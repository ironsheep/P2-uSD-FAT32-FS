{Spin2_v45}
{{ =================================================================================================

   File....... SD_example_directory_walk.spin2
   Purpose.... Directory enumeration, file management, and tree walk example
   Author..... Stephen M Moraco
               -- see below for terms of use
   E-mail..... stephen@ironsheep.biz
   Started.... 25 FEB 2026
   Updated.... 01 MAR 2026

   This example demonstrates directory operations:
     1. List files in the root directory with sizes and attributes
     2. Create a subdirectory and files within it
     3. List a subdirectory using handle-based enumeration (without changing CWD)
     4. Delete a file and rename another
     5. Show volume information

================================================================================================= }}

CON

    _CLKFREQ = 350_000_000

    SD_BASE = 56
    SD_SCK  = SD_BASE + 5
    SD_CS   = SD_BASE + 4
    SD_MOSI = SD_BASE + 3
    SD_MISO = SD_BASE + 2

    DEBUG_DISABLE = 0

OBJ

    sd : "micro_sd_fat32_fs"

VAR

    byte  name_copy[13]

PUB go() | handle
'' Main entry point -- lists root directory, creates EXDIR with files, demonstrates handle-based
'' directory enumeration, delete, and rename operations.
' @local handle - File handle for creating test files

    debug("=== SD Directory Walk Example ===")

    if sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK) < 0
        debug("Mount FAILED")
        return

    ' --- Show volume info ---
    debug("Volume: ", zstr(sd.volumeLabel()))
    debug("Free:   ", udec(sd.freeSpace() >> 11), " MB")

    ' --- List root directory ---
    debug(" ")
    debug("--- Root Directory ---")
    listCurrentDirectory()

    ' --- Create a test subdirectory with files ---
    '   newDirectory() fails if the directory already exists -- that's OK.
    '   deleteFile() before createFileNew() makes this re-runnable.
    debug(" ")
    debug("--- Creating EXDIR with files ---")
    sd.newDirectory(@"EXDIR")
    sd.changeDirectory(@"EXDIR")

    sd.deleteFile(@"FILE_A.TXT")
    handle := sd.createFileNew(@"FILE_A.TXT")
    if handle >= 0
        sd.writeHandle(handle, @"Contents of file A", 18)
        sd.closeFileHandle(handle)

    sd.deleteFile(@"FILE_B.TXT")
    handle := sd.createFileNew(@"FILE_B.TXT")
    if handle >= 0
        sd.writeHandle(handle, @"Contents of file B", 18)
        sd.closeFileHandle(handle)

    sd.deleteFile(@"TEMP.TXT")
    handle := sd.createFileNew(@"TEMP.TXT")
    if handle >= 0
        sd.writeHandle(handle, @"Temporary file", 14)
        sd.closeFileHandle(handle)

    sd.changeDirectory(@"/")

    ' --- List subdirectory using handle-based enumeration ---
    '     This does NOT change our CWD (we stay in root)
    debug(" ")
    debug("--- EXDIR contents (via directory handle) ---")
    listDirectoryByHandle(@"EXDIR")

    ' --- File management: delete and rename ---
    debug(" ")
    debug("--- File management ---")
    sd.changeDirectory(@"EXDIR")

    sd.deleteFile(@"TEMP.TXT")
    debug("Deleted TEMP.TXT")

    sd.rename(@"FILE_B.TXT", @"RENAMED.TXT")
    debug("Renamed FILE_B.TXT -> RENAMED.TXT")

    ' Show the result
    debug(" ")
    debug("--- EXDIR after changes ---")
    listCurrentDirectory()

    sd.changeDirectory(@"/")
    sd.unmount()

    debug(" ")
    debug("=== Done ===")

PRI listCurrentDirectory() | entry_num, p_entry, attr
' List all entries in the current working directory using index-based enumeration.
' @local entry_num - Current directory entry index
' @local p_entry - Pointer to directory entry returned by readDirectory()
' @local attr - File attribute byte from sd.attributes()
    entry_num := 0
    repeat
        p_entry := sd.readDirectory(entry_num)
        if p_entry == 0
            quit

        attr := sd.attributes()
        ' Copy name before next call invalidates it
        bytemove(@name_copy, sd.fileName(), 13)

        if attr & $10
            debug("  [DIR]  ", zstr(@name_copy))
        else
            debug("  [FILE] ", zstr(@name_copy), "  ", udec(sd.fileSize()), " bytes")

        entry_num++

PRI listDirectoryByHandle(p_path) | dh, p_entry, attr
' List entries in a specific directory without changing CWD.
' @param p_path - Pointer to null-terminated directory path string
' @local dh - Directory handle from openDirectory()
' @local p_entry - Pointer to directory entry returned by readDirectoryHandle()
' @local attr - File attribute byte from sd.attributes()
    dh := sd.openDirectory(p_path)
    if dh < 0
        debug("  Cannot open directory, error: ", sdec(dh))
        return

    repeat
        p_entry := sd.readDirectoryHandle(dh)
        if p_entry == 0
            quit

        attr := sd.attributes()
        bytemove(@name_copy, sd.fileName(), 13)

        if attr & $10
            debug("  [DIR]  ", zstr(@name_copy))
        else
            debug("  [FILE] ", zstr(@name_copy), "  ", udec(sd.fileSize()), " bytes")

    sd.closeDirectoryHandle(dh)

con { license }

