'' =========================================================================================
''
''   File....... isp_fsck_utility.spin2
''   Purpose.... Combined FSCK (repair) + Audit (read-only) library for FAT32 filesystems
''   Author..... Stephen M Moraco
''   E-mail..... stephen@ironsheep.biz
''   Started.... 21 FEB 2026
''   Updated.... 12 AUG 2026
''
'' =========================================================================================

{ Description:
   Runs in a temporary cog, communicates via FIFO strings.
   Reusable library that runs FSCK or Audit in a temporary cog.
   Output is sent via isp_string_fifo for the caller to display.

   Two modes, one 4-pass engine (structural integrity, chain validation,
   lost-cluster detection, free-count):
     MODE_AUDIT - full scan, read-only: reports every issue (incl. clusters
                  orphaned by a faulty write path), writes nothing
     MODE_FSCK  - the same full scan, plus repairs (writes to card)

   Usage:
     caller: sd.stop()
     caller: fsck.startFsck(cs, mosi, miso, sck)   ' or startAudit() for read-only
     caller: repeat
               if fsck.hasOutput()
                 display(fsck.getOutput())
               if fsck.isDone()
                 drain remaining, quit
     caller: fsck.stop()
     caller: sd.mount(cs, mosi, miso, sck)
}

CON { suppress debug output }

  DEBUG_DISABLE = 1

CON { operation modes }

  ' One 4-pass engine (structural integrity, chain validation, lost-cluster
  ' detection, free-count) serves both modes. Audit is the read-only run.
  MODE_AUDIT = 0                    ' read-only: report every issue, write nothing (dry-run)
  MODE_FSCK  = 1                    ' repair: same full scan, apply fixes

CON { FAT32 structure constants }

  ' Signatures (NOT in driver)
  FSINFO_TRAIL_SIG            = $AA550000      ' FSInfo trailing signature
  EXT_BOOT_SIG                = $29            ' Extended boot signature

  ' FAT entry constants (NOT in driver)
  FAT_FREE        = $00000000     ' Free cluster
  FAT_BAD         = $0FFFFFF7     ' Bad cluster marker

  ' BPB byte offsets (NOT in driver)
  BPB_BYTES_PER_SEC   = $0B
  BPB_SEC_PER_CLUS    = $0D
  BPB_RESERVED_SECS   = $0E
  BPB_NUM_FATS        = $10
  BPB_ROOT_ENTRY_CT   = $11
  BPB_TOTAL_SEC_16    = $13
  BPB_MEDIA_TYPE      = $15
  BPB_FAT_SIZE_16     = $16
  BPB_HIDDEN_SECS     = $1C
  BPB_TOTAL_SEC_32    = $20
  BPB_FAT_SIZE_32     = $24
  BPB_ROOT_CLUSTER    = $2C
  BPB_FSINFO_SEC      = $30
  BPB_BACKUP_BOOT_SEC = $32
  BPB_EXT_BOOT_SIG    = $42
  BPB_FS_TYPE         = $52

  ' MBR partition sub-offsets (NOT in driver)
  MBR_PART_TYPE_OFF   = $1C2
  MBR_PART_LBA_START  = $1C6
  MBR_PART_LBA_SIZE   = $1CA

  ' FSInfo field offsets (NOT in driver)
  FSINFO_SIG2_OFFSET          = 484
  FSINFO_FREE_COUNT_OFFSET    = 488
  FSINFO_NEXT_FREE_OFFSET     = 492

  ' Directory processing constants
  ENTRIES_PER_SECTOR  = 16
  DIR_END_MARKER      = $00
  ATTR_LFN_MASK       = $3F

  ' FAT geometry constants
  FAT_ENTRIES_PER_SECTOR = 128
  CLUSTER_SHIFT          = 7
  CLUSTER_OFFSET_MASK    = $7F
  BIT_INDEX_MASK         = $1F

  ' Bitmap capacity (256KB covers up to 2M clusters -- sufficient for cards up to 64GB)
  BITMAP_LONGS        = 65536             ' 256KB
  MAX_BITMAP_CLUSTERS = BITMAP_LONGS * 32 ' 2,097,152 clusters

  ' Safety limits
  MAX_DIR_DEPTH       = 16
  ' Ceiling on the look-ahead's walk of one directory's cluster chain. A corrupt chain can
  ' loop, and the look-ahead runs on damaged filesystems by definition, so it must not be
  ' able to spin forever. Far above any real directory.
  MAX_DIR_CHAIN_HOPS  = 4096
  MAX_CHAIN_LENGTH    = 2_000_000

  ' Audit fail tracking
  MAX_FAIL_NAMES    = 16

  ' Stack for cogspin'd cog
  STACK_LONGS       = 512
  STACK_GUARD_LONGS = 4
  STACK_GUARD_BYTE  = $CC

' Enable full driver features
#ifdef __SPINTOOLS__
#define SD_INCLUDE_ALL
#elseifdef __FLEXSPIN__
#define SD_INCLUDE_ALL
#pragma exportdef SD_INCLUDE_ALL
#else
#pragma exportdef SD_INCLUDE_ALL
#endif

OBJ

  sd   : "micro_sd_fat32_fs"
  fifo : "isp_string_fifo"

VAR

  ' Sector buffers
  BYTE    buf[sd.SECTOR_SIZE]              ' general purpose / directory entries
  BYTE    buf2[sd.SECTOR_SIZE]             ' comparison buffer
  BYTE    fatBuf[sd.SECTOR_SIZE]           ' FAT sector cache

  ' FAT cache state
  LONG    fatBufSector          ' which FAT1 sector is cached (-1 = none)
  LONG    fatBufDirty           ' TRUE if fatBuf needs writing

  ' Filesystem geometry (populated by readGeometry)
  LONG    partitionStart
  LONG    sectorsPerFat
  LONG    sectorsPerCluster
  LONG    totalClusters
  LONG    totalSectors
  LONG    reservedSectors
  LONG    fat1Start
  LONG    fat2Start
  LONG    dataStart
  LONG    rootCluster
  LONG    mediaType             ' BPB media descriptor byte ($F0 removable / $F8 fixed)
  LONG    dryRun                ' TRUE in MODE_AUDIT -- all repair writes suppressed

  ' Statistics / results
  LONG    v_passCount
  LONG    v_failCount
  LONG    v_failNames[MAX_FAIL_NAMES]   ' pointers to failed test name strings
  LONG    v_repairCount
  LONG    v_errorCount
  LONG    v_warningCount
  LONG    v_dirCount
  LONG    v_fileCount
  LONG    scanDepth
  LONG    v_lostCount           ' running count of lost clusters freed
  LONG    v_fragmentedFileCount ' files with fragment_count > 1
  LONG    v_totalFragments      ' sum of all fragment counts
  LONG    windowStart           ' first cluster in current bitmap window
  LONG    windowEnd             ' last cluster+1 in current window (exclusive)
  LONG    currentWindow         ' current window index (0-based)
  LONG    windowCount           ' total windows needed

  ' Cluster bitmap (256KB)
  LONG    bitmapData[BITMAP_LONGS]

DAT { singleton cog state }

cog_id      LONG    -1                   ' cog number (-1 = not running)
op_mode     LONG    0                    ' MODE_AUDIT or MODE_FSCK
op_done     LONG    0                    ' TRUE when cog finished

pin_cs      LONG    0                    ' SD pin configuration
pin_mosi    LONG    0
pin_miso    LONG    0
pin_sck     LONG    0

cog_stack   LONG    0[STACK_LONGS]
cog_guard   LONG    0[STACK_GUARD_LONGS]

tmpStr      BYTE    0[32]                ' temp buffer for string extraction

' Repair-line voice. Each message names the PROBLEM, never the action, so the
' one text reads correctly under either tag: "needs repair: 2 lost clusters"
' (audit) and "repaired: 2 lost clusters" (fsck). See repairTag().
tagRepair   BYTE    "repaired", 0
tagWould    BYTE    "needs repair", 0


'' =========================================================================
'' Caller API (call from main cog)
'' =========================================================================

PUB null()
'' This is not a top level object


PUB startFsck(cs, mosi, miso, sck) : ok
'' Launch FSCK (check and repair) in a new cog
''
'' @param cs - SD card CS pin
'' @param mosi - SD card MOSI pin
'' @param miso - SD card MISO pin
'' @param sck - SD card SCK pin
'' @returns ok - TRUE if cog launched successfully

    ok := doStart(cs, mosi, miso, sck, MODE_FSCK)


PUB startAudit(cs, mosi, miso, sck) : ok
'' Launch Audit in a new cog: the full 4-pass filesystem scan, read-only.
'' Runs the same structural integrity, chain-validation, lost-cluster, and
'' free-count checks fsck does, reporting every issue (including clusters
'' orphaned by a faulty write path) while writing nothing to the card.
''
'' @param cs - SD card CS pin
'' @param mosi - SD card MOSI pin
'' @param miso - SD card MISO pin
'' @param sck - SD card SCK pin
'' @returns ok - TRUE if cog launched successfully

    ok := doStart(cs, mosi, miso, sck, MODE_AUDIT)


PUB hasOutput() : yes
'' Check if the utility has produced output strings
''
'' @returns yes - TRUE if strings are waiting in the FIFO

    yes := fifo.hasOutput()


PUB getOutput() : pStr
'' Get the next output string from the utility
''
'' @returns pStr - pointer to string, or 0 if empty

    pStr := fifo.getOutput()


PUB isDone() : yes
'' Check if the utility cog has finished
''
'' @returns yes - TRUE if the cog has completed its work

    yes := (op_done <> 0)


PUB getResults(pPass, pFail, pRepairs, pErrors, pWarnings, pDirs, pFiles)
'' Copy result statistics to caller-provided LONG addresses
'' Call after isDone() returns TRUE
''
'' @param pPass - pointer to LONG to receive pass count
'' @param pFail - pointer to LONG to receive fail count
'' @param pRepairs - pointer to LONG to receive repair count
'' @param pErrors - pointer to LONG to receive error count
'' @param pWarnings - pointer to LONG to receive warning count
'' @param pDirs - pointer to LONG to receive directory count
'' @param pFiles - pointer to LONG to receive file count

    LONG[pPass] := v_passCount
    LONG[pFail] := v_failCount
    LONG[pRepairs] := v_repairCount
    LONG[pErrors] := v_errorCount
    LONG[pWarnings] := v_warningCount
    LONG[pDirs] := v_dirCount
    LONG[pFiles] := v_fileCount


PUB stop()
'' Stop the utility cog and clean up SD driver
'' Safe to call even if cog already finished

    if cog_id >= 0
        cogstop(cog_id)
    cog_id := -1
    sd.stop()


' =========================================================================
' Cog launch (private)
' =========================================================================

PRI doStart(cs, mosi, miso, sck, mode) : ok
' Store pin configuration, init FIFO, launch cog
'
' @param cs, mosi, miso, sck - SD pin configuration
' @param mode - MODE_AUDIT (read-only) or MODE_FSCK (repair)
' @returns ok - TRUE if cog launched

    ' Store pins for the new cog to read
    pin_cs := cs
    pin_mosi := mosi
    pin_miso := miso
    pin_sck := sck
    op_mode := mode
    dryRun := (mode == MODE_AUDIT)                              '  audit = full 4-pass scan with all writes suppressed
    op_done := false

    ' Initialize FIFO
    fifo.init()

    ' Fill stack guard
    bytefill(@cog_guard, STACK_GUARD_BYTE, STACK_GUARD_LONGS * 4)

    ' Launch cog
    cog_id := cogspin(NEWCOG, run(), @cog_stack)
    ok := (cog_id >= 0)


' =========================================================================
' Cog entry point (runs in new cog)
' =========================================================================

PRI run() | result, cardSectors
' Cog entry point -- initializes card and dispatches to audit or fsck
' When this method returns, the cog stops automatically

    ' Initialize card for raw sector access
    result := sd.initCardOnly(pin_cs, pin_mosi, pin_miso, pin_sck)
    if result < 0
        fifo.put(@"FATAL: Cannot initialize card!")
    else
        cardSectors := sd.cardSizeSectors()

        ' One 4-pass engine for both modes; MODE_AUDIT runs it read-only (dryRun).
        runFsck(cardSectors)

        ' Clean up SD driver before finishing
        sd.stop()
    op_done := true


' =========================================================================
' FSCK orchestration
' =========================================================================

PRI runFsck(cardSectors)
' Run full 4-pass filesystem check and repair, then display summary.
'
' @param cardSectors - Total number of sectors on the card

    v_repairCount := 0
    v_errorCount := 0
    v_warningCount := 0
    v_dirCount := 0
    v_fileCount := 0
    v_lostCount := 0
    v_fragmentedFileCount := 0
    v_totalFragments := 0
    v_passCount := 0
    v_failCount := 0
    longfill(@v_failNames, 0, MAX_FAIL_NAMES)
    scanDepth := 0
    fatBufSector := -1
    fatBufDirty := false

    if dryRun
        fifo.put(@"=== FAT32 Filesystem Audit ===")
        fifo.put(@"Read-only -- nothing on this card is changed.")
    else
        fifo.put(@"=== FAT32 Filesystem Check & Repair ===")
    fifo.putFmt2(@"Card: %d sectors (%d MB)", cardSectors, cardSectors / 2048)
    fifo.put(@" ")

    ' Read filesystem geometry
    if not readGeometry()
        fifo.put(@"FATAL: Cannot read filesystem geometry")
    else
        fifo.put(@" ")

        ' Structural validation: read-only itemized MBR + VBR field checks
        auditMBR()
        auditVBR()

        ' Pass 1: Structural integrity
        fsckPass1()

        ' Pass 2: Directory walk + chain validation (windowed bitmap)
        fsckPass2()

        ' Pass 4: FAT sync + free count
        fsckPass4()

        ' Summary. The completion marker names the operation the caller asked
        ' for -- audit (read-only) or fsck (repair) -- so a log identifies its
        ' own vehicle. Log consumers key on these two markers.
        fifo.put(@" ")
        if dryRun
            fifo.put(@"=== AUDIT COMPLETE ===")
        else
            fifo.put(@"=== FSCK COMPLETE ===")
        ' In audit mode nothing was written, so the repair count is the count of
        ' repairs that WOULD be made -- reported as such rather than as "Repairs".
        if dryRun
            fifo.putFmt2(@"Errors: %d  Repairs needed: %d", v_errorCount, v_repairCount)
        else
            fifo.putFmt2(@"Errors: %d  Repairs: %d", v_errorCount, v_repairCount)
        fifo.putFmt1(@"Warnings: %d", v_warningCount)
        fifo.putFmt2(@"Structural checks: %d pass, %d fail", v_passCount, v_failCount)
        fifo.putFmt2(@"Directories: %d  Files: %d", v_dirCount, v_fileCount)
        if v_fragmentedFileCount > 0
            fifo.putFmt2(@"Fragmented files: %d (%d fragments total)", v_fragmentedFileCount, v_totalFragments)
        if v_errorCount == 0
            if v_repairCount == 0
                fifo.put(@"This filesystem is healthy.")
                fifo.put(@"STATUS: CLEAN")
            elseif dryRun
                fifo.put(@"Nothing was repaired -- run SD_FAT32_fsck to fix what is listed above.")
                fifo.put(@"STATUS: REPAIRS NEEDED")             '  read-only run -- nothing was written
            else
                fifo.put(@"Everything listed above has been repaired.")
                fifo.put(@"STATUS: REPAIRED")
        else
            fifo.put(@"Some problems could not be repaired -- see the errors above.")
            fifo.put(@"STATUS: ERRORS REMAIN")


' =========================================================================
' Shared geometry reader
' =========================================================================

PRI readGeometry() : ok | numFats, rdStatus
' Read MBR and VBR to extract filesystem geometry.
' Populates all geometry variables needed by subsequent passes.
'
' @returns ok - TRUE if geometry read successfully

    ' Read MBR to get partition start
    ok := false
    rdStatus := sd.readSectorRaw(0, @buf)
    if rdStatus < 0
        fifo.putFmt1(@"  ERROR: MBR (sector 0) read failed, status %d", rdStatus)
    elseif WORD[@buf + sd.BOOT_SIG_OFFSET] <> sd.BOOT_SIGNATURE
        fifo.putFmt1(@"  ERROR: Invalid MBR signature (got $%x, expected $AA55)", WORD[@buf + sd.BOOT_SIG_OFFSET])
    elseif LONG[@buf + MBR_PART_LBA_START] == 0
        fifo.put(@"  ERROR: Partition start is 0")
    else
        partitionStart := LONG[@buf + MBR_PART_LBA_START]

        ' Read VBR (Volume Boot Record)
        rdStatus := sd.readSectorRaw(partitionStart, @buf)
        if rdStatus < 0
            fifo.putFmt1(@"  ERROR: VBR read failed, status %d", rdStatus)
        elseif WORD[@buf + sd.BOOT_SIG_OFFSET] <> sd.BOOT_SIGNATURE
            fifo.putFmt1(@"  ERROR: Invalid VBR signature (got $%x)", WORD[@buf + sd.BOOT_SIG_OFFSET])
        else
            ' Extract geometry fields
            sectorsPerCluster := buf[BPB_SEC_PER_CLUS]
            reservedSectors := WORD[@buf + BPB_RESERVED_SECS]
            numFats := buf[BPB_NUM_FATS]
            sectorsPerFat := LONG[@buf + BPB_FAT_SIZE_32]
            totalSectors := LONG[@buf + BPB_TOTAL_SEC_32]
            rootCluster := LONG[@buf + BPB_ROOT_CLUSTER]
            mediaType := buf[BPB_MEDIA_TYPE]

            ' Validate critical fields
            if sectorsPerCluster == 0 or sectorsPerFat == 0 or totalSectors == 0
                fifo.put(@"  ERROR: Zero in critical VBR field")
            elseif numFats < 1 or numFats > 2
                fifo.putFmt1(@"  ERROR: Invalid number of FATs: %d", numFats)
            else
                ok := true

    if ok
        ' Compute derived values
        fat1Start := partitionStart + reservedSectors
        fat2Start := fat1Start + sectorsPerFat
        dataStart := fat1Start + (numFats * sectorsPerFat)
        totalClusters := (totalSectors - reservedSectors - (numFats * sectorsPerFat)) / sectorsPerCluster

        fifo.put(@"  Geometry:")
        fifo.putFmt1(@"    Partition start:  %d", partitionStart)
        fifo.putFmt1(@"    Sectors/cluster:  %d", sectorsPerCluster)
        fifo.putFmt1(@"    Sectors/FAT:      %d", sectorsPerFat)
        fifo.putFmt1(@"    Total clusters:   %d", totalClusters)
        fifo.putFmt1(@"    Root cluster:     %d", rootCluster)
        fifo.putFmt1(@"    Data start:       %d", dataStart)
        fifo.put(@" ")


PRI readOrFail(sector, pBuf) : bOk
' Read a sector, and make a failure impossible to ignore.
'
' A CHECKER THAT CANNOT READ THE MEDIA MUST SAY SO. An unchecked read leaves the PREVIOUS
' sector's contents sitting in the buffer, and every caller here then validates those
' stale bytes as directory entries or FAT data -- so the tool either invents corruption
' that is not on the card, or certifies CLEAN over a sector it never actually saw. For a
' tool whose entire job is telling the truth about the media, that is the worst failure
' available to it.
'
' Each failure is reported and counted as an error, which is what keeps the run from
' reaching the CLEAN verdict: that verdict is computed from v_errorCount, so no separate
' suppression is needed. Callers must treat FALSE as "this sector's contents are unknown"
' and skip whatever they were about to conclude from it.
'
' @param sector - LBA to read
' @param pBuf - Pointer to the 512-byte destination
' @returns bOk - TRUE if the sector was read; FALSE if its contents are unknown

    if sd.readSectorRaw(sector, pBuf) < 0
        fifo.putFmt1(@"  ERROR: Could not read sector %d -- contents unknown", sector)
        v_errorCount++
        return false
    return true


PRI doRepairWrite(sector, pBuf)
' Perform a repair sector write, or skip the write in MODE_AUDIT (dry-run).
' Every fsck repair site routes its write through here so audit mode can
' exercise the same detection logic with zero risk to the card.
'
' @param sector - Sector number to write
' @param pBuf - Pointer to 512-byte buffer to write

    if dryRun
        return                                                                  '  MODE_AUDIT -- detection only, no writes
    sd.writeSectorRaw(sector, pBuf)


' =========================================================================
' FSCK Pass 1: Structural integrity
' =========================================================================

PRI auditRunTest(pTestName, passed)
' Record and display a single read-only structural check result.
'
' @param pTestName - pointer to test name string
' @param passed - TRUE if test passed

    if passed
        v_passCount++
        fifo.putFmt1(@"  [PASS] %s", pTestName)
    else
        if v_failCount < MAX_FAIL_NAMES
            v_failNames[v_failCount] := pTestName
        v_failCount++
        fifo.putFmt1(@"  [FAIL] %s", pTestName)


PRI auditMBR() | result
' Read-only itemized validation of the MBR (sector 0). Reports each field;
' the MBR itself is never rewritten (too risky), so these are checks, not repairs.

    fifo.put(@"Checking MBR (sector 0)...")

    if not readOrFail(0, @buf)
        fifo.put(@"  MBR checks SKIPPED -- nothing can be concluded from an unread sector")
        return

    auditRunTest(@"MBR boot signature ($AA55)", WORD[@buf + sd.BOOT_SIG_OFFSET] == sd.BOOT_SIGNATURE)

    result := buf[sd.MBR_PARTITION_OFFSET]
    auditRunTest(@"Partition 1 boot flag ($00/$80)", result == $00 OR result == $80)

    result := buf[MBR_PART_TYPE_OFF]
    auditRunTest(@"Partition type FAT32 ($0B or $0C)", result == sd.PART_TYPE_FAT32_LBA OR result == sd.PART_TYPE_FAT32_LBA28)

    result := LONG[@buf + MBR_PART_LBA_START]
    auditRunTest(@"Partition start > 0", result > 0)
    fifo.putFmt1(@"    Partition start: sector %d", result)

    result := LONG[@buf + MBR_PART_LBA_SIZE]
    auditRunTest(@"Partition size > 0", result > 0)
    fifo.putFmt1(@"    Partition size: %d sectors", result)
    fifo.put(@" ")


PRI auditVBR() | result
' Read-only itemized validation of the VBR (primary boot sector at partition start).

    fifo.put(@"Checking VBR (boot sector)...")

    if not readOrFail(partitionStart, @buf)
        fifo.put(@"  VBR checks SKIPPED -- nothing can be concluded from an unread sector")
        return

    result := buf[0]
    auditRunTest(@"VBR jump ($EB or $E9)", result == $EB OR result == $E9)

    auditRunTest(@"VBR boot signature ($AA55)", WORD[@buf + sd.BOOT_SIG_OFFSET] == sd.BOOT_SIGNATURE)

    result := WORD[@buf + BPB_BYTES_PER_SEC]
    auditRunTest(@"Bytes/sector = 512", result == sd.SECTOR_SIZE)

    result := buf[BPB_SEC_PER_CLUS]
    auditRunTest(@"Sectors/cluster power of 2", result >= 1 AND result <= 128 AND (result & (result - 1)) == 0)
    fifo.putFmt1(@"    Sectors/cluster: %d", result)

    result := WORD[@buf + BPB_RESERVED_SECS]
    auditRunTest(@"Reserved sectors = 32", result == 32)

    result := buf[BPB_NUM_FATS]
    auditRunTest(@"Number of FATs = 2", result == sd.EXPECTED_FAT_COUNT)

    result := WORD[@buf + BPB_ROOT_ENTRY_CT]
    auditRunTest(@"Root entry count = 0 (FAT32)", result == 0)

    result := WORD[@buf + BPB_TOTAL_SEC_16]
    auditRunTest(@"Total sectors 16-bit = 0", result == 0)

    result := buf[BPB_MEDIA_TYPE]
    ' $F0 (removable) and $F8 (fixed) are both spec-legal -- macOS writes $F0 for SD
    auditRunTest(@"Media type valid ($F0/$F8)", result == $F0 OR result == $F8)
    fifo.putFmt1(@"    Media type: $%x", result)

    result := WORD[@buf + BPB_FAT_SIZE_16]
    auditRunTest(@"FAT size 16-bit = 0", result == 0)

    result := LONG[@buf + BPB_HIDDEN_SECS]
    ' Informational BPB field -- macOS writes 0, others write the partition LBA; both OK
    auditRunTest(@"Hidden sectors valid (0 or partition start)", result == partitionStart OR result == 0)
    fifo.putFmt1(@"    Hidden sectors: %d", result)

    auditRunTest(@"Total sectors 32-bit > 0", totalSectors > 0)
    fifo.putFmt1(@"    Total sectors: %d", totalSectors)

    auditRunTest(@"Sectors per FAT > 0", sectorsPerFat > 0)
    fifo.putFmt1(@"    Sectors/FAT: %d", sectorsPerFat)

    result := LONG[@buf + BPB_ROOT_CLUSTER]
    auditRunTest(@"Root cluster = 2", result == sd.ROOT_CLUSTER)

    result := WORD[@buf + BPB_FSINFO_SEC]
    auditRunTest(@"FSInfo at sector 1", result == 1)

    result := WORD[@buf + BPB_BACKUP_BOOT_SEC]
    auditRunTest(@"Backup boot at sector 6", result == 6)

    result := buf[BPB_EXT_BOOT_SIG]
    auditRunTest(@"Extended boot sig = $29", result == EXT_BOOT_SIG)

    result := true
    if buf[BPB_FS_TYPE] <> "F"
        result := false
    if buf[BPB_FS_TYPE + 1] <> "A"
        result := false
    if buf[BPB_FS_TYPE + 2] <> "T"
        result := false
    if buf[BPB_FS_TYPE + 3] <> "3"
        result := false
    if buf[BPB_FS_TYPE + 4] <> "2"
        result := false
    auditRunTest(@"FS type = FAT32", result)
    fifo.put(@" ")


PRI fsckPass1() | idx, mismatch, fsinfoDirty, startRepairs
' Check and repair structural elements.
' Verifies VBR backup, FSInfo signatures and backup, FAT[0], FAT[1], FAT[2].

    fifo.put(@"--- Pass 1: Structural Integrity ---")
    startRepairs := v_repairCount

    ' === VBR backup (sector 6) ===
    if not readOrFail(partitionStart, @buf)
        return                                                                  '  a mismatch reported from stale bytes would be a lie
    if not readOrFail(partitionStart + 6, @buf2)
        return

    mismatch := false
    repeat idx from 0 to sd.SECTOR_SIZE - 1
        if buf[idx] <> buf2[idx]
            mismatch := true
            quit

    if mismatch
        fifo.putFmt1(@"  %s: backup VBR out of sync with the primary", repairTag())
        doRepairWrite(partitionStart + 6, @buf)
        v_repairCount++
    else
        fifo.put(@"  [OK] Backup VBR matches")

    ' === FSInfo signatures (sector 1) ===
    if not readOrFail(partitionStart + 1, @buf)
        return
    fsinfoDirty := false

    if LONG[@buf] <> sd.FSINFO_LEAD_SIG
        fifo.putFmt1(@"  %s: FSInfo lead signature wrong", repairTag())
        LONG[@buf] := sd.FSINFO_LEAD_SIG
        fsinfoDirty := true
        v_repairCount++

    if LONG[@buf + FSINFO_SIG2_OFFSET] <> sd.FSINFO_STRUCT_SIG
        fifo.putFmt1(@"  %s: FSInfo structure signature wrong", repairTag())
        LONG[@buf + FSINFO_SIG2_OFFSET] := sd.FSINFO_STRUCT_SIG
        fsinfoDirty := true
        v_repairCount++

    if LONG[@buf + $1FC] <> FSINFO_TRAIL_SIG
        fifo.putFmt1(@"  %s: FSInfo trailing signature wrong", repairTag())
        LONG[@buf + $1FC] := FSINFO_TRAIL_SIG
        fsinfoDirty := true
        v_repairCount++

    if fsinfoDirty
        doRepairWrite(partitionStart + 1, @buf)
    else
        fifo.put(@"  [OK] FSInfo signatures")

    ' === FSInfo backup (sector 7) ===
    if not readOrFail(partitionStart + 1, @buf)
        return
    if not readOrFail(partitionStart + 7, @buf2)
        return

    mismatch := false
    repeat idx from 0 to sd.SECTOR_SIZE - 1
        if buf[idx] <> buf2[idx]
            mismatch := true
            quit

    if mismatch
        fifo.putFmt1(@"  %s: backup FSInfo out of sync with the primary", repairTag())
        doRepairWrite(partitionStart + 7, @buf)
        v_repairCount++
    else
        fifo.put(@"  [OK] Backup FSInfo matches")

    ' === FAT[0] media type ===
    ' FAT[0]'s low byte mirrors the BPB media byte ($F0 removable / $F8 fixed).
    ' Validate and repair against the card's ACTUAL media byte -- assuming $F8 here
    ' would rewrite a perfectly valid $F0-media filesystem ($0FFFFFF0) and corrupt it.
    if not readOrFail(fat1Start, @buf)
        return

    if (LONG[@buf] & sd.FAT32_ENTRY_MASK) <> (($0FFFFF00 | mediaType) & sd.FAT32_ENTRY_MASK)
        fifo.putFmt1(@"  %s: FAT[0] media type byte wrong", repairTag())
        LONG[@buf] := ($0FFFFF00 | mediaType) | (LONG[@buf] & $F0000000)
        doRepairWrite(fat1Start, @buf)
        v_repairCount++
    else
        fifo.put(@"  [OK] FAT[0] media type")

    ' === FAT[1] EOC marker ===
    if (LONG[@buf + 4] & sd.FAT32_ENTRY_MASK) <> sd.FAT32_EOC_MARK
        fifo.putFmt1(@"  %s: FAT[1] end-of-chain marker wrong", repairTag())
        LONG[@buf + 4] := sd.FAT32_EOC_MARK | (LONG[@buf + 4] & $F0000000)
        doRepairWrite(fat1Start, @buf)
        v_repairCount++
    else
        fifo.put(@"  [OK] FAT[1] EOC marker")

    ' === FAT[2] root cluster ===
    if (LONG[@buf + 8] & sd.FAT32_ENTRY_MASK) == FAT_FREE
        fifo.putFmt1(@"  %s: root cluster marked free", repairTag())
        LONG[@buf + 8] := sd.FAT32_EOC_MARK | (LONG[@buf + 8] & $F0000000)
        doRepairWrite(fat1Start, @buf)
        v_repairCount++
    else
        fifo.put(@"  [OK] FAT[2] root cluster")

    fifo.putFmt1(@"  Pass 1: %d repairs", v_repairCount - startRepairs)
    fifo.put(@" ")


' =========================================================================
' FSCK Pass 2: Directory walk + chain validation
' =========================================================================

PRI fsckPass2() | startRepairs
' Walk directory tree and validate all cluster chains using windowed bitmap.
' For cards >64GB, processes cluster space in 2M-cluster windows,
' re-walking the directory tree for each window.
' After each window, runs pass 3 (lost cluster recovery) for that window.

    fifo.put(@"--- Pass 2: Directory & Chain Validation ---")
    startRepairs := v_repairCount

    ' Compute number of windows needed
    windowCount := (totalClusters + 2 + MAX_BITMAP_CLUSTERS - 1) / MAX_BITMAP_CLUSTERS
    if windowCount > 1
        fifo.putFmt2(@"  Using %d bitmap windows for %d clusters", windowCount, totalClusters + 2)

    repeat currentWindow from 0 to windowCount - 1
        ' Set up window boundaries
        windowStart := currentWindow * MAX_BITMAP_CLUSTERS
        windowEnd := (windowStart + MAX_BITMAP_CLUSTERS) <# (totalClusters + 2)

        ' Clear cluster bitmap for this window
        longfill(@bitmapData, 0, BITMAP_LONGS)

        ' Mark clusters 0 and 1 as used (they don't exist as data clusters)
        if windowStart == 0
            setBit(0)
            setBit(1)

        ' Reset counters only on first window
        if currentWindow == 0
            v_dirCount := 0
            v_fileCount := 0

        ' CRITICAL: Validate root chain BEFORE scanning directories
        ' This prevents pass 3 from freeing root directory clusters
        fsckValidateChain(rootCluster, 0, true)

        ' Scan directory tree
        scanDepth := 0
        fsckScanDir(rootCluster)

        ' Run pass 3 (lost cluster recovery) for this window immediately
        fsckPass3Window()

    fifo.putFmt2(@"  Dirs: %d  Files: %d", v_dirCount, v_fileCount)
    if v_lostCount > 0
        fifo.putFmt2(@"  %s: %d lost clusters", repairTag(), v_lostCount)
        v_repairCount += v_lostCount
    else
        fifo.put(@"  [OK] No lost clusters")
    fifo.putFmt1(@"  Pass 2/3: %d repairs", v_repairCount - startRepairs)
    fifo.put(@" ")


PRI fsckScanDir(dirCluster) | dirDone, sector, entSector, entIdx, pEntry, attr, startClus, fSize, name0, nextClus
' Recursively scan directory, validating all entries and chains.
' Re-reads parent sector after returning from subdirectory recursion.
' On windows >0, suppresses counting and error messages (bitmap marking only).
'
' @param dirCluster - First cluster of the directory to scan

    if currentWindow == 0
        v_dirCount++
    scanDepth++
    dirDone := false

    if scanDepth > MAX_DIR_DEPTH
        if currentWindow == 0
            fifo.put(@"  WARNING: Max dir depth exceeded")
            v_warningCount++
        dirDone := true

    ' Follow the directory's cluster chain
    repeat while dirCluster >= 2 and not dirDone
        if dirCluster >= (totalClusters + 2)
            quit
        sector := clus2sec(dirCluster)

        ' Read each sector in this cluster
        repeat entSector from 0 to sectorsPerCluster - 1
            if dirDone
                quit
            if not readOrFail(sector + entSector, @buf)
                dirDone := true                                                 '  stale bytes are not directory entries -- stop rather than invent findings
                quit

            ' Process directory entries per sector
            repeat entIdx from 0 to ENTRIES_PER_SECTOR - 1
                if dirDone
                    quit
                pEntry := @buf + (entIdx * sd.DIR_ENTRY_SIZE)
                name0 := BYTE[pEntry]

                ' End of directory
                if name0 == DIR_END_MARKER
                    ' Halting at $00 is CORRECT FAT32 and is what terminates every healthy
                    ' directory -- so this is NOT treated as suspicious on its own. It is
                    ' only wrong when live entries lie BEYOND it, which is the one case the
                    ' look-ahead reports. A healthy directory never reaches the branch below.
                    if liveEntriesPastMarker(dirCluster, entSector, entIdx)
                        if currentWindow == 0
                            fifo.put(@"  ERROR: Live entries stranded past end-of-directory marker")
                            fifo.putFmt1(@"         %s: rewriting the marker as a deleted-entry tombstone", repairTag())
                            v_errorCount++
                            v_repairCount++
                        ' $00 means "end of directory, stop"; $E5 means "deleted, keep
                        ' scanning". Rewriting the terminator as a tombstone makes the
                        ' stranded entries reachable to any conforming scan. No data is
                        ' invented -- a terminator becomes a tombstone, nothing more.
                        BYTE[pEntry] := sd.DIR_ENTRY_DELETED
                        doRepairWrite(sector + entSector, @buf)
                        next                                                    '  keep scanning: the entries beyond this are real
                    dirDone := true
                    quit

                ' Deleted entry, skip
                if name0 == sd.DIR_ENTRY_DELETED
                    next

                attr := BYTE[pEntry + sd.DE_ATTR_OFFSET]

                ' Long filename entry, skip
                if (attr & ATTR_LFN_MASK) == sd.ATTR_LFN
                    next

                ' Volume label, skip
                if attr & sd.ATTR_VOLUME_ID
                    next

                ' Skip . and .. entries
                if isDot(pEntry)
                    next

                ' Extract start cluster and file size
                startClus := WORD[pEntry + sd.DE_CLUS_LO_OFFSET] | (WORD[pEntry + sd.DE_CLUS_HI_OFFSET] << 16)
                fSize := LONG[pEntry + sd.DE_FILESIZE_OFFSET]

                if attr & sd.ATTR_DIRECTORY
                    ' --- Subdirectory ---
                    if startClus >= 2
                        if startClus < (totalClusters + 2)
                            fsckValidateChain(startClus, 0, true)
                            fsckScanDir(startClus)
                            ' Re-read our sector after recursion
                            if not readOrFail(sector + entSector, @buf)
                                dirDone := true                                 '  buf no longer holds this directory -- do not keep walking it
                                quit
                        elseif currentWindow == 0
                            fifo.putFmt1(@"  ERROR: Bad dir start cluster %d", startClus)
                            v_errorCount++
                    elseif startClus <> 0
                        if currentWindow == 0
                            fifo.putFmt1(@"  ERROR: Bad dir start cluster %d", startClus)
                            v_errorCount++
                else
                    ' --- Regular file ---
                    if currentWindow == 0
                        v_fileCount++
                    if startClus >= 2
                        if startClus < (totalClusters + 2)
                            fsckValidateChain(startClus, fSize, false)
                    if startClus == 0
                        if fSize > 0
                            if currentWindow == 0
                                fifo.putFmt1(@"  ERROR: File has size %d but no cluster", fSize)
                                v_errorCount++

        ' Advance to next cluster in directory chain
        if not dirDone
            nextClus := readFAT(dirCluster) & sd.FAT32_ENTRY_MASK
            if nextClus >= sd.FAT32_EOC_MIN
                quit
            if nextClus < 2
                if currentWindow == 0
                    fifo.putFmt1(@"  ERROR: Bad cluster in dir chain: %d", nextClus)
                    v_errorCount++
                quit
            if nextClus >= (totalClusters + 2)
                if currentWindow == 0
                    fifo.putFmt1(@"  ERROR: Bad cluster in dir chain: %d", nextClus)
                    v_errorCount++
                quit
            dirCluster := nextClus

    scanDepth--


PRI fsckValidateChain(startClus, fSize, isDir) | clus, nextClus, chainLen, expectedLen, fragCount
' Follow a cluster chain and validate integrity.
' Marks each visited cluster in the bitmap to detect cross-links.
' On window 0: repairs bad refs and reports errors.
' On windows >0: bitmap marking only (chains already repaired).
'
' @param startClus - First cluster of the chain
' @param fSize - Expected file size (0 for directories)
' @param isDir - TRUE if this chain belongs to a directory

    chainLen := 0
    fragCount := 1
    clus := startClus

    repeat while clus >= 2
        if clus >= (totalClusters + 2)
            quit

        ' Check for cross-link (cluster already referenced by another chain)
        if testBit(clus)
            if currentWindow == 0
                fifo.putFmt1(@"  ERROR: Cross-linked cluster %d", clus)
                v_errorCount++
            quit

        ' Mark cluster as referenced
        setBit(clus)
        chainLen++

        ' Safety: detect infinite loops
        if chainLen > MAX_CHAIN_LENGTH
            if currentWindow == 0
                fifo.putFmt1(@"  ERROR: Chain too long from cluster %d", startClus)
                v_errorCount++
            quit

        ' Read next cluster in chain
        nextClus := readFAT(clus) & sd.FAT32_ENTRY_MASK

        ' End of chain?
        if nextClus >= sd.FAT32_EOC_MIN
            quit

        ' Bad cluster reference?
        if nextClus < 2
            if currentWindow == 0
                fifo.putFmt1(@"  ERROR: Bad ref %d in chain", nextClus)
                writeFAT(clus, sd.FAT32_EOC_MARK)
                fifo.putFmt2(@"  %s: chain runs past the file size at cluster %d", repairTag(), clus)
                v_repairCount++
            quit

        if nextClus >= (totalClusters + 2)
            if nextClus <> FAT_BAD
                if currentWindow == 0
                    fifo.putFmt1(@"  ERROR: Bad ref %d in chain", nextClus)
                    writeFAT(clus, sd.FAT32_EOC_MARK)
                    fifo.putFmt2(@"  %s: chain runs past the file size at cluster %d", repairTag(), clus)
                    v_repairCount++
                quit

        ' Bad cluster marker - stop following
        if nextClus == FAT_BAD
            quit

        ' Detect fragment transitions (non-contiguous cluster)
        if nextClus <> clus + 1
            fragCount++

        clus := nextClus

    ' Track fragmentation statistics (window 0 only, files only)
    if currentWindow == 0
        if not isDir
            if chainLen > 0 and fragCount > 1
                v_fragmentedFileCount++
                v_totalFragments += fragCount

    ' For files, check chain length vs expected
    if currentWindow == 0
        if not isDir
            if fSize > 0
                expectedLen := (fSize + (sectorsPerCluster * sd.SECTOR_SIZE) - 1) / (sectorsPerCluster * sd.SECTOR_SIZE)
                if chainLen <> expectedLen
                    fifo.putFmt2(@"  WARNING: Chain %d clusters, expected %d", chainLen, expectedLen)
                    v_warningCount++


PRI liveEntriesPastMarker(dirCluster, fromEntSector, fromEntIdx) : bLive | clus, sec, entSector, entIdx, firstIdx, nameByte, hops
' Look past an end-of-directory marker for entries that are still alive.
'
' A $00 first byte is the normal terminator of every healthy directory, so it cannot be
' treated as damage by itself. It is damage only when real entries survive BEYOND it --
' then a conforming scan stops early and those files become unreachable, while their
' cluster chains still look unreferenced to the lost-cluster pass. That combination is
' what lets fsck free the chains and leave the entries pointing at them, so the files
' resurrect the moment the directory refills and the clusters have been handed to
' somebody else.
'
' Scans the remainder of the current sector, the remainder of the current cluster, and the
' rest of the directory's cluster chain. Uses buf2 so the caller's buf -- which holds the
' sector being walked -- is left untouched; buf2 is otherwise used only by passes 1 and 4.
'
' @param dirCluster - Cluster containing the marker
' @param fromEntSector - Sector offset within that cluster where the marker sits
' @param fromEntIdx - Entry index of the marker within that sector
' @returns bLive - TRUE if any live entry exists past the marker
' @local clus - Cluster being examined
' @local sec - First sector of clus
' @local entSector - Sector offset within clus
' @local entIdx - Entry index within the sector
' @local firstIdx - Where to start within the first sector examined
' @local nameByte - First byte of the entry under test
' @local hops - Chain-walk guard

    bLive := false
    clus := dirCluster
    hops := 0

    repeat while clus >= 2 and clus < (totalClusters + 2) and not bLive
        sec := clus2sec(clus)
        repeat entSector from fromEntSector to sectorsPerCluster - 1
            if not readOrFail(sec + entSector, @buf2)
                ' Unknown contents. Report NOTHING live: repairing a directory terminator
                ' on the strength of bytes we could not read would be the worse mistake,
                ' and readOrFail has already made the run non-CLEAN.
                return false
            ' Only the sector holding the marker starts part-way in; every later sector
            ' is examined from its first entry.
            firstIdx := 0
            if clus == dirCluster and entSector == fromEntSector
                firstIdx := fromEntIdx + 1
            repeat entIdx from firstIdx to ENTRIES_PER_SECTOR - 1
                nameByte := BYTE[@buf2 + (entIdx * sd.DIR_ENTRY_SIZE)]
                ' Anything that is neither a terminator nor a tombstone is a live entry.
                if nameByte <> DIR_END_MARKER and nameByte <> sd.DIR_ENTRY_DELETED
                    bLive := true
                    quit
            if bLive
                quit

        ' Later clusters are examined in full
        fromEntSector := 0

        hops++
        if hops > MAX_DIR_CHAIN_HOPS                                            '  refuse to ride a corrupt chain forever
            quit
        clus := readFAT(clus) & sd.FAT32_ENTRY_MASK
        if clus >= sd.FAT32_EOC_MIN
            quit


' =========================================================================
' FSCK Pass 3: Lost cluster recovery
' =========================================================================

PRI fsckPass3Window() | clus, fatVal, startClus
' Find and free lost clusters within the current bitmap window.
' A "lost" cluster is allocated in the FAT but not referenced by any directory entry.
' Called once per window from fsckPass2(). Running count kept in v_lostCount.

    startClus := windowStart #> 2
    repeat clus from startClus to windowEnd - 1
        if clus >= (totalClusters + 2)
            quit

        ' If not in bitmap, it was not referenced by any file/dir
        if not testBit(clus)
            fatVal := readFAT(clus) & sd.FAT32_ENTRY_MASK
            if fatVal <> FAT_FREE
                if fatVal <> FAT_BAD
                    ' Cluster is allocated but unreferenced - free it
                    writeFAT(clus, FAT_FREE)
                    v_lostCount++

    ' Flush any pending FAT writes after this window
    flushFAT()


' =========================================================================
' FSCK Pass 4: FAT sync + free count
' =========================================================================

PRI fsckPass4() | fatSector, entIdx, clus, fatVal, freeCount, syncCount, mismatch, idx, startRepairs
' Synchronize FAT1 -> FAT2 and correct the free cluster count.
' Reads each FAT1 sector, counts free entries, compares with FAT2, syncs if different.

    fifo.put(@"--- Pass 4: FAT Sync & Free Count ---")
    startRepairs := v_repairCount

    ' Ensure all prior FAT writes are flushed
    flushFAT()

    freeCount := 0
    syncCount := 0
    clus := 0

    repeat fatSector from 0 to sectorsPerFat - 1
        ' Read FAT1 sector
        if not readOrFail(fat1Start + fatSector, @buf)
            quit                                                                '  a FAT mismatch reported from stale bytes would be a lie

        ' Count free clusters in this sector
        repeat entIdx from 0 to FAT_ENTRIES_PER_SECTOR - 1
            if clus >= 2
                if clus < (totalClusters + 2)
                    fatVal := LONG[@buf + (entIdx * 4)] & sd.FAT32_ENTRY_MASK
                    if fatVal == FAT_FREE
                        freeCount++
            clus++

        ' Read FAT2 sector and compare
        if not readOrFail(fat2Start + fatSector, @buf2)
            quit

        mismatch := false
        repeat idx from 0 to sd.SECTOR_SIZE - 1
            if buf[idx] <> buf2[idx]
                mismatch := true
                quit

        if mismatch
            ' Copy FAT1 to FAT2
            doRepairWrite(fat2Start + fatSector, @buf)
            syncCount++

    if syncCount > 0
        fifo.putFmt2(@"  %s: %d FAT sectors out of sync with the backup", repairTag(), syncCount)
        v_repairCount += syncCount
    else
        fifo.put(@"  [OK] FAT1 and FAT2 in sync")

    fifo.putFmt1(@"  Free clusters: %d", freeCount)

    ' Update FSInfo free cluster count
    if not readOrFail(partitionStart + 1, @buf)
        return

    if LONG[@buf + FSINFO_FREE_COUNT_OFFSET] <> freeCount
        fifo.putFmt3(@"  %s: FSInfo free count wrong (says %d, actually %d)", repairTag(), LONG[@buf + FSINFO_FREE_COUNT_OFFSET], freeCount)
        LONG[@buf + FSINFO_FREE_COUNT_OFFSET] := freeCount
        doRepairWrite(partitionStart + 1, @buf)
        ' Update backup FSInfo too
        doRepairWrite(partitionStart + 7, @buf)
        v_repairCount++
    else
        fifo.put(@"  [OK] FSInfo free count correct")

    fifo.putFmt1(@"  Pass 4: %d repairs", v_repairCount - startRepairs)
    fifo.put(@" ")


' =========================================================================
' FAT cache methods
' =========================================================================

PRI repairTag() : pStr
' Voice for every repair line: "REPAIR" when the fix was applied, "WOULD REPAIR"
' on a read-only audit. Single choke point - a new repair site gets the correct
' voice for free by formatting %s with this, exactly as doRepairWrite() is
' the single choke point that makes MODE_AUDIT's read-only guarantee structural.

    if dryRun
        pStr := @tagWould
    else
        pStr := @tagRepair


PRI readFAT(cluster) : value | sector, offset
' Read a FAT entry with sector caching.
'
' If the cache fill fails the entry cannot be known. Returning whatever the PREVIOUS FAT
' sector left in the buffer would send every chain walk off into unrelated clusters, so
' the buffer is zeroed instead: the entry reads as FAT_FREE, which the walkers already
' treat as "no link here" rather than following it somewhere wrong. readOrFail has already
' reported the failure and made the run non-CLEAN.
'
' @param cluster - Cluster number to read
' @returns value - Raw 32-bit FAT entry, or FAT_FREE if the sector could not be read

    sector := fat1Start + (cluster >> CLUSTER_SHIFT)
    offset := (cluster & CLUSTER_OFFSET_MASK) * 4

    if sector <> fatBufSector
        flushFAT()
        if not readOrFail(sector, @fatBuf)
            longfill(@fatBuf, FAT_FREE, FAT_ENTRIES_PER_SECTOR)                 '  never hand back the previous sector's links
        fatBufSector := sector

    value := LONG[@fatBuf + offset]


PRI writeFAT(cluster, value) | sector, offset, existing
' Write a FAT entry with sector caching. Preserves upper 4 reserved bits.
'
' THIS IS A READ-MODIFY-WRITE over a whole FAT sector: 128 entries are read into the
' cache, one is changed, and the sector is written back. If the read fails, flushing the
' cache would overwrite 127 live FAT entries with whatever was in the buffer -- turning an
' unreadable sector into a destroyed one. So a failed fill abandons the repair entirely.
' The entry stays as it was on the card, and readOrFail has reported why.
'
' @param cluster - Cluster number to write
' @param value - New FAT entry value (only lower 28 bits used)

    sector := fat1Start + (cluster >> CLUSTER_SHIFT)
    offset := (cluster & CLUSTER_OFFSET_MASK) * 4

    if sector <> fatBufSector
        flushFAT()
        if not readOrFail(sector, @fatBuf)
            fatBufSector := -1                                                  '  cache holds nothing trustworthy
            fatBufDirty := false                                                '  and must never be flushed over a live FAT sector
            return
        fatBufSector := sector

    existing := LONG[@fatBuf + offset]
    LONG[@fatBuf + offset] := (value & sd.FAT32_ENTRY_MASK) | (existing & $F0000000)
    fatBufDirty := true


PRI flushFAT()
' Write cached FAT sector to disk (both FAT1 and FAT2) if dirty.

    if fatBufDirty
        if fatBufSector >= 0
            doRepairWrite(fatBufSector, @fatBuf)
            doRepairWrite(fatBufSector - fat1Start + fat2Start, @fatBuf)
            fatBufDirty := false


' =========================================================================
' Cluster bitmap methods
' =========================================================================

PRI clus2sec(cluster) : sector
' Convert cluster number to absolute sector number.
'
' @param cluster - Cluster number (2-based)
' @returns sector - Absolute LBA sector number

    sector := dataStart + ((cluster - 2) * sectorsPerCluster)


PRI setBit(cluster) | idx
' Set a bit in the cluster bitmap (window-relative).
' Clusters outside the current window are silently ignored.
'
' @param cluster - Cluster number to mark

    if cluster >= windowStart and cluster < windowEnd
        idx := cluster - windowStart
        bitmapData[idx >> 5] |= (1 << (idx & BIT_INDEX_MASK))


PRI testBit(cluster) : bSet | idx
' Test whether a cluster is marked in the bitmap (window-relative).
' Returns FALSE for clusters outside the current window.
'
' @param cluster - Cluster number to test
' @returns bSet - TRUE (non-zero) if marked

    bSet := false
    if cluster >= windowStart and cluster < windowEnd
        idx := cluster - windowStart
        bSet := (bitmapData[idx >> 5] >> (idx & BIT_INDEX_MASK)) & 1


PRI isDot(pEntry) : bIsDot
' Check if a directory entry is the "." or ".." special entry.
'
' @param pEntry - Pointer to 32-byte directory entry
' @returns bIsDot - TRUE if entry is . or ..

    bIsDot := false
    if BYTE[pEntry] == "."
        if BYTE[pEntry + 1] == " "
            bIsDot := true
        if BYTE[pEntry + 1] == "."
            bIsDot := true


