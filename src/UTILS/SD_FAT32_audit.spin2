'' =========================================================================================
''
''   File....... SD_FAT32_audit.spin2
''   Purpose.... FAT32 filesystem audit -- the full 4-pass scan, read-only.
''               Same engine as fsck (structural integrity, chain validation,
''               lost-cluster detection, free-count) but writes nothing.
''               Thin wrapper around isp_fsck_utility.startAudit().
''   Author..... Stephen M Moraco
''   E-mail..... stephen@ironsheep.biz
''   Started.... JAN 2026
''   Updated.... 24 JUL 2026
''
'' =========================================================================================

{ Description:
   Thin wrapper that launches the Audit library in a temporary cog
   and displays output via debug(). Read-only -- does not modify card.
}

CON

    _CLKFREQ        = 320_000_000

    ' SD card pin assignments
    ' Default: P2 Edge module SD slot. Build with -D SD_PINS_EXTERNAL
    ' to use the external SD header (base pin 16).
#ifdef SD_PINS_EXTERNAL
    SD_CS   = 20
    SD_MOSI = 19
    SD_MISO = 18
    SD_SCK  = 21
#else
    SD_CS   = 60
    SD_MOSI = 59
    SD_MISO = 58
    SD_SCK  = 61
#endif
OBJ

    fsck : "isp_fsck_utility"

PUB go() | pStr
'' Main entry point - runs FAT32 filesystem audit.

    debug("==============================================")
    debug("  FAT32 Audit (via isp_fsck_utility)")
    debug("==============================================")
    debug(" ")

    if fsck.startAudit(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
        ' Pump FIFO output to debug
        repeat
            pStr := fsck.getOutput()
            if pStr
                debug(zstr_(pStr))
            elseif fsck.isDone()
                ' Drain any remaining output
                repeat while (pStr := fsck.getOutput())
                    debug(zstr_(pStr))
                quit

        fsck.stop()
    else
        debug("FATAL: Could not start Audit cog")

    ' Drain the headless terminal log backlog before END_SESSION triggers
    ' shutdown -- without this the last emitted line (STATUS:) is cut off.
    waitms(500)
    debug(" ")
    debug("END_SESSION")

con { license }

