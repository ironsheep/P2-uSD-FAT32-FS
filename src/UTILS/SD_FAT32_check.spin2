'' =========================================================================================
''
''   File....... SD_FAT32_check.spin2
''   Purpose.... FAT32 filesystem check-only utility -- runs full 4-pass fsck logic with
''               zero writes (reports every repair that fsck WOULD perform). Safe to run
''               on any card. Thin wrapper around isp_fsck_utility.startCheck().
''   Author..... Stephen M Moraco
''   E-mail..... stephen@ironsheep.biz
''   Started.... MAY 2026
''
'' =========================================================================================

{ Description:
   Thin wrapper that launches the check-only (dry-run) FSCK in a temporary cog
   and displays output via debug(). Useful for verifying that fsck would not
   make spurious changes to a healthy filesystem before running real fsck.
}

CON

    _CLKFREQ        = 320_000_000
    DEBUG_BAUD      = 2_000_000

    ' SD card pin assignments
    ' Default: P2 Edge module SD slot. Build with -D SD_PINS_EXTERNAL
    ' to use the external SD header (base pin 16).
#ifdef SD_PINS_EXTERNAL
    SD_CS   = 20
    SD_MOSI = 19
    SD_MISO = 18
    SD_SCK  = 21
#else
    SD_CS   = 60
    SD_MOSI = 59
    SD_MISO = 58
    SD_SCK  = 61
#endif
OBJ

    fsck : "isp_fsck_utility"

PUB go() | pStr
'' Main entry point - runs FAT32 filesystem check (dry-run, no writes).

    debug("==============================================")
    debug("  FAT32 CHECK (dry-run, via isp_fsck_utility)")
    debug("==============================================")
    debug(" ")

    if fsck.startCheck(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
        ' Pump FIFO output to debug
        repeat
            pStr := fsck.getOutput()
            if pStr
                debug(zstr_(pStr))
            elseif fsck.isDone()
                ' Drain any remaining output
                repeat while (pStr := fsck.getOutput())
                    debug(zstr_(pStr))
                quit

        fsck.stop()
    else
        debug("FATAL: Could not start CHECK cog")

    debug(" ")
    debug("END_SESSION")

con { license }

