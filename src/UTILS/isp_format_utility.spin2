{{ =================================================================================================

   File....... isp_format_utility.spin2
   Purpose.... FAT32 format utility for SD cards using the micro_sd_fat32_fs
   Author..... Stephen M Moraco
               -- see below for terms of use
   E-mail..... stephen@ironsheep.biz
   Started.... JAN 2026
   Updated.... 16 JAN 2026

   This utility formats an SD card with a FAT32 filesystem.

   USAGE:
     fmt.format(cs, mosi, miso, sck)                    ' Format with default label "P2-XFER"
     fmt.formatWithLabel(cs, mosi, miso, sck, @"MYCARD")  ' Format with custom label (max 11 chars)

   WARNING: This will ERASE ALL DATA on the card!

================================================================================================= }}

CON

    DEBUG_DISABLE = 0   ' Enable debug output

    ' FAT32 formatting parameters (values NOT exported by driver)
    RESERVED_SECTORS    = 32              ' Standard for FAT32
    FAT32_MEDIA_TYPE    = $0FFFFFF8       ' Media descriptor in FAT[0]
    FSINFO_TRAIL_SIG    = $AA550000       ' FSInfo trailing signature

    ' Multi-sector write batch size for initFAT/initRootDirectory
    MULTI_BATCH_SIZE    = 64              ' Sectors per CMD25 batch (32 KB)

    ' VBR/BPB byte offsets
    BPB_OEM_NAME        = $03
    BPB_BYTES_PER_SEC   = $0B
    BPB_SEC_PER_CLUS    = $0D
    BPB_RESERVED_SECS   = $0E
    BPB_NUM_FATS        = $10
    BPB_ROOT_ENTRY_CT   = $11
    BPB_TOTAL_SEC_16    = $13
    BPB_MEDIA_TYPE      = $15
    BPB_FAT_SIZE_16     = $16
    BPB_SEC_PER_TRACK   = $18
    BPB_NUM_HEADS       = $1A
    BPB_HIDDEN_SECS     = $1C
    BPB_TOTAL_SEC_32    = $20
    BPB_FAT_SIZE_32     = $24
    BPB_EXT_FLAGS       = $28
    BPB_FS_VERSION      = $2A
    BPB_ROOT_CLUSTER    = $2C
    BPB_FSINFO_SEC      = $30
    BPB_BACKUP_BOOT_SEC = $32
    BPB_DRIVE_NUM       = $40
    BPB_EXT_BOOT_SIG    = $42
    BPB_VOLUME_SERIAL   = $43
    BPB_VOLUME_LABEL    = $47
    BPB_FS_TYPE         = $52

    ' VBR field values
    VBR_JUMP_BYTE0      = $EB
    VBR_JUMP_BYTE2      = $90
    MEDIA_TYPE_FIXED    = $F8
    DRIVE_NUM_HDD       = $80
    EXT_BOOT_SIG_VAL    = $29

    ' FSInfo field offsets
    FSINFO_SIG2_OFF        = $1E4
    FSINFO_FREE_COUNT_OFF  = $1E8
    FSINFO_NEXT_FREE_OFF   = $1EC

    ' MBR partition sub-offsets
    MBR_PART_TYPE_OFF   = $1C2
    MBR_PART_LBA_START  = $1C6
    MBR_PART_LBA_SIZE   = $1CA

    ' Geometry constants
    VOLUME_LABEL_LEN        = 11
    PARTITION_ALIGN_SECTOR  = 8192
    BACKUP_VBR_OFFSET       = 6
    FSINFO_SECTOR_OFFSET    = 1
    MIN_FAT32_CLUSTERS      = 65525

    ' Volume label (11 chars, space padded) - "P2-XFER    "
    DEFAULT_LABEL_0     = $58_2D_32_50    ' "P2-X" (little endian: P, 2, -, X)
    DEFAULT_LABEL_1     = $20_52_45_46    ' "FER " (little endian: F, E, R, space)
    DEFAULT_LABEL_2     = $00_20_20_20    ' "   " + null (spaces to pad to 11)

' Enable full driver features for this utility
#ifdef __SPINTOOLS__
#define SD_INCLUDE_ALL
#elseifdef __FLEXSPIN__
#define SD_INCLUDE_ALL
#pragma exportdef SD_INCLUDE_ALL
#else
#pragma exportdef SD_INCLUDE_ALL
#endif

    ' Cog stack for async format
    FMT_STACK_LONGS   = 256
    FMT_GUARD_LONGS   = 4
    FMT_GUARD_BYTE    = $CC

OBJ

    sd   : "micro_sd_fat32_fs"           ' Use V3 driver with smart pins for formatting
    fifo : "isp_string_fifo"            ' FIFO for cog-based output

VAR

    ' Pin configuration
    LONG    pinCS, pinMOSI, pinMISO, pinSCK

    ' Sector buffer
    BYTE    buf[sd.SECTOR_SIZE]
    BYTE    verifyBuf[sd.SECTOR_SIZE]
    BYTE    zeroBuf[MULTI_BATCH_SIZE * sd.SECTOR_SIZE]  ' 32 KB zero buffer for CMD25 batches

    ' Card geometry
    LONG    totalSectors
    LONG    sectorsPerCluster
    LONG    sectorsPerFat
    LONG    dataSectors
    LONG    totalClusters
    LONG    partitionStart      ' LBA of partition start (VBR)
    LONG    fat1Start           ' LBA of first FAT
    LONG    fat2Start           ' LBA of second FAT
    LONG    dataStart           ' LBA of data area

    ' Volume label (12 bytes: 11 chars + null)
    BYTE    volumeLabel[12]

DAT { singleton cog state for async format }

fmt_cog_id    LONG    -1                 ' cog number (-1 = not running)
fmt_op_done   LONG    0                  ' TRUE when cog finished
fmt_op_result LONG    0                  ' TRUE if format succeeded

fmt_cog_stack LONG    0[FMT_STACK_LONGS]
fmt_cog_guard LONG    0[FMT_GUARD_LONGS]


'' =========================================================================
'' Synchronous API (existing - unchanged)
'' =========================================================================

PUB format(cs, mosi, miso, sck) : result
'' Format the SD card with default volume label "P2-XFER".
''
'' @param cs - Chip Select pin number
'' @param mosi - Master Out Slave In pin number
'' @param miso - Master In Slave Out pin number
'' @param sck - Serial Clock pin number
'' @returns result - TRUE if successful, FALSE if failed

    pinCS := cs
    pinMOSI := mosi
    pinMISO := miso
    pinSCK := sck
    setDefaultLabel()
    result := doFormat()

PUB formatWithLabel(cs, mosi, miso, sck, pLabel) : result | idx, ch
'' Format the SD card with a custom volume label.
''
'' @param cs - Chip Select pin number
'' @param mosi - Master Out Slave In pin number
'' @param miso - Master In Slave Out pin number
'' @param sck - Serial Clock pin number
'' @param pLabel - Pointer to null-terminated string (max 11 chars)
'' @returns result - TRUE if successful, FALSE if failed

    pinCS := cs
    pinMOSI := mosi
    pinMISO := miso
    pinSCK := sck

    ' Copy and pad label to 11 characters
    bytefill(@volumeLabel, " ", 11)
    volumeLabel[11] := 0

    idx := 0
    repeat while idx < 11
        ch := BYTE[pLabel][idx]
        if ch == 0
            quit
        ' Convert to uppercase for FAT compatibility
        if ch >= "a" and ch <= "z"
            ch -= 32
        volumeLabel[idx] := ch
        idx++

    result := doFormat()

PUB stop()
'' Stop the driver worker cog and release SPI pins.
'' Call this after format() or formatWithLabel() to allow other drivers to use the card.

    sd.stop()


'' =========================================================================
'' Cog-based (asynchronous) API - for use from demo shell
'' =========================================================================

PUB startFormat(cs, mosi, miso, sck) : ok
'' Launch format with default label in a new cog
''
'' @param cs, mosi, miso, sck - SD pin configuration
'' @returns ok - TRUE if cog launched successfully

    pinCS := cs
    pinMOSI := mosi
    pinMISO := miso
    pinSCK := sck
    setDefaultLabel()
    ok := doStartCog()


PUB startFormatWithLabel(cs, mosi, miso, sck, pLabel) : ok | idx, ch
'' Launch format with custom label in a new cog
''
'' @param cs, mosi, miso, sck - SD pin configuration
'' @param pLabel - Pointer to null-terminated string (max 11 chars)
'' @returns ok - TRUE if cog launched successfully

    pinCS := cs
    pinMOSI := mosi
    pinMISO := miso
    pinSCK := sck

    ' Copy and pad label to 11 characters
    bytefill(@volumeLabel, " ", 11)
    volumeLabel[11] := 0

    idx := 0
    repeat while idx < 11
        ch := BYTE[pLabel][idx]
        if ch == 0
            quit
        if ch >= "a"
            if ch <= "z"
                ch -= 32
        volumeLabel[idx] := ch
        idx++

    ok := doStartCog()


PUB hasOutput() : yes
'' Check if the format utility has produced output strings
''
'' @returns yes - TRUE if strings are waiting in the FIFO

    yes := fifo.hasOutput()


PUB getOutput() : pStr
'' Get the next output string
''
'' @returns pStr - pointer to string, or 0 if empty

    pStr := fifo.getOutput()


PUB isDone() : yes
'' Check if the format cog has finished
''
'' @returns yes - TRUE if the cog has completed

    yes := (fmt_op_done <> 0)


PUB getResult() : ok
'' Get the format result after isDone() returns TRUE
''
'' @returns ok - TRUE if format succeeded, FALSE if failed

    ok := fmt_op_result


PUB stopCog()
'' Stop the format cog and clean up SD driver
'' Safe to call even if cog already finished

    if fmt_cog_id >= 0
        cogstop(fmt_cog_id)
    fmt_cog_id := -1
    sd.stop()


' =========================================================================
' Cog launch and entry point (private)
' =========================================================================

PRI doStartCog() : ok
' Initialize FIFO and launch format cog
'
' @returns ok - TRUE if cog launched

    fmt_op_done := false
    fmt_op_result := false

    fifo.init()

    bytefill(@fmt_cog_guard, FMT_GUARD_BYTE, FMT_GUARD_LONGS * 4)

    fmt_cog_id := cogspin(NEWCOG, runInCog(), @fmt_cog_stack)
    ok := (fmt_cog_id >= 0)


PRI runInCog() | result
' Cog entry point for async format.
' When this method returns, the cog stops automatically.

    result := doFormatCog()
    sd.stop()
    fmt_op_result := result
    fmt_op_done := true


PRI doFormatCog() : result | ok
' Execute the format operation with FIFO output instead of debug().
' Calls the same write methods (writeMBR, writeVBR, etc.) as doFormat().
'
' @returns result - TRUE if all steps succeeded

    result := false

    fifo.put(@"=== SD Card FAT32 Formatter ===")
    fifo.putFmt1(@"Volume Label: %s", @volumeLabel)
    fifo.put(@" ")

    ' Initialize card
    fifo.put(@"Initializing SD card...")
    ok := (sd.initCardOnly(pinCS, pinMOSI, pinMISO, pinSCK) >= 0)
    if not ok
        fifo.put(@"ERROR: Could not initialize SD card!")

    ' Get card size
    if ok
        totalSectors := sd.cardSizeSectors()
        ok := (totalSectors <> 0)
        if not ok
            fifo.put(@"ERROR: Could not read card size!")

    if ok
        fifo.putFmt2(@"Card: %d sectors (%d MB)", totalSectors, totalSectors / 2048)

        ' Calculate filesystem parameters
        ok := calculateParameters()
        if not ok
            fifo.put(@"ERROR: Card too small for FAT32!")

    if ok
        fifo.putFmt1(@"Sectors/cluster: %d", sectorsPerCluster)
        fifo.putFmt1(@"Sectors/FAT: %d", sectorsPerFat)
        fifo.putFmt1(@"Total clusters: %d", totalClusters)

        ' Write MBR
        fifo.put(@"Writing MBR...")
        ok := writeMBR()
        if not ok
            fifo.put(@"ERROR: Failed to write MBR!")

    if ok
        ' Write VBR
        fifo.put(@"Writing VBR...")
        ok := writeVBR()
        if not ok
            fifo.put(@"ERROR: Failed to write VBR!")

    if ok
        ' Write FSInfo
        fifo.put(@"Writing FSInfo...")
        ok := writeFSInfo()
        if not ok
            fifo.put(@"ERROR: Failed to write FSInfo!")

    if ok
        ' Write backup boot
        fifo.put(@"Writing backup boot...")
        ok := writeBackupBoot()
        if not ok
            fifo.put(@"ERROR: Failed to write backup boot!")

    if ok
        ' Initialize FAT tables
        fifo.put(@"Initializing FAT1...")
        ok := initFAT(fat1Start)
        if not ok
            fifo.put(@"ERROR: Failed to initialize FAT1!")

    if ok
        fifo.put(@"Initializing FAT2...")
        ok := initFAT(fat2Start)
        if not ok
            fifo.put(@"ERROR: Failed to initialize FAT2!")

    if ok
        ' Initialize root directory
        fifo.put(@"Initializing root directory...")
        ok := initRootDirectory()
        if not ok
            fifo.put(@"ERROR: Failed to initialize root directory!")

    if ok
        fifo.put(@" ")
        fifo.put(@"=== FORMAT COMPLETE ===")
        fifo.putFmt1(@"Volume: %s", @volumeLabel)
        fifo.putFmt2(@"Size: %d MB, Clusters: %d", totalSectors / 2048, totalClusters)
        result := true


PRI setDefaultLabel()
' Set default volume label "P2-XFER" (11 chars, space padded).

    ' Set default label "P2-XFER    " (11 chars, space padded)
    LONG[@volumeLabel][0] := DEFAULT_LABEL_0
    LONG[@volumeLabel][1] := DEFAULT_LABEL_1
    BYTE[@volumeLabel][8] := " "
    BYTE[@volumeLabel][9] := " "
    BYTE[@volumeLabel][10] := " "
    volumeLabel[11] := 0

PRI doFormat() : result | ok
' Execute the format operation: MBR, VBR, FSInfo, FAT tables, root directory.
'
' @returns result - TRUE if all steps succeeded, FALSE otherwise

    result := false

    debug("==============================================")
    debug("  SD Card FAT32 Formatter")
    debug("  Volume Label: [", zstr_(@volumeLabel), "]")
    debug("==============================================")
    debug(" ")

    ' Initialize card (low-level, no filesystem mount)
    debug("* Initializing SD card...")
    ok := (sd.initCardOnly(pinCS, pinMOSI, pinMISO, pinSCK) >= 0)
    if not ok
        debug("ERROR: Could not initialize SD card!")

    ' Get card size
    if ok
        debug("* Reading card size...")
        totalSectors := sd.cardSizeSectors()
        ok := (totalSectors <> 0)
        if not ok
            debug("ERROR: Could not read card size!")

    if ok
        debug("  Total sectors: ", udec_(totalSectors))
        debug("  Card size: ", udec_(totalSectors / 2048), " MB")

        ' Calculate filesystem parameters
        debug("* Calculating filesystem parameters...")
        ok := calculateParameters()
        if not ok
            debug("ERROR: Card too small for FAT32!")

    if ok
        debug("  Sectors/cluster: ", udec_(sectorsPerCluster))
        debug("  Sectors/FAT: ", udec_(sectorsPerFat))
        debug("  Total clusters: ", udec_(totalClusters))
        debug("  Partition start: ", udec_(partitionStart))
        debug("  FAT1 start: ", udec_(fat1Start))
        debug("  FAT2 start: ", udec_(fat2Start))
        debug("  Data start: ", udec_(dataStart))

        ' Write MBR
        debug(" ")
        debug("* Writing MBR...")
        ok := writeMBR()
        if not ok
            debug("ERROR: Failed to write MBR!")
            showWriteDiag()

    if ok
        ' Verify MBR read-back
        sd.readSectorRaw(0, @verifyBuf)
#ifdef __FLEXSPIN__
        debug("  MBR readback: sig=$", uhex_word_(WORD[@verifyBuf + sd.BOOT_SIG_OFFSET]), " type=$", uhex_byte_(verifyBuf[MBR_PART_TYPE_OFF]), " start=", udec_(LONG[@verifyBuf + MBR_PART_LBA_START]))
        debug("  MBR read[0..7]: $", uhex_byte_(verifyBuf[0]), " $", uhex_byte_(verifyBuf[1]), " $", uhex_byte_(verifyBuf[2]), " $", uhex_byte_(verifyBuf[3]), " $", uhex_byte_(verifyBuf[4]), " $", uhex_byte_(verifyBuf[5]), " $", uhex_byte_(verifyBuf[6]), " $", uhex_byte_(verifyBuf[7]))
#else
        debug("  MBR readback: sig=$", uhex_word_(WORD[@verifyBuf + sd.BOOT_SIG_OFFSET]), ...
          " type=$", uhex_byte_(verifyBuf[MBR_PART_TYPE_OFF]), ...
          " start=", udec_(LONG[@verifyBuf + MBR_PART_LBA_START]))
        debug("  MBR read[0..7]: $", uhex_byte_(verifyBuf[0]), " $", uhex_byte_(verifyBuf[1]), ...
          " $", uhex_byte_(verifyBuf[2]), " $", uhex_byte_(verifyBuf[3]), ...
          " $", uhex_byte_(verifyBuf[4]), " $", uhex_byte_(verifyBuf[5]), ...
          " $", uhex_byte_(verifyBuf[6]), " $", uhex_byte_(verifyBuf[7]))
#endif
        debug("  verify buf addr: $", uhex_long_(@verifyBuf))
        if WORD[@verifyBuf + sd.BOOT_SIG_OFFSET] <> sd.BOOT_SIGNATURE
            debug("  *** MBR READBACK MISMATCH! Written data not on card ***")

        ' Write VBR (Volume Boot Record)
        debug("* Writing VBR...")
        ok := writeVBR()
        if not ok
            debug("ERROR: Failed to write VBR!")
            showWriteDiag()

    if ok
        ' Verify VBR read-back
        sd.readSectorRaw(partitionStart, @verifyBuf)
#ifdef __FLEXSPIN__
        debug("  VBR readback: jump=$", uhex_byte_(verifyBuf[0]), " OEM=$", uhex_byte_(verifyBuf[BPB_OEM_NAME]), uhex_byte_(verifyBuf[BPB_OEM_NAME + 1]), " bps=", udec_(WORD[@verifyBuf + BPB_BYTES_PER_SEC]), " spc=", udec_(verifyBuf[BPB_SEC_PER_CLUS]), " sig=$", uhex_word_(WORD[@verifyBuf + sd.BOOT_SIG_OFFSET]))
#else
        debug("  VBR readback: jump=$", uhex_byte_(verifyBuf[0]), ...
          " OEM=$", uhex_byte_(verifyBuf[BPB_OEM_NAME]), uhex_byte_(verifyBuf[BPB_OEM_NAME + 1]), ...
          " bps=", udec_(WORD[@verifyBuf + BPB_BYTES_PER_SEC]), ...
          " spc=", udec_(verifyBuf[BPB_SEC_PER_CLUS]), ...
          " sig=$", uhex_word_(WORD[@verifyBuf + sd.BOOT_SIG_OFFSET]))
#endif
        if verifyBuf[0] <> VBR_JUMP_BYTE0
            debug("  *** VBR READBACK MISMATCH! Expected $EB got $", uhex_byte_(verifyBuf[0]), " ***")

        ' Write FSInfo sector
        debug("* Writing FSInfo...")
        ok := writeFSInfo()
        if not ok
            debug("ERROR: Failed to write FSInfo!")

    if ok
        ' Write backup boot sector
        debug("* Writing backup boot sector...")
        ok := writeBackupBoot()
        if not ok
            debug("ERROR: Failed to write backup boot!")

    if ok
        ' Initialize FAT tables
        debug("* Initializing FAT1...")
        ok := initFAT(fat1Start)
        if not ok
            debug("ERROR: Failed to initialize FAT1!")

    if ok
        debug("* Initializing FAT2...")
        ok := initFAT(fat2Start)
        if not ok
            debug("ERROR: Failed to initialize FAT2!")

    if ok
        ' Initialize root directory
        debug("* Initializing root directory...")
        ok := initRootDirectory()
        if not ok
            debug("ERROR: Failed to initialize root directory!")

    if ok
        debug(" ")
        debug("==============================================")
        debug("  FORMAT COMPLETE")
        debug("  Volume: [", zstr_(@volumeLabel), "]")
        debug("  Size: ", udec_(totalSectors / 2048), " MB")
        debug("  Clusters: ", udec_(totalClusters))
        debug("==============================================")
        result := true

PRI calculateParameters() : success
' Calculate filesystem parameters based on card size.
'
' @returns success - TRUE if card large enough for FAT32, FALSE otherwise

    success := false

    ' Partition starts at sector 8192 (4MB aligned for modern cards)
    partitionStart := PARTITION_ALIGN_SECTOR

    ' Calculate data sectors available
    dataSectors := totalSectors - partitionStart

    ' Determine sectors per cluster based on volume size
    ' Microsoft recommends:
    '   <= 8GB:   8 sectors (4KB clusters)
    '   <= 16GB: 16 sectors (8KB clusters)
    '   <= 32GB: 32 sectors (16KB clusters)
    '   > 32GB:  64 sectors (32KB clusters)

    if dataSectors <= 16_777_216        ' <= 8GB
        sectorsPerCluster := 8
    elseif dataSectors <= 33_554_432    ' <= 16GB
        sectorsPerCluster := 16
    elseif dataSectors <= 67_108_864    ' <= 32GB
        sectorsPerCluster := 32
    else
        sectorsPerCluster := 64

    ' Calculate sectors per FAT
    ' Formula: sectorsPerFat = (dataSectors - RESERVED) / (clusterSize * 2 / 4 + sd.EXPECTED_FAT_COUNT)
    ' Simplified approximation that works well:
    totalClusters := (dataSectors - RESERVED_SECTORS) / sectorsPerCluster
    sectorsPerFat := (totalClusters * 4 + sd.SECTOR_SIZE - 1) / sd.SECTOR_SIZE

    ' Recalculate actual data area
    fat1Start := partitionStart + RESERVED_SECTORS
    fat2Start := fat1Start + sectorsPerFat
    dataStart := fat2Start + sectorsPerFat

    ' Recalculate total clusters with actual layout
    dataSectors := totalSectors - dataStart
    totalClusters := dataSectors / sectorsPerCluster

    ' FAT32 requires at least 65525 clusters
    if totalClusters >= MIN_FAT32_CLUSTERS
        success := true

PRI writeMBR() : success | partitionSectors
' Write the Master Boot Record (sector 0) with partition table.
'
' @returns success - TRUE if write succeeded, FALSE otherwise

    ' Clear buffer
    bytefill(@buf, 0, sd.SECTOR_SIZE)

    ' Partition table entry at offset $1BE (446)
    partitionSectors := totalSectors - partitionStart

    buf[sd.MBR_PARTITION_OFFSET] := $00                    ' Boot indicator (not bootable)
    buf[sd.MBR_PARTITION_OFFSET + 1] := $00                ' Starting head (CHS - ignored for LBA)
    buf[sd.MBR_PARTITION_OFFSET + 2] := $00                ' Starting sector (CHS)
    buf[sd.MBR_PARTITION_OFFSET + 3] := $00                ' Starting cylinder (CHS)
    buf[MBR_PART_TYPE_OFF] := sd.PART_TYPE_FAT32_LBA       ' Partition type
    buf[MBR_PART_TYPE_OFF + 1] := $FE                      ' Ending head (CHS)
    buf[MBR_PART_TYPE_OFF + 2] := $FF                      ' Ending sector (CHS)
    buf[MBR_PART_TYPE_OFF + 3] := $FF                      ' Ending cylinder (CHS)

    ' Partition start LBA (little endian)
    LONG[@buf + MBR_PART_LBA_START] := partitionStart

    ' Partition size in sectors (little endian)
    LONG[@buf + MBR_PART_LBA_SIZE] := partitionSectors

    ' MBR signature
    WORD[@buf + sd.BOOT_SIG_OFFSET] := sd.BOOT_SIGNATURE

    ' Diagnostic: dump write buffer before writing
#ifdef __FLEXSPIN__
    debug("  MBR write buf: sig=$", uhex_word_(WORD[@buf + sd.BOOT_SIG_OFFSET]), " type=$", uhex_byte_(buf[MBR_PART_TYPE_OFF]), " start=", udec_(LONG[@buf + MBR_PART_LBA_START]))
    debug("  MBR buf[0..7]: $", uhex_byte_(buf[0]), " $", uhex_byte_(buf[1]), " $", uhex_byte_(buf[2]), " $", uhex_byte_(buf[3]), " $", uhex_byte_(buf[4]), " $", uhex_byte_(buf[5]), " $", uhex_byte_(buf[6]), " $", uhex_byte_(buf[7]))
#else
    debug("  MBR write buf: sig=$", uhex_word_(WORD[@buf + sd.BOOT_SIG_OFFSET]), ...
      " type=$", uhex_byte_(buf[MBR_PART_TYPE_OFF]), ...
      " start=", udec_(LONG[@buf + MBR_PART_LBA_START]))
    debug("  MBR buf[0..7]: $", uhex_byte_(buf[0]), " $", uhex_byte_(buf[1]), ...
      " $", uhex_byte_(buf[2]), " $", uhex_byte_(buf[3]), ...
      " $", uhex_byte_(buf[4]), " $", uhex_byte_(buf[5]), ...
      " $", uhex_byte_(buf[6]), " $", uhex_byte_(buf[7]))
#endif
    debug("  MBR buf addr: $", uhex_long_(@buf))

    ' Write MBR to sector 0
    success := (sd.writeSectorRaw(0, @buf) == sd.SUCCESS)

PRI writeVBR() : success
' Write the Volume Boot Record (first sector of partition).
'
' @returns success - TRUE if write succeeded, FALSE otherwise

    ' Clear buffer
    bytefill(@buf, 0, sd.SECTOR_SIZE)

    ' Jump instruction
    buf[$00] := VBR_JUMP_BYTE0
    buf[$01] := $58
    buf[$02] := VBR_JUMP_BYTE2

    ' OEM name (8 bytes)
    bytemove(@buf + BPB_OEM_NAME, @"P2FMTER ", 8)

    ' BPB (BIOS Parameter Block)
    WORD[@buf + BPB_BYTES_PER_SEC] := sd.SECTOR_SIZE       ' Bytes per sector
    buf[BPB_SEC_PER_CLUS] := sectorsPerCluster             ' Sectors per cluster
    WORD[@buf + BPB_RESERVED_SECS] := RESERVED_SECTORS     ' Reserved sectors
    buf[BPB_NUM_FATS] := sd.EXPECTED_FAT_COUNT             ' Number of FATs
    WORD[@buf + BPB_ROOT_ENTRY_CT] := 0                    ' Root entries (0 for FAT32)
    WORD[@buf + BPB_TOTAL_SEC_16] := 0                     ' Total sectors 16-bit (0 for FAT32)
    buf[BPB_MEDIA_TYPE] := MEDIA_TYPE_FIXED                ' Media type (fixed disk)
    WORD[@buf + BPB_FAT_SIZE_16] := 0                      ' Sectors per FAT (16-bit, 0 for FAT32)
    WORD[@buf + BPB_SEC_PER_TRACK] := 63                   ' Sectors per track (legacy)
    WORD[@buf + BPB_NUM_HEADS] := 255                      ' Number of heads (legacy)
    LONG[@buf + BPB_HIDDEN_SECS] := partitionStart         ' Hidden sectors (partition start)
    LONG[@buf + BPB_TOTAL_SEC_32] := totalSectors - partitionStart  ' Total sectors 32-bit

    ' FAT32 extended BPB
    LONG[@buf + BPB_FAT_SIZE_32] := sectorsPerFat          ' Sectors per FAT (32-bit)
    WORD[@buf + BPB_EXT_FLAGS] := 0                        ' Flags
    WORD[@buf + BPB_FS_VERSION] := 0                       ' Version
    LONG[@buf + BPB_ROOT_CLUSTER] := sd.ROOT_CLUSTER       ' Root cluster
    WORD[@buf + BPB_FSINFO_SEC] := FSINFO_SECTOR_OFFSET    ' FSInfo sector
    WORD[@buf + BPB_BACKUP_BOOT_SEC] := BACKUP_VBR_OFFSET  ' Backup boot sector
    ' Bytes $34-$3F reserved (already 0)

    buf[BPB_DRIVE_NUM] := DRIVE_NUM_HDD                    ' Drive number
    buf[BPB_DRIVE_NUM + 1] := 0                            ' Reserved
    buf[BPB_EXT_BOOT_SIG] := EXT_BOOT_SIG_VAL             ' Extended boot signature
    LONG[@buf + BPB_VOLUME_SERIAL] := getct()              ' Volume serial number (random)

    ' Volume label (11 bytes)
    bytemove(@buf + BPB_VOLUME_LABEL, @volumeLabel, VOLUME_LABEL_LEN)

    ' File system type (8 bytes)
    bytemove(@buf + BPB_FS_TYPE, @"FAT32   ", 8)

    ' Boot signature
    WORD[@buf + sd.BOOT_SIG_OFFSET] := sd.BOOT_SIGNATURE

    ' Write VBR to partition start
    success := (sd.writeSectorRaw(partitionStart, @buf) == sd.SUCCESS)

PRI writeFSInfo() : success
' Write the FSInfo sector with free cluster count and hint.
'
' @returns success - TRUE if write succeeded, FALSE otherwise

    ' Clear buffer
    bytefill(@buf, 0, sd.SECTOR_SIZE)

    ' FSInfo signatures
    LONG[@buf + $000] := sd.FSINFO_LEAD_SIG            ' Lead signature
    LONG[@buf + FSINFO_SIG2_OFF] := sd.FSINFO_STRUCT_SIG  ' Structure signature
    LONG[@buf + FSINFO_FREE_COUNT_OFF] := totalClusters - 1  ' Free cluster count
    LONG[@buf + FSINFO_NEXT_FREE_OFF] := 3             ' Next free cluster hint
    LONG[@buf + $1FC] := FSINFO_TRAIL_SIG              ' Trail signature (includes $AA55)

    ' Write FSInfo to sector 1 of partition
    success := (sd.writeSectorRaw(partitionStart + FSINFO_SECTOR_OFFSET, @buf) == sd.SUCCESS)

PRI writeBackupBoot() : success
' Write backup VBR and FSInfo to sectors 6 and 7 of partition.
'
' @returns success - TRUE if writes succeeded, FALSE otherwise

    success := false

    ' Re-create VBR in buffer
    writeVBR()

    ' Write to backup VBR location
    if sd.writeSectorRaw(partitionStart + BACKUP_VBR_OFFSET, @buf) >= 0
        ' Write backup FSInfo
        writeFSInfo()
        success := (sd.writeSectorRaw(partitionStart + BACKUP_VBR_OFFSET + FSINFO_SECTOR_OFFSET, @buf) == sd.SUCCESS)

PRI initFAT(fatStart) : success | ok, sector, remaining, batch, written
' Initialize a FAT table with media type and root cluster.
' Uses CMD25 multi-sector writes in 64-sector batches for ~5.5x speedup.
'
' @param fatStart - Starting sector of the FAT
' @returns success - TRUE if all sectors written, FALSE otherwise

    success := false

    ' Clear buffer
    bytefill(@buf, 0, sd.SECTOR_SIZE)

    ' First sector of FAT has special entries
    LONG[@buf + 0] := FAT32_MEDIA_TYPE      ' FAT[0] - media type
    LONG[@buf + 4] := sd.FAT32_EOC_MARK     ' FAT[1] - end of chain marker
    LONG[@buf + 8] := sd.FAT32_EOC_MARK     ' FAT[2] - root directory (end of chain)

    ' Write first FAT sector (single-sector, has special entries)
    if sd.writeSectorRaw(fatStart, @buf) >= 0
        ' Write remaining FAT sectors in CMD25 batches (all zeros = free clusters)
        ' zeroBuf is zero-initialized by Spin2 VAR section
        ok := true
        sector := 1
        remaining := sectorsPerFat - 1
        repeat while remaining > 0 and ok
            batch := remaining <# MULTI_BATCH_SIZE                               ' Clamp to 64 or remainder
            written := sd.writeSectorsRaw(fatStart + sector, batch, @zeroBuf)
            if written <> batch
                debug("  FAT batch write FAILED at sector ", udec_(sector), " wrote ", udec_(written), "/", udec_(batch))
                ok := false
                quit
            if (sector & $FF) == 0 or remaining <= batch
                debug("  Progress: ", udec_(sector + batch), "/", udec_(sectorsPerFat))
            sector += batch
            remaining -= batch
        success := ok

PRI initRootDirectory() : success | written
' Initialize the root directory cluster with volume label entry.
'
' @returns success - TRUE if all sectors written, FALSE otherwise

    ' Clear buffer
    bytefill(@buf, 0, sd.SECTOR_SIZE)

    ' Create volume label directory entry at offset 0
    ' Filename (11 bytes) = volume label
    bytemove(@buf, @volumeLabel, VOLUME_LABEL_LEN)

    ' Attributes = volume label
    buf[sd.DE_ATTR_OFFSET] := sd.ATTR_VOLUME_ID

    ' Creation time/date (use some default)
    WORD[@buf + sd.DE_CRT_TIME_OFFSET] := $0000   ' Creation time
    WORD[@buf + sd.DE_CRT_TIME_OFFSET + 2] := $0021  ' Creation date (1980-01-01)
    WORD[@buf + sd.DE_CRT_TIME_OFFSET + 4] := $0021  ' Access date
    WORD[@buf + sd.DE_CLUS_HI_OFFSET] := $0000    ' High word of cluster (0)
    WORD[@buf + sd.DE_WRT_TIME_OFFSET] := $0000    ' Modification time
    WORD[@buf + sd.DE_WRT_TIME_OFFSET + 2] := $0021  ' Modification date
    WORD[@buf + sd.DE_CLUS_LO_OFFSET] := $0000    ' Low word of cluster (0)
    LONG[@buf + sd.DE_FILESIZE_OFFSET] := 0        ' File size (0 for volume label)

    ' Write first sector of root directory
    success := false
    if sd.writeSectorRaw(dataStart, @buf) >= 0
        ' Clear remaining sectors of root cluster using CMD25 batch write
        ' zeroBuf is zero-initialized by Spin2 VAR section; max 63 sectors fits in 32 KB
        if sectorsPerCluster > 1
            written := sd.writeSectorsRaw(dataStart + 1, sectorsPerCluster - 1, @zeroBuf)
            if written == sectorsPerCluster - 1
                success := true
            else
                debug("  Root dir batch write FAILED: wrote ", udec_(written), "/", udec_(sectorsPerCluster - 1))
        else
            success := true

PRI showWriteDiag() | wResult, wR1, wDresp, wSector
' Display write diagnostic info from driver after a write failure.

    wResult, wR1, wDresp, wSector := sd.getWriteDiag()
    debug("  DIAG: result=", udec_(wResult), " R1=$", uhex_byte_(wR1), " dresp=$", uhex_byte_(wDresp), " sector=", udec_(wSector))
    debug("  (1=CMD24fatal 2=drespTimeout 3=CRCreject 4=writeErr 5=unknownReject 6=busyTimeout 7=OK)")

