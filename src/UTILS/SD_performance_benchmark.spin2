'' =========================================================================================
''
''   File....... SD_performance_benchmark.spin2
''   Purpose.... Performance benchmark for SD card driver - measures real-world throughput
''   Author..... Stephen M Moraco
''   E-mail..... stephen@ironsheep.biz
''   Started.... JAN 2026
''   Updated.... 07 FEB 2026
''
'' =========================================================================================

{ Description:
   Measures SD card driver performance across three levels:

     1. RAW SINGLE-SECTOR: readSectorsRaw/writeSectorsRaw with count=1
        - Isolates: command dispatch + SPI transfer + card latency
        - Uses multi-sector API with count=1 to avoid debug print overhead

     2. RAW MULTI-SECTOR: readSectorsRaw/writeSectorsRaw with CMD18/CMD25
        - Shows benefit of amortizing command overhead across N sectors
        - Tests at 8, 32, and 64 sector counts

     3. FILE-LEVEL: createFileNew/openFileRead + writeHandle/readHandle + closeFileHandle
        - Includes FAT traversal, cluster allocation, sector caching
        - Real-world throughput an application developer will see

   Run on each card, at both 350 MHz and 250 MHz sysclk, to build performance catalog.
   Both sysclks yield an exact 25 MHz SCK on cards that can sustain it
   (350/14 = 25.00, 250/10 = 25.00), so throughput is directly comparable across
   cards. See DOCs/cards/CATALOG-PROCEDURE.md for the full per-card procedure.

   Test sizes (embedded use cases):
     Write: 512B (log entry), 4KB (config), 32KB (data batch)
     Read:  4KB (config), 32KB (icon), 128KB (small image), 256KB (large image)
}

CON

    _CLKFREQ        = 350_000_000       ' Change to 250_000_000 for low-sysclk runs

    ' SD card pin assignments
    ' Default: P2 Edge module SD slot. Build with -D SD_PINS_EXTERNAL
    ' to use the external SD header (base pin 16).
#ifdef SD_PINS_EXTERNAL
    SD_CS   = 20
    SD_MOSI = 19
    SD_MISO = 18
    SD_SCK  = 21
#else
    SD_CS   = 60
    SD_MOSI = 59
    SD_MISO = 58
    SD_SCK  = 61
#endif
    ' Test parameters
    ITERATIONS      = 10                ' Number of iterations per test

    ' REPEAT RUNS -- measure RUN variance before INSTANCE variance.
    '
    ' Round 11b measured the same physical PNY card moving by up to 3x between
    ' rounds, with 6x dispersion inside a single measurement loop, while its
    ' high-speed numbers repeated to 0.3%. So a difference between two cards means
    ' nothing until the run-to-run spread of one card is known. Set this above 1
    ' and the whole measurement set repeats on the mounted card; every emitted
    ' CATALOG-ROW carries its run number, so the spread is visible in the harvested
    ' table as a range rather than averaged away.
    '
    ' Measurement ORDER may matter too -- the first run of a card can differ from
    ' later ones -- which is a second reason the runs are reported separately
    ' instead of being folded together here.
    REPEAT_RUNS     = 1                 ' Passes over the full measurement set

    ' Test sizes (in bytes)
    SIZE_512B       = 512
    SIZE_4KB        = 4096
    SIZE_32KB       = 32768
    SIZE_128KB      = 131072
    SIZE_256KB      = 262144

    ' Buffer size - must accommodate largest test
    BUFFER_SIZE     = 262144 + 512      ' 256KB + margin

    ' Multi-sector test parameters
    MULTI_8         = 8                 ' 4KB
    MULTI_32        = 32                ' 16KB
    MULTI_64        = 64                ' 32KB
    TEST_SECTOR     = 200_000           ' Safe test sector (away from FAT/data area)
    CID_PNM_LEN     = 5                 ' CID product name field length

    ' BUS-CEILING ATTRIBUTION (added 2026-08-18)
    ' A 512-byte sector is 4096 bits on a 1-bit SPI data line, so the bus can
    ' never carry more than spi_freq / 8 bytes per second no matter how good the
    ' card or the driver is. Every measured rate is reported as a percentage of
    ' that ceiling, which makes "what is the limiting factor" a derived number
    ' rather than a judgement:
    '
    '   near the ceiling -> the BUS is the limit; a faster card cannot help, and
    '                       only a faster clock or more data lines (4-bit) will
    '   far below it     -> the CARD is the limit; its internal latency dominates
    '                       and neither a faster clock nor 4-bit will help much
    '
    ' These two thresholds are REPORTING boundaries chosen for legibility, not
    ' physical constants. They label a continuum.
    BUS_LIMITED_PCT  = 70               ' At or above: bus/driver bound
    CARD_LIMITED_PCT = 30               ' Below: card-internal bound

' Enable full driver features for this utility
#ifdef __SPINTOOLS__
#define SD_INCLUDE_ALL
#elseifdef __FLEXSPIN__
#define SD_INCLUDE_ALL
#pragma exportdef SD_INCLUDE_ALL
#else
#pragma exportdef SD_INCLUDE_ALL
#endif

OBJ
    sd    : "micro_sd_fat32_fs"
    fmt   : "isp_mem_strings"           ' machine-readable key lines: debug() digit-grouping corrupts them

DAT

' Test filenames
testFile        BYTE    "PERFTEST.BIN", 0

' Large buffer for read/write tests (256KB)
testBuffer      BYTE    0[BUFFER_SIZE]

' Statistics arrays
timings         LONG    0[ITERATIONS]

' Which pass over the measurement set is running (1..REPEAT_RUNS). Stamped into
' every CATALOG-ROW so repeat runs stay distinguishable after harvesting.
currentRun      LONG    1

' Card identification buffer
cid_buf         BYTE    0[16]

' Line buffer + trimmed PNM for the machine-readable key lines. Built with
' sFormatStr, never debug()'s formatters -- see the note in identifyCard.
keyBuf          BYTE    0[200]
pnmKey          BYTE    0[8]

' Write-verification read-back buffer (one sector at a time -- see verifyRawWrite)
verifyBuf       BYTE    0[512]

' Limiter verdict strings (see pctOfCeiling / limiterTag)
str_bus_bound   BYTE    "BUS-bound", 0
str_card_bound  BYTE    "CARD-bound", 0
str_mixed       BYTE    "mixed", 0

PUB go() | result, spi_hz, runIdx
'' Main entry point - runs comprehensive SD card performance benchmark.

    debug(" ")
    debug("======================================================")
    debug("  SD Card Performance Benchmark v2.0")
    debug("======================================================")
    debug(" ")
    ' The DRIVER version, not this tool's. Throughput is a property of the driver
    ' as much as of the card -- the align default, the production speed bound and
    ' the init sequence have all moved these numbers between releases -- so a
    ' transcript that does not name the driver cannot be placed in a catalog table.
    debug("Driver version: ", zstr_(sd.driverVersionString()))
    debug("SysClk: ", udec_(clkfreq / 1_000_000), " MHz")
    debug("Iterations per test: ", udec_(ITERATIONS))
    debug("Repeat runs: ", udec_(REPEAT_RUNS))
    debug(" ")

    ' Mount the card first (for accurate cold-mount timing)
    result := runMountBenchmark()
    if result >= 0

#ifdef HIGH_SPEED
        ' HIGH-SPEED ARM (added 2026-08-18). Negotiate CMD6 high speed BEFORE any
        ' measurement, so every number below is taken at the faster clock. This is
        ' the explicit, opt-in form -- the driver does NOT do this at mount today.
        ' The whole point of this arm is to measure whether it is worth making it
        ' automatic, so the answer must not be assumed by the instrument.
        '
        ' A card that declines is not a failed run: it is one of the two outcomes,
        ' and it is reported as such so the transcript is self-labelling.
        if sd.attemptHighSpeed()
            debug("  HIGH-SPEED ARM: negotiated, running at ", udec_(sd.getSPIFrequency() / 1000), " kHz")
        else
            debug("  HIGH-SPEED ARM: card DECLINED (ERROR(): ", sdec_(sd.ERROR()), ") -- numbers below are standard speed")
#endif

        ' Show SPI frequency and volume info
        spi_hz := sd.getSPIFrequency()
        debug("  SPI Frequency: ", udec_(spi_hz / 1000), " kHz")
        debug("  Bus ceiling at this clock: ", udec_(busCeilingKBps()), " KB/s (spi_freq / 8; 1 data line)")
        debug("  Rates below are annotated [% of bus, limiter] -- see the tool header")
        showVolumeInfo()

        ' Identify card AFTER mount (reads CID via worker cog)
        debug("------------------------------------------------------")
        debug("  CARD IDENTIFICATION")
        debug("------------------------------------------------------")
        result := identifyCard()
        if result == false
            debug("  WARNING: Could not read CID")
        debug(" ")

        ' === THE MEASUREMENT SET, repeated REPEAT_RUNS times ===
        ' Repeats happen inside one mount, on one card, so what varies between
        ' passes is the card and the driver -- not the mount, the socket or the
        ' operator. That is the run variance the instance experiment has to be
        ' compared against.
        repeat runIdx from 1 to REPEAT_RUNS
            ' Published to DAT so emitCatalogRow can stamp it without threading the
            ' run number through four reporters. A method-local drives the loop
            ' deliberately: Spin2 documents the FROM..TO loop variable as local to
            ' the REPEAT block, so a DAT symbol in that position is not a contract
            ' this instrument should rest its provenance stamp on.
            currentRun := runIdx
            if REPEAT_RUNS > 1
                debug(" ")
                debug("######################################################")
                debug("  RUN ", udec_(currentRun), " of ", udec_(REPEAT_RUNS))
                debug("######################################################")

            ' === RAW SINGLE-SECTOR BENCHMARKS ===
            debug(" ")
            debug("------------------------------------------------------")
            debug("  RAW SINGLE-SECTOR (1x512B per operation)")
            debug("------------------------------------------------------")
            runSingleSectorBenchmarks()

            ' === RAW MULTI-SECTOR BENCHMARKS ===
            debug(" ")
            debug("------------------------------------------------------")
            debug("  RAW MULTI-SECTOR (CMD18/CMD25 bulk transfers)")
            debug("------------------------------------------------------")
            runMultiSectorBenchmarks()

            ' === FILE-LEVEL BENCHMARKS ===
            debug(" ")
            debug("------------------------------------------------------")
            debug("  FILE-LEVEL (handle API, includes FAT overhead)")
            debug("------------------------------------------------------")
            runFileLevelBenchmarks()

        ' Unmount with timing
        debug(" ")
        debug("------------------------------------------------------")
        debug("  OVERHEAD")
        debug("------------------------------------------------------")
        runFileOpenCloseBenchmark()
        runUnmountBenchmark()

        debug(" ")
        debug("======================================================")
        debug("  Benchmark Complete")
        debug("======================================================")
    else
        debug("ERROR: Could not mount SD card!")

    ' Drain the headless terminal log backlog before END_SESSION triggers
    ' shutdown -- without this the closing banner above is cut off mid-line
    ' and the captured transcript is truncated.
    waitms(500)
    debug("END_SESSION")


' CARD IDENTIFICATION

PRI identifyCard() : bIdentified | psn, mdt_year, mdt_month
' Identify card by reading CID (call after mount).
'
' THE IDENTITY BLOCK IS THE ROW KEY. Catalog rows are per physical instance,
' keyed by the full Card ID, and grouped by SILICON KEY = MID_PNM_PRV. The MID is
' printed as hex rather than a brand name on purpose: mapping MID to a
' manufacturer is a lookup the CATALOG owns in one place, and an instrument
' carrying its own copy would go stale silently. Brand does not predict
' controller in any case -- Gigastone-branded cards in this project's own drawer
' carry three different MIDs.
'
' Until 2026-08-19 this printed MID and the 5-character product name only, which
' cannot distinguish two cards of the same model. The PSN can.
'
' CID layout: [0]=MID, [1..2]=OID, [3..7]=PNM (5 ASCII), [8]=PRV, [9..12]=PSN,
' [13..14]=MDT (12 bits: 8-bit year offset from 2000, 4-bit month), [15]=CRC7
'
' @returns bIdentified - TRUE if the CID was read
' @local psn - Product serial number, the field that distinguishes two same-model cards
' @local mdt_year - Manufacture year, decoded from the 12-bit MDT field
' @local mdt_month - Manufacture month

    bIdentified := false
    if sd.readCIDRaw(@cid_buf) >= 0
        psn := (cid_buf[9] << 24) | (cid_buf[10] << 16) | (cid_buf[11] << 8) | cid_buf[12]
        mdt_year := 2000 + ((cid_buf[13] & $0F) << 4) + (cid_buf[14] >> 4)
        mdt_month := cid_buf[14] & $0F

        debug("  Card: MID=$", uhex_byte_(cid_buf[0]), " OID='", lstr_(@cid_buf[1], 2), ...
            "' PNM='", lstr_(@cid_buf[3], CID_PNM_LEN), "' rev ", udec_(cid_buf[8] >> 4), ".", udec_(cid_buf[8] & $0F))
        debug("  >>> SERIAL PSN=$", uhex_long_(psn), "  mfg ", udec_(mdt_year), "/", udec_(mdt_month), " <<<")
        debug("  CID raw: ", uhex_byte_array_(@cid_buf, 16))

        emitCatalogCard(psn, mdt_year, mdt_month)
        bIdentified := true
    else
        debug("  Could not read the card ID register")


' MOUNT / UNMOUNT TIMING

PRI runMountBenchmark() : status | start_ct, elapsed_ct, elapsed_us
' Mount card and display timing.

    debug("MOUNT:")
    start_ct := getct()
    status := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    elapsed_ct := getct() - start_ct

    elapsed_us := elapsed_ct / (clkfreq / 1_000_000)
    debug("  Mount time: ", udec_(elapsed_us / 1000), ".", udec_((elapsed_us // 1000) / 100), " ms")


PRI runUnmountBenchmark() | start_ct, elapsed_ct, elapsed_ms
' Unmount card and display timing.

    debug(" ")
    debug("Unmount:")
    start_ct := getct()
    sd.unmount()
    elapsed_ct := getct() - start_ct

    elapsed_ms := elapsed_ct / (clkfreq / 1000)
    debug("  Unmount time: ", udec_(elapsed_ms), " ms")


PRI showVolumeInfo() | free_sectors, free_mb
' Display mounted volume info.

    debug("  Volume: ", zstr_(sd.volumeLabel()))
    free_sectors := sd.freeSpace()
    free_mb := free_sectors / 2048
    debug("  Free: ", udec_(free_mb), " MB (", udec_(free_sectors), " sectors)")
    debug(" ")


' RAW SINGLE-SECTOR BENCHMARKS

PRI runSingleSectorBenchmarks()
' Measure raw single-sector read and write performance.
' Uses readSectorsRaw/writeSectorsRaw with count=1 to avoid debug print overhead.

    debug(" ")
    debug("Single-Sector Read (", udec_(ITERATIONS), " iterations):")
    runRawReadTest(1)

    debug(" ")
    debug("Single-Sector Write (", udec_(ITERATIONS), " iterations):")
    runRawWriteTest(1)


' RAW MULTI-SECTOR BENCHMARKS

PRI runMultiSectorBenchmarks()
' Run all multi-sector read and write benchmarks at multiple sector counts.

    debug(" ")
    debug("Multi-Sector Read (CMD18):")
    runRawReadTest(MULTI_8)
    runRawReadTest(MULTI_32)
    runRawReadTest(MULTI_64)

    debug(" ")
    debug("Multi-Sector Write (CMD25):")
    runRawWriteTest(MULTI_8)
    runRawWriteTest(MULTI_32)
    runRawWriteTest(MULTI_64)

    debug(" ")
    debug("Single vs Multi Comparison (", udec_(MULTI_64), " sectors):")
    runComparisonTest(MULTI_64)


PRI runRawReadTest(count) | iter, start_ct, elapsed_ct, min_us, max_us, total_us, avg_us, kbps, size, readCt, pct, ok
' Benchmark raw sector read at specified count.
' Works for both single-sector (count=1) and multi-sector operations.
'
' @param count - Number of sectors to read per iteration

    size := count * sd.SECTOR_SIZE

    ' Ensure test area has data
    fillBuffer(size, $A5)
    sd.writeSectorsRaw(TEST_SECTOR, count, @testBuffer)

    min_us := $7FFF_FFFF
    max_us := 0
    total_us := 0
    ok := true

    repeat iter from 0 to ITERATIONS - 1
        start_ct := getct()
        readCt := sd.readSectorsRaw(TEST_SECTOR, count, @testBuffer)
        elapsed_ct := getct() - start_ct

        if readCt == count
            timings[iter] := elapsed_ct / (clkfreq / 1_000_000)
            total_us += timings[iter]
            if timings[iter] < min_us
                min_us := timings[iter]
            if timings[iter] > max_us
                max_us := timings[iter]
        else
            debug("  ERROR: bulk read failed, status ", sdec_(readCt), " (expected ", udec_(count), ")")
            ok := false
            quit

    if ok
        avg_us := total_us / ITERATIONS

        if avg_us > 0
            kbps := (size * 1000) / avg_us
        else
            kbps := 0

        pct := pctOfCeiling(size, avg_us)
        debug("  ", udec_(count), " sector(s) (", udec_(size), "B): Min=", udec_(min_us), " Avg=", udec_(avg_us), " Max=", udec_(max_us), " us => ", udec_(kbps), " KB/s  [", udec_(pct), "% of bus, ", zstr_(limiterTag(pct)), "]")
        emitCatalogRow(string("raw_read"), size, avg_us, min_us, max_us, kbps, pct)


PRI emitCatalogCard(psn, mdt_year, mdt_month) | nLen
' Emit the canonical keys and the machine-parseable identity for this card.
'
' BUILT AS A STRING, NOT PRINTED WITH debug()'s FORMATTERS (2026-08-19, first
' light). debug() formats for a human at a terminal, and three of its habits
' corrupt a machine key: uhex_* emit their own "$" (giving "$$AD"), longs are
' digit-grouped ("$3584_1E2E", "350_000_000"), and udec_ groups anything >= 1000
' so a 2025/7 date rendered "2_02507". The grouping is the dangerous one --
' harvest_catalog.sh reads numbers with awk`s "+0", and awk parses "2_500" as 2,
' so every rate and timing in a swept catalog would have been silently truncated.
'
' Every CATALOG-ROW line after this one belongs to the card named here; the
' harvester associates rows with the most recent CATALOG-CARD.
'
' @param psn - Product serial number
' @param mdt_year - Manufacture year
' @param mdt_month - Manufacture month
' @local nLen - Characters placed by the first format call, for appending

    ' Trim the CID's space padding: a trailing space inside a key would make two
    ' spellings of one card.
    bytemove(@pnmKey, @cid_buf[3], CID_PNM_LEN)
    pnmKey[CID_PNM_LEN] := 0
    repeat while pnmKey[0] <> 0 and pnmKey[strsize(@pnmKey) - 1] == " "
        pnmKey[strsize(@pnmKey) - 1] := 0

    fmt.sFormatStr4(@keyBuf, 200, @"  SILICON-KEY: $%.2x_%s_%d.%d", ...
        cid_buf[0], @pnmKey, cid_buf[8] >> 4, cid_buf[8] & $0F)
    debug(zstr_(@keyBuf))

    nLen := fmt.sFormatStr4(@keyBuf, 200, @"  CARD-ID: $%.2x_%s_%d.%d", ...
        cid_buf[0], @pnmKey, cid_buf[8] >> 4, cid_buf[8] & $0F)
    fmt.sFormatStr3(@BYTE[@keyBuf][nLen], 200 - nLen, @"_%.8x_%d%.2d", ...
        psn, mdt_year, mdt_month)
    debug(zstr_(@keyBuf))

    nLen := fmt.sFormatStr5(@keyBuf, 200, @"CATALOG-CARD: tool=performance_benchmark drv=%s mid=$%.2x pnm=%s prv=%d.%d", ...
        sd.driverVersionString(), cid_buf[0], @pnmKey, cid_buf[8] >> 4, cid_buf[8] & $0F)
    fmt.sFormatStr5(@BYTE[@keyBuf][nLen], 200 - nLen, @" psn=$%.8x mdt=%d/%d sysclk=%d spi_hz=%d", ...
        psn, mdt_year, mdt_month, clkfreq, sd.getSPIFrequency())
    debug(zstr_(@keyBuf))

PRI emitCatalogRow(p_op, bytes_moved, avg_us, min_us, max_us, kbps, pct) | nLen
' Emit one machine-parseable row for the catalog harvester.
'
' WHY THIS EXISTS (2026-08-19). Catalog numbers have always been transcribed from
' transcripts by hand, and the result is visible in the documents: three different
' row labels across eras for the same measurement ("Read (1x512B)" / "RAW read
' 1x512B" / "Read 1 sector"), and six cards whose measured data never reached the
' summary table at all. A prefixed, fixed-shape line makes the table a
' transformation of the log rather than a retyping of it.
'
' ADDITIVE ONLY. The human-readable line above each of these is unchanged -- this
' is a second rendering of the same numbers, not a replacement, because the
' transcripts are read by people during a bench session and by scripts afterwards.
'
' Identity is NOT repeated per row; rows inherit the most recent CATALOG-CARD line.
'
' @param p_op - Pointer to the traffic-type label, e.g. "raw_read"
' @param bytes_moved - Bytes per iteration
' @param avg_us - Mean microseconds per iteration
' @param min_us - Fastest iteration
' @param max_us - Slowest iteration
' @param kbps - Throughput in KB/s (KB = 1000)
' @param pct - Percent of the bus ceiling at the current clock

  ' Plain digits only -- see emitCatalogCard for why debug()'s formatters cannot
  ' be used here. Every field below is read numerically by harvest_catalog.sh.
  nLen := fmt.sFormatStr5(@keyBuf, 200, @"CATALOG-ROW: instr=throughput run=%d op=%s bytes=%d avg_us=%d min_us=%d", ...
      currentRun, p_op, bytes_moved, avg_us, min_us)
  fmt.sFormatStr5(@BYTE[@keyBuf][nLen], 200 - nLen, @" max_us=%d kbps=%d pct_bus=%d limiter=%s spi_hz=%d", ...
      max_us, kbps, pct, limiterTag(pct), sd.getSPIFrequency())
  debug(zstr_(@keyBuf))

PRI busCeilingKBps() : kbps
' The transfer ceiling of the SPI bus at the CURRENT clock, in KB/s (KB = 1000,
' matching the rate math everywhere else in this tool).
'
' One data line carries one bit per SCK, so the bus moves spi_freq / 8 bytes per
' second. Nothing on the card side and nothing in the driver can exceed this --
' it is the wall that 4-bit support exists to move.
'
' @returns kbps - bus ceiling in KB/s at the current SPI frequency

  kbps := sd.getSPIFrequency() / 8 / 1000

PRI pctOfCeiling(size, avg_us) : pct | kbps
' Measured rate as a percentage of the bus ceiling. See the CON note.
'
' @param size - bytes moved per iteration
' @param avg_us - average microseconds per iteration
' @returns pct - percent of the bus ceiling actually achieved

  if avg_us == 0
    return 0
  kbps := (size * 1000) / avg_us
  pct := (kbps * 100) / (busCeilingKBps() #> 1)         ' #> 1 guards divide-by-zero

PRI limiterTag(pct) : p_tag
' The one-word verdict that goes with a percentage. Thresholds are reporting
' boundaries, not physics -- see the CON note.
'
' @param pct - percent of bus ceiling
' @returns p_tag - pointer to the verdict string

  if pct >= BUS_LIMITED_PCT
    p_tag := @str_bus_bound
  elseif pct < CARD_LIMITED_PCT
    p_tag := @str_card_bound
  else
    p_tag := @str_mixed

PRI runRawWriteTest(count) | iter, start_ct, elapsed_ct, min_us, max_us, total_us, avg_us, kbps, size, written, pct, ok
' Benchmark raw sector write at specified count.
' Works for both single-sector (count=1) and multi-sector operations.
'
' @param count - Number of sectors to write per iteration

    size := count * sd.SECTOR_SIZE
    fillBuffer(size, $5A)

    min_us := $7FFF_FFFF
    max_us := 0
    total_us := 0
    ok := true

    repeat iter from 0 to ITERATIONS - 1
        start_ct := getct()
        written := sd.writeSectorsRaw(TEST_SECTOR, count, @testBuffer)
        elapsed_ct := getct() - start_ct

        if written == count
            timings[iter] := elapsed_ct / (clkfreq / 1_000_000)
            total_us += timings[iter]
            if timings[iter] < min_us
                min_us := timings[iter]
            if timings[iter] > max_us
                max_us := timings[iter]
        else
            debug("  ERROR: bulk write failed, status ", sdec_(written), " (expected ", udec_(count), ")")
            ok := false
            quit

    if ok
        avg_us := total_us / ITERATIONS

        if avg_us > 0
            kbps := (size * 1000) / avg_us
        else
            kbps := 0

        pct := pctOfCeiling(size, avg_us)
        debug("  ", udec_(count), " sector(s) (", udec_(size), "B): Min=", udec_(min_us), " Avg=", udec_(avg_us), " Max=", udec_(max_us), " us => ", udec_(kbps), " KB/s  [", udec_(pct), "% of bus, ", zstr_(limiterTag(pct)), "]")
        emitCatalogRow(string("raw_write"), size, avg_us, min_us, max_us, kbps, pct)
        if verifyRawWrite(count) == 0
            debug("    verify: ", udec_(size), " bytes match")


PRI verifyRawWrite(count) : status | sec, idx, bad, first_bad, exp, got, was_hs
' Read back what runRawWriteTest just wrote and compare it, byte for byte.
'
' WHY THIS EXISTS (2026-08-18). Round 10b measured writes getting dramatically
' SLOWER in CMD6 high-speed mode -- PNY -64%, Samsung -55% -- with zero reported
' errors. But "no errors" only meant no card REJECTIONS: nothing in this
' benchmark had ever checked that the bytes on the card matched the bytes we
' sent. Round 7b documented a driver-side tx phase that produces exactly that
' failure -- silent whole-sector corruption the card accepts without complaint.
' So until this check existed, "slower" and "corrupt" were indistinguishable in
' the one measurement that mattered.
'
' RUN OUTSIDE THE TIMED REGION. Verification cost must not enter the throughput
' figure, so this is called once after the timed loop, never per iteration.
'
' TWO-STAGE ON MISMATCH, and the order matters. The first read-back happens at
' the CURRENT speed -- cheap, and no disturbance to card state in the common
' case. But a mismatch there is ambiguous: a bad READ at hp=4 looks identical to
' a bad WRITE. So a mismatch triggers a second read at a known-good speed, and
' the two answers separate the cases:
'   persists at safe speed -> the WRITE really did corrupt the card's contents
'   clears at safe speed   -> the write was fine; the fast READ-BACK was wrong
' Dropping to a safe speed exits high-speed mode (a hand-set clock always does),
' which is why it is reserved for the mismatch path -- by then the run has found
' what it came for and the remaining timings are forfeit anyway.
'
' @param count - Number of sectors runRawWriteTest just wrote
' @returns status - 0 clean, -1 read-back-only fault, -2 confirmed write corruption
' @local sec - Sector loop counter
' @local bad - Mismatched byte count
' @local first_bad - Byte offset of the first mismatch
' @local was_hs - Whether high-speed mode was active before the safe-speed re-read

    status := 0
    bad := 0
    first_bad := -1

    repeat sec from 0 to count - 1
        if sd.readSectorsRaw(TEST_SECTOR + sec, 1, @verifyBuf) <> 1
            debug("  VERIFY: read-back FAILED at sector +", udec_(sec))
            return -1
        repeat idx from 0 to sd.SECTOR_SIZE - 1
            exp := BYTE[@testBuffer][(sec * sd.SECTOR_SIZE) + idx]
            got := BYTE[@verifyBuf][idx]
            if exp <> got
                bad++
                if first_bad < 0
                    first_bad := (sec * sd.SECTOR_SIZE) + idx
                    debug("  VERIFY MISMATCH: offset ", udec_(first_bad), " expected $", uhex_byte_(exp), " got $", uhex_byte_(got))

    if bad == 0
        return 0

    debug("  VERIFY: ", udec_(bad), " mismatched byte(s) at ", udec_(sd.getSPIFrequency() / 1000), " kHz -- re-reading at a trusted speed")

    ' Stage two: was it the write, or the read-back?
    was_hs := sd.isHighSpeedActive()
    sd.setSPISpeed(25_000_000)
    bad := 0
    repeat sec from 0 to count - 1
        if sd.readSectorsRaw(TEST_SECTOR + sec, 1, @verifyBuf) <> 1
            debug("  VERIFY: safe-speed read-back ALSO failed -- cannot attribute")
            return -1
        repeat idx from 0 to sd.SECTOR_SIZE - 1
            if BYTE[@testBuffer][(sec * sd.SECTOR_SIZE) + idx] <> BYTE[@verifyBuf][idx]
                bad++

    if bad > 0
        debug("  >>> CONFIRMED WRITE CORRUPTION: ", udec_(bad), " byte(s) still wrong at 25 MHz <<<")
        status := -2
    else
        debug("  >>> Write was CLEAN; the fast READ-BACK was at fault (HS active before: ", sdec_(was_hs), ") <<<")
        status := -1

    debug("  NOTE: speed was dropped to attribute this; high-speed mode is now OFF and later timings in this run are not comparable.")

PRI runComparisonTest(count) | idx, start_ct, elapsed_ct, single_us, multi_us, size, improvement, readCt
' Compare N individual single-sector reads vs one multi-sector read.
'
' @param count - Number of sectors for comparison

    size := count * sd.SECTOR_SIZE

    ' Ensure test data exists
    fillBuffer(size, $CC)
    sd.writeSectorsRaw(TEST_SECTOR, count, @testBuffer)

    ' Time N individual single-sector reads
    start_ct := getct()
    repeat idx from 0 to count - 1
        readCt := sd.readSectorsRaw(TEST_SECTOR + idx, 1, @testBuffer + (idx * sd.SECTOR_SIZE))
    elapsed_ct := getct() - start_ct
    single_us := elapsed_ct / (clkfreq / 1_000_000)

    ' Time one multi-sector read
    start_ct := getct()
    readCt := sd.readSectorsRaw(TEST_SECTOR, count, @testBuffer)
    elapsed_ct := getct() - start_ct
    multi_us := elapsed_ct / (clkfreq / 1_000_000)

    if single_us > 0
        improvement := ((single_us - multi_us) * 100) / single_us
    else
        improvement := 0

    debug("  ", udec_(count), "x single-sector (CMD18x", udec_(count), "): ", udec_(single_us), " us")
    debug("  1x multi-sector  (CMD18x1):     ", udec_(multi_us), " us")
    debug("  Improvement: ", udec_(improvement), "%")


' FILE-LEVEL BENCHMARKS (handle-based API)

PRI runFileLevelBenchmarks()
' Run all file-level benchmarks using handle-based API.
' Timing includes open + transfer + close (the full user-visible cost).

    ' Clean up any leftover test file
    sd.deleteFile(@testFile)

    debug(" ")
    debug("File Write (create + write + close):")
    runFileWriteTest(SIZE_512B, string("512B"))
    runFileWriteTest(SIZE_4KB, string("4KB"))
    runFileWriteTest(SIZE_32KB, string("32KB"))

    debug(" ")
    debug("File Read (open + read + close):")
    runFileReadTest(SIZE_4KB, string("4KB"))
    runFileReadTest(SIZE_32KB, string("32KB"))
    runFileReadTest(SIZE_128KB, string("128KB"))
    runFileReadTest(SIZE_256KB, string("256KB"))

    ' Cleanup
    sd.deleteFile(@testFile)


PRI runFileWriteTest(size, p_label) | iter, handle, start_ct, elapsed_ct, min_us, max_us, total_us, avg_us, kbps, written, pct, ok
' Benchmark file write: create + writeHandle + closeFileHandle.
' Measures the full cycle an application would perform.
'
' @param size - Number of bytes to write
' @param p_label - Pointer to label string for display

    fillBuffer(size, $5A)

    min_us := $7FFF_FFFF
    max_us := 0
    total_us := 0
    ok := true

    repeat iter from 0 to ITERATIONS - 1
        ' Delete previous iteration's file
        sd.deleteFile(@testFile)

        ' Time the full write cycle
        start_ct := getct()
        handle := sd.createFileNew(@testFile)
        if handle >= 0
            written := sd.writeHandle(handle, @testBuffer, size)
            sd.closeFileHandle(handle)
        elapsed_ct := getct() - start_ct

        if handle < 0
            debug("  ERROR: createFileNew failed (", sdec_(handle), ")")
            ok := false
            quit

        timings[iter] := elapsed_ct / (clkfreq / 1_000_000)
        total_us += timings[iter]
        if timings[iter] < min_us
            min_us := timings[iter]
        if timings[iter] > max_us
            max_us := timings[iter]

    if ok
        avg_us := total_us / ITERATIONS

        if avg_us > 0
            kbps := (size * 1000) / avg_us
        else
            kbps := 0

        pct := pctOfCeiling(size, avg_us)
        debug("  ", zstr_(p_label), ": Min=", udec_(min_us), " Avg=", udec_(avg_us), " Max=", udec_(max_us), " us => ", udec_(kbps), " KB/s  [", udec_(pct), "% of bus, ", zstr_(limiterTag(pct)), "]")
        emitCatalogRow(string("file_write"), size, avg_us, min_us, max_us, kbps, pct)


PRI runFileReadTest(size, p_label) | iter, handle, start_ct, elapsed_ct, min_us, max_us, total_us, avg_us, kbps, bytesRead, pct, ok
' Benchmark file read: openFileRead + readHandle + closeFileHandle.
' Creates a file of the target size first, then times repeated reads.
'
' @param size - Number of bytes to read per iteration
' @param p_label - Pointer to label string for display

    ' Create test file of required size
    sd.deleteFile(@testFile)
    handle := sd.createFileNew(@testFile)
    ok := handle >= 0
    if ok
        fillBuffer(size, $A5)
        sd.writeHandle(handle, @testBuffer, size)
        sd.closeFileHandle(handle)

        min_us := $7FFF_FFFF
        max_us := 0
        total_us := 0

        repeat iter from 0 to ITERATIONS - 1
            ' Time the full read cycle
            start_ct := getct()
            handle := sd.openFileRead(@testFile)
            if handle >= 0
                bytesRead := sd.readHandle(handle, @testBuffer, size)
                sd.closeFileHandle(handle)
            elapsed_ct := getct() - start_ct

            if handle < 0
                debug("  ERROR: openFileRead failed (", sdec_(handle), ")")
                ok := false
                quit

            timings[iter] := elapsed_ct / (clkfreq / 1_000_000)
            total_us += timings[iter]
            if timings[iter] < min_us
                min_us := timings[iter]
            if timings[iter] > max_us
                max_us := timings[iter]

        if ok
            avg_us := total_us / ITERATIONS

            if avg_us > 0
                kbps := (size * 1000) / avg_us
            else
                kbps := 0

            pct := pctOfCeiling(size, avg_us)
            debug("  ", zstr_(p_label), ": Min=", udec_(min_us), " Avg=", udec_(avg_us), " Max=", udec_(max_us), " us => ", udec_(kbps), " KB/s  [", udec_(pct), "% of bus, ", zstr_(limiterTag(pct)), "]")
            emitCatalogRow(string("file_read"), size, avg_us, min_us, max_us, kbps, pct)
    else
        debug("  ERROR: Could not create test file for read benchmark")


' FILE OPEN/CLOSE OVERHEAD

PRI runFileOpenCloseBenchmark() | iter, handle, start_ct, elapsed_ct, open_min, open_max, open_total, close_min, close_max, close_total, open_avg, close_avg
' Measure file open and close overhead independently.
' Uses a small existing file to isolate open/close latency.

    ' Create a small test file
    sd.deleteFile(@testFile)
    handle := sd.createFileNew(@testFile)
    if handle >= 0
        fillBuffer(1024, $AA)
        sd.writeHandle(handle, @testBuffer, 1024)
        sd.closeFileHandle(handle)

    open_min := $7FFF_FFFF
    open_max := 0
    open_total := 0
    close_min := $7FFF_FFFF
    close_max := 0
    close_total := 0

    repeat iter from 0 to ITERATIONS - 1
        ' Measure open
        start_ct := getct()
        handle := sd.openFileRead(@testFile)
        elapsed_ct := getct() - start_ct
        timings[iter] := elapsed_ct / (clkfreq / 1_000_000)
        open_total += timings[iter]
        if timings[iter] < open_min
            open_min := timings[iter]
        if timings[iter] > open_max
            open_max := timings[iter]

        ' Measure close
        start_ct := getct()
        sd.closeFileHandle(handle)
        elapsed_ct := getct() - start_ct
        timings[iter] := elapsed_ct / (clkfreq / 1_000_000)
        close_total += timings[iter]
        if timings[iter] < close_min
            close_min := timings[iter]
        if timings[iter] > close_max
            close_max := timings[iter]

    open_avg := open_total / ITERATIONS
    close_avg := close_total / ITERATIONS

    debug(" ")
    debug("File Open/Close:")
    debug("  Open:  Min=", udec_(open_min), " Avg=", udec_(open_avg), " Max=", udec_(open_max), " us")
    debug("  Close: Min=", udec_(close_min), " Avg=", udec_(close_avg), " Max=", udec_(close_max), " us")

    ' Cleanup
    sd.deleteFile(@testFile)


' UTILITY

PRI fillBuffer(size, seed)
' Fill the test buffer with a SHIFT-DETECTABLE pattern.
'
' This was a bytefill() of one repeated value until 2026-08-18. A uniform buffer
' is worthless for verification: a read (or write) shifted by a bit or a byte
' reproduces a uniform pattern EXACTLY, including its CRC, so the corruption
' this benchmark now checks for would compare equal and pass. That is not a
' hypothetical -- it is the aliasing that blinded the socket shmoo's Path B in
' round 6 (SOCKET-SHMOO-RUN-NOTES.md) until the reference sector was changed.
'
' The pattern varies within a sector AND between sectors, so a shift, a dropped
' byte, and a wrong-sector read are all distinguishable, and the offset of a
' shift is recoverable from a dump. The seed keeps different call sites writing
' different content, as the old value argument did.
'
' Timing note: write duration is independent of data content, so this does not
' affect the throughput being measured.
'
' @param size - Number of bytes to fill
' @param seed - Per-call-site seed, keeps distinct sites distinguishable

    fillPattern(@testBuffer, size, seed)

PRI fillPattern(p_buf, size, seed) | idx
' Write the shift-detectable pattern into any buffer. See fillBuffer.
'
' @param p_buf - Destination buffer
' @param size - Number of bytes
' @param seed - Pattern seed
' @local idx - Byte index

    repeat idx from 0 to size - 1
        BYTE[p_buf][idx] := (idx + (idx >> 8) + seed) & $FF

