{Spin2_v49}
'' =========================================================================================
''
''   File....... SD_demo_shell.spin2
''   Purpose.... Interactive command-line shell for SD card filesystem
''   Author..... Stephen M Moraco
''   E-mail..... stephen@ironsheep.biz
''   Started.... FEB 2026
''   Updated.... 07 FEB 2026
''
'' =========================================================================================

{ Description:
   Interactive shell for exploring SD card filesystem operations.
   Supports both DOS-style (dir, type, del) and Unix-style (ls, cat, rm) commands.

   Connect via serial terminal at 2,000,000 baud (2 Mbit).
   Type 'help' for list of available commands.
}

CON { timing }

  CLK_FREQ  = 350_000_000                                                     ' system freq as a constant

  _CLKFREQ  = CLK_FREQ                                                        ' set system clock

#pragma exportdef SD_INCLUDE_DEFRAG

CON { terminal }

'  BR_TERM  = 230_400                                            ' terminal baud rate
  BR_TERM        = 2_000_000                                                  ' terminal baud rate

  DEBUG_BAUD     = BR_TERM                                                    ' debug baud must match terminal
  DEBUG_DISABLE  = 1                                                          ' suppress debug() in this file

CON { SD card pins }

  ' P2 Edge module SD slot pins
  SD_CS    = 60  { O }                                                        ' chip select
  SD_SCK   = 61  { O }                                                        ' serial clock
  SD_MOSI  = 59  { O }                                                        ' master out, slave in
  SD_MISO  = 58  { I }                                                        ' master in, slave out

  ' External SD header (base pin 16)
  'SD_CS   = 20
  'SD_MOSI = 19
  'SD_MISO = 18
  'SD_SCK  = 21

CON { fixed io pins }

  PGM_RX  = 63  { I }                                                         ' programming / debug
  PGM_TX  = 62  { O }

CON { constants }

  #TRUE, ON, OFF
  #FALSE, NO, YES

  MAX_PATH     = 128                                                          ' max path length
  SECTOR_SIZE  = 512                                                          ' SD sector size
  BUFFER_SIZE  = 512                                                          ' read/write buffer

CON { FAT32 / bench constants }

  ' FAT32 structure signatures (used by detectFilesystem / do_card_info)
  MBR_SIGNATURE             = $AA55
  PARTITION_TYPE_FAT32_LBA  = $0C

  ' Sector-to-megabyte conversion
  SECTORS_PER_MB            = 2048                                            ' 512 * 2048 = 1 MB

  ' Confirm prompt suffix length: " (y/N)? " = 8 chars
  CONFIRM_SUFFIX_LEN        = 8

  ' Bench test parameters
  BENCH_SECTOR_BASE         = 1_000_000                                       ' Safe area past filesystem
  BENCH_SECTOR_RANGE        = 10_000                                          ' Range of test sectors
  BENCH_BUF_LONGS           = 8192                                            ' 32 KB for multi-sector reads

CON { parser }

  CLI_BUF_SIZE  = 128                                                         ' command input buffer size
  CLI_MAX_TKNS  = 10                                                          ' max tokens per command

CON { FAT32 directory entry offsets }

  DE_WRT_TIME  = 22                                                           ' modification time (WORD)
  DE_WRT_DATE  = 24                                                           ' modification date (WORD)

CON { command enums }

  #0, CMD_UNKNOWN, CMD_HELP, CMD_VERSION, CMD_CLS, CMD_CLEAR
  CMD_MOUNT, CMD_UNMOUNT, CMD_EJECT, CMD_FORMAT
  CMD_STATS, CMD_INFO, CMD_DIR, CMD_LS
  CMD_CD, CMD_PWD, CMD_MKDIR
  CMD_TYPE, CMD_CAT, CMD_HEXDUMP, CMD_HD
  CMD_REN, CMD_MV, CMD_MOVE, CMD_COPY, CMD_CP
  CMD_DEL, CMD_RM, CMD_RMDIR
  CMD_DEMO, CMD_CARD, CMD_CID
  CMD_BENCHMARK, CMD_PERF, CMD_TOUCH
  CMD_AUDIT, CMD_FSCK, CMD_BENCH
  CMD_LABEL, CMD_VOL
  CMD_ALIAS, CMD_TREE
  CMD_DATE

'' Enable full driver features for card info display
#ifdef __SPINTOOLS__
#define SD_INCLUDE_ALL
#elseifdef __FLEXSPIN__
#define SD_INCLUDE_ALL
#pragma exportdef SD_INCLUDE_ALL
#else
#pragma exportdef SD_INCLUDE_ALL
#endif

OBJ

  sd            : "micro_sd_fat32_fs"                   '   SD card filesystem driver
  serial        : "isp_serial_singleton"                '   serial IO for terminal (singleton)
  fmt           : "isp_mem_strings"                     '   string formatting (for card display)
  fsckUtil      : "isp_fsck_utility"                    '   FSCK/audit library (cog-based)
  fmtUtil       : "isp_format_utility"                  '   format library (cog-based)

VAR { application }

  BYTE  buffer[BUFFER_SIZE]                                                   ' general purpose buffer
  BYTE  cwd[MAX_PATH]                                                         ' current working directory
  BYTE  ntokens                                                               ' number of parsed tokens
  BYTE  mounted                                                               ' mount status flag

VAR { card info - driver receive buffers (moved from locals TO avoid stack issues) }

  sd.cid_t  cid                                                               ' CID register from card
  sd.scr_t  scr                                                               ' SCR register from card

' DAT { card info - driver receive buffers (moved from locals to avoid stack issues) }

'  cid      sd.cid_t                                                    ' CID register from card
'  scr      sd.scr_t                                                    ' SCR register from card

VAR { card info / bench }

  BYTE  buf2[SECTOR_SIZE]                                                     ' card info / detect buffer

  ' Struct overlay pointers (set before use, overlaid on buf2)
  LONG  pVBR                                                                  ' ^sd.vbr_t overlay
  LONG  pPart                                                                 ' ^sd.mbr_partition_t overlay

  ' Bench multi-sector read buffer (32 KB)
  LONG  benchBuf[BENCH_BUF_LONGS]

VAR { parser }

  BYTE  cliBuf[CLI_BUF_SIZE]                                                  ' command input buffer
  BYTE  cliIdx                                                                ' current position in buffer
  LONG  tkPtrs[CLI_MAX_TKNS]                                                  ' pointers to parsed tokens

PUB main() | len, eCmd
'' Entry point for the interactive shell - initializes serial, waits for terminal, then runs command loop.
''
' @local len - Length of command entered
' @local eCmd - Enum value of the parsed command

  serial.start(BR_TERM)                                 ' full pin init (debug disabled in this file)
  waitms(250)                                           ' let terminal connect after download
  serial.tx(serial.CLS)
  serial.fstr0(@"* Press return to start...\r\n")
  wait_for_terminal(FALSE, 0)

  serial.tx(serial.CLS)
  serial.fstr0(@"P2 SD Card Filesystem Shell\r\n")
  serial.fstr0(@"- type 'help' for commands\r\n")
  serial.fstr0(@"\r\n")
  DEBUG("SD Shell: ready for commands")

  ' Initialize current working directory
  bytemove(@cwd, @"/", 2)
  mounted := FALSE

  repeat
    show_prompt()                                       ' prompt user
    len := get_command()                                ' get input
    if (len > 0)                                        ' if command entered
      serial.tx(serial.CRSR_X)                          ' position cursor past prompt
      serial.tx(prompt_len())
      serial.fstr1(@"%s\r\n", @cliBuf)                  ' command + CRLF flushes display
      DEBUG("CMD: [", zstr_(@cliBuf), "] len=", udec_(len))
      ntokens := parse()                                ' parse and count tokens
      if (ntokens)                                      ' if !0 tokens
        eCmd := idCommand(lcstr(token(0)))              ' lookup command enum
        DEBUG("  -> enum=", udec_(eCmd), " tokens=", udec_(ntokens))
        run_command(eCmd)                               ' run command code

PUB get_command() : len | idx
'' Read a command line from the terminal - waits for CR-terminated input.
''
'' @returns len - Number of characters entered
' @local idx - Loop counter for tab conversion

  len := 0
  parserReset()                                         ' prep for new entry

  cliIdx := serial.rxline(@cliBuf, CLI_BUF_SIZE)        ' tight receive until CR

  ' convert tabs to spaces
  repeat idx from 0 TO cliIdx - 1
    if (cliBuf[idx] == 9)
      cliBuf[idx] := " "

  len := cliIdx                                         ' report length of input

PUB show_prompt()
'' Display command prompt with current directory path.

  if (mounted)
    serial.fstr1(@"SD:%s> \r", @cwd)
  ELSE
    serial.fstr0(@"SD:(unmounted)> \r")

PRI prompt_len() : len
' Calculate prompt string length for cursor positioning.
'
' @returns len - Number of characters in the current prompt

  if (mounted)
    len := 5 + strsize(@cwd)                            ' "SD:" + cwd + "> "
  ELSE
    len := 16                                           ' "SD:(unmounted)> "

CON { command handlers }

PUB run_command(eCmd)
'' Dispatch and execute the shell command identified by its enum value.
''
'' @param eCmd - Command enum (CMD_HELP, CMD_DIR, etc.)

  if (eCmd == CMD_UNKNOWN)
    serial.fstr1(@"'%s' is not recognized as a command\r\n", token(0))
  ELSE
    case eCmd
      CMD_HELP                : show_help()
      CMD_VERSION             : show_version()
      CMD_CLS, CMD_CLEAR      : do_cls()
      CMD_MOUNT               : do_mount()
      CMD_UNMOUNT, CMD_EJECT  : do_unmount()
      CMD_FORMAT              : do_format()
      CMD_STATS, CMD_INFO     : do_stats()
      CMD_DIR, CMD_LS         : do_dir()
      CMD_CD                  : do_cd()
      CMD_PWD                 : do_pwd()
      CMD_MKDIR               : do_mkdir()
      CMD_TYPE, CMD_CAT       : do_type()
      CMD_HEXDUMP, CMD_HD     : do_hexdump()
      CMD_REN                 : do_rename()
      CMD_MV, CMD_MOVE        : do_move()
      CMD_COPY, CMD_CP        : do_copy()
      CMD_DEL, CMD_RM         : do_delete()
      CMD_RMDIR               : do_rmdir()
      CMD_DEMO                : do_demo()
      CMD_CARD, CMD_CID       : do_card_info()
      CMD_BENCHMARK, CMD_PERF, CMD_BENCH : do_bench()
      CMD_TOUCH               : do_touch()
      CMD_AUDIT               : do_audit()
      CMD_FSCK                : do_fsck()
      CMD_LABEL, CMD_VOL      : do_label()
      CMD_ALIAS               : do_alias()
      CMD_TREE                : do_tree()
      CMD_DATE                : do_date()
      other                   : not_implemented()

PUB show_help()
'' Display the full help screen listing all available shell commands.

  if (ntokens <> 1)
    bad_syntax()
  ELSE
    serial.tx(serial.CLS)
    serial.fstr0(@"  SD Shell v1.4.2\r\n\r\n")
    serial.fstr0(@"  Navigation                          File Operations\r\n")
    serial.fstr0(@"  mount       Mount SD card           type <f>    Show text (cat)\r\n")
    serial.fstr0(@"  unmount     Unmount (eject)         hexdump <f> Hex dump (hd)\r\n")
    serial.fstr0(@"  dir [path]  List files (ls)         copy <s><d> Copy file (cp)\r\n")
    serial.fstr0(@"  tree [path] Directory tree          ren <o> <n> Rename in place\r\n")
    serial.fstr0(@"  cd <path>   Change directory        move <f><d> Move file (mv)\r\n")
    serial.fstr0(@"  pwd         Working directory       del <f>     Delete (rm)\r\n")
    serial.fstr0(@"  mkdir <d>   Create directory        touch <f>   Create file\r\n")
    serial.fstr0(@"  rmdir <d>   Remove directory        demo        Create demo files\r\n")
    serial.fstr0(@"\r\n")
    serial.fstr0(@"  Information                         Diagnostics & Utility\r\n")
    serial.fstr0(@"  stats       FS stats (info)         audit       Check FS integrity\r\n")
    serial.fstr0(@"  card        Card summary (cid)      fsck        Check & repair FS\r\n")
    serial.fstr0(@"  version     Driver version          bench       Throughput test\r\n")
    serial.fstr0(@"  label [n]   Volume label (vol)      format      Format SD card\r\n")
    serial.fstr0(@"  date        Show current date       help        This help\r\n")
    serial.fstr0(@"  date YYYY MM DD HH MM SS  Set date+time\r\n")
    serial.fstr0(@"  cls         Clear screen\r\n")
    serial.fstr0(@"  alias       Show command aliases\r\n")

PUB show_version()
'' Display driver version and current SPI frequency.

  if (ntokens <> 1)
    bad_syntax()
  ELSE
    serial.fstr0(@"SD Card Driver - Iron Sheep Productions\r\n")
    serial.fstr1(@"SPI Frequency: %d Hz\r\n", sd.getSPIFrequency())

PUB do_cls()
'' Clear the terminal screen.

  if (ntokens <> 1)
    bad_syntax()
  ELSE
    serial.tx(serial.CLS)

PUB do_mount() | result
'' Mount the SD card filesystem and display a brief card summary.
''
' @local result - Mount return value (SUCCESS or negative error code)

  if (ntokens <> 1)
    bad_syntax()
  elseif (mounted)
    serial.fstr0(@"SD card is already mounted\r\n")
  ELSE
    serial.fstr0(@"Mounting SD card...\r\n")
    result := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    DEBUG("mount result=", sdec_(result), " err=", sdec_(sd.error()))

    if result == sd.SUCCESS
      mounted := TRUE
      bytemove(@cwd, @"/", 2)                           ' reset to root
      serial.fstr0(@"Mounted successfully\r\n")
      DEBUG("  mounted, SPI=", udec_(sd.getSPIFrequency()), " Hz")
      show_card_summary()
    ELSE
      serial.fstr1(@"Mount failed, error: %d\r\n", sd.error())

PUB do_unmount()
'' Unmount the SD card filesystem and release the driver.

  if (ntokens <> 1)
    bad_syntax()
  elseif (check_mount() == FALSE)
  ' error already printed by check_mount()
  ELSE
    sd.unmount()
    mounted := FALSE
    serial.fstr0(@"SD card unmounted\r\n")

PUB do_format() | p_label, pStr, ok, label_ok
'' Format SD card via the format utility library (cog-based).
'' Usage: format          - format with default label
''        format LABEL    - format with specified label (max 11 chars)
''
' @local p_label - Pointer to optional volume label string
' @local pStr - Pointer to FIFO output string from format cog
' @local ok - Format success/failure result
' @local label_ok - True if optional label argument is valid

  if (ntokens > 2)
    bad_syntax()
  elseif (NOT confirmYN(@"WARNING: Format will erase ALL data on the SD card!\r\nContinue with format"))
  ' user declined
  ELSE
    ' Must unmount first
    if (mounted)
      sd.unmount()
      mounted := FALSE
      serial.fstr0(@"Unmounted.\r\n")
    ELSE
      ' Stop any existing driver so format library can use SPI
      sd.stop()

    ' Parse optional label argument
    p_label := 0
    label_ok := TRUE
    if (ntokens == 2)
      p_label := token(1)
      if strsize(p_label) > 11
        serial.fstr0(@"Label too long (max 11 characters)\r\n")
        label_ok := FALSE

    if (label_ok)
      ' Launch format in utility cog
      if (p_label)
        ok := fmtUtil.startFormatWithLabel(SD_CS, SD_MOSI, SD_MISO, SD_SCK, p_label)
      ELSE
        ok := fmtUtil.startFormat(SD_CS, SD_MOSI, SD_MISO, SD_SCK)

      if (NOT ok)
        serial.fstr0(@"ERROR: Could not start format cog\r\n")
      ELSE
        ' Pump FIFO output to terminal
        repeat
          pStr := fmtUtil.getOutput()
          if pStr
            serial.str(pStr)
            serial.fstr0(@"\r\n")
          elseif fmtUtil.isDone()
            repeat while (pStr := fmtUtil.getOutput())
              serial.str(pStr)
              serial.fstr0(@"\r\n")
            quit

        ok := fmtUtil.getResult()
        fmtUtil.stopCog()

        if (ok)
          serial.fstr0(@"Format complete.\r\n")
        ELSE
          serial.fstr0(@"Format FAILED.\r\n")

        ' Offer to re-mount
        serial.fstr0(@"\r\n")
        if (confirmYN(@"Mount card"))
          do_mount()

PUB do_stats() | total_sectors, total_mb, free_sectors, free_mb
'' Display filesystem statistics including total/free space and volume label.
'' For card hardware info, use the 'card' command instead.
''
' @local total_sectors - Total sectors on card
' @local total_mb - Total capacity in megabytes
' @local free_sectors - Free sectors available
' @local free_mb - Free space in megabytes

  if (ntokens <> 1)
    bad_syntax()
  elseif (check_mount() == FALSE)
  ' error already printed by check_mount()
  ELSE
    total_sectors := sd.cardSizeSectors()
    total_mb := total_sectors / SECTORS_PER_MB
    free_sectors := sd.freeSpace()
    free_mb := free_sectors / SECTORS_PER_MB

    serial.fstr2(@"Total:  %d sectors (%d MB)\r\n", total_sectors, total_mb)
    serial.fstr2(@"Free:   %d sectors (%d MB)\r\n", free_sectors, free_mb)
    serial.fstr1(@"Label:  %s\r\n", sd.volumeLabel())

PUB do_dir() | dh, result, count, total_size, attrib, size, p_name, p_path, p_entry, wrt_date, wrt_time, yr, mo, dy, hr, mn
'' List directory contents with attributes, timestamps, sizes, and summary.
''
' @local dh - Directory handle
' @local result - readDirectoryHandle result
' @local count - Number of entries listed
' @local total_size - Cumulative file size in bytes
' @local attrib - FAT attribute byte for current entry
' @local size - File size of current entry
' @local p_name - Pointer to current entry name string
' @local p_path - Pointer to path argument or "."
' @local p_entry - Pointer to 32-byte FAT directory entry
' @local wrt_date - Packed FAT date word
' @local wrt_time - Packed FAT time word
' @local yr - Year extracted from date
' @local mo - Month extracted from date
' @local dy - Day extracted from date
' @local hr - Hour extracted from time
' @local mn - Minute extracted from time

  if (ntokens > 2)
    bad_syntax()
  elseif (check_mount() == FALSE)
  ' error already printed by check_mount()
  ELSE
    ' Use argument as path, or "." for current directory
    if (ntokens == 2)
      p_path := token(1)
      if (strsize(@cwd) == 1)                                                   ' cwd is "/"
        serial.fstr2(@"\r\n Directory of %s%s\r\n\r\n", @cwd, p_path)
      ELSE
        serial.fstr2(@"\r\n Directory of %s/%s\r\n\r\n", @cwd, p_path)
    ELSE
      p_path := @"."
      serial.fstr1(@"\r\n Directory of %s\r\n\r\n", @cwd)
    serial.fstr0(@"  Attr  Modified              Size  Name\r\n")
    serial.fstr0(@"  ----  ----------------  --------  --------------------------------\r\n")

    dh := sd.openDirectory(p_path)
    if (dh < 0)
      serial.fstr1(@"  Error opening directory: %d\r\n", dh)
    ELSE
      count := 0
      total_size := 0

      repeat
        p_entry := sd.readDirectoryHandle(dh)
        if (p_entry == 0)                                                       ' no more entries
          quit

        p_name := sd.fileName()
        if (BYTE[p_name] == 0)                                                  ' empty name, skip
          next

        attrib := sd.attributes()
        size := sd.fileSize()

        ' Extract modification timestamp from directory entry
        wrt_time := WORD[p_entry + DE_WRT_TIME]
        wrt_date := WORD[p_entry + DE_WRT_DATE]
        yr := (wrt_date >> 9) + 1980
        mo := (wrt_date >> 5) & $0F
        dy := wrt_date & $1F
        hr := wrt_time >> 11
        mn := (wrt_time >> 5) & $3F

        ' Format attributes
        serial.fstr0(@"  ")
        serial.tx((attrib & sd.ATTR_DIRECTORY) ? "D" : "-")                     ' directory
        serial.tx((attrib & sd.ATTR_READONLY) ? "R" : "-")                      ' read-only
        serial.tx((attrib & sd.ATTR_HIDDEN) ? "H" : "-")                        ' hidden
        serial.tx((attrib & sd.ATTR_SYSTEM) ? "S" : "-")                        ' system

        ' Format timestamp: YYYY-MM-DD HH:MM
        serial.fstr0(@"  ")
        emit_zpad(yr, 4)
        serial.tx("-")
        emit_zpad(mo, 2)
        serial.tx("-")
        emit_zpad(dy, 2)
        serial.tx(" ")
        emit_zpad(hr, 2)
        serial.tx(":")
        emit_zpad(mn, 2)

        if (attrib & sd.ATTR_DIRECTORY)                                         ' directory
          serial.fstr1(@"    <DIR>  %s\r\n", p_name)
        ELSE
          serial.fstr2(@"  %8d  %s\r\n", size, p_name)
          total_size += size

        count++

      sd.closeDirectoryHandle(dh)

      serial.fstr0(@"\r\n")
      serial.fstr2(@"  %d file(s), %d bytes\r\n", count, total_size)

PUB do_cd() | p_path
'' Change the current working directory. Supports "/", "..", and named subdirectories.
''
' @local p_path - Pointer to the target path argument

  if (ntokens <> 2)
    bad_syntax()
  elseif (check_mount() == FALSE)
  ' error already printed by check_mount()
  ELSE
    p_path := token(1)

    ' Handle special cases
    if (strcomp(p_path, @"/") OR strcomp(p_path, @"\\"))
      ' Go to root
      sd.changeDirectory(@"/")
      bytemove(@cwd, @"/", 2)
    elseif (strcomp(p_path, @".."))
      ' Go up one level
      go_up_directory()
    ELSE
      ' Try to change to specified directory
      if sd.changeDirectory(p_path) == sd.SUCCESS
        update_cwd(p_path)
      ELSE
        serial.fstr1(@"Directory not found: %s\r\n", p_path)

PUB do_pwd()
'' Print the current working directory path.

  if (ntokens <> 1)
    bad_syntax()
  elseif (check_mount() == FALSE)
  ' error already printed by check_mount()
  ELSE
    serial.fstr1(@"%s\r\n", @cwd)

PUB do_mkdir() | p_name, p_leaf, has_path, result
'' Create a new directory. Supports paths like "work/logs":
''   - Navigates to parent ("work"), creates leaf ("logs"), navigates back.
''   - Parent directory must already exist.
''
' @local p_name - Pointer to the full path argument
' @local p_leaf - Pointer to leaf name within the path
' @local has_path - True if path contained "/" separators
' @local result - newDirectory result (SUCCESS or negative error code)

  if (ntokens <> 2)
    bad_syntax()
  elseif (check_mount() == FALSE)
  ' error already printed by check_mount()
  ELSE
    p_name := token(1)
    p_leaf, has_path := navigate_to_parent(p_name)
    if p_leaf <> 0
      result := sd.newDirectory(p_leaf)
      if result == sd.SUCCESS
        serial.fstr1(@"Created: %s\r\n", p_leaf)
      ELSE
        serial.fstr1(@"Failed to create: %s\r\n", p_leaf)

      if has_path
        nav_back(p_name)

PUB do_type() | p_name, p_leaf, has_path, handle, bytes_read, total, ch, idx
'' Display contents of a text file. Supports paths like "work/readme.txt".
''
' @local p_name - Pointer to the full path argument
' @local p_leaf - Pointer to leaf filename within the path
' @local has_path - True if path contained "/" separators
' @local handle - File read handle
' @local bytes_read - Bytes returned from readHandle
' @local total - Cumulative bytes displayed
' @local ch - Current character being displayed
' @local idx - Loop index within the read buffer

  if (ntokens <> 2)
    bad_syntax()
  elseif (check_mount() == FALSE)
  ' error already printed by check_mount()
  ELSE
    p_name := token(1)
    p_leaf, has_path := navigate_to_parent(p_name)
    if p_leaf <> 0
      handle := sd.openFileRead(p_leaf)
      DEBUG("openFileRead handle=", sdec_(handle))

      if (handle < 0)
        serial.fstr1(@"File not found: %s\r\n", p_leaf)
      ELSE
        serial.fstr0(@"\r\n")
        total := 0

        repeat
          bytes_read := sd.readHandle(handle, @buffer, BUFFER_SIZE - 1)
          if (bytes_read <= 0)
            quit

          ' Display as text
          repeat idx from 0 TO bytes_read - 1
            ch := buffer[idx]
            if (ch == 13) OR (ch == 10)                 ' CR or LF
              serial.tx(ch)
            elseif (ch >= 32 AND ch < 127)              ' printable
              serial.tx(ch)
            ELSE
              serial.tx(".")                            ' non-printable

          total += bytes_read

        sd.closeFileHandle(handle)
        serial.fstr1(@"\r\n\r\n[%d bytes]\r\n", total)

      if has_path
        nav_back(p_name)

PUB do_hexdump() | p_name, p_leaf, has_path, handle, bytes_read, offset, idx, ch, fileSize
'' Display file contents in hex+ASCII format. Supports paths like "work/data.bin".
''
' @local p_name - Pointer to the full path argument
' @local p_leaf - Pointer to leaf filename within the path
' @local has_path - True if path contained "/" separators
' @local handle - File read handle
' @local bytes_read - Bytes returned from readHandle
' @local offset - Current byte offset within the file
' @local idx - Loop index within the 16-byte line
' @local ch - Current byte being displayed
' @local fileSize - Total file size from handle

  if (ntokens <> 2)
    bad_syntax()
  elseif (check_mount() == FALSE)
  ' error already printed by check_mount()
  ELSE
    p_name := token(1)
    p_leaf, has_path := navigate_to_parent(p_name)
    if p_leaf <> 0
      handle := sd.openFileRead(p_leaf)
      DEBUG("openFileRead handle=", sdec_(handle))

      if (handle < 0)
        serial.fstr1(@"File not found: %s\r\n", p_leaf)
      ELSE
        serial.fstr0(@"\r\n")
        offset := 0

        repeat
          bytes_read := sd.readHandle(handle, @buffer, 16)
          if (bytes_read <= 0)
            quit

          ' Print offset
          serial.fstr1(@"%.8x  ", offset)

          ' Print hex bytes
          repeat idx from 0 TO 15
            if (idx < bytes_read)
              serial.fstr1(@"%.2x ", buffer[idx])
            ELSE
              serial.fstr0(@"   ")
            if (idx == 7)
              serial.tx(" ")

          serial.fstr0(@" |")

          ' Print ASCII
          repeat idx from 0 TO bytes_read - 1
            ch := buffer[idx]
            if (ch >= 32 AND ch < 127)
              serial.tx(ch)
            ELSE
              serial.tx(".")

          serial.fstr0(@"|\r\n")
          offset += bytes_read

          ' Limit output to first 512 bytes
          if (offset >= SECTOR_SIZE)
            serial.fstr0(@"... (truncated at 512 bytes)\r\n")
            quit

        fileSize := sd.fileSizeHandle(handle)
        sd.closeFileHandle(handle)
        serial.fstr1(@"\r\n[%d bytes total]\r\n", fileSize > 0 ? fileSize : offset)

      if has_path
        nav_back(p_name)

PUB do_rename() | p_old, p_new, p_old_leaf, p_new_leaf, has_path, result
'' Rename a file or directory in place. Supports paths like "work/old.txt new.txt".
'' Both names must resolve to the same directory.
''
' @local p_old - Pointer to original name argument
' @local p_new - Pointer to new name argument
' @local p_old_leaf - Pointer to leaf of old name
' @local p_new_leaf - Pointer to leaf of new name
' @local has_path - True if old name contained "/" separators
' @local result - Rename result (SUCCESS or negative error code)

  if (ntokens <> 3)
    bad_syntax()
  elseif (check_mount() == FALSE)
  ' error already printed by check_mount()
  ELSE
    p_old := token(1)
    p_new := token(2)

    ' Navigate to old name's parent directory
    p_old_leaf, has_path := navigate_to_parent(p_old)
    if p_old_leaf <> 0
      ' Extract leaf from new name (ignore any path prefix)
      p_new_leaf := path_leaf(p_new)

      result := sd.rename(p_old_leaf, p_new_leaf)

      if result == sd.SUCCESS
        serial.fstr2(@"Renamed '%s' to '%s'\r\n", p_old_leaf, p_new_leaf)
      ELSE
        serial.fstr1(@"Failed to rename: %s\r\n", p_old_leaf)

      if has_path
        nav_back(p_old)

PUB do_move() | p_src, p_dst, p_src_leaf, has_path, dh, result
'' Move a file to a directory, or rename if destination is a plain name.
'' Examples: mv a.txt work, mv work/a.txt backup, mv a.txt b.txt
''
' @local p_src - Pointer to source path argument
' @local p_dst - Pointer to destination path argument
' @local p_src_leaf - Pointer to leaf of source name
' @local has_path - True if source contained "/" separators
' @local dh - Directory handle (tests if dest is a directory)
' @local result - Move/rename result (SUCCESS or negative error code)

  if (ntokens <> 3)
    bad_syntax()
  elseif (check_mount() == FALSE)
  ' error already printed by check_mount()
  ELSE
    p_src := token(1)
    p_dst := token(2)

    ' Navigate to source's parent directory
    p_src_leaf, has_path := navigate_to_parent(p_src)
    if p_src_leaf <> 0
      ' Check if dest is a directory
      dh := sd.openDirectory(p_dst)
      if dh >= 0
        ' Dest is a directory -- move file into it
        sd.closeDirectoryHandle(dh)
        result := sd.moveFile(p_src_leaf, p_dst)
        if result == sd.SUCCESS
          serial.fstr2(@"Moved '%s' to %s/\r\n", p_src_leaf, p_dst)
        ELSE
          serial.fstr1(@"Failed to move: %s\r\n", p_src_leaf)
      ELSE
        ' Dest is not a directory -- rename in place
        result := sd.rename(p_src_leaf, path_leaf(p_dst))
        if result == sd.SUCCESS
          serial.fstr2(@"Renamed '%s' to '%s'\r\n", p_src_leaf, path_leaf(p_dst))
        ELSE
          serial.fstr1(@"Failed to rename: %s\r\n", p_src_leaf)

      if has_path
        nav_back(p_src)

PUB do_copy() | p_src, p_dst, p_src_leaf, p_dst_leaf, src_has_path, dst_has_path, dst_is_dir, dh, h_src, h_dst, bytes_read, total, src_open, dst_open, ok
'' Copy a file. Supports paths and "copy file dir" (keeps source name).
'' Examples: copy a.txt b.txt, copy a.txt work, copy work/a.txt backup/b.txt
''
' @local p_src - Pointer to source path argument
' @local p_dst - Pointer to destination path argument
' @local p_src_leaf - Pointer to leaf of source filename
' @local p_dst_leaf - Pointer to leaf of destination filename
' @local src_has_path - True if source contained "/" separators
' @local dst_has_path - True if destination contained "/" separators
' @local dst_is_dir - True if destination is an existing directory
' @local dh - Directory handle (tests if dest is a directory)
' @local h_src - Source file read handle
' @local h_dst - Destination file write handle
' @local bytes_read - Bytes returned from readHandle per iteration
' @local total - Cumulative bytes copied
' @local src_open - True if source handle is open and needs closing
' @local dst_open - True if destination handle is open and needs closing
' @local ok - True if copy operation can proceed

  if (ntokens <> 3)
    bad_syntax()
  elseif (check_mount() == FALSE)
  ' error already printed by check_mount()
  ELSE
    p_src := token(1)
    p_dst := token(2)
    src_open := FALSE
    dst_open := FALSE
    dst_is_dir := FALSE
    dst_has_path := FALSE
    ok := TRUE

    if (strcomp(p_src, p_dst))
      serial.fstr0(@"Cannot copy file to itself\r\n")
      ok := FALSE

    ' Navigate to source parent and open for read
    if (ok)
      p_src_leaf, src_has_path := navigate_to_parent(p_src)
      if p_src_leaf == 0
        ok := FALSE

    if (ok)
      h_src := sd.openFileRead(p_src_leaf)
      if (h_src < 0)
        serial.fstr1(@"Source file not found: %s\r\n", p_src_leaf)
        ok := FALSE
      ELSE
        src_open := TRUE

      ' Navigate back before opening dest (handles are CWD-independent)
      if src_has_path
        nav_back(p_src)

    ' Navigate to dest parent directory (if path has "/")
    if (ok)
      p_dst_leaf, dst_has_path := navigate_to_parent(p_dst)
      if p_dst_leaf == 0
        ok := FALSE

    ' Check if dest leaf is a directory -- if so, cd into it and use source name
    if (ok)
      dh := sd.openDirectory(p_dst_leaf)
      if dh >= 0
        sd.closeDirectoryHandle(dh)
        ' Dest is a directory -- cd into it and use source filename
        if sd.changeDirectory(p_dst_leaf) < 0
          serial.fstr1(@"Cannot enter directory: %s\r\n", p_dst_leaf)
          ok := FALSE
        ELSE
          dst_is_dir := TRUE
          p_dst_leaf := p_src_leaf

    if (ok)
      h_dst := sd.createFileNew(p_dst_leaf)
      if (h_dst < 0)
        serial.fstr1(@"Cannot create destination: %s\r\n", p_dst_leaf)
        ok := FALSE
      ELSE
        dst_open := TRUE

    ' Navigate back before copy loop
    if dst_is_dir
      sd.changeDirectory(@"..")
    if dst_has_path
      nav_back(p_dst)

    if (ok)
      ' Copy data (both handles are open and CWD-independent)
      total := 0
      repeat
        bytes_read := sd.readHandle(h_src, @buffer, BUFFER_SIZE)
        if (bytes_read <= 0)
          quit
        sd.writeHandle(h_dst, @buffer, bytes_read)
        total += bytes_read

    ' Always close any open handles
    if (src_open)
      sd.closeFileHandle(h_src)
    if (dst_open)
      sd.closeFileHandle(h_dst)

    if (ok)
      serial.fstr2(@"Copied %d bytes to %s\r\n", total, p_dst_leaf)

PUB do_delete() | p_name, p_leaf, has_path, result
'' Delete a file. Supports paths like "work/test.txt".
''
' @local p_name - Pointer to the full path argument
' @local p_leaf - Pointer to leaf filename within the path
' @local has_path - True if path contained "/" separators
' @local result - Delete result (SUCCESS or negative error code)

  if (ntokens <> 2)
    bad_syntax()
  elseif (check_mount() == FALSE)
  ' error already printed by check_mount()
  ELSE
    p_name := token(1)
    p_leaf, has_path := navigate_to_parent(p_name)
    if p_leaf <> 0
      result := sd.deleteFile(p_leaf)

      if result == sd.SUCCESS
        serial.fstr1(@"Deleted: %s\r\n", p_leaf)
      ELSE
        serial.fstr1(@"Failed to delete: %s\r\n", p_leaf)

      if has_path
        nav_back(p_name)

PUB do_rmdir() | p_name, p_leaf, has_path, dh, result, p_entry, is_empty
'' Remove an empty directory. Supports paths like "work/logs".
''
' @local p_name - Pointer to the full path argument
' @local p_leaf - Pointer to leaf directory name within the path
' @local has_path - True if path contained "/" separators
' @local dh - Directory handle to verify existence
' @local result - readDirectoryHandle/deleteFile result (SUCCESS or negative error code)
' @local p_entry - Pointer to current entry name during emptiness check
' @local is_empty - True if directory contains no real entries

  if (ntokens <> 2)
    bad_syntax()
  elseif (check_mount() == FALSE)
  ' error already printed by check_mount()
  ELSE
    p_name := token(1)
    p_leaf, has_path := navigate_to_parent(p_name)
    if p_leaf <> 0
      ' Open directory to verify it exists and is a directory
      dh := sd.openDirectory(p_leaf)
      if (dh < 0)
        serial.fstr1(@"Not a directory: %s\r\n", p_leaf)
      ELSE
        ' Check if directory is empty (skip . and .. entries)
        is_empty := TRUE
        repeat
          result := sd.readDirectoryHandle(dh)
          if (result == 0)
            quit
          p_entry := sd.fileName()
          if (strcomp(p_entry, @".") OR strcomp(p_entry, @".."))
            next
          ' Found a real entry -- not empty
          is_empty := FALSE
          quit

        sd.closeDirectoryHandle(dh)

        if (NOT is_empty)
          serial.fstr1(@"Directory not empty: %s\r\n", p_leaf)
        ELSE
          ' Directory is empty, delete it
          result := sd.deleteFile(p_leaf)
          if result == sd.SUCCESS
            serial.fstr1(@"Removed: %s\r\n", p_leaf)
          ELSE
            serial.fstr1(@"Failed to remove: %s\r\n", p_leaf)

      if has_path
        nav_back(p_name)

PUB do_demo()
'' Create a set of demo files (HELLO.TXT, README.TXT, NUMBERS.TXT) in the current directory.
''

  if (ntokens <> 1)
    bad_syntax()
  elseif (check_mount() == FALSE)
  ' error already printed by check_mount()
  ELSE
    serial.fstr0(@"Creating demo files...\r\n")

    ' Create text file 1
    write_demo_file(@"HELLO.TXT", @demo_hello)
    write_demo_file(@"README.TXT", @demo_readme)
    write_demo_file(@"NUMBERS.TXT", @demo_numbers)

    serial.fstr0(@"Demo files created.\r\n")

PUB do_card_info() | wasMounted, card_ok,               ...
  ocr, sizeMB, spiHz, psn, mdtYear, mdtMonth,           ...
  pnm[2], p_mfr, p_type, p_spec, p_fs,                  ...
  oemBuf[3], partStart, idx, nLen
'' Display detailed card identification summary. Works mounted or unmounted.
'' Line 1: Manufacturer Product Type SizeMB/GB [FS] SDver revN.M SN:hex Year/Mo
'' Line 2: SPI freq MHz  [OEM name]
''
  ' @local wasMounted - True if card was already mounted on entry
  ' @local card_ok - True if card is ready for register reads
  ' @local ocr - OCR register value from card
  ' @local sizeMB - Card capacity in megabytes
  ' @local spiHz - Current SPI frequency in Hz
  ' @local psn - Product serial number from CID
  ' @local mdtYear - Manufacturing year from CID
  ' @local mdtMonth - Manufacturing month from CID
  ' @local pnm - Product name buffer (5 chars + null, 2 longs)
  ' @local p_mfr - Pointer to manufacturer name string
  ' @local p_type - Pointer to card type string (SDSC/SDHC/SDXC)
  ' @local p_spec - Pointer to SD spec version string
  ' @local p_fs - Pointer to filesystem type string
  ' @local oemBuf - OEM name buffer (8 chars + null, 3 longs)
  ' @local partStart - LBA start of first partition
  ' @local idx - Loop index for OEM name trimming
  ' @local nLen - Length of formatted string for concatenation

  if (ntokens <> 1)
    bad_syntax()
  ELSE
    wasMounted := mounted
    card_ok := TRUE

    ' If not mounted, initialize card for raw access
    if (NOT mounted)
      serial.fstr0(@"Initializing card...\r\n")
      if sd.initCardOnly(SD_CS, SD_MOSI, SD_MISO, SD_SCK) < 0
        serial.fstr0(@"ERROR: Cannot initialize card\r\n")
        card_ok := FALSE

    if (card_ok)
      serial.fstr0(@"card ready...\r\n")
      ' Read card registers into struct locals
      sd.readCIDRaw(@cid)
      sd.readSCRRaw(@scr)
      ocr := sd.getOCR()
      sizeMB := sd.cardSizeSectors() / SECTORS_PER_MB
      spiHz := sd.getSPIFrequency()

      ' Parse CID: product name (5 bytes, null-terminated)
      bytemove(@pnm, @cid.pnm, 5)
      BYTE[@pnm + 5] := 0

      ' Parse CID: serial number (4 bytes big-endian -> 32-bit LONG)
      psn := (cid.psn[0] << 24) | (cid.psn[1] << 16) | (cid.psn[2] << 8) | cid.psn[3]

      ' Parse CID: manufacturing date
      mdtYear := 2000 + ((cid.mdt[0] & $0F) << 4) + ((cid.mdt[1] >> 4) & $0F)
      mdtMonth := cid.mdt[1] & $0F

      ' Look up descriptive strings
      p_mfr := lookupMID(cid.mid)
      p_type := getCardType(ocr, sizeMB)
      p_spec := getSDSpecVersion(@scr)
      p_fs := detectFilesystem()

      ' Read VBR OEM name from partition boot record
      sd.readSectorRaw(0, @buf2)
      if WORD[@buf2 + sd.BOOT_SIG_OFFSET] == MBR_SIGNATURE
        pPart := @buf2 + sd.MBR_PARTITION_OFFSET
        partStart := partLbaStart(pPart)
        if partStart > 0
          sd.readSectorRaw(partStart, @buf2)
          bytemove(@oemBuf, @buf2 + 3, 8)
          BYTE[@oemBuf + 8] := 0
          ' Trim trailing spaces
          idx := 7
          repeat while idx >= 0
            if BYTE[@oemBuf + idx] <> " "
              quit
            BYTE[@oemBuf + idx] := 0
            idx--
        ELSE
          bytemove(@oemBuf, @"n/a", 4)
      ELSE
        bytemove(@oemBuf, @"n/a", 4)

      ' Line 1: Mfr Product Type Size [FS] Spec revN.M SN:hex Year/MM
      if sizeMB < 1024
        nLen := fmt.sFormatStr6(@buf2, SECTOR_SIZE, @"%s %s %s %dMB [%s] %s", p_mfr, @pnm, p_type, sizeMB, p_fs, p_spec)
      ELSE
        nLen := fmt.sFormatStr6(@buf2, SECTOR_SIZE, @"%s %s %s %dGB [%s] %s", p_mfr, @pnm, p_type, sizeMB / 1024, p_fs, p_spec)
      fmt.sFormatStr5(@BYTE[@buf2][nLen], SECTOR_SIZE - nLen, @" rev%d.%d SN:%.8x %d/%.2d\r\n", cid.prv >> 4, cid.prv & $0F, psn, mdtYear, mdtMonth)
      serial.str(@buf2)

      ' Line 2: SPI frequency and OEM name
      fmt.sFormatStr3(@buf2, SECTOR_SIZE, @"SPI %d.%d MHz  [%s]\r\n", spiHz / 1_000_000, (spiHz / 100_000) // 10, @oemBuf)
      serial.str(@buf2)

      ' Clean up if we initialized raw access
      if (NOT wasMounted)
        sd.stop()

PUB do_audit() | pStr
'' Audit FAT32 filesystem integrity via the FSCK library (read-only check).
'' Unmounts if mounted, runs audit in a utility cog, then offers to re-mount.
''
' @local pStr - Pointer to FIFO output string from audit cog

  if (ntokens <> 1)
    bad_syntax()
  ELSE
    ' Must unmount so library can use SPI
    if (mounted)
      sd.unmount()
      mounted := FALSE
      serial.fstr0(@"Unmounted for audit.\r\n")
    ELSE
      sd.stop()

    ' Launch audit in utility cog
    if (NOT fsckUtil.startAudit(SD_CS, SD_MOSI, SD_MISO, SD_SCK))
      serial.fstr0(@"ERROR: Could not start audit cog\r\n")
    ELSE
      ' Pump FIFO output to terminal
      repeat
        pStr := fsckUtil.getOutput()
        if pStr
          serial.str(pStr)
          serial.fstr0(@"\r\n")
        elseif fsckUtil.isDone()
          repeat while (pStr := fsckUtil.getOutput())
            serial.str(pStr)
            serial.fstr0(@"\r\n")
          quit

      fsckUtil.stop()

      ' Offer to re-mount
      serial.fstr0(@"\r\n")
      if (confirmYN(@"Re-mount card"))
        do_mount()

PUB do_fsck() | pStr, proceed
'' Check and repair FAT32 filesystem via the FSCK library (cog-based).
'' Requires unmount for write access to FAT sectors.
''
' @local pStr - Pointer to FIFO output string from FSCK cog
' @local proceed - True if FSCK should proceed (user confirmed unmount)

  if (ntokens <> 1)
    bad_syntax()
  ELSE
    ' FSCK needs raw write access - must unmount first
    proceed := TRUE
    if (mounted)
      if (NOT confirmYN(@"FSCK requires unmount. Unmount now"))
        proceed := FALSE
      ELSE
        sd.unmount()
        mounted := FALSE
        serial.fstr0(@"Unmounted.\r\n")
    ELSE
      sd.stop()

    if (proceed)
      ' Launch FSCK in utility cog
      if (NOT fsckUtil.startFsck(SD_CS, SD_MOSI, SD_MISO, SD_SCK))
        serial.fstr0(@"ERROR: Could not start FSCK cog\r\n")
      ELSE
        ' Pump FIFO output to terminal
        repeat
          pStr := fsckUtil.getOutput()
          if pStr
            serial.str(pStr)
            serial.fstr0(@"\r\n")
          elseif fsckUtil.isDone()
            repeat while (pStr := fsckUtil.getOutput())
              serial.str(pStr)
              serial.fstr0(@"\r\n")
            quit

        fsckUtil.stop()

        ' Offer to re-mount
        serial.fstr0(@"\r\n")
        if (confirmYN(@"Re-mount card"))
          do_mount()

PUB do_bench() | wasMounted, card_ok, tStart, tElapsed, sector, rate, readResult, msPerTick
'' Run read-only throughput benchmark using raw sector reads at multiple batch sizes.
'' Works mounted or unmounted - no files are created or deleted.
''
' @local wasMounted - True if card was already mounted on entry
' @local card_ok - True if card is ready for benchmark reads
' @local tStart - System counter at start of timed section
' @local tElapsed - Elapsed ticks for timed section
' @local sector - Current sector number for reads
' @local rate - Calculated throughput in KB/s
' @local readResult - Return value from readSectorsRaw
' @local msPerTick - Clock ticks per millisecond

  if (ntokens <> 1)
    bad_syntax()
  ELSE
    wasMounted := mounted
    card_ok := TRUE

    ' If not mounted, initialize card for raw access
    if (NOT mounted)
      serial.fstr0(@"Initializing card...\r\n")
      if sd.initCardOnly(SD_CS, SD_MOSI, SD_MISO, SD_SCK) < 0
        serial.fstr0(@"ERROR: Cannot initialize card\r\n")
        card_ok := FALSE

    if (card_ok)
      serial.fstr0(@"\r\n=== Read-Only Throughput Benchmark ===\r\n")
      serial.fstr2(@"Card: %d MB, SPI: %d Hz\r\n", sd.cardSizeSectors() / SECTORS_PER_MB, sd.getSPIFrequency())
      serial.fstr1(@"Test area: sectors %d+\r\n\r\n", BENCH_SECTOR_BASE)

      msPerTick := clkfreq / 1000

      ' --- Single-sector test (100 reads) ---
      serial.fstr0(@"Single-sector (100 reads)... ")
      sector := BENCH_SECTOR_BASE
      tStart := GETCT()
      repeat 100
        sd.readSectorRaw(sector, @buffer)
        sector++
      tElapsed := GETCT() - tStart

      rate := (100 * SECTOR_SIZE * msPerTick) / tElapsed                        ' bytes/ms = KB/s approx
      serial.fstr2(@"%d ms, %d KB/s\r\n", tElapsed / msPerTick, rate)

      ' --- Multi-sector x8 ---
      serial.fstr0(@"Multi-sector x8 (100 reads)... ")
      sector := BENCH_SECTOR_BASE
      tStart := GETCT()
      repeat 100
        readResult := sd.readSectorsRaw(sector, 8, @benchBuf)
        sector += 8
      tElapsed := GETCT() - tStart

      rate := (100 * 8 * SECTOR_SIZE * (msPerTick / 10)) / (tElapsed / 10)
      serial.fstr2(@"%d ms, %d KB/s\r\n", tElapsed / msPerTick, rate)

      ' --- Multi-sector x32 ---
      serial.fstr0(@"Multi-sector x32 (25 reads)... ")
      sector := BENCH_SECTOR_BASE
      tStart := GETCT()
      repeat 25
        readResult := sd.readSectorsRaw(sector, 32, @benchBuf)
        sector += 32
      tElapsed := GETCT() - tStart

      rate := (25 * 32 * SECTOR_SIZE * (msPerTick / 10)) / (tElapsed / 10)
      serial.fstr2(@"%d ms, %d KB/s\r\n", tElapsed / msPerTick, rate)

      ' --- Multi-sector x64 ---
      serial.fstr0(@"Multi-sector x64 (16 reads)... ")
      sector := BENCH_SECTOR_BASE
      tStart := GETCT()
      repeat 16
        readResult := sd.readSectorsRaw(sector, 64, @benchBuf)
        sector += 64
      tElapsed := GETCT() - tStart

      rate := (16 * 64 * SECTOR_SIZE * (msPerTick / 10)) / (tElapsed / 10)
      serial.fstr2(@"%d ms, %d KB/s\r\n", tElapsed / msPerTick, rate)

      serial.fstr0(@"\r\nBenchmark complete.\r\n")

      ' Clean up if we initialized raw access
      if (NOT wasMounted)
        sd.stop()

PUB do_touch() | p_name, p_leaf, has_path, handle
'' Create an empty file. Supports paths like "work/newfile.txt".
''
' @local p_name - Pointer to the full path argument
' @local p_leaf - Pointer to leaf filename within the path
' @local has_path - True if path contained "/" separators
' @local handle - File write handle (created then immediately closed)

  if (ntokens <> 2)
    bad_syntax()
  elseif (check_mount() == FALSE)
  ' error already printed by check_mount()
  ELSE
    p_name := token(1)
    p_leaf, has_path := navigate_to_parent(p_name)
    if p_leaf <> 0
      handle := sd.createFileNew(p_leaf)

      if (handle >= 0)
        sd.closeFileHandle(handle)
        serial.fstr1(@"Created: %s\r\n", p_leaf)
      ELSE
        serial.fstr1(@"Failed to create: %s\r\n", p_leaf)

      if has_path
        nav_back(p_name)

PUB do_label() | p_label
'' Display or set the volume label.
'' Usage: label          - show current volume label
''        label NEWNAME  - set new volume label (max 11 chars)
''
' @local p_label - Pointer to new label string argument (if provided)

  if (ntokens > 2)
    bad_syntax()
  elseif (check_mount() == FALSE)
  ' error already printed by check_mount()
  elseif (ntokens == 1)
    serial.fstr1(@"Volume label: %s\r\n", sd.volumeLabel())
  ELSE
    p_label := token(1)
    if strsize(p_label) > 11
      serial.fstr0(@"Label too long (max 11 characters)\r\n")
    elseif sd.setVolumeLabel(p_label) == sd.SUCCESS
      serial.fstr1(@"Volume label set to: %s\r\n", sd.volumeLabel())
    ELSE
      serial.fstr0(@"Failed to set volume label\r\n")

PUB do_alias()
'' Display all command aliases showing primary and alternate names.

  serial.fstr0(@"\r\n  Command aliases (either name works):\r\n\r\n")
  serial.fstr0(@"  Primary     Alias       Description\r\n")
  serial.fstr0(@"  ----------  ----------  ----------------------\r\n")
  serial.fstr0(@"  dir         ls          List directory\r\n")
  serial.fstr0(@"  type        cat         Show file contents\r\n")
  serial.fstr0(@"  hexdump     hd          Hex dump of file\r\n")
  serial.fstr0(@"  copy        cp          Copy file\r\n")
  serial.fstr0(@"  move        mv          Move / rename\r\n")
  serial.fstr0(@"  del         rm          Delete file\r\n")
  serial.fstr0(@"  unmount     eject       Unmount SD card\r\n")
  serial.fstr0(@"  stats       info        Filesystem stats\r\n")
  serial.fstr0(@"  card        cid         Card information\r\n")
  serial.fstr0(@"  benchmark   bench,perf  Throughput test\r\n")
  serial.fstr0(@"  label       vol         Volume label\r\n")
  serial.fstr0(@"  cls         clear       Clear screen\r\n")

PUB do_date() | yr, mo, dy, hr, mn, sec, result
'' Display or set the driver clock. Usage: date [YYYY MM DD HH MM SS]
''
' @local yr - Year
' @local mo - Month
' @local dy - Day
' @local hr - Hour
' @local mn - Minute
' @local sec - Second
' @local result - setDate return value

  if (ntokens <> 1 AND ntokens <> 7)
    serial.fstr0(@"Usage: date                   Show current date/time\r\n")
    serial.fstr0(@"       date YYYY MM DD HH MM SS   Set date/time\r\n")
  elseif (check_mount() == FALSE)
  ' error already printed by check_mount()
  elseif (ntokens == 7)
    ' Set date/time from 6 arguments
    yr  := decval(token(1))
    mo  := decval(token(2))
    dy  := decval(token(3))
    hr  := decval(token(4))
    mn  := decval(token(5))
    sec := decval(token(6))
    result := sd.setDate(yr, mo, dy, hr, mn, sec)
    if (result < 0)
      serial.fstr1(@"Invalid date/time (error %d)\r\n", result)
    ELSE
      serial.fstr0(@"Date set: ")
      emit_datetime(yr, mo, dy, hr, mn, sec)
      serial.fstr0(@"\r\n")
  ELSE
    ' Display current date/time
    yr, mo, dy, hr, mn, sec := sd.getDate()
    emit_datetime(yr, mo, dy, hr, mn, sec)
    serial.fstr0(@"\r\n")

PUB do_tree() | p_path
'' Display a recursive directory tree. Usage: tree [path]
''
' @local p_path - Pointer to root path for tree (defaults to ".")

  if (ntokens > 2)
    bad_syntax()
  elseif (check_mount() == FALSE)
  ' error already printed by check_mount()
  ELSE
    if (ntokens == 2)
      p_path := token(1)
    ELSE
      p_path := @"."

    serial.fstr0(@"\r\n")
    tree_walk(p_path, 0)
    serial.fstr0(@"\r\n")

PUB not_implemented()
'' Display "not implemented" message for unrecognized or stub commands.

  serial.fstr1(@"%s is not implemented\r\n", token(0))

CON { helper methods }

PRI write_demo_file(p_name, p_content) | handle, len
' Write a string to a new file on the SD card.
'
' @param p_name - Pointer to filename string
' @param p_content - Pointer to content string to write
' @local handle - File write handle
' @local len - Length of content string in bytes

  len := strsize(p_content)
  serial.fstr2(@"  Writing %s (%d bytes)...\r\n", p_name, len)

  sd.deleteFile(p_name)                                 ' Remove if exists (ignore error)
  handle := sd.createFileNew(p_name)
  if (handle < 0)
    serial.fstr1(@"    ERROR: Could not create file (%d)\r\n", handle)
  ELSE
    sd.writeHandle(handle, p_content, len)
    sd.closeFileHandle(handle)

PRI navigate_to_parent(p_path) : p_leaf, has_path | slash_pos, idx
' Split a path at the last "/" and cd to the parent directory.
' Returns leaf name pointer and whether navigation occurred.
' If parent cd fails, prints error and returns p_leaf=0.
' Caller must call nav_back(p_path) when done if has_path is true.
'
' @param p_path - Pointer to full path string (modified: "/" replaced with null)
' @returns p_leaf - Pointer to leaf name portion of path (0 on error)
' @returns has_path - True if navigation to parent directory occurred
' @local slash_pos - Position of last "/" in path (-1 if none)
' @local idx - Scan index through path characters

  p_leaf := 0
  has_path := FALSE

  slash_pos := -1
  idx := 0
  repeat while BYTE[p_path + idx] <> 0
    if BYTE[p_path + idx] == "/"
      slash_pos := idx
    idx++

  if slash_pos < 0
    ' No path separator -- use as-is in CWD
    p_leaf := p_path
  ELSE
    ' Split at last "/"
    p_leaf := p_path + slash_pos + 1
    BYTE[p_path + slash_pos] := 0                       ' null-terminate parent

    if sd.changeDirectory(p_path) < 0
      serial.fstr1(@"Directory not found: %s\r\n", p_path)
      p_leaf := 0
    ELSE
      has_path := TRUE

PRI path_leaf(p_path) : p_leaf | slash_pos, idx
' Return pointer to the leaf portion of a path (after last "/").
' Does NOT modify the string or navigate.
'
' @param p_path - Pointer to path string
' @returns p_leaf - Pointer to leaf name (after last "/" or entire string)
' @local slash_pos - Position of last "/" in path (-1 if none)
' @local idx - Scan index through path characters

  slash_pos := -1
  idx := 0
  repeat while BYTE[p_path + idx] <> 0
    if BYTE[p_path + idx] == "/"
      slash_pos := idx
    idx++

  if slash_pos >= 0
    p_leaf := p_path + slash_pos + 1
  ELSE
    p_leaf := p_path

PRI nav_back(p_parent) | depth, idx
' Navigate back up after a temporary cd into a parent path.
' Counts "/" separators in p_parent to determine how many levels to ascend.
'
' @param p_parent - Pointer to parent path string (used to count "/" depth)
' @local depth - Number of cd("..") calls needed
' @local idx - Scan index through path characters

  depth := 1
  idx := 0
  repeat while BYTE[p_parent + idx] <> 0
    if BYTE[p_parent + idx] == "/"
      depth++
    idx++
  repeat depth
    sd.changeDirectory(@"..")

PRI tree_walk(p_path, depth) | dh, result, p_name, attrib, name_buf[4], reopen_ok
' Recursively display a directory tree.
' Enumerates entries, prints files, and recurses into subdirectories.
' Max depth 8 to protect stack.
'
' @param p_path - Pointer to directory path to enumerate (relative to CWD)
' @param depth - Current indentation level (0 = root of tree)
' @local dh - Directory handle for current level
' @local result - readDirectoryHandle result
' @local p_name - Pointer to current entry name string
' @local attrib - FAT attribute byte for current entry
' @local idx - Loop index (reserved for future use)
' @local name_buf - 16-byte buffer to save directory name across reopen
' @local reopen_ok - True if directory reopen succeeded after recursion

  if depth > 8
    tree_indent(depth)
    serial.fstr0(@"... (max depth)\r\n")
  ELSE
    dh := sd.openDirectory(p_path)
    if dh < 0
      if depth == 0
        serial.fstr1(@"Cannot open: %s\r\n", p_path)
    ELSE
      ' Print the directory name header at depth 0
      if depth == 0
        if strcomp(p_path, @".")
          serial.fstr1(@"%s\r\n", @cwd)
        ELSE
          serial.fstr1(@"%s\r\n", p_path)

      reopen_ok := TRUE
      repeat while reopen_ok
        result := sd.readDirectoryHandle(dh)
        if result == 0
          quit

        p_name := sd.fileName()
        if BYTE[p_name] == 0
          next

        ' Skip . and .. entries
        if strcomp(p_name, @".") OR strcomp(p_name, @"..")
          next

        attrib := sd.attributes()

        if attrib & sd.ATTR_DIRECTORY
          ' Directory entry -- print and recurse
          tree_indent(depth + 1)
          serial.fstr1(@"%s/\r\n", p_name)
          ' Save name for cd (fileName() buffer gets reused)
          bytefill(@name_buf, 0, 16)
          bytemove(@name_buf, p_name, strsize(p_name) <# 15)
          sd.closeDirectoryHandle(dh)
          ' cd into subdirectory and recurse
          if sd.changeDirectory(@name_buf) == sd.SUCCESS
            tree_walk(@".", depth + 1)
            sd.changeDirectory(@"..")
          ' Reopen parent directory and skip past entries already seen
          dh := sd.openDirectory(p_path)
          if dh < 0
            reopen_ok := FALSE
          ELSE
            tree_skip_to(dh, @name_buf)
        ELSE
          ' File entry
          tree_indent(depth + 1)
          serial.fstr1(@"%s\r\n", p_name)

      if reopen_ok
        sd.closeDirectoryHandle(dh)

PRI tree_indent(depth)
' Print tree indentation spaces for the given depth level.
'
' @param depth - Number of indentation levels to print

  repeat depth
    serial.fstr0(@"  ")

PRI tree_skip_to(dh, p_past_name) | result, p_name, found
' Advance a directory handle past the named entry and all entries before it.
' Used after reopening a directory to resume enumeration where we left off.
'
' @param dh - Open directory handle to advance
' @param p_past_name - Pointer to name string to skip past
' @local result - readDirectoryHandle result
' @local p_name - Pointer to current entry name string
' @local found - True when the target entry has been found

  found := FALSE
  repeat while NOT found
    result := sd.readDirectoryHandle(dh)
    if result == 0
      quit
    p_name := sd.fileName()
    if strcomp(p_name, p_past_name)
      found := TRUE

PRI show_card_summary() | total_mb, size_gb
' Display brief card summary after mount (skips free space scan which takes ~14s on 16GB cards).
'
' @local total_mb - Card capacity in megabytes
' @local size_gb - Card capacity in marketed gigabytes

  total_mb := sd.cardSizeSectors() / SECTORS_PER_MB
  size_gb := (total_mb + 953) / 954                     ' decimal GB (marketed card size)

  serial.fstr1(@"  Volume: %s\r\n", sd.volumeLabel())
  serial.fstr2(@"  Size: %d MB (%dGB)\r\n", total_mb, size_gb)
  serial.fstr1(@"  SPI: %d Hz\r\n", sd.getSPIFrequency())

PRI check_mount() : status
' Check if the SD card is mounted and print an error message if not.
'
' @returns status - True if mounted, false otherwise

  status := mounted
  if (status == FALSE)
    serial.fstr0(@"SD card not mounted. Use 'mount' command first.\r\n")

PRI go_up_directory() | idx, len
' Navigate up one directory level by trimming the cwd string and calling cd("..").
'
' @local idx - Scan index for finding last "/" in cwd
' @local len - Current length of cwd string

  len := strsize(@cwd)
  if (len > 1)                                          ' not already at root
    ' Find last slash
    idx := len - 1
    if (cwd[idx] == "/")
      idx--

    repeat while idx > 0
      if (cwd[idx] == "/")
        quit
      idx--

    if (idx == 0)
      bytemove(@cwd, @"/", 2)                           ' back to root
    ELSE
      cwd[idx + 1] := 0                                 ' truncate path

    sd.changeDirectory(@"..")

PRI update_cwd(p_path) | len, cwd_len
' Append a directory name to the current working directory path string.
'
' @param p_path - Pointer to directory name to append
' @local len - Length of the directory name being appended
' @local cwd_len - Current length of the cwd string

  cwd_len := strsize(@cwd)
  len := strsize(p_path)

  if (cwd_len + len + 2 < MAX_PATH)
    ' Add separator if needed
    if (cwd[cwd_len - 1] <> "/")
      cwd[cwd_len++] := "/"

    ' Append new directory
    bytemove(@cwd + cwd_len, p_path, len + 1)

PRI bad_syntax()
' Display a syntax error message directing the user to the help command.

  serial.fstr0(@"Syntax error. Type 'help' for command list.\r\n")

CON { STRUCT accessors (kept for do_card_info / detectFilesystem) }

' ── MBR partition entry accessors ──────────────────────────────────────────────

PRI partType(^sd.mbr_partition_t pEntry) : value
' Get the partition type byte from an MBR partition entry.
'
' @param pEntry - Typed pointer to MBR partition entry struct
' @returns value - Partition type byte ($0C = FAT32 LBA, etc.)

  value := pEntry.partType

PRI partLbaStart(^sd.mbr_partition_t pEntry) : value
' Get the LBA start sector from an MBR partition entry.
'
' @param pEntry - Typed pointer to MBR partition entry struct
' @returns value - LBA sector number where partition begins

  value := pEntry.lbaStart

' ── VBR accessor (used by resolveType07) ─────────────────────────────────────

PRI vbrOemNameByte(^sd.vbr_t pRec, byteIdx) : value
' Get a single byte from the OEM name field in a VBR (Volume Boot Record).
'
' @param pRec - Typed pointer to VBR struct overlay
' @param byteIdx - Byte index within the 8-byte OEM name field
' @returns value - Character byte at the specified index

  value := pRec.oemName[byteIdx]

CON { shared utility methods }

PRI confirmYN(p_prompt) : confirmed | ch
' Prompt user for y/n confirmation with a 10-second timeout.
' Default is NO (pressing Enter or timeout returns false).
'
' @param p_prompt - Pointer to prompt text string
' @returns confirmed - True if user pressed 'y' or 'Y'
' @local ch - Character received from terminal

  confirmed := FALSE
  serial.fstr1(@"%s (y/N)? \r", p_prompt)
  ch := serial.rxtime(10_000)
  serial.tx(serial.CRSR_X)                              ' position cursor past prompt
  serial.tx(strsize(p_prompt) + CONFIRM_SUFFIX_LEN)     ' "<prompt> (y/N)? "
  if (ch == "y" OR ch == "Y")
    serial.fstr0(@"yes\r\n")
    confirmed := TRUE
  ELSE
    serial.fstr0(@"no\r\n")
    confirmed := FALSE

PRI lookupMID(mid) : p_name | pCursor, entryMID
' Look up manufacturer name from MID byte in the midTable.
' Returns pointer to name string, or "MID:$NN" formatted string for unknown IDs.
'
' @param mid - Manufacturer ID byte from CID register
' @returns p_name - Pointer to manufacturer name string
' @local pCursor - Scan pointer through midTable entries
' @local entryMID - MID value from current table entry

  p_name := 0
  pCursor := @midTable
  repeat while p_name == 0
    entryMID := WORD[pCursor]
    if entryMID == $00                                  ' end sentinel
      ' Unknown - format hex into dedicated DAT buffer (not shared buffer!)
      BYTE[@midFmtBuf + 5] := hexDigit(mid >> 4)
      BYTE[@midFmtBuf + 6] := hexDigit(mid & $0F)
      p_name := @midFmtBuf
    elseif entryMID == mid
      p_name := @@WORD[pCursor + 2]                     ' convert DAT relative offset to absolute address
    ELSE
      pCursor += 4                                      ' next entry: word MID + word ptr

PRI hexDigit(nibble) : ch
' Convert a 4-bit value (0-15) to its ASCII hex digit character.
'
' @param nibble - Value 0-15 to convert
' @returns ch - ASCII character '0'-'9' or 'A'-'F'

  ch := "A" + nibble - 10
  if nibble < 10
    ch := "0" + nibble

PRI getCardType(ocr, sizeMB) : p_type
' Determine card type string from OCR CCS bit and card capacity.
' CCS=0: SDSC, CCS=1 and <=32GB: SDHC, CCS=1 and >32GB: SDXC
'
' @param ocr - OCR register value from card
' @param sizeMB - Card capacity in megabytes
' @returns p_type - Pointer to card type string ("SDSC", "SDHC", or "SDXC")

  p_type := @ctSDHC
  if (ocr & (1 << 30)) == 0
    p_type := @ctSDSC
  elseif sizeMB > 32768
    p_type := @ctSDXC

PRI getSDSpecVersion(^sd.scr_t p_scr) : p_version | sdSpec, spec3, spec4, specX
' Decode SD specification version from the SCR register struct fields.
' Returns a pointer to a version string like "SD 3.x".
'
' @param p_scr - Typed pointer to SCR register struct
' @returns p_version - Pointer to SD spec version string
' @local sdSpec - Base SD spec field (bits 0-3)
' @local spec3 - SD spec 3.x indicator bit
' @local spec4 - SD spec 4.x indicator bit
' @local specX - Extended spec version field

  sdSpec := p_scr.sdSpec & $0F
  spec3 := (p_scr.sdSpec3Ext >> 7) & 1
  spec4 := (p_scr.sdSpec3Ext >> 2) & 1
  specX := ((p_scr.sdSpec3Ext & $03) << 2) | ((p_scr.sdSpecXLo >> 6) & $03)

  p_version := @"SD ??"
  if sdSpec < 2
    p_version := @"SD 1.x"
  elseif spec3 == 0
    p_version := @"SD 2.0"
  elseif spec4 == 0
    p_version := @"SD 3.x"
  elseif specX == 0
    p_version := @"SD 4.x"
  elseif specX == 1
    p_version := @"SD 5.x"
  elseif specX == 2
    p_version := @"SD 6.x"
  elseif specX == 3
    p_version := @"SD 7.x"
  elseif specX == 4
    p_version := @"SD 8.x"
  elseif specX == 5
    p_version := @"SD 9.x"

PRI decodeSpeedClass(classByte) : speed
' Decode the SPEED_CLASS byte from SD Status register.
' Maps: $00=Class 0, $01=Class 2, $02=Class 4, $03=Class 6, $04=Class 10
'
' @param classByte - Raw speed class byte from SD Status
' @returns speed - Decoded speed class number (0, 2, 4, 6, or 10)

  speed := 0
  case classByte
    $01 : speed := 2
    $02 : speed := 4
    $03 : speed := 6
    $04 : speed := 10

PRI detectFilesystem() : p_fsName | pType
' Read MBR sector 0 to determine the filesystem type from the partition type byte.
' Uses buf2 for the sector read. Returns pointer to a filesystem name string.
'
' @returns p_fsName - Pointer to filesystem type string ("FAT32", "exFAT", etc.)
' @local pType - Partition type byte from MBR entry

  sd.readSectorRaw(0, @buf2)

  ' Check MBR signature
  if WORD[@buf2 + sd.BOOT_SIG_OFFSET] <> MBR_SIGNATURE
    p_fsName := @fsUnknown
  ELSE
    pPart := @buf2 + sd.MBR_PARTITION_OFFSET            ' overlay partition entry 1
    pType := partType(pPart)

    case pType
      $00 : p_fsName := @fsEmpty
      $01 : p_fsName := @fsFAT12
      $04, $06, $0E : p_fsName := @fsFAT16
      $0B, $0C : p_fsName := @fsFAT32
      $07 : p_fsName := resolveType07()
      $83 : p_fsName := @fsLinux
      $EE : p_fsName := @fsGPT
      other : p_fsName := @fsUnknown

PRI resolveType07() : p_fsName | partStart
' Distinguish exFAT from NTFS for partition type $07 by reading the VBR OEM name.
'
' @returns p_fsName - Pointer to "exFAT" or "NTFS" string
' @local partStart - LBA start sector of the partition

  partStart := partLbaStart(pPart)                      ' pPart set by detectFilesystem
  if partStart == 0
    p_fsName := @fsUnknown
  ELSE
    sd.readSectorRaw(partStart, @buf2)
    pVBR := @buf2                                       ' overlay VBR

    ' Check OEM name for "EXFAT"
    p_fsName := @fsNTFS
    if vbrOemNameByte(pVBR, 0) == "E" AND vbrOemNameByte(pVBR, 1) == "X" AND    ...
      vbrOemNameByte(pVBR, 2) == "F" AND vbrOemNameByte(pVBR, 3) == "A" AND vbrOemNameByte(pVBR, 4) == "T"
      p_fsName := @fsExFAT

PRI lcstr(p_str) : p_lcstr | ch
' Convert a string to lowercase in place and return the original pointer.
'
' @param p_str - Pointer to null-terminated string (modified in place)
' @returns p_lcstr - Same pointer as p_str (for use in expressions)
' @local ch - Current character being examined

  p_lcstr := p_str

  repeat strsize(p_str)
    ch := BYTE[p_str]
    if (ch >= "A") && (ch <= "Z")
      BYTE[p_str] := ch + 32
    ++p_str

PRI emit_zpad(value, width) | divisor, digit, STARTED
' Emit a decimal number with leading zero padding to the specified width.
'
' @param value - Non-negative integer to emit
' @param width - Minimum field width (2 or 4)

  divisor := 1
  repeat width - 1
    divisor *= 10

  repeat width
    digit := value / divisor
    value := value // divisor
    divisor /= 10
    serial.tx(digit + "0")

PRI emit_datetime(yr, mo, dy, hr, mn, sec)
' Emit a formatted date/time string: YYYY-MM-DD HH:MM:SS
'
' @param yr - Year
' @param mo - Month
' @param dy - Day
' @param hr - Hour
' @param mn - Minute
' @param sec - Second

  emit_zpad(yr, 4)
  serial.tx("-")
  emit_zpad(mo, 2)
  serial.tx("-")
  emit_zpad(dy, 2)
  serial.tx(" ")
  emit_zpad(hr, 2)
  serial.tx(":")
  emit_zpad(mn, 2)
  serial.tx(":")
  emit_zpad(sec, 2)

PRI decval(p_str) : value | ch
' Parse a null-terminated decimal string to an integer.
'
' @param p_str - Pointer to null-terminated decimal string
' @returns value - Parsed integer value (0 if no digits found)
' @local ch - Current character

  repeat strsize(p_str)
    ch := BYTE[p_str++]
    if (ch >= "0" AND ch <= "9")
      value := value * 10 + (ch - "0")

CON { inline parser }

PRI parserReset()
' Reset the command input buffer, token pointers, and token count.

  bytefill(@cliBuf, 0, CLI_BUF_SIZE)
  cliIdx := 0
  longfill(@tkPtrs, 0, CLI_MAX_TKNS)
  ntokens := 0

PRI parse() : count | pScan
' Parse the input buffer into tokens separated by spaces and tabs.
'
' @returns count - Number of tokens found
' @local pScan - Scan pointer through cliBuf

  count := 0
  longfill(@tkPtrs, 0, CLI_MAX_TKNS)
  ntokens := 0

  if (cliIdx <> 0)                                      ' something to parse
    pScan := @cliBuf

    repeat while (ntokens < CLI_MAX_TKNS)
      ' skip separators (space, tab)
      repeat while (BYTE[pScan] == " ") OR (BYTE[pScan] == 9)
        pScan++
      if (BYTE[pScan] == 0)                             ' end of string
        quit
      tkPtrs[ntokens++] := pScan                        ' save token start
      ' walk to next separator or end
      repeat while (BYTE[pScan] <> 0)
        if (BYTE[pScan] == " ") OR (BYTE[pScan] == 9)
          BYTE[pScan++] := 0                            ' terminate token
          quit
        pScan++

    count := ntokens

PRI token(idx) : p_str
' Return pointer to the parsed token at the given index.
'
' @param idx - Token index (0-based, must be < CLI_MAX_TKNS)
' @returns p_str - Pointer to token string, or 0 if index out of range

  p_str := 0
  if (idx >= 0) AND (idx < CLI_MAX_TKNS)
    p_str := tkPtrs[idx]

PRI idCommand(pCmdStr) : eCmdId | nIdx, pEntry, pStr
' Look up a command string in the command table and return its enum value.
'
' @param pCmdStr - Pointer to lowercase command string to look up
' @returns eCmdId - Command enum value (CMD_UNKNOWN if not found)
' @local nIdx - Loop index through command table entries
' @local pEntry - Pointer to current command table entry
' @local pStr - Pointer to command string within the entry

  eCmdId := CMD_UNKNOWN

  repeat nIdx from 0 TO cmdCt - 1
    pEntry := @@WORD[@cmdTable][nIdx]                   ' get pointer from table
    pStr := @BYTE[pEntry][1]                            ' skip enum byte, point to string
    if strcomp(pCmdStr, pStr)
      eCmdId := BYTE[pEntry][0]                         ' matched - return embedded enum
      quit

CON { strings / lists }

DAT { help text }

DAT { command table }

' ------------------------------------------------------------
'   Adjust Command Set:
'    (1) add/remove enum in CON { command enums }
'    (2) add/remove entry             "name  BYTE  ENUM, CmdString, 0"
'    (3) add/remove pointer to entry  "WORD  @name"
' ------------------------------------------------------------

' Command entries: each contains [enum_byte, "string", 0]

        cmdHelp         BYTE    CMD_HELP,      "help",      0
        cmdVersion      BYTE    CMD_VERSION,   "version",   0
        cmdCls          BYTE    CMD_CLS,       "cls",       0
        cmdClear        BYTE    CMD_CLEAR,     "clear",     0
        cmdMount        BYTE    CMD_MOUNT,     "mount",     0
        cmdUnmount      BYTE    CMD_UNMOUNT,   "unmount",   0
        cmdEject        BYTE    CMD_EJECT,     "eject",     0
        cmdFormat       BYTE    CMD_FORMAT,    "format",    0
        cmdStats        BYTE    CMD_STATS,     "stats",     0
        cmdInfo         BYTE    CMD_INFO,      "info",      0
        cmdDir          BYTE    CMD_DIR,       "dir",       0
        cmdLs           BYTE    CMD_LS,        "ls",        0
        cmdCd           BYTE    CMD_CD,        "cd",        0
        cmdPwd          BYTE    CMD_PWD,       "pwd",       0
        cmdMkdir        BYTE    CMD_MKDIR,     "mkdir",     0
        cmdType         BYTE    CMD_TYPE,      "type",      0
        cmdCat          BYTE    CMD_CAT,       "cat",       0
        cmdHexdump      BYTE    CMD_HEXDUMP,   "hexdump",   0
        cmdHd           BYTE    CMD_HD,        "hd",        0
        cmdRen          BYTE    CMD_REN,       "ren",       0
        cmdMv           BYTE    CMD_MV,        "mv",        0
        cmdMove         BYTE    CMD_MOVE,      "move",      0
        cmdCopy         BYTE    CMD_COPY,      "copy",      0
        cmdCp           BYTE    CMD_CP,        "cp",        0
        cmdDel          BYTE    CMD_DEL,       "del",       0
        cmdRm           BYTE    CMD_RM,        "rm",        0
        cmdRmdir        BYTE    CMD_RMDIR,     "rmdir",     0
        cmdDemo         BYTE    CMD_DEMO,      "demo",      0
        cmdCard         BYTE    CMD_CARD,      "card",      0
        cmdCid          BYTE    CMD_CID,       "cid",       0
        cmdBenchmark    BYTE    CMD_BENCHMARK, "benchmark", 0
        cmdPerf         BYTE    CMD_PERF,      "perf",      0
        cmdTouch        BYTE    CMD_TOUCH,     "touch",     0
        cmdAudit        BYTE    CMD_AUDIT,     "audit",     0
        cmdFsck         BYTE    CMD_FSCK,      "fsck",      0
        cmdBench        BYTE    CMD_BENCH,     "bench",     0
        cmdLabel        BYTE    CMD_LABEL,     "label",     0
        cmdVol          BYTE    CMD_VOL,       "vol",       0
        cmdAlias        BYTE    CMD_ALIAS,     "alias",     0
        cmdTree         BYTE    CMD_TREE,      "tree",      0
        cmdDate         BYTE    CMD_DATE,      "date",      0

cmdTable      ' first table-entry must follow immediately
                        WORD    @cmdHelp, @cmdVersion, @cmdCls, @cmdClear
                        WORD    @cmdMount, @cmdUnmount, @cmdEject, @cmdFormat
                        WORD    @cmdStats, @cmdInfo, @cmdDir, @cmdLs
                        WORD    @cmdCd, @cmdPwd, @cmdMkdir
                        WORD    @cmdType, @cmdCat, @cmdHexdump, @cmdHd
                        WORD    @cmdRen, @cmdMv, @cmdMove, @cmdCopy, @cmdCp
                        WORD    @cmdDel, @cmdRm, @cmdRmdir
                        WORD    @cmdDemo, @cmdCard, @cmdCid
                        WORD    @cmdBenchmark, @cmdPerf, @cmdTouch
                        WORD    @cmdAudit, @cmdFsck, @cmdBench
                        WORD    @cmdLabel, @cmdVol
                        WORD    @cmdAlias, @cmdTree
                        WORD    @cmdDate
cmdTableEnd   ' last entry must be immediately above this line
' ------------------------------------------------------------
        cmdCt           BYTE    (@cmdTableEnd - @cmdTable) >> 1

DAT { demo FILE content }

        demo_hello      BYTE    "Hello from the P2 SD Card Filesystem!", 13, 10
                        BYTE    "This file was created by the demo command.", 13, 10
                        BYTE    0

        demo_readme     BYTE    "P2 SD Card Driver Demo", 13, 10
                        BYTE    "======================", 13, 10
                        BYTE    13, 10
                        BYTE    "This SD card filesystem driver provides:", 13, 10
                        BYTE    "- FAT32 support for cards up to 32GB", 13, 10
                        BYTE    "- Multiple simultaneous file handles", 13, 10
                        BYTE    "- High-speed SPI transfers with CRC", 13, 10
                        BYTE    "- Smart pin hardware acceleration", 13, 10
                        BYTE    13, 10
                        BYTE    "Type 'help' for available commands.", 13, 10
                        BYTE    0

        demo_numbers    BYTE    "1 One", 13, 10
                        BYTE    "2 Two", 13, 10
                        BYTE    "3 Three", 13, 10
                        BYTE    "4 Four", 13, 10
                        BYTE    "5 Five", 13, 10
                        BYTE    "6 Six", 13, 10
                        BYTE    "7 Seven", 13, 10
                        BYTE    "8 Eight", 13, 10
                        BYTE    "9 Nine", 13, 10
                        BYTE    "10 Ten", 13, 10
                        BYTE    0

DAT { manufacturer lookup table - WORD pairs: MID, pointer TO name }

        ' Manufacturer ID lookup: word MID, word @name
        ' From SD Card Association assigned IDs and observed cards
        ' 4 bytes per entry, word-aligned
  midTable
                        WORD    $02, @midKioxia
                        WORD    $03, @midSanDisk
                        WORD    $09, @midATP
                        WORD    $1B, @midSamsung
                        WORD    $1D, @midADATA
                        WORD    $27, @midPhison
                        WORD    $28, @midLexar
                        WORD    $41, @midKingston
                        WORD    $45, @midTeam
                        WORD    $6F, @midHiksemi
                        WORD    $74, @midGigastone
                        WORD    $82, @midSony
                        WORD    $9C, @midAngelbird
                        WORD    $9F, @midSharedOEM
                        WORD    $AD, @midLongsys
                        WORD    $00, 0                  ' end sentinel

        midKioxia       BYTE    "Kioxia", 0
        midSanDisk      BYTE    "SanDisk", 0
        midATP          BYTE    "ATP", 0
        midSamsung      BYTE    "Samsung", 0
        midADATA        BYTE    "ADATA", 0
        midPhison       BYTE    "Phison", 0
        midLexar        BYTE    "Lexar", 0
        midKingston     BYTE    "Kingston", 0
        midTeam         BYTE    "TEAM", 0
        midHiksemi      BYTE    "Hiksemi", 0
        midGigastone    BYTE    "Gigastone", 0
        midSony         BYTE    "Sony", 0
        midAngelbird    BYTE    "Angelbird", 0
        midSharedOEM    BYTE    "OEM", 0
        midLongsys      BYTE    "Longsys", 0
        midUnknown      BYTE    "MID:$", 0
        midFmtBuf       BYTE    "MID:$XX", 0            ' scratch buffer for unknown MID display

DAT { filesystem TYPE strings }

        fsUnknown       BYTE    "Unknown", 0
        fsFAT32         BYTE    "FAT32", 0
        fsFAT16         BYTE    "FAT16", 0
        fsFAT12         BYTE    "FAT12", 0
        fsExFAT         BYTE    "exFAT", 0
        fsNTFS          BYTE    "NTFS", 0
        fsLinux         BYTE    "Linux", 0
        fsGPT           BYTE    "GPT", 0
        fsEmpty         BYTE    "Empty", 0

DAT { card TYPE strings }

        ctSDSC          BYTE    "SDSC", 0
        ctSDHC          BYTE    "SDHC", 0
        ctSDXC          BYTE    "SDXC", 0

CON { init routines }

PRI wait_for_terminal(clear, delay)
' Wait for the terminal to connect by blocking until a keypress is received.
'
' @param clear - If true, send CLS after keypress
' @param delay - Milliseconds to wait after clearing (minimum 0)

  DEBUG("SD Shell: wait for CR")
  serial.rxflush()
  serial.rx()
  if (clear)
    serial.tx(serial.CLS)
    waitms(delay #> 0)

