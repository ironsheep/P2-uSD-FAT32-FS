  if has_path
    nav_back(p_name)


PUB do_label() | p_label

'' Display or set volume label
'' Usage: label          - show current volume label
''        label NEWNAME  - set new volume label (max 11 chars)

  if (ntokens > 2)
    bad_syntax()
    return

  if (check_mount() == false)
    return

  if (ntokens == 1)
