'' =================================================================================================
''
''   File....... SD_RT_recovery_tests.spin2
''   Purpose.... This object tests recovery scenarios after injected CRC errors
''   Author..... Stephen M Moraco
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... FEB 2026
''   Updated.... 27 FEB 2026
''
'' =================================================================================================
''
'' Tests recovery behavior after various error conditions:
''   - Continue reading after CRC retry
''   - Seek and retry after exhaustive CRC failure
''   - File data preservation after write rejection
''   - Retry write after rejection
''   - Remount recovery after errors
''   - Handle isolation (error on one handle doesn't corrupt others)
''   - Handle reuse after error close
''
'' Depends on: Phase 4 CRC error injection test hooks
''
'' =================================================================================================

CON

     _CLKFREQ        = 350_000_000

     ' SD card pin assignments
     ' Default: P2 Edge module SD slot. Build with -D SD_PINS_EXTERNAL
     ' to use the external SD header (base pin 16).
#ifdef SD_PINS_EXTERNAL
     SD_CS   = 20
     SD_MOSI = 19
     SD_MISO = 18
     SD_SCK  = 21
#else
     SD_CS   = 60
     SD_MOSI = 59
     SD_MISO = 58
     SD_SCK  = 61
#endif
     BUFFER_SIZE = 512

     MAX_READ_CRC_RETRIES = 3  ' Must match driver constant

' Enable all features including debug/test hooks
#ifdef __SPINTOOLS__
#define SD_INCLUDE_ALL
#elseifdef __FLEXSPIN__
#define SD_INCLUDE_ALL
#pragma exportdef SD_INCLUDE_ALL
#else
#pragma exportdef SD_INCLUDE_ALL
#endif

OBJ
    sd    : "micro_sd_fat32_fs"
    utils : "isp_rt_utilities"

DAT

' Test filenames
recFile1        BYTE    "RECOV1.BIN", 0
recFile2        BYTE    "RECOV2.BIN", 0
recFile3        BYTE    "RECOV3.BIN", 0
recWriteFile    BYTE    "RECWR1.TXT", 0

' Buffers
writeBuffer     BYTE    0[BUFFER_SIZE]
readBuffer      BYTE    0[BUFFER_SIZE]
readBuffer_guard BYTE   0[16]
readBuffer2     BYTE    0[BUFFER_SIZE]
readBuffer2_guard BYTE  0[16]

' Short content for write tests
beforeContent   BYTE    "BEFORE", 0
afterContent    BYTE    "AFTER", 0

PUB go() | result, handle, handle0, handle1, handle2, bytesRead, bytesRead2, crcBaseline, dummyCRC
'' Main entry point for recovery scenario regression tests

    debug(" ")
    debug("==============================================")
    debug("  SD Card Driver - Recovery Scenario Tests")
    debug("==============================================")

    ' Mount the card first
    result := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    ifnot utils.requireSetup(result == 0, @"SETUP: mount SD card")
        debug("ERROR: Could not mount SD card!")
        utils.ShowTestEndCounts()
        debug("END_SESSION")
        return

    ' Detect dummy-CRC cards. On these cards (CW_NO_DATA_CRC), the driver
    ' permanently skips read-side CRC validation, so read-side error injection
    ' is a no-op - exhaustive injection cannot force a read failure.
    dummyCRC := (sd.cardWarnings() & sd.CW_NO_DATA_CRC) <> 0
    debug("   Dummy-CRC card: ", udec(dummyCRC))

    ' Show card info
    debug(" ")
    debug("* SD Card Information:")
    debug("   Volume Label: ", zstr_(sd.volumeLabel()))

    ' Clean up any existing test files
    deleteRecoveryFiles()

    ' Create the pattern fixtures. Gated: every recovery test reads one of
    ' these, so a failed seed is one named, scored setup failure -- not a
    ' cascade of opaque read failures.
    ifnot utils.requireSetup(createRecoveryFiles(), @"SETUP: create recovery pattern files")
        deleteRecoveryFiles()
        sd.unmount()
        utils.ShowTestEndCounts()
        debug("END_SESSION")
        return

    ' Ensure test hooks are clean
    sd.clearTestErrors()

    ' ======================================================================
    ' TEST GROUP: Recovery After Read Errors
    ' ======================================================================
    utils.startTestGroup(@"Recovery After Read Errors")

    ' Test 1: Continue reading after CRC retry
    ' Open file -> arm force(1) -> read 512B twice -> both succeed
    utils.startTest(@"Continue reading after CRC retry")
    utils.setCheckCountPerTest(2)
    bytesRead := 0                                                              ' Zeroed: the check below runs on the skip path too
    handle := sd.openFileRead(@recFile1)
    if handle >= 0
        sd.setTestForceReadError(1)
        bytefill(@readBuffer, 0, BUFFER_SIZE)
        utils.initGuard(@readBuffer_guard)
        bytesRead := sd.readHandle(handle, @readBuffer, BUFFER_SIZE)
        utils.checkGuard(@readBuffer_guard, @"readBuffer guard")
        utils.evaluateSubValue(bytesRead, @"first read 512 bytes", BUFFER_SIZE)

        bytefill(@readBuffer, 0, BUFFER_SIZE)
        utils.initGuard(@readBuffer_guard)
        bytesRead := sd.readHandle(handle, @readBuffer, BUFFER_SIZE)
        utils.checkGuard(@readBuffer_guard, @"readBuffer guard")
        utils.evaluateSubValue(bytesRead, @"second read 512 bytes", BUFFER_SIZE)
        sd.closeFileHandle(handle)
    utils.showSubTestResults()

    ' Test 2: Seek and retry after exhaustive error
    ' open file -> arm(3) -> read fails -> clear -> seek(0) -> read succeeds
    utils.startTest(@"Seek and retry after exhaustive CRC error")
    utils.setCheckCountPerTest(4)
    sd.clearTestErrors()
    bytesRead := 0                                                              ' Zeroed: the check below runs on the skip path too
    handle := sd.openFileRead(@recFile1)
    if handle >= 0
        crcBaseline := sd.getCRCMismatchCount()
        sd.setTestForceReadError(MAX_READ_CRC_RETRIES)
        bytefill(@readBuffer, 0, BUFFER_SIZE)
        bytesRead := sd.readHandle(handle, @readBuffer, BUFFER_SIZE)
        if dummyCRC
            ' Read-side validation is permanently skipped on this card class, so
            ' exhaustive injection cannot force failure. Read returns 512 bytes
            ' and mismatch counter stays unchanged.
            utils.evaluateSubValue(bytesRead, @"read returns 512 (validation skipped)", BUFFER_SIZE)
            utils.evaluateSubValue(sd.getCRCMismatchCount(), @"mismatch count unchanged (validation skipped)", crcBaseline)
        else
            utils.evaluateSubValue(bytesRead, @"read fails with E_IO_ERROR, never a zero", sd.E_IO_ERROR)
            utils.evaluateSubBool(sd.getCRCMismatchCount() > crcBaseline, @"CRC mismatches counted", true)

        ' Clear errors and seek back to start
        sd.clearTestErrors()
        sd.seekHandle(handle, 0)

        bytefill(@readBuffer, 0, BUFFER_SIZE)
        utils.initGuard(@readBuffer_guard)
        bytesRead := sd.readHandle(handle, @readBuffer, BUFFER_SIZE)
        utils.checkGuard(@readBuffer_guard, @"readBuffer guard")
        utils.evaluateSubValue(bytesRead, @"retry read 512 bytes", BUFFER_SIZE)

        result := utils.verifyBufferPattern(@readBuffer, BUFFER_SIZE, $31)
        utils.evaluateSubBool(result, @"data matches pattern", true)
        sd.closeFileHandle(handle)
    utils.showSubTestResults()

    ' ======================================================================
    ' TEST GROUP: Recovery After Write Errors
    ' ======================================================================
    utils.startTestGroup(@"Recovery After Write Errors")

    ' Test 3: File data preserved after write rejection
    ' Write "BEFORE", close, reopen write, arm error, attempt write -> close
    ' Reopen read -> "BEFORE" still present
    utils.startTest(@"File data preserved after write rejection")
    sd.clearTestErrors()
    sd.deleteFile(@recWriteFile)
    handle := sd.createFileNew(@recWriteFile)
    if handle >= 0
        sd.writeHandle(handle, @beforeContent, strsize(@beforeContent))
        sd.closeFileHandle(handle)

    ' Reopen for write, arm error, attempt write
    handle := sd.openFileWrite(@recWriteFile)
    if handle >= 0
        sd.setTestForceWriteError(1)
        sd.writeHandle(handle, @afterContent, strsize(@afterContent))
        sd.closeFileHandle(handle)

    ' Read back and verify the ORIGINAL content survived.
    ' This checked only the LENGTH ("at least 6 bytes"), which a corrupted file
    ' satisfies just as well as an intact one -- the rejected write could have
    ' scribbled "AFTER\0" or arbitrary bytes over it and this still passed. Since
    ' the property under test is precisely that the data was NOT damaged, the
    ' content itself has to be compared.
    utils.setCheckCountPerTest(2)
    sd.clearTestErrors()
    bytesRead := 0
    handle := sd.openFileRead(@recWriteFile)
    if handle >= 0
        bytefill(@readBuffer, 0, BUFFER_SIZE)
        bytesRead := sd.readHandle(handle, @readBuffer, 64)
        sd.closeFileHandle(handle)
    debug("  Read back: ", udec_(bytesRead), " bytes, content=[", lstr_(@readBuffer, bytesRead <# 20), "]")
    utils.evaluateSubValue(bytesRead, @"read back the original length", strsize(@beforeContent))
    utils.evaluateSubBool(strcomp(@readBuffer, @beforeContent), @"content is still BEFORE (not corrupted)", true)
    utils.showSubTestResults()

    ' Test 4: Retry write after rejection succeeds
    utils.startTest(@"Retry write after rejection succeeds")
    sd.clearTestErrors()
    sd.deleteFile(@recWriteFile)
    handle := sd.createFileNew(@recWriteFile)
    if handle >= 0
        sd.writeHandle(handle, @afterContent, strsize(@afterContent))
        sd.closeFileHandle(handle)

    ' Verify "AFTER" was written -- content, not just byte count. A 5-byte file of
    ' the wrong bytes used to pass this.
    utils.setCheckCountPerTest(2)
    bytesRead := 0
    handle := sd.openFileRead(@recWriteFile)
    if handle >= 0
        bytefill(@readBuffer, 0, BUFFER_SIZE)
        bytesRead := sd.readHandle(handle, @readBuffer, 64)
        sd.closeFileHandle(handle)
    debug("  Read back: ", udec_(bytesRead), " bytes, content=[", lstr_(@readBuffer, bytesRead <# 20), "]")
    utils.evaluateSubValue(bytesRead, @"retried write produced the right length", strsize(@afterContent))
    utils.evaluateSubBool(strcomp(@readBuffer, @afterContent), @"content is AFTER", true)
    utils.showSubTestResults()

    ' ======================================================================
    ' TEST GROUP: Remount Recovery
    ' ======================================================================
    utils.startTestGroup(@"Remount Recovery")

    ' Test 5: Remount after errors restores operation
    utils.startTest(@"Remount after errors restores operation")
    utils.setCheckCountPerTest(3)
    ' Force some errors then unmount/remount
    sd.setTestForceReadError(1)
    sd.unmount()
    result := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    utils.evaluateSubValue(result, @"remount succeeds", sd.SUCCESS)

    ' Create a new file
    sd.clearTestErrors()
    sd.deleteFile(@"REMOUNT.TXT")
    handle := sd.createFileNew(@"REMOUNT.TXT")
    if handle >= 0
        sd.writeHandle(handle, @"Remount test", 12)
        sd.closeFileHandle(handle)
    utils.evaluateSubBool(handle >= 0, @"create file after remount", true)

    ' Read existing file
    bytesRead := 0                                                              ' Zeroed: the check below runs on the skip path too
    handle := sd.openFileRead(@recFile2)
    if handle >= 0
        bytefill(@readBuffer, 0, BUFFER_SIZE)
        utils.initGuard(@readBuffer_guard)
        bytesRead := sd.readHandle(handle, @readBuffer, BUFFER_SIZE)
        utils.checkGuard(@readBuffer_guard, @"readBuffer guard")
        sd.closeFileHandle(handle)
    result := utils.verifyBufferPattern(@readBuffer, BUFFER_SIZE, $42)
    utils.evaluateSubBool(result, @"existing file data OK", true)
    utils.showSubTestResults()

    sd.deleteFile(@"REMOUNT.TXT")

    ' ======================================================================
    ' TEST GROUP: Handle Isolation
    ' ======================================================================
    utils.startTestGroup(@"Handle Isolation")

    ' Test 6: Error on one handle does not corrupt others
    utils.startTest(@"Error on one handle does not corrupt others")
    utils.setCheckCountPerTest(3)
    sd.clearTestErrors()

    ' Open three files
    handle0 := sd.openFileRead(@recFile1)
    handle1 := sd.openFileRead(@recFile2)
    handle2 := sd.openFileRead(@recFile3)

    ' Read handle0 successfully
    bytefill(@readBuffer, 0, BUFFER_SIZE)
    utils.initGuard(@readBuffer_guard)
    bytesRead := sd.readHandle(handle0, @readBuffer, BUFFER_SIZE)
    utils.checkGuard(@readBuffer_guard, @"readBuffer guard")
    result := utils.verifyBufferPattern(@readBuffer, BUFFER_SIZE, $31)
    utils.evaluateSubBool(result, @"handle0 read correct", true)

    ' Force error on handle1
    sd.setTestForceReadError(MAX_READ_CRC_RETRIES)
    bytesRead := sd.readHandle(handle1, @readBuffer, BUFFER_SIZE)
    debug("  handle1 read after force error: ", sdec_(bytesRead))

    ' Clear errors, verify handle0 and handle2 still work
    sd.clearTestErrors()
    ' handle0 is at position 512 (already read first sector), read second sector
    bytefill(@readBuffer, 0, BUFFER_SIZE)
    utils.initGuard(@readBuffer_guard)
    bytesRead := sd.readHandle(handle0, @readBuffer, BUFFER_SIZE)
    utils.checkGuard(@readBuffer_guard, @"readBuffer guard")
    utils.evaluateSubValue(bytesRead, @"handle0 2nd read OK", BUFFER_SIZE)

    bytefill(@readBuffer2, 0, BUFFER_SIZE)
    utils.initGuard(@readBuffer2_guard)
    bytesRead2 := sd.readHandle(handle2, @readBuffer2, BUFFER_SIZE)
    utils.checkGuard(@readBuffer2_guard, @"readBuffer2 guard")
    result := utils.verifyBufferPattern(@readBuffer2, BUFFER_SIZE, $53)
    utils.evaluateSubBool(result, @"handle2 read correct", true)

    sd.closeFileHandle(handle0)
    sd.closeFileHandle(handle1)
    sd.closeFileHandle(handle2)
    utils.showSubTestResults()

    ' Test 7: Handle reuse after error close
    utils.startTest(@"Handle reuse after error close")
    sd.clearTestErrors()
    ' handle1 was closed above, open a new file in freed slot
    bytesRead := 0                                                              ' Zeroed: the check below runs on the skip path too
    handle := sd.openFileRead(@recFile2)
    if handle >= 0
        bytefill(@readBuffer, 0, BUFFER_SIZE)
        utils.initGuard(@readBuffer_guard)
        bytesRead := sd.readHandle(handle, @readBuffer, BUFFER_SIZE)
        utils.checkGuard(@readBuffer_guard, @"readBuffer guard")
        sd.closeFileHandle(handle)
    result := utils.verifyBufferPattern(@readBuffer, BUFFER_SIZE, $42)
    utils.evaluateBool(result, @"reused handle reads OK", true)

    ' ======================================================================
    ' Cleanup and Summary
    ' ======================================================================
    sd.clearTestErrors()
    deleteRecoveryFiles()

    sd.unmount()

    utils.ShowTestEndCounts()

    debug(" ")
    debug("END_SESSION")

PRI deleteRecoveryFiles()
' Delete every fixture name this suite can leave behind -- the one roster,
' used by the pre-clean, the setup-failure bail, and the teardown alike.

    sd.deleteFile(@recFile1)
    sd.deleteFile(@recFile2)
    sd.deleteFile(@recFile3)
    sd.deleteFile(@recWriteFile)

PRI createRecoveryFiles() : bOk
' Create the three pattern fixtures the recovery tests read.
' recFile1: pattern $31, 2 sectors; recFile2: $42, 1 sector; recFile3: $53, 1 sector.
'
' @returns bOk - TRUE only when every file was created and fully written

    bOk := seedPatternFile(@recFile1, $31, 2)
    bOk := seedPatternFile(@recFile2, $42, 1) and bOk
    bOk := seedPatternFile(@recFile3, $53, 1) and bOk

PRI seedPatternFile(pFile, pattern, sectorCount) : bOk | handle, idx
' Create one fixture of sectorCount sectors filled with pattern
'
' @param pFile - Pointer to filename string
' @param pattern - Byte pattern for fillBufferWithPattern
' @param sectorCount - Number of BUFFER_SIZE sectors to write
' @returns bOk - TRUE only when created, every sector fully written, and closed

    bOk := false
    utils.fillBufferWithPattern(@writeBuffer, BUFFER_SIZE, pattern)
    handle := sd.createFileNew(pFile)
    if handle >= 0
        bOk := true
        repeat idx from 1 to sectorCount
            if sd.writeHandle(handle, @writeBuffer, BUFFER_SIZE) <> BUFFER_SIZE
                bOk := false
        if sd.closeFileHandle(handle) < 0
            bOk := false
    ifnot bOk
        debug("  FAILED to seed ", zstr_(pFile))

con { license }

