'' =================================================================================================
''
''   File....... SD_RT_directory_tests.spin2
''   Purpose.... This object exercises directory operations (create, change, list)
''   Author..... Stephen M Moraco
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... JAN 2026
''   Updated.... 12 AUG 2026
''
'' =================================================================================================

CON

     _CLKFREQ        = 350_000_000

     ' SD card pin assignments
     ' Default: P2 Edge module SD slot. Build with -D SD_PINS_EXTERNAL
     ' to use the external SD header (base pin 16).
#ifdef SD_PINS_EXTERNAL
     SD_CS   = 20
     SD_MOSI = 19
     SD_MISO = 18
     SD_SCK  = 21
#else
     SD_CS   = 60
     SD_MOSI = 59
     SD_MISO = 58
     SD_SCK  = 61
#endif

     ' Peak on-card footprint: the stale-cluster group writes a 32 KB polluter
     ' file (64 x 512) to occupy and then free a cluster, on top of the 20-file
     ' and 5-level-deep directory groups.
     STALE_POLLUTER_BYTES = 64 * 512
     PEAK_BYTES           = STALE_POLLUTER_BYTES + 32 * 1024

' Uncomment SD_INCLUDE_STACK_CHECK to measure worker cog stack depth
' RAW + TEST_HOOKS + DEBUG power the cluster-0 fixture: raw entry patch via
' readSectorRaw/writeSectorRaw (RAW), setTestInvalidateCaches() so the patched
' entry is re-read from the card (TEST_HOOKS), debugGetRootSec() to address
' the scan (DEBUG)
#ifdef __SPINTOOLS__
#define SD_INCLUDE_RAW
#define SD_INCLUDE_TEST_HOOKS
#define SD_INCLUDE_DEBUG
#elseifdef __FLEXSPIN__
#define SD_INCLUDE_RAW
#define SD_INCLUDE_TEST_HOOKS
#define SD_INCLUDE_DEBUG
#pragma exportdef SD_INCLUDE_RAW
#pragma exportdef SD_INCLUDE_TEST_HOOKS
#pragma exportdef SD_INCLUDE_DEBUG
#else
#pragma exportdef SD_INCLUDE_RAW
#pragma exportdef SD_INCLUDE_TEST_HOOKS
#pragma exportdef SD_INCLUDE_DEBUG
#define SD_INCLUDE_STACK_CHECK
#pragma exportdef SD_INCLUDE_STACK_CHECK
#endif

OBJ
    sd    : "micro_sd_fat32_fs"
    utils : "isp_rt_utilities"

DAT

' Test directory and file names
testDir1        BYTE    "RTDIR1", 0
testDir2        BYTE    "RTDIR2", 0
subDir1         BYTE    "SUBDIR1", 0
testFile1       BYTE    "FILE1.TXT", 0
testFile2       BYTE    "FILE2.TXT", 0
testContent     BYTE    "Test file content", 0

' Deep nesting directory names
deepDir1        BYTE    "DEEP1", 0
deepDir2        BYTE    "DEEP2", 0
deepDir3        BYTE    "DEEP3", 0
deepDir4        BYTE    "DEEP4", 0
deepDir5        BYTE    "DEEP5", 0

' Max filename (8.3 format)
maxNameFile     BYTE    "12345678.123", 0

' Many files test directory
manyFilesDir    BYTE    "RTMANY", 0

' Buffer for generated filenames
genFileName     BYTE    0[16]

' Buffer for read-back verification
readBuf         BYTE    0[32]
readBuf_guard   BYTE    0[16]

' Stale cluster test names and buffers
staleDir        BYTE    "STALE", 0
stalePolluter   BYTE    "STPOLL.TXT", 0
staleBuf        BYTE    0[512]
staleBuf_guard  BYTE    0[16]
staleGenName    BYTE    0[16]

' Cluster-zero fixture (S2 witness): names, the on-disk SFN form for the raw
' scan, and the raw-patch bookkeeping the restore helper needs. staleBuf above
' doubles as the raw-sector scratch (the stale group refills it itself).
czFile          BYTE    "CZERO.TXT", 0
czPath          BYTE    "/CZERO.TXT", 0
czWitness       BYTE    "CZWIT.TXT", 0
sfnCzero        BYTE    "CZERO   TXT"
czSec           LONG    -1
czOfs           LONG    0
czOrigHi        WORD    0
czOrigLo        WORD    0

PUB go() | result, pEntry, pFilename, attrs, fileCount, idx, handle, bytesRead, secPerClus, cBytes, freeSec, freeClus, needClus, bCwdOk
'' Main entry point for directory regression tests
''
'' Tests directory creation, navigation, listing, and nested directories

    debug(" ")
    debug("==============================================")
    debug("  SD Card Driver - Directory Tests")
    debug("==============================================")

    ' Mount the card first
    result := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    ifnot utils.requireSetup(result == 0, @"SETUP: mount SD card")
        debug("ERROR: Could not mount SD card!")
        utils.ShowTestEndCounts()
        debug("END_SESSION")
        return

    ' Show card info
    debug(" ")
    debug("* SD Card Information:")
    debug("   Volume Label: ", zstr_(sd.volumeLabel()))
    debug("   Free Space: ", udec(sd.freeSpace()), " sectors")

    ' Clean up any existing test directories/files
    cleanupTestItems()

    ' ------------------------------------------------------------------
    ' Precondition gate -- geometry + free space.  Local-first idiom: resolve
    ' each driver query into its own local BEFORE combining, so two worker-routed
    ' calls are never chained in one Spin2 expression.
    ' ------------------------------------------------------------------
    secPerClus := sd.sectorsPerCluster()
    cBytes     := sd.clusterBytes()
    freeSec    := sd.freeSpace()
    freeClus   := 0
    if secPerClus > 0
        freeClus := freeSec / secPerClus
    needClus := utils.clustersForBytes(PEAK_BYTES, cBytes) + 8                  ' + margin for the directory clusters themselves

    debug("* Geometry: ", udec(secPerClus), " sec/clus, ", udec(cBytes), " bytes/clus, ", udec(freeClus), " free clusters")

    ' Scored gate: the bare-counts form printed a 0-test summary that the runner
    ' read as green. requireSetup records one named failing test so a declined run
    ' is unmistakably RED.
    ifnot utils.requireSetup(cBytes <> 0 and utils.assertFreeSpace(freeClus, needClus), @"SETUP: free clusters for directory fixtures")
        debug("  *** SETUP NOT MET: need ", udec_(needClus), " free clusters, have ", udec_(freeClus), " (cBytes=", udec_(cBytes), ") -- directory tests NOT run ***")
        sd.unmount()
        utils.ShowTestEndCounts()
        debug("END_SESSION")
        return

    ' ----------------------------------
    ' TEST GROUP: Directory creation
    ' ----------------------------------
    utils.startTestGroup(@"Directory Creation")

    utils.startTest(@"newDirectory() creates a directory")
    result := sd.newDirectory(@testDir1)
    utils.evaluateSingleValue(result, @"newDirectory()", sd.SUCCESS)

    utils.startTest(@"newDirectory() fails if directory exists")
    result := sd.newDirectory(@testDir1)
    utils.evaluateSingleValue(result, @"newDirectory() existing", sd.E_FILE_EXISTS)

    utils.startTest(@"Create second directory")
    result := sd.newDirectory(@testDir2)
    utils.evaluateSingleValue(result, @"newDirectory() second", sd.SUCCESS)

    ' ----------------------------------
    ' TEST GROUP: Change directory
    ' ----------------------------------
    utils.startTestGroup(@"Change Directory")

    utils.startTest(@"changeDirectory() to new directory")
    result := sd.changeDirectory(@testDir1)
    bCwdOk := (result == sd.SUCCESS)
    utils.evaluateSingleValue(result, @"changeDirectory()", sd.SUCCESS)

    ' Gated on the cd above. Un-gated, a failed cd created FILE1.TXT in ROOT while
    ' the test name claimed the subdirectory -- and the debris outlived the run,
    ' because the teardown only ever looked inside RTDIR1.
    utils.startTest(@"Create file in subdirectory")
    if bCwdOk
        handle := sd.createFileNew(@testFile1)
        utils.evaluateBool(handle >= 0, @"createFileNew() in subdir", true)
        if handle >= 0
            sd.writeHandle(handle, @testContent, strsize(@testContent))
            sd.closeFileHandle(handle)
    else
        debug("  CWD is not the test subdirectory -- refusing to create in the wrong place")
        utils.evaluateBool(false, @"createFileNew() in subdir", true)

    utils.startTest(@"changeDirectory() back to parent with ..")
    result := sd.changeDirectory(@"..")
    utils.evaluateSingleValue(result, @"changeDirectory(..) ", sd.SUCCESS)

    utils.startTest(@"changeDirectory() to root with /")
    result := sd.changeDirectory(@"/")
    utils.evaluateSingleValue(result, @"changeDirectory(/)", sd.SUCCESS)

    utils.startTest(@"changeDirectory() fails for non-existent")
    result := sd.changeDirectory(@"NOEXIST")
    utils.evaluateSingleValue(result, @"changeDirectory() non-existent", sd.E_FILE_NOT_FOUND)

    ' A missing name now reports E_FILE_NOT_FOUND, so E_NOT_A_DIR below can only
    ' mean "exists but is not a directory". The existence proof stays anyway: it
    ' pins the failure to THIS file rather than to a create that landed elsewhere.
    utils.startTest(@"changeDirectory() fails on a file (not a directory)")
    utils.setCheckCountPerTest(2)
    sd.changeDirectory(@testDir1)                                               ' Go to RTDIR1 where FILE1.TXT exists
    handle := sd.openFileRead(@testFile1)
    utils.evaluateSubBool(handle >= 0, @"the file under test exists", true)
    if handle >= 0
        sd.closeFileHandle(handle)
    result := sd.changeDirectory(@testFile1)                                    ' Should fail - FILE1.TXT is not a directory
    utils.evaluateSubValue(result, @"changeDirectory() on file", sd.E_NOT_A_DIR)
    utils.showSubTestResults()
    sd.changeDirectory(@"/")                                                    ' Return to root

    ' ----------------------------------
    ' TEST GROUP: Cluster-zero file rejection (S2 witness)
    ' ----------------------------------
    ' A PC writes an empty file's entry with first cluster 0 -- the same value
    ' a root-pointing '..' carries. searchDirectory redirects a cluster-0 match
    ' to the root sector, and do_chdir's old root-sector OR-arm then accepted
    ' it: changeDirectory() onto such a file returned SUCCESS and silently set
    ' the caller's CWD to root. The file-chdir test above uses a real-cluster
    ' file and could never catch that. The fixture fabricates the cluster-0
    ' shape raw, and the probe runs from inside RTDIR1 so a silently-changed
    ' CWD is provable by where a witness file lands.
    utils.startTestGroup(@"Cluster-Zero File Rejection")

    utils.startTest(@"Fabricate cluster-0 empty file (raw patch)")
    bCwdOk := makeClusterZeroFile(@czFile)
    utils.evaluateBool(bCwdOk, @"fixture fabricated", true)

    ' Gated on the fixture: an ungated probe against a missing/unpatched file
    ' gets E_NOT_A_DIR for ABSENCE -- a pass for the wrong reason, the same
    ' trap the file-chdir test above defends against
    utils.startTest(@"changeDirectory() onto cluster-0 file is refused")
    utils.setCheckCountPerTest(4)
    if bCwdOk
        sd.changeDirectory(@testDir1)                                           ' probe from a non-root CWD
        result := sd.changeDirectory(@czPath)
        utils.evaluateSubValue(result, @"chdir returns E_NOT_A_DIR", sd.E_NOT_A_DIR)
        ' CWD provably unchanged: a file created NOW must land in RTDIR1
        handle := sd.createFileNew(@czWitness)
        utils.evaluateSubBool(handle >= 0, @"witness file created in CWD", true)
        if handle >= 0
            sd.closeFileHandle(handle)
        sd.changeDirectory(@"/")
        handle := sd.openFileRead(@"RTDIR1/CZWIT.TXT")
        utils.evaluateSubBool(handle >= 0, @"witness found under RTDIR1", true)
        if handle >= 0
            sd.closeFileHandle(handle)
        sd.changeDirectory(@testDir1)
        utils.evaluateSubValue(sd.deleteFile(@czWitness), @"witness cleanup", sd.SUCCESS)
        sd.changeDirectory(@"/")
        sd.deleteFile(@czWitness)                                               ' regression-branch residue: witness landed in root
    else
        debug("  Fixture missing -- refusing to probe absence and score it as rejection")
        utils.evaluateSubBool(false, @"chdir returns E_NOT_A_DIR", true)
        utils.evaluateSubBool(false, @"witness file created in CWD", true)
        utils.evaluateSubBool(false, @"witness found under RTDIR1", true)
        utils.evaluateSubBool(false, @"witness cleanup", true)
    utils.showSubTestResults()

    utils.startTest(@"Cluster-0 fixture teardown (restore + delete)")
    utils.evaluateBool(restoreClusterZeroFile(@czFile), @"fixture removed", true)

    ' ----------------------------------
    ' TEST GROUP: Nested directories
    ' ----------------------------------
    utils.startTestGroup(@"Nested Directories")

    utils.startTest(@"Change to first directory")
    result := sd.changeDirectory(@testDir1)
    bCwdOk := (result == sd.SUCCESS)
    utils.evaluateSingleValue(result, @"changeDirectory()", sd.SUCCESS)

    ' Gated: an un-gated nested mkdir after a failed cd creates SUBDIR1 in ROOT.
    utils.startTest(@"Create subdirectory")
    if bCwdOk
        result := sd.newDirectory(@subDir1)
        utils.evaluateSingleValue(result, @"newDirectory() nested", sd.SUCCESS)
    else
        debug("  CWD is not the first directory -- refusing to nest in the wrong place")
        utils.evaluateBool(false, @"newDirectory() nested", true)

    utils.startTest(@"Change to nested subdirectory")
    result := sd.changeDirectory(@subDir1)
    bCwdOk := (result == sd.SUCCESS)
    utils.evaluateSingleValue(result, @"changeDirectory() nested", sd.SUCCESS)

    ' Gated for the same reason: FILE2.TXT belongs in SUBDIR1, nowhere else.
    utils.startTest(@"Create file in nested directory")
    if bCwdOk
        handle := sd.createFileNew(@testFile2)
        utils.evaluateBool(handle >= 0, @"createFileNew() nested", true)
        if handle >= 0
            sd.writeHandle(handle, @"Nested file content", 19)
            sd.closeFileHandle(handle)
    else
        debug("  CWD is not the nested subdirectory -- refusing to create in the wrong place")
        utils.evaluateBool(false, @"createFileNew() nested", true)

    utils.startTest(@"Navigate back to root")
    sd.changeDirectory(@"/")
    result := sd.changeDirectory(@"/")  ' Should succeed
    utils.evaluateSingleValue(result, @"changeDirectory(/)", sd.SUCCESS)

    ' ----------------------------------
    ' TEST GROUP: Path navigation
    ' ----------------------------------
    utils.startTestGroup(@"Path Navigation")

    utils.startTest(@"Open file with path: /RTDIR1/FILE1.TXT")
    handle := sd.openFileRead(@"/RTDIR1/FILE1.TXT")
    utils.evaluateBool(handle >= 0, @"openFileRead() with path", true)
    sd.closeFileHandle(handle)

    utils.startTest(@"Open nested file: /RTDIR1/SUBDIR1/FILE2.TXT")
    handle := sd.openFileRead(@"/RTDIR1/SUBDIR1/FILE2.TXT")
    utils.evaluateBool(handle >= 0, @"openFileRead() nested path", true)
    sd.closeFileHandle(handle)

    utils.startTest(@"Ensure back at root after path operations")
    result := sd.changeDirectory(@"/")
    utils.evaluateSingleValue(result, @"changeDirectory(/)", sd.SUCCESS)

    ' ----------------------------------
    ' TEST GROUP: Directory listing
    ' ----------------------------------
    utils.startTestGroup(@"Directory Listing")

    utils.startTest(@"readDirectory() enumerates entries")
    fileCount := 0
    idx := 0
    repeat
        pEntry := sd.readDirectory(idx)
        if pEntry == 0
            quit
        pFilename := sd.fileName()
        attrs := sd.attributes()
        debug("  Entry ", udec_(idx), ": [", zstr_(pFilename), "] attr=$", uhex_(attrs))
        fileCount++
        idx++
    utils.evaluateRange(fileCount, @"directory entries found", 2, 100)  ' At least our 2 test dirs

    ' The cd was unasserted: a failure listed ROOT and the >= 2 range passed on
    ' root's own entries, so "subdir entries" was measuring the wrong directory.
    utils.startTest(@"List subdirectory contents")
    utils.setCheckCountPerTest(2)
    result := sd.changeDirectory(@testDir1)
    utils.evaluateSubValue(result, @"cd to the subdirectory being listed", sd.SUCCESS)
    fileCount := 0
    idx := 0
    repeat
        pEntry := sd.readDirectory(idx)
        if pEntry == 0
            quit
        pFilename := sd.fileName()
        attrs := sd.attributes()
        debug("  Entry ", udec_(idx), ": [", zstr_(pFilename), "] attr=$", uhex_(attrs))
        fileCount++
        idx++
    ' Should have FILE1.TXT and SUBDIR1
    utils.evaluateSubBool(fileCount >= 2 and fileCount <= 10, @"subdir entries", true)
    utils.showSubTestResults()
    sd.changeDirectory(@"/")

    ' ----------------------------------
    ' TEST GROUP: Move file between directories
    ' ----------------------------------
    utils.startTestGroup(@"Move File")

    ' Create a file in root to move
    utils.startTest(@"Create file in root to move")
    handle := sd.createFileNew(@"MOVEME.TXT")
    utils.evaluateBool(handle >= 0, @"createFileNew()", true)
    if handle >= 0
        sd.writeHandle(handle, @"File to be moved", 16)
        sd.closeFileHandle(handle)

    utils.startTest(@"moveFile() to subdirectory")
    result := sd.moveFile(@"MOVEME.TXT", @testDir2)
    utils.evaluateSingleValue(result, @"moveFile()", sd.SUCCESS)

    utils.startTest(@"File no longer in root")
    handle := sd.openFileRead(@"MOVEME.TXT")
    utils.evaluateBool(handle >= 0, @"openFileRead() old location", false)
    if handle >= 0                                                              ' Must fail; if the move left it behind, do not leak the slot
        sd.closeFileHandle(handle)

    ' The cd was unasserted, so a failed cd looked in ROOT for MOVEME.TXT -- which
    ' is where it started. The test could report "moved" without a move happening.
    utils.startTest(@"File exists in new location")
    utils.setCheckCountPerTest(2)
    result := sd.changeDirectory(@testDir2)
    utils.evaluateSubValue(result, @"cd to the move destination", sd.SUCCESS)
    handle := sd.openFileRead(@"MOVEME.TXT")
    utils.evaluateSubBool(handle >= 0, @"openFileRead() new location", true)
    if handle >= 0
        sd.closeFileHandle(handle)
    utils.showSubTestResults()
    sd.changeDirectory(@"/")

    ' ----------------------------------
    ' TEST GROUP: Directory Boundary Conditions
    ' ----------------------------------
    utils.startTestGroup(@"Directory Boundary Conditions")

    ' Test: Deep nesting (5 levels)
    utils.startTest(@"Deep nesting - create 5-level directory structure")
    sd.changeDirectory(@"/")
    result := sd.newDirectory(@deepDir1)
    utils.evaluateSubValue(result, @"create DEEP1", sd.SUCCESS)
    sd.changeDirectory(@deepDir1)
    result := sd.newDirectory(@deepDir2)
    utils.evaluateSubValue(result, @"create DEEP2", sd.SUCCESS)
    sd.changeDirectory(@deepDir2)
    result := sd.newDirectory(@deepDir3)
    utils.evaluateSubValue(result, @"create DEEP3", sd.SUCCESS)
    sd.changeDirectory(@deepDir3)
    result := sd.newDirectory(@deepDir4)
    utils.evaluateSubValue(result, @"create DEEP4", sd.SUCCESS)
    sd.changeDirectory(@deepDir4)
    result := sd.newDirectory(@deepDir5)
    utils.evaluateSubValue(result, @"create DEEP5", sd.SUCCESS)

    utils.startTest(@"Navigate to deepest level and create file")
    sd.changeDirectory(@deepDir5)
    handle := sd.createFileNew(@"DEEP.TXT")
    utils.evaluateSubBool(handle >= 0, @"create file at depth 5", true)
    sd.writeHandle(handle, @"Deep file", 9)
    sd.closeFileHandle(handle)

    utils.startTest(@"Navigate back to root using ..")
    sd.changeDirectory(@"..")  ' DEEP4
    sd.changeDirectory(@"..")  ' DEEP3
    sd.changeDirectory(@"..")  ' DEEP2
    sd.changeDirectory(@"..")  ' DEEP1
    sd.changeDirectory(@"..")  ' root
    result := sd.changeDirectory(@"/")
    utils.evaluateSingleValue(result, @"back at root", sd.SUCCESS)

    ' Test: Empty directory listing
    utils.startTest(@"Empty directory listing")
    sd.changeDirectory(@"/")
    result := sd.newDirectory(@manyFilesDir)
    sd.changeDirectory(@manyFilesDir)
    fileCount := 0
    idx := 0
    repeat
        pEntry := sd.readDirectory(idx)
        if pEntry == 0
            quit
        fileCount++
        idx++
    ' FAT32 empty directories contain . and .. entries (2 entries)
    utils.evaluateSingleValue(fileCount, @"empty dir entries (. and ..)", 2)
    sd.changeDirectory(@"/")

    ' Test: Max filename length (8.3 format)
    utils.startTest(@"Max filename length (8.3)")
    sd.changeDirectory(@manyFilesDir)
    handle := sd.createFileNew(@maxNameFile)
    utils.evaluateSubBool(handle >= 0, @"create 12345678.123", true)
    sd.writeHandle(handle, @"Max name file content", 21)
    sd.closeFileHandle(handle)

    ' Verify can open and read it
    handle := sd.openFileRead(@maxNameFile)
    utils.evaluateSubBool(handle >= 0, @"open 12345678.123", true)
    sd.closeFileHandle(handle)
    sd.changeDirectory(@"/")

    ' Clean up boundary test items
    sd.changeDirectory(@manyFilesDir)
    sd.deleteFile(@maxNameFile)
    sd.changeDirectory(@"/")
    sd.deleteFile(@manyFilesDir)

    ' ----------------------------------
    ' TEST GROUP: Many Files Stress Test
    ' ----------------------------------
    utils.startTestGroup(@"Many Files Stress Test")

    utils.startTest(@"Create and list 20 files in one directory")
    utils.setCheckCountPerTest(5)

    ' (a) Create RTMANY directory
    sd.changeDirectory(@"/")
    result := sd.newDirectory(@manyFilesDir)
    utils.evaluateSubValue(result, @"create RTMANY dir", sd.SUCCESS)

    ' (b) Create 20 files FILE01.TXT through FILE20.TXT
    sd.changeDirectory(@manyFilesDir)
    result := true
    repeat idx from 1 to 20
        buildFileName(idx)
        handle := sd.createFileNew(@genFileName)
        if handle >= 0
            sd.writeHandle(handle, @genFileName, strsize(@genFileName))
            sd.closeFileHandle(handle)
        else
            debug("  createFileNew failed at FILE", udec_(idx))
            result := false
            quit
    utils.evaluateSubBool(result, @"create 20 files", true)

    ' (c) Count entries via readDirectory - expect 22 (20 files + . + ..)
    fileCount := 0
    idx := 0
    repeat
        pEntry := sd.readDirectory(idx)
        if pEntry == 0
            quit
        fileCount++
        idx++
    debug("  Directory entry count: ", udec_(fileCount))
    utils.evaluateSubValue(fileCount, @"count == 22 (20+.+..)", 22)

    ' (d) Verify sample file is readable (FILE10.TXT)
    buildFileName(10)
    handle := sd.openFileRead(@genFileName)
    if handle >= 0
        bytefill(@readBuf, 0, 32)
        utils.initGuard(@readBuf_guard)
        bytesRead := sd.readHandle(handle, @readBuf, 32)
        utils.checkGuard(@readBuf_guard, @"readBuf guard")
        sd.closeFileHandle(handle)
        utils.evaluateSubBool(bytesRead > 0, @"FILE10.TXT readable", true)
    else
        utils.evaluateSubBool(false, @"FILE10.TXT readable", true)

    ' (e) Clean up: delete all 20 files and remove directory
    repeat idx from 1 to 20
        buildFileName(idx)
        sd.deleteFile(@genFileName)
    sd.changeDirectory(@"/")
    sd.deleteFile(@manyFilesDir)
    ' Verify directory was removed
    result := sd.changeDirectory(@manyFilesDir)
    utils.evaluateSubBool(result < 0, @"RTMANY removed", true)
    sd.changeDirectory(@"/")

    utils.showSubTestResults()

    ' Clean up deep directories (must delete from deepest first)
    sd.changeDirectory(@deepDir1)
    sd.changeDirectory(@deepDir2)
    sd.changeDirectory(@deepDir3)
    sd.changeDirectory(@deepDir4)
    sd.changeDirectory(@deepDir5)
    sd.deleteFile(@"DEEP.TXT")
    sd.changeDirectory(@"..")
    sd.deleteFile(@deepDir5)
    sd.changeDirectory(@"..")
    sd.deleteFile(@deepDir4)
    sd.changeDirectory(@"..")
    sd.deleteFile(@deepDir3)
    sd.changeDirectory(@"..")
    sd.deleteFile(@deepDir2)
    sd.changeDirectory(@"/")
    sd.deleteFile(@deepDir1)

    ' ----------------------------------
    ' TEST GROUP: Stale Cluster Directory Test
    ' ----------------------------------
    ' Regression test for stale directory cluster bug: do_newdir() must
    ' clearCluster() the new directory's data cluster so that stale data
    ' from a previously-used cluster does not masquerade as directory entries.
    utils.startTestGroup(@"Stale Cluster Directory Test")

    utils.startTest(@"Create dir in recycled cluster, files span sectors")
    utils.setCheckCountPerTest(7)

    ' (a) Create polluter file and fill with $AA (non-zero, non-$E5)
    sd.changeDirectory(@"/")
    utils.fillBufferWithValue(@staleBuf, 512, $AA)
    utils.initGuard(@staleBuf_guard)
    handle := sd.createFileNew(@stalePolluter)
    utils.evaluateSubBool(handle >= 0, @"create polluter", true)
    if handle >= 0
        ' Write 32 KB of $AA fill (covers cluster sizes up to 64 sectors)
        repeat 64
            sd.writeHandle(handle, @staleBuf, 512)
        sd.closeFileHandle(handle)
    utils.checkGuard(@staleBuf_guard, @"staleBuf guard")

    ' (b) Delete polluter to free its cluster(s) with stale $AA data
    result := sd.deleteFile(@stalePolluter)
    utils.evaluateSubBool(result == sd.SUCCESS, @"delete polluter", true)

    ' (c) Create STALE directory (should get recycled cluster)
    result := sd.newDirectory(@staleDir)
    utils.evaluateSubBool(result == sd.SUCCESS, @"create STALE dir", true)

    ' (d) Create 20 files in STALE (forces entries past first sector)
    sd.changeDirectory(@staleDir)
    result := true
    repeat idx from 1 to 20
        buildStaleFileName(idx)
        handle := sd.createFileNew(@staleGenName)
        if handle >= 0
            sd.writeHandle(handle, @staleGenName, strsize(@staleGenName))
            sd.closeFileHandle(handle)
        else
            debug("  createFileNew failed at STR", udec_(idx))
            result := false
            quit
    utils.evaluateSubBool(result, @"create 20 files", true)

    ' (e) Enumerate directory - expect 22 (20 files + . + ..)
    fileCount := 0
    idx := 0
    repeat
        pEntry := sd.readDirectory(idx)
        if pEntry == 0
            quit
        fileCount++
        idx++
    debug("  Stale dir entry count: ", udec_(fileCount))
    utils.evaluateSubValue(fileCount, @"count == 22 (20+.+..)", 22)

    ' (f) Verify STR15.TXT is openable and readable (overflow region file)
    buildStaleFileName(15)
    handle := sd.openFileRead(@staleGenName)
    if handle >= 0
        bytefill(@readBuf, 0, 32)
        utils.initGuard(@readBuf_guard)
        bytesRead := sd.readHandle(handle, @readBuf, 32)
        utils.checkGuard(@readBuf_guard, @"readBuf guard")
        sd.closeFileHandle(handle)
        utils.evaluateSubBool(bytesRead > 0, @"STR15.TXT readable", true)
    else
        utils.evaluateSubBool(false, @"STR15.TXT readable", true)

    ' (g) Clean up: delete files, remove directory
    repeat idx from 1 to 20
        buildStaleFileName(idx)
        sd.deleteFile(@staleGenName)
    sd.changeDirectory(@"/")
    result := sd.deleteFile(@staleDir)
    utils.evaluateSubBool(result == sd.SUCCESS, @"STALE removed", true)

    utils.showSubTestResults()

    ' ----------------------------------
    ' Cleanup
    ' ----------------------------------
    debug(" ")
    debug("* Cleaning up test items...")
    cleanupTestItems()

    ' Report stack depth while worker cog is still running
#ifdef SD_INCLUDE_STACK_CHECK
    debug(" ")
    debug("* Worker cog stack: ", udec_(sd.reportStackDepth()), " of ", udec_(sd.STACK_SIZE), " longs used")
#endif

    ' Unmount
    sd.unmount()

    ' ----------------------------------
    ' Summary
    ' ----------------------------------
    utils.ShowTestEndCounts()

    debug(" ")
    debug("* Directory Tests Complete")
    debug("END_SESSION")


PRI buildFileName(fileNum) | d10, d1
' Build filename "FILEnn.TXT" in genFileName buffer
'
' @param fileNum - File number 1..99
' @local d10 - Tens digit of file number
' @local d1 - Ones digit of file number

  d10 := fileNum / 10
  d1 := fileNum // 10
  bytemove(@genFileName, @"FILE", 4)
  BYTE[@genFileName + 4] := "0" + d10
  BYTE[@genFileName + 5] := "0" + d1
  bytemove(@genFileName + 6, @".TXT", 4)
  BYTE[@genFileName + 10] := 0


PRI buildStaleFileName(fileNum) | d10, d1
' Build filename "STRnn.TXT" in staleGenName buffer
'
' @param fileNum - File number 1..99
' @local d10 - Tens digit of file number
' @local d1 - Ones digit of file number

  d10 := fileNum / 10
  d1 := fileNum // 10
  bytemove(@staleGenName, @"STR", 3)
  BYTE[@staleGenName + 3] := "0" + d10
  BYTE[@staleGenName + 4] := "0" + d1
  bytemove(@staleGenName + 5, @".TXT", 4)
  BYTE[@staleGenName + 9] := 0


PRI makeClusterZeroFile(pName) : bOk | rootSec, secIdx, entryOfs, pEntry, bDone
' Fabricate what a PC writes for an empty file: a directory entry whose
' first-cluster words are 0. createFileNew() may allocate a real cluster, so
' the entry is patched RAW -- readSectorRaw, zero DE_CLUS_HI/LO, writeSectorRaw
' -- behind the filesystem's back, then setTestInvalidateCaches() forces the
' driver to re-read the patched entry from the card. The original cluster
' words are saved so restoreClusterZeroFile() can undo the patch BEFORE the
' delete, so the file's real chain is freed and nothing leaks.
'
' REFERENCE IMPLEMENTATION (decided 2026-08-10): this raw-fabrication idiom
' cannot live in isp_rt_utilities -- that object deliberately holds no sd
' reference -- so it lives per-suite, and later suites copy this decided form
' rather than re-deriving it.
'
' @param pName - Pointer to filename to create in the CURRENT directory (root expected)
' @returns bOk - TRUE when the file exists on disk with cluster words 0
' @local rootSec - First sector of the root directory
' @local secIdx - Create handle briefly, then root-sector scan index
' @local entryOfs - Byte offset of the entry within its sector
' @local pEntry - Pointer to the entry under inspection in staleBuf
' @local bDone - TRUE once the end-of-directory terminator was seen

    bOk := false
    czSec := -1
    bDone := false
    secIdx := sd.createFileNew(pName)
    if secIdx < 0
        return
    sd.closeFileHandle(secIdx)

    ' Scan covers the root's FIRST cluster only -- on a root grown past one
    ' cluster the fresh entry can land further out and the fixture fails
    ' VISIBLY (never silently probing the wrong thing)
    rootSec := sd.debugGetRootSec()
    repeat secIdx from 0 to sd.sectorsPerCluster() - 1
        if sd.readSectorRaw(rootSec + secIdx, @staleBuf) < 0
            quit
        repeat entryOfs from 0 to sd.LAST_DIR_ENTRY_OFFSET step sd.DIR_ENTRY_SIZE
            pEntry := @staleBuf + entryOfs
            if BYTE[pEntry] == 0                                                ' end-of-directory: nothing lives beyond
                bDone := true
                quit
            if BYTE[pEntry] <> sd.DIR_ENTRY_DELETED AND sfnMatches(pEntry, @sfnCzero)
                czSec := rootSec + secIdx
                czOfs := entryOfs
                quit
        if czSec >= 0 OR bDone
            quit
    if czSec < 0
        return

    czOrigHi := WORD[@staleBuf + czOfs + sd.DE_CLUS_HI_OFFSET]                  ' save for the paired restore
    czOrigLo := WORD[@staleBuf + czOfs + sd.DE_CLUS_LO_OFFSET]
    WORD[@staleBuf + czOfs + sd.DE_CLUS_HI_OFFSET] := 0
    WORD[@staleBuf + czOfs + sd.DE_CLUS_LO_OFFSET] := 0
    if sd.writeSectorRaw(czSec, @staleBuf) < 0
        czSec := -1                                                             ' patch never landed -- nothing to restore
        return
    sd.setTestInvalidateCaches()                                                  ' the patched entry must be re-read from the card
    bOk := true

PRI restoreClusterZeroFile(pName) : bOk | status
' Undo the raw cluster-0 patch, then delete the fixture through the normal
' API. Restoring the saved cluster words FIRST means deleteFile() frees the
' file's real chain (if create allocated one) -- raw-patch discipline:
' capture, patch, probe, restore, then clean up through the front door.
'
' @param pName - Pointer to the fixture's filename (in the current directory, root expected)
' @returns bOk - TRUE when restore (if armed) and delete both succeeded
' @local status - Intermediate API status

    bOk := true
    if czSec >= 0
        if sd.readSectorRaw(czSec, @staleBuf) == sd.SUCCESS
            WORD[@staleBuf + czOfs + sd.DE_CLUS_HI_OFFSET] := czOrigHi
            WORD[@staleBuf + czOfs + sd.DE_CLUS_LO_OFFSET] := czOrigLo
            if sd.writeSectorRaw(czSec, @staleBuf) < 0
                bOk := false
            sd.setTestInvalidateCaches()
        else
            bOk := false
        czSec := -1
    status := sd.deleteFile(pName)
    if status < 0
        bOk := false

PRI sfnMatches(pEntry, pName) : bMatch | idx
' Compare a directory entry's 11-byte on-disk SFN field against an expected name
'
' @param pEntry - Pointer to the 32-byte directory entry (SFN at offset 0)
' @param pName - Pointer to the expected 11-byte space-padded SFN
' @returns bMatch - TRUE when all 11 bytes match
' @local idx - Byte index

    bMatch := true
    repeat idx from 0 to 10
        if BYTE[pEntry + idx] <> BYTE[pName + idx]
            bMatch := false
            quit

PRI cleanupTestItems() | idx
' Delete every fixture this suite owns, files before directories and nested
' items first (a directory can only be removed once it is empty).
'
' Called both BEFORE the body and as teardown, so it must cover every item any
' test group creates -- including the deep-nesting, many-files and stale-cluster
' groups whose own inline cleanup never runs if the suite aborts partway. Residue
' from an aborted run would otherwise fail the very first newDirectory() test
' with E_FILE_EXISTS.
'
' @local idx - File number 1..20 for the generated FILEnn.TXT / STRnn.TXT names

' EVERY cd below is guarded. An unguarded chain that hits a missing directory keeps
' going and deletes the RELATIVE names out of whatever directory it actually landed
' in -- and since a failed cd during the body is precisely what strands those names
' in root, the unguarded pre-clean was capable of deleting a same-named file that
' did not belong to this suite. Guarded, a missing directory just skips its group.

    ' Clean nested items under testDir1
    sd.changeDirectory(@"/")
    if sd.changeDirectory(@testDir1) == sd.SUCCESS
        if sd.changeDirectory(@subDir1) == sd.SUCCESS
            sd.deleteFile(@testFile2)
            sd.changeDirectory(@"..")
        sd.deleteFile(@testFile1)
        sd.deleteFile(@subDir1)
        sd.deleteFile(@czWitness)                       ' cluster-0 group's witness, if a prior run aborted mid-group
    sd.changeDirectory(@"/")

    ' Cluster-0 fixture residue: deleting a cluster-0 entry is safe --
    ' freeClusterChain() refuses clusters below ROOT_CLUSTER, so the entry is
    ' removed and no FAT write happens. If the aborted run left the file with
    ' its real cluster intact, this frees it normally. KNOWN BOUNDED LEAK: a
    ' run that aborted between patch and restore hid the create-allocated
    ' cluster behind the zeroed entry words -- that one cluster stays marked
    ' used until an fsck/format reclaims it (the regression card gets both).
    sd.deleteFile(@czFile)
    sd.deleteFile(@czWitness)                           ' regression-branch residue lands in root (see probe test)

    ' Clean testDir2 contents
    if sd.changeDirectory(@testDir2) == sd.SUCCESS
        sd.deleteFile(@"MOVEME.TXT")
        sd.changeDirectory(@"/")

    ' Clean the many-files directory (20 generated files + max-name file)
    if sd.changeDirectory(@manyFilesDir) == sd.SUCCESS
        repeat idx from 1 to 20
            buildFileName(idx)
            sd.deleteFile(@genFileName)
        sd.deleteFile(@maxNameFile)
        sd.changeDirectory(@"/")

    ' Clean the stale-cluster directory (20 generated files) and its polluter
    if sd.changeDirectory(@staleDir) == sd.SUCCESS
        repeat idx from 1 to 20
            buildStaleFileName(idx)
            sd.deleteFile(@staleGenName)
        sd.changeDirectory(@"/")
    sd.deleteFile(@stalePolluter)

    ' Unwind the 5-level deep nesting, deepest first
    if sd.changeDirectory(@deepDir1) == sd.SUCCESS
        if sd.changeDirectory(@deepDir2) == sd.SUCCESS
            if sd.changeDirectory(@deepDir3) == sd.SUCCESS
                if sd.changeDirectory(@deepDir4) == sd.SUCCESS
                    if sd.changeDirectory(@deepDir5) == sd.SUCCESS
                        sd.deleteFile(@"DEEP.TXT")
                        sd.changeDirectory(@"..")
                    sd.deleteFile(@deepDir5)
                    sd.changeDirectory(@"..")
                sd.deleteFile(@deepDir4)
                sd.changeDirectory(@"..")
            sd.deleteFile(@deepDir3)
            sd.changeDirectory(@"..")
        sd.deleteFile(@deepDir2)
    sd.changeDirectory(@"/")

    ' Root-level strays. When a cd fails mid-body the dependent creation lands in
    ' ROOT under its relative name, and nothing above -- which only ever looks
    ' inside the test directories -- can reach it. Without these, one bad run
    ' leaves FILE1.TXT and friends in root permanently.
    sd.deleteFile(@testFile1)
    sd.deleteFile(@testFile2)
    sd.deleteFile(@"MOVEME.TXT")
    sd.deleteFile(@"DEEP.TXT")
    sd.deleteFile(@maxNameFile)
    sd.deleteFile(@subDir1)

    ' Delete root-level test directories (now empty)
    sd.deleteFile(@deepDir1)
    sd.deleteFile(@manyFilesDir)
    sd.deleteFile(@staleDir)
    sd.deleteFile(@testDir1)
    sd.deleteFile(@testDir2)

