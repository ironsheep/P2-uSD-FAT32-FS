'' =================================================================================================
''
''   File....... SD_RT_raw_sector_tests.spin2
''   Purpose.... Round-trip test of raw sector read/write using V2 driver streamer
''   Author..... Stephen M Moraco
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... JAN 2026
''   Updated.... 12 AUG 2026
''
'' =================================================================================================
''
''   This test verifies the V2 driver's raw sector I/O (readSectorRaw/writeSectorRaw) works
''   correctly by writing known patterns to test sectors, then reading them back and verifying.
''
''   Test Sectors (in free space at sector 100000+):
''     Sector 100000: Pattern A - Sequential bytes with boundary markers
''     Sector 100001: Pattern B - Alternating AA/55 with boundary markers
''     Sector 100002: Pattern C - All FF (except markers)
''     Sector 100003: Pattern D - All 00 (except markers)
''     Sector 100004: Pattern E - Incrementing with sector offset
''
''   Each sector has:
''     - Head marker (bytes 0-7): sector#, sector#, pattern, pattern, DEADBEEF ^ nonce
''     - Fill pattern (bytes 8-503): Pattern-specific data
''     - Tail marker (bytes 504-511): CAFEBABE ^ nonce, pattern, pattern, sector#, sector#
''
''   The nonce is a per-run byte (utils.perRunNonce()). Without it every run wrote
''   byte-identical markers, so a write that silently did nothing still verified --
''   against the previous run's data. The nonce makes stale sectors detectable.
''
''   This provides a full round-trip test of the streamer-based sector I/O.
''
'' =================================================================================================

CON

    _CLKFREQ        = 350_000_000

    ' Enable INIT + SECTOR + RECOVER debug channels for this diagnostic run.
    ' Bits per driver: CH_INIT=0, CH_SECTOR=4, CH_RECOVER=9.
    ' (Three channels combined; well under the 255-record limit.)
    DEBUG_MASK      = (1 << 0) | (1 << 4) | (1 << 9)
    DEBUG_BAUD      = 2_000_000

    ' SD card pin assignments
    ' Default: P2 Edge module SD slot. Build with -D SD_PINS_EXTERNAL
    ' to use the external SD header (base pin 16).
#ifdef SD_PINS_EXTERNAL
    SD_CS   = 20
    SD_MOSI = 19
    SD_MISO = 18
    SD_SCK  = 21
#else
    SD_CS   = 60
    SD_MOSI = 59
    SD_MISO = 58
    SD_SCK  = 61
#endif
    ' Scratch sector numbers. These are RAW LBAs -- the suite runs in MODE_RAW
    ' (initCardOnly, no filesystem), so it writes whatever lives at these
    ' addresses. That is sanctioned: a regression card is project scratch. The
    ' range must still be verified to exist on the card before use, otherwise a
    ' small card fails with confusing I/O errors instead of a clear precondition
    ' message.
    TEST_SECTOR_A   = 100_000   ' Sequential pattern
    TEST_SECTOR_B   = 100_001   ' Alternating AA/55
    TEST_SECTOR_C   = 100_002   ' All FF
    TEST_SECTOR_D   = 100_003   ' All 00
    TEST_SECTOR_E   = 100_004   ' Incrementing with offset

    ' Highest scratch LBA touched, plus the high-LBA addressing probe at 1,000,000
    ' (that probe tolerates an out-of-range result, so it is not part of the gate).
    TEST_SECTOR_MAX = TEST_SECTOR_E


' Enable full driver features for raw sector testing
' Uncomment SD_INCLUDE_STACK_CHECK to measure worker cog stack depth
#ifdef __SPINTOOLS__
#define SD_INCLUDE_ALL
#elseifdef __FLEXSPIN__
#define SD_INCLUDE_ALL
#pragma exportdef SD_INCLUDE_ALL
#else
#pragma exportdef SD_INCLUDE_ALL
#define SD_INCLUDE_STACK_CHECK
#pragma exportdef SD_INCLUDE_STACK_CHECK
#endif

OBJ
    sd    : "micro_sd_fat32_fs"
    utils : "isp_rt_utilities"

VAR
    BYTE    write_buf[512]
    BYTE    read_buf[512]
    BYTE    read_buf_guard[16]
    BYTE    cmd13_pre[7]                                                        ' Buffer for getLastCMD13PreCapture (MISO bytes captured during CMD13 transmission)

PUB go() | result, idx, sector, cardSectors, wroteA, wroteB, wroteC, wroteD, wroteE
'' Main entry point for raw sector round-trip tests
''
'' Tests readSectorRaw/writeSectorRaw operations with various patterns

    debug(" ")
    debug("============================================================")
    debug("  SD Raw Sector Round-Trip Test (V2 Driver)")
    debug("============================================================")
    debug(" ")

    ' Initialize card only (no filesystem mount - we're doing raw sector access)
    debug("Initializing SD card (V2 driver with streamer)...")
    result := sd.initCardOnly(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    ifnot utils.requireSetup(result == 0, @"SETUP: initialize SD card")
        debug("ERROR: Card init failed!")
        utils.ShowTestEndCounts()
        debug("END_SESSION")
        return

    debug("Card initialized successfully")

    ' ----------------------------------------
    ' Precondition gate: the scratch LBA range must exist on this card.
    ' ----------------------------------------
    cardSectors := sd.cardSizeSectors()
    debug("Card size: ", udec_(cardSectors), " sectors; scratch range ", udec_(TEST_SECTOR_A), "..", udec_(TEST_SECTOR_MAX))
    ' Scored, not just printed: the rig's regression cards all satisfy this
    ' range, so a failed check means the wrong card (or something worse) and
    ' must not read as a green 0-fail run.
    ifnot utils.requireSetup(cardSectors > TEST_SECTOR_MAX, @"SETUP: card large enough for scratch range")
        debug("  *** SETUP NOT MET: card has ", udec_(cardSectors), " sectors, scratch range needs > ", udec_(TEST_SECTOR_MAX), " -- raw sector tests NOT run ***")
        utils.ShowTestEndCounts()
        debug("END_SESSION")
        return
    debug(" ")

    ' ========================================
    ' PHASE 1: Write all test patterns
    ' ========================================
    debug("--- PHASE 1: Writing test patterns ---")
    debug(" ")

    ' PHASES 2 AND 3 RE-READ WHAT PHASE 1 WROTE. When a phase-1 write fails, the
    ' matching phase-2 and phase-3 checks are reading a sector nobody wrote this run,
    ' so one root cause used to score as three separate failures and the sweep looked
    ' three times worse than it was. Each phase-1 result is remembered here and the
    ' dependent checks report SKIPPED instead of inventing failures of their own.
    wroteA := false
    wroteB := false
    wroteC := false
    wroteD := false
    wroteE := false

    utils.startTestGroup(@"Pattern Writes with Immediate Read-Back")

    ' Write Pattern A: Sequential bytes
    utils.startTest(@"Write pattern A (sequential)")
    sector := TEST_SECTOR_A
    debug("* Test: Write Pattern A (sequential) to sector ", udec_(sector))
    repeat idx from 0 to 511
        write_buf[idx] := idx & $FF
    addBoundaryMarkers(sector, $A0)
    wroteA := writeAndVerify(sector, $A0)
    if wroteA
        utils.recordPass()
    else
        utils.recordFail()

    ' Write Pattern B: Alternating AA/55
    utils.startTest(@"Write pattern B (alternating AA/55)")
    sector := TEST_SECTOR_B
    debug("* Test: Write Pattern B (AA/55) to sector ", udec_(sector))
    repeat idx from 0 to 511
        write_buf[idx] := (idx & 1) ? $55 : $AA
    addBoundaryMarkers(sector, $B0)
    wroteB := writeAndVerify(sector, $B0)
    if wroteB
        utils.recordPass()
    else
        utils.recordFail()

    ' Write Pattern C: All FF (except markers)
    utils.startTest(@"Write pattern C (all $FF)")
    sector := TEST_SECTOR_C
    debug("* Test: Write Pattern C (all FF) to sector ", udec_(sector))
    bytefill(@write_buf, $FF, 512)
    addBoundaryMarkers(sector, $C0)
    wroteC := writeAndVerify(sector, $C0)
    if wroteC
        utils.recordPass()
    else
        utils.recordFail()

    ' Write Pattern D: All 00 (except markers)
    utils.startTest(@"Write pattern D (all $00)")
    sector := TEST_SECTOR_D
    debug("* Test: Write Pattern D (all 00) to sector ", udec_(sector))
    bytefill(@write_buf, $00, 512)
    addBoundaryMarkers(sector, $D0)
    wroteD := writeAndVerify(sector, $D0)
    if wroteD
        utils.recordPass()
    else
        utils.recordFail()

    ' Write Pattern E: Incrementing with sector offset
    utils.startTest(@"Write pattern E (sequential + $E0 offset)")
    sector := TEST_SECTOR_E
    debug("* Test: Write Pattern E (offset) to sector ", udec_(sector))
    repeat idx from 0 to 511
        write_buf[idx] := (idx + $E0) & $FF          ' Offset by $E0 to distinguish from pattern A
    addBoundaryMarkers(sector, $E0)
    wroteE := writeAndVerify(sector, $E0)
    if wroteE
        utils.recordPass()
    else
        utils.recordFail()

    debug(" ")

    ' ========================================
    ' PHASE 2: Read back in REVERSE order
    ' ========================================
    debug("--- PHASE 2: Verify by reading in REVERSE order ---")
    debug("(Tests that correct sectors were written, not just cached)")
    debug(" ")

    utils.startTestGroup(@"Reverse-Order Read-Back")

    ' A SKIPPED dependent check is neither titled nor recorded (see the phase-1
    ' comment): skipping startTest along with the record keeps the framework's
    ' title/record counts balanced.

    ' Read Pattern E first (was written last)
    sector := TEST_SECTOR_E
    debug("* Test: Read sector ", udec_(sector), " (expect pattern E=$E0)")
    ifnot wroteE
        debug("  -> SKIPPED (pattern E was never written this run)")
    else
        utils.startTest(@"Read back pattern E (reverse order)")
        if verifyPattern(sector, $E0)
            utils.recordPass()
        else
            utils.recordFail()

    ' Read Pattern D
    sector := TEST_SECTOR_D
    debug("* Test: Read sector ", udec_(sector), " (expect pattern D=$D0)")
    ifnot wroteD
        debug("  -> SKIPPED (pattern D was never written this run)")
    else
        utils.startTest(@"Read back pattern D (reverse order)")
        if verifyPattern(sector, $D0)
            utils.recordPass()
        else
            utils.recordFail()

    ' Read Pattern C
    sector := TEST_SECTOR_C
    debug("* Test: Read sector ", udec_(sector), " (expect pattern C=$C0)")
    ifnot wroteC
        debug("  -> SKIPPED (pattern C was never written this run)")
    else
        utils.startTest(@"Read back pattern C (reverse order)")
        if verifyPattern(sector, $C0)
            utils.recordPass()
        else
            utils.recordFail()

    ' Read Pattern B
    sector := TEST_SECTOR_B
    debug("* Test: Read sector ", udec_(sector), " (expect pattern B=$B0)")
    ifnot wroteB
        debug("  -> SKIPPED (pattern B was never written this run)")
    else
        utils.startTest(@"Read back pattern B (reverse order)")
        if verifyPattern(sector, $B0)
            utils.recordPass()
        else
            utils.recordFail()

    ' Read Pattern A last (was written first)
    sector := TEST_SECTOR_A
    debug("* Test: Read sector ", udec_(sector), " (expect pattern A=$A0)")
    ifnot wroteA
        debug("  -> SKIPPED (pattern A was never written this run)")
    else
        utils.startTest(@"Read back pattern A (reverse order)")
        if verifyPattern(sector, $A0)
            utils.recordPass()
        else
            utils.recordFail()

    debug(" ")

    ' ========================================
    ' PHASE 3: Full data verification
    ' ========================================
    debug("--- PHASE 3: Full 512-byte data verification ---")
    debug(" ")

    utils.startTestGroup(@"Full Data Verification")

    ' Verify all 512 bytes of Pattern A (sequential)
    debug("* Test: Full verify Pattern A (512 sequential bytes)")
    ifnot wroteA
        debug("  -> SKIPPED (pattern A was never written this run)")
    else
        utils.startTest(@"Full verify pattern A")
        if verifyFullPattern(TEST_SECTOR_A, 0)
            utils.recordPass()
        else
            utils.recordFail()

    ' Verify all 512 bytes of Pattern B (AA/55)
    debug("* Test: Full verify Pattern B (alternating AA/55)")
    ifnot wroteB
        debug("  -> SKIPPED (pattern B was never written this run)")
    else
        utils.startTest(@"Full verify pattern B")
        if verifyFullPatternAlt(TEST_SECTOR_B)
            utils.recordPass()
        else
            utils.recordFail()

    debug(" ")

    ' ========================================
    ' PHASE 4: Sector Address Boundary Tests
    ' ========================================
    debug("--- PHASE 4: Sector Address Boundary Tests ---")
    debug(" ")

    utils.startTestGroup(@"Sector Address Boundaries")

    ' Test: Sector 0 (MBR) - verify MBR signature
    utils.startTest(@"Read sector 0 (MBR signature)")
    debug("* Test: Read sector 0 (MBR) and verify signature $55 $AA")
    utils.initGuard(@read_buf_guard)
    result := sd.readSectorRaw(0, @read_buf)
    utils.checkGuard(@read_buf_guard, @"read_buf guard")
    if result < 0
        debug("  READ FAILED! status=", sdec_(result))
        dumpReadFailDiag()
        debug("  -> FAIL")
        utils.recordFail()
    elseif read_buf[510] == $55 and read_buf[511] == $AA
        debug("  MBR signature verified: $55 $AA at bytes 510-511")
        debug("  -> pass")
        utils.recordPass()
    else
        debug("  ERROR: Expected $55 $AA, got $", uhex_byte_(read_buf[510]), " $", uhex_byte_(read_buf[511]))
        dumpReadFailDiag()
        debug("  -> FAIL")
        utils.recordFail()

    ' Test: High sector number (1,000,000) - verify large LBA addressing
    utils.startTest(@"Read high LBA 1,000,000 (answer agrees with card size)")
    debug("* Test: Read high sector number 1,000,000 (large LBA)")
    utils.initGuard(@read_buf_guard)
    result := sd.readSectorRaw(1_000_000, @read_buf)
    utils.checkGuard(@read_buf_guard, @"read_buf guard")
    ' Both branches used to record a pass, which made this test incapable of
    ' failing -- it asserted only that the call returned. The real property is that
    ' the driver's answer AGREES WITH THE CARD: sector 1,000,000 must read
    ' successfully on a card that has it, and must be refused on a card that does
    ' not. Either answer is correct; the WRONG answer for this card is the failure.
    if 1_000_000 < cardSectors
        if result == sd.SUCCESS
            debug("  High sector read completed (result=", sdec_(result), ")")
            debug("  First bytes: $", uhex_byte_(read_buf[0]), " $", uhex_byte_(read_buf[1]), " $", uhex_byte_(read_buf[2]), " $", uhex_byte_(read_buf[3]))
            debug("  -> pass (in-range large LBA read succeeded)")
            utils.recordPass()
        else
            debug("  ERROR: sector 1,000,000 is WITHIN this card (", udec_(cardSectors), " sectors) but read returned ", sdec_(result))
            debug("  -> FAIL")
            utils.recordFail()
    else
        if result == sd.SUCCESS
            debug("  ERROR: sector 1,000,000 is BEYOND this card (", udec_(cardSectors), " sectors) but the read reported success")
            debug("  -> FAIL")
            utils.recordFail()
        else
            debug("  High sector read returned: ", sdec_(result))
            debug("  -> pass (out-of-range sector correctly refused)")
            utils.recordPass()

    ' Report stack depth while worker cog is still running
#ifdef SD_INCLUDE_STACK_CHECK
    debug(" ")
    debug("* Worker cog stack: ", udec_(sd.reportStackDepth()), " of ", udec_(sd.STACK_SIZE), " longs used")
#endif

    ' Framework totals, BAD TEST COUNTS cross-check, and (on measurement builds) the stack watermark
    utils.ShowTestEndCounts()

    debug(" ")
    debug("END_SESSION")

PRI addBoundaryMarkers(sector, patternId) | secLow, nonce
' Add head and tail boundary markers to write_buf
'
' @param sector - sector number for marker
' @param patternId - pattern identifier byte
' @local nonce - per-run byte mixed into the magic values (see below)
'
' Head (bytes 0-7): sector#, sector#, pattern, pattern, DEADBEEF ^ nonce
' Tail (bytes 504-511): CAFEBABE ^ nonce, pattern, pattern, sector#, sector#
'
' THE NONCE IS WHY THESE MARKERS MEAN ANYTHING. Every run used to write byte-for-byte
' IDENTICAL markers, so a write that silently did nothing still read back a perfect
' match -- from the PREVIOUS run's data sitting in those sectors. Phases 2 and 3
' re-read what phase 1 wrote, so all three phases could pass without a single byte
' having been written this run. Mixing utils.perRunNonce() into the magic values
' makes last run's bytes distinguishable from this run's.

    secLow := sector & $FF
    nonce := utils.perRunNonce()

    ' Head marker (bytes 0-7)
    write_buf[0] := secLow
    write_buf[1] := secLow
    write_buf[2] := patternId
    write_buf[3] := patternId
    write_buf[4] := $DE ^ nonce
    write_buf[5] := $AD ^ nonce
    write_buf[6] := $BE ^ nonce
    write_buf[7] := $EF ^ nonce

    ' Tail marker (bytes 504-511)
    write_buf[504] := $CA ^ nonce
    write_buf[505] := $FE ^ nonce
    write_buf[506] := $BA ^ nonce
    write_buf[507] := $BE ^ nonce
    write_buf[508] := patternId
    write_buf[509] := patternId
    write_buf[510] := secLow
    write_buf[511] := secLow

PRI writeAndVerify(sector, expectedPattern) : success | wrStatus, rdStatus
' Write sector and immediately read back to verify
'
' @param sector - sector number to write
' @param expectedPattern - expected pattern ID for verification
' @returns success - true if write succeeded and readback matches
' @local wrStatus - writeSectorRaw return code
' @local rdStatus - readSectorRaw return code (was previously discarded, masking real errors)

    wrStatus := sd.writeSectorRaw(sector, @write_buf)
    if wrStatus < 0
        debug("  WRITE FAILED! status=", sdec_(wrStatus))
        dumpWriteFailDiag()
        return false

    ' Read back immediately
    utils.initGuard(@read_buf_guard)
    rdStatus := sd.readSectorRaw(sector, @read_buf)
    utils.checkGuard(@read_buf_guard, @"read_buf guard")
    if rdStatus < 0
        debug("  READ FAILED after write! status=", sdec_(rdStatus))
        dumpWriteFailDiag()  ' prior write reported success; show its diag for context
        dumpReadFailDiag()
        return false

    ' Quick verify of markers
    success := verifyMarkers(sector, expectedPattern)
    if success
        debug("  -> pass (write + immediate readback)")
    else
        debug("  -> FAIL (readback mismatch, both API calls returned SUCCESS)")
        dumpWriteFailDiag()
        dumpReadFailDiag()

PRI verifyPattern(sector, expectedPattern) : success | rdStatus
' Read sector and verify boundary markers match expected pattern
'
' @param sector - sector number to read
' @param expectedPattern - expected pattern ID
' @returns success - true if verified OK, false if mismatch
' @local rdStatus - readSectorRaw return code (was previously discarded, masking real errors)

    utils.initGuard(@read_buf_guard)
    rdStatus := sd.readSectorRaw(sector, @read_buf)
    utils.checkGuard(@read_buf_guard, @"read_buf guard")
    if rdStatus < 0
        debug("  READ FAILED! status=", sdec_(rdStatus))
        dumpReadFailDiag()
        return false
    success := verifyMarkers(sector, expectedPattern)
    if success
        debug("  -> pass")
    else
        debug("  -> FAIL (readback mismatch, API returned SUCCESS)")
        dumpReadFailDiag()

PRI verifyMarkers(sector, expectedPattern) : success | secLow, nonce
' Verify head and tail markers in read_buf
'
' @param sector - sector number for expected marker values
' @param expectedPattern - expected pattern ID
' @returns success - true if all markers match
' @local nonce - the same per-run byte addBoundaryMarkers() mixed in; a sector left
'                by an EARLIER run carries that run's nonce and fails here

    success := true
    secLow := sector & $FF
    nonce := utils.perRunNonce()

    ' Check head marker
    if read_buf[0] <> secLow or read_buf[1] <> secLow
        debug("  ERROR: Sector ID mismatch! Expected $", uhex_byte_(secLow), ", got $", uhex_byte_(read_buf[0]))
        success := false

    if read_buf[2] <> expectedPattern or read_buf[3] <> expectedPattern
        debug("  ERROR: Pattern ID mismatch! Expected $", uhex_byte_(expectedPattern), ", got $", uhex_byte_(read_buf[2]))
        success := false

    if read_buf[4] <> ($DE ^ nonce) or read_buf[5] <> ($AD ^ nonce) or read_buf[6] <> ($BE ^ nonce) or read_buf[7] <> ($EF ^ nonce)
        debug("  ERROR: Head magic mismatch! Expected DEADBEEF^$", uhex_byte_(nonce), ", got $", uhex_byte_(read_buf[4]), uhex_byte_(read_buf[5]), uhex_byte_(read_buf[6]), uhex_byte_(read_buf[7]))
        debug("         (a mismatch here can mean STALE DATA from an earlier run, not just corruption)")
        success := false

    ' Check tail marker
    if read_buf[504] <> ($CA ^ nonce) or read_buf[505] <> ($FE ^ nonce) or read_buf[506] <> ($BA ^ nonce) or read_buf[507] <> ($BE ^ nonce)
        debug("  ERROR: Tail magic mismatch! Expected CAFEBABE^$", uhex_byte_(nonce))
        success := false

    if read_buf[508] <> expectedPattern or read_buf[509] <> expectedPattern
        debug("  ERROR: Tail pattern mismatch!")
        success := false

    if read_buf[510] <> secLow or read_buf[511] <> secLow
        debug("  ERROR: Tail sector ID mismatch!")
        success := false

PRI verifyFullPattern(sector, baseOffset) : success | idx, expected, actual, rdStatus
' Verify all 512 bytes of a sequential pattern sector
'
' @param sector - sector number to verify
' @param baseOffset - offset added to sequential count (0 for A, $E0 for E)
' @returns success - true if all data bytes match
' @local rdStatus - readSectorRaw return code (was previously discarded, masking real errors)

    utils.initGuard(@read_buf_guard)
    rdStatus := sd.readSectorRaw(sector, @read_buf)
    utils.checkGuard(@read_buf_guard, @"read_buf guard")
    if rdStatus < 0
        debug("  READ FAILED! status=", sdec_(rdStatus))
        dumpReadFailDiag()
        return false
    success := true

    repeat idx from 8 to 503
        expected := (idx + baseOffset) & $FF
        actual := read_buf[idx]
        if actual <> expected
            debug("  ERROR at byte ", udec_(idx), ": expected $", uhex_byte_(expected), ", got $", uhex_byte_(actual))
            success := false
            quit  ' Report first error only

    if success
        debug("  -> pass (496 data bytes verified)")
    else
        debug("  -> FAIL (data mismatch, API returned SUCCESS)")
        dumpReadFailDiag()

PRI verifyFullPatternAlt(sector) : success | idx, expected, actual, rdStatus
' Verify all bytes of alternating AA/55 pattern sector
'
' @param sector - sector number to verify
' @returns success - true if all data bytes match AA/55 pattern
' @local rdStatus - readSectorRaw return code (was previously discarded, masking real errors)

    utils.initGuard(@read_buf_guard)
    rdStatus := sd.readSectorRaw(sector, @read_buf)
    utils.checkGuard(@read_buf_guard, @"read_buf guard")
    if rdStatus < 0
        debug("  READ FAILED! status=", sdec_(rdStatus))
        dumpReadFailDiag()
        return false
    success := true

    repeat idx from 8 to 503
        expected := (idx & 1) ? $55 : $AA
        actual := read_buf[idx]
        if actual <> expected
            debug("  ERROR at byte ", udec_(idx), ": expected $", uhex_byte_(expected), ", got $", uhex_byte_(actual))
            success := false
            quit  ' Report first error only

    if success
        debug("  -> pass (496 data bytes verified)")
    else
        debug("  -> FAIL (data mismatch, API returned SUCCESS)")
        dumpReadFailDiag()

PRI dumpWriteFailDiag() | code, r1, dresp, sec, cmd13, r1_ms, r1_polls, last_op
' Print the driver's per-write diagnostic state. Call from any failure path
' inside writeAndVerify -- write-fail, read-after-write-fail, or marker
' mismatch. The diag fields reflect the most recent writeSector call, so
' the dump is valid even when the immediate FAILURE is on the read-back.
'
' Includes cmd13_pre_capture bytes: MISO captured DURING CMD13 transmission.
' Healthy bus reads $FF $FF ... while we transmit; if the bytes are $00 the
' bus was stuck LOW before the command started, meaning the card is wedged
' and CMD13's "happy" $00 $00 R2 is uninterpretable (driver cannot
' distinguish stuck-low from a legitimate clean R2).
'
' @local code   - getWriteDiag result code (1=CMD24fatalR1 2=drespTO 3=CRCrej
'                 4=writeErr 5=unkRej 6=busyTO 7=success 8=CMD24 R1 never arrived)
' @local r1     - CMD24 R1 response byte from the last write
' @local dresp  - Data response token (masked) from the last write
' @local sec    - Sector number the last write attempted
' @local cmd13  - Most recent non-zero CMD13 R2 (R1 high byte, status low byte)

    code, r1, dresp, sec := sd.getWriteDiag()
    cmd13 := sd.getLastCMD13Error()
    r1_ms, r1_polls, last_op := sd.getCmdR1Diag()
    sd.getLastCMD13PreCapture(@cmd13_pre)
    debug("    write diag: code=", udec_(code), " R1=$", uhex_byte_(r1), " dresp=$", uhex_byte_(dresp), " sector=", udec_(sec))
    debug("    write diag: lastCMD13err=$", uhex_word_(cmd13), "  (codes: 1=CMD24fatalR1 2=drespTO 3=CRCrej 4=writeErr 5=unkRej 6=busyTO 7=success 8=R1neverArrived)")
    debug("    write diag: cmd13_pre=[", uhex_byte_(cmd13_pre[0]), " ", uhex_byte_(cmd13_pre[1]), " ", uhex_byte_(cmd13_pre[2]), " ", uhex_byte_(cmd13_pre[3]), " ", uhex_byte_(cmd13_pre[4]), " ", uhex_byte_(cmd13_pre[5]), " ", uhex_byte_(cmd13_pre[6]), "]  (expect $FF*; $00* = bus stuck LOW = wedged)")
    debug("    write diag: cmd(CMD", udec_(last_op), ") R1 latency=", sdec_(r1_ms), " ms after ", udec_(r1_polls), " byte polls  (fast=<5ms, slow=several hundred ms, timeout=-1)")

PRI dumpReadFailDiag() | cmd13, warnings
' Print driver state useful for diagnosing a failed or wrong-data read.
' Driver has no equivalent of getWriteDiag for the read path -- the most
' informative pieces are the last CMD13 error, the warning flags
' (CW_NO_DATA_CRC etc.), and cmd13_pre_capture.
'
' CRC fields (getLastReceivedCRC / getLastCalculatedCRC) are intentionally
' omitted -- on CW_NO_DATA_CRC cards rxCRC is always the dummy $0000 the
' card transmits, and calcCRC stays frozen at the most recent successful
' CRC computation (typically the init-time probeDataCrc value). Neither
' tells us anything about the current failing read.
'
' cmd13_pre_capture: MISO bytes captured DURING the last CMD13 command
' transmission. On a healthy bus those bytes are all $FF (idle while we
' transmit). On a wedged card with MISO stuck LOW they are $00 -- which
' is the discriminator for whether CMD13's "$0000 R2 = no error" report
' is genuine or just driver-misread stuck-low MISO.
'
' @local cmd13    - Most recent non-zero CMD13 R2
' @local warnings - cardWarnings() bitmask (CW_NO_DATA_CRC = $04, etc.)

    cmd13    := sd.getLastCMD13Error()
    warnings := sd.cardWarnings()
    sd.getLastCMD13PreCapture(@cmd13_pre)
    debug("    read diag: lastCMD13err=$", uhex_word_(cmd13), " warnings=$", uhex_byte_(warnings))
    debug("    read diag: cmd13_pre=[", uhex_byte_(cmd13_pre[0]), " ", uhex_byte_(cmd13_pre[1]), " ", uhex_byte_(cmd13_pre[2]), " ", uhex_byte_(cmd13_pre[3]), " ", uhex_byte_(cmd13_pre[4]), " ", uhex_byte_(cmd13_pre[5]), " ", uhex_byte_(cmd13_pre[6]), "]  (expect $FF*; $00* = bus stuck LOW = wedged)")

