'' =================================================================================================
''
''   File....... SD_RT_async_tests.spin2
''   Purpose.... This object exercises the non-blocking file I/O API: startReadHandle,
''               startWriteHandle, isComplete, getResult, cancelAsync
''   Author..... Stephen M Moraco
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... MAR 2026
''   Updated.... 17 MAR 2026
''
'' =================================================================================================

CON

     _CLKFREQ        = 350_000_000

     ' SD card pin assignments
     ' Default: P2 Edge module SD slot. Build with -D SD_PINS_EXTERNAL
     ' to use the external SD header (base pin 16).
#ifdef SD_PINS_EXTERNAL
     SD_CS   = 20
     SD_MOSI = 19
     SD_MISO = 18
     SD_SCK  = 21
#else
     SD_CS   = 60
     SD_MOSI = 59
     SD_MISO = 58
     SD_SCK  = 61
#endif
     ' Async test configuration
     STACK_SIZE      = 128           ' Stack size for helper cog (longs)
     BUF_SIZE        = 64            ' Test buffer size (bytes)

     ' Hang-proofing budget: bounded wait gives up and lets the caller's named
     ' checks record the failure (see waitHelperDone). Shorter than the 30s
     ' worker budget elsewhere -- the helper does ONE blocking read, not a
     ' multi-iteration workload.
     HELPER_TIMEOUT_POLLS = 500      ' x 10ms polls = 5s helper-completion budget

     ' Worker status codes
     STATUS_IDLE      = 0
     STATUS_RUNNING   = 1
     STATUS_PASS      = 2
     STATUS_FAIL      = -1

' Enable all features including async
#pragma exportdef SD_INCLUDE_ALL
#pragma exportdef SD_INCLUDE_ASYNC

OBJ
    sd    : "micro_sd_fat32_fs"
    utils : "isp_rt_utilities"

DAT

' Test files
asyncTestFile   BYTE    "ASYNC1.TXT", 0
asyncContent    BYTE    "Async test data 1234567890ABCDEF", 0
bigTestFile     BYTE    "ASYNC2.BIN", 0          ' 2-sector file for the partial-count witness

' Buffers for async operations
asyncBuf        BYTE    0[BUF_SIZE]
asyncBuf_guard  BYTE    0[16]
blockBuf        BYTE    0[BUF_SIZE]
blockBuf_guard  BYTE    0[16]
bigBuf          BYTE    0[1024]                  ' spans two sectors for the partial-count witness
bigBuf_guard    BYTE    0[16]

' Throwaway receivers for debugGetReadSectorDiag(); only the sector is wanted
diagLastSector  LONG    0
diagScratch     LONG    0[7]

' Helper cog resources
helper_stack    LONG    0[STACK_SIZE]
helper_status   LONG    0
helper_result   LONG    0
helper_cogid    LONG    -1
sync_barrier    LONG    0

' What a NON-OWNING cog got back when it reached for someone else's async operation
foreign_complete LONG   0
foreign_result   LONG    0
foreign_cancel   LONG    0

' What the OWNING cog's own blocking calls got back while its async op was in flight
samecog_start   LONG    0
samecog_read    LONG    0
samecog_close   LONG    0
samecog_collect LONG    0

' TRUE when a deadlocked helper died owning api_lock: any further driver call
' would hang the suite, so go() skips driver cleanup and goes straight to the
' score + END_SESSION
cleanup_unsafe  LONG    0


PUB go() | result
'' Main entry point -- runs non-blocking file I/O tests.

    debug(" ")
    debug("==============================================")
    debug("  SD Card Driver - Async I/O Tests")
    debug("==============================================")
    debug(" ")

    result := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    ifnot utils.requireSetup(result == 0, @"SETUP: mount SD card")
        debug("ERROR: Could not mount SD card - aborting async tests!")
        utils.ShowTestEndCounts()
        debug("END_SESSION")
        return

    ' Create test file with known content. Gated: every test below depends on
    ' this seed, so a failure is one named, scored setup failure -- not seven
    ' obscure downstream ones.
    ifnot utils.requireSetup(createTestFile(), @"SETUP: create async test file")
        sd.deleteFile(@asyncTestFile)
        sd.unmount()
        utils.ShowTestEndCounts()
        debug("END_SESSION")
        return

    ' ----------------------------------
    ' TEST GROUP: Async Read
    ' ----------------------------------
    utils.startTestGroup(@"Async Read Operations")
    runTest1_AsyncReadMatch()
    runTest2_AsyncWriteVerify()

    ' ----------------------------------
    ' TEST GROUP: Async Lifecycle
    ' ----------------------------------
    utils.startTestGroup(@"Async Lifecycle")
    runTest3_IsCompleteTransition()
    runTest4_CancelReleasesLock()

    ' ----------------------------------
    ' TEST GROUP: Multi-Cog Async
    ' ----------------------------------
    utils.startTestGroup(@"Multi-Cog Async Interleave")
    runTest5_AsyncInterleave()

    ' ----------------------------------
    ' TEST GROUP: Error Cases
    ' ----------------------------------
    utils.startTestGroup(@"Async Error Cases")
    runTest6_DoubleStartBusy()
    runTest7_ForeignCogRejected()
    runTest8_SameCogAsyncBusy()

    ' ----------------------------------
    ' TEST GROUP: Async Failure Paths
    ' ----------------------------------
    ' Error propagation through the async path is correct in code (worker maps
    ' a negative op result into pb_status; getResult returns it and set_error()s
    ' it for the collecting cog) but NOTHING witnessed it before this group --
    ' the error cases above cover only E_ASYNC_BUSY and foreign-cog refusals.
    utils.startTestGroup(@"Async Failure Paths")
    runTest9_CollectTimeInvalid()
    runTest10_InjectedReadFailure()
    runTest11_PartialCount()
    runTest12_AsyncWriteAppend()
    runTest13_ErrorAfterStart()

    ' Cleanup -- skipped when a deadlocked helper stranded api_lock (Test 8
    ' timeout path): the named failures are already recorded, and the score +
    ' END_SESSION must still reach the log instead of hanging here
    if cleanup_unsafe
        debug("  *** api_lock stranded by deadlocked helper -- driver cleanup skipped ***")
    else
        sd.deleteFile(@asyncTestFile)
        result := sd.unmount()
        if result < 0
            debug("WARNING: unmount() returned ", sdec_(result))

    utils.ShowTestEndCounts()

    debug(" ")
    debug("* Async I/O Tests Complete")
    debug("END_SESSION")


' ═══════════════════════════════════════════════════════════════════════════
' TEST METHODS
' ═══════════════════════════════════════════════════════════════════════════

PRI runTest1_AsyncReadMatch() | handle, status, bytesAsync, bytesBlock, contentLen, matched
' Verify async read produces identical data to blocking read of the same file.
'

    utils.startTest(@"Async read matches blocking read")
    utils.setCheckCountPerTest(4)

    contentLen := strsize(@asyncContent)
    utils.initGuard(@asyncBuf_guard)
    utils.initGuard(@blockBuf_guard)

    ' First: blocking read into blockBuf
    bytefill(@blockBuf, 0, BUF_SIZE)
    handle := sd.openFileRead(@asyncTestFile)
    utils.evaluateSubBool(handle >= 0, @"open for blocking read", true)
    if handle >= 0
        bytesBlock := sd.readHandle(handle, @blockBuf, contentLen)
        sd.closeFileHandle(handle)
    else
        bytesBlock := -1

    ' Second: async read into asyncBuf
    bytefill(@asyncBuf, 0, BUF_SIZE)
    handle := sd.openFileRead(@asyncTestFile)
    utils.evaluateSubBool(handle >= 0, @"open for async read", true)
    if handle >= 0
        status := sd.startReadHandle(handle, @asyncBuf, contentLen)
        if status == sd.PENDING
            bytesAsync := sd.getResult()
        else
            bytesAsync := status
        sd.closeFileHandle(handle)
    else
        bytesAsync := -1

    ' Compare results
    utils.evaluateSubValue(bytesAsync, @"async bytes == blocking bytes", bytesBlock)

    ' Compare buffer contents
    if bytesAsync > 0 and bytesBlock > 0
        matched := true
        repeat contentLen
            if asyncBuf[contentLen - 1] <> blockBuf[contentLen - 1]
                matched := false
                quit
            contentLen--
        utils.evaluateSubBool(matched, @"buffer contents match", true)
    else
        utils.evaluateSubBool(false, @"buffer contents match", true)
    utils.showSubTestResults()

    utils.checkGuard(@asyncBuf_guard, @"asyncBuf guard")
    utils.checkGuard(@blockBuf_guard, @"blockBuf guard")


PRI runTest2_AsyncWriteVerify() | hWrite, hRead, status, bytesWritten, bytesRead, contentLen, matched, idx
' Verify async write persists correct data by reading it back with a blocking read.
'

    utils.startTest(@"Async write verified by blocking read")
    utils.setCheckCountPerTest(4)

    contentLen := strsize(@asyncContent)
    utils.initGuard(@asyncBuf_guard)

    ' Delete and recreate with async write
    sd.deleteFile(@asyncTestFile)
    hWrite := sd.createFileNew(@asyncTestFile)
    utils.evaluateSubBool(hWrite >= 0, @"create for async write", true)
    if hWrite >= 0
        debug("  DBG: calling startWriteHandle(", sdec_(hWrite), ", @buf, ", udec_(contentLen), ")")
        status := sd.startWriteHandle(hWrite, @asyncContent, contentLen)
        debug("  DBG: startWriteHandle returned status=", sdec_(status))
        if status == sd.PENDING
            bytesWritten := sd.getResult()
            debug("  DBG: getResult returned=", sdec_(bytesWritten))
        else
            bytesWritten := status
            debug("  DBG: startWriteHandle not PENDING, bytesWritten=", sdec_(bytesWritten))
        sd.closeFileHandle(hWrite)
    else
        bytesWritten := -1

    utils.evaluateSubValue(bytesWritten, @"async wrote all bytes", contentLen)

    ' Blocking read to verify
    bytefill(@asyncBuf, 0, BUF_SIZE)
    hRead := sd.openFileRead(@asyncTestFile)
    utils.evaluateSubBool(hRead >= 0, @"open for verify read", true)
    if hRead >= 0
        bytesRead := sd.readHandle(hRead, @asyncBuf, contentLen)
        sd.closeFileHandle(hRead)

        matched := true
        repeat idx from 0 to contentLen - 1
            if asyncBuf[idx] <> BYTE[@asyncContent][idx]
                matched := false
                quit
        utils.evaluateSubBool(matched, @"read-back data matches", true)
    else
        utils.evaluateSubBool(false, @"read-back data matches", true)
    utils.showSubTestResults()

    utils.checkGuard(@asyncBuf_guard, @"asyncBuf guard")


PRI runTest3_IsCompleteTransition() | handle, status, wasFalse, contentLen
' Verify isComplete() transitions from FALSE to TRUE during an async read operation.
'

    utils.startTest(@"isComplete transitions FALSE to TRUE")
    utils.setCheckCountPerTest(3)

    contentLen := strsize(@asyncContent)
    wasFalse := false                                   ' read after the ifs -- must hold on every path

    handle := sd.openFileRead(@asyncTestFile)
    utils.evaluateSubBool(handle >= 0, @"open file", true)
    if handle >= 0
        status := sd.startReadHandle(handle, @asyncBuf, contentLen)
        utils.evaluateSubValue(status, @"startReadHandle returns PENDING", sd.PENDING)

        ' The poll below is entered ONLY with an operation in flight. By driver
        ' semantics isComplete() is FALSE forever when nothing is pending
        ' (driver do_is_complete), so polling after a failed start would hang
        ' this suite, not fail it.
        if status == sd.PENDING
            ' Record if we ever see FALSE before completion
            wasFalse := not sd.isComplete()

            ' Wait for completion -- an in-flight op always completes
            repeat until sd.isComplete()

            ' For fast SD cards, isComplete may already be TRUE on first check.
            ' Either we saw FALSE (transition observed) or TRUE immediately (fast card).
            ' Both are valid - the key invariant is that getResult succeeds.
            sd.getResult()

            ' isComplete followed by getResult must succeed (no hang)
            utils.evaluateSubBool(true, @"isComplete+getResult completed", true)
        else
            utils.evaluateSubBool(false, @"isComplete+getResult completed", true)
        sd.closeFileHandle(handle)
    else
        utils.evaluateSubBool(false, @"startReadHandle returns PENDING", true)
        utils.evaluateSubBool(false, @"isComplete+getResult completed", true)
    utils.showSubTestResults()

    if wasFalse
        debug("  (saw FALSE before TRUE - transition observed)")
    else
        debug("  (isComplete was TRUE immediately - fast card)")


PRI runTest4_CancelReleasesLock() | handle, status, bytesRead, contentLen, position
' Verify cancelAsync()'s documented semantics: the operation runs to COMPLETION
' (only the result is discarded), so the position MOVES -- and the lock is
' released for the next blocking call. The recovery seek must stay AFTER the
' position assertion; seeking first would mask the movement.
'

    utils.startTest(@"cancelAsync completes op, moves position, releases lock")
    utils.setCheckCountPerTest(5)

    contentLen := strsize(@asyncContent)
    utils.initGuard(@asyncBuf_guard)

    handle := sd.openFileRead(@asyncTestFile)
    utils.evaluateSubBool(handle >= 0, @"open file", true)
    if handle >= 0
        ' Start async read then immediately cancel
        status := sd.startReadHandle(handle, @asyncBuf, contentLen)
        utils.evaluateSubValue(status, @"startReadHandle PENDING", sd.PENDING)

        status := sd.cancelAsync()
        utils.evaluateSubValue(status, @"cancelAsync SUCCESS", 0)

        ' tellHandle is itself a blocking command, so a correct answer here also
        ' proves the lock was released.
        position := sd.tellHandle(handle)
        utils.evaluateSubValue(position, @"position moved to contentLen", contentLen)

        ' Explicit recovery from the moved position, then read back the data
        sd.seekHandle(handle, 0)
        bytefill(@asyncBuf, 0, BUF_SIZE)
        bytesRead := sd.readHandle(handle, @asyncBuf, contentLen)
        utils.evaluateSubValue(bytesRead, @"blocking read after cancel", contentLen)

        sd.closeFileHandle(handle)
    else
        utils.evaluateSubBool(false, @"startReadHandle PENDING", true)
        utils.evaluateSubBool(false, @"cancelAsync SUCCESS", true)
        utils.evaluateSubBool(false, @"position moved to contentLen", true)
        utils.evaluateSubBool(false, @"blocking read after cancel", true)
    utils.showSubTestResults()

    utils.checkGuard(@asyncBuf_guard, @"asyncBuf guard")


PRI runTest5_AsyncInterleave() | hMain, hHelper, status, bytesMain, contentLen
' Verify async read on main cog and blocking read on helper cog interleave correctly.
'

    utils.startTest(@"Async + blocking interleave from 2nd cog")
    utils.setCheckCountPerTest(3)

    contentLen := strsize(@asyncContent)
    utils.initGuard(@asyncBuf_guard)

    ' Open two handles - one for main cog async, one for helper cog blocking
    hMain := sd.openFileRead(@asyncTestFile)
    utils.evaluateSubBool(hMain >= 0, @"open handle for main cog", true)

    hHelper := sd.openFileRead(@asyncTestFile)
    utils.evaluateSubBool(hHelper >= 0, @"open handle for helper cog", true)

    if hMain >= 0 and hHelper >= 0
        ' Launch helper cog - it will wait on barrier, then do blocking read
        helper_status := STATUS_RUNNING
        helper_result := 0
        sync_barrier := 0
        helper_cogid := cogspin(NEWCOG, helper_blocking_read(hHelper), @helper_stack)
        if helper_cogid == -1
            ' No cog free: a named failure, not a hang -- the wait below would
            ' spin forever on a status no cog will ever set.
            utils.evaluateSubBool(false, @"both cogs read OK", true)
        else
            ' Start async read on main cog (acquires lock)
            status := sd.startReadHandle(hMain, @asyncBuf, contentLen)

            ' Release helper - it will try blocking read (will spin on locktry)
            sync_barrier := 1

            ' Complete our async op (releases lock - helper can proceed)
            bytesMain := sd.getResult()

            waitHelperDone()

            ' Both operations should succeed
            utils.evaluateSubBool(bytesMain == contentLen and helper_status == STATUS_PASS, @"both cogs read OK", true)

            cogstop(helper_cogid)
            helper_cogid := -1

        sd.closeFileHandle(hMain)
        sd.closeFileHandle(hHelper)
    else
        utils.evaluateSubBool(false, @"both cogs read OK", true)
        if hMain >= 0
            sd.closeFileHandle(hMain)
        if hHelper >= 0
            sd.closeFileHandle(hHelper)
    utils.showSubTestResults()

    utils.checkGuard(@asyncBuf_guard, @"asyncBuf guard")


PRI runTest6_DoubleStartBusy() | handle, status1, status2, contentLen
' Verify a second startReadHandle() without getResult() returns E_ASYNC_BUSY.
'

    utils.startTest(@"Double start returns E_ASYNC_BUSY")
    utils.setCheckCountPerTest(3)

    contentLen := strsize(@asyncContent)

    handle := sd.openFileRead(@asyncTestFile)
    utils.evaluateSubBool(handle >= 0, @"open file", true)
    if handle >= 0
        ' First start - should succeed
        status1 := sd.startReadHandle(handle, @asyncBuf, contentLen)
        utils.evaluateSubValue(status1, @"first start PENDING", sd.PENDING)

        ' Second start without getResult - should fail with E_ASYNC_BUSY
        status2 := sd.startReadHandle(handle, @asyncBuf, contentLen)
        utils.evaluateSubValue(status2, @"second start E_ASYNC_BUSY", sd.E_ASYNC_BUSY)

        ' Clean up: complete the first operation
        sd.getResult()
        sd.closeFileHandle(handle)
    else
        utils.evaluateSubBool(false, @"first start PENDING", true)
        utils.evaluateSubBool(false, @"second start E_ASYNC_BUSY", true)
    utils.showSubTestResults()


PRI runTest7_ForeignCogRejected() | handle, status, bytesMain, contentLen
' Verify an async operation belongs to the cog that started it.
'
' A cog that did not start the operation must not be able to take its result. The
' damaging part is not the stolen byte count -- it is the LOCKREL() at the end of
' getResult()/cancelAsync(), which would release the API lock the OWNING cog still
' holds, handing the driver to whoever grabs it next while the owner believes it has
' exclusive access.
'
' @local handle - Read handle owned by the main cog
' @local status - Start status
' @local bytesMain - Bytes the owning cog eventually collects
' @local contentLen - Length of the known test content

    utils.startTest(@"A second cog cannot collect or cancel another cog's async op")
    utils.setCheckCountPerTest(6)

    contentLen := strsize(@asyncContent)

    handle := sd.openFileRead(@asyncTestFile)
    utils.evaluateSubBool(handle >= 0, @"open file", true)
    if handle >= 0
        helper_status := STATUS_RUNNING
        sync_barrier := 0
        foreign_complete := -99
        foreign_result := 0
        foreign_cancel := 0
        helper_cogid := cogspin(NEWCOG, helper_foreign_collect(), @helper_stack)
        if helper_cogid == -1
            ' No cog free: named failures, not a hang -- the wait below would
            ' spin forever on a status no cog will ever set.
            utils.evaluateSubBool(false, @"owning cog starts the operation", true)
            utils.evaluateSubBool(false, @"foreign isComplete reports FALSE", true)
            utils.evaluateSubBool(false, @"foreign getResult refused", true)
            utils.evaluateSubBool(false, @"foreign cancelAsync refused", true)
            utils.evaluateSubBool(false, @"owning cog still collects its own result", true)
        else
            status := sd.startReadHandle(handle, @asyncBuf, contentLen)
            utils.evaluateSubValue(status, @"owning cog starts the operation", sd.PENDING)

            ' Turn the helper loose while the operation is in flight and OURS.
            sync_barrier := 1
            waitHelperDone()

            ' A cog with no operation of its own has none that is complete.
            utils.evaluateSubValue(foreign_complete, @"foreign isComplete reports FALSE", 0)
            utils.evaluateSubValue(foreign_result, @"foreign getResult refused", sd.E_NO_ASYNC_OP)
            utils.evaluateSubValue(foreign_cancel, @"foreign cancelAsync refused", sd.E_NO_ASYNC_OP)

            ' The decisive check: the operation and the lock are still ours, so our own
            ' collection returns the real data. Had the helper's LOCKREL() gone through,
            ' the lock would be free and this result would be gone.
            bytesMain := sd.getResult()
            utils.evaluateSubValue(bytesMain, @"owning cog still collects its own result", contentLen)

            cogstop(helper_cogid)
            helper_cogid := -1

        sd.closeFileHandle(handle)
    else
        utils.evaluateSubBool(false, @"owning cog starts the operation", true)
        utils.evaluateSubBool(false, @"foreign isComplete reports FALSE", true)
        utils.evaluateSubBool(false, @"foreign getResult refused", true)
        utils.evaluateSubBool(false, @"foreign cancelAsync refused", true)
        utils.evaluateSubBool(false, @"owning cog still collects its own result", true)
    utils.showSubTestResults()


PRI runTest8_SameCogAsyncBusy() | handle, contentLen
' The owning cog's own blocking calls during its in-flight async op must answer
' E_ASYNC_BUSY promptly -- the api_lock is not re-entrant, and before v1.7.0's
' send_command same-cog guard every such call deadlocked silently forever.
' The scenario runs in a helper cog so a regression stays BOUNDED: the main
' cog's 5s waitHelperDone turns a helper deadlock into named check failures
' instead of a silently hung suite.
'
' S8 note: the collect-time worker stack-guard escalation (getResult/cancelAsync
' override to E_STACK_OVERFLOW) is asserted STRUCTURALLY -- the guard-intact
' accessor check below plus code review. Deliberately corrupting the worker
' stack to provoke E_STACK_OVERFLOW is not regression-safe (nothing the worker
' reports afterward can be trusted, including its ability to keep running), so
' no test does it.
'
' @local handle - Read handle the helper cog uses for both async and blocking calls
' @local contentLen - Length of the known test content

    utils.startTest(@"Same-cog blocking calls during own async return E_ASYNC_BUSY")
    utils.setCheckCountPerTest(6)

    contentLen := strsize(@asyncContent)

    handle := sd.openFileRead(@asyncTestFile)
    utils.evaluateSubBool(handle >= 0, @"open file", true)
    if handle >= 0
        helper_status := STATUS_RUNNING
        sync_barrier := 0
        samecog_start := -99
        samecog_read := -99
        samecog_close := -99
        samecog_collect := -99
        helper_cogid := cogspin(NEWCOG, helper_samecog_busy(handle), @helper_stack)
        if helper_cogid == -1
            ' No cog free: named failures, not a hang
            utils.evaluateSubBool(false, @"own async started PENDING", true)
            utils.evaluateSubBool(false, @"readHandle answered E_ASYNC_BUSY (no hang)", true)
            utils.evaluateSubBool(false, @"closeFileHandle answered E_ASYNC_BUSY (no hang)", true)
            utils.evaluateSubBool(false, @"getResult still collects the op", true)
            utils.evaluateSubBool(false, @"worker stack guard intact (S8 structural)", true)
        else
            sync_barrier := 1
            waitHelperDone()

            if helper_status == STATUS_RUNNING
                ' Helper never reported: it is deadlocked INSIDE a driver call
                ' and died owning api_lock -- driver cleanup would hang go()
                cleanup_unsafe := true

            utils.evaluateSubValue(samecog_start, @"own async started PENDING", sd.PENDING)
            utils.evaluateSubValue(samecog_read, @"readHandle answered E_ASYNC_BUSY (no hang)", sd.E_ASYNC_BUSY)
            utils.evaluateSubValue(samecog_close, @"closeFileHandle answered E_ASYNC_BUSY (no hang)", sd.E_ASYNC_BUSY)
            utils.evaluateSubValue(samecog_collect, @"getResult still collects the op", contentLen)
            utils.evaluateSubBool(sd.checkStackGuard(), @"worker stack guard intact (S8 structural)", true)

            cogstop(helper_cogid)
            helper_cogid := -1
        ' On the success path the helper already closed the handle; a repeat
        ' close here would touch a recycled slot. On the timeout path the lock
        ' may still be held -- a close would hang, so it is skipped either way.
    else
        utils.evaluateSubBool(false, @"own async started PENDING", true)
        utils.evaluateSubBool(false, @"readHandle answered E_ASYNC_BUSY (no hang)", true)
        utils.evaluateSubBool(false, @"closeFileHandle answered E_ASYNC_BUSY (no hang)", true)
        utils.evaluateSubBool(false, @"getResult still collects the op", true)
        utils.evaluateSubBool(false, @"worker stack guard intact (S8 structural)", true)
    utils.showSubTestResults()


PRI runTest9_CollectTimeInvalid() | status, result
' Start-time validation is deliberately nil -- an invalid handle is accepted
' at start and the error surfaces at COLLECT time. Assert that contract
' explicitly at both ends.

    utils.startTest(@"Invalid handle surfaces at collect, not start")
    utils.setCheckCountPerTest(3)
    status := sd.startReadHandle(-1, @asyncBuf, 16)
    utils.evaluateSubValue(status, @"start accepts (validation deferred)", sd.PENDING)
    result := sd.getResult()
    utils.evaluateSubValue(result, @"getResult returns E_INVALID_HANDLE", sd.E_INVALID_HANDLE)
    utils.evaluateSubValue(sd.error(), @"error() reports it for this cog", sd.E_INVALID_HANDLE)
    utils.showSubTestResults()

PRI runTest10_InjectedReadFailure() | dataSector, handle, status, result, bytesRead, contentLen
' An armed read failure must come back through getResult() as the negative
' code, land in this cog's error() slot, and clear on retry once disarmed.

    utils.startTest(@"Injected read failure surfaces through getResult")
    utils.setCheckCountPerTest(4)
    contentLen := strsize(@asyncContent)
    dataSector := discoverFileSector(@asyncTestFile, 0)
    handle := sd.openFileRead(@asyncTestFile)
    ' STICKY: the read path runs the real CRC retry loop; a one-shot arm
    ' would fail once and let the retry succeed
    sd.setTestFailSector(dataSector, sd.TF_READ | sd.TF_STICKY)
    sd.setTestInvalidateCaches()                          ' deterministic miss -- armed reads fire only on a miss
    status := sd.startReadHandle(handle, @asyncBuf, contentLen)
    utils.evaluateSubValue(status, @"start PENDING", sd.PENDING)
    ' No isComplete() poll: getResult() blocks until completion itself, and on
    ' a failed start it returns promptly (E_NO_ASYNC_OP) where a poll would
    ' hang the suite forever (see test 3's gate)
    result := sd.getResult()
    ' do_read_h coerces every data-sector read failure to E_IO_ERROR when
    ' nothing moved -- assert the exact code
    utils.evaluateSubValue(result, @"getResult returns E_IO_ERROR", sd.E_IO_ERROR)
    utils.evaluateSubValue(sd.error(), @"error() reports the same code", result)
    sd.clearTestErrors()
    bytesRead := sd.readHandle(handle, @asyncBuf, contentLen)
    utils.evaluateSubValue(bytesRead, @"disarmed retry reads clean", contentLen)
    sd.closeFileHandle(handle)
    utils.showSubTestResults()

PRI runTest11_PartialCount() | secondSector, handle, status, result, herr
' Blocking-API parity: a failure after bytes have moved returns the PARTIAL
' COUNT with ERROR()==SUCCESS, and handleError(handle) holds the reason.

    utils.startTest(@"Partial count at second sector, reason in handleError")
    utils.setCheckCountPerTest(4)
    ' Build a 2-sector file (1024 bytes) -- GATED: on a failed build nothing
    ' gets armed (a sticky arm from a bad probe would poison an unrelated
    ' sector), four named failures instead
    sd.deleteFile(@bigTestFile)
    handle := sd.createFileNew(@bigTestFile)
    if handle >= 0
        bytefill(@asyncBuf, $5A, BUF_SIZE)
        repeat 16
            sd.writeHandle(handle, @asyncBuf, BUF_SIZE)
        sd.closeFileHandle(handle)
        secondSector := discoverFileSector(@bigTestFile, 512)
        handle := sd.openFileRead(@bigTestFile)
        sd.setTestFailSector(secondSector, sd.TF_READ | sd.TF_STICKY)
        sd.setTestInvalidateCaches()
        utils.initGuard(@bigBuf_guard)
        status := sd.startReadHandle(handle, @bigBuf, 1024)
        utils.evaluateSubValue(status, @"start PENDING", sd.PENDING)
        result := sd.getResult()                        ' blocks until complete (see test 10 note)
        utils.evaluateSubValue(result, @"short count 512", 512)
        utils.evaluateSubValue(sd.error(), @"ERROR() SUCCESS on a partial (parity)", 0)
        herr := sd.handleError(handle)
        utils.evaluateSubBool(herr < 0, @"handleError holds the reason", true)
        utils.checkGuard(@bigBuf_guard, @"bigBuf guard")
        sd.clearTestErrors()
        sd.closeFileHandle(handle)
    else
        utils.evaluateSubBool(false, @"start PENDING", true)
        utils.evaluateSubBool(false, @"short count 512", true)
        utils.evaluateSubBool(false, @"ERROR() SUCCESS on a partial (parity)", true)
        utils.evaluateSubBool(false, @"handleError holds the reason", true)
    sd.deleteFile(@bigTestFile)
    utils.showSubTestResults()

PRI runTest12_AsyncWriteAppend() | handle, status, bytesWritten, bytesRead, contentLen, matched, idx
' Second startWriteHandle exercise suite-wide: append asynchronously, then
' verify BOTH halves of the file with a blocking read-back.

    utils.startTest(@"Async append verified by blocking read-back")
    utils.setCheckCountPerTest(3)
    contentLen := strsize(@asyncContent)
    createTestFile()                                    ' fresh single-copy content
    handle := sd.openFileWrite(@asyncTestFile)          ' position lands at EOF
    if handle >= 0
        status := sd.startWriteHandle(handle, @asyncContent, contentLen)
        utils.evaluateSubValue(status, @"start PENDING", sd.PENDING)
        bytesWritten := (status == sd.PENDING) ? sd.getResult() : -1
        utils.evaluateSubValue(bytesWritten, @"async append full count", contentLen)
        sd.closeFileHandle(handle)
    else
        utils.evaluateSubBool(false, @"start PENDING", true)
        utils.evaluateSubBool(false, @"async append full count", true)
    handle := sd.openFileRead(@asyncTestFile)
    matched := false
    if handle >= 0
        bytesRead := sd.readHandle(handle, @bigBuf, contentLen * 2)
        matched := (bytesRead == contentLen * 2)
        repeat idx from 0 to contentLen - 1
            if bigBuf[idx] <> BYTE[@asyncContent][idx] OR bigBuf[contentLen + idx] <> BYTE[@asyncContent][idx]
                matched := false
                quit
        sd.closeFileHandle(handle)
    utils.evaluateSubBool(matched, @"both halves verified", true)
    utils.showSubTestResults()
    createTestFile()                                    ' restore the single-copy seed

PRI runTest13_ErrorAfterStart() | handle, status, result, contentLen
' The documented start-vs-collect contract: a successful START records
' SUCCESS in error(); the operation's own outcome is recorded at collect.

    utils.startTest(@"error() is SUCCESS immediately after a good start")
    utils.setCheckCountPerTest(3)
    contentLen := strsize(@asyncContent)
    handle := sd.openFileRead(@asyncTestFile)
    status := sd.startReadHandle(handle, @asyncBuf, contentLen)
    utils.evaluateSubValue(status, @"start PENDING", sd.PENDING)
    utils.evaluateSubValue(sd.error(), @"error() SUCCESS after start", 0)
    result := sd.getResult()
    utils.evaluateSubValue(result, @"collect returns the count", contentLen)
    sd.closeFileHandle(handle)
    utils.showSubTestResults()

PRI discoverFileSector(pName, fileOffset) : sector | handle
' Find the LBA of the data sector holding a given offset of a file.
' No accessor reports where a file's data lives, so this measures it: read
' that offset on a healthy card, then ask the read diagnostic which sector
' the read just touched. The cache invalidate makes the probe a genuine card
' access rather than a cache hit -- same guarantee as error_injection's
' remount idiom without the 400 kHz re-init; the fresh handle covers the
' per-handle buffer.
'
' @param pName - Pointer to filename
' @param fileOffset - Byte offset within the file
' @returns sector - LBA of the sector containing that offset

    sd.setTestInvalidateCaches()
    handle := sd.openFileRead(pName)
    if fileOffset > 0
        sd.seekHandle(handle, fileOffset)
    sd.readHandle(handle, @blockBuf, BUF_SIZE)
    sd.debugGetReadSectorDiag(@diagLastSector, @diagScratch[0], @diagScratch[1], @diagScratch[2], @diagScratch[3], @diagScratch[4], @diagScratch[5], @diagScratch[6])
    sector := diagLastSector
    sd.closeFileHandle(handle)

PRI waitHelperDone()
' Bounded wait for the helper cog to report. A helper that never reports
' (launch raced, driver hang) makes this return after ~5s instead of hanging
' the suite; the caller's checks against helper_status / the foreign_* slots
' then fail by name, and the caller's unconditional cogstop reaps the cog.

    repeat HELPER_TIMEOUT_POLLS
        if helper_status <> STATUS_RUNNING
            return
        waitms(10)
    debug("  *** waitHelperDone TIMEOUT (5s): helper cog never reported ***")

' ═══════════════════════════════════════════════════════════════════════════
' HELPER COG METHODS
' ═══════════════════════════════════════════════════════════════════════════

PRI helper_foreign_collect()
' Helper cog entry point: reach for an async operation this cog did not start.
' Records what each call handed back; all three must refuse.
'

    repeat until sync_barrier <> 0

    foreign_complete := sd.isComplete() ? 1 : 0
    foreign_result := sd.getResult()
    foreign_cancel := sd.cancelAsync()
    helper_status := STATUS_PASS

PRI helper_samecog_busy(handle) | contentLen
' Helper cog entry point: start an async read, then -- while it is in flight or
' uncollected -- call blocking APIs from THIS SAME COG. Each must answer
' E_ASYNC_BUSY promptly (the api_lock this cog already holds is not re-entrant),
' and getResult afterward must still collect the undisturbed operation.
'
' @param handle - open read handle used for the async op and the blocking calls
'

    repeat until sync_barrier <> 0

    contentLen := strsize(@asyncContent)
    samecog_start := sd.startReadHandle(handle, @asyncBuf, contentLen)
    samecog_read := sd.readHandle(handle, @blockBuf, contentLen)       ' must answer, never hang
    samecog_close := sd.closeFileHandle(handle)                        ' must answer, never hang
    samecog_collect := sd.getResult()                                  ' guard must not disturb the op
    sd.closeFileHandle(handle)                                         ' real close now succeeds
    helper_status := STATUS_PASS

PRI helper_blocking_read(handle) | bytesRead, contentLen
' Helper cog entry point: wait for barrier, then do a blocking read.
' The main cog holds the api_lock via async -- this cog will spin
' on locktry until main calls getResult().
'
' @param handle - open read handle to use
'

    repeat until sync_barrier <> 0

    contentLen := strsize(@asyncContent)
    bytesRead := sd.readHandle(handle, @blockBuf, contentLen)

    if bytesRead == contentLen
        helper_status := STATUS_PASS
    else
        helper_status := STATUS_FAIL
    helper_result := bytesRead


' ═══════════════════════════════════════════════════════════════════════════
' HELPER METHODS
' ═══════════════════════════════════════════════════════════════════════════

PRI createTestFile() : bOk | handle, expected
' Create (or recreate) the test file with known content for async tests.
'
' @returns bOk - TRUE only when the file was created, fully written, and closed
'
' Every test in this suite reads or rewrites this file, so the caller gates on
' the result -- an unreported seed failure here would fan into all 7 tests.

    bOk := false
    sd.deleteFile(@asyncTestFile)
    handle := sd.createFileNew(@asyncTestFile)
    if handle >= 0
        expected := strsize(@asyncContent)
        bOk := (sd.writeHandle(handle, @asyncContent, expected) == expected)
        if sd.closeFileHandle(handle) < 0
            bOk := false
        debug("  Created test file: ", zstr_(@asyncTestFile))
    ifnot bOk
        debug("  FAILED to create test file!")

