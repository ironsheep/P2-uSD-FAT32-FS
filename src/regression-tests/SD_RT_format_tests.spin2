'' =================================================================================================
''
''   File....... SD_RT_format_tests.spin2
''   Purpose.... Regression tests for SD card FAT32 formatter - Cross-OS Compatibility
''   Author..... Stephen M Moraco
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... JAN 2026
''   Updated.... 16 JAN 2026
''
'' =================================================================================================
''
''  This test formats a blank SD card and verifies the FAT32 structure is correct for
''  cross-OS compatibility (Windows, macOS, Linux).
''
''  REQUIREMENTS:
''    - A BLANK SD card (all data will be erased!)
''    - Card must be at least 64MB for FAT32
''
''  WARNING: This test ERASES ALL DATA on the card!
''
'' =================================================================================================

CON

    _CLKFREQ        = 350_000_000

    ' SD card pin assignments
    ' Default: P2 Edge module SD slot. Build with -D SD_PINS_EXTERNAL
    ' to use the external SD header (base pin 16).
#ifdef SD_PINS_EXTERNAL
    SD_CS   = 20
    SD_MOSI = 19
    SD_MISO = 18
    SD_SCK  = 21
#else
    SD_CS   = 60
    SD_MOSI = 59
    SD_MISO = 58
    SD_SCK  = 61
#endif
    ' Expected FAT32 constants
    FSINFO_TRAIL_SIG    = $AA550000  ' Trail signature (stored little-endian)
    FAT32_MEDIA_TYPE    = $F8        ' Fixed disk
    EXT_BOOT_SIG        = $29        ' Extended boot signature
    PARTITION_START     = 8192       ' 4MB alignment

    ' FAT32 requires a 64 MB minimum, and the partition starts 4 MB in, so the
    ' card must be comfortably larger than PARTITION_START. Asserted at run time
    ' rather than left to the file header as an unchecked instruction.
    MIN_CARD_SECTORS    = 131_072    ' 64 MB

' Enable full driver features for format testing
' Uncomment SD_INCLUDE_STACK_CHECK to measure worker cog stack depth
#ifdef __SPINTOOLS__
#define SD_INCLUDE_ALL
#elseifdef __FLEXSPIN__
#define SD_INCLUDE_ALL
#pragma exportdef SD_INCLUDE_ALL
#else
#pragma exportdef SD_INCLUDE_ALL
#define SD_INCLUDE_STACK_CHECK
#pragma exportdef SD_INCLUDE_STACK_CHECK
#endif

OBJ

    utils : "isp_rt_utilities"
    fmt   : "isp_format_utility"
    sd    : "micro_sd_fat32_fs"

VAR

    BYTE    buf[sd.SECTOR_SIZE]
    BYTE    buf_guard[16]
    BYTE    buf2[sd.SECTOR_SIZE]
    BYTE    buf2_guard[16]
    LONG    sectorsPerFat
    LONG    totalSectors
    LONG    partitionStart

PUB go() | result, dataStart, fat1Start, fat2Start, idx, mismatch, cardSectors
'' Main entry point for FAT32 format regression tests
''
'' WARNING: This test ERASES ALL DATA on the card!
'' Tests FAT32 formatting and cross-OS compatibility verification

    debug("==============================================")
    debug("  SD_RT_format_tests - FAT32 Format Tests")
    debug("  (Cross-OS Compatibility Verification)")
    debug("==============================================")
    debug(" ")
    debug("WARNING: This test will ERASE ALL DATA on the card!")
    debug(" ")

    ' ----------------------------------------
    ' PRE-FLIGHT: measure the card BEFORE erasing it
    ' ----------------------------------------
    ' This gate used to sit AFTER fmt.format(). On a card below the FAT32 minimum
    ' that meant erasing every byte on it and THEN declining to verify -- paying the
    ' card's entire contents to reach a check that was always going to stop the run.
    ' Nothing destructive may happen above this point.
    utils.startTestGroup(@"Pre-Flight (before anything is erased)")

    result := sd.initCardOnly(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    ifnot utils.requireSetup(result == 0, @"SETUP: initialize SD card for size pre-flight")
        debug("ERROR: Cannot initialize card! Nothing was erased.")
        utils.ShowTestEndCounts()
        debug("END_SESSION")
        return

    cardSectors := sd.cardSizeSectors()
    debug("  Card size: ", udec(cardSectors), " sectors (", udec(cardSectors / 2048), " MB)")

    utils.startTest(@"Card meets FAT32 64MB minimum")
    utils.evaluateBool(cardSectors >= MIN_CARD_SECTORS, @"card >= 64MB", true)
    if cardSectors < MIN_CARD_SECTORS
        debug("  *** SETUP NOT MET: card has ", udec_(cardSectors), " sectors, FAT32 needs >= ", udec_(MIN_CARD_SECTORS), " -- NOTHING WAS ERASED, format checks NOT run ***")
        sd.stop()
        utils.ShowTestEndCounts()
        debug("END_SESSION")
        return

    ' Release the raw-access worker so the format utility can own the pins
    sd.stop()

    ' ----------------------------------------
    ' TEST 1: Format card with default label  (DESTRUCTIVE FROM HERE)
    ' ----------------------------------------
    utils.startTestGroup(@"Format Operation")
    utils.startTest(@"Format card with default label")

    result := fmt.format(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    utils.evaluateBool(result, @"format() returns true", true)

    ' Release format utility's worker cog before using sd driver for verification
    fmt.stop()

    ' Re-initialize card for raw-access verification of what the format wrote
    result := sd.initCardOnly(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    ifnot utils.requireSetup(result == 0, @"SETUP: re-initialize SD card for verification")
        debug("ERROR: Cannot initialize card for verification!")
        utils.ShowTestEndCounts()
        debug("END_SESSION")
        return

    ' ========================================
    ' MBR VERIFICATION (Sector 0)
    ' ========================================
    utils.startTestGroup(@"MBR Verification")

    utils.startTest(@"Read MBR (sector 0)")
    utils.evaluateBool(readVerifySector(0, @buf, @buf_guard), @"readSectorRaw(MBR)", true)

    utils.startTest(@"MBR boot signature")
    result := WORD[@buf + sd.BOOT_SIG_OFFSET]
    utils.evaluateBool(result == sd.BOOT_SIGNATURE, @"$AA55 at offset $1FE", true)

    utils.startTest(@"Partition 1 bootable flag")
    result := buf[sd.MBR_PARTITION_OFFSET]
    utils.evaluateBool(result == $00 OR result == $80, @"$00 or $80", true)

    utils.startTest(@"Partition 1 type")
    result := buf[sd.MBR_PART_TYPE_OFFSET]
    utils.evaluateBool(result == sd.PART_TYPE_FAT32_LBA, @"$0C (FAT32 LBA)", true)

    utils.startTest(@"Partition 1 start sector")
    partitionStart := LONG[@buf + sd.MBR_PART_LBA_OFFSET]
    utils.evaluateBool(partitionStart == PARTITION_START, @"8192 (4MB aligned)", true)

    ' Everything downstream -- the VBR, both FSInfo copies, both FAT copies and the
    ' root directory -- is addressed relative to partitionStart. A garbage value here
    ' does not produce one failure, it produces a dozen reads of unrelated sectors
    ' whose content checks all fail for reasons that have nothing to do with the
    ' format. Stop at the one real failure and say what is being skipped.
    ifnot utils.requireSetup(partitionStart > 0 and partitionStart < cardSectors, @"SETUP: partition start LBA is usable")
        debug("  *** partitionStart = ", udec_(partitionStart), " is not a sector on this card")
        debug("  *** VBR / FSInfo / FAT / root-directory checks SKIPPED (all derive from it)")
        sd.stop()
        utils.ShowTestEndCounts()
        debug("END_SESSION")
        return

    utils.startTest(@"Partition 1 size")
    result := LONG[@buf + sd.MBR_PART_SIZE_OFFSET]
    ' Partition size should be card size minus partition start
    utils.evaluateBool(result > 0, @"Size > 0", true)
    debug("  Partition size: ", udec(result), " sectors")

    ' ========================================
    ' VBR VERIFICATION (Primary Boot Sector)
    ' ========================================
    utils.startTestGroup(@"VBR Verification")

    utils.startTest(@"Read VBR (partition start)")
    utils.evaluateBool(readVerifySector(partitionStart, @buf, @buf_guard), @"readSectorRaw(VBR)", true)

    utils.startTest(@"VBR jump instruction")
    ' EXPECTED VALUE: FAT VBR must start with JMP SHORT ($EB) or JMP FAR ($E9) boot jump instruction
    result := buf[0]
    utils.evaluateBool(result == $EB OR result == $E9, @"Jump ($EB or $E9)", true)

    utils.startTest(@"VBR boot signature")
    result := WORD[@buf + sd.BOOT_SIG_OFFSET]
    utils.evaluateBool(result == sd.BOOT_SIGNATURE, @"$AA55 at offset $1FE", true)

    utils.startTest(@"OEM name present")
    ' OEM name at offset $03, should be printable ASCII
    result := buf[$03]
    utils.evaluateBool(result >= $20 AND result <= $7E, @"Printable OEM name", true)
    debug("  OEM name: ", lstr_(@buf + $03, 8))

    utils.startTest(@"Bytes per sector")
    result := WORD[@buf + $0B]
    utils.evaluateBool(result == sd.SECTOR_SIZE, @"512 bytes/sector", true)

    utils.startTest(@"Sectors per cluster")
    result := buf[$0D]
    ' Must be power of 2: 1, 2, 4, 8, 16, 32, 64, 128
    utils.evaluateBool(result >= 1 AND result <= 128 AND (result & (result - 1)) == 0, @"Power of 2", true)
    debug("  Sectors per cluster: ", udec(result))

    utils.startTest(@"Reserved sectors")
    result := WORD[@buf + $0E]
    utils.evaluateBool(result == 32, @"32 reserved sectors", true)

    utils.startTest(@"Number of FATs")
    result := buf[$10]
    utils.evaluateBool(result == 2, @"2 FATs", true)

    utils.startTest(@"Root entry count (must be 0 for FAT32)")
    result := WORD[@buf + $11]
    utils.evaluateBool(result == 0, @"0 (FAT32 requirement)", true)

    utils.startTest(@"Total sectors 16-bit (must be 0 for FAT32)")
    result := WORD[@buf + $13]
    utils.evaluateBool(result == 0, @"0 (FAT32 uses 32-bit)", true)

    utils.startTest(@"Media type")
    result := buf[$15]
    utils.evaluateBool(result == FAT32_MEDIA_TYPE, @"$F8 (fixed disk)", true)

    utils.startTest(@"FAT size 16-bit (must be 0 for FAT32)")
    result := WORD[@buf + $16]
    utils.evaluateBool(result == 0, @"0 (FAT32 uses 32-bit)", true)

    utils.startTest(@"Hidden sectors match partition start")
    result := LONG[@buf + $1C]
    utils.evaluateBool(result == partitionStart, @"Matches partition start", true)

    utils.startTest(@"Total sectors 32-bit")
    totalSectors := LONG[@buf + $20]
    utils.evaluateBool(totalSectors > 0, @"Total sectors > 0", true)
    debug("  Total sectors: ", udec(totalSectors))

    utils.startTest(@"FAT32 sectors per FAT")
    sectorsPerFat := LONG[@buf + $24]
    utils.evaluateBool(sectorsPerFat > 0, @"Sectors per FAT > 0", true)
    debug("  Sectors per FAT: ", udec(sectorsPerFat))

    ' fat2Start and dataStart are both computed from this. A wild value sends the
    ' FAT-mirror and root-directory reads off to arbitrary sectors -- same cascade
    ' as a bad partitionStart, same treatment.
    ifnot utils.requireSetup(sectorsPerFat > 0 and (partitionStart + 32 + 2 * sectorsPerFat) < cardSectors, @"SETUP: sectors-per-FAT yields usable FAT/data LBAs")
        debug("  *** sectorsPerFat = ", udec_(sectorsPerFat), " puts the data region off the end of the card")
        debug("  *** FAT-table and root-directory checks SKIPPED (both derive from it)")
        sd.stop()
        utils.ShowTestEndCounts()
        debug("END_SESSION")
        return

    utils.startTest(@"Root cluster number")
    result := LONG[@buf + $2C]
    utils.evaluateBool(result == 2, @"Root cluster = 2", true)

    utils.startTest(@"FSInfo sector location")
    result := WORD[@buf + $30]
    utils.evaluateBool(result == 1, @"FSInfo at sector 1", true)

    utils.startTest(@"Backup boot sector location")
    result := WORD[@buf + $32]
    utils.evaluateBool(result == 6, @"Backup at sector 6", true)

    utils.startTest(@"Extended boot signature")
    result := buf[$42]
    utils.evaluateBool(result == EXT_BOOT_SIG, @"$29", true)

    utils.startTest(@"File system type string")
    ' At offset $52, should be "FAT32   " (8 bytes)
    result := true
    if buf[$52] <> "F" OR buf[$53] <> "A" OR buf[$54] <> "T" OR buf[$55] <> "3" OR buf[$56] <> "2"
        result := false
    utils.evaluateBool(result, @"FAT32 string at $52", true)
    debug("  FS Type: ", lstr_(@buf + $52, 8))

    ' ========================================
    ' BACKUP VBR VERIFICATION
    ' ========================================
    utils.startTestGroup(@"Backup VBR Verification")

    utils.startTest(@"Backup VBR matches primary")
    ' Read backup boot sector at partition + 6
    utils.startTest(@"Read backup VBR (partition start + 6)")
    utils.evaluateBool(readVerifySector(partitionStart + 6, @buf2, @buf2_guard), @"readSectorRaw(backup VBR)", true)

    ' Compare the two boot sectors
    mismatch := false
    repeat idx from 0 to 511
        if buf[idx] <> buf2[idx]
            mismatch := true
            debug("  Mismatch at offset ", udec(idx), ": $", uhex_(buf[idx]), " vs $", uhex_(buf2[idx]))
            quit
    utils.evaluateBool(mismatch == false, @"Primary and backup match", true)

    ' ========================================
    ' FSINFO VERIFICATION
    ' ========================================
    utils.startTestGroup(@"FSInfo Verification")

    utils.startTest(@"Read FSInfo (partition start + 1)")
    utils.evaluateBool(readVerifySector(partitionStart + 1, @buf, @buf_guard), @"readSectorRaw(FSInfo)", true)

    utils.startTest(@"FSInfo lead signature")
    result := LONG[@buf + 0]
    utils.evaluateBool(result == sd.FSINFO_LEAD_SIG, @"$41615252 (RRaA)", true)

    utils.startTest(@"FSInfo structure signature")
    result := LONG[@buf + 484]
    utils.evaluateBool(result == sd.FSINFO_STRUCT_SIG, @"$61417272 (rrAa)", true)

    utils.startTest(@"FSInfo trail signature")
    result := LONG[@buf + $1FC]
    utils.evaluateBool(result == FSINFO_TRAIL_SIG, @"$AA550000 at $1FC", true)

    utils.startTest(@"FSInfo free cluster count")
    result := LONG[@buf + 488]
    ' Can be $FFFFFFFF (unknown) or actual count
    utils.evaluateBool(result <> 0, @"Free count set", true)
    debug("  Free clusters: ", udec(result))

    utils.startTest(@"FSInfo next free cluster hint")
    result := LONG[@buf + 492]
    ' Should be 3 (first free after root) or $FFFFFFFF (unknown)
    utils.evaluateBool(result == 3 OR result == $FFFFFFFF, @"Next free = 3 or unknown", true)
    debug("  Next free hint: ", udec(result))

    utils.startTest(@"Backup FSInfo matches primary")
    utils.startTest(@"Read backup FSInfo (partition start + 7)")
    utils.evaluateBool(readVerifySector(partitionStart + 7, @buf2, @buf2_guard), @"readSectorRaw(backup FSInfo)", true)
    mismatch := false
    repeat idx from 0 to 511
        if buf[idx] <> buf2[idx]
            mismatch := true
            quit
    utils.evaluateBool(mismatch == false, @"Primary and backup FSInfo match", true)

    ' ========================================
    ' FAT TABLE VERIFICATION
    ' ========================================
    utils.startTestGroup(@"FAT Table Verification")

    fat1Start := partitionStart + 32
    fat2Start := fat1Start + sectorsPerFat

    ' Read FAT1 first sector for multiple tests
    utils.startTest(@"Read FAT1 first sector")
    utils.evaluateBool(readVerifySector(fat1Start, @buf, @buf_guard), @"readSectorRaw(FAT1)", true)

    utils.startTest(@"FAT[0] media type entry")
    result := LONG[@buf + 0]
    utils.evaluateBool(result == $0FFFFFF8, @"FAT[0] = $0FFFFFF8", true)

    utils.startTest(@"FAT[1] end of chain marker")
    result := LONG[@buf + 4]
    utils.evaluateBool(result == $0FFFFFFF, @"FAT[1] = $0FFFFFFF (EOC)", true)

    utils.startTest(@"FAT[2] root directory EOC")
    result := LONG[@buf + 8]
    utils.evaluateBool(result == $0FFFFFFF, @"FAT[2] = $0FFFFFFF (root EOC)", true)

    utils.startTest(@"FAT[3] first free cluster")
    result := LONG[@buf + 12]
    utils.evaluateBool(result == 0, @"FAT[3] = 0 (free)", true)

    utils.startTest(@"FAT2 mirrors FAT1 (first sector)")
    utils.evaluateBool(readVerifySector(fat2Start, @buf2, @buf2_guard), @"readSectorRaw(FAT2)", true)
    mismatch := false
    repeat idx from 0 to 511
        if buf[idx] <> buf2[idx]
            mismatch := true
            debug("  FAT mismatch at offset ", udec(idx))
            quit
    utils.evaluateBool(mismatch == false, @"FAT1 and FAT2 identical", true)

    utils.startTest(@"FAT1 second sector is zeroed")
    utils.evaluateBool(readVerifySector(fat1Start + 1, @buf, @buf_guard), @"readSectorRaw(FAT1 sector 2)", true)
    mismatch := false
    repeat idx from 0 to 511
        if buf[idx] <> 0
            mismatch := true
            quit
    utils.evaluateBool(mismatch == false, @"All zeros", true)

    utils.startTest(@"FAT2 second sector is zeroed")
    utils.evaluateBool(readVerifySector(fat2Start + 1, @buf, @buf_guard), @"readSectorRaw(FAT2 sector 2)", true)
    mismatch := false
    repeat idx from 0 to 511
        if buf[idx] <> 0
            mismatch := true
            quit
    utils.evaluateBool(mismatch == false, @"All zeros", true)

    ' ========================================
    ' ROOT DIRECTORY VERIFICATION
    ' ========================================
    utils.startTestGroup(@"Root Directory Verification")

    dataStart := partitionStart + 32 + 2 * sectorsPerFat
    debug("  Data region starts at sector ", udec(dataStart))

    utils.startTest(@"Read root directory first sector")
    utils.evaluateBool(readVerifySector(dataStart, @buf, @buf_guard), @"readSectorRaw(root dir)", true)

    utils.startTest(@"Volume label entry present")
    ' First entry should be volume label
    result := buf[$0B]
    utils.evaluateBool(result == $08, @"Attr = $08 (volume label)", true)

    utils.startTest(@"Volume label name")
    debug("  Volume label: ", lstr_(@buf, 11))
    ' Check first char is printable
    result := buf[0]
    utils.evaluateBool(result >= $20 AND result <= $7E, @"Valid label chars", true)

    utils.startTest(@"Second entry is end marker or empty")
    result := buf[$20]
    ' Should be $00 (end) or another valid entry
    utils.evaluateBool(result == $00 OR result == sd.DIR_ENTRY_DELETED OR (result >= $20 AND result <= $7E), @"Valid second entry", true)

    utils.startTest(@"Rest of root cluster is zeroed")
    mismatch := false
    repeat idx from $40 to 511  ' Start after possible 2nd entry
        if buf[idx] <> 0
            mismatch := true
            quit
    utils.evaluateBool(mismatch == false, @"Remaining bytes zero", true)

    ' ========================================
    ' MOUNT AND USABILITY TEST
    ' ========================================
    utils.startTestGroup(@"Mount and Usability")

    utils.startTest(@"Mount formatted card")
    result := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    utils.evaluateSingleValue(result, @"mount() succeeds", sd.SUCCESS)

    utils.startTest(@"Read volume label")
    debug("  Mounted volume: ", zstr_(sd.volumeLabel()))
    result := sd.volumeLabel()
    utils.evaluateBool(result <> 0, @"Label pointer valid", true)

    utils.startTest(@"Check free space reported")
    result := sd.freeSpace()
    utils.evaluateBool(result > 0, @"Free space > 0", true)
    debug("  Free space: ", udec(result), " sectors")

    ' Report stack depth while worker cog is still running
#ifdef SD_INCLUDE_STACK_CHECK
    debug(" ")
    debug("* Worker cog stack: ", udec_(sd.reportStackDepth()), " of ", udec_(sd.STACK_SIZE), " longs used")
#endif

    sd.unmount()

    ' ----------------------------------------
    ' Summary
    ' ----------------------------------------
    utils.ShowTestEndCounts()

    debug(" ")
    debug("END_SESSION")

PRI readVerifySector(lba, pBuf, pGuard) : bOk
' Read one sector for structural verification, poisoning the buffer first.
'
' @param lba - absolute sector to read
' @param pBuf - 512-byte destination buffer
' @param pGuard - that buffer's 16-byte guard zone
' @returns bOk - TRUE only when readSectorRaw reported SUCCESS
'
' The poison fill is the point. These checks run back to back through the same two
' buffers, so a FAILED read used to leave the PREVIOUS sector's contents in place
' and let the next content check pass on them. The concrete case: "FAT2 second
' sector is zeroed" read into the buffer the "FAT1 second sector is zeroed" check
' had just filled with zeros, so a FAT2 read that never happened passed. $A5 is
' chosen because it matches nothing this suite looks for -- not zero, not $AA55,
' not $0FFFFFF8.

    bytefill(pBuf, $A5, sd.SECTOR_SIZE)
    utils.initGuard(pGuard)
    bOk := (sd.readSectorRaw(lba, pBuf) == sd.SUCCESS)
    utils.checkGuard(pGuard, @"sector buffer guard")

con { license }

