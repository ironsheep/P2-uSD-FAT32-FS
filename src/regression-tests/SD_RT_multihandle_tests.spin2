'' =================================================================================================
''
''   File....... SD_RT_multihandle_tests.spin2
''   Purpose.... This object tests multi-file handle functionality
''   Author..... Stephen M Moraco
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... JAN 2026
''   Updated.... 12 AUG 2026
''
'' =================================================================================================
''
'' Tests the handle-based file API:
''   - Multiple simultaneous file opens
''   - Per-handle independent positions
''   - Single-writer policy enforcement
''   - Handle allocation and release
''   - Data persistence through write/close/reopen/read cycle
''   - Sync operations
''
'' =================================================================================================

CON

     _CLKFREQ        = 350_000_000

     ' SD card pin assignments
     ' Default: P2 Edge module SD slot. Build with -D SD_PINS_EXTERNAL
     ' to use the external SD header (base pin 16).
#ifdef SD_PINS_EXTERNAL
     SD_CS   = 20
     SD_MOSI = 19
     SD_MISO = 18
     SD_SCK  = 21
#else
     SD_CS   = 60
     SD_MOSI = 59
     SD_MISO = 58
     SD_SCK  = 61
#endif
OBJ
    sd    : "micro_sd_fat32_fs"
    utils : "isp_rt_utilities"

DAT

' Test filenames - unique names for multi-handle tests
testfile1       BYTE    "MHTEST1.TXT", 0
testfile2       BYTE    "MHTEST2.TXT", 0
testfile3       BYTE    "MHTEST3.TXT", 0
testfile4       BYTE    "MHTEST4.TXT", 0
testfile5       BYTE    "MHTEST5.TXT", 0      ' Fifth file for overflow test

' Test content - unique for each file
content1        BYTE    "Content for file ONE - first test file", 0
content2        BYTE    "Content for file TWO - second test file", 0
content3        BYTE    "Content for file THREE - third test file", 0
content4        BYTE    "Content for file FOUR - fourth test file", 0

' Buffer for read operations
readBuffer      BYTE    0[256]
readBuffer_guard BYTE   0[16]

' Cross-handle cache-coherence test: file + full-sector source buffer
cohFile         BYTE    "MHCOHER.TXT", 0
cohBuffer       BYTE    0[512]

PUB go() | result, handle, h1, h2, h3, h4, h5, h6, hDir, hDir2, bytesRead, bytesWritten, size, nonce
'' Main entry point for multi-handle regression tests
''
'' Tests handle-based file API with multiple simultaneous file handles

    debug(" ")
    debug("==============================================")
    debug("  SD Card Driver - Multi-Handle Tests")
    debug("==============================================")

    ' Mount the card first
    result := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    ifnot utils.requireSetup(result == 0, @"SETUP: mount SD card")
        debug("ERROR: Could not mount SD card!")
        utils.ShowTestEndCounts()
        debug("END_SESSION")
        return

    ' Show card info
    debug(" ")
    debug("* SD Card Information:")
    debug("   Volume Label: ", zstr_(sd.volumeLabel()))
    debug("   Free Space: ", udec(sd.freeSpace()), " sectors")

    ' Clean up any existing test files
    cleanupTestFiles()

    ' Create test files with known content. Gated: one named, scored setup
    ' failure instead of fanning into most of the suite's open/read tests.
    ifnot utils.requireSetup(createTestFiles(), @"SETUP: create multihandle test files")
        cleanupTestFiles()
        sd.unmount()
        utils.ShowTestEndCounts()
        debug("END_SESSION")
        return

    ' ======================================================================
    ' TEST GROUP: Multiple Read Handles
    ' ======================================================================
    utils.startTestGroup(@"Multiple Read Handles")

    ' Test: Open 4 files for read, get unique handles
    utils.startTest(@"Open 4 files for read returns unique handles 0-3")
    h1 := sd.openFileRead(@testfile1)
    h2 := sd.openFileRead(@testfile2)
    h3 := sd.openFileRead(@testfile3)
    h4 := sd.openFileRead(@testfile4)

    utils.evaluateSubBool(h1 >= 0, @"Handle 1 valid", true)
    utils.evaluateSubBool(h2 >= 0, @"Handle 2 valid", true)
    utils.evaluateSubBool(h3 >= 0, @"Handle 3 valid", true)
    utils.evaluateSubBool(h4 >= 0, @"Handle 4 valid", true)
    utils.evaluateSubBool(h1 <> h2 and h2 <> h3 and h3 <> h4, @"All handles unique", true)

    ' Test: Read from all 4 files, verify correct data
    utils.startTest(@"Read from 4 handles returns correct data")
    utils.setCheckCountPerTest(4)

    bytefill(@readBuffer, 0, 256)
    utils.initGuard(@readBuffer_guard)
    bytesRead := sd.readHandle(h1, @readBuffer, strsize(@content1))
    utils.checkGuard(@readBuffer_guard, @"readBuffer guard")
    utils.evaluateSubBool(strcomp(@readBuffer, @content1), @"Handle 1 content", true)

    bytefill(@readBuffer, 0, 256)
    utils.initGuard(@readBuffer_guard)
    bytesRead := sd.readHandle(h2, @readBuffer, strsize(@content2))
    utils.checkGuard(@readBuffer_guard, @"readBuffer guard")
    utils.evaluateSubBool(strcomp(@readBuffer, @content2), @"Handle 2 content", true)

    bytefill(@readBuffer, 0, 256)
    utils.initGuard(@readBuffer_guard)
    bytesRead := sd.readHandle(h3, @readBuffer, strsize(@content3))
    utils.checkGuard(@readBuffer_guard, @"readBuffer guard")
    utils.evaluateSubBool(strcomp(@readBuffer, @content3), @"Handle 3 content", true)

    bytefill(@readBuffer, 0, 256)
    utils.initGuard(@readBuffer_guard)
    bytesRead := sd.readHandle(h4, @readBuffer, strsize(@content4))
    utils.checkGuard(@readBuffer_guard, @"readBuffer guard")
    utils.evaluateSubBool(strcomp(@readBuffer, @content4), @"Handle 4 content", true)
    utils.setCheckCountPerTest(1)

    ' Close all handles
    sd.closeFileHandle(h1)
    sd.closeFileHandle(h2)
    sd.closeFileHandle(h3)
    sd.closeFileHandle(h4)

    ' ======================================================================
    ' TEST GROUP: Independent Positions
    ' ======================================================================
    utils.startTestGroup(@"Independent Handle Positions")

    ' Test: Same file, two read handles, independent positions
    utils.startTest(@"Same file on 2 handles have independent positions")
    h1 := sd.openFileRead(@testfile1)
    h2 := sd.openFileRead(@testfile1)

    utils.evaluateSubBool(h1 >= 0, @"First handle valid", true)
    utils.evaluateSubBool(h2 >= 0, @"Second handle valid", true)
    utils.evaluateSubBool(h1 <> h2, @"Handles are different", true)

    ' Seek handle 1 to position 12 ("file ONE" starts there)
    sd.seekHandle(h1, 12)

    ' Read from both - should get different data
    bytefill(@readBuffer, 0, 256)
    utils.initGuard(@readBuffer_guard)
    bytesRead := sd.readHandle(h1, @readBuffer, 8)  ' Read "file ONE"
    utils.checkGuard(@readBuffer_guard, @"readBuffer guard")
    utils.evaluateSubBool(strncmp(@readBuffer, @"file ONE", 8), @"Handle 1 at pos 12", true)

    bytefill(@readBuffer, 0, 256)
    utils.initGuard(@readBuffer_guard)
    bytesRead := sd.readHandle(h2, @readBuffer, 7)  ' Read "Content"
    utils.checkGuard(@readBuffer_guard, @"readBuffer guard")
    utils.evaluateSubBool(strncmp(@readBuffer, @"Content", 7), @"Handle 2 at pos 0", true)

    sd.closeFileHandle(h1)
    sd.closeFileHandle(h2)

    ' ======================================================================
    ' TEST GROUP: Single-Writer Policy
    ' ======================================================================
    utils.startTestGroup(@"Single-Writer Policy")

    ' Test: Second write open returns E_FILE_ALREADY_OPEN
    utils.startTest(@"Second write-open returns E_FILE_ALREADY_OPEN")
    h1 := sd.openFileWrite(@testfile1)
    utils.evaluateSubBool(h1 >= 0, @"First write-open succeeds", true)

    h2 := sd.openFileWrite(@testfile1)
    utils.evaluateSubValue(h2, @"Second write-open error", sd.E_FILE_ALREADY_OPEN)

    sd.closeFileHandle(h1)

    ' Test: Write open blocks write, but read is allowed
    utils.startTest(@"Read allowed while file open for write")
    h1 := sd.openFileWrite(@testfile1)
    utils.evaluateSubBool(h1 >= 0, @"Write-open succeeds", true)

    h2 := sd.openFileRead(@testfile1)
    utils.evaluateSubBool(h2 >= 0, @"Read-open succeeds", true)

    sd.closeFileHandle(h1)
    sd.closeFileHandle(h2)

    ' ======================================================================
    ' TEST GROUP: Handle Limit Enforcement
    ' ======================================================================
    utils.startTestGroup(@"Handle Limit Enforcement")

    ' Test: Opening 7th file returns E_TOO_MANY_FILES (MAX_OPEN_FILES = 6)
    utils.startTest(@"Opening 7th file returns E_TOO_MANY_FILES")

    ' Create the 5th test file
    h1 := sd.createFileNew(@testfile5)
    if h1 >= 0
        sd.closeFileHandle(h1)

    ' Open all 6 handles (reuse testfile1 for 6th handle)
    h1 := sd.openFileRead(@testfile1)
    h2 := sd.openFileRead(@testfile2)
    h3 := sd.openFileRead(@testfile3)
    h4 := sd.openFileRead(@testfile4)
    h5 := sd.openFileRead(@testfile5)
    h6 := sd.openFileRead(@testfile1)

    utils.evaluateSubBool(h1 >= 0, @"Handle 1 allocated", true)
    utils.evaluateSubBool(h2 >= 0, @"Handle 2 allocated", true)
    utils.evaluateSubBool(h3 >= 0, @"Handle 3 allocated", true)
    utils.evaluateSubBool(h4 >= 0, @"Handle 4 allocated", true)
    utils.evaluateSubBool(h5 >= 0, @"Handle 5 allocated", true)
    utils.evaluateSubBool(h6 >= 0, @"Handle 6 allocated", true)

    result := sd.openFileRead(@testfile2)
    utils.evaluateSubValue(result, @"7th open error", sd.E_TOO_MANY_FILES)
    if result >= 0                              ' Must fail. An unexpected 7th handle would
        sd.closeFileHandle(result)              '  leak and resurface in the recycling test

    sd.closeFileHandle(h1)
    sd.closeFileHandle(h2)
    sd.closeFileHandle(h3)
    sd.closeFileHandle(h4)
    sd.closeFileHandle(h5)
    sd.closeFileHandle(h6)

    ' ======================================================================
    ' TEST GROUP: Handle Release and Reuse
    ' ======================================================================
    utils.startTestGroup(@"Handle Release and Reuse")

    ' Test: Close handles in non-sequential order, verify slots become reusable
    utils.startTest(@"Closed handles become reusable")

    h1 := sd.openFileRead(@testfile1)
    h2 := sd.openFileRead(@testfile2)
    h3 := sd.openFileRead(@testfile3)
    h4 := sd.openFileRead(@testfile4)

    ' Close in non-sequential order: 2, 0, 3, 1
    result := sd.closeFileHandle(h3)  ' Close handle for file 3
    utils.evaluateSubValue(result, @"Close h3", 0)

    result := sd.closeFileHandle(h1)  ' Close handle for file 1
    utils.evaluateSubValue(result, @"Close h1", 0)

    result := sd.closeFileHandle(h4)  ' Close handle for file 4
    utils.evaluateSubValue(result, @"Close h4", 0)

    result := sd.closeFileHandle(h2)  ' Close handle for file 2
    utils.evaluateSubValue(result, @"Close h2", 0)

    ' Now open should work again
    h1 := sd.openFileRead(@testfile1)
    utils.evaluateSubBool(h1 >= 0, @"Reopen after close", true)
    sd.closeFileHandle(h1)

    ' ======================================================================
    ' TEST GROUP: Write Persistence
    ' ======================================================================
    utils.startTestGroup(@"Write Persistence")

    ' Test: Write, close, reopen, read back - verify data persisted
    utils.startTest(@"Write persists through close/reopen cycle")

    ' Delete the test file if it exists, then create fresh
    sd.deleteFile(@testfile5)
    h1 := sd.createFileNew(@testfile5)
    utils.evaluateSubBool(h1 >= 0, @"Create new file", true)

    ' Write test data
    bytesWritten := sd.writeHandle(h1, @"Persistence Test Data", 21)
    utils.evaluateSubValue(bytesWritten, @"Bytes written", 21)

    ' Close the file
    result := sd.closeFileHandle(h1)
    utils.evaluateSubValue(result, @"Close after write", 0)

    ' Reopen for read
    h1 := sd.openFileRead(@testfile5)
    utils.evaluateSubBool(h1 >= 0, @"Reopen for read", true)

    ' Check file size
    size := sd.fileSizeHandle(h1)
    utils.evaluateSubValue(size, @"File size", 21)

    ' Read back and verify
    bytefill(@readBuffer, 0, 256)
    utils.initGuard(@readBuffer_guard)
    bytesRead := sd.readHandle(h1, @readBuffer, 21)
    utils.checkGuard(@readBuffer_guard, @"readBuffer guard")
    utils.evaluateSubValue(bytesRead, @"Bytes read", 21)
    utils.evaluateSubBool(strcomp(@readBuffer, @"Persistence Test Data"), @"Data matches", true)

    sd.closeFileHandle(h1)

    ' ======================================================================
    ' TEST GROUP: Sync Operations
    ' ======================================================================
    utils.startTestGroup(@"Sync Operations")

    ' Test: Sync flushes data without closing
    utils.startTest(@"syncHandle flushes without closing")

    ' Create and write to a file
    sd.deleteFile(@testfile5)
    h1 := sd.createFileNew(@testfile5)
    utils.evaluateSubBool(h1 >= 0, @"Create file", true)

    bytesWritten := sd.writeHandle(h1, @"Sync Test", 9)
    utils.evaluateSubValue(bytesWritten, @"Bytes written", 9)

    ' Sync the handle
    result := sd.syncHandle(h1)
    utils.evaluateSubValue(result, @"Sync result", 0)

    ' Handle should still be valid - write more data
    bytesWritten := sd.writeHandle(h1, @" More", 5)
    utils.evaluateSubValue(bytesWritten, @"Write after sync", 5)

    ' Check size includes both writes
    size := sd.fileSizeHandle(h1)
    utils.evaluateSubValue(size, @"Size after sync+write", 14)

    sd.closeFileHandle(h1)

    ' Verify by reopening
    h1 := sd.openFileRead(@testfile5)
    size := sd.fileSizeHandle(h1)
    utils.evaluateSubValue(size, @"Final size", 14)

    bytefill(@readBuffer, 0, 256)
    utils.initGuard(@readBuffer_guard)
    bytesRead := sd.readHandle(h1, @readBuffer, 14)
    utils.checkGuard(@readBuffer_guard, @"readBuffer guard")
    utils.evaluateSubBool(strcomp(@readBuffer, @"Sync Test More"), @"All data present", true)

    sd.closeFileHandle(h1)

    ' ======================================================================
    ' TEST GROUP: Cross-Handle Cache Coherence
    ' ======================================================================
    utils.startTestGroup(@"Cross-Handle Cache Coherence")

    ' Test: a write handle's flush must invalidate another handle's CLEAN cached
    ' copy of the same sector. The read handle primes its buffer with the file's
    ' first sector, the write handle overwrites that sector on the card, and the
    ' read handle must then serve the NEW bytes. CAN-FAIL: against a driver whose
    ' writeSector coherence sweep skips the per-handle tier, the read handle's
    ' buffer stays tagged valid and serves the PRE-overwrite pattern, failing the
    ' final pattern check.
    utils.startTest(@"Read handle sees another handle's flushed overwrite")

    nonce := utils.perRunNonce()
    sd.deleteFile(@cohFile)
    h1 := sd.createFileNew(@cohFile)
    utils.evaluateSubBool(h1 >= 0, @"Create file", true)
    utils.fillBufferWithPattern(@cohBuffer, 512, nonce)
    bytesWritten := sd.writeHandle(h1, @cohBuffer, 512)
    utils.evaluateSubValue(bytesWritten, @"Write full pattern-A sector", 512)
    result := sd.closeFileHandle(h1)
    utils.evaluateSubValue(result, @"Close writer", 0)

    ' Prime the read handle's buffer with the file's (only) data sector -- clean
    h1 := sd.openFileRead(@cohFile)
    utils.evaluateSubBool(h1 >= 0, @"Open read handle", true)
    bytesRead := sd.readHandle(h1, @readBuffer, 16)
    utils.evaluateSubValue(bytesRead, @"Prime read-handle buffer", 16)

    ' Second handle overwrites the same sector on the card
    h2 := sd.openFileWrite(@cohFile)
    utils.evaluateSubBool(h2 >= 0, @"Open write handle", true)
    result := sd.seekHandle(h2, 0)
    utils.evaluateSubValue(result, @"Seek writer to 0", 0)
    utils.fillBufferWithPattern(@cohBuffer, 512, nonce + $55)
    bytesWritten := sd.writeHandle(h2, @cohBuffer, 512)
    utils.evaluateSubValue(bytesWritten, @"Overwrite with pattern B", 512)
    result := sd.syncHandle(h2)
    utils.evaluateSubValue(result, @"Sync writer (flush to card)", 0)

    ' The read handle must now serve the post-overwrite bytes
    result := sd.seekHandle(h1, 0)
    utils.evaluateSubValue(result, @"Seek reader to 0", 0)
    bytefill(@readBuffer, 0, 256)
    utils.initGuard(@readBuffer_guard)
    bytesRead := sd.readHandle(h1, @readBuffer, 64)
    utils.checkGuard(@readBuffer_guard, @"readBuffer guard")
    utils.evaluateSubValue(bytesRead, @"Re-read after overwrite", 64)
    utils.evaluateSubBool(utils.verifyBufferPattern(@readBuffer, 64, nonce + $55), @"Reader serves post-overwrite bytes", true)

    sd.closeFileHandle(h2)
    sd.closeFileHandle(h1)
    sd.deleteFile(@cohFile)

    ' ======================================================================
    ' TEST GROUP: EOF Detection
    ' ======================================================================
    utils.startTestGroup(@"EOF Detection")

    utils.startTest(@"eofHandle returns correct state")
    h1 := sd.openFileRead(@testfile1)

    ' At start, should not be at EOF
    result := sd.eofHandle(h1)
    utils.evaluateSubBool(result == 0, @"Not at EOF initially", true)

    ' Read entire file
    size := sd.fileSizeHandle(h1)
    bytefill(@readBuffer, 0, 256)
    utils.initGuard(@readBuffer_guard)
    bytesRead := sd.readHandle(h1, @readBuffer, size)
    utils.checkGuard(@readBuffer_guard, @"readBuffer guard")

    ' Now should be at EOF
    result := sd.eofHandle(h1)
    utils.evaluateSubBool(result <> 0, @"At EOF after reading all", true)

    ' Seek back - should not be at EOF
    sd.seekHandle(h1, 0)
    result := sd.eofHandle(h1)
    utils.evaluateSubBool(result == 0, @"Not at EOF after seek to 0", true)

    sd.closeFileHandle(h1)

    ' ======================================================================
    ' TEST GROUP: Invalid Handle Parameters
    ' ======================================================================
    utils.startTestGroup(@"Invalid Handle Parameters")

    ' Test: readHandle with -1 returns E_INVALID_HANDLE
    utils.startTest(@"readHandle(-1) returns E_INVALID_HANDLE")
    result := sd.readHandle(-1, @readBuffer, 10)
    utils.evaluateSingleValue(result, @"readHandle(-1)", sd.E_INVALID_HANDLE)

    ' Test: readHandle with 99 returns E_INVALID_HANDLE
    utils.startTest(@"readHandle(99) returns E_INVALID_HANDLE")
    result := sd.readHandle(99, @readBuffer, 10)
    utils.evaluateSingleValue(result, @"readHandle(99)", sd.E_INVALID_HANDLE)

    ' Test: writeHandle on closed handle returns E_INVALID_HANDLE
    ' THIS TEST HAD NEVER ONCE EXECUTED ITS INTENDED SCENARIO. Earlier groups leave
    ' MHTEST5.TXT on the card, so createFileNew returned E_FILE_EXISTS -- a negative
    ' number -- and h1 was an ERROR CODE, not a closed handle. closeFileHandle() on
    ' it did nothing and writeHandle() then returned E_INVALID_HANDLE because the
    ' argument was garbage, not because the slot had been closed. Right answer,
    ' wrong question, every single run. The delete makes the create succeed so a
    ' genuinely closed handle is what gets written to.
    utils.startTest(@"writeHandle on closed handle returns E_INVALID_HANDLE")
    utils.setCheckCountPerTest(2)
    sd.deleteFile(@testfile5)
    h1 := sd.createFileNew(@testfile5)
    utils.evaluateSubBool(h1 >= 0, @"file created (so the handle is real)", true)
    sd.closeFileHandle(h1)
    result := sd.writeHandle(h1, @"test", 4)
    utils.evaluateSubValue(result, @"writeHandle(closed)", sd.E_INVALID_HANDLE)
    utils.showSubTestResults()

    ' Test: seekHandle with invalid handle returns E_INVALID_HANDLE
    utils.startTest(@"seekHandle(-1) returns E_INVALID_HANDLE")
    result := sd.seekHandle(-1, 0)
    utils.evaluateSingleValue(result, @"seekHandle(-1)", sd.E_INVALID_HANDLE)

    ' Test: closeFileHandle twice returns E_INVALID_HANDLE on second call
    utils.startTest(@"Double close returns E_INVALID_HANDLE")
    h1 := sd.openFileRead(@testfile1)
    result := sd.closeFileHandle(h1)
    utils.evaluateSubValue(result, @"First close", 0)
    result := sd.closeFileHandle(h1)
    utils.evaluateSubValue(result, @"Second close", sd.E_INVALID_HANDLE)

    ' Test: tellHandle with invalid handle returns E_INVALID_HANDLE
    utils.startTest(@"tellHandle(-1) returns E_INVALID_HANDLE")
    result := sd.tellHandle(-1)
    utils.evaluateSingleValue(result, @"tellHandle(-1)", sd.E_INVALID_HANDLE)

    ' Test: fileSizeHandle with invalid handle returns E_INVALID_HANDLE
    utils.startTest(@"fileSizeHandle(-1) returns E_INVALID_HANDLE")
    result := sd.fileSizeHandle(-1)
    utils.evaluateSingleValue(result, @"fileSizeHandle(-1)", sd.E_INVALID_HANDLE)

    ' Test: syncHandle with invalid handle returns E_INVALID_HANDLE
    utils.startTest(@"syncHandle(-1) returns E_INVALID_HANDLE")
    result := sd.syncHandle(-1)
    utils.evaluateSingleValue(result, @"syncHandle(-1)", sd.E_INVALID_HANDLE)

    ' Test: eofHandle(-1) reports TRUE, and ERROR() carries E_INVALID_HANDLE.
    ' eofHandle is boolean-only by design -- it cannot return the code itself, because
    ' TRUE and E_TIMEOUT are both -1. The code is recovered from ERROR().
    utils.startTest(@"eofHandle(-1) returns E_INVALID_HANDLE")
    utils.setCheckCountPerTest(2)
    result := sd.eofHandle(-1)
    utils.evaluateSubBool(result <> 0, @"eofHandle(-1) reports TRUE", true)
    utils.evaluateSubValue(sd.ERROR(), @"ERROR() is E_INVALID_HANDLE", sd.E_INVALID_HANDLE)
    utils.showSubTestResults()
    utils.setCheckCountPerTest(1)

    ' ======================================================================
    ' TEST GROUP: Use-After-Close (recently valid handle)
    ' ======================================================================
    utils.startTestGroup(@"Use-After-Close")

    ' Create file, open, close, then test all 7 operations on stale handle
    utils.startTest(@"All handle ops fail on closed handle")
    utils.setCheckCountPerTest(8)                       ' 7 ops; eofHandle contributes 2 (bool + ERROR())
    sd.deleteFile(@testfile1)
    handle := sd.createFileNew(@testfile1)
    if handle >= 0
        sd.writeHandle(handle, @content1, strsize(@content1))
        sd.closeFileHandle(handle)

        result := sd.readHandle(handle, @readBuffer, 10)
        utils.evaluateSubValue(result, @"readHandle(closed)", sd.E_INVALID_HANDLE)

        result := sd.writeHandle(handle, @content1, 5)
        utils.evaluateSubValue(result, @"writeHandle(closed)", sd.E_INVALID_HANDLE)

        result := sd.seekHandle(handle, 0)
        utils.evaluateSubValue(result, @"seekHandle(closed)", sd.E_INVALID_HANDLE)

        result := sd.tellHandle(handle)
        utils.evaluateSubValue(result, @"tellHandle(closed)", sd.E_INVALID_HANDLE)

        result := sd.fileSizeHandle(handle)
        utils.evaluateSubValue(result, @"fileSizeHandle(closed)", sd.E_INVALID_HANDLE)

        ' eofHandle is boolean-only -- TRUE on failure, with the code in ERROR()
        result := sd.eofHandle(handle)
        utils.evaluateSubBool(result <> 0, @"eofHandle(closed) reports TRUE", true)
        utils.evaluateSubValue(sd.ERROR(), @"eofHandle(closed) ERROR()", sd.E_INVALID_HANDLE)

        result := sd.syncHandle(handle)
        utils.evaluateSubValue(result, @"syncHandle(closed)", sd.E_INVALID_HANDLE)
    utils.showSubTestResults()
    utils.setCheckCountPerTest(1)

    ' ======================================================================
    ' TEST GROUP: Handle Pool Recycling (file + dir)
    ' ======================================================================
    utils.startTestGroup(@"Handle Pool Recycling")

    utils.startTest(@"Mixed file and dir handles recycle")
    utils.setCheckCountPerTest(4)
    ' Open 4 file handles
    h1 := sd.openFileRead(@testfile1)
    h2 := sd.openFileRead(@testfile2)
    h3 := sd.openFileRead(@testfile3)
    h4 := sd.openFileRead(@testfile4)

    ' Open 2 dir handles (fills pool to 6)
    hDir := sd.openDirectory(@".")
    utils.evaluateSubBool(hDir >= 0, @"5th handle (dir)", true)

    hDir2 := sd.openDirectory(@".")
    utils.evaluateSubBool(hDir2 >= 0, @"6th handle (dir)", true)

    ' Close a dir handle and a file handle
    sd.closeDirectoryHandle(hDir)
    sd.closeFileHandle(h2)

    ' Open new file handle - should get recycled slot
    result := sd.openFileRead(@testfile2)
    utils.evaluateSubBool(result >= 0, @"recycled file handle", true)
    if result >= 0
        sd.closeFileHandle(result)

    ' Open new dir handle - should get recycled slot
    result := sd.openDirectory(@".")
    utils.evaluateSubBool(result >= 0, @"recycled dir handle", true)
    if result >= 0
        sd.closeDirectoryHandle(result)

    ' Cleanup remaining handles
    sd.closeFileHandle(h1)
    sd.closeFileHandle(h3)
    sd.closeFileHandle(h4)
    sd.closeDirectoryHandle(hDir2)
    utils.showSubTestResults()
    utils.setCheckCountPerTest(1)

    ' ======================================================================
    ' Cleanup and Summary
    ' ======================================================================
    cleanupTestFiles()

    sd.unmount()

    utils.ShowTestEndCounts()

    debug(" ")
    debug("END_SESSION")

PRI cleanupTestFiles()
' Delete all test files (ignore errors for non-existent files)

    sd.deleteFile(@testfile1)
    sd.deleteFile(@testfile2)
    sd.deleteFile(@testfile3)
    sd.deleteFile(@testfile4)
    sd.deleteFile(@testfile5)
    sd.deleteFile(@cohFile)

PRI createTestFiles() : bOk
' Create the four test files with known content
'
' @returns bOk - TRUE only when all four files were created and fully written
'
' Every test in this suite opens some subset of these files, so the caller
' gates on the result -- one failed seed used to fan into most of the suite.

    debug(" ")
    debug("* Creating test files...")

    bOk := seedFile(@testfile1, @content1)
    bOk := seedFile(@testfile2, @content2) and bOk
    bOk := seedFile(@testfile3, @content3) and bOk
    bOk := seedFile(@testfile4, @content4) and bOk

    if bOk
        debug("* Test files created")
    debug(" ")

PRI seedFile(pFile, pContent) : bOk | handle, expected
' Create one seed file holding the full content string
'
' @param pFile - Pointer to filename string
' @param pContent - Pointer to content the file must hold in full
' @returns bOk - TRUE only when created, fully written, and closed

    bOk := false
    handle := sd.createFileNew(pFile)
    if handle >= 0
        expected := strsize(pContent)
        bOk := (sd.writeHandle(handle, pContent, expected) == expected)
        if sd.closeFileHandle(handle) < 0
            bOk := false
        debug("  Created: ", zstr_(pFile))
    ifnot bOk
        debug("  ERROR creating ", zstr_(pFile))

PRI strncmp(p1, p2, maxLen) : match | idx
' Compare first maxLen bytes of two strings
'
' @param p1 - pointer to first string
' @param p2 - pointer to second string
' @param maxLen - number of bytes to compare
' @returns match - true if first maxLen bytes match

    match := true
    repeat idx from 0 to maxLen - 1
        if BYTE[p1][idx] <> BYTE[p2][idx]
            match := false
            quit

