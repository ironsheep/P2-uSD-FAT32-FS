'' =================================================================================================
''
''   File....... SD_RT_multiblock_tests.spin2
''   Purpose.... Multi-block read/write data integrity tests for V2 driver
''   Author..... Stephen M Moraco
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... JAN 2026
''   Updated.... 12 AUG 2026
''
'' =================================================================================================
''
''   This test verifies the V2 driver's multi-block operations (readSectorsRaw/writeSectorsRaw)
''   work correctly by testing data integrity across multiple scenarios.
''
''   Test Scenarios:
''     1. Round-trip: writeSectorsRaw() 8 sectors -> readSectorsRaw() 8 sectors -> verify
''     2. Multi-write, single-read: writeSectorsRaw() -> 8x readSectorRaw() -> verify
''     3. Single-write, multi-read: 8x writeSectorRaw() -> readSectorsRaw() -> verify
''     4. Edge cases: count=1 (fallback), count=0 (immediate return)
''     5. Large transfer: 64 sectors (32KB) round-trip
''
''   Test Sectors: 200000+ (safe area for all card sizes)
''
'' =================================================================================================

CON

    _CLKFREQ        = 350_000_000

    ' SD card pin assignments
    ' Default: P2 Edge module SD slot. Build with -D SD_PINS_EXTERNAL
    ' to use the external SD header (base pin 16).
#ifdef SD_PINS_EXTERNAL
    SD_CS   = 20
    SD_MOSI = 19
    SD_MISO = 18
    SD_SCK  = 21
#else
    SD_CS   = 60
    SD_MOSI = 59
    SD_MISO = 58
    SD_SCK  = 61
#endif
    ' Scratch sector base. These are RAW LBAs written while the card is also
    ' mounted as a filesystem -- sanctioned because a regression card is project
    ' scratch, but the range must be verified to exist on the card before use so a
    ' small card reports a precondition failure instead of confusing I/O errors.
    TEST_SECTOR_BASE = 200_000

    ' Test sizes
    SMALL_COUNT      = 8            ' Standard multi-block test size
    LARGE_COUNT      = 64           ' Large multi-block test

    ' Highest scratch LBA touched: TEST 5 starts at base+50 and runs LARGE_COUNT.
    TEST_SECTOR_MAX  = TEST_SECTOR_BASE + 50 + LARGE_COUNT - 1


' Enable full driver features for multi-block testing
' Uncomment SD_INCLUDE_STACK_CHECK to measure worker cog stack depth
#ifdef __SPINTOOLS__
#define SD_INCLUDE_ALL
#elseifdef __FLEXSPIN__
#define SD_INCLUDE_ALL
#pragma exportdef SD_INCLUDE_ALL
#else
#pragma exportdef SD_INCLUDE_ALL
#define SD_INCLUDE_STACK_CHECK
#pragma exportdef SD_INCLUDE_STACK_CHECK
#endif

OBJ
    sd    : "micro_sd_fat32_fs"
    utils : "isp_rt_utilities"

VAR
    ' Buffers for multi-sector operations
    BYTE    write_buf[SMALL_COUNT * sd.SECTOR_SIZE]     ' 4KB for 8 sectors
    BYTE    read_buf[SMALL_COUNT * sd.SECTOR_SIZE]
    BYTE    read_buf_guard[16]
    BYTE    large_write_buf[LARGE_COUNT * sd.SECTOR_SIZE]  ' 32KB for 64 sectors
    BYTE    large_read_buf[LARGE_COUNT * sd.SECTOR_SIZE]
    BYTE    large_read_buf_guard[16]

    BYTE    cmd12_buf[16]
    BYTE    cmd12_pre_buf[7]

DAT
' TEST 6 (CMD25 cache coherence) filenames, plus their 11-byte on-disk SFN forms
cohFileA        BYTE    "MBCOHA.TXT", 0
cohFileB        BYTE    "MBCOHB.TXT", 0
sfnCohA         BYTE    "MBCOHA  TXT"
sfnCohB         BYTE    "MBCOHB  TXT"

PUB go() | result, cardSectors
'' Main entry point for multi-block data integrity tests
''
'' Tests readSectorsRaw/writeSectorsRaw operations

    debug(" ")
    debug("============================================================")
    debug("  SD Multi-Block Data Integrity Tests (V2 Driver)")
    debug("============================================================")
    debug(" ")

    ' Mount the card (starts worker cog needed for multi-block operations)
    debug("Mounting SD card (V2 driver)...")
    result := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    ifnot utils.requireSetup(result == 0, @"SETUP: mount SD card")
        debug("ERROR: Mount failed!")
        utils.ShowTestEndCounts()
        debug("END_SESSION")
        return

    debug("Card mounted successfully")
    result := sd.cardWarnings()
    debug("Card capabilities: $", uhex_byte_(result))
    if result & sd.CW_CMD13_UNRELIABLE
      debug("  CMD13: UNRELIABLE (status checks disabled)")
    else
      debug("  CMD13: OK")
    if result & sd.CW_CMD23_SUPPORTED
      debug("  CMD23: SUPPORTED (pre-defined block count)")
    else
      debug("  CMD23: not supported in SPI mode")

    ' ----------------------------------------
    ' Precondition gate: the scratch LBA range must exist on this card.
    ' ----------------------------------------
    cardSectors := sd.cardSizeSectors()
    debug("Card size: ", udec_(cardSectors), " sectors; scratch range ", udec_(TEST_SECTOR_BASE), "..", udec_(TEST_SECTOR_MAX))
    ' Scored, not just printed: the rig's regression cards all satisfy this
    ' range, so a failed check means the wrong card (or something worse) and
    ' must not read as a green 0-fail run.
    ' ASSUMPTION, stated here because it is load-bearing and invisible otherwise:
    ' this suite writes RAW LBAs from TEST_SECTOR_BASE (200,000) upward, on the
    ' understanding that they sit past the filesystem's allocated clusters on the
    ' regression cards -- i.e. writing them destroys no live file data. That holds
    ' for the rig's cards because the FAT32 data region on them starts far below
    ' 200,000 and is nowhere near full. It is NOT a general guarantee: on a heavily
    ' populated or much smaller card these LBAs could hold real file content. The
    ' card-size gate below is what keeps the range on the card; it deliberately does
    ' NOT prove the range is unallocated, because MODE_RAW has no filesystem view to
    ' ask. A regression card is project scratch by standing policy, which is what
    ' makes that acceptable.
    ifnot utils.requireSetup(cardSectors > TEST_SECTOR_MAX, @"SETUP: card large enough for scratch range")
        debug("  *** SETUP NOT MET: card has ", udec_(cardSectors), " sectors, scratch range needs > ", udec_(TEST_SECTOR_MAX), " -- multi-block tests NOT run ***")
        sd.unmount()
        utils.ShowTestEndCounts()
        debug("END_SESSION")
        return
    debug(" ")

    utils.startTestGroup(@"Multi-Block Data Integrity")

    ' ========================================
    ' TEST 1: Round-trip multi-block
    ' ========================================
    testRoundTripMultiBlock()

    ' ========================================
    ' TEST 2: Multi-write, single-read
    ' ========================================
    testMultiWriteSingleRead()

    ' ========================================
    ' TEST 3: Single-write, multi-read
    ' ========================================
    testSingleWriteMultiRead()

    ' ========================================
    ' TEST 4: Edge cases
    ' ========================================
    testEdgeCases()

    ' ========================================
    ' TEST 5: Large multi-block (64 sectors)
    ' ========================================
    testLargeMultiBlock()

    ' ========================================
    ' TEST 6: CMD25 cache coherence
    ' ========================================
    utils.startTestGroup(@"CMD25 Cache Coherence")
    testCmd25CacheCoherence()

    ' Report stack depth while worker cog is still running
#ifdef SD_INCLUDE_STACK_CHECK
    debug(" ")
    debug("* Worker cog stack: ", udec_(sd.reportStackDepth()), " of ", udec_(sd.STACK_SIZE), " longs used")
#endif

    ' Release the filesystem cleanly -- this suite left the card mounted, which
    ' skipped the final cache flush that every other suite performs on teardown.
    sd.unmount()

    ' Framework totals, BAD TEST COUNTS cross-check, and (on measurement builds) the stack watermark
    utils.ShowTestEndCounts()

    debug(" ")
    debug("END_SESSION")


PRI testRoundTripMultiBlock() | sector, idx, written, readCt, errors, nonce
' TEST 1: Write 8 sectors with writeSectorsRaw, read back with readSectorsRaw
'
' @local sector - Starting sector number for the test
' @local idx - Byte index into the write/read buffers
' @local written - Number of sectors written by writeSectorsRaw()
' @local readCt - Number of sectors read by readSectorsRaw()
' @local errors - Count of byte mismatches during verification

    utils.startTest(@"Round-trip multi-block (8 sectors)")
    debug("--- TEST 1: Round-trip Multi-Block (8 sectors) ---")
    sector := TEST_SECTOR_BASE

    ' Fill write buffer with a known pattern, offset by the per-run nonce so this
    ' run's data is distinguishable from what a previous run left in these sectors.
    ' The nonce is read ONCE -- it is stable for the run, and calling it per byte
    ' would put a method call in a 4 KB..32 KB loop for no benefit.
    nonce := utils.perRunNonce()
    repeat idx from 0 to (SMALL_COUNT * sd.SECTOR_SIZE) - 1
        write_buf[idx] := ((idx / sd.SECTOR_SIZE) * 17 + (idx // sd.SECTOR_SIZE) + nonce) & $FF

    ' Write all 8 sectors at once
    debug("* Writing 8 sectors starting at ", udec_(sector))
    written := sd.writeSectorsRaw(sector, SMALL_COUNT, @write_buf)
    if written <> SMALL_COUNT
        debug("  FAIL: writeSectorsRaw returned ", udec_(written), " (expected ", udec_(SMALL_COUNT), ")")
        utils.recordFail()
        return

    ' Clear read buffer
    bytefill(@read_buf, $00, SMALL_COUNT * sd.SECTOR_SIZE)

    ' Read all 8 sectors at once
    debug("* Reading 8 sectors starting at ", udec_(sector))
    utils.initGuard(@read_buf_guard)
    readCt := sd.readSectorsRaw(sector, SMALL_COUNT, @read_buf)
    utils.checkGuard(@read_buf_guard, @"read_buf guard")
    if readCt <> SMALL_COUNT
        debug("  FAIL: readSectorsRaw returned ", udec_(readCt), " (expected ", udec_(SMALL_COUNT), ")")
        dumpCMD18Diag()
        utils.recordFail()
        return

    ' Verify every byte
    errors := 0
    repeat idx from 0 to (SMALL_COUNT * sd.SECTOR_SIZE) - 1
        if read_buf[idx] <> write_buf[idx]
            if errors < 5  ' Only report first 5 errors
                debug("  ERROR at byte ", udec_(idx), ": expected $", uhex_byte_(write_buf[idx]), " got $", uhex_byte_(read_buf[idx]))
            errors++

    if errors == 0
        debug("  -> PASS: All ", udec_(SMALL_COUNT * sd.SECTOR_SIZE), " bytes verified")
        if sd.getLastCMD18FailPath() == 5
            debug("  NOTE: CMD12 error was tolerated (path=5)")
            dumpCMD18Diag()
        utils.recordPass()
    else
        debug("  -> FAIL: ", udec_(errors), " byte mismatches")
        utils.recordFail()


PRI testMultiWriteSingleRead() | sector, idx, jdx, written, errors, expected, actual, bufOffset, nonce
' TEST 2: Write 8 sectors with writeSectorsRaw, read back with individual readSectorRaw calls
'
' @local sector - Starting sector number for the test
' @local idx - Sector index (0..SMALL_COUNT-1)
' @local jdx - Byte index within a sector (0..511)
' @local written - Number of sectors written by writeSectorsRaw()
' @local errors - Count of byte mismatches during verification
' @local expected - Expected byte value at current position
' @local actual - Actual byte value read from buffer
' @local bufOffset - Byte offset into write_buf for current sector

    utils.startTest(@"Multi-write, single-read (8 sectors)")
    debug(" ")
    debug("--- TEST 2: Multi-Write, Single-Read (8 sectors) ---")
    sector := TEST_SECTOR_BASE + 10

    ' Fill write buffer with a different pattern; nonce read once, not per byte
    nonce := utils.perRunNonce()
    repeat idx from 0 to (SMALL_COUNT * sd.SECTOR_SIZE) - 1
        write_buf[idx] := ((idx / sd.SECTOR_SIZE) * 23 + (idx // sd.SECTOR_SIZE) + $A0 + nonce) & $FF

    ' Write all 8 sectors at once
    debug("* Writing 8 sectors with writeSectorsRaw at ", udec_(sector))
    written := sd.writeSectorsRaw(sector, SMALL_COUNT, @write_buf)
    if written <> SMALL_COUNT
        debug("  FAIL: writeSectorsRaw returned ", udec_(written))
        utils.recordFail()
        return

    ' Read back with 8 individual reads and verify each
    errors := 0
    utils.initGuard(@read_buf_guard)
    repeat idx from 0 to SMALL_COUNT - 1
        ' Read single sector into read_buf (reuse first 512 bytes).
        ' The status was discarded: a FAILED read left the previous sector's bytes
        ' in read_buf and the mismatch loop below then reported it as a DATA
        ' CORRUPTION defect. Wrong diagnosis, and it pointed at the multi-block
        ' write path rather than at the read that actually failed.
        if sd.readSectorRaw(sector + idx, @read_buf) < 0
            debug("  FAIL: readSectorRaw failed for sector ", udec_(sector + idx), " (not a data mismatch)")
            utils.recordFail()
            return
        utils.initAndCheckGuard(@read_buf_guard, @"read_buf guard")

        ' Verify this sector's data against write_buf
        bufOffset := idx * sd.SECTOR_SIZE
        repeat jdx from 0 to sd.SECTOR_SIZE - 1
            expected := write_buf[bufOffset + jdx]
            actual := read_buf[jdx]
            if actual <> expected
                if errors < 5
                    debug("  ERROR sector ", udec_(idx), " byte ", udec_(jdx), ": expected $", uhex_byte_(expected), " got $", uhex_byte_(actual))
                errors++

    if errors == 0
        debug("  -> PASS: All 8 sectors verified with single reads")
        utils.recordPass()
    else
        debug("  -> FAIL: ", udec_(errors), " byte mismatches")
        utils.recordFail()


PRI testSingleWriteMultiRead() | sector, idx, jdx, readCt, errors, expected, actual, bufOffset, nonce
' TEST 3: Write 8 sectors with individual writeSectorRaw calls, read back with readSectorsRaw
'
' @local sector - Starting sector number for the test
' @local idx - Sector index (0..SMALL_COUNT-1)
' @local jdx - Byte index within a sector (0..511)
' @local readCt - Number of sectors read by readSectorsRaw()
' @local errors - Count of byte mismatches during verification
' @local expected - Expected byte value at current position
' @local actual - Actual byte value read from buffer
' @local bufOffset - Byte offset into write_buf for current sector

    utils.startTest(@"Single-write, multi-read (8 sectors)")
    debug(" ")
    debug("--- TEST 3: Single-Write, Multi-Read (8 sectors) ---")
    sector := TEST_SECTOR_BASE + 20

    ' Write 8 sectors one at a time with unique pattern per sector
    debug("* Writing 8 sectors with individual writeSectorRaw at ", udec_(sector))
    nonce := utils.perRunNonce()
    repeat idx from 0 to SMALL_COUNT - 1
        ' Fill single sector buffer
        bufOffset := idx * sd.SECTOR_SIZE
        repeat jdx from 0 to sd.SECTOR_SIZE - 1
            write_buf[bufOffset + jdx] := ((idx * 31) + jdx + $B0 + nonce) & $FF

        ' Write this sector
        if sd.writeSectorRaw(sector + idx, @write_buf + bufOffset) < 0
            debug("  FAIL: writeSectorRaw failed for sector ", udec_(idx))
            utils.recordFail()
            return

    ' Clear read buffer
    bytefill(@read_buf, $00, SMALL_COUNT * sd.SECTOR_SIZE)

    ' Read all 8 sectors at once
    debug("* Reading 8 sectors with readSectorsRaw")
    utils.initGuard(@read_buf_guard)
    readCt := sd.readSectorsRaw(sector, SMALL_COUNT, @read_buf)
    utils.checkGuard(@read_buf_guard, @"read_buf guard")
    if readCt <> SMALL_COUNT
        debug("  FAIL: readSectorsRaw returned ", udec_(readCt))
        dumpCMD18Diag()
        utils.recordFail()
        return

    ' Verify all data
    errors := 0
    repeat idx from 0 to SMALL_COUNT - 1
        bufOffset := idx * sd.SECTOR_SIZE
        repeat jdx from 0 to sd.SECTOR_SIZE - 1
            expected := write_buf[bufOffset + jdx]
            actual := read_buf[bufOffset + jdx]
            if actual <> expected
                if errors < 5
                    debug("  ERROR sector ", udec_(idx), " byte ", udec_(jdx), ": expected $", uhex_byte_(expected), " got $", uhex_byte_(actual))
                errors++

    if errors == 0
        debug("  -> PASS: All 8 sectors verified")
        utils.recordPass()
    else
        debug("  -> FAIL: ", udec_(errors), " byte mismatches")
        utils.recordFail()


PRI testEdgeCases() | sector, idx, written, readCt, errors, nonce
' TEST 4: Edge cases - count=1, count=0
'
' @local sector - Starting sector number for the test
' @local idx - Byte index into the sector buffer
' @local written - Number of sectors written by writeSectorsRaw()
' @local readCt - Number of sectors read by readSectorsRaw()
' @local errors - Count of byte mismatches during verification

    debug(" ")
    debug("--- TEST 4: Edge Cases ---")

    ' Test 4a: count=1 (should work as single-sector operation)
    ' 4a and 4b each record their own result, so each carries its own title
    utils.startTest(@"Edge case: count=1 single-sector fallback")
    sector := TEST_SECTOR_BASE + 30
    debug("* Test 4a: writeSectorsRaw/readSectorsRaw with count=1")

    ' Fill single sector; nonce read once, not per byte
    nonce := utils.perRunNonce()
    repeat idx from 0 to sd.SECTOR_SIZE - 1
        write_buf[idx] := (idx + $C0 + nonce) & $FF

    written := sd.writeSectorsRaw(sector, 1, @write_buf)
    if written <> 1
        debug("  FAIL: count=1 write returned ", udec_(written))
        utils.recordFail()
    else
        bytefill(@read_buf, $00, sd.SECTOR_SIZE)
        utils.initGuard(@read_buf_guard)
        readCt := sd.readSectorsRaw(sector, 1, @read_buf)
        utils.checkGuard(@read_buf_guard, @"read_buf guard")
        if readCt <> 1
            debug("  FAIL: count=1 read returned ", udec_(readCt))
            debug("  DIAG: R1=$", uhex_byte_(sd.getLastCMD18R1()), " tok=$", uhex_byte_(sd.getLastCMD18Token()), " path=", udec_(sd.getLastCMD18FailPath()), " sread=", udec_(sd.getLastCMD18SectorsRead()))
            debug("  CMD12: R1=$", uhex_byte_(sd.getLastCMD12R1()), " result=", udec_(sd.getLastCMD12Result()))
            utils.recordFail()
        else
            errors := 0
            repeat idx from 0 to sd.SECTOR_SIZE - 1
                if read_buf[idx] <> write_buf[idx]
                    errors++
            if errors == 0
                debug("  -> PASS: count=1 works correctly")
                utils.recordPass()
            else
                debug("  -> FAIL: count=1 data mismatch (", udec_(errors), " errors)")
                utils.recordFail()

    ' Test 4b: count=0 (should return 0 immediately)
    utils.startTest(@"Edge case: count=0 immediate return")
    debug("* Test 4b: writeSectorsRaw/readSectorsRaw with count=0")

    written := sd.writeSectorsRaw(sector, 0, @write_buf)
    readCt := sd.readSectorsRaw(sector, 0, @read_buf)

    if written == 0 and readCt == 0
        debug("  -> PASS: count=0 returns 0 for both operations")
        utils.recordPass()
    else
        debug("  -> FAIL: count=0 returned write=", udec_(written), " read=", udec_(readCt))
        utils.recordFail()


PRI testLargeMultiBlock() | sector, idx, written, readCt, errors, nonce
' TEST 5: Large multi-block (64 sectors = 32KB)
'
' @local sector - Starting sector number for the test
' @local idx - Byte index into the large write/read buffers
' @local written - Number of sectors written by writeSectorsRaw()
' @local readCt - Number of sectors read by readSectorsRaw()
' @local errors - Count of byte mismatches during verification

    utils.startTest(@"Large multi-block (64 sectors = 32KB)")
    debug(" ")
    debug("--- TEST 5: Large Multi-Block (64 sectors = 32KB) ---")
    sector := TEST_SECTOR_BASE + 50

    ' Fill large write buffer with pattern
    debug("* Filling 32KB buffer with pattern...")
    ' Nonce read ONCE. A per-byte call here would be 32768 method calls.
    nonce := utils.perRunNonce()
    repeat idx from 0 to (LARGE_COUNT * sd.SECTOR_SIZE) - 1
        large_write_buf[idx] := ((idx / sd.SECTOR_SIZE) + (idx // sd.SECTOR_SIZE) + nonce) & $FF

    ' Write 64 sectors at once
    debug("* Writing 64 sectors starting at ", udec_(sector))
    written := sd.writeSectorsRaw(sector, LARGE_COUNT, @large_write_buf)
    if written <> LARGE_COUNT
        debug("  FAIL: writeSectorsRaw returned ", udec_(written), " (expected ", udec_(LARGE_COUNT), ")")
        utils.recordFail()
        return

    debug("* Write complete, clearing read buffer...")
    bytefill(@large_read_buf, $00, LARGE_COUNT * sd.SECTOR_SIZE)

    ' Read 64 sectors at once
    debug("* Reading 64 sectors starting at ", udec_(sector))
    utils.initGuard(@large_read_buf_guard)
    readCt := sd.readSectorsRaw(sector, LARGE_COUNT, @large_read_buf)
    utils.checkGuard(@large_read_buf_guard, @"large_read_buf guard")
    if readCt <> LARGE_COUNT
        debug("  FAIL: readSectorsRaw returned ", udec_(readCt), " (expected ", udec_(LARGE_COUNT), ")")
        dumpCMD18Diag()
        utils.recordFail()
        return

    ' Verify all 32KB
    debug("* Verifying 32KB of data...")
    errors := 0
    repeat idx from 0 to (LARGE_COUNT * sd.SECTOR_SIZE) - 1
        if large_read_buf[idx] <> large_write_buf[idx]
            if errors < 5
                debug("  ERROR at byte ", udec_(idx), ": expected $", uhex_byte_(large_write_buf[idx]), " got $", uhex_byte_(large_read_buf[idx]))
            errors++

    if errors == 0
        debug("  -> PASS: All 32KB (", udec_(LARGE_COUNT * sd.SECTOR_SIZE), " bytes) verified")
        utils.recordPass()
    else
        debug("  -> FAIL: ", udec_(errors), " byte mismatches in 32KB")
        utils.recordFail()


PRI testCmd25CacheCoherence() | rootSec, secIdx, entryOfs, entrySec, written, hNew, hStale
' TEST 6: CMD25 (writeSectorsRaw) must invalidate the filesystem's cache tiers.
'
' Creates a file, locates its directory entry on disk, primes the directory
' cache with that sector, then REWRITES the sector via CMD25 with the entry
' renamed -- a raw multi-block write behind the filesystem's back. Opening the
' new name must succeed and the old name must be gone. CAN-FAIL: against a
' driver whose writeSectors performs no cache invalidation, the directory
' cache serves the stale pre-rename sector: the new name returns
' E_FILE_NOT_FOUND and the old name still "opens".
'
' @local rootSec - First sector of the root directory
' @local secIdx - Root-sector scan index
' @local entryOfs - Byte offset of the entry within its sector
' @local entrySec - Absolute sector holding the file's directory entry
' @local written - writeSectorsRaw() result
' @local hNew - Handle for the post-rewrite (new-name) open
' @local hStale - Handle for the post-rewrite (old-name) open

    utils.startTest(@"CMD25 cache coherence (root dir rewrite)")
    debug("--- TEST 6: CMD25 cache coherence (root dir rewrite) ---")

    sd.deleteFile(@cohFileA)                            ' self-establishing preconditions
    sd.deleteFile(@cohFileB)

    hNew := sd.createFileNew(@cohFileA)
    if hNew < 0
        debug("  FAIL: could not create ", zstr_(@cohFileA), ": ", sdec_(hNew))
        utils.recordFail()
        return
    sd.writeHandle(hNew, @"coherence probe", 15)
    sd.closeFileHandle(hNew)

    ' Locate the on-disk sector holding the new entry (first root cluster;
    ' 8 sectors covers the smallest cluster size in the certification pairing)
    rootSec := sd.debugGetRootSec()
    entrySec := -1
    repeat secIdx from 0 to 7
        if sd.readSectorRaw(rootSec + secIdx, @read_buf) < 0
            quit
        repeat entryOfs from 0 to sd.SECTOR_SIZE - 32 step 32
            if sfnMatches(@read_buf + entryOfs, @sfnCohA)
                entrySec := rootSec + secIdx
                quit
        if entrySec >= 0
            quit
    if entrySec < 0
        ' Scored, not silently skipped: on the rig's regression cards the fresh
        ' entry always lands in the first root cluster, so failing to find it
        ' means the wrong card or a broken root walk -- neither may read green
        debug("  *** SETUP NOT MET: entry not in first 8 root sectors ***")
        sd.deleteFile(@cohFileA)
        utils.recordFail()
        return

    ' Prime the directory cache with the entry's sector (the open's search
    ' walks the root directory and leaves that sector cached)
    hNew := sd.openFileRead(@cohFileA)
    if hNew >= 0
        sd.closeFileHandle(hNew)

    ' Rename the entry ON DISK via CMD25, behind the filesystem's back
    bytemove(@read_buf + entryOfs, @sfnCohB, 11)
    written := sd.writeSectorsRaw(entrySec, 1, @read_buf)
    if written <> 1
        debug("  FAIL: writeSectorsRaw returned ", udec_(written), " (expected 1)")
        sd.deleteFile(@cohFileA)
        utils.recordFail()
        return

    ' The filesystem must see the post-CMD25 directory contents
    hNew := sd.openFileRead(@cohFileB)
    hStale := sd.openFileRead(@cohFileA)
    if hStale >= 0
        sd.closeFileHandle(hStale)
    if hNew >= 0
        sd.closeFileHandle(hNew)

    if hNew >= 0 AND hStale < 0
        debug("  -> PASS: new name opens, old name gone (cache re-read after CMD25)")
        utils.recordPass()
    else
        debug("  -> FAIL: openFileRead new=", sdec_(hNew), " old=", sdec_(hStale), " (stale directory cache after CMD25)")
        utils.recordFail()

    sd.deleteFile(@cohFileB)                            ' entry's on-disk name is B after the rewrite
    sd.deleteFile(@cohFileA)                            ' harmless when already renamed; covers early-failure residue

PRI sfnMatches(pEntry, pName) : bMatch | idx
' Compare a directory entry's 11-byte on-disk SFN field against an expected name
'
' @param pEntry - Pointer to the 32-byte directory entry (SFN at offset 0)
' @param pName - Pointer to the expected 11-byte space-padded SFN
' @returns bMatch - TRUE when all 11 bytes match
' @local idx - Byte index

    bMatch := true
    repeat idx from 0 to 10
        if BYTE[pEntry + idx] <> BYTE[pName + idx]
            bMatch := false
            quit

PRI dumpCMD18Diag() | ncr_len
' Dump CMD18 diagnostic info: CMD23 status, R1, token, failure path, sectors read, and CMD12 details
'
' @local ncr_len - NCR gap length (bytes before first non-$FF in CMD12 capture)

    debug("  DIAG: R1=$", uhex_byte_(sd.getLastCMD18R1()), " tok=$", uhex_byte_(sd.getLastCMD18Token()), " path=", udec_(sd.getLastCMD18FailPath()), " sread=", udec_(sd.getLastCMD18SectorsRead()))
    debug("  CMD23: supported=", udec_(sd.getCmd23Supported()), " used=", udec_(sd.getLastCMD23Used()), " R1=$", uhex_byte_(sd.getLastCMD23R1()), " verify=$", uhex_byte_(sd.getLastCMD23Verify()))
    if not sd.getLastCMD23Used()
      debug("  CMD12: R1=$", uhex_byte_(sd.getLastCMD12R1()), " result=", udec_(sd.getLastCMD12Result()))
      sd.getLastCMD12PreCapture(@cmd12_pre_buf)
      debug("  CMD12 MISO during send: $", uhex_byte_(cmd12_pre_buf[0]), " $", uhex_byte_(cmd12_pre_buf[1]), " $", uhex_byte_(cmd12_pre_buf[2]), " $", uhex_byte_(cmd12_pre_buf[3]), " $", uhex_byte_(cmd12_pre_buf[4]), " $", uhex_byte_(cmd12_pre_buf[5]), " $", uhex_byte_(cmd12_pre_buf[6]))
      ncr_len := sd.getLastCMD12Capture(@cmd12_buf)
      debug("  CMD12 stream (NCR=", udec_(ncr_len), "): $", uhex_byte_(cmd12_buf[0]), " $", uhex_byte_(cmd12_buf[1]), " $", uhex_byte_(cmd12_buf[2]), " $", uhex_byte_(cmd12_buf[3]), " $", uhex_byte_(cmd12_buf[4]), " $", uhex_byte_(cmd12_buf[5]), " $", uhex_byte_(cmd12_buf[6]), " $", uhex_byte_(cmd12_buf[7]))
      debug("                       $", uhex_byte_(cmd12_buf[8]), " $", uhex_byte_(cmd12_buf[9]), " $", uhex_byte_(cmd12_buf[10]), " $", uhex_byte_(cmd12_buf[11]), " $", uhex_byte_(cmd12_buf[12]), " $", uhex_byte_(cmd12_buf[13]), " $", uhex_byte_(cmd12_buf[14]), " $", uhex_byte_(cmd12_buf[15]))


