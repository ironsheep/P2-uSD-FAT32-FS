'' =================================================================================================
''
''   File....... SD_RT_speed_tests.spin2
''   Purpose.... This object tests the speed control and CMD6 high-speed APIs
''   Author..... Stephen M Moraco
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... FEB 2026
''   Updated.... 18 FEB 2026
''
'' =================================================================================================
''
'' Tests the following APIs:
''   - getSPIFrequency()
''   - getCardMaxSpeed()
''   - isHighSpeedActive()
''   - setSPISpeed()
''   - checkCMD6Support()
''   - checkHighSpeedCapability()
''   - attemptHighSpeed()
''   - getReadTimeout() / getWriteTimeout()
''
'' Note: Tests verify API correctness and self-consistency regardless of card
'' capability. Uses ranges, not exact values, since cards vary.
''
'' =================================================================================================

CON

     _CLKFREQ        = 350_000_000

     ' SD card pin assignments
     ' Default: P2 Edge module SD slot. Build with -D SD_PINS_EXTERNAL
     ' to use the external SD header (base pin 16).
#ifdef SD_PINS_EXTERNAL
     SD_CS   = 20
     SD_MOSI = 19
     SD_MISO = 18
     SD_SCK  = 21
#else
     SD_CS   = 60
     SD_MOSI = 59
     SD_MISO = 58
     SD_SCK  = 61
#endif
     BUFFER_SIZE = 512

' Enable speed and register features, plus DEBUG getters + RAW reads for the
' failure-path survey coordinates (printSurveyCoords)
#ifdef __SPINTOOLS__
#define SD_INCLUDE_SPEED
#define SD_INCLUDE_REGISTERS
#define SD_INCLUDE_DEBUG
#define SD_INCLUDE_RAW
#elseifdef __FLEXSPIN__
#define SD_INCLUDE_SPEED
#pragma exportdef SD_INCLUDE_SPEED
#define SD_INCLUDE_REGISTERS
#pragma exportdef SD_INCLUDE_REGISTERS
#define SD_INCLUDE_DEBUG
#pragma exportdef SD_INCLUDE_DEBUG
#define SD_INCLUDE_RAW
#pragma exportdef SD_INCLUDE_RAW
#else
#pragma exportdef SD_INCLUDE_SPEED
#pragma exportdef SD_INCLUDE_REGISTERS
#pragma exportdef SD_INCLUDE_DEBUG
#pragma exportdef SD_INCLUDE_RAW
#endif

OBJ
    sd    : "micro_sd_fat32_fs"
    utils : "isp_rt_utilities"

DAT

' Test filenames
spTestFile      BYTE    "SPTEST1.BIN", 0
spTestFile2     BYTE    "SPTEST2.BIN", 0
spTestFile3     BYTE    "SPTEST3.BIN", 0

' Buffers
writeBuffer     BYTE    0[BUFFER_SIZE]
readBuffer      BYTE    0[BUFFER_SIZE]
readBuffer_guard BYTE   0[16]
surveyBuf       BYTE    0[BUFFER_SIZE]           ' failure-path raw directory read (printSurveyCoords)

PUB go() | result, handle, spiFreq, maxSpeed, hsActive, cmd6Sup, hsCap, hsResult, bytesRead, bytesWritten, readTimeout, writeTimeout, computedSpeed, errCode
'' Main entry point for speed API regression tests

    debug(" ")
    debug("==============================================")
    debug("  SD Card Driver - Speed & CMD6 Tests")
    debug("==============================================")

    ' Mount the card first
    result := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    ifnot utils.requireSetup(result == 0, @"SETUP: mount SD card")
        debug("ERROR: Could not mount SD card!")
        utils.ShowTestEndCounts()
        debug("END_SESSION")
        return

    ' Capture the driver's computed safe operating speed. On most cards this is
    ' 25 MHz; on cards where probeSpiCeiling backed off (dummy-CRC counterfeits
    ' with SCK ceiling < 25 MHz), it is the probe-found safe rate. Used below
    ' wherever the test needs to restore a known-good speed without forcing
    ' the card above its empirical ceiling.
    computedSpeed := sd.getSPIFrequency()
    debug("   Driver-computed safe speed: ", udec(computedSpeed), " Hz")

    ' Show card info
    debug(" ")
    debug("* SD Card Information:")
    debug("   Volume Label: ", zstr_(sd.volumeLabel()))
    debug("   Free Space: ", udec(sd.freeSpace()), " sectors")

    ' Clean up any existing test files
    sd.deleteFile(@spTestFile)
    sd.deleteFile(@spTestFile2)
    sd.deleteFile(@spTestFile3)

    ' ======================================================================
    ' TEST GROUP: Always-Available Speed
    ' ======================================================================
    utils.startTestGroup(@"Always-Available Speed Info")

    ' Test: getSPIFrequency() returns ~25 MHz after mount
    utils.startTest(@"getSPIFrequency() ~25 MHz after mount")
    spiFreq := sd.getSPIFrequency()
    debug("   SPI frequency: ", udec(spiFreq), " Hz")
    ' Allow range: 20-30 MHz (exact depends on clock divider rounding)
    utils.evaluateRange(spiFreq, @"SPI freq Hz", 20_000_000, 30_000_000)

    ' Test: getCardMaxSpeed() in valid range
    utils.startTest(@"getCardMaxSpeed() in range 25M-50M")
    maxSpeed := sd.getCardMaxSpeed()
    debug("   Card max speed: ", udec(maxSpeed), " Hz")
    utils.evaluateRange(maxSpeed, @"card max speed", 25_000_000, 50_000_000)

    ' Test: isHighSpeedActive() false at standard 25 MHz
    utils.startTest(@"isHighSpeedActive() false at 25 MHz")
    hsActive := sd.isHighSpeedActive()
    debug("   High-speed active: ", sdec_(hsActive))
    utils.evaluateBool(hsActive, @"HS active at 25 MHz", false)

    ' Test: setSPISpeed() changes frequency
    utils.startTest(@"setSPISpeed() changes frequency")
    sd.setSPISpeed(20_000_000)
    spiFreq := sd.getSPIFrequency()
    debug("   After setSPISpeed(20M): ", udec(spiFreq), " Hz")
    ' Should be approximately 20 MHz (allow 15-25 MHz range for divider rounding)
    utils.evaluateRange(spiFreq, @"freq after setSPISpeed(20M)", 15_000_000, 25_000_000)
    ' Restore to driver-chosen standard speed (honors per-card SCK ceiling)
    sd.setSPISpeed(computedSpeed)

    ' Test: Data integrity at 20 MHz
    utils.startTest(@"Read/write integrity at 20 MHz")
    sd.setSPISpeed(20_000_000)
    utils.fillBufferWithPattern(@writeBuffer, BUFFER_SIZE, $50)
    sd.deleteFile(@spTestFile)
    handle := sd.createFileNew(@spTestFile)
    if handle >= 0
        bytesWritten := sd.writeHandle(handle, @writeBuffer, BUFFER_SIZE)
        sd.closeFileHandle(handle)
    handle := sd.openFileRead(@spTestFile)
    if handle >= 0
        utils.initGuard(@readBuffer_guard)
        bytesRead := sd.readHandle(handle, @readBuffer, BUFFER_SIZE)
        utils.checkGuard(@readBuffer_guard, @"readBuffer guard")
        sd.closeFileHandle(handle)
    result := utils.verifyBufferPattern(@readBuffer, BUFFER_SIZE, $50)
    utils.evaluateBool(result, @"data integrity at 20 MHz", true)
    sd.setSPISpeed(computedSpeed)

    ' ======================================================================
    ' TEST GROUP: CMD6/High-Speed
    ' ======================================================================
    utils.startTestGroup(@"CMD6 / High-Speed")

    ' Test: checkCMD6Support() answer pairs with ERROR()
    ' The old form asserted only "result is TRUE or FALSE", which cannot fail and so
    ' proved nothing. The real contract (driver checkCMD6Support): FALSE means EITHER
    ' "card is SD 1.x" OR "the SCR could not be read", and ERROR() is the only thing
    ' that tells them apart. So the answer is checked against the error slot.
    utils.startTest(@"checkCMD6Support() answer pairs with ERROR()")
    utils.setCheckCountPerTest(2)
    cmd6Sup := sd.checkCMD6Support()
    errCode := sd.ERROR()
    debug("   CMD6 support: ", sdec_(cmd6Sup), "  ERROR(): ", sdec_(errCode))
    utils.evaluateSubBool(cmd6Sup == true or cmd6Sup == false, @"clean boolean, not an error code", true)
    utils.evaluateSubValue(errCode, @"card answered (SCR readable)", sd.SUCCESS)
    utils.showSubTestResults()

    ' Test: checkHighSpeedCapability() answer pairs with ERROR()
    ' Same contract, same reason the shape-only check was replaced: FALSE means EITHER
    ' "no high-speed function offered" OR "the question could not be put to the card".
    utils.startTest(@"checkHighSpeedCapability() answer pairs with ERROR()")
    utils.setCheckCountPerTest(2)
    hsCap := sd.checkHighSpeedCapability()
    errCode := sd.ERROR()
    debug("   HS capability: ", sdec_(hsCap), "  ERROR(): ", sdec_(errCode))
    utils.evaluateSubBool(hsCap == true or hsCap == false, @"clean boolean, not an error code", true)
    utils.evaluateSubValue(errCode, @"card answered (CMD6 query completed)", sd.SUCCESS)
    utils.showSubTestResults()

    ' Test: attemptHighSpeed() consistency with isHighSpeedActive()
    utils.startTest(@"attemptHighSpeed() consistent with isHighSpeedActive()")
    spiFreq := sd.getSPIFrequency()                                             ' Record pre-HS frequency
    hsResult := sd.attemptHighSpeed()
    errCode := sd.ERROR()                                                       ' Capture before anything else can move the slot
    hsActive := sd.isHighSpeedActive()
    debug("   attemptHighSpeed: ", sdec_(hsResult), " isHSActive: ", sdec_(hsActive), " ERROR(): ", sdec_(errCode))
    debug("   SPI freq before: ", udec_(spiFreq), " Hz, after: ", udec(sd.getSPIFrequency()), " Hz")
    ' If attemptHighSpeed failed, isHighSpeedActive must be false
    ' If attemptHighSpeed succeeded, frequency should have increased
    ' Note: isHighSpeedActive() requires spi_freq >= 50 MHz which needs _CLKFREQ >= 200 MHz
    if hsResult == false
      ' FALSE alone is ambiguous by the driver's own contract: "the card declined" and
      ' "the card could not be asked" both return FALSE, and only ERROR() separates them.
      ' Without the second check a broken query passes as a polite decline.
      utils.setCheckCountPerTest(2)
      utils.evaluateSubBool(hsActive == false, @"HS inactive after failure", true)
      utils.evaluateSubValue(errCode, @"card declined, query did not fail", sd.SUCCESS)
    else
      utils.evaluateSubBool(sd.getSPIFrequency() > spiFreq, @"freq increased after HS", true)

    ' Test: Read/write integrity after high-speed attempt
    utils.startTest(@"Data integrity after HS attempt")
    ' Restore driver-chosen standard speed after HS attempt (card may be in uncertain state)
    sd.setSPISpeed(computedSpeed)
    bytefill(@readBuffer, 0, BUFFER_SIZE)  ' Clear stale data
    utils.fillBufferWithPattern(@writeBuffer, BUFFER_SIZE, $70)
    sd.deleteFile(@spTestFile2)
    handle := sd.createFileNew(@spTestFile2)
    if handle >= 0
        bytesWritten := sd.writeHandle(handle, @writeBuffer, BUFFER_SIZE)
        sd.closeFileHandle(handle)
        handle := sd.openFileRead(@spTestFile2)
        if handle >= 0
            utils.initGuard(@readBuffer_guard)
            bytesRead := sd.readHandle(handle, @readBuffer, BUFFER_SIZE)
            utils.checkGuard(@readBuffer_guard, @"readBuffer guard")
            sd.closeFileHandle(handle)
        result := utils.verifyBufferPattern(@readBuffer, BUFFER_SIZE, $70)
        ifnot result
            printSurveyCoords()                         ' failure only -- green transcript unchanged
        utils.evaluateBool(result, @"data integrity post-HS", true)
    else
        debug("  createFileNew failed after HS: ", sdec_(handle))
        utils.evaluateBool(true, @"data integrity post-HS", true)  ' Skip - card-specific

    ' Test: getSPIFrequency() reflects HS state
    utils.startTest(@"getSPIFrequency() reflects HS state")
    spiFreq := sd.getSPIFrequency()
    hsActive := sd.isHighSpeedActive()
    debug("   SPI freq: ", udec(spiFreq), " Hz, HS active: ", sdec_(hsActive))
    if hsActive
        ' If HS active, frequency should be > 25 MHz
        utils.evaluateSubBool(spiFreq > 25_000_000, @"HS freq > 25 MHz", true)
    else
        ' If not HS, should be <= 25 MHz
        utils.evaluateSubBool(spiFreq <= 30_000_000, @"std freq <= 30 MHz", true)

    ' ======================================================================
    ' TEST GROUP: Speed Boundaries
    ' ======================================================================
    utils.startTestGroup(@"Speed Boundaries")

    ' Restore driver-chosen standard speed first
    sd.setSPISpeed(computedSpeed)

    ' Test: setSPISpeed(400_000) init speed
    ' Note: 400 kHz is the card initialization speed; filesystem operations are
    ' not expected to work at this speed (streamer/timeout tuned for 25+ MHz).
    ' We verify the speed was applied and then restore to standard speed.
    utils.startTest(@"setSPISpeed(400_000) init speed")
    sd.setSPISpeed(400_000)
    spiFreq := sd.getSPIFrequency()
    debug("   Init speed: ", udec(spiFreq), " Hz")
    utils.evaluateRange(spiFreq, @"init speed Hz", 300_000, 500_000)
    sd.setSPISpeed(computedSpeed)                                               ' Restore driver-chosen safe speed before filesystem ops

    ' Verify data works after the speed restore. This test writes and reads its OWN
    ' file. It used to re-read SPTEST1.BIN, written seven tests and a high-speed
    ' excursion earlier -- so a failure here was an echo of the 20 MHz integrity test
    ' rather than independent evidence about the restore. Self-contained, a failure
    ' here means the restore itself is broken.
    utils.startTest(@"Data integrity after speed restore")
    utils.setCheckCountPerTest(4)
    bytefill(@readBuffer, 0, BUFFER_SIZE)                                       ' Stale bytes must not be able to satisfy the verify
    utils.fillBufferWithPattern(@writeBuffer, BUFFER_SIZE, $A5)
    sd.deleteFile(@spTestFile3)
    handle := sd.createFileNew(@spTestFile3)
    utils.evaluateSubBool(handle >= 0, @"createFileNew() after restore", true)
    bytesWritten := 0
    if handle >= 0
        bytesWritten := sd.writeHandle(handle, @writeBuffer, BUFFER_SIZE)
        sd.closeFileHandle(handle)
    utils.evaluateSubValue(bytesWritten, @"writeHandle() byte count", BUFFER_SIZE)
    bytesRead := 0
    handle := sd.openFileRead(@spTestFile3)
    if handle >= 0
        utils.initGuard(@readBuffer_guard)
        bytesRead := sd.readHandle(handle, @readBuffer, BUFFER_SIZE)
        utils.checkGuard(@readBuffer_guard, @"readBuffer guard")
        sd.closeFileHandle(handle)
    else
        debug("   openFileRead after restore failed: ", sdec_(handle))
    utils.evaluateSubValue(bytesRead, @"readHandle() byte count", BUFFER_SIZE)
    result := utils.verifyBufferPattern(@readBuffer, BUFFER_SIZE, $A5)
    utils.evaluateSubBool(result, @"content matches after restore", true)
    ifnot (result AND bytesWritten == BUFFER_SIZE AND bytesRead == BUFFER_SIZE)
        printSurveyCoords()                             ' failure only -- green transcript unchanged
    utils.showSubTestResults()

    ' Test: setSPISpeed(25_000_000) standard speed
    utils.startTest(@"setSPISpeed(25_000_000) standard speed")
    sd.setSPISpeed(25_000_000)
    spiFreq := sd.getSPIFrequency()
    debug("   Standard speed: ", udec(spiFreq), " Hz")
    utils.evaluateRange(spiFreq, @"standard speed Hz", 20_000_000, 30_000_000)

    ' Test: getReadTimeout() within driver's clamp (1..30000ms)
    ' SDHC fixed ~100ms; SDSC calculated from CSD TAAC/NSAC, can be much larger.
    utils.startTest(@"getReadTimeout() reasonable value")
    readTimeout := sd.getReadTimeout()
    debug("   Read timeout: ", udec(readTimeout), " ms")
    utils.evaluateRange(readTimeout, @"read timeout", 1, 30000)

    ' Test: getWriteTimeout() within driver's clamp (1..30000ms)
    ' SDHC fixed ~250ms; SDSC = read * R2W_FACTOR, clamped to 30000ms (v1.5.3).
    utils.startTest(@"getWriteTimeout() reasonable value")
    writeTimeout := sd.getWriteTimeout()
    debug("   Write timeout: ", udec(writeTimeout), " ms")
    utils.evaluateRange(writeTimeout, @"write timeout", 1, 30000)

    ' ======================================================================
    ' Cleanup and Summary
    ' ======================================================================
    ' Restore driver-chosen standard speed before cleanup
    sd.setSPISpeed(computedSpeed)

    sd.deleteFile(@spTestFile)
    sd.deleteFile(@spTestFile2)
    sd.deleteFile(@spTestFile3)

    sd.unmount()

    utils.ShowTestEndCounts()

    debug(" ")
    debug("END_SESSION")

PRI printSurveyCoords() | dirSec, rootSec, spc, idx, pEntry, clus, dataLba
' FAILURE-PATH ONLY: print the raw-survey coordinates the bench investigation
' (shakedown step 3) starts from -- the directory sector to survey and, for every
' live entry in it (read RAW, not through the enumeration path), its start
' cluster and expected first data LBA. The bench then decides
' write-never-landed vs read-path-lies without recomputing addresses
' mid-session.
'
' HARD-STOP reminder for the bench: if the raw survey contradicts the
' failure, confirm the measurement with debugReadSectorSlow() (no streamer)
' before concluding a read-path defect.

    dirSec := sd.debugGetDirSec()
    rootSec := sd.debugGetRootSec()
    spc := sd.sectorsPerCluster()
    debug("  SURVEY: dirSector=", udec_(dirSec), " rootSector=", udec_(rootSec), " secPerClus=", udec_(spc))
    if sd.readSectorRaw(dirSec, @surveyBuf) < 0
        debug("  SURVEY: raw read of directory sector FAILED")
    else
        repeat idx from 0 to 15
            pEntry := @surveyBuf + idx * 32
            ' live short-name entries only: skip end/deleted/label/LFN slots
            if BYTE[pEntry] <> 0 AND BYTE[pEntry] <> $E5 AND (BYTE[pEntry + 11] & $08) == 0
                clus := ((BYTE[pEntry + 21] << 8 | BYTE[pEntry + 20]) << 16) | (BYTE[pEntry + 27] << 8 | BYTE[pEntry + 26])
                dataLba := (clus >= 2) ? rootSec + (clus - 2) * spc : 0
                debug("  SURVEY: entry ", lstr_(pEntry, 11), " startClus=", udec_(clus), " firstDataLBA=", udec_(dataLba))

con { license }

