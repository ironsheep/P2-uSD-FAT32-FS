'' =================================================================================================
''
''   File....... SD_RT_multicog_tests.spin2
''   Purpose.... This object exercises multi-cog safety: singleton pattern, concurrent access,
''               and API lock serialization of the SD card driver
''   Author..... Stephen M Moraco
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... JAN 2026
''   Updated.... 12 AUG 2026
''
'' =================================================================================================

CON

     _CLKFREQ        = 350_000_000

     ' SD card pin assignments
     ' Default: P2 Edge module SD slot. Build with -D SD_PINS_EXTERNAL
     ' to use the external SD header (base pin 16).
#ifdef SD_PINS_EXTERNAL
     SD_CS   = 20
     SD_MOSI = 19
     SD_MISO = 18
     SD_SCK  = 21
#else
     SD_CS   = 60
     SD_MOSI = 59
     SD_MISO = 58
     SD_SCK  = 61
#endif
     ' Multi-cog test configuration
     NUM_WORKER_COGS = 3             ' Number of concurrent test workers

     ' Hang-proofing budget: bounded wait gives up, records, and reaps instead
     ' of hanging the harness (see waitForWorkers)
     WORKER_TIMEOUT_POLLS = 3000     ' x 10ms polls = 30s generous worker-completion budget
     STACK_SIZE      = 128           ' Stack size per worker cog (longs)
     ITERATIONS      = 10            ' Number of iterations per stress test

     ' Worker status codes
     STATUS_IDLE      = 0
     STATUS_RUNNING   = 1
     STATUS_PASS      = 2
     STATUS_FAIL      = -1

OBJ
    sd    : "micro_sd_fat32_fs"
    utils : "isp_rt_utilities"

DAT

' Test files - created during test setup
testfile1       BYTE    "MCOG1.TXT", 0
testfile2       BYTE    "MCOG2.TXT", 0
testfile3       BYTE    "MCOG3.TXT", 0
testContent     BYTE    "Multi-cog test content 12345", 0

' Worker cog stacks
worker_stacks   LONG    0[NUM_WORKER_COGS * STACK_SIZE]

' Read buffers for worker cogs (separate from stacks!)
worker_buffers  BYTE    0[NUM_WORKER_COGS * 64]   ' 64 bytes per worker
worker_buffers_guard BYTE 0[16]

' Worker status and results (shared between cogs)
worker_status   LONG    0[NUM_WORKER_COGS]    ' Current status
worker_cogid    LONG    0[NUM_WORKER_COGS]    ' Cog ID returned from start()
worker_result   LONG    0[NUM_WORKER_COGS]    ' Test result (bytes read, etc.)
worker_errors   LONG    0[NUM_WORKER_COGS]    ' Error count

' Synchronization
sync_barrier    LONG    0                     ' Barrier for synchronized start
test_phase      LONG    0                     ' Current test phase

' Cog IDs of launched workers
launched_cogs   LONG    0[NUM_WORKER_COGS]

PUB go() | result, idx, firstCogId, allSame, totalErrors
'' Main entry point -- runs multi-cog concurrent access tests.

    debug(" ")
    debug("==============================================")
    debug("  SD Card Driver - Multi-Cog Safety Tests")
    debug("==============================================")
    debug(" ")
    debug("  Testing singleton pattern, concurrent access,")
    debug("  and API lock serialization with ", udec_(NUM_WORKER_COGS), " worker cogs")

    ' Initialize worker status
    repeat idx from 0 to NUM_WORKER_COGS - 1
        worker_status[idx] := STATUS_IDLE
        worker_cogid[idx] := -1
        worker_result[idx] := 0
        worker_errors[idx] := 0
        launched_cogs[idx] := -1

    ' ----------------------------------
    ' TEST GROUP: Singleton Pattern
    ' ----------------------------------
    utils.startTestGroup(@"Singleton Pattern Verification")

    utils.startTest(@"First start() returns valid cog ID")
    firstCogId := sd.start(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    utils.evaluateRange(firstCogId, @"start() cog ID", 0, 7)

    utils.startTest(@"Second start() returns SAME cog ID (singleton)")
    result := sd.start(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    utils.evaluateSingleValue(result, @"second start()", firstCogId)

    utils.startTest(@"Third start() returns SAME cog ID (singleton)")
    result := sd.start(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    utils.evaluateSingleValue(result, @"third start()", firstCogId)

    ' Mount the filesystem for subsequent tests
    utils.startTest(@"mount() succeeds")
    result := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    utils.evaluateSingleValue(result, @"mount()", sd.SUCCESS)

    if result < 0
        debug("ERROR: Could not mount SD card - aborting multi-cog tests!")
        utils.ShowTestEndCounts()                       ' 4 results are already recorded -- score them
        debug("END_SESSION")
        return

    ' Create the worker-cog fixture. Gated: every worker test reads this file,
    ' so a failed seed is one named, scored setup failure -- previously it
    ' debug-printed and fanned into every worker assertion, and ALSO turned
    ' the stress-completion test vacuous (workers complete fine while 100%
    ' of their operations fail against the missing file).
    ifnot utils.requireSetup(createTestFiles(), @"SETUP: create worker fixture MCOG1.TXT")
        cleanupTestFiles()
        sd.unmount()
        utils.ShowTestEndCounts()
        debug("END_SESSION")
        return

    ' ----------------------------------
    ' TEST GROUP: Multi-Cog Singleton Verification
    ' ----------------------------------
    utils.startTestGroup(@"Multi-Cog Singleton - All cogs see same driver")

    utils.startTest(@"Launch worker cogs to call start()")
    test_phase := 1   ' Singleton test phase
    sync_barrier := 0
    utils.initGuard(@worker_buffers_guard)

    ' Launch worker cogs
    repeat idx from 0 to NUM_WORKER_COGS - 1
        worker_status[idx] := STATUS_RUNNING
        launched_cogs[idx] := cogspin(NEWCOG, worker_singleton_test(idx), @worker_stacks[idx * STACK_SIZE])
        if launched_cogs[idx] == -1
            debug("  FAIL: Could not launch worker cog ", udec_(idx))
            worker_status[idx] := STATUS_FAIL

    ' Release workers
    sync_barrier := 1
    utils.recordPass()  ' Workers launched successfully

    ' Wait for all workers to complete
    waitForWorkers()
    utils.checkGuard(@worker_buffers_guard, @"worker_buffers guard")

    ' Verify all workers got the same cog ID
    utils.startTest(@"All workers see same cog ID (singleton)")
    allSame := true
    repeat idx from 0 to NUM_WORKER_COGS - 1
        if worker_cogid[idx] <> firstCogId
            allSame := false
            debug("  Worker ", udec_(idx), " got cog ID ", sdec_(worker_cogid[idx]), " (expected ", udec_(firstCogId), ")")
    utils.evaluateBool(allSame, @"All workers see same cog ID", true)

    utils.startTest(@"All workers report success")
    totalErrors := 0
    repeat idx from 0 to NUM_WORKER_COGS - 1
        if worker_status[idx] <> STATUS_PASS
            totalErrors++
            debug("  Worker ", udec_(idx), " status: ", sdec_(worker_status[idx]))
    utils.evaluateSingleValue(totalErrors, @"Worker failures", 0)

    ' Stop worker cogs
    stopWorkerCogs()

    ' ----------------------------------
    ' TEST GROUP: Concurrent Read Operations
    ' ----------------------------------
    utils.startTestGroup(@"Concurrent Read Operations")

    utils.startTest(@"Launch workers for concurrent file reads")
    test_phase := 2   ' Concurrent read phase
    sync_barrier := 0
    utils.initGuard(@worker_buffers_guard)

    ' Reset worker status
    repeat idx from 0 to NUM_WORKER_COGS - 1
        worker_status[idx] := STATUS_RUNNING
        worker_result[idx] := 0
        worker_errors[idx] := 0

    ' Launch worker cogs
    repeat idx from 0 to NUM_WORKER_COGS - 1
        launched_cogs[idx] := cogspin(NEWCOG, worker_read_test(idx), @worker_stacks[idx * STACK_SIZE])
        if launched_cogs[idx] == -1
            debug("  FAIL: Could not launch worker cog ", udec_(idx))
            worker_status[idx] := STATUS_FAIL

    ' Release workers
    sync_barrier := 1
    utils.recordPass()  ' Workers launched successfully

    ' Wait for all workers to complete
    waitForWorkers()
    utils.checkGuard(@worker_buffers_guard, @"worker_buffers guard")

    ' NOTE: Due to driver limitation (one open file at a time), interleaved
    ' open/read/close operations may fail when another cog's openFile() resets
    ' file state. We verify that operations COMPLETE (no deadlock/crash) and
    ' that at least ONE worker succeeds (proves the lock mechanism works).
    utils.startTest(@"Concurrent operations completed (lock mechanism works)")
    totalErrors := 0
    repeat idx from 0 to NUM_WORKER_COGS - 1
        if worker_status[idx] == STATUS_PASS
            debug("  Worker ", udec_(idx), ": read ", udec_(worker_result[idx]), " bytes OK")
        else
            debug("  Worker ", udec_(idx), ": status=", sdec_(worker_status[idx]), " (expected due to shared file state)")
            totalErrors++
    ' At least one worker should succeed to prove lock serialization works
    utils.evaluateRange(totalErrors, @"Failed workers (0-2 acceptable)", 0, NUM_WORKER_COGS - 1)

    ' Stop worker cogs
    stopWorkerCogs()

    ' ----------------------------------
    ' TEST GROUP: Stress Test - Rapid Sequential Access
    ' ----------------------------------
    utils.startTestGroup(@"Stress Test - Rapid Sequential Access")

    utils.startTest(@"Launch workers for stress test")
    test_phase := 3   ' Stress test phase
    sync_barrier := 0
    utils.initGuard(@worker_buffers_guard)

    ' Reset worker status
    repeat idx from 0 to NUM_WORKER_COGS - 1
        worker_status[idx] := STATUS_RUNNING
        worker_result[idx] := 0
        worker_errors[idx] := 0

    ' Launch worker cogs
    repeat idx from 0 to NUM_WORKER_COGS - 1
        launched_cogs[idx] := cogspin(NEWCOG, worker_stress_test(idx), @worker_stacks[idx * STACK_SIZE])
        if launched_cogs[idx] == -1
            debug("  FAIL: Could not launch worker cog ", udec_(idx))
            worker_status[idx] := STATUS_FAIL

    ' Release workers
    sync_barrier := 1
    utils.recordPass()  ' Workers launched successfully

    ' Wait for all workers to complete
    waitForWorkers()
    utils.checkGuard(@worker_buffers_guard, @"worker_buffers guard")

    ' NOTE: Stress test verifies lock mechanism under load. Due to single-file
    ' limitation, some operations fail when interleaved, but this proves the
    ' lock prevents crashes and operations complete safely.
    utils.startTest(@"Stress test completed (no crashes, lock works under load)")
    utils.setCheckCountPerTest(1 + NUM_WORKER_COGS)
    totalErrors := 0
    repeat idx from 0 to NUM_WORKER_COGS - 1
        debug("  Worker ", udec_(idx), ": ", udec_(worker_result[idx]), " iterations, ", udec_(worker_errors[idx]), " errors")
        if worker_result[idx] < ITERATIONS
            totalErrors++   ' Worker didn't complete all iterations
    ' All workers should complete all iterations (even if some ops fail)
    utils.evaluateSubValue(totalErrors, @"Workers that didn't complete", 0)
    ' ... but "completed" alone is vacuous: a worker whose every open/read
    ' failed still finishes its loop on time. Bound the failures per worker so
    ' total operational failure cannot score as a pass.
    repeat idx from 0 to NUM_WORKER_COGS - 1
        utils.evaluateSubBool(worker_errors[idx] < ITERATIONS, @"worker had at least one clean iteration", true)
    utils.showSubTestResults()

    ' Stop worker cogs
    stopWorkerCogs()

    ' ----------------------------------
    ' TEST GROUP: Per-Cog Error Storage
    ' ----------------------------------
    utils.startTestGroup(@"Per-Cog Error Storage")

    utils.startTest(@"error() returns value for calling cog")
    ' This tests that error() uses COGID() correctly
    result := sd.error()  ' Should return 0 (SUCCESS) or last error
    debug("  Main cog error(): ", sdec_(result))
    utils.recordPass()

    ' Two cogs must not observe each other's error slots. This matters more under
    ' write-on-exit than it did before: every operation now WRITES the slot on
    ' success as well as failure, so a shared slot would let one cog's success
    ' erase another cog's error (or vice versa) on every single call.
    utils.startTest(@"One cog's failure does not disturb another cog's slot")
    utils.setCheckCountPerTest(3)

    ' Main cog: land a known-good operation so its own slot holds SUCCESS
    sd.deleteFile(@testfile3)
    result := sd.newDirectory(@testfile3)
    if result == sd.SUCCESS
        sd.deleteFile(@testfile3)
    utils.evaluateSubValue(sd.error(), @"main cog starts at SUCCESS", sd.SUCCESS)

    ' Worker cog: deliberately fail, and report what ITS slot holds.
    ' Only worker 0 runs here, so park the rest -- waitForWorkers() polls them all.
    repeat idx from 0 to NUM_WORKER_COGS - 1
        worker_status[idx] := STATUS_IDLE
    worker_result[0] := 0
    worker_status[0] := STATUS_RUNNING
    sync_barrier := 0
    launched_cogs[0] := cogspin(NEWCOG, worker_error_slot_test(0), @worker_stacks[0])
    if launched_cogs[0] == -1
        debug("  FAIL: Could not launch worker cog 0")
        worker_status[0] := STATUS_FAIL
    sync_barrier := 1
    waitForWorkers()

    utils.evaluateSubValue(worker_result[0], @"worker cog sees its own error", sd.E_INVALID_HANDLE)
    utils.evaluateSubValue(sd.error(), @"main cog slot still SUCCESS", sd.SUCCESS)
    utils.showSubTestResults()
    stopWorkerCogs()

    ' ----------------------------------
    ' TEST GROUP: Cleanup
    ' ----------------------------------
    utils.startTestGroup(@"Cleanup")

    ' Clean up test files
    cleanupTestFiles()

    utils.startTest(@"unmount() succeeds")
    result := sd.unmount()
    utils.evaluateSingleValue(result, @"unmount()", sd.SUCCESS)

    utils.startTest(@"stop() releases resources")
    sd.stop()
    debug("  stop(): completed")
    utils.recordPass()

    ' ----------------------------------
    ' Summary
    ' ----------------------------------
    utils.ShowTestEndCounts()

    debug(" ")
    debug("* Multi-Cog Safety Tests Complete")
    debug("END_SESSION")


' ═══════════════════════════════════════════════════════════════════════════
' WORKER COG METHODS
' ═══════════════════════════════════════════════════════════════════════════

PRI worker_singleton_test(worker_id) | cogResult
    ' Worker cog: Test that start() returns the singleton cog ID
    '
    ' @param worker_id - Worker cog identifier (0 or 1)
    ' @local cogResult - Cog ID returned by sd.start()

    ' Wait for barrier
    repeat until sync_barrier <> 0

    ' Call start() - should return same cog ID as main cog got
    cogResult := sd.start(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    worker_cogid[worker_id] := cogResult

    if cogResult >= 0 and cogResult <= 7
        worker_status[worker_id] := STATUS_PASS
    else
        worker_status[worker_id] := STATUS_FAIL

    ' Worker cog terminates here

PRI worker_read_test(worker_id) | handle, bytesRead
    ' Worker cog: Perform file read operations
    ' Each worker opens/reads/closes via handle API.
    '
    ' @param worker_id - Worker cog identifier (0 or 1)
    ' @local handle - File handle from openFileRead()
    ' @local bytesRead - Number of bytes successfully read

    ' Wait for barrier
    repeat until sync_barrier <> 0

    ' Open file for reading via handle
    handle := sd.openFileRead(@testfile1)
    if handle < 0
        worker_errors[worker_id]++
        worker_status[worker_id] := STATUS_FAIL
        return

    bytesRead := readFileToBuffer(worker_id, handle)
    worker_result[worker_id] := bytesRead

    sd.closeFileHandle(handle)

    if bytesRead > 0 and worker_errors[worker_id] == 0
        worker_status[worker_id] := STATUS_PASS
    else
        worker_status[worker_id] := STATUS_FAIL

PRI worker_error_slot_test(worker_id)
    ' Worker cog: fail one operation and report what THIS cog's error slot holds.
    ' The main cog checks its own slot is untouched, proving per-cog isolation
    ' under write-on-exit semantics.
    '
    ' @param worker_id - Worker cog identifier

    ' Wait for barrier
    repeat until sync_barrier <> 0

    sd.readHandle(99, @worker_buffers[worker_id * 64], 10)   ' invalid handle
    worker_result[worker_id] := sd.error()
    worker_status[worker_id] := STATUS_PASS

PRI worker_stress_test(worker_id) | iter, handle, bytesRead, expectedLen
    ' Worker cog: Rapid open/read/close cycles
    '
    ' @param worker_id - Worker cog identifier (0 or 1)
    ' @local iter - Current iteration counter (1 to ITERATIONS)
    ' @local handle - File handle from openFileRead()
    ' @local bytesRead - Number of bytes returned by readHandle()
    ' @local expectedLen - Expected file content length from strsize()

    ' Wait for barrier
    repeat until sync_barrier <> 0

    expectedLen := strsize(@testContent)

    repeat iter from 1 to ITERATIONS
        ' Open file
        handle := sd.openFileRead(@testfile1)
        if handle < 0
            worker_errors[worker_id]++
        else
            ' Read into worker's dedicated buffer (NOT stack!)
            bytesRead := sd.readHandle(handle, @worker_buffers[worker_id * 64], expectedLen)
            if bytesRead <> expectedLen
                worker_errors[worker_id]++

            ' Close file
            sd.closeFileHandle(handle)

        worker_result[worker_id] := iter

    if worker_errors[worker_id] == 0
        worker_status[worker_id] := STATUS_PASS
    else
        worker_status[worker_id] := STATUS_FAIL


' ═══════════════════════════════════════════════════════════════════════════
' HELPER METHODS
' ═══════════════════════════════════════════════════════════════════════════

PRI waitForWorkers() | idx, allDone
    ' Wait for all worker cogs to complete.
    '
    ' Bounded by a deliberately GENEROUS timeout (30s against a <1s typical
    ' completion) so the design intent survives: a worker that never finishes
    ' is a driver bug this suite exists to EXPOSE. The timeout exposes it
    ' loudly -- hung workers are marked STATUS_FAIL (their result checks then
    ' fail by name) and reaped -- instead of silently, by hanging the harness
    ' and costing the run its totals line.

    repeat WORKER_TIMEOUT_POLLS
        allDone := true
        repeat idx from 0 to NUM_WORKER_COGS - 1
            if worker_status[idx] == STATUS_RUNNING
                allDone := false
                quit

        if allDone
            return

        waitms(10)

    debug("  *** waitForWorkers TIMEOUT (30s): reaping hung worker cog(s) ***")
    repeat idx from 0 to NUM_WORKER_COGS - 1
        if worker_status[idx] == STATUS_RUNNING
            worker_status[idx] := STATUS_FAIL
            if launched_cogs[idx] <> -1
                cogstop(launched_cogs[idx])
                launched_cogs[idx] := -1


PRI stopWorkerCogs() | idx
    ' Stop all launched worker cogs

    repeat idx from 0 to NUM_WORKER_COGS - 1
        if launched_cogs[idx] <> -1
            cogstop(launched_cogs[idx])
            launched_cogs[idx] := -1


PRI readFileToBuffer(worker_id, handle) : bytesRead | fileSize, toRead
    ' Read file into worker's dedicated buffer (NOT the stack!)
    '
    ' @param worker_id - Worker cog identifier used to index into worker_buffers
    ' @param handle - Open file handle to read from
    ' @returns bytesRead - Number of bytes actually read into buffer
    ' @local fileSize - Total file size reported by fileSizeHandle()
    ' @local toRead - Clamped byte count (min of fileSize, 64)

    fileSize := sd.fileSizeHandle(handle)
    toRead := fileSize <# 64  ' Limit to 64 bytes to fit in worker buffer

    bytesRead := sd.readHandle(handle, @worker_buffers[worker_id * 64], toRead)

    if bytesRead <> toRead
        worker_errors[worker_id]++


PRI createTestFiles() : bOk | handle, expected
    ' Create the one fixture the worker cogs actually consume.
    '
    ' Only MCOG1.TXT is ever READ: every worker deliberately hammers the same
    ' file (single-file contention is what the stress test measures). MCOG2.TXT
    ' was created here for years and never touched by anyone; MCOG3.TXT's only
    ' use is as a scratch NAME whose test deletes it before creating a directory
    ' over it. Neither is a fixture, so neither is created -- the cleanup still
    ' deletes all three names to clear residue from older runs.
    '
    ' @returns bOk - TRUE only when the file was created, fully written, and closed
    ' @local handle - File handle from createFileNew()
    ' @local expected - Content length the write must land in full

    debug("  Creating test file for worker cogs...")

    bOk := false
    sd.deleteFile(@testfile1)
    sd.deleteFile(@testfile2)
    sd.deleteFile(@testfile3)

    handle := sd.createFileNew(@testfile1)
    if handle >= 0
        expected := strsize(@testContent)
        bOk := (sd.writeHandle(handle, @testContent, expected) == expected)
        if sd.closeFileHandle(handle) < 0
            bOk := false
        debug("    Created: ", zstr_(@testfile1))
    ifnot bOk
        debug("    FAILED to create: ", zstr_(@testfile1))


PRI cleanupTestFiles()
    ' Remove test files

    sd.deleteFile(@testfile1)
    sd.deleteFile(@testfile2)
    sd.deleteFile(@testfile3)
    debug("  Test files cleaned up")

con { license }

