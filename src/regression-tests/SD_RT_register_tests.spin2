'' =================================================================================================
''
''   File....... SD_RT_register_tests.spin2
''   Purpose.... This object tests CSD register access and timeout value APIs
''   Author..... Stephen M Moraco
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... FEB 2026
''   Updated.... 12 AUG 2026
''
'' =================================================================================================
''
'' Tests the following APIs:
''   - readCSDRaw() - CSD register raw read
''   - getReadTimeout() / getWriteTimeout() - timeout values
''   - cardSizeSectors() - capacity cross-check
''   - getCardMaxSpeed() - TRAN_SPEED cross-check
''
'' =================================================================================================

CON

     _CLKFREQ        = 350_000_000

     ' SD card pin assignments
     ' Default: P2 Edge module SD slot. Build with -D SD_PINS_EXTERNAL
     ' to use the external SD header (base pin 16).
#ifdef SD_PINS_EXTERNAL
     SD_CS   = 20
     SD_MOSI = 19
     SD_MISO = 18
     SD_SCK  = 21
#else
     SD_CS   = 60
     SD_MOSI = 59
     SD_MISO = 58
     SD_SCK  = 61
#endif
' Enable register and raw access
#ifdef __SPINTOOLS__
#define SD_INCLUDE_REGISTERS
#define SD_INCLUDE_RAW
#define SD_INCLUDE_SPEED
#elseifdef __FLEXSPIN__
#define SD_INCLUDE_REGISTERS
#pragma exportdef SD_INCLUDE_REGISTERS
#define SD_INCLUDE_RAW
#pragma exportdef SD_INCLUDE_RAW
#define SD_INCLUDE_SPEED
#pragma exportdef SD_INCLUDE_SPEED
#else
#pragma exportdef SD_INCLUDE_REGISTERS
#pragma exportdef SD_INCLUDE_RAW
#pragma exportdef SD_INCLUDE_SPEED
#endif

OBJ
    sd    : "micro_sd_fat32_fs"
    utils : "isp_rt_utilities"

DAT

' CSD register buffer (16 bytes)
csdBuf          BYTE    0[16]
csdBuf_guard    BYTE    0[16]

' CID (16), SCR (8), SD Status (64) register buffers
cidBuf          BYTE    0[16]
cidBuf_guard    BYTE    0[16]
scrBuf          BYTE    0[8]
scrBuf_guard    BYTE    0[16]
sdsBuf          BYTE    0[64]
sdsBuf_guard    BYTE    0[16]

PUB go() | result, csdVer, tranSpeed, capacity, cardSectors, readTimeout, writeTimeout, maxSpeed, bCsdOk, bCidOk, mid, ocr, idx, bOk, serial, mdtYear, mdtMon, eraseSectors, cmd6
'' Main entry point for register access regression tests

    debug(" ")
    debug("==============================================")
    debug("  SD Card Driver - Register & Timeout Tests")
    debug("==============================================")

    ' Mount the card first
    result := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    ifnot utils.requireSetup(result == 0, @"SETUP: mount SD card")
        debug("ERROR: Could not mount SD card!")
        utils.ShowTestEndCounts()
        debug("END_SESSION")
        return

    ' Show card info
    debug(" ")
    debug("* SD Card Information:")
    debug("   Volume Label: ", zstr_(sd.volumeLabel()))
    debug("   Free Space: ", udec(sd.freeSpace()), " sectors")

    ' ======================================================================
    ' TEST GROUP: readCSDRaw
    ' ======================================================================
    utils.startTestGroup(@"readCSDRaw")

    ' Test: readCSDRaw returns data
    utils.startTest(@"readCSDRaw() returns data successfully")
    bytefill(@csdBuf, 0, 16)
    utils.initGuard(@csdBuf_guard)
    result := sd.readCSDRaw(@csdBuf)
    utils.checkGuard(@csdBuf_guard, @"csdBuf guard")
    bCsdOk := (result == sd.SUCCESS)
    utils.evaluateSingleValue(result, @"readCSDRaw()", sd.SUCCESS)

    ' WHY bCsdOk EXISTS. csdBuf is zeroed before the read, so when readCSDRaw fails
    ' every field below reads as 0 -- and csdVer == 0 means "SDSC", which routes the
    ' capacity test into a branch that only asserts cardSectors > 0. That is true on
    ' any working card, so a total failure to read the CSD scored a PASS on the test
    ' whose whole job is to check the CSD. The derived tests now fail explicitly.

    ' Test: CSD version is valid (0 for SDSC, 1 for SDHC/SDXC)
    utils.startTest(@"CSD version is valid (0 or 1)")
    if bCsdOk
        csdVer := (csdBuf[0] >> 6) & $03
        debug("   CSD version: ", udec_(csdVer))
        utils.evaluateRange(csdVer, @"CSD_STRUCTURE", 0, 1)
    else
        utils.evaluateBool(false, @"CSD_STRUCTURE (CSD was never read)", true)

    ' Test: TRAN_SPEED is valid (byte 3 of CSD)
    utils.startTest(@"TRAN_SPEED is valid ($32-$5A)")
    if bCsdOk
        tranSpeed := csdBuf[3]
        debug("   TRAN_SPEED: $", uhex_(tranSpeed))
        ' $32 = 25 MHz, $5A = 50 MHz - standard values for SD cards
        utils.evaluateRange(tranSpeed, @"TRAN_SPEED byte", $32, $5A)
    else
        utils.evaluateBool(false, @"TRAN_SPEED byte (CSD was never read)", true)

    ' Test: Capacity > 0
    utils.startTest(@"Card capacity > 0 sectors")
    cardSectors := sd.cardSizeSectors()
    debug("   Card sectors: ", udec(cardSectors))
    utils.evaluateSubBool(cardSectors > 0, @"capacity > 0", true)

    ' Test: Capacity matches cardSizeSectors()
    utils.startTest(@"CSD capacity consistent with cardSizeSectors()")
    ' For CSD v1 (SDHC/SDXC), capacity = (C_SIZE + 1) * 1024 sectors
    ifnot bCsdOk
        utils.evaluateBool(false, @"CSD vs cardSizeSectors (CSD was never read)", true)
    elseif csdVer == 1
        ' C_SIZE is in CSD bytes 7-9 (bits 69:48)
        capacity := ((csdBuf[7] & $3F) << 16) | (csdBuf[8] << 8) | csdBuf[9]
        capacity := (capacity + 1) * 1024
        debug("   CSD computed sectors: ", udec(capacity))
        ' Should match within rounding
        utils.evaluateSingleValue(capacity, @"CSD vs cardSizeSectors", cardSectors)
    else
        ' SDSC: more complex calculation, just verify non-zero
        utils.evaluateSubBool(cardSectors > 0, @"SDSC capacity > 0", true)

    ' Test: readCSDRaw works via initCardOnly path (unmounted)
    utils.startTest(@"readCSDRaw() works after initCardOnly")
    sd.unmount()
    result := sd.initCardOnly(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    utils.evaluateSubValue(result, @"initCardOnly()", sd.SUCCESS)
    bytefill(@csdBuf, 0, 16)
    utils.initGuard(@csdBuf_guard)
    result := sd.readCSDRaw(@csdBuf)
    utils.checkGuard(@csdBuf_guard, @"csdBuf guard")
    utils.evaluateSubValue(result, @"readCSDRaw() unmounted", sd.SUCCESS)
    ' Verify same version
    result := (csdBuf[0] >> 6) & $03
    utils.evaluateSubValue(result, @"CSD version matches", csdVer)
    sd.stop()

    ' Remount for timeout tests. Scored: without the named failure, an abort
    ' here would print all-green partial totals and read as a passing run.
    result := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    ifnot utils.requireSetup(result == 0, @"SETUP: remount for timeout tests")
        debug("ERROR: Could not remount!")
        utils.ShowTestEndCounts()
        debug("END_SESSION")
        return

    ' ======================================================================
    ' TEST GROUP: Timeout Values
    ' ======================================================================
    utils.startTestGroup(@"Timeout Values")

    ' Test: getReadTimeout() within driver's clamp (1..30000ms)
    ' SDHC fixed ~100ms; SDSC calculated from CSD TAAC/NSAC, can be much larger.
    utils.startTest(@"getReadTimeout() in reasonable range")
    readTimeout := sd.getReadTimeout()
    debug("   Read timeout: ", udec(readTimeout), " ms")
    utils.evaluateRange(readTimeout, @"read timeout ms", 1, 30000)

    ' Test: getWriteTimeout() within driver's clamp (1..30000ms)
    ' SDHC fixed ~250ms; SDSC = read * R2W_FACTOR, clamped to 30000ms (v1.5.3).
    utils.startTest(@"getWriteTimeout() in reasonable range")
    writeTimeout := sd.getWriteTimeout()
    debug("   Write timeout: ", udec(writeTimeout), " ms")
    utils.evaluateRange(writeTimeout, @"write timeout ms", 1, 30000)

    ' Test: Write timeout >= read timeout
    utils.startTest(@"Write timeout >= read timeout")
    utils.evaluateSubBool(writeTimeout >= readTimeout, @"write >= read", true)

    ' Test: TRAN_SPEED matches getCardMaxSpeed()
    utils.startTest(@"TRAN_SPEED consistent with getCardMaxSpeed()")
    maxSpeed := sd.getCardMaxSpeed()
    debug("   Card max speed: ", udec(maxSpeed), " Hz")
    ' 25 MHz = $32 TRAN_SPEED, 50 MHz = $5A TRAN_SPEED
    if tranSpeed == $32
        utils.evaluateSingleValue(maxSpeed, @"25 MHz from $32", 25_000_000)
    elseif tranSpeed == $5A
        utils.evaluateSingleValue(maxSpeed, @"50 MHz from $5A", 50_000_000)
    else
        ' Other TRAN_SPEED values - just check range
        utils.evaluateRange(maxSpeed, @"max speed Hz", 25_000_000, 50_000_000)

    ' ======================================================================
    ' TEST GROUP: CID / SCR / SD Status / OCR (G-2)
    ' ======================================================================
    ' These registers had ZERO regression coverage -- the worker commands
    ' behind the read*Raw calls were the only non-debug commands with no
    ' regression path. The cached getters (getOCR, getManufacturerID,
    ' eraseBlockSectors) never touch set_error(), so nothing here judges
    ' them via error() -- returned values only.
    utils.startTestGroup(@"CID / SCR / SD Status / OCR")

    utils.startTest(@"readCIDRaw() returns valid CID")
    utils.setCheckCountPerTest(4)
    bytefill(@cidBuf, 0, 16)
    utils.initGuard(@cidBuf_guard)
    result := sd.readCIDRaw(@cidBuf)
    bCidOk := (result == sd.SUCCESS)
    utils.evaluateSubValue(result, @"readCIDRaw() status", sd.SUCCESS)
    utils.evaluateSubBool(bCidOk AND (cidBuf[15] & 1) == 1, @"CRC7 stop bit set", true)
    mid := sd.getManufacturerID()
    utils.evaluateSubBool(bCidOk AND cidBuf[0] == mid, @"CID MID == getManufacturerID()", true)
    ' MDT: bytes 13-14 hold reserved(4) year-since-2000(8) month(4)
    mdtYear := ((cidBuf[13] & $0F) << 4) | (cidBuf[14] >> 4)
    mdtMon := cidBuf[14] & $0F
    utils.evaluateSubBool(bCidOk AND mdtMon >= 1 AND mdtMon <= 12 AND mdtYear >= 1 AND mdtYear <= 45, @"MDT plausible (2001-2045)", true)
    ' PNM (bytes 3-7): the SD spec calls for printable ASCII, but OEM cards ship
    ' non-printable product names in the field (observed: Gigastone OEM ASTC).
    ' The driver's contract is faithful register transport, not card conformance,
    ' so printability is INFORMATIONAL -- scored structural checks above already
    ' cover delivery. Non-printables appear as hex in the transcript line below.
    bOk := bCidOk
    repeat idx from 3 to 7
        if cidBuf[idx] < $20 OR cidBuf[idx] > $7E
            bOk := false
    debug("   CID PNM bytes 3-7: ", uhex_byte_array_(@cidBuf[3], 5), bOk ? @" (printable ASCII)" : @" (NOT printable ASCII - card quirk, informational)")
    utils.checkGuard(@cidBuf_guard, @"cidBuf guard")
    ' Transcript record for cross-checking against DOCs/cards/
    serial := (cidBuf[9] << 24) | (cidBuf[10] << 16) | (cidBuf[11] << 8) | cidBuf[12]
    debug("   CID: MID=$", uhex_(mid), " PSN=$", uhex_long_(serial))
    utils.showSubTestResults()

    utils.startTest(@"readSCRRaw() returns valid SCR")
    utils.setCheckCountPerTest(4)
    bytefill(@scrBuf, 0, 8)
    utils.initGuard(@scrBuf_guard)
    result := sd.readSCRRaw(@scrBuf)
    utils.evaluateSubValue(result, @"readSCRRaw() status", sd.SUCCESS)
    utils.evaluateSubBool((scrBuf[0] >> 4) == 0, @"SCR_STRUCTURE == 0", true)
    ' checkCMD6Support() is literally SD_SPEC >= 2 read from a fresh SCR --
    ' the two sources must agree
    cmd6 := sd.checkCMD6Support()
    utils.evaluateSubBool(((scrBuf[0] & $0F) >= 2) == (cmd6 <> 0), @"SD_SPEC >= 2 iff checkCMD6Support", true)
    utils.evaluateSubBool((scrBuf[1] & $01) == 1, @"1-bit bus width supported (mandatory)", true)
    utils.checkGuard(@scrBuf_guard, @"scrBuf guard")
    utils.showSubTestResults()

    utils.startTest(@"readSDStatusRaw() returns valid SD Status")
    utils.setCheckCountPerTest(3)
    bytefill(@sdsBuf, 0, 64)
    utils.initGuard(@sdsBuf_guard)
    result := sd.readSDStatusRaw(@sdsBuf)
    utils.evaluateSubValue(result, @"readSDStatusRaw() status", sd.SUCCESS)
    utils.evaluateSubBool((sdsBuf[0] >> 6) == 0, @"DAT_BUS_WIDTH is 1-bit (SPI mode)", true)
    utils.evaluateSubBool(sdsBuf[8] <= 4, @"SPEED_CLASS in range (0-4)", true)
    utils.checkGuard(@sdsBuf_guard, @"sdsBuf guard")
    debug("   SD Status: SPEED_CLASS=", udec_(sdsBuf[8]))
    utils.showSubTestResults()

    utils.startTest(@"getOCR() cached value is coherent")
    utils.setCheckCountPerTest(2)
    ocr := sd.getOCR()
    debug("   OCR: $", uhex_long_(ocr))
    utils.evaluateSubBool(((ocr >> 31) & 1) == 1, @"OCR ready bit set", true)
    ifnot bCsdOk
        utils.evaluateSubBool(false, @"CCS agrees with CSD version (CSD never read)", true)
    else
        ' CCS (bit 30) is 1 exactly for SDHC/SDXC -- the same identity CSD
        ' version 1 asserts
        utils.evaluateSubBool(((ocr >> 30) & 1) == csdVer, @"CCS agrees with CSD version", true)
    utils.showSubTestResults()

    utils.startTest(@"getManufacturerID() is nonzero")
    utils.evaluateNotZero(mid, @"manufacturer ID")

    utils.startTest(@"eraseBlockSectors() power-of-two, CSD-consistent")
    utils.setCheckCountPerTest(2)
    eraseSectors := sd.eraseBlockSectors()
    debug("   Erase block: ", udec_(eraseSectors), " sectors")
    utils.evaluateSubBool(eraseSectors > 0 AND (eraseSectors & (eraseSectors - 1)) == 0, @"power of two", true)
    ifnot bCsdOk
        utils.evaluateSubBool(false, @"erase block vs CSD (CSD never read)", true)
    elseif csdVer == 1
        utils.evaluateSubValue(eraseSectors, @"CSD v2 fixed 64KB erase block", 128)
    else
        utils.evaluateSubBool(eraseSectors >= 1 AND eraseSectors <= 128, @"CSD v1 erase block range", true)
    utils.showSubTestResults()

    ' ======================================================================
    ' TEST GROUP: Register Reads In RAW Mode (G-2)
    ' ======================================================================
    ' Register commands fall outside both worker mode-gate ranges, so they
    ' must serve in MODE_RAW exactly as mounted -- mirroring the
    ' CSD-after-initCardOnly test above.
    utils.startTestGroup(@"Register Reads In RAW Mode")

    utils.startTest(@"CID/SCR/SDStatus readable after initCardOnly")
    utils.setCheckCountPerTest(5)
    sd.unmount()
    result := sd.initCardOnly(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    utils.evaluateSubValue(result, @"initCardOnly()", sd.SUCCESS)
    bytefill(@cidBuf, 0, 16)
    utils.initGuard(@cidBuf_guard)
    result := sd.readCIDRaw(@cidBuf)
    utils.checkGuard(@cidBuf_guard, @"cidBuf guard (RAW)")
    utils.evaluateSubValue(result, @"readCIDRaw() in RAW", sd.SUCCESS)
    utils.evaluateSubBool(cidBuf[0] == mid, @"MID matches mounted read", true)
    bytefill(@scrBuf, 0, 8)
    utils.initGuard(@scrBuf_guard)
    result := sd.readSCRRaw(@scrBuf)
    utils.checkGuard(@scrBuf_guard, @"scrBuf guard (RAW)")
    utils.evaluateSubValue(result, @"readSCRRaw() in RAW", sd.SUCCESS)
    bytefill(@sdsBuf, 0, 64)
    utils.initGuard(@sdsBuf_guard)
    result := sd.readSDStatusRaw(@sdsBuf)
    utils.checkGuard(@sdsBuf_guard, @"sdsBuf guard (RAW)")
    utils.evaluateSubValue(result, @"readSDStatusRaw() in RAW", sd.SUCCESS)
    utils.showSubTestResults()
    sd.stop()

    ' ======================================================================
    ' Cleanup and Summary
    ' ======================================================================
    ' (driver stopped by the RAW-mode group; the unmount below is a
    ' harmless no-op kept for shape)
    sd.unmount()

    utils.ShowTestEndCounts()

    debug(" ")
    debug("END_SESSION")

con { license }

