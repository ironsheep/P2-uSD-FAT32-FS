'' =================================================================================================
''
''   File....... SD_RT_mount_tests.spin2
''   Purpose.... This object exercises mount/unmount and basic card operations
''   Author..... Stephen M Moraco
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... JAN 2026
''   Updated.... 12 AUG 2026
''
'' =================================================================================================

CON

     _CLKFREQ        = 350_000_000

     ' Enable INIT + MOUNT + RECOVER debug channels for this diagnostic run.
     ' Bits per driver: CH_INIT=0, CH_MOUNT=1, CH_RECOVER=9.
     DEBUG_MASK      = (1 << 0) | (1 << 1) | (1 << 9)
     DEBUG_BAUD      = 2_000_000

     ' SD card pin assignments
     ' Default: P2 Edge module SD slot. Build with -D SD_PINS_EXTERNAL
     ' to use the external SD header (base pin 16).
#ifdef SD_PINS_EXTERNAL
     SD_CS   = 20
     SD_MOSI = 19
     SD_MISO = 18
     SD_SCK  = 21
#else
     SD_CS   = 60
     SD_MOSI = 59
     SD_MISO = 58
     SD_SCK  = 61
#endif

' Enable raw sector access and debug diagnostics
' Uncomment SD_INCLUDE_STACK_CHECK to measure worker cog stack depth
#ifdef __SPINTOOLS__
#define SD_INCLUDE_RAW
#define SD_INCLUDE_DEBUG
#define SD_INCLUDE_STACK_CHECK
#elseifdef __FLEXSPIN__
#define SD_INCLUDE_RAW
#pragma exportdef SD_INCLUDE_RAW
#define SD_INCLUDE_DEBUG
#pragma exportdef SD_INCLUDE_DEBUG
#define SD_INCLUDE_STACK_CHECK
#pragma exportdef SD_INCLUDE_STACK_CHECK
#else
#define SD_INCLUDE_STACK_CHECK
#pragma exportdef SD_INCLUDE_RAW
#pragma exportdef SD_INCLUDE_DEBUG
#pragma exportdef SD_INCLUDE_STACK_CHECK
#endif

OBJ
    sd    : "micro_sd_fat32_fs"
    utils : "isp_rt_utilities"

DAT

testfile1       BYTE    "TEST1.TXT", 0
sectorBuffer    BYTE    0[512]
sectorBuffer_guard BYTE 0[16]
saveBuffer      BYTE    0[512]                          ' corruption group: pristine copy for restore
saveBuffer_guard BYTE   0[16]

PUB go() | result, pLabel, freeSpace, handle, bytesRead, vbrSec, fsiSec
'' Main entry point for mount/unmount regression tests
''
'' Tests SD card mount, unmount, and basic card operations

    debug(" ")
    debug("==============================================")
    debug("  SD Card Driver - Mount/Unmount Tests")
    debug("==============================================")

    ' ----------------------------------
    ' TEST GROUP: Operations before mount
    ' ----------------------------------
    utils.startTestGroup(@"Operations before mount should fail gracefully")

    ' These operations should not crash when card isn't mounted
    utils.startTest(@"openFileRead() before mount")
    result := sd.openFileRead(@testfile1)
    utils.evaluateBool(result >= 0, @"openFileRead()", false)

    utils.startTest(@"createFileNew() before mount")
    result := sd.createFileNew(@testfile1)
    utils.evaluateBool(result >= 0, @"createFileNew()", false)

    utils.startTest(@"freeSpace() before mount")
    freeSpace := sd.freeSpace()
    utils.evaluateSingleValue(freeSpace, @"freeSpace()", 0)

    ' ----------------------------------
    ' TEST GROUP: Pre-Mount Error Validation
    ' ----------------------------------
    utils.startTestGroup(@"Pre-Mount Error Validation")

    utils.startTest(@"openFileRead() before mount returns E_NOT_MOUNTED")
    handle := sd.openFileRead(@testfile1)
    utils.evaluateSingleValue(handle, @"openFileRead()", sd.E_NOT_MOUNTED)

    utils.startTest(@"createFileNew() before mount returns E_NOT_MOUNTED")
    handle := sd.createFileNew(@testfile1)
    utils.evaluateSingleValue(handle, @"createFileNew()", sd.E_NOT_MOUNTED)

    utils.startTest(@"readSectorRaw() before mount returns error")
    utils.initGuard(@sectorBuffer_guard)
    result := sd.readSectorRaw(0, @sectorBuffer)
    utils.checkGuard(@sectorBuffer_guard, @"sectorBuffer guard")
    utils.evaluateSingleValue(result, @"readSectorRaw()", sd.E_NOT_MOUNTED)

    utils.startTest(@"changeDirectory() before mount returns error")
    result := sd.changeDirectory(@"TESTDIR")
    utils.evaluateSingleValue(result, @"changeDirectory()", sd.E_NOT_MOUNTED)

    ' ----------------------------------
    ' TEST GROUP: Pin offset validation
    ' ----------------------------------
    utils.startTestGroup(@"Pin offset validation (B-input +/-3 limit)")

    utils.startTest(@"mount() with SCK too far from MOSI (offset=+5)")
    result := sd.mount(SD_CS, 10, SD_MISO, 15)
    utils.evaluateSingleValue(result, @"mount(bad pins)", sd.E_BAD_PIN_CONFIG)

    utils.startTest(@"mount() with SCK too far from MISO (offset=-4)")
    result := sd.mount(SD_CS, SD_MOSI, 20, 16)
    utils.evaluateSingleValue(result, @"mount(bad pins)", sd.E_BAD_PIN_CONFIG)

    ' ----------------------------------
    ' TEST GROUP: Mount card
    ' ----------------------------------
    utils.startTestGroup(@"Mount SD card")

    utils.startTest(@"mount() with valid pins")
    result := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    utils.evaluateSingleValue(result, @"mount()", sd.SUCCESS)

    ' DIAGNOSTIC: Show CMD13 and CRC state after mount attempt
    debug(" ")
    debug("  DIAG: error()=", sdec_(sd.error()))
    debug("  DIAG: lastCMD13=$", uhex_(sd.getLastCMD13()), " lastCMD13Error=$", uhex_(sd.getLastCMD13Error()))
    debug("  DIAG: CRC match=", udec_(sd.getCRCMatchCount()), " mismatch=", udec_(sd.getCRCMismatchCount()), " retry=", udec_(sd.getCRCRetryCount()))
    debug("  DIAG: recvCRC=$", uhex_(sd.getLastReceivedCRC()), " calcCRC=$", uhex_(sd.getLastCalculatedCRC()))
    ' Read sector 0 raw to inspect MBR partition table bytes
    utils.initGuard(@sectorBuffer_guard)
    if sd.readSectorRaw(0, @sectorBuffer) == sd.SUCCESS
      utils.checkGuard(@sectorBuffer_guard, @"sectorBuffer guard")
      debug("  DIAG MBR: sig=$", uhex_byte_(sectorBuffer[sd.BOOT_SIG_OFFSET]), " $", uhex_byte_(sectorBuffer[sd.BOOT_SIG_OFFSET + 1]))
      debug("  DIAG MBR: part1 type=$", uhex_byte_(sectorBuffer[sd.MBR_PART_TYPE_OFFSET]), " lba=$", uhex_byte_(sectorBuffer[sd.MBR_PART_LBA_OFFSET + 3]), uhex_byte_(sectorBuffer[sd.MBR_PART_LBA_OFFSET + 2]), uhex_byte_(sectorBuffer[sd.MBR_PART_LBA_OFFSET + 1]), uhex_byte_(sectorBuffer[sd.MBR_PART_LBA_OFFSET]))
      debug("  DIAG MBR[0..7]: $", uhex_byte_(sectorBuffer[0]), " $", uhex_byte_(sectorBuffer[1]), " $", uhex_byte_(sectorBuffer[2]), " $", uhex_byte_(sectorBuffer[3]), " $", uhex_byte_(sectorBuffer[4]), " $", uhex_byte_(sectorBuffer[5]), " $", uhex_byte_(sectorBuffer[6]), " $", uhex_byte_(sectorBuffer[7]))
    else
      debug("  DIAG: readSectorRaw(0) FAILED")

    utils.startTest(@"Verify card is accessible - get volume label")
    pLabel := sd.volumeLabel()
    utils.evaluateNotZero(pLabel, @"volumeLabel() pointer")

    utils.startTest(@"Verify free space is reasonable")
    freeSpace := sd.freeSpace()
    utils.evaluateRange(freeSpace, @"freeSpace()", 1, $7FFF_FFFF)

    debug(" ")
    debug("  Card Info:")
    debug("    Volume Label: ", zstr_(pLabel))
    debug("    Free Space: ", udec_(freeSpace), " sectors (", udec_(freeSpace / 2048), " MB)")

    ' ----------------------------------
    ' TEST GROUP: Unmount card
    ' ----------------------------------
    utils.startTestGroup(@"Unmount SD card")

    utils.startTest(@"unmount() card")
    result := sd.unmount()
    utils.evaluateSingleValue(result, @"unmount()", sd.SUCCESS)

    utils.startTest(@"Operations after unmount should fail")
    freeSpace := sd.freeSpace()
    utils.evaluateSingleValue(freeSpace, @"freeSpace() after unmount", 0)

    ' ----------------------------------
    ' TEST GROUP: Remount card
    ' ----------------------------------
    utils.startTestGroup(@"Remount SD card")

    utils.startTest(@"mount() again")
    result := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    utils.evaluateSingleValue(result, @"mount() second time", sd.SUCCESS)

    ' DIAGNOSTIC: Show CMD13 and CRC state after remount attempt
    debug("  DIAG2: error()=", sdec_(sd.error()))
    debug("  DIAG2: lastCMD13=$", uhex_(sd.getLastCMD13()), " lastCMD13Error=$", uhex_(sd.getLastCMD13Error()))
    debug("  DIAG2: CRC match=", udec_(sd.getCRCMatchCount()), " mismatch=", udec_(sd.getCRCMismatchCount()), " retry=", udec_(sd.getCRCRetryCount()))

    utils.startTest(@"Card still accessible after remount")
    freeSpace := sd.freeSpace()
    utils.evaluateRange(freeSpace, @"freeSpace() after remount", 1, $7FFF_FFFF)

    ' ----------------------------------
    ' TEST GROUP: Multiple mount calls
    ' ----------------------------------
    utils.startTestGroup(@"Multiple mount/unmount cycles")

    utils.startTest(@"unmount()")
    result := sd.unmount()
    utils.evaluateSingleValue(result, @"unmount()", sd.SUCCESS)

    utils.startTest(@"mount() cycle 1")
    result := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    utils.evaluateSingleValue(result, @"mount()", sd.SUCCESS)

    utils.startTest(@"unmount()")
    result := sd.unmount()
    utils.evaluateSingleValue(result, @"unmount()", sd.SUCCESS)

    utils.startTest(@"mount() cycle 2")
    result := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    utils.evaluateSingleValue(result, @"mount()", sd.SUCCESS)

    utils.startTest(@"unmount()")
    result := sd.unmount()
    utils.evaluateSingleValue(result, @"unmount()", sd.SUCCESS)

    utils.startTest(@"mount() cycle 3")
    result := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    utils.evaluateSingleValue(result, @"mount()", sd.SUCCESS)

    utils.startTest(@"Card still works after 3 mount/unmount cycles")
    freeSpace := sd.freeSpace()
    utils.evaluateRange(freeSpace, @"freeSpace()", 1, $7FFF_FFFF)

    ' ----------------------------------
    ' TEST GROUP: Post-Unmount State
    ' ----------------------------------
    utils.startTestGroup(@"Post-Unmount State")

    ' Unmount, then verify operations fail with E_NOT_MOUNTED
    sd.unmount()

    utils.startTest(@"openFileRead() after unmount returns E_NOT_MOUNTED")
    handle := sd.openFileRead(@testfile1)
    utils.evaluateSingleValue(handle, @"openFileRead()", sd.E_NOT_MOUNTED)

    utils.startTest(@"createFileNew() after unmount returns E_NOT_MOUNTED")
    handle := sd.createFileNew(@testfile1)
    utils.evaluateSingleValue(handle, @"createFileNew()", sd.E_NOT_MOUNTED)

    utils.startTest(@"changeDirectory() after unmount returns E_NOT_MOUNTED")
    result := sd.changeDirectory(@"/")
    utils.evaluateSingleValue(result, @"changeDirectory()", sd.E_NOT_MOUNTED)

    ' Remount and verify clean state
    utils.startTest(@"Remount after unmount succeeds")
    result := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    utils.evaluateSingleValue(result, @"mount() after unmount", sd.SUCCESS)

    utils.startTest(@"freeSpace() works after remount")
    freeSpace := sd.freeSpace()
    utils.evaluateRange(freeSpace, @"freeSpace() after remount", 1, $7FFF_FFFF)

    ' ----------------------------------
    ' TEST GROUP: Double-Mount Behavior
    ' ----------------------------------
    utils.startTestGroup(@"Double-Mount Behavior")

    utils.startTest(@"Double mount returns SUCCESS")
    utils.setCheckCountPerTest(2)
    result := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    utils.evaluateSubValue(result, @"mount() again", sd.SUCCESS)
    freeSpace := sd.freeSpace()
    utils.evaluateSubBool(freeSpace > 0, @"freeSpace() valid", true)
    utils.showSubTestResults()
    utils.setCheckCountPerTest(1)

    utils.startTest(@"Double mount preserves open file handle")
    utils.setCheckCountPerTest(4)
    sd.deleteFile(@testfile1)
    handle := sd.createFileNew(@testfile1)
    if handle >= 0
        sd.writeHandle(handle, @"ABCDEFGHIJ", 10)
        result := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
        utils.evaluateSubValue(result, @"mount() during write", sd.SUCCESS)
        bytesRead := sd.writeHandle(handle, @"KLMNOPQRST", 10)
        utils.evaluateSubBool(bytesRead > 0, @"write after mount", true)
        sd.closeFileHandle(handle)
        handle := sd.openFileRead(@testfile1)
        if handle >= 0
            bytesRead := sd.readHandle(handle, @sectorBuffer, 20)
            utils.evaluateSubValue(bytesRead, @"read 20 bytes", 20)
            utils.evaluateSubBool(sectorBuffer[0] == $41 and sectorBuffer[10] == $4B, @"data intact", true)
            sd.closeFileHandle(handle)
        else
            ' Reopen failed. Score the two checks it gated instead of letting the
            ' record run short -- the same labels, so the shape still matches.
            debug("  reopen after double mount failed: ", sdec_(handle))
            utils.evaluateSubBool(false, @"read 20 bytes", true)
            utils.evaluateSubBool(false, @"data intact", true)
    else
        ' Create failed, so ALL FOUR checks are gated: the test would be counted by
        ' startTest and never scored, vanishing into BAD TEST COUNTS rather than
        ' failing. Score all four so one setup failure reads as one failing test.
        debug("  createFileNew failed, cannot test double mount: ", sdec_(handle))
        utils.evaluateSubBool(false, @"mount() during write", true)
        utils.evaluateSubBool(false, @"write after mount", true)
        utils.evaluateSubBool(false, @"read 20 bytes", true)
        utils.evaluateSubBool(false, @"data intact", true)
    utils.showSubTestResults()
    utils.setCheckCountPerTest(1)

    ' The property under test is that the mount does not reset CWD. That only means
    ' anything if we were provably IN the subdirectory first -- unasserted, the mkdir
    ' and cd could both fail and the whole test would pass while running at root,
    ' testing nothing. Both are now scored sub-checks.
    utils.startTest(@"Double mount preserves working directory")
    utils.setCheckCountPerTest(4)
    sd.deleteFile(@"DMTDIR/DMTFILE.TXT")                ' empty first: an aborted prior run leaves the file inside,
    sd.deleteFile(@"DMTDIR")                            '  and delete of a populated directory now refuses (E_DIR_NOT_EMPTY)
    result := sd.newDirectory(@"DMTDIR")
    utils.evaluateSubValue(result, @"newDirectory(DMTDIR)", sd.SUCCESS)
    result := sd.changeDirectory(@"DMTDIR")
    utils.evaluateSubValue(result, @"changeDirectory(DMTDIR)", sd.SUCCESS)
    result := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    utils.evaluateSubValue(result, @"mount() in subdir", sd.SUCCESS)
    sd.deleteFile(@"DMTFILE.TXT")
    handle := sd.createFileNew(@"DMTFILE.TXT")
    if handle >= 0
        sd.writeHandle(handle, @"test", 4)
        sd.closeFileHandle(handle)
    handle := sd.openFileRead(@"DMTFILE.TXT")
    utils.evaluateSubBool(handle >= 0, @"file in subdir", true)
    if handle >= 0
        sd.closeFileHandle(handle)
    utils.showSubTestResults()
    utils.setCheckCountPerTest(1)

    ' Cleanup double-mount tests
    sd.deleteFile(@"DMTFILE.TXT")
    sd.changeDirectory(@"/")
    sd.deleteFile(@"DMTDIR")
    sd.deleteFile(@testfile1)

#ifdef SD_INCLUDE_STACK_CHECK
    debug(" ")
    debug("* Worker cog stack: ", udec_(sd.reportStackDepth()), " of ", udec_(sd.STACK_SIZE), " longs used")
#endif

    ' Final unmount
    sd.unmount()

    ' ----------------------------------
    ' TEST GROUP: Structural Corruption Fails The Mount (S9 / G-3)
    ' ----------------------------------
    ' Each case captures the target sector raw, patches ONE field, PROVES the
    ' patch landed with a re-read (a wrong mount code over an unlanded patch is
    ' a fixture failure, not a driver finding), asserts the SPECIFIC mount
    ' code, then restores and verifies the restore. A failed mount leaves the
    ' driver in RAW mode (do_mount assigns driver_mode only on success), so
    ' the raw fixture survives every armed mount. PRIMARY copies only: the
    ' driver never reads the backup boot sector or backup FSInfo, so
    ' corrupting them would witness nothing.
    utils.startTestGroup(@"Structural Corruption Fails The Mount")

    utils.initGuard(@sectorBuffer_guard)
    utils.initGuard(@saveBuffer_guard)

    utils.startTest(@"initCardOnly for raw fixture access")
    result := sd.initCardOnly(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    utils.evaluateSingleValue(result, @"initCardOnly()", 0)

    ' The VBR's LBA, parsed from the MBR partition entry (start-LBA bytes
    ' $1C6-$1C9, little-endian)
    vbrSec := 0
    if sd.readSectorRaw(0, @sectorBuffer) == 0
        vbrSec := rd32(@sectorBuffer, $1C6)

    corruptCase(@"MBR partition type rejects with E_NOT_FAT32", 0, $1C2, $00, sd.E_NOT_FAT32)
    corruptCase(@"VBR bytes/sector rejects with E_BAD_SECTOR_SIZE", vbrSec, $0C, $04, sd.E_BAD_SECTOR_SIZE)
    corruptCase(@"VBR FAT count rejects with E_NOT_FAT32", vbrSec, $10, $01, sd.E_NOT_FAT32)
    ' secPerClus=0 slid through the power-of-two test (0 & -1 == 0) and
    ' divided by zero in the worker -- a HANG, not a code. Post-fix it must
    ' reject like any other structural fault. A regression here times the
    ' suite out rather than scoring -- that red is the finding.
    corruptCase(@"VBR secPerClus=0 rejects with E_NOT_FAT32 (not a hang)", vbrSec, $0D, $00, sd.E_NOT_FAT32)

    ' FSInfo tolerance contract: bad FSInfo is TOLERATED at mount (free-count
    ' hint marked unknown); it surfaces as E_BAD_FSINFO only when a free-count
    ' change forces unmount/sync to write it back and the signatures fail the
    ' pre-write verify.
    utils.startTest(@"Corrupt FSInfo: tolerated at mount, E_BAD_FSINFO at unmount")
    utils.setCheckCountPerTest(6)
    ' FSInfo LBA parsed from the VBR (WORD at $30, relative to the VBR)
    fsiSec := 0
    if vbrSec > 0 AND sd.readSectorRaw(vbrSec, @sectorBuffer) == 0
        fsiSec := vbrSec + rd16(@sectorBuffer, $30)
    utils.evaluateSubBool(fsiSec > vbrSec, @"FSInfo sector located", true)

    result := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)  ' clean mount reads the VALID free count
    if fsiSec <= vbrSec
        result := -1                                     ' bad locate (scored above) -- touch nothing
    if result == 0
        result := sd.readSectorRaw(fsiSec, @sectorBuffer)
    if result == 0
        bytemove(@saveBuffer, @sectorBuffer, 512)
        bytefill(@sectorBuffer, 0, 4)                    ' lead signature 'RRaA'
        bytefill(@sectorBuffer + 484, 0, 4)              ' struct signature 'rrAa'
        result := sd.writeSectorRaw(fsiSec, @sectorBuffer)
    if result == 0
        result := sd.readSectorRaw(fsiSec, @sectorBuffer)  ' prove it landed
    utils.evaluateSubBool(result == 0 AND sectorBuffer[0] == 0 AND sectorBuffer[484] == 0, @"FSInfo corruption landed while mounted", true)

    ' Force a free-count change so unmount MUST write FSInfo back
    handle := sd.createFileNew(@testfile1)
    if handle >= 0
        sd.writeHandle(handle, @"S9!!", 4)
        sd.closeFileHandle(handle)
    sd.deleteFile(@testfile1)
    result := sd.unmount()
    utils.evaluateSubValue(result, @"unmount reports E_BAD_FSINFO", sd.E_BAD_FSINFO)

    ' The tolerance IS the contract: a mount over the still-bad FSInfo
    ' succeeds, and its unmount (no allocation, hint unknown) is clean
    result := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    utils.evaluateSubValue(result, @"mount with bad FSInfo returns SUCCESS", 0)
    sd.unmount()

    ' Restore FSInfo raw and verify
    result := sd.initCardOnly(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    if result == 0
        result := sd.writeSectorRaw(fsiSec, @saveBuffer)
    if result == 0
        result := sd.readSectorRaw(fsiSec, @sectorBuffer)
    utils.evaluateSubBool(result == 0 AND sectorBuffer[0] == saveBuffer[0] AND sectorBuffer[484] == saveBuffer[484], @"FSInfo restored", true)

    ' Operational close for the whole group: the card mounts green and
    ' serves its volume label
    result := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    pLabel := 0
    if result == 0
        pLabel := sd.volumeLabel()
    utils.evaluateSubBool(result == 0 AND pLabel <> 0, @"remount green + volume label readable", true)
    utils.showSubTestResults()
    sd.unmount()

    utils.checkGuard(@sectorBuffer_guard, @"sectorBuffer guard")
    utils.checkGuard(@saveBuffer_guard, @"saveBuffer guard")

    ' ----------------------------------
    ' TEST GROUP: RAW Mode Gates Filesystem Commands (G-4)
    ' ----------------------------------
    ' The worker dispatch rejects filesystem commands while driver_mode is
    ' MODE_RAW -- a gate that had NEVER been exercised: no test issued a
    ' filesystem op from RAW mode before this group.
    utils.startTestGroup(@"RAW Mode Gates Filesystem Commands")

    utils.startTest(@"initCardOnly enters RAW mode")
    result := sd.initCardOnly(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    utils.evaluateSingleValue(result, @"initCardOnly()", 0)

    utils.startTest(@"openFileRead() in RAW mode returns E_NOT_MOUNTED")
    handle := sd.openFileRead(@testfile1)
    utils.evaluateSingleValue(handle, @"openFileRead()", sd.E_NOT_MOUNTED)

    utils.startTest(@"createFileNew() in RAW mode returns E_NOT_MOUNTED")
    handle := sd.createFileNew(@testfile1)
    utils.evaluateSingleValue(handle, @"createFileNew()", sd.E_NOT_MOUNTED)

    utils.startTest(@"changeDirectory() in RAW mode returns E_NOT_MOUNTED")
    result := sd.changeDirectory(@"/")
    utils.evaluateSingleValue(result, @"changeDirectory()", sd.E_NOT_MOUNTED)

    utils.startTest(@"RAW -> FILESYSTEM upgrade serves file ops")
    utils.setCheckCountPerTest(2)
    result := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    utils.evaluateSubValue(result, @"mount() upgrades from RAW", 0)
    handle := sd.createFileNew(@testfile1)
    utils.evaluateSubBool(handle >= 0, @"file op succeeds after upgrade", true)
    if handle >= 0
        sd.closeFileHandle(handle)
    sd.deleteFile(@testfile1)
    utils.showSubTestResults()

    ' Documented odd-but-deliberate choice: initCardOnly from a mounted
    ' filesystem refuses with E_NOT_MOUNTED (assert what the code does; the
    ' docs task verifies the docstring says the same)
    utils.startTest(@"initCardOnly() while mounted returns E_NOT_MOUNTED")
    result := sd.initCardOnly(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    utils.evaluateSingleValue(result, @"initCardOnly() while mounted", sd.E_NOT_MOUNTED)

    sd.unmount()

    ' ----------------------------------
    ' Summary
    ' ----------------------------------
    utils.ShowTestEndCounts()

    debug(" ")
    debug("* Mount/Unmount Tests Complete")
    debug("END_SESSION")

PRI corruptCase(pTitle, lba, offset, newValue, expectedCode) | result
' One structural-corruption case: capture the sector raw, patch one byte,
' PROVE the patch landed, assert the specific mount code, restore, verify.
' Entered in RAW mode; a failed mount leaves RAW mode, so the fixture holds.
'
' @param pTitle - Test title
' @param lba - Sector to corrupt (0 = MBR, or the VBR's LBA)
' @param offset - Byte offset within the sector
' @param newValue - Corrupting byte value
' @param expectedCode - The specific error mount() must return

    utils.startTest(pTitle)
    utils.setCheckCountPerTest(3)

    result := sd.readSectorRaw(lba, @sectorBuffer)
    if result == 0
        bytemove(@saveBuffer, @sectorBuffer, 512)
        sectorBuffer[offset] := newValue
        result := sd.writeSectorRaw(lba, @sectorBuffer)
    if result == 0
        result := sd.readSectorRaw(lba, @sectorBuffer)   ' prove the patch landed BEFORE judging the mount
    utils.evaluateSubBool(result == 0 AND sectorBuffer[offset] == newValue, @"corruption landed on card", true)

    result := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    utils.evaluateSubValue(result, @"mount returns the specific code", expectedCode)
    if result == 0
        ' Regression path: the mount accepted a corrupt volume. Get back to
        ' RAW mode so the restore below and the following cases still run.
        sd.unmount()
        sd.initCardOnly(SD_CS, SD_MOSI, SD_MISO, SD_SCK)

    result := sd.writeSectorRaw(lba, @saveBuffer)
    if result == 0
        result := sd.readSectorRaw(lba, @sectorBuffer)
    utils.evaluateSubBool(result == 0 AND sectorBuffer[offset] == saveBuffer[offset], @"restore verified", true)
    utils.showSubTestResults()

PRI rd32(pBuf, offset) : value
' Little-endian 32-bit read, byte-assembled (no alignment assumption).

    value := BYTE[pBuf][offset] | BYTE[pBuf][offset+1] << 8 | BYTE[pBuf][offset+2] << 16 | BYTE[pBuf][offset+3] << 24

PRI rd16(pBuf, offset) : value
' Little-endian 16-bit read, byte-assembled (no alignment assumption).

    value := BYTE[pBuf][offset] | BYTE[pBuf][offset+1] << 8

con { license }

