'' =================================================================================================
''
''   File....... SD_RT_volume_tests.spin2
''   Purpose.... This object tests volume operations, sync, date, and VBR access
''   Author..... Stephen M Moraco
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... FEB 2026
''   Updated.... 18 FEB 2026
''
'' =================================================================================================
''
'' Tests the following APIs:
''   - setVolumeLabel() / volumeLabel()
''   - syncAllHandles()
''   - sync() (legacy)
''   - setDate() with timestamp verification
''   - VBR access via readVBRRaw() and readSectorRaw()
''
'' =================================================================================================

CON

     _CLKFREQ        = 350_000_000

     ' SD card pin assignments
     ' Default: P2 Edge module SD slot. Build with -D SD_PINS_EXTERNAL
     ' to use the external SD header (base pin 16).
#ifdef SD_PINS_EXTERNAL
     SD_CS   = 20
     SD_MOSI = 19
     SD_MISO = 18
     SD_SCK  = 21
#else
     SD_CS   = 60
     SD_MOSI = 59
     SD_MISO = 58
     SD_SCK  = 61
#endif

' Simulated cluster cap for the Disk Full Simulation group. Named because the
' precondition gate, setTestMaxClusters() and the write-count arithmetic all have
' to agree -- as three separate literal 20s they could drift apart silently.
CON
    DF_MAX_CLUSTERS    = 20
    DF_CLUSTER_MARGIN  = 8      ' headroom so the cap, not the card, is what runs out

' Enable register access, raw sector access, debug, and the test hooks the
' disk-full checks arm (setTestMaxClusters)
#ifdef __SPINTOOLS__
#define SD_INCLUDE_REGISTERS
#define SD_INCLUDE_RAW
#define SD_INCLUDE_DEBUG
#define SD_INCLUDE_TEST_HOOKS
#elseifdef __FLEXSPIN__
#define SD_INCLUDE_REGISTERS
#pragma exportdef SD_INCLUDE_REGISTERS
#define SD_INCLUDE_RAW
#pragma exportdef SD_INCLUDE_RAW
#define SD_INCLUDE_DEBUG
#pragma exportdef SD_INCLUDE_DEBUG
#define SD_INCLUDE_TEST_HOOKS
#pragma exportdef SD_INCLUDE_TEST_HOOKS
#else
#pragma exportdef SD_INCLUDE_REGISTERS
#pragma exportdef SD_INCLUDE_RAW
#pragma exportdef SD_INCLUDE_DEBUG
#pragma exportdef SD_INCLUDE_TEST_HOOKS
#endif

OBJ
    sd    : "micro_sd_fat32_fs"
    utils : "isp_rt_utilities"

DAT

' Test filenames
vlTestFile1     BYTE    "VLTEST1.TXT", 0
vlTestFile2     BYTE    "VLTEST2.TXT", 0
vlTestFile3     BYTE    "VLTEST3.TXT", 0
vlSyncFile      BYTE    "VLSYNC.TXT", 0
vlDateFile      BYTE    "VLDATE1.TXT", 0
vlDateFile2     BYTE    "VLDATE2.TXT", 0
vlDateDir       BYTE    "VLDTDIR", 0
vlLegacyFile    BYTE    "VLLEGCY.TXT", 0
vlFlushFile     BYTE    "VLFLUSH.TXT", 0
dfTestFile      BYTE    "DFTEST.BIN", 0
dfVerifyFile    BYTE    "DFVERFY.BIN", 0
dfNameBuf       BYTE    "DF00.BIN", 0

' Volume label test strings
newLabel        BYTE    "TESTLABEL  ", 0
maxLabel        BYTE    "12345678901", 0

' File content
testContent     BYTE    "Volume test content data", 0
syncContent     BYTE    "Sync test data chunk one", 0
flushContent    BYTE    "Auto-flush test data pattern!", 0

' Buffers
vbrBuf          BYTE    0[sd.SECTOR_SIZE]
vbrBuf_guard    BYTE    0[16]
vbrBuf2         BYTE    0[sd.SECTOR_SIZE]
vbrBuf2_guard   BYTE    0[16]
readBuffer      BYTE    0[256]
readBuffer_guard BYTE   0[16]
writeBuf        BYTE    0[512]

' Saved original label
origLabel       BYTE    0[12]

PUB go() | result, hndl1, hndl2, bytesWritten, pLabel, idx, pEntry, wrtDate, wrtTime, vbrSector, found, baselineFree, filesCreated, dfHandle, maxWrites, dfSecPerClus, dfFreeClus
'' Main entry point for volume operation regression tests

    debug(" ")
    debug("==============================================")
    debug("  SD Card Driver - Volume Operation Tests")
    debug("==============================================")

    ' Mount the card first
    result := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    ifnot utils.requireSetup(result == 0, @"SETUP: mount SD card")
        debug("ERROR: Could not mount SD card!")
        utils.ShowTestEndCounts()
        debug("END_SESSION")
        return

    ' Show card info
    debug(" ")
    debug("* SD Card Information:")
    debug("   Volume Label: ", zstr_(sd.volumeLabel()))
    debug("   Free Space: ", udec(sd.freeSpace()), " sectors")

    ' Save original volume label
    pLabel := sd.volumeLabel()
    bytefill(@origLabel, 0, 12)
    bytemove(@origLabel, pLabel, strsize(pLabel))
    debug("   Original Label saved: [", zstr_(@origLabel), "]")

    ' Clean up any existing test files
    cleanupTestFiles()

    ' ======================================================================
    ' TEST GROUP: setVolumeLabel
    ' ======================================================================
    utils.startTestGroup(@"setVolumeLabel")

    ' Test: Set a new volume label
    utils.startTest(@"setVolumeLabel() changes label")
    result := sd.setVolumeLabel(@newLabel)
    utils.evaluateSingleValue(result, @"setVolumeLabel()", sd.SUCCESS)

    ' Test: volumeLabel() returns the new label
    utils.startTest(@"volumeLabel() returns new label after set")
    pLabel := sd.volumeLabel()
    debug("   New label: [", zstr_(pLabel), "]")
    result := strncmp(pLabel, @"TESTLABEL", 9)
    utils.evaluateBool(result, @"label matches TESTLABEL", true)

    ' Test: Max length label (11 chars)
    utils.startTest(@"setVolumeLabel() accepts 11-char label")
    result := sd.setVolumeLabel(@maxLabel)
    utils.evaluateSingleValue(result, @"setVolumeLabel(11 chars)", sd.SUCCESS)

    ' Test: Label persists through unmount/remount
    utils.startTest(@"Label persists through unmount/remount")
    sd.unmount()
    result := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    utils.evaluateSubValue(result, @"remount succeeds", sd.SUCCESS)
    ' A failed remount here is unrecoverable for this suite AND leaves the card
    ' wearing the test label, because the restore below cannot run unmounted.
    ifnot utils.requireSetup(result == sd.SUCCESS, @"SETUP: remount for the rest of the volume suite")
        debug("  *** Card did not remount -- volume label may still be the test value")
        utils.ShowTestEndCounts()
        debug("END_SESSION")
        return
    pLabel := sd.volumeLabel()
    debug("   Label after remount: [", zstr_(pLabel), "]")
    result := strncmp(pLabel, @"12345678901", 11)
    utils.evaluateSubBool(result, @"label persisted", true)

    ' Test: Restore original label
    utils.startTest(@"Restore original volume label")
    result := sd.setVolumeLabel(@origLabel)
    utils.evaluateSingleValue(result, @"restore label", sd.SUCCESS)
    pLabel := sd.volumeLabel()
    debug("   Restored label: [", zstr_(pLabel), "]")

    ' ======================================================================
    ' TEST GROUP: syncAllHandles
    ' ======================================================================
    utils.startTestGroup(@"syncAllHandles")

    ' Test: syncAllHandles with no handles open
    utils.startTest(@"syncAllHandles() with no handles open")
    result := sd.syncAllHandles()
    utils.evaluateSingleValue(result, @"syncAllHandles() no handles", 0)

    ' Test: syncAllHandles flushes single write handle
    utils.startTest(@"syncAllHandles() flushes single write handle")
    sd.deleteFile(@vlSyncFile)
    hndl1 := sd.createFileNew(@vlSyncFile)
    utils.evaluateSubBool(hndl1 >= 0, @"create file", true)
    if hndl1 >= 0
        bytesWritten := sd.writeHandle(hndl1, @syncContent, strsize(@syncContent))
        result := sd.syncAllHandles()
        utils.evaluateSubValue(result, @"syncAllHandles()", 0)
        ' File should still be writable
        bytesWritten := sd.writeHandle(hndl1, @syncContent, strsize(@syncContent))
        utils.evaluateSubBool(bytesWritten > 0, @"write after sync", true)
        sd.closeFileHandle(hndl1)

    ' Test: syncAllHandles flushes multiple write handles
    utils.startTest(@"syncAllHandles() flushes multiple write handles")
    sd.deleteFile(@vlTestFile1)
    sd.deleteFile(@vlTestFile2)
    hndl1 := sd.createFileNew(@vlTestFile1)
    hndl2 := sd.createFileNew(@vlTestFile2)
    if hndl1 >= 0
        sd.writeHandle(hndl1, @testContent, strsize(@testContent))
    if hndl2 >= 0
        sd.writeHandle(hndl2, @testContent, strsize(@testContent))
    result := sd.syncAllHandles()
    utils.evaluateSingleValue(result, @"syncAllHandles() multi", 0)
    if hndl1 >= 0
        sd.closeFileHandle(hndl1)
    if hndl2 >= 0
        sd.closeFileHandle(hndl2)

    ' Test: syncAllHandles with mixed read+write handles
    utils.startTest(@"syncAllHandles() with read+write mix")
    hndl1 := sd.openFileRead(@vlTestFile1)
    sd.deleteFile(@vlTestFile3)
    hndl2 := sd.createFileNew(@vlTestFile3)
    if hndl2 >= 0
        sd.writeHandle(hndl2, @testContent, strsize(@testContent))
    result := sd.syncAllHandles()
    utils.evaluateSingleValue(result, @"syncAllHandles() mix", 0)
    if hndl1 >= 0
        sd.closeFileHandle(hndl1)
    if hndl2 >= 0
        sd.closeFileHandle(hndl2)

    ' Test: syncAllHandles persists directory entry to disk
    utils.startTest(@"syncAllHandles() persists dir entry to disk")
    utils.setCheckCountPerTest(3)
    sd.deleteFile(@vlSyncFile)
    hndl1 := sd.createFileNew(@vlSyncFile)
    utils.evaluateSubBool(hndl1 >= 0, @"create file", true)
    if hndl1 >= 0
        bytesWritten := sd.writeHandle(hndl1, @syncContent, strsize(@syncContent))
        result := sd.syncAllHandles()
        utils.evaluateSubValue(result, @"syncAllHandles()", 0)
        ' Open same file with a SECOND read handle -- reads dir entry from disk
        hndl2 := sd.openFileRead(@vlSyncFile)
        if hndl2 >= 0
            utils.evaluateSubValue(sd.fileSizeHandle(hndl2), @"size via 2nd handle", strsize(@syncContent))
            sd.closeFileHandle(hndl2)
        else
            utils.evaluateSubBool(false, @"size via 2nd handle", true)
        sd.closeFileHandle(hndl1)
    else
        utils.evaluateSubBool(false, @"syncAllHandles()", true)
        utils.evaluateSubBool(false, @"size via 2nd handle", true)
    utils.showSubTestResults()

    ' ======================================================================
    ' TEST GROUP: sync
    ' ======================================================================
    utils.startTestGroup(@"sync")

    ' Test: sync flushes handle write
    utils.startTest(@"sync() flushes handle write")
    sd.deleteFile(@vlLegacyFile)
    hndl1 := sd.createFileNew(@vlLegacyFile)
    utils.evaluateSubBool(hndl1 >= 0, @"createFileNew()", true)
    sd.writeHandle(hndl1, @testContent, strsize(@testContent))
    result := sd.sync()
    utils.evaluateSubValue(result, @"sync()", sd.SUCCESS)
    sd.closeFileHandle(hndl1)

    ' Test: sync with no file open
    utils.startTest(@"sync() with no file open")
    result := sd.sync()
    utils.evaluateSingleValue(result, @"sync() no file", sd.SUCCESS)

    ' ======================================================================
    ' TEST GROUP: Auto-Flush on Idle
    ' ======================================================================
    utils.startTestGroup(@"Auto-Flush on Idle")

    ' Test: Auto-flush writes dirty handle after idle period
    utils.startTest(@"Auto-flush persists data after 300ms idle")
    utils.setCheckCountPerTest(2)
    sd.deleteFile(@vlFlushFile)
    hndl1 := sd.createFileNew(@vlFlushFile)
    utils.evaluateSubBool(hndl1 >= 0, @"create file", true)
    if hndl1 >= 0
        bytesWritten := sd.writeHandle(hndl1, @flushContent, strsize(@flushContent))
        ' Do NOT close - wait for auto-flush (200ms threshold)
        waitms(300)
        ' Open same file with second handle to read dir entry from disk
        hndl2 := sd.openFileRead(@vlFlushFile)
        if hndl2 >= 0
            utils.evaluateSubValue(sd.fileSizeHandle(hndl2), @"size via 2nd handle", strsize(@flushContent))
            sd.closeFileHandle(hndl2)
        else
            utils.evaluateSubBool(false, @"size via 2nd handle", true)
        sd.closeFileHandle(hndl1)
    else
        utils.evaluateSubBool(false, @"size via 2nd handle", true)
    utils.showSubTestResults()

    ' Test: Auto-flush updates directory entry
    utils.startTest(@"Auto-flush updates dir entry size")
    utils.setCheckCountPerTest(2)
    sd.deleteFile(@vlFlushFile)
    hndl1 := sd.createFileNew(@vlFlushFile)
    utils.evaluateSubBool(hndl1 >= 0, @"create file", true)
    if hndl1 >= 0
        ' Write twice to grow the file
        sd.writeHandle(hndl1, @flushContent, strsize(@flushContent))
        sd.writeHandle(hndl1, @flushContent, strsize(@flushContent))
        waitms(300)
        ' Verify size reflects both writes
        hndl2 := sd.openFileRead(@vlFlushFile)
        if hndl2 >= 0
            utils.evaluateSubValue(sd.fileSizeHandle(hndl2), @"size after 2 writes", strsize(@flushContent) * 2)
            sd.closeFileHandle(hndl2)
        else
            utils.evaluateSubBool(false, @"size after 2 writes", true)
        sd.closeFileHandle(hndl1)
    else
        utils.evaluateSubBool(false, @"size after 2 writes", true)
    utils.showSubTestResults()

    ' Test: Auto-flush does not interfere with active I/O
    utils.startTest(@"Active I/O not disrupted by flush")
    utils.setCheckCountPerTest(2)
    sd.deleteFile(@vlFlushFile)
    hndl1 := sd.createFileNew(@vlFlushFile)
    utils.evaluateSubBool(hndl1 >= 0, @"create file", true)
    if hndl1 >= 0
        ' Rapid writes with no 200ms gap
        bytesWritten := 0
        repeat 50
            bytesWritten += sd.writeHandle(hndl1, @flushContent, strsize(@flushContent))
        utils.evaluateSubValue(bytesWritten, @"total bytes written", strsize(@flushContent) * 50)
        sd.closeFileHandle(hndl1)
    else
        utils.evaluateSubBool(false, @"total bytes written", true)
    utils.showSubTestResults()
    sd.deleteFile(@vlFlushFile)

    ' ======================================================================
    ' TEST GROUP: setDate
    ' ======================================================================
    utils.startTestGroup(@"setDate")

    ' Test: Timestamp on new file
    utils.startTest(@"setDate() sets timestamp on new file")
    sd.setDate(2026, 2, 18, 14, 30, 0)
    sd.deleteFile(@vlDateFile)
    hndl1 := sd.createFileNew(@vlDateFile)
    if hndl1 >= 0
        sd.writeHandle(hndl1, @testContent, strsize(@testContent))
        sd.closeFileHandle(hndl1)
    ' Verify timestamp via directory entry
    wrtDate := 0
    wrtTime := 0
    found := false
    idx := 0
    repeat
        pEntry := sd.readDirectory(idx)
        if pEntry == 0
            quit
        pLabel := sd.fileName()
        if strcomp(pLabel, @"VLDATE1.TXT")
            ' FAT date: bits 15-9=year-1980, 8-5=month, 4-0=day
            wrtDate := WORD[pEntry + 24]
            ' FAT time: bits 15-11=hour, 10-5=minute, 4-0=second/2
            wrtTime := WORD[pEntry + 22]
            found := true
            quit
        idx++
    debug("   found=", sdec_(found), " wrtDate=$", uhex_(wrtDate), " wrtTime=$", uhex_(wrtTime))
    utils.evaluateSubBool(found, @"file found in dir", true)
    utils.evaluateSubBool(wrtDate <> 0, @"date stamp non-zero", true)
    utils.evaluateSubBool(wrtTime <> 0, @"time stamp non-zero", true)
    ' Verify year field (bits 15-9) = 46 (2026-1980)
    result := (wrtDate >> 9) & $7F
    utils.evaluateSubValue(result, @"year field (2026-1980)", 46)

    ' Test: Midnight Jan 1, 2000
    utils.startTest(@"setDate() midnight Jan 1 2000")
    sd.setDate(2000, 1, 1, 0, 0, 0)
    sd.deleteFile(@vlDateFile2)
    hndl1 := sd.createFileNew(@vlDateFile2)
    if hndl1 >= 0
        sd.writeHandle(hndl1, @testContent, strsize(@testContent))
        sd.closeFileHandle(hndl1)
    found := false
    idx := 0
    repeat
        pEntry := sd.readDirectory(idx)
        if pEntry == 0
            quit
        pLabel := sd.fileName()
        if strcomp(pLabel, @"VLDATE2.TXT")
            wrtDate := WORD[pEntry + 24]
            wrtTime := WORD[pEntry + 22]
            found := true
            quit
        idx++
    debug("   found=", sdec_(found), " wrtDate=$", uhex_(wrtDate))
    utils.evaluateSubBool(found, @"file found in dir", true)
    ' Year=2000-1980=20, month=1, day=1
    result := (wrtDate >> 9) & $7F
    utils.evaluateSubValue(result, @"year field (2000-1980)", 20)
    ' Time at midnight should be 0
    utils.evaluateSubValue(wrtTime, @"midnight time", 0)

    ' Test: End-of-day Dec 31
    utils.startTest(@"setDate() end-of-day Dec 31")
    sd.setDate(2025, 12, 31, 23, 59, 58)
    sd.deleteFile(@vlDateFile2)
    hndl1 := sd.createFileNew(@vlDateFile2)
    if hndl1 >= 0
        sd.writeHandle(hndl1, @testContent, strsize(@testContent))
        sd.closeFileHandle(hndl1)
    found := false
    idx := 0
    repeat
        pEntry := sd.readDirectory(idx)
        if pEntry == 0
            quit
        pLabel := sd.fileName()
        if strcomp(pLabel, @"VLDATE2.TXT")
            wrtDate := WORD[pEntry + 24]
            wrtTime := WORD[pEntry + 22]
            found := true
            quit
        idx++
    debug("   found=", sdec_(found), " wrtDate=$", uhex_(wrtDate), " wrtTime=$", uhex_(wrtTime))
    utils.evaluateSubBool(found, @"file found in dir", true)
    ' Year=2025-1980=45
    result := (wrtDate >> 9) & $7F
    utils.evaluateSubValue(result, @"year field (2025-1980)", 45)
    ' Month=12
    result := (wrtDate >> 5) & $0F
    utils.evaluateSubValue(result, @"month field (12)", 12)
    ' Hour=23, minute=59, second/2=29
    result := (wrtTime >> 11) & $1F
    utils.evaluateSubValue(result, @"hour field (23)", 23)

    ' Test: setDate via createFileNew
    utils.startTest(@"setDate() timestamp on createFileNew")
    sd.setDate(2026, 6, 15, 10, 0, 0)
    sd.deleteFile(@vlDateFile)
    hndl1 := sd.createFileNew(@vlDateFile)
    if hndl1 >= 0
        sd.writeHandle(hndl1, @testContent, strsize(@testContent))
        sd.closeFileHandle(hndl1)
    found := false
    idx := 0
    repeat
        pEntry := sd.readDirectory(idx)
        if pEntry == 0
            quit
        pLabel := sd.fileName()
        if strcomp(pLabel, @"VLDATE1.TXT")
            wrtDate := WORD[pEntry + 24]
            found := true
            quit
        idx++
    debug("   found=", sdec_(found), " wrtDate=$", uhex_(wrtDate))
    utils.evaluateSubBool(found, @"file found in dir", true)
    ' Year=2026-1980=46, month=6
    result := (wrtDate >> 9) & $7F
    utils.evaluateSubValue(result, @"year field", 46)
    result := (wrtDate >> 5) & $0F
    utils.evaluateSubValue(result, @"month field", 6)

    ' Test: setDate on new directory
    utils.startTest(@"setDate() timestamp on new directory")
    sd.setDate(2026, 3, 1, 8, 0, 0)
    sd.newDirectory(@vlDateDir)
    found := false
    idx := 0
    repeat
        pEntry := sd.readDirectory(idx)
        if pEntry == 0
            quit
        pLabel := sd.fileName()
        if strcomp(pLabel, @"VLDTDIR")
            wrtDate := WORD[pEntry + 24]
            found := true
            quit
        idx++
    debug("   found=", sdec_(found), " wrtDate=$", uhex_(wrtDate))
    utils.evaluateSubBool(found, @"dir found in listing", true)
    ' Year=2026-1980=46, month=3
    result := (wrtDate >> 9) & $7F
    utils.evaluateSubValue(result, @"dir year field", 46)
    result := (wrtDate >> 5) & $0F
    utils.evaluateSubValue(result, @"dir month field", 3)

    ' ======================================================================
    ' TEST GROUP: VBR Access
    ' ======================================================================
    utils.startTestGroup(@"VBR Access")

    ' Read MBR (sector 0) to find VBR sector
    utils.startTest(@"Read MBR to find VBR sector")
    bytefill(@vbrBuf, 0, sd.SECTOR_SIZE)
    utils.initGuard(@vbrBuf_guard)
    result := sd.readSectorRaw(0, @vbrBuf)
    utils.checkGuard(@vbrBuf_guard, @"vbrBuf guard")
    utils.evaluateSingleValue(result, @"readSectorRaw(0)", sd.SUCCESS)

    ' Get VBR sector from partition table (offset $1C6 = 454, 4-byte LE)
    utils.startTest(@"MBR partition table has valid VBR sector")
    vbrSector := LONG[@vbrBuf + $1C6]
    debug("   VBR sector: ", udec_(vbrSector))
    utils.evaluateSubBool(vbrSector > 0, @"VBR sector > 0", true)
    utils.evaluateSubBool(vbrSector < 100_000, @"VBR sector reasonable", true)

    ' Read VBR sector
    utils.startTest(@"VBR has boot signature $AA55")
    bytefill(@vbrBuf, 0, sd.SECTOR_SIZE)
    utils.initGuard(@vbrBuf_guard)
    result := sd.readSectorRaw(vbrSector, @vbrBuf)
    utils.checkGuard(@vbrBuf_guard, @"vbrBuf guard")
    if result == sd.SUCCESS
        result := WORD[@vbrBuf + sd.BOOT_SIG_OFFSET]
        utils.evaluateSingleValueHex(result, @"boot signature", sd.BOOT_SIGNATURE)
    else
        utils.evaluateBool(false, @"VBR read failed", true)

    ' Test: Bytes per sector == 512
    utils.startTest(@"VBR bytes-per-sector == 512")
    result := WORD[@vbrBuf + $0B]
    utils.evaluateSingleValue(result, @"bytes per sector", sd.SECTOR_SIZE)

    ' Test: OEM name is readable (8 bytes at offset 3)
    utils.startTest(@"VBR OEM name is readable")
    ' OEM name is 8 bytes at offset 3, should be printable ASCII
    result := true
    repeat idx from 0 to 7
        if vbrBuf[$03 + idx] < $20 or vbrBuf[$03 + idx] > $7E
            result := false
            quit
    debug("   OEM: ", lstr_(@vbrBuf + $03, 8))
    utils.evaluateBool(result, @"OEM name printable", true)

    ' Test: readVBRRaw() returns valid VBR
    utils.startTest(@"readVBRRaw() succeeds")
    bytefill(@vbrBuf2, 0, sd.SECTOR_SIZE)
    utils.initGuard(@vbrBuf2_guard)
    result := sd.readVBRRaw(@vbrBuf2)
    utils.checkGuard(@vbrBuf2_guard, @"vbrBuf2 guard")
    utils.evaluateSingleValue(result, @"readVBRRaw()", sd.SUCCESS)

    ' Test: readVBRRaw() data matches readSectorRaw VBR
    utils.startTest(@"readVBRRaw() matches readSectorRaw VBR")
    utils.evaluateBufferMatch(@vbrBuf, @vbrBuf2, sd.SECTOR_SIZE, @"VBR data matches")

    ' ======================================================================
    ' TEST GROUP: Disk Full Simulation (O-13)
    ' ======================================================================
    utils.startTestGroup(@"Disk Full Simulation")

    baselineFree := sd.freeSpace()
    debug("   Baseline free space: ", udec_(baselineFree), " sectors")

    ' This whole group depends on the SIMULATED cap (setTestMaxClusters) being the
    ' thing that runs out first. If the card itself has fewer free clusters than the
    ' cap, the E_DISK_FULL these tests observe is real exhaustion, not the simulation
    ' -- and whether that happens depends on how many clusters the PRECEDING groups
    ' happened to leave free. That is an arbitrary pass/fail with no relation to the
    ' code under test, and it is the sharpest landmine the 2026-08-09 audit found.
    dfSecPerClus := sd.sectorsPerCluster()
    dfFreeClus := 0
    if dfSecPerClus > 0
        dfFreeClus := baselineFree / dfSecPerClus
    debug("   Free clusters: ", udec_(dfFreeClus), " (simulated cap is ", udec_(DF_MAX_CLUSTERS), ")")
    ifnot utils.requireSetup(dfSecPerClus > 0 and dfFreeClus > DF_MAX_CLUSTERS + DF_CLUSTER_MARGIN, @"SETUP: card has more free clusters than the simulated cap")
        debug("  *** SETUP NOT MET: need > ", udec_(DF_MAX_CLUSTERS + DF_CLUSTER_MARGIN), " free clusters so the SIMULATED limit is what trips")
        debug("  *** Disk Full Simulation group SKIPPED (a real out-of-space would prove nothing here)")
        cleanupTestFiles()
        sd.setVolumeLabel(@origLabel)
        sd.unmount()
        utils.ShowTestEndCounts()
        debug("END_SESSION")
        return

    ' Test A: E_DISK_FULL on createFileNew with cluster limit
    ' Use limit of 20 to allow root dir cluster + a few data clusters before exhaustion
    utils.startTest(@"E_DISK_FULL on createFileNew with cluster limit")
    utils.setCheckCountPerTest(3)
    sd.setTestMaxClusters(DF_MAX_CLUSTERS)
    filesCreated := 0
    result := 0
    repeat idx from 0 to 29
        dfNameBuf[2] := $30 + idx / 10
        dfNameBuf[3] := $30 + idx // 10
        dfHandle := sd.createFileNew(@dfNameBuf)
        if dfHandle < 0
            result := dfHandle
            quit
        sd.writeHandle(dfHandle, @"X", 1)
        sd.closeFileHandle(dfHandle)
        filesCreated++
    debug("   Files created before full: ", udec_(filesCreated), " result=", sdec_(result))
    utils.evaluateSubBool(filesCreated >= 1, @"at least 1 created", true)
    utils.evaluateSubValue(result, @"error is E_DISK_FULL", sd.E_DISK_FULL)
    ' Was `evaluateSubBool(true, @"guard", true)` -- a check that cannot fail, present
    ' only to make the count reach 3. The real property it should have asserted: the
    ' SIMULATED limit stopped us, not the physical card, so the run must have halted
    ' short of the 30 files the loop would otherwise have made.
    utils.evaluateSubBool(filesCreated < 30, @"stopped before the loop ran out", true)
    utils.showSubTestResults()
    utils.setCheckCountPerTest(1)

    ' Test B: Recovery after disk full - delete and retry
    utils.startTest(@"Recovery after disk full - delete and retry")
    utils.setCheckCountPerTest(2)
    ' Delete the first file to free a cluster
    dfNameBuf[2] := $30
    dfNameBuf[3] := $30
    result := sd.deleteFile(@dfNameBuf)
    utils.evaluateSubValue(result, @"delete DF00", sd.SUCCESS)
    ' Create a new file in the freed space
    dfHandle := sd.createFileNew(@dfTestFile)
    utils.evaluateSubBool(dfHandle >= 0, @"create in freed space", true)
    if dfHandle >= 0
        sd.closeFileHandle(dfHandle)
    utils.showSubTestResults()
    utils.setCheckCountPerTest(1)

    ' Test C: Write-path disk full (write exhausts clusters)
    utils.startTest(@"Write-path disk full exhausts clusters")
    utils.setCheckCountPerTest(3)
    sd.clearTestErrors()
    ' Delete all files from Tests A and B to start with a clean disk
    repeat idx from 0 to 29
        dfNameBuf[2] := $30 + idx / 10
        dfNameBuf[3] := $30 + idx // 10
        sd.deleteFile(@dfNameBuf)
    sd.deleteFile(@dfTestFile)
    sd.setTestMaxClusters(DF_MAX_CLUSTERS)
    ' Compute writes needed to exhaust all possible clusters at any cluster size.
    ' (test_max_clusters - 2) covers clusters 2..19 - the maximum the allocator
    ' can hand out.  Multiply by sec_per_clus to get sector count, then add margin.
    maxWrites := (DF_MAX_CLUSTERS - 2) * sd.sectorsPerCluster() + 1
    debug("   maxWrites=", udec_(maxWrites), " secPerClus=", udec_(sd.sectorsPerCluster()))
    dfHandle := sd.createFileNew(@dfTestFile)
    utils.evaluateSubBool(dfHandle >= 0, @"create for write test", true)
    bytesWritten := 0
    if dfHandle >= 0
        bytefill(@writeBuf, $55, 512)
        repeat maxWrites
            result := sd.writeHandle(dfHandle, @writeBuf, 512)
            if result <= 0
                quit
            bytesWritten += result
        debug("   Bytes written before full: ", udec_(bytesWritten), " last result=", sdec_(result))
        utils.evaluateSubBool(bytesWritten > 0, @"wrote some data", true)
        ' `result <= 0` accepted ANY failure, including a real I/O error or a
        ' zero-byte short write, as proof of the disk-full path. Name the code.
        utils.evaluateSubValue(result, @"write stops with E_DISK_FULL", sd.E_DISK_FULL)
        sd.closeFileHandle(dfHandle)
    else
        utils.evaluateSubBool(false, @"wrote some data", true)
        utils.evaluateSubBool(false, @"write stops with E_DISK_FULL", true)
    utils.showSubTestResults()
    utils.setCheckCountPerTest(1)

    ' Test D: Cleanup and restore - clearTestErrors restores normal operation
    utils.startTest(@"clearTestErrors restores normal operation")
    utils.setCheckCountPerTest(3)
    sd.clearTestErrors()
    ' Delete all disk-full test files
    repeat idx from 0 to 29
        dfNameBuf[2] := $30 + idx / 10
        dfNameBuf[3] := $30 + idx // 10
        sd.deleteFile(@dfNameBuf)
    sd.deleteFile(@dfTestFile)
    ' Verify normal operation restored
    dfHandle := sd.createFileNew(@dfVerifyFile)
    utils.evaluateSubBool(dfHandle >= 0, @"create after clear", true)
    if dfHandle >= 0
        sd.closeFileHandle(dfHandle)
    result := sd.freeSpace()
    debug("   Free space after cleanup: ", udec_(result), " baseline: ", udec_(baselineFree))
    utils.evaluateSubBool(result > 0, @"freeSpace positive", true)
    ' Was `evaluateSubBool(true, @"cleanup done", true)` -- unfailable filler. The
    ' property worth asserting is that the cleanup actually returned the free space
    ' the group borrowed, so a leak here is caught instead of carried forward.
    sd.deleteFile(@dfVerifyFile)
    utils.evaluateSubBool(sd.freeSpace() >= baselineFree, @"free space restored to baseline", true)
    utils.showSubTestResults()
    utils.setCheckCountPerTest(1)

    ' ======================================================================
    ' Cleanup and Summary
    ' ======================================================================
    cleanupTestFiles()

    ' Restore the label unconditionally. The inline restore earlier in the suite is
    ' the one that is SUPPOSED to do this, but it only runs if the remount before it
    ' succeeded -- and when that remount failed, the card was left carrying the test
    ' label "12345678901" for every later run and every human who inserted it.
    sd.setVolumeLabel(@origLabel)

    sd.unmount()

    utils.ShowTestEndCounts()

    debug(" ")
    debug("END_SESSION")

PRI cleanupTestFiles() | idx
' Delete every fixture this suite owns.
'
' Called both BEFORE the body and as teardown, so it must cover the disk-full
' group's DF00..DF29 / DFTEST.BIN / DFVERFY.BIN and the auto-flush group's
' VLFLUSH.TXT as well -- those are only removed inline today, so an abort partway
' through leaves them behind and the next run starts with less free space than it
' thinks. deleteFile() on a missing item just returns an error we ignore.
'
' @local idx - Disk-full file number 0..29 for the generated DFnn.BIN names

    sd.deleteFile(@vlTestFile1)
    sd.deleteFile(@vlTestFile2)
    sd.deleteFile(@vlTestFile3)
    sd.deleteFile(@vlSyncFile)
    sd.deleteFile(@vlDateFile)
    sd.deleteFile(@vlDateFile2)
    sd.deleteFile(@vlLegacyFile)
    sd.deleteFile(@vlFlushFile)
    sd.deleteFile(@vlDateDir)

    ' Disk-full simulation fixtures
    repeat idx from 0 to 29
        dfNameBuf[2] := $30 + idx / 10
        dfNameBuf[3] := $30 + idx // 10
        sd.deleteFile(@dfNameBuf)
    sd.deleteFile(@dfTestFile)
    sd.deleteFile(@dfVerifyFile)

PRI strncmp(p1, p2, maxLen) : match | idx
' Compare first maxLen bytes of two strings
'
' @param p1 - Pointer to first string
' @param p2 - Pointer to second string
' @param maxLen - Number of bytes to compare
' @returns match - TRUE if first maxLen bytes are identical
' @local idx - Byte index (0..maxLen-1)

    match := true
    repeat idx from 0 to maxLen - 1
        if BYTE[p1][idx] <> BYTE[p2][idx]
            match := false
            quit

con { license }

