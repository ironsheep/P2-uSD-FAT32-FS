' CONDITIONAL COMPILATION - Optional Feature Modules
' Default: MINIMAL driver (core file operations only)
' To enable optional features, use #pragma exportdef in your top-level file:
'
'   Application features:
'   #pragma exportdef SD_INCLUDE_ASYNC      ' Non-blocking file I/O: startReadHandle, startWriteHandle, isComplete, getResult
'   #pragma exportdef SD_INCLUDE_DEFRAG     ' Defragmentation: fileFragments, compactFile, createFileContiguous
'
'   Utility features:
'   #pragma exportdef SD_INCLUDE_RAW        ' Raw sector access
'   #pragma exportdef SD_INCLUDE_REGISTERS  ' Card register access (CID/CSD/SCR)
'   #pragma exportdef SD_INCLUDE_SPEED      ' High-speed mode control (requires SD_INCLUDE_REGISTERS)
'
'   Diagnostic features:
'   #pragma exportdef SD_INCLUDE_DEBUG      ' Debug/diagnostic methods & CRC getters
'   #pragma exportdef SD_INCLUDE_STACK_CHECK ' Worker cog stack depth measurement
'   SD_INCLUDE_STACK_REPORT: measurement-build flag, normally injected by the tools
'   as a compile-line define (-D SD_INCLUDE_STACK_REPORT), not a pragma. Implies
'   SD_INCLUDE_STACK_CHECK, enlarges STACK_SIZE (see its CON), and lights the
'   per-suite stack-watermark line in isp_rt_utilities. Release builds never define it.
'
'   Test features:
'   #pragma exportdef SD_INCLUDE_TEST_HOOKS ' Fault injection: make sector I/O fail on purpose
'
'   SD_INCLUDE_TEST_HOOKS is deliberately NOT implied by SD_INCLUDE_DEBUG. A debug
'   build is a legitimate production-diagnostic build that a user may ship enabled;
'   the injection hooks include methods that corrupt a write on purpose and have no
'   place in a shipped product. Only SD_INCLUDE_ALL turns them on.
'
'   OBJ
'       sd : "micro_sd_fat32_fs"
'
' Or define SD_INCLUDE_ALL to include everything (except STACK_CHECK):
'   #pragma exportdef SD_INCLUDE_ALL

#ifdef SD_INCLUDE_ALL
#ifndef SD_INCLUDE_ASYNC
#define SD_INCLUDE_ASYNC
#endif
#ifndef SD_INCLUDE_DEFRAG
#define SD_INCLUDE_DEFRAG
#endif
#ifndef SD_INCLUDE_RAW
#define SD_INCLUDE_RAW
#endif
#ifndef SD_INCLUDE_REGISTERS
#define SD_INCLUDE_REGISTERS
#endif
#ifndef SD_INCLUDE_SPEED
#define SD_INCLUDE_SPEED
#endif
#ifndef SD_INCLUDE_DEBUG
#define SD_INCLUDE_DEBUG
#endif
#ifndef SD_INCLUDE_TEST_HOOKS
#define SD_INCLUDE_TEST_HOOKS
#endif
#endif

#ifdef SD_INCLUDE_STACK_REPORT
#ifndef SD_INCLUDE_STACK_CHECK
#define SD_INCLUDE_STACK_CHECK                  ' REPORT implies CHECK (file-local is enough; CHECK is consumed only in this file)
#endif
#endif

#ifdef SD_INCLUDE_STACK_CHECK
OBJ ' special stack need determination and checking
  stackUtils    : "isp_stack_check"
#endif

CON ' flags
  F_NEWDIR   = decod 1
  F_MOUNTED  = decod 3

CON ' debug channel assignments for selective debug output
  ' All debug() uses debug[CH_xxx]() - DEBUG_MASK controls which channels compile.
  ' Set DEBUG_MASK = 0 for production (no debug code compiled).
  ' Enable 2-3 channels at a time to stay under the 255-record compiler limit.
  CH_INIT     = 0                                                             ' Card initialization, pin setup, speed config
  CH_MOUNT    = 1                                                             ' Mount/unmount, filesystem geometry, FSInfo
  CH_FILE     = 2                                                             ' File handle operations: open, close, read, write, seek, sync
  CH_DIR      = 3                                                             ' Directory operations: search, create, rename, move
  CH_SECTOR   = 4                                                             ' Sector I/O, FAT chain walking, cluster allocation
  CH_STATUS   = 5                                                             ' CMD13/CMD23 probe and runtime status checks
  CH_IDENT    = 6                                                             ' Card identity: CID/CSD/SCR parsing, timeouts
  CH_HSPEED   = 7                                                             ' High-speed mode: CMD6 query, switch, verification
  CH_API      = 8                                                             ' Public API entry points, worker cog, stack guard
  CH_RECOVER  = 9                                                             ' Error recovery: CMD12, bus recovery, wait timeouts

  ' To debug, set DEBUG_MASK to enable channels you need:
  '   DEBUG_MASK = (1 << CH_INIT) | (1 << CH_MOUNT)           ' Debug mount failures
  '   DEBUG_MASK = (1 << CH_FILE) | (1 << CH_SECTOR)          ' Debug file read/write
  '   DEBUG_MASK = (1 << CH_STATUS)                           ' Debug CMD13 issues
  '   DEBUG_MASK = -1                                         ' ALL channels (will exceed 255!)
  DEBUG_MASK  = 0                                                             ' Production: all debug suppressed

CON ' ---- Driver Modes ----
  ' Driver operating modes (enforces valid command sequences):
  '  MODE_NONE       (0) - Not initialized, only mount() or initCardOnly() allowed
  '  MODE_RAW        (1) - Raw sector access only, initCardOnly() was called
  '  MODE_FILESYSTEM (2) - Full filesystem access, mount() was called
  MODE_NONE        = 0
  MODE_RAW         = 1
  MODE_FILESYSTEM  = 2

CON ' command codes for worker cog
  CMD_NONE                 = 0                                                ' Idle / command complete
  CMD_MOUNT                = 1                                                ' Mount filesystem
  CMD_UNMOUNT              = 2                                                ' Unmount filesystem
  CMD_NEWDIR               = 9                                                ' Create new directory: param0=dirname ptr
  CMD_DELETE               = 10                                               ' Delete file: param0=filename ptr
  CMD_RENAME               = 11                                               ' Rename: param0=oldname, param1=newname
  CMD_CHDIR                = 12                                               ' Change directory: param0=dirname ptr
  CMD_READDIR              = 13                                               ' Read directory entry: param0=index
  CMD_FILESIZE             = 14                                               ' Get file size
  CMD_FREESPACE            = 15                                               ' Get free space
  CMD_SYNC                 = 16                                               ' Flush buffers
  CMD_MOVEFILE             = 17                                               ' Move file: param0=name, param1=dest folder
#ifdef SD_INCLUDE_DEBUG
  CMD_DEBUG_SLOW_READ      = 25                                               ' DEBUG: Byte-by-byte sector read (no streamer)
  CMD_DEBUG_ZERO_ROOT_SEC  = 26                                               ' DEBUG: Zero the FIRST root-directory sector only (leaks chains)
  CMD_DEBUG_ERASE_BLOCK    = 42                                               ' DEBUG: Erase one erase-block region: param0=start_sector
#endif
#ifdef SD_INCLUDE_STACK_CHECK
  CMD_STACK_DEPTH          = 50                                               ' DIAG: Report stack depth used
#endif
#ifdef SD_INCLUDE_TEST_HOOKS
  CMD_TEST_INVAL_CACHES    = 51                                               ' TEST: Drop all three sector-cache tags (no I/O)
#endif

  CMD_READ_SECTOR_RAW      = 20                                               ' Raw single sector read: param0=sector, param1=buffer ptr (infrastructure - used across multiple feature flags)

#ifdef SD_INCLUDE_RAW
  CMD_INIT_CARD_ONLY       = 22                                               ' Initialize card without filesystem (raw mode)
  CMD_GET_CARD_SIZE        = 23                                               ' Get card size in sectors: returns in data0
  CMD_READ_SECTORS         = 18                                               ' Raw multi-block read: param0=start_sector, param1=count, param2=buffer ptr
  CMD_WRITE_SECTORS        = 19                                               ' Raw multi-block write: param0=start_sector, param1=count, param2=buffer ptr
  CMD_WRITE_SECTOR_RAW     = 21                                               ' Raw single sector write: param0=sector, param1=buffer ptr
  CMD_TEST_CMD13           = 82                                               ' Test CMD13: returns R2 response in data0
#endif

#ifdef SD_INCLUDE_REGISTERS
  CMD_READ_SCR             = 24                                               ' Read SCR register: param0=buffer ptr
  CMD_READ_CID             = 27                                               ' Read CID register: param0=buffer ptr
  CMD_READ_CSD             = 28                                               ' Read CSD register: param0=buffer ptr
  CMD_READ_SD_STATUS       = 29                                               ' Read SD Status (ACMD13): 64-byte register via CMD55+CMD13
#endif

#ifdef SD_INCLUDE_SPEED
#ifndef SD_INCLUDE_REGISTERS
#error "SD_INCLUDE_SPEED requires SD_INCLUDE_REGISTERS"
#endif
  CMD_ATTEMPT_HIGH_SPEED   = 83                                               ' Attempt 50 MHz high-speed: returns data0=boolean
  CMD_CHECK_HS_CAPABILITY  = 84                                               ' Check CMD6 high-speed support: returns data0=boolean
  CMD_SET_SPI_SPEED        = 85                                               ' Set SPI clock frequency: param0=target Hz, returns data0=actual Hz
#endif

  ' Handle-Based File Commands (multi-file support)
  CMD_OPEN_READ            = 30                                               ' Open file for reading: param0=path ptr, returns data0=handle
  CMD_OPEN_WRITE           = 31                                               ' Open file for writing (append): param0=path ptr, returns data0=handle
  CMD_CREATE               = 32                                               ' Create new file for writing: param0=path ptr, returns data0=handle
  CMD_CLOSE_H              = 33                                               ' Close file handle: param0=handle
  CMD_READ_H               = 34                                               ' Read from handle: param0=handle, param1=buffer ptr, param2=count, returns data0=bytes_read
  CMD_WRITE_H              = 35                                               ' Write to handle: param0=handle, param1=buffer ptr, param2=count, returns data0=bytes_written
  CMD_SEEK_H               = 36                                               ' Seek in handle: param0=handle, param1=position
  CMD_TELL_H               = 37                                               ' Get position: param0=handle, returns data0=position
  CMD_FILESIZE_H           = 38                                               ' Get file size: param0=handle, returns data0=size
  CMD_SYNC_H               = 39                                               ' Sync handle buffer to disk: param0=handle
  CMD_SYNC_ALL             = 40                                               ' Sync all open file handles
  CMD_EOF_H                = 41                                               ' Check end of file: param0=handle, returns data0=true/false
  CMD_OPEN_DIR             = 43                                               ' Open directory: param0=path ptr, returns data0=handle
  CMD_READ_DIR_H           = 44                                               ' Read next dir entry: param0=handle, returns data0=ptr
  CMD_CLOSE_DIR_H          = 45                                               ' Close directory handle: param0=handle
  CMD_SET_VOL_LABEL        = 46                                               ' Set volume label: param0=new label string ptr
#ifdef SD_INCLUDE_DEFRAG
  CMD_CREATE_CONTIGUOUS    = 47                                               ' Create file with pre-allocated contiguous chain: param0=path ptr, param1=file_size, returns data0=handle
  CMD_COMPACT_FILE         = 48                                               ' Defragment a single file: param0=path ptr
  CMD_FILE_FRAGMENTS       = 49                                               ' Count file fragmentation: param0=path ptr, returns data0=fragment_count
#endif

CON ' buffer types for sector read/write (diagnostic: separate buffers to isolate conflicts)
  BUF_DIR   = 0                                                               ' Directory sector buffer
  BUF_FAT   = 1                                                               ' FAT sector buffer
  BUF_DATA  = 2                                                               ' Data sector buffer

CON ' error codes
  {Spin2_Doc_CON}
  SUCCESS                  = 0
  END_OF_CHAIN             = 1                                                ' readNextSector(): chain ended, zeros served (not an error; callers checking < 0 are unaffected)
  E_TIMEOUT                = -1                                               ' Card didn't respond in time
  E_NO_RESPONSE            = -2                                               ' Card not responding
  E_BAD_RESPONSE           = -3                                               ' Unexpected response from card
  E_CRC_ERROR              = -4                                               ' Data CRC mismatch
  E_WRITE_REJECTED         = -5                                               ' Card rejected write operation
  E_CARD_BUSY              = -6                                               ' Card busy
  E_IO_ERROR               = -7                                               ' General I/O error during read/write
  E_NO_CARD                = -8                                               ' No card detected in slot (MISO idle during CMD0 probe)
  E_BAD_PIN_CONFIG         = -9                                               ' SPI pins too far apart (SCK must be within +/-3 of MOSI and MISO)
  E_NOT_MOUNTED            = -20                                              ' Filesystem not mounted
  E_INIT_FAILED            = -21                                              ' Card initialization failed
  E_NOT_FAT32              = -22                                              ' Card not formatted as FAT32
  E_BAD_SECTOR_SIZE        = -23                                              ' Sector size not 512 bytes
  E_BAD_FSINFO             = -24                                              ' FSInfo sector signatures invalid (free-space hint cannot be updated)
  E_BAD_CHAIN              = -25                                              ' Cluster chain disagrees with the directory entry (chain walk went wrong)
  E_STACK_OVERFLOW         = -26                                              ' Worker cog wrote past its stack -- nothing it reports can be trusted
  E_FILE_NOT_FOUND         = -40                                              ' File doesn't exist
  E_FILE_EXISTS            = -41                                              ' File already exists
  E_NOT_A_FILE             = -42                                              ' Expected file, found directory
  E_NOT_A_DIR              = -43                                              ' Expected directory, found file
  E_DIR_NOT_EMPTY          = -44                                              ' Directory still contains entries (delete refused; empty it first)
  E_FILE_NOT_OPEN          = -45                                              ' RESERVED -- never produced; the driver reports E_INVALID_HANDLE for a closed handle
  E_END_OF_FILE            = -46                                              ' Read past end of file
  E_FILE_OPEN              = -47                                              ' File has an open handle (delete refused; close it first)
  E_DISK_FULL              = -60                                              ' No free clusters
#ifdef SD_INCLUDE_DEFRAG
  E_NO_CONTIGUOUS_SPACE    = -61                                              ' No contiguous run of sufficient length
  E_FILE_OPEN_FOR_COMPACT  = -62                                              ' File is open (cannot compact while open)
  E_VERIFY_FAILED          = -63                                              ' Read-back verification failed after compact
#endif
  E_NO_LOCK                = -64                                              ' Couldn't allocate hardware lock
  E_NO_COG                 = -65                                              ' No free cog to run the worker (all eight in use)

  ' Multi-File Handle Error Codes
  E_TOO_MANY_FILES         = -90                                              ' All file handles are in use
  E_INVALID_HANDLE         = -91                                              ' Handle out of range or not open
  E_FILE_ALREADY_OPEN      = -92                                              ' File is already open for writing (single-writer policy)
  E_NOT_A_DIR_HANDLE       = -93                                              ' Handle is not a directory handle (or vice versa)
  E_INVALID_PARAM          = -94                                              ' Parameter value out of valid range

CON ' card warning/capability flags
  {Spin2_Doc_CON}
  CW_NONE              = $00                                                  ' No warnings or capabilities
  CW_CMD13_UNRELIABLE  = $01                                                  ' CMD13 probe failed at init; status checks disabled for this card
  CW_CMD23_SUPPORTED   = $02                                                  ' CMD23 (SET_BLOCK_COUNT) confirmed working in SPI mode
  CW_NO_DATA_CRC       = $04                                                  ' Card returns a dummy data-block CRC; read-CRC validation disabled for this card

#ifdef SD_INCLUDE_TEST_HOOKS
CON ' targeted fault-injection modes [SD_INCLUDE_TEST_HOOKS]
  {Spin2_Doc_CON}
  ' Passed as the mode argument to setTestFailSector(). Combine the direction
  ' with TF_STICKY to keep failing; without it the armed failure is one-shot.
  TF_OFF               = %000                                                 ' Disarm
  TF_READ              = %001                                                 ' Fail readSector() at the named LBA
  TF_WRITE             = %010                                                 ' Fail writeSector() at the named LBA
  TF_BOTH              = %011                                                 ' Fail both directions at the named LBA
  TF_STICKY            = %100                                                 ' Modifier: keep failing until cleared (default is one-shot)
#endif

CON ' Multi-file handle configuration
  {Spin2_Doc_CON}
  ' FILE HANDLE SYSTEM - supports multiple simultaneously open files
  ' User can override MAX_OPEN_FILES in their top-level CON section before OBJ
  ' Memory cost: 548 bytes per handle (36 bytes state + 512 bytes buffer)
  ' Default 6 covers 2-3 cogs with mixed file/directory operations
  MAX_OPEN_FILES  = 6                                                         ' Default number of handles (user-overridable)

  ' Handle state flags (stored in h_flags array):
  '  HF_FREE  (0)   - Handle slot is available for allocation
  '  HF_READ  (1)   - Handle is open for reading
  '  HF_WRITE (2)   - Handle is open for writing
  '  HF_DIR   (4)   - Handle is a directory enumeration handle
  '  HF_DIRTY ($80) - Handle buffer has pending writes (OR'd with mode)
  HF_FREE         = 0
  HF_READ         = 1
  HF_WRITE        = 2
  HF_DIR          = 4
  HF_DIRSTALE     = $40                                 ' Directory entry update failed and is owed (see do_sync_h)
  HF_DIRTY        = $80

CON ' worker cog stack size
  ' RELEASE SIZING FORMULA: release STACK_SIZE = (max watermark measured across a FULL
  ' successful hardware sweep with -D SD_INCLUDE_STACK_REPORT) + 32 longs minimum
  ' headroom, rounded UP to a multiple of 16, annotated here with the sweep date and
  ' card serial it was measured on. Applied ONLY after that full sweep passes -- the
  ' stack-finalization task owns applying it.
  '
  ' MEASURED v1.7.0, 2026-08-12: peak 122 of 512 longs, in SD_RT_defrag_tests, IDENTICAL
  ' on both certifying cards -- SN $0000_0F14 (Gigastone ASTC SDXC 58GB) and SN $0001_B9D5
  ' (SharedOEM/Gigastone SDHC 7GB), each a full 27-suite / 574-test sweep at 574/574.
  ' Formula: 122 + 32 = 154, rounded up to a multiple of 16 = 160. The release value is
  ' therefore unchanged from the pre-f34610f sizing, now re-derived from a current sweep
  ' rather than inherited: the +1237-line f34610f growth did not deepen the worst-case
  ' call chain, and 160 carries 38 longs of headroom over the measured peak.
#ifdef SD_INCLUDE_STACK_REPORT
  STACK_SIZE         = 512                                                    ' MEASUREMENT BUILD: generous headroom so the watermark, not an overflow, is the datum
#else
  STACK_SIZE         = 160                                                    ' 160 longs = 640 bytes (measured peak 122 longs, 2026-08-12 two-card sweep -- see formula above)
#endif
  STACK_GUARD_LONGS  = 4                                                      ' 4 longs = 16 bytes guard zone after stack
  STACK_GUARD_BYTE   = $CC                                                    ' Sentinel value (matches isp_rt_utilities convention)

CON ' idle flush threshold
  IDLE_FLUSH_MS  = 200                                                        ' Milliseconds idle before auto-flush

CON ' sector geometry
  {Spin2_Doc_CON}
  SECTOR_SIZE  = 512                                                          ' Bytes per sector (FAT32 standard)

CON ' sector geometry (internal)
  SECTOR_SHIFT        = 9                                                     ' log2(SECTOR_SIZE) -- byte-to-sector conversion
  SECTOR_OFFSET_MASK  = 511                                                   ' SECTOR_SIZE - 1 -- byte offset within sector

CON ' FAT32 directory entry attribute flags
  {Spin2_Doc_CON}
  ATTR_READONLY   = $01                                                       ' File is read-only
  ATTR_HIDDEN     = $02                                                       ' File is hidden
  ATTR_SYSTEM     = $04                                                       ' System file
  ATTR_VOLUME_ID  = $08                                                       ' Volume label entry
  ATTR_DIRECTORY  = $10                                                       ' Directory entry
  ATTR_ARCHIVE    = $20                                                       ' Archive flag (set on write)
  ATTR_LFN        = $0F                                                       ' Long filename entry (RO+HID+SYS+VOL)

CON ' FAT32 directory entry markers
  {Spin2_Doc_CON}
  DIR_ENTRY_DELETED  = $E5                                                    ' First byte marks deleted entry
  DIR_ENTRY_SIZE     = 32                                                     ' Bytes per directory entry

CON ' FAT32 cluster chain markers (FAT32 File System Spec)
  FAT32_EOC_MIN        = $0FFF_FFF8                                           ' Minimum end-of-chain marker
  FAT32_EOC_MARK       = $0FFF_FFFF                                           ' End-of-chain marker for new allocations
  FAT32_ENTRY_MASK     = $0FFF_FFFF                                           ' Low 28 bits: cluster number
  FAT32_RESERVED_MASK  = $F000_0000                                           ' High 4 bits: reserved (preserve on write)
  ROOT_CLUSTER         = 2                                                    ' First data cluster (clusters 0,1 reserved)
  EXPECTED_FAT_COUNT   = 2                                                    ' Standard FAT32 has 2 FATs

CON ' ---- MBR/VBR Structure Constants ----
  {Spin2_Doc_CON}
  MBR_PARTITION_OFFSET   = $1BE                                               ' Byte offset of first partition entry in MBR
  MBR_PART_TYPE_OFFSET   = $1C2                                               ' Byte offset of partition 1 type in MBR
  MBR_PART_LBA_OFFSET    = $1C6                                               ' Byte offset of partition 1 LBA start in MBR
  MBR_PART_SIZE_OFFSET   = $1CA                                               ' Byte offset of partition 1 size in sectors
  BOOT_SIGNATURE         = $AA55                                              ' MBR/VBR boot signature
  BOOT_SIG_OFFSET        = $1FE                                               ' Byte offset of boot signature in sector
  PART_TYPE_FAT32_LBA28  = $0B                                                ' FAT32 partition type (CHS/LBA < 2TB)
  PART_TYPE_FAT32_LBA    = $0C                                                ' FAT32 partition type (LBA)
  FAT_EPOCH_YEAR         = 1980                                               ' FAT timestamp base year

CON ' FSInfo sector signatures
  FSINFO_LEAD_SIG    = $4161_5252                                             ' FSInfo lead signature
  FSINFO_STRUCT_SIG  = $6141_7272                                             ' FSInfo struct signature

CON ' 8.3 Short Filename (SFN) constants
  SFN_NAME_LEN      = 8
  SFN_EXT_LEN       = 3
  SFN_TOTAL_LEN     = 11
  SFN_WITH_DOT_LEN  = 12

CON ' ASCII constants
  ASCII_CASE_OFFSET  = $20                                                    ' lowercase - uppercase

CON ' Directory/FAT iteration counts
  FAT_ENTRIES_PER_SECTOR  = 128                                               ' SECTOR_SIZE / 4
  DIR_ENTRIES_PER_SECTOR  = 16                                                ' SECTOR_SIZE / DIR_ENTRY_SIZE
  LAST_DIR_ENTRY_OFFSET   = 480                                               ' (DIR_ENTRIES_PER_SECTOR - 1) * DIR_ENTRY_SIZE

CON ' Directory entry field byte offsets
  {Spin2_Doc_CON}
  DE_ATTR_OFFSET      = 11                                                    ' Attributes byte
  DE_CRT_TIME_OFFSET  = 14                                                    ' Creation timestamp (long)
  DE_CLUS_HI_OFFSET   = 20                                                    ' Start cluster high word
  DE_WRT_TIME_OFFSET  = 22                                                    ' Write/modification timestamp (long)
  DE_CLUS_LO_OFFSET   = 26                                                    ' Start cluster low word
  DE_FILESIZE_OFFSET  = 28                                                    ' File size in bytes (long)

CON ' streamer configuration (compile-time constants for bulk sector transfers)
  ' Reference: flash_loader.spin2 pattern, P2 Silicon Doc streamer section
  ' Using explicit hex values from working flash_loader code:
  ' Mode word: [31:28]=mode [27:24]=options [23:17]=pin [16:0]=count
  ' $C0 = 1-pin input to WFBYTE (RX), $80 = RFBYTE to 1-pin output (TX)
  ' $81 = X_ALT_ON (MSB-first, bit 7) + X_WRITE_ON/X_PINS_ON (bit 0)
  STREAM_RX_BASE  = $C081_0000                                                ' 1-pin input to hub, MSB-first (flash_loader wmode)
  STREAM_TX_BASE  = $8081_0000                                                ' hub to 1-pin output, MSB-first (flash_loader rmode)

CON ' CRC-16-CCITT configuration (using P2 GETCRC instruction)
  ' Replaces 512-byte lookup table with hardware GETCRC + transformation
  ' Formula: crc := ((GETCRC(@data, CRC_POLY, 512) ^ CRC_BASE_512) REV 31) >> 16
  CRC_POLY_REFLECTED  = $8408                                                 ' CRC-16-CCITT in LSB-first (reflected) form
  CRC_BASE_512        = $2C68                                                 ' GETCRC of 512 zero bytes with poly $8408

CON ' CRC retry configuration
  MAX_READ_CRC_RETRIES  = 3                                                   ' Number of read retries on CRC mismatch (industry standard)
  PROBE_SCK_SAMPLES     = 8                                                   ' probeSpiCeiling: clean reads required at each candidate hp; first mismatch derates

CON ' SD SPI command numbers (SD Physical Layer Spec)
  CMD0    = 0                                                                 ' GO_IDLE_STATE
  CMD6    = 6                                                                 ' SWITCH_FUNC (high-speed mode)
  CMD8    = 8                                                                 ' SEND_IF_COND (voltage check)
  CMD9    = 9                                                                 ' SEND_CSD
  CMD10   = 10                                                                ' SEND_CID
  CMD12   = 12                                                                ' STOP_TRANSMISSION - terminates multi-block read/write
  CMD13   = 13                                                                ' SEND_STATUS - get card status register (R2 response)
  CMD16   = 16                                                                ' SET_BLOCKLEN - set data block length (mandatory for SDSC)
  CMD17   = 17                                                                ' READ_SINGLE_BLOCK
  CMD18   = 18                                                                ' READ_MULTIPLE_BLOCK - read consecutive sectors
  CMD23   = 23                                                                ' SET_BLOCK_COUNT - pre-define sector count for CMD18/CMD25
  CMD24   = 24                                                                ' WRITE_BLOCK
  CMD25   = 25                                                                ' WRITE_MULTIPLE_BLOCK - write consecutive sectors
  CMD32   = 32                                                                ' ERASE_WR_BLK_START_ADDR - first sector of erase range
  CMD33   = 33                                                                ' ERASE_WR_BLK_END_ADDR - last sector of erase range
  CMD38   = 38                                                                ' ERASE - perform erase on selected range
  ACMD41  = 41                                                                ' SD_SEND_OP_COND (requires CMD55 prefix)
  ACMD51  = 51                                                                ' SEND_SCR (requires CMD55 prefix)
  CMD55   = 55                                                                ' APP_CMD prefix
  CMD58   = 58                                                                ' READ_OCR

CON ' SPI R1 response bit masks (SD Physical Layer Spec section 7.3.2.1)
  R1_IN_IDLE     = $01
  R1_FATAL_MASK  = $64                                                        ' Illegal + Address + Parameter
  R1_STALE_MASK  = $1B                                                        ' Idle + Erase reset + CRC + Erase seq

CON ' Data response token mask
  DATA_RESPONSE_MASK  = $1F

CON ' Pre-computed CRC bytes for fixed-argument commands
  CRC_CMD0    = $95
  CRC_CMD8    = $87
  CRC_CMD9    = $AF
  CRC_CMD10   = $1B
  CRC_CMD12   = $61
  CRC_CMD55   = $65
  CRC_ACMD51  = $55
  CRC_NONE    = $FF                                                           ' CRC not validated in SPI mode after init

CON ' CMD8 / ACMD41 / OCR constants
  CMD8_CHECK_PATTERN  = $000001AA                                             ' VHS=1, pattern=$AA
  CMD8_ECHO_MASK      = $FFF
  CMD8_ECHO_EXPECTED  = $1AA
  ACMD41_HCS_BIT      = $40000000                                             ' Host Capacity Support
  OCR_CCS_SHIFT       = 30                                                    ' Card Capacity Status bit position

CON ' Card initialization timing
  POWER_ON_DELAY_MS        = 100                                              ' VDD stabilization delay (spec: 1ms minimum)
  INIT_SPI_FREQ            = 400_000                                          ' 400 kHz per SD spec during init
  SMARTPIN_SETTLE_US       = 100                                              ' Smart pin configuration settle time
  RECOVERY_FLUSH_CLKS      = 4096                                             ' Mandatory baseline clocks during init flush
  RECOVERY_BUSY_TIMEOUT_CLKS = 65536                                           ' Additional clocks to poll MISO release (~2s @ ~50kHz)
  CMD0_MAX_RETRIES         = 5                                                ' GO_IDLE_STATE retry count
  CMD_RETRY_DELAY_MS       = 10                                               ' Delay between CMD0 retries
  ACMD41_TIMEOUT_SECS      = 2                                                ' ACMD41 init loop timeout
  ACMD41_POLL_DELAY_MS     = 10                                               ' Delay between ACMD41 polls
  INIT_DUMMY_BYTES         = 10                                               ' Dummy bytes after smart pin init (80+ clocks)
  POST_INIT_DUMMY_REPS     = 8                                                ' Dummy transfers after speed change (64 clocks)

  ' Card Status Register (CSR) bits - returned by CMD13 (R2 response = R1 + status byte)
  ' Reference: SD Physical Layer Spec section 4.10.1
  ' R2 response is 2 bytes: first byte = R1, second byte = status flags
  ' Status byte bit definitions (directly from SD spec):
  CSR_CARD_IS_LOCKED       = $01                                              ' Bit 0: Card is locked
  CSR_WP_ERASE_SKIP        = $02                                              ' Bit 1: Write protect erase skip / lock/unlock cmd failed
  CSR_ERROR                = $04                                              ' Bit 2: General/unknown error
  CSR_CC_ERROR             = $08                                              ' Bit 3: Card controller error
  CSR_CARD_ECC_FAILED      = $10                                              ' Bit 4: Card internal ECC failed
  CSR_WP_VIOLATION         = $20                                              ' Bit 5: Write protect violation
  CSR_ERASE_PARAM          = $40                                              ' Bit 6: Invalid erase parameter
  CSR_OUT_OF_RANGE         = $80                                              ' Bit 7: Out of range / CSD overwrite error

  ' SD SPI Data Tokens (reference: SD Physical Layer Spec section 7.3.3)
  TOKEN_START_BLOCK        = $FE                                              ' Start token for single-block read/write and multi-block read
  TOKEN_START_MULTI_WRITE  = $FC                                              ' Start token for each block in multi-block WRITE
  TOKEN_STOP_TRAN          = $FD                                              ' Stop token to terminate multi-block WRITE (not CMD12!)

  ' Data Response Token format (after each block write): xxx0sss1
  ' sss = status: 010 = accepted, 101 = CRC error, 110 = write error
  DATA_ACCEPTED            = $05                                              ' Lower 5 bits = xxx00101 = data accepted
  DATA_CRC_ERROR           = $0B                                              ' Lower 5 bits = xxx01011 = CRC error
  DATA_WRITE_ERROR         = $0D                                              ' Lower 5 bits = xxx01101 = write error

CON ' struct types - SD card register and FAT32 on-disk data structures
  {Spin2_Doc_CON}
  ' Struct type definitions for card registers, filesystem structures, and
  ' directory entries. Exported automatically to consumer objects via OBJ.
  ' All structs are packed (Spin2 default) - offsets match hardware/on-disk layouts.

  ' --- SD Card Registers ---

  ' CID register (16 bytes, big-endian from card):
  '  mid      - Manufacturer ID (1 byte)
  '  oid[2]   - OEM/Application ID (2 bytes ASCII)
  '  pnm[5]   - Product name (5 bytes ASCII)
  '  prv      - Product revision (1 byte, BCD: high=major, low=minor)
  '  psn[4]   - Product serial number (4 bytes)
  '  mdt[2]   - Manufacturing date (2 bytes: year offset from 2000, month)
  '  crc      - CRC7 checksum (1 byte)
  STRUCT cid_t(BYTE mid, BYTE oid[2], BYTE pnm[5], BYTE prv, BYTE psn[4], BYTE mdt[2], BYTE crc)

  ' SCR register (8 bytes, big-endian from card):
  '  sdSpec       - SD spec version (4 bits)
  '  sdSecurity   - Security protocol support (4 bits)
  '  sdSpec3Ext   - Spec 3.0 extended fields
  '  sdSpecXLo    - Spec extensions (lower bits)
  '  reserved[4]  - Reserved bytes
  STRUCT scr_t(BYTE sdSpec, BYTE sdSecurity, BYTE sdSpec3Ext, BYTE sdSpecXLo, BYTE reserved[4])

  ' --- FAT32 On-Disk Structures ---

  ' Directory entry (32 bytes, little-endian):
  '  name[8]    - Short filename (8 chars, space-padded)
  '  ext[3]     - Extension (3 chars, space-padded)
  '  attr       - Attribute flags (ATTR_READONLY, ATTR_DIRECTORY, etc.)
  '  ntRes      - Reserved for Windows NT (case info)
  '  crtTenth   - Creation time tenths of a second
  '  crtTime    - Creation time (hour:min:sec/2)
  '  crtDate    - Creation date (year-1980:month:day)
  '  accDate    - Last access date
  '  clusHI     - Start cluster high word
  '  wrtTime    - Last write time
  '  wrtDate    - Last write date
  '  clusLO     - Start cluster low word
  '  fileSize   - File size in bytes
  STRUCT dir_entry_t(BYTE name[8], BYTE ext[3], BYTE attr, BYTE ntRes, BYTE crtTenth,  ...
    WORD crtTime, WORD crtDate, WORD accDate, WORD clusHI,                             ...
    WORD wrtTime, WORD wrtDate, WORD clusLO, LONG fileSize)

  ' MBR partition table entry (16 bytes, little-endian):
  '  bootFlag     - Boot indicator ($00=inactive, $80=active)
  '  chsStart[3]  - CHS address of first sector
  '  partType     - Partition type ($0B/$0C = FAT32)
  '  chsEnd[3]    - CHS address of last sector
  '  lbaStart     - LBA of first sector
  '  lbaSize      - Total sectors in partition
  STRUCT mbr_partition_t(BYTE bootFlag, BYTE chsStart[3], BYTE partType,        ...
    BYTE chsEnd[3], LONG lbaStart, LONG lbaSize)

  ' VBR / FAT32 BPB (512 bytes, little-endian):
  '  -- Boot header --
  '  jumpBoot[3]     - Boot jump instruction ($EB xx $90)
  '  oemName[8]      - OEM name / formatting tool ID
  '  -- BPB geometry --
  '  bytesPerSec     - Bytes per sector (always 512)
  '  secPerClus      - Sectors per cluster (power of 2)
  '  reservedSec     - Reserved sectors before first FAT
  '  numFats         - Number of FAT copies (always 2)
  '  rootEntCnt      - Root entry count (0 for FAT32)
  '  totalSec16      - Total sectors 16-bit (0 for FAT32)
  '  mediaType       - Media type ($F8 = hard disk)
  '  secPerFat16     - Sectors per FAT 16-bit (0 for FAT32)
  '  secPerTrack     - Sectors per track (CHS geometry)
  '  numHeads        - Number of heads (CHS geometry)
  '  hiddenSec       - Hidden sectors before partition
  '  totalSec32      - Total sectors 32-bit
  '  -- FAT32 extended --
  '  secPerFat32     - Sectors per FAT (32-bit)
  '  extFlags        - FAT mirroring flags
  '  fsVersion       - Filesystem version (0.0)
  '  rootCluster     - Root directory first cluster (usually 2)
  '  fsInfoSec       - FSInfo sector number (usually 1)
  '  backBootSec     - Backup boot sector (usually 6)
  '  reserved2[12]   - Reserved
  '  driveNum        - BIOS drive number
  '  reserved3       - Reserved
  '  bootSig         - Extended boot signature ($29)
  '  volSerialNum    - Volume serial number
  '  volLabel[11]    - Volume label (space-padded)
  '  fsTypeLabel[8]  - Filesystem type string ("FAT32   ")
  '  bootCode[420]   - Boot code
  '  bootSignature   - Boot signature ($AA55)
  STRUCT vbr_t(BYTE jumpBoot[3], BYTE oemName[8], WORD bytesPerSec, BYTE secPerClus,  ...
    WORD reservedSec, BYTE numFats, WORD rootEntCnt, WORD totalSec16,                 ...
    BYTE mediaType, WORD secPerFat16, WORD secPerTrack, WORD numHeads,                ...
    LONG hiddenSec, LONG totalSec32, LONG secPerFat32, WORD extFlags,                 ...
    WORD fsVersion, LONG rootCluster, WORD fsInfoSec, WORD backBootSec,               ...
    BYTE reserved2[12], BYTE driveNum, BYTE reserved3, BYTE bootSig,                  ...
    LONG volSerialNum, BYTE volLabel[11], BYTE fsTypeLabel[8],                        ...
    BYTE bootCode[420], WORD bootSignature)

  ' FSInfo sector (512 bytes, little-endian):
  '  leadSig        - Lead signature ($41615252)
  '  reserved1[480] - Reserved (must be zero)
  '  structSig      - Struct signature ($61417272)
  '  freeClusters   - Free cluster count ($FFFFFFFF if unknown)
  '  nextFreeHint   - Next free cluster hint ($FFFFFFFF if unknown)
  '  reserved2[12]  - Reserved
  '  trailSig       - Trail signature ($AA550000)
  STRUCT fsinfo_t(LONG leadSig, BYTE reserved1[480], LONG structSig,            ...
    LONG freeClusters, LONG nextFreeHint, BYTE reserved2[12], LONG trailSig)

DAT  ' ---- Singleton Control ----
        ' SINGLETON CONTROL - Must be initialized to "not started" state
        cog_id                                  LONG    -1                       ' Worker cog ID (-1 = not started)
        api_lock                                LONG    -1                       ' Hardware lock ID (-1 = not allocated)
        driver_mode                             LONG    0                        ' Current mode: MODE_NONE, MODE_RAW, or MODE_FILESYSTEM
        last_init_error                         LONG    0                        ' Specific error from last initCard() failure
        fat_io_status                           LONG    0                        ' Companion to readFat(): SUCCESS, or E_IO_ERROR when the returned pointer is stale
        fsinfo_error                            LONG    0                        ' Companion to updateFSInfo(): why FALSE was returned (0 = nothing to update, not a failure)
        freespace_error                         LONG    0                        ' Companion to do_freespace(): set when the FAT scan did not complete
        hs_supported                            LONG    0                        ' Companion to probeHighSpeed(): the ANSWER, once the status says it was obtained
        hs_query_error                          LONG    0                        ' Companion to the high-speed capability queries: set when the card could not be ASKED

        ' HIGH-SPEED MODE STATE (2026-08-18). TRUE if and only if the CARD is in
        ' CMD6 high-speed mode. Set at the ONE point where the switch is verified
        ' (do_attempt_high_speed); cleared at the ONE point that switches the card
        ' back (applyDefaultSpeedMode). Nothing else may write it.
        '
        ' This exists because the mode cannot be inferred from the host clock. The
        ' old test -- spi_freq >= 50_000_000 -- is false at every sysclk that cannot
        ' land on exactly 50 MHz, including this project's own 350 MHz default where
        ' high speed resolves to hp=4 / 43_750_000 Hz. Two consumers read that literal
        ' (isHighSpeedActive, clampUserSpeed) and both answered "not high speed" while
        ' the card was in high-speed mode.
        '
        ' Declared unconditionally although only [SD_INCLUDE_SPEED] code can set it:
        ' isHighSpeedActive() is compiled in every build, and in a build without the
        ' speed feature this stays 0 forever -- correct by construction, since there
        ' is then no way into high-speed mode at all.
        hs_mode_active                          LONG    0                        ' TRUE while the card is in CMD6 high-speed mode
        advance_cluster_error                   LONG    0                        ' Companion to writeAdvanceCluster(): E_IO_ERROR vs E_DISK_FULL when it returns FALSE
        search_io_status                        LONG    0                        ' Companion to searchDirectory(): SUCCESS, or E_IO_ERROR when FALSE means "could not look" not "not there"
        search_parent_sec                       LONG    0                        ' Companion to searchDirectory(): first sector of the directory the final component was scanned in

        ' CMD13 STATUS STAGING - Preserved for diagnostic inspection
        last_cmd13_r1                           BYTE    0                        ' Last R1 byte from CMD13
        last_cmd13_status                       BYTE    0                        ' Last STATUS byte from CMD13
        last_cmd13_error                        WORD    0                        ' Last non-zero R2 (preserved until next error)
        last_cmd18_r1                           BYTE    0                        ' Last R1 byte from CMD18 (for multi-block read diagnostics)
        last_cmd18_token                        BYTE    0                        ' Last data token or error token from CMD18 waitDataToken()
        last_cmd18_result                       BYTE    0                        ' Last waitDataToken() result: 0=ok, 1=timeout, 2=error token
        last_cmd18_fail                         BYTE    0                        ' Failure path: 0=none, 1=R1 reject, 2=data token, 3=CMD12, 4=CMD13
        last_cmd18_sread                        BYTE    0                        ' sectors_read at end of loop (before CMD12/CMD13)
        last_cmd12_r1                           BYTE    0                        ' Last R1 from CMD12 (sendStopTransmission)
        last_cmd12_busy                         BYTE    0                        ' CMD12 busy result: 0=ok, 1=timeout, 2=R1 error, 3=busy timeout
        cmd12_capture_len                       BYTE    0                        ' Number of bytes captured in cmd12_capture[]
        cmd12_capture                           BYTE    0[16]                    ' Raw byte stream after CMD12 stuff byte (for framing analysis)
        cmd12_pre_capture                       BYTE    0[7]                     ' MISO bytes received DURING CMD12 command transmission (full-duplex)
        last_cmd23_r1                           BYTE    0                        ' Last R1 from CMD23 (SET_BLOCK_COUNT): $00=accepted, $FF=not sent
        last_cmd23_verify                       BYTE    0                        ' Post-read verification byte: $FF=card stopped, other=still streaming
        last_cmd23_used                         BYTE    FALSE                    ' TRUE if CMD23 path was used for the last multi-block read
        cmd13_reliable                          BYTE    TRUE                     ' FALSE if CMD13 probe failed at init (default: enabled)
        cmd23_supported                         BYTE    FALSE                    ' TRUE if card advertises CMD23 in SCR CMD_SUPPORT
        card_warning_flags                      BYTE    CW_NONE                  ' Advisory bitmask (queried via cardWarnings())
        cmd13_pre_capture                       BYTE    0[7]                     ' MISO bytes received DURING CMD13 command transmission (full-duplex)
        cmd13_capture                           BYTE    0[8]                     ' Raw bytes post-command: NCR gap $FFs, R1, STATUS, extra bytes
        cmd13_capture_len                       BYTE    0                        ' Position of first non-$FF byte in cmd13_capture (NCR gap length)
        test_force_cmd13                        BYTE    FALSE                    ' Diagnostic: force CMD13 even on cards flagged unreliable

        ' PARAMETER BLOCK - Communication between API and worker cog
        pb_cmd                                  LONG    0                        ' Command (0 = idle/done)
        pb_status                               LONG    0                        ' Result status code
        pb_caller                               LONG    0                        ' Caller's cog ID (for COGATN signal)
        pb_param0                               LONG    0                        ' Parameter 0 (varies by command)
        pb_param1                               LONG    0                        ' Parameter 1
        pb_param2                               LONG    0                        ' Parameter 2
        pb_param3                               LONG    0                        ' Parameter 3
        pb_data0                                LONG    0                        ' Result data 0 (handle, count, etc.)
        pb_data1                                LONG    0                        ' Result data 1

        ' WORKER LOOP STATE (idle flush + clock tick)
        idle_timer                              LONG    0                        ' getct() at last command completion
        idle_flush_clocks                       LONG    0                        ' Threshold in clock ticks (set at mount time)
        flush_done                              BYTE    false                    ' TRUE after idle flush completes (reset on next command)

        ' The idle flush is started by the worker itself, so there is no caller to return a
        ' status to and no cog error slot that would be the right place to put one. Without
        ' this field a background flush failure reaches NOBODY: the data never lands and
        ' every later API call still reports success. Sticky on the FIRST failure -- a
        ' later clean flush must not erase it before anyone has looked -- and cleared only
        ' by clearFlushError(), never by reading. Read via lastFlushError().
        flush_error                             LONG    0                        ' First failure seen by an automatic idle flush (0 = none since last clear)
        ct_active                               BYTE    0                        ' TRUE when live clock is enabled (set by setDate)
        ct_last_tick                            LONG    0                        ' getct() at last clock tick
        ct_tick_clocks                          LONG    0                        ' Clock ticks per 2-second interval (set at mount)
        async_active                            BYTE    0                        ' TRUE when an async operation is in flight
        async_caller                            BYTE    0                        ' Cog ID of the async caller

        ' WORKER COG STACK
        '
        ' THE ORDER AND THE GAP HERE ARE BOTH LOAD-BEARING. Two separate overflow detectors
        ' watch this stack, and they must not share memory:
        '
        '   1. isp_stack_check (the formal stack-check object) writes its DO_NOT_WRITE_MARK
        '      sentinel to LONG[@cog_stack][STACK_SIZE] -- one long PAST the stack. Its user
        '      guide states the caller "must" declare that sentinel long immediately after the
        '      stack buffer. cog_stack_end_mark IS that long. It is the object's memory.
        '   2. cog_stack_guard is this driver's own always-compiled guard ($CC fill).
        '
        ' Without cog_stack_end_mark between them, the object's sentinel address IS
        ' cog_stack_guard[0], and the two detectors demand different values at the same
        ' address ($addee5e5 vs $CC) -- a requirement no single value can satisfy. start()
        ' writes the guard first and the object's sentinel second, so the guard lost every
        ' time and checkStackGuard() became a stuck-at-FAIL detector: it reported overflow
        ' after every command, on a stack that had not overflowed. That was invisible while
        ' the violation only reached DEBUG, and became E_STACK_OVERFLOW (-26) on every
        ' command once the check was escalated to the caller.
        '
        ' Do not remove cog_stack_end_mark, and do not move cog_stack_guard adjacent to
        ' cog_stack.
        cog_stack                               LONG    0[STACK_SIZE]            ' Worker cog stack
        cog_stack_end_mark                      LONG    0                        ' isp_stack_check's sentinel -- ITS memory, per its contract
        cog_stack_guard                         LONG    0[STACK_GUARD_LONGS]     ' Stack overflow sentinel ($CC fill)
        stack_peak_longs                        LONG    0                        ' Retained high-water across worker sessions (start() refills the sentinel, so a per-session read alone under-reports)
        stack_prepped                           LONG    0                        ' Nonzero once prepStackForCheck has ever run -- before that the stack holds zeros, not sentinel, and a scan would read full

        ' SPI PIN CONFIGURATION (set once at start)
        cs                                      LONG    0                        ' Chip select pin
        mosi                                    LONG    0                        ' Master out, slave in pin
        miso                                    LONG    0                        ' Master in, slave out pin
        sck                                     LONG    0                        ' Serial clock pin

        ' SMART PIN SPI CONFIGURATION (Phase 1 Performance Sprint)
        ' P_TRANSITION for clock, P_SYNC_TX for transmit, P_SYNC_RX for receive
        ' B-input offset links MOSI/MISO to SCK for synchronized operation
        spi_clk_mode                            LONG    0                        ' P_PULSE | P_OE for SCK
        spi_tx_mode                             LONG    0                        ' P_SYNC_TX | P_OE for MOSI
        spi_rx_mode                             LONG    0                        ' P_SYNC_RX for MISO
        spi_period                              LONG    0                        ' Current SPI half-period (for sysclk-independent timing)
        spi_freq                                LONG    0                        ' Actual achieved SPI frequency (Hz)
        spi_event                               LONG    0                        ' Event config for waitse1 (%01_000000 | sck)
        sp_debug_ctr                            LONG    0                        ' Debug counter for sp_transfer_8

        ' PHASE 2 -- Adaptive Path A sample-mode tuning (WXPIN[5] for MISO)
        ' miso_wxpin holds the current X value used at every MISO WXPIN call site.
        ' sample_mode_override: -1=auto-by-hp (default), 0=force pre-edge, 1=force on-edge.
        ' pre_edge_threshold: in auto mode, hp <= threshold uses pre-edge (%0_00111),
        ' otherwise on-edge (%1_00111). Default 5 is conservative: only hp=4 and hp=5
        ' use pre-edge, preserving on-edge behavior at hp >= 6 (sysclk >= 255 MHz at
        ' 25 MHz target). Set by applySPISpeed; consumed by every WXPIN(_miso, ...) site.
        miso_wxpin                              LONG    %1_00111                 ' X value for MISO WXPIN (default on-edge)
        sample_mode_override                    LONG    -1                       ' -1 = auto-by-hp, 0 = pre-edge, 1 = on-edge
        pre_edge_threshold                      LONG    5                        ' hp <= this -> pre-edge in auto mode

        ' S.3 -- Cached target SPI rate for debugOnClockChange() recompute path.
        ' applySPISpeed sets this on every call so debugOnClockChange() knows
        ' what target frequency to recompute against after a runtime clkset().
        ' Default 25_000_000 matches the historical post-init rate; the actual
        ' value is overwritten on the first applySPISpeed call during init.
        current_spi_target_hz                   LONG    25_000_000               ' Most recent applySPISpeed target (Hz)

        ' PHASE 3 -- Adaptive Path B alignment tuning (streamer DMA align_delay)
        ' align_delay_offset is added to spi_period (= hp) at every streamer-burst
        ' site to produce the actual WAITX value before XINIT.
        '
        ' Default 5, baked in from the 2026-08-17/18 socket-timing campaign
        ' (DOCs/Plans/SOCKET-SHMOO-RUN-NOTES.md rounds 4 + 7c): five independent
        ' passing-band sweeps -- two card families (mainstream SDHC and asdfg-class
        ' SDSC), both sockets, three frequencies -- ALL center on +5, matching the
        ' p2kbArchIoPinTiming prediction of +5..+7 (host I/O ring round trip of
        ' 5-6 sysclks). The narrowest measured band is [+1..+9] (35 MHz); the old
        ' default 0 sat ON or OUTSIDE the lower edge at elevated frequencies and
        ' one tick from it on the adapter socket at 29 MHz.
        '
        ' hp=4 floor-cell rule: positive offsets are withheld at spi_period = 4
        ' (see effectiveAlignDelay) -- the floor cell keeps historical align = hp,
        ' because the band was measured at hp = 5..7 only and +5 there exceeds the
        ' bit period, breaking the CMD6 high-speed verify read (round 8a).
        '
        ' Floor: align_delay must be >= 2 (cog needs at least 2 sysclks to execute
        ' WAITX before XINIT); the floor clamp engages in effectiveAlignDelay.
        align_delay_offset                      LONG    5                        ' Signed integer; accepted range [-8, +16]

        ' LAYOUT-INVARIANCE FIX (2026-08-12) -- TX streamer phase pad.
        ' tx_align_delay is the WAITX value between the SCK counter reset
        ' (DRVL) and XINIT at both write-path streamer sites. With RDFAST
        ' hoisted ABOVE the SCK reset, every instruction from DRVL to XINIT
        ' is a fixed-2-clock cog op, so the MOSI-bitstream-to-SCK-edge phase
        ' is a compile-time constant -- this pad is how that constant gets
        ' centered in the passing window (bench shmoo), NOT a per-build
        ' workaround. See DOCs/Analysis/LAYOUT-SENSITIVITY-ROOTCAUSE-ANALYSIS.md.
        ' Floor 2 applies at use site (WAITX minimum), same rule as align_delay.
        ' Characterized 2026-08-11 on Card 2b (SN $0000_0F14), Edge slot, 350 MHz /
        ' 25 MHz (hp=7): pad->phase is a SAWTOOTH with period hp (SCK starts on the
        ' next base-period boundary after WYPIN; streamer start moves continuously),
        ' so only hp distinct phases exist. Losing phase: pad == 1 (mod 7) -- measured
        ' fails at pads 8, 15, 22, 29; all 24 other measured points pass (three shmoo
        ' runs, SD_tx_phase_shmoo). Default 4 = maximal mod-7 distance (3) from the
        ' cliff on both sides; the old floor value 2 sat one sysclk from it.
        '
        ' 2026-08-18 five-card survey (SOCKET-SHMOO-RUN-NOTES.md round 7b): the
        ' losing phase is DRIVER-SIDE -- every affected card fails at identical
        ' pads (three of five affected; the other two tolerate the marginal
        ' phase). The losing residue MOVES with hp (pads 8,22 at hp=14; 8,15 at
        ' hp=7; 4,9 at hp=5), so distance-from-cliff computed at one frequency
        ' does not transfer to another: at hp=5 this default LANDS ON the losing
        ' phase. That configuration is unreachable in production -- the user
        ' speed path clamps at the card ceiling (see clampUserSpeed) -- and any
        ' future change that raises SPI speed must re-derive this pad for its hp.
        tx_align_delay                          LONG    4                        ' Sysclks; sweep range [2, 2+2*hp]

        ' PRODUCTION SPEED BOUND (2026-08-18, Stephen: above-ceiling SPI is
        ' "diagnostic / developer only"). Consumed by clampUserSpeed at the
        ' CMD_SET_SPI_SPEED handler; set ONLY by debugSetOverspeedAllowed
        ' [SD_INCLUDE_DEBUG]. Zero = production behavior (clamped).
        overspeed_allowed                       BYTE    0                        ' 1 = diagnostics may exceed the card ceiling

        ' FLOOR-CELL RULE ESCAPE (2026-08-18). The hp=4 rule in effectiveAlignDelay
        ' withholds positive align offsets at that cell because its passing band was
        ' never measured -- which also makes the cell unmeasurable, since a sweep
        ' there would see every positive offset collapse to the same align value.
        ' This knob lets a characterization tool lift the rule to MEASURE the band;
        ' production keeps it. Set ONLY by debugSetAlignFloorRuleEnabled.
        floor_rule_disabled                     BYTE    0                        ' 1 = apply offsets at hp=4 too (characterization)
        BYTE    0[2]                                                             ' pad to long boundary

        ' FILESYSTEM STATE (moved from VAR)
        fat_sec                                 LONG    0                        ' Starting sector of FAT
        fat2_sec                                LONG    0                        ' Starting sector of FAT2 (mirror)
        sec_per_fat                             LONG    0                        ' Sectors per FAT
        sec_per_clus                            LONG    0                        ' Sectors per cluster
        root_sec                                LONG    0                        ' Starting sector of root directory
        cluster_offset                          LONG    0                        ' Cluster offset calculation
        cog_dir_sec                             LONG    0[8]                     ' Per-cog current directory sector
        entry_address                           LONG    0                        ' Current entry byte address
        date_stamp                              LONG    0                        ' Timestamp for new files (live packed FAT32 date+time)

        ' FIELD pointers into date_stamp (initialized in worker startup)
        fld_yr                                  LONG    0                        ' ^@date_stamp.[31..25]  Year-1980 (7 bits)
        fld_mon                                 LONG    0                        ' ^@date_stamp.[24..21]  Month (4 bits)
        fld_day                                 LONG    0                        ' ^@date_stamp.[20..16]  Day (5 bits)
        fld_hr                                  LONG    0                        ' ^@date_stamp.[15..11]  Hour (5 bits)
        fld_min                                 LONG    0                        ' ^@date_stamp.[10..5]   Minute (6 bits)
        fld_sec                                 LONG    0                        ' ^@date_stamp.[4..0]    Second/2 (5 bits)
        days_table                              BYTE    31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31
        n_sec                                   LONG    0                        ' Current sector number
        flags                                   LONG    0                        ' State flags (F_MOUNTED, F_NEWDIR)
        dir_sec_in_buf                          LONG    0                        ' Directory sector currently in dir_buf
        fat_sec_in_buf                          LONG    0                        ' FAT sector currently in fat_buf
        sec_in_buf                              LONG    0                        ' Data sector currently in buf
        bit_delay                               LONG    0                        ' SPI bit delay
        hcs                                     LONG    0                        ' High capacity support flag
        fsinfo_sec                              LONG    0                        ' FSInfo sector number
        fsi_free_count                          LONG    0                        ' Cached free cluster count
        fsi_nxt_free                            LONG    0                        ' Cached next free cluster hint
        vbr_sec                                 LONG    0                        ' Volume Boot Record sector
        ocr_value                               LONG    0                        ' Cached OCR register (from CMD58)

        ' ADAPTIVE TIMING (Phase 2 - Card identification and speed adjustment)
        card_mfr_id                             LONG    0                        ' Manufacturer ID from CID (byte 0)
        card_max_speed_hz                       LONG    0                        ' Maximum speed from CSD TRAN_SPEED (Hz)
        card_read_timeout_ms                    LONG    100                      ' Read timeout in ms (from CSD or spec default)
        card_write_timeout_ms                   LONG    500                      ' Write timeout in ms (from CSD or spec default)
        card_erase_block_sectors                LONG    128                      ' Erase block size in sectors (from CSD SECTOR_SIZE+1; default 128 = SDHC)

        ' PER-COG ERROR STORAGE (for thread-safe error reporting)
        last_error                              LONG    0[8]                     ' One slot per possible cog

        ' DIAGNOSTIC: Capture data inside readSector for debugging from test cog
        diag_last_sector                        LONG    0                        ' Last sector read
        diag_last_buftype                       LONG    0                        ' Last buf_type used
        diag_last_token                         LONG    0                        ' Last start token received
        diag_buf_byte0                          LONG    0                        ' First byte of buffer after streamer
        diag_buf_byte1                          LONG    0                        ' Second byte
        diag_buf_byte2                          LONG    0                        ' Third byte
        diag_buf_byte3                          LONG    0                        ' Fourth byte
        diag_p_buf                              LONG    0                        ' Buffer pointer used
        diag_before_b0                          LONG    0                        ' Buffer byte 0 BEFORE streamer
        diag_before_b1                          LONG    0                        ' Buffer byte 1 BEFORE streamer
        diag_before_b2                          LONG    0                        ' Buffer byte 2 BEFORE streamer
        diag_before_b3                          LONG    0                        ' Buffer byte 3 BEFORE streamer
        diag_spi_period                         LONG    0                        ' SPI period at time of read
        diag_recv_crc                           WORD    0                        ' CRC-16 received from card (high byte first)
        diag_calc_crc                           WORD    0                        ' CRC-16 calculated from data
        diag_sent_crc                           WORD    0                        ' CRC-16 sent with write data
        diag_crc_matches                        LONG    0                        ' Count of CRC matches (reads)
        diag_crc_mismatches                     LONG    0                        ' Count of CRC mismatches (reads)
        diag_crc_retries                        LONG    0                        ' Count of CRC retry attempts
        diag_crc_enabled                        BYTE    1                        ' CRC validation enabled (1=on, 0=off)

        ' WRITE DIAGNOSTICS (set by writeSector, readable from any cog)
        ' Codes: 0=not called, 1=CMD24 fatal-R1, 2=data-response timeout,
        '        3=data CRC reject, 4=data write-err reject, 5=data unknown reject,
        '        6=busy timeout, 7=success, 8=CMD24 R1 never arrived (cmd() timed out)
        diag_write_result                       LONG    0                        ' Outcome code of last writeSector call
        diag_write_r1                           LONG    0                        ' CMD24 R1 response byte
        diag_write_dresp                        LONG    0                        ' Data response token from card
        diag_write_sector                       LONG    0                        ' Sector number attempted

        ' CMD R1 LATENCY DIAGNOSTICS (set by every cmd() call)
        diag_cmd_r1_ms                          LONG    0                        ' Elapsed ms in last cmd() between command-end and R1-received (-1 if timed out)
        diag_cmd_r1_polls                       LONG    0                        ' Bytes polled in last cmd() before R1 arrived (or timeout)
        diag_cmd_last_op                        LONG    0                        ' Op code of last cmd() call (for context)

#ifdef SD_INCLUDE_TEST_HOOKS
        ' TEST HOOKS: Error injection. Absent unless SD_INCLUDE_TEST_HOOKS is defined.
        ' Used by SD_RT_error_injection_tests, SD_RT_crc_validation_tests,
        ' SD_RT_recovery_tests, SD_RT_volume_tests and SD_RT_defrag_tests.
        test_force_read_crc_error               BYTE    0                        ' Counter: force N read CRC mismatches (any sector)
        test_force_write_crc_error              BYTE    0                        ' Flag: corrupt next write CRC (one-shot, any sector)
        test_error_count                        LONG    0                        ' Count of injected errors triggered
        test_max_clusters                       LONG    0                        ' Limit: max allocatable cluster number (0 = no limit)

        ' TARGETED FAULT INJECTION: name one LBA, or one write within a sequence
        test_fail_sector                        LONG    -1                       ' LBA to fail (-1 = disarmed)
        test_fail_mode                          LONG    0                        ' TF_READ / TF_WRITE / TF_BOTH, optionally | TF_STICKY
        test_fail_write_after                   LONG    0                        ' Fail the nth subsequent writeSector() (0 = disarmed)
        test_write_call_count                   LONG    0                        ' writeSector() calls counted since arming
        test_fail_read_after                    LONG    0                        ' Fail the nth subsequent card read (cache misses only; 0 = disarmed)
        test_read_call_count                    LONG    0                        ' readSector() cache-miss transfers counted since arming
#endif

        ' BUFFERS (must be in DAT for worker cog access)
        ' DIAGNOSTIC: Separate buffers for each sector type to isolate conflicts
        dir_buf                                 BYTE    0[512]                   ' Directory sector buffer
        fat_buf                                 BYTE    0[512]                   ' FAT sector buffer
        buf                                     BYTE    0[512]                   ' Data sector buffer
  entry_buffer  dir_entry_t
                                                BYTE    0[14]                    ' name[8], ext[3], attr, ntRes, crtTenth
                                                WORD    0[7]                     ' crtTime, crtDate, accDate, clusHI, wrtTime, wrtDate, clusLO
                                                LONG    0                        ' fileSize
        vol_label                               BYTE    0[12]                    ' Volume label (11 chars + null)

        ' FILE HANDLE TABLE - 32 bytes per handle
        ' Each handle tracks an independently open file with its own state
        h_flags                                 BYTE    0[MAX_OPEN_FILES]        ' Handle state: HF_FREE, HF_READ, HF_WRITE (| HF_DIRTY)
        h_attr                                  BYTE    0[MAX_OPEN_FILES]        ' FAT directory entry attributes byte
        h_dir_offset                            WORD    0[MAX_OPEN_FILES]        ' Offset of dir entry within sector (0-511)
        h_position                              LONG    0[MAX_OPEN_FILES]        ' Current byte position in file
        h_sector                                LONG    0[MAX_OPEN_FILES]        ' Current sector number being accessed
        h_start_clus                            LONG    0[MAX_OPEN_FILES]        ' First cluster of file (from dir entry)
        h_size                                  LONG    0[MAX_OPEN_FILES]        ' File size in bytes
        h_dir_sector                            LONG    0[MAX_OPEN_FILES]        ' Sector containing directory entry
        h_cluster                               LONG    0[MAX_OPEN_FILES]        ' Current cluster in FAT chain

        ' PER-HANDLE ERROR SLOT - why the last read/write on this handle came up short.
        ' readHandle()/writeHandle() return a byte COUNT, and a partial count is positive,
        ' so a card failure part-way through a transfer cannot be told from EOF by the
        ' return value alone. do_read_h/do_write_h write this slot on EVERY exit -- SUCCESS
        ' as well as failure -- so handleError() after a call describes THAT call, matching
        ' ERROR()'s write-on-exit rule. Read via the handleError() pure accessor.
        h_error                                 LONG    0[MAX_OPEN_FILES]        ' Outcome of last readHandle/writeHandle on this handle

        ' PER-HANDLE DATA BUFFERS - 512 bytes per handle
        ' Each handle has its own buffer to eliminate thrashing when switching files
        ' Cost: 512 bytes per handle, but provides significant performance benefit
        h_buf                                   BYTE    0[512 * MAX_OPEN_FILES]  ' Per-handle sector buffers
        h_buf_sector                            LONG    0[MAX_OPEN_FILES]        ' Sector currently in each buffer (-1 = invalid)
#ifdef SD_INCLUDE_DEFRAG
        h_prealloc_end                          LONG    0[MAX_OPEN_FILES]        ' Last pre-allocated cluster (0 = normal handle)
#endif

        ' ---- Consolidated debug message strings ----
        ' Used by methods that consolidate multiple compile-time debug records
        ' into one parameterised debug() call. Each branch sets a pointer to one
        ' of these strings; a single debug() at the method's exit emits the
        ' chosen string. Same runtime fidelity, fewer compiled records.
        ' See p2kbSpin2DbgDebugStrategyGuide for the 255-record limit context.

        ' CMD16 SET_BLOCKLEN outcomes (initCard step 7.5)
        msg_cmd16_skipped       BYTE "Step 7.5: CMD16 skipped (SDHC/SDXC hardwires 512)", 0
        msg_cmd16_no_resp       BYTE "CMD16 NO RESPONSE (R1 timeout) - block length NOT pinned", 0
        msg_cmd16_fatal         BYTE "CMD16 REJECTED (fatal R1 bits) - block length NOT pinned", 0
        msg_cmd16_stale         BYTE "CMD16 (stale R1 bits, no fatal error) - block length probably set", 0
        msg_cmd16_accepted      BYTE "CMD16 ACCEPTED - SDSC block length pinned to 512", 0

        ' do_erase_block CMD outcome labels (consolidated end-of-method emit)
        msg_erase_no_resp       BYTE "R1 NEVER ARRIVED (cmd() timed out)", 0
        msg_erase_fatal         BYTE "fatal R1 bits", 0
        msg_erase_busy          BYTE "busy timeout after CMD38", 0

        ' writeSectors per-block / post-loop outcome labels
        msg_ws_cmd25_no_resp    BYTE "CMD25 R1 NEVER ARRIVED (cmd() timed out)", 0
        msg_ws_cmd25_fatal      BYTE "CMD25 rejected (fatal R1 bits)", 0
        msg_ws_no_dresp         BYTE "No data response (timeout)", 0
        msg_ws_rejected         BYTE "Data rejected", 0
        msg_ws_busy_perblock    BYTE "Per-block busy timeout", 0
        msg_ws_busy_final       BYTE "Final busy timeout - card still programming", 0
        msg_ws_cmd13_failed     BYTE "CMD13 status check FAILED", 0

CON ' ---- Lifecycle ----

PUB null()
'' This is not a top-level object - placeholder to indicate driver must be instantiated as OBJ.

PUB start(_cs, _mosi, _miso, _sck) : workerCogId
'' Start worker cog (singleton) - initialize SD card driver and launch dedicated worker cog.
'' This method is idempotent - calling multiple times is safe.
''
'' @param _cs - Chip select pin number
'' @param _mosi - Master Out Slave In pin number
'' @param _miso - Master In Slave Out pin number
'' @param _sck - Serial clock pin number
'' @returns workerCogId - Cog ID (0-7) on success, -1 on failure

' Check if already started (singleton pattern)

  if cog_id <> -1
    DEBUG[CH_API]("  [start] Already started (cog ", udec_(cog_id), ")")
    workerCogId := cog_id
    set_error(SUCCESS)                                  ' write-on-exit: start() never reaches send_command()
  else
    ' Store pin configuration
    longmove(@cs, @_cs, 4)

    ' Validate pin offsets: smart pin B-input selector supports +/-3 pins max
    if ABS(_sck - _mosi) > 3 OR ABS(_sck - _miso) > 3
      DEBUG[CH_API]("  [start] FAIL: SPI pins too far apart (SCK must be within +/-3 of MOSI and MISO)")
      DEBUG[CH_API]("  [start]   SCK=P", udec_(_sck), " MOSI=P", udec_(_mosi), " (offset=", sdec_(_sck - _mosi), ") MISO=P", udec_(_miso), " (offset=", sdec_(_sck - _miso), ")")
      workerCogId := set_error(E_BAD_PIN_CONFIG)
      return

    ' Allocate hardware lock for API serialization
    api_lock := LOCKNEW()
    if api_lock == -1
      DEBUG[CH_API]("  [start] FAIL: Could not allocate lock")
      workerCogId := set_error(E_NO_LOCK)
    else
      ' Initialize parameter block
      pb_cmd := CMD_NONE
      pb_status := SUCCESS
      sec_in_buf := -1                                  ' Invalidate buffer

      ' Initialize stack guard zone before launching worker
      bytefill(@cog_stack_guard, STACK_GUARD_BYTE, STACK_GUARD_LONGS * 4)
#ifdef SD_INCLUDE_STACK_CHECK
      ' Retain the outgoing session's high-water before the sentinel refill below
      ' erases it -- reportStackDepth() reports the max across ALL sessions, so a
      ' suite that stops/restarts the worker still reports its true peak.
      if stack_prepped
        stack_peak_longs #>= stackUtils.getStackDepth(@cog_stack, STACK_SIZE)
      ' Prepare stack for depth measurement (fills with sentinel pattern)
      stackUtils.prepStackForCheck(@cog_stack, STACK_SIZE)
      stack_prepped := 1
#endif

      ' Launch worker cog
      cog_id := cogspin(NEWCOG, fs_worker(), @cog_stack)
      if cog_id == -1
        LOCKRET(api_lock)
        api_lock := -1
        DEBUG[CH_API]("  [start] FAIL: Could not start worker cog")
        workerCogId := set_error(E_NO_COG)              ' The lock was fine -- there was no cog free. Different condition, different remedy.
      else
        DEBUG[CH_API]("  [start] Worker cog ", udec_(cog_id), " started, lock ", udec_(api_lock))
        workerCogId := cog_id
        set_error(SUCCESS)                              ' write-on-exit: start() never reaches send_command()

PUB stop() : status
'' Stop worker cog - cleanly shut down the worker cog and release resources.
'' Safe to call even if not started.
''
'' THIS IS THE LAST CHANCE buffered data has to reach the card. If the driver is still
'' mounted, stop() unmounts first, and that unmount can fail -- and the very next thing
'' stop() does is halt the worker cog, after which no retry is possible and nothing can
'' report what happened. The unmount's status is therefore returned here.
''
'' The shutdown itself always completes: a failed unmount does not leave the cog running
'' or the lock held, because there would be no way to recover either. What the caller
'' gets is the truth about whether the data landed.
''
'' Safe to ignore the return value if the caller does not care -- Spin2 allows calling a
'' value-returning method as a bare statement.
''
'' @returns status - SUCCESS (0), or the negative error code from the final unmount

  status := SUCCESS
  if cog_id <> -1
    ' Send unmount command if mounted
    if flags & F_MOUNTED
      status := send_command(CMD_UNMOUNT, 0, 0, 0, 0)
      if status <> SUCCESS
        DEBUG[CH_API]("  [stop] Final unmount FAILED: ", sdec_(status))

    ' Stop the worker cog
    COGSTOP(cog_id)
    DEBUG[CH_API]("  [stop] Worker cog ", udec_(cog_id), " stopped")
    cog_id := -1

  ' Release hardware lock
  if api_lock <> -1
    LOCKRET(api_lock)
    api_lock := -1

  ' Clear state
  driver_mode := MODE_NONE                              ' Reset mode so next init/mount starts fresh
  flags := 0
  sec_in_buf := -1

  ' Write-on-exit: covers the not-mounted case too, where no command ran to record one
  set_error(status)

PUB mount(_cs, _mosi, _miso, _sck) : status
'' Mount SD card (multi-cog safe) - starts worker cog and mounts filesystem.
'' Supports MODE_RAW -> MODE_FILESYSTEM upgrade (card already initialized).
'' A structurally corrupt volume fails the mount with a specific code
'' (E_NOT_FAT32, E_BAD_SECTOR_SIZE) -- including sectors-per-cluster 0, which
'' is rejected rather than dividing by zero in the worker. A bad FSInfo
'' sector is TOLERATED at mount (free-count rebuilt lazily); it surfaces as
'' E_BAD_FSINFO only if an update to it later fails at unmount/sync time.
''
'' @param _cs - Chip select pin number
'' @param _mosi - Master Out Slave In pin number
'' @param _miso - Master In Slave Out pin number
'' @param _sck - Serial clock pin number
'' @returns status - SUCCESS (0) on success, negative error code on failure

' Check if already mounted

  if driver_mode == MODE_FILESYSTEM
    DEBUG[CH_API]("  [mount] Already mounted")
    status := SUCCESS
  else
    ' MODE_RAW -> MODE_FILESYSTEM upgrade is allowed
    ' Worker is already running, just send mount command
    if driver_mode == MODE_RAW
      DEBUG[CH_API]("  [mount] Upgrading from RAW to FILESYSTEM mode")

    ' Start worker cog if not already running (MODE_NONE case)
    if cog_id == -1
      if start(_cs, _mosi, _miso, _sck) < 0
        DEBUG[CH_API]("  [mount] Failed to start worker cog")
        status := error()

    ' Send mount command to worker (only if no error so far)
    if status == 0
      status := send_command(CMD_MOUNT, 0, 0, 0, 0)
      if status == SUCCESS
        DEBUG[CH_API]("  [mount] Mount successful, mode=FILESYSTEM")
      else
        DEBUG[CH_API]("  [mount] Mount failed with error ", sdec_(status))

PUB unmount() : status
'' Unmount SD card (multi-cog safe) - cleanly unmounts, flushing data and updating FSInfo.
''
'' @returns status - SUCCESS (0) on success, negative error code on failure

  status := send_command(CMD_UNMOUNT, 0, 0, 0, 0)
  DEBUG[CH_API]("  [unmount] Card unmounted")

CON ' ---- File I/O ----

PUB openFileRead(p_path) : handle
'' Open file for reading - opens existing file and returns handle.
'' Multiple files can be open simultaneously with independent positions.
'' Use closeFileHandle() when done.
''
'' @param p_path - Pointer to null-terminated path string
'' @returns handle - File handle (0 to MAX_OPEN_FILES-1) on success, negative error code on failure

  handle := send_command(CMD_OPEN_READ, p_path, 0, 0, 0)
  if handle == SUCCESS
    ' Same rule as readHandle: dereference pb_data0 only for a completed
    ' command -- E_ASYNC_BUSY / E_STACK_OVERFLOW return as themselves.
    handle := pb_data0
  if handle >= 0
    DEBUG[CH_API]("  [openFileRead] Opened handle ", udec_(handle))
  else
    DEBUG[CH_API]("  [openFileRead] Failed: ", sdec_(handle))

PUB openFileWrite(p_path) : handle
'' Open file for writing/append - opens for appending.
'' Position is set to end of file. Only one write handle per file allowed.
'' Use closeFileHandle() when done to flush data.
''
'' A 0-byte file whose entry carries start cluster 0 (what a PC writes for an
'' empty file) opens normally; its first cluster is allocated lazily by the
'' first writeHandle() (v1.7.0 -- previously the first append failed
'' E_BAD_CHAIN and the file was permanently unappendable).
''
'' @param p_path - Pointer to null-terminated path string
'' @returns handle - File handle (0 to MAX_OPEN_FILES-1) on success, negative error code on failure

  handle := send_command(CMD_OPEN_WRITE, p_path, 0, 0, 0)
  if handle == SUCCESS
    handle := pb_data0                                  ' Same rule as readHandle: completed commands only
  if handle >= 0
    DEBUG[CH_API]("  [openFileWrite] Opened handle ", udec_(handle))
  else
    DEBUG[CH_API]("  [openFileWrite] Failed: ", sdec_(handle))

PUB createFileNew(p_path) : handle
'' Create new file for writing - creates and opens for writing.
'' Returns error if file exists.
'' Use closeFileHandle() when done to flush data and finalize size.
''
'' @param p_path - Pointer to null-terminated path string
'' @returns handle - File handle (0 to MAX_OPEN_FILES-1) on success, negative error code on failure

  handle := send_command(CMD_CREATE, p_path, 0, 0, 0)
  if handle == SUCCESS
    handle := pb_data0                                  ' Same rule as readHandle: completed commands only
  if handle >= 0
    DEBUG[CH_API]("  [createFileNew] Created handle ", udec_(handle))
  else
    DEBUG[CH_API]("  [createFileNew] Failed: ", sdec_(handle))

PUB closeFileHandle(handle) : status
'' Close file handle - closes handle, flushing pending writes.
'' For write handles, updates directory with final file size.
'' After close, handle is invalid and slot is available for reuse.
''
'' @param handle - File handle to close
'' @returns status - SUCCESS (0) on success, negative error code on failure

  status := send_command(CMD_CLOSE_H, handle, 0, 0, 0)
  if status == SUCCESS
    DEBUG[CH_API]("  [closeFileHandle] Closed handle ", udec_(handle))
  else
    DEBUG[CH_API]("  [closeFileHandle] Failed: ", sdec_(status))

PUB readHandle(handle, p_buffer, count) : bytes_read
'' Read from file handle - reads up to count bytes into buffer.
'' Returns actual bytes read. Returns 0 ONLY at a genuine end of file.
'' Position advances by the number of bytes read.
''
'' A NEGATIVE RETURN MEANS NOTHING WAS TRANSFERRED. A read that fails before moving a
'' single byte returns its error code rather than 0, so that `repeat while n > 0` and
'' `repeat until n == 0` both stop for the right reason -- a zero here would make a dying
'' card indistinguishable from a finished file.
''
'' A POSITIVE COUNT SHORTER THAN REQUESTED MEANS EITHER END OF FILE OR A CARD FAILURE,
'' and the two look identical here. Call handleError(handle) after any short count to
'' tell them apart; it reports SUCCESS for a clean end of file.
''
'' @param handle - Valid read handle
'' @param p_buffer - Pointer to destination buffer
'' @param count - Number of bytes to read
'' @returns bytes_read - Bytes actually read; 0 ONLY at a genuine end of file; negative
''                       on error (see handleError() when a positive count is short)

  bytes_read := send_command(CMD_READ_H, handle, p_buffer, count, 0)
  if bytes_read == SUCCESS
    ' Only a completed command's mailbox is meaningful. On E_ASYNC_BUSY the
    ' mailbox still belongs to the in-flight async op, and on E_STACK_OVERFLOW
    ' nothing the worker reported can be trusted -- both must come back as the
    ' error, never as a stale/untrusted pb_data0 count.
    bytes_read := pb_data0
  if bytes_read < 0
    DEBUG[CH_API]("  [readHandle] Failed: ", sdec_(bytes_read))

PUB writeHandle(handle, p_buffer, count) : bytes_written
'' Write to file handle - writes count bytes from buffer.
'' File grows as needed with automatic cluster allocation.
'' Position advances by the number of bytes written.
''
'' The first write to a cluster-0 empty file (PC-written) allocates the
'' file's first cluster here, lazily; a disk-full during that allocation
'' returns the allocator's error with the entry left cluster-0/size-0.
''
'' A NEGATIVE RETURN MEANS NOTHING WAS ACCEPTED. Once any byte has been accepted a
'' failure returns the PARTIAL COUNT instead, so the caller still knows how much of the
'' file is valid -- call handleError(handle) after any count short of count to learn
'' whether the shortfall was a card failure, a full disk, or a bad cluster chain.
''
'' @param handle - Valid write handle
'' @param p_buffer - Pointer to source data buffer
'' @param count - Number of bytes to write
'' @returns bytes_written - Number of bytes written, negative on error
''                          (see handleError() when the count is short but not negative)

  bytes_written := send_command(CMD_WRITE_H, handle, p_buffer, count, 0)
  if bytes_written == SUCCESS
    ' Same rule as readHandle: dereference pb_data0 only for a completed
    ' command -- E_ASYNC_BUSY / E_STACK_OVERFLOW return as themselves.
    bytes_written := pb_data0
  if bytes_written < 0
    DEBUG[CH_API]("  [writeHandle] Failed: ", sdec_(bytes_written))

PUB seekHandle(handle, position) : status
'' Seek to position in file - seeks to absolute byte position.
'' Position must be <= file size (cannot seek past EOF).
''
'' @param handle - Valid file handle
'' @param position - Absolute byte position to seek to
'' @returns status - SUCCESS (0) on success, negative error code on failure

  status := send_command(CMD_SEEK_H, handle, position, 0, 0)
  if status <> SUCCESS
    DEBUG[CH_API]("  [seekHandle] Failed: ", sdec_(status))

PUB tellHandle(handle) : position
'' Get current position - returns current byte position in file.
''
'' @param handle - Valid file handle
'' @returns position - Current position (0-based), negative on error

  position := send_command(CMD_TELL_H, handle, 0, 0, 0)
  if position == SUCCESS
    position := pb_data0                                ' Same rule as readHandle: completed commands only

PUB eofHandle(handle) : is_eof
'' Check if at end of file - returns TRUE if at or past EOF.
''
'' RETURNS A BOOLEAN ONLY. It used to return TRUE, FALSE, *or* a negative error code, and
'' those cannot coexist in Spin2: TRUE is -1 and E_TIMEOUT is -1, so "at end of file" and
'' "the card timed out" were the same value. Worse, every other negative code is non-zero
'' and therefore already read as TRUE in the `if sd.eofHandle(h)` form every caller uses.
''
'' A failed query now reports TRUE, which is what the old code effectively did anyway, and
'' is the safe direction: a loop reading until EOF stops rather than spinning on a card
'' that is not answering. ERROR() says whether it was a real end of file.
''
'' @param handle - Valid file handle
'' @returns is_eof - TRUE if at EOF or the query failed (see ERROR()), FALSE if not at EOF

  if send_command(CMD_EOF_H, handle, 0, 0, 0) <> SUCCESS
    is_eof := true                                      ' Could not ask -- stop the loop, and let ERROR() say why
  else
    is_eof := pb_data0 <> 0

PUB fileSizeHandle(handle) : size
'' Get file size - returns total size in bytes.
'' For write handles, reflects current size including pending writes.
''
'' @param handle - Valid file handle
'' @returns size - File size in bytes, negative on error

  size := send_command(CMD_FILESIZE_H, handle, 0, 0, 0)
  if size == SUCCESS
    size := pb_data0                                    ' Same rule as readHandle: completed commands only

PUB syncHandle(handle) : status
'' Flush handle to disk - flushes pending writes and updates directory.
'' File remains open for further operations.
''
'' @param handle - Valid file handle
'' @returns status - SUCCESS (0) on success, negative error code on failure

  status := send_command(CMD_SYNC_H, handle, 0, 0, 0)
  if status <> SUCCESS
    DEBUG[CH_API]("  [syncHandle] Failed: ", sdec_(status))

PUB syncAllHandles() : status
'' Flush all handles to disk - flushes all open write handles.
'' Useful before risky operations or for periodic safety.
''
'' @returns status - SUCCESS (0) on success

  status := send_command(CMD_SYNC_ALL, 0, 0, 0, 0)
  if status <> SUCCESS
    DEBUG[CH_API]("  [syncAllHandles] Failed: ", sdec_(status))

PUB sync() : status
'' Flush all pending writes to the card (multi-cog safe): every open write
'' handle's buffered data and directory entry, then the FSInfo free-space
'' sector. The full unmount-grade persistence pass, without unmounting --
'' call it before power-down or card removal to make everything durable.
''
'' Use syncHandle() to checkpoint a single handle without paying for the rest.
''
'' On failure the affected handles stay dirty and this method reports the
'' first error encountered, so a later sync() retries whatever did not land.
''
'' @returns status - SUCCESS (0) on success, negative error code on failure

  status := send_command(CMD_SYNC, 0, 0, 0, 0)
  if status <> SUCCESS
    DEBUG[CH_API]("  [sync] Failed: ", sdec_(status))

CON ' ---- Directory ----

PUB openDirectory(p_path) : handle
'' Open directory for enumeration (multi-cog safe) - returns handle for iterating entries.
'' Use readDirectoryHandle() to get entries, closeDirectoryHandle() when done.
'' Pass "" or "." to enumerate calling cog's current working directory.
'' Handles share the existing file handle pool (MAX_OPEN_FILES total).
''
'' @param p_path - Pointer to null-terminated path string
'' @returns handle - Handle (0 to MAX_OPEN_FILES-1) on success, negative error code on failure

  handle := send_command(CMD_OPEN_DIR, p_path, 0, 0, 0)
  if handle == SUCCESS
    handle := pb_data0                                  ' Same rule as readHandle: completed commands only

PUB readDirectoryHandle(handle) : p_entry
'' Read next entry from directory handle (multi-cog safe) - returns pointer to entry data.
'' Skips deleted, LFN, and hidden/system entries automatically.
'' After each call, use fileName() and attributes() to inspect the returned entry.
''
'' A ZERO RETURN MEANS EITHER END OF DIRECTORY OR A FAILED READ, and the enumeration
'' loop `repeat while sd.readDirectoryHandle(h)` ends the same way for both -- so a
'' directory truncated by an unreadable sector looks like a directory that simply ended.
'' ERROR() separates them: E_FILE_NOT_FOUND is the clean end, E_IO_ERROR is not. Check it
'' after the loop, the same way a short read is checked with handleError().
''
'' @param handle - Directory handle from openDirectory()
'' @returns p_entry - Pointer to entry_buffer on success, 0 at end of directory OR on error
''                    (see ERROR() to tell those apart)

  p_entry := 0
  if send_command(CMD_READ_DIR_H, handle, 0, 0, 0) == SUCCESS
    p_entry := @entry_buffer

PUB closeDirectoryHandle(handle) : status
'' Close directory handle (multi-cog safe) - releases handle back to pool.
''
'' Safe to call as a bare statement if the caller does not care about the outcome --
'' Spin2 allows a value-returning method to be called that way.
''
'' @param handle - Directory handle from openDirectory()
'' @returns status - SUCCESS (0) on success, negative error code on failure

  status := send_command(CMD_CLOSE_DIR_H, handle, 0, 0, 0)

PUB readDirectory(entry) : pEntry
'' Read directory entry (multi-cog safe) - iterates through directory entries.
''
'' As with readDirectoryHandle(), a 0 return covers both "no such entry" and a failed
'' read; ERROR() carries which.
''
'' @param entry - Entry index to read (0-based)
'' @returns pEntry - Pointer to entry_buffer on success, 0 if entry doesn't exist or on error

  pEntry := 0
  if send_command(CMD_READDIR, entry, 0, 0, 0) == SUCCESS
    pEntry := @entry_buffer

PUB newDirectory(name_ptr) : status
'' Create a new directory (multi-cog safe) in current directory.
''
'' @param name_ptr - Pointer to null-terminated directory name string
'' @returns status - SUCCESS (0) on success, negative error code on failure

  status := send_command(CMD_NEWDIR, name_ptr, 0, 0, 0)

PUB changeDirectory(name_ptr) : status
'' Change directory (multi-cog safe) - changes current directory.
''
'' Only a real directory entry (ATTR_DIRECTORY set) is accepted. In particular
'' a 0-byte file -- whose entry a PC writes with first cluster 0, the same
'' value a root-pointing '..' carries -- returns E_NOT_A_DIR and leaves the
'' caller's working directory unchanged (v1.7.0; previously such a file
'' silently changed the CWD to root).
''
'' A name with no entry returns E_FILE_NOT_FOUND; E_NOT_A_DIR means the name
'' exists but is not a directory (v1.7.0; previously both returned
'' E_NOT_A_DIR). The volume label is invisible here as everywhere: its name
'' reports E_FILE_NOT_FOUND.
''
'' @param name_ptr - Pointer to null-terminated directory name string
'' @returns status - SUCCESS (0) on success, negative error code on failure

  status := send_command(CMD_CHDIR, name_ptr, 0, 0, 0)

CON ' ---- Metadata ----

PUB deleteFile(name_ptr) : status
'' Delete file or empty directory (multi-cog safe) - deletes from current directory.
''
'' Refuses two dangerous deletes (v1.7.0 contract):
'' - a file any handle still has open returns E_FILE_OPEN (-47); close it first
'' - a non-empty directory returns E_DIR_NOT_EMPTY (-44) and is left intact;
''   delete its contents first (there is no recursive delete)
''
'' @param name_ptr - Pointer to null-terminated filename string
'' @returns status - SUCCESS (0) on success, negative error code on failure
''                   (E_FILE_NOT_FOUND, E_FILE_OPEN, E_DIR_NOT_EMPTY, E_IO_ERROR)

  status := send_command(CMD_DELETE, name_ptr, 0, 0, 0)

PUB rename(old_name, new_name) : status
'' Rename file or directory (multi-cog safe).
''
'' @param old_name - Pointer to current filename string
'' @param new_name - Pointer to new filename string
'' @returns status - SUCCESS (0) on success, negative error code on failure

  status := send_command(CMD_RENAME, old_name, new_name, 0, 0)

PUB moveFile(name_ptr, dest_folder) : status
'' Move file to another directory (multi-cog safe).
''
'' @param name_ptr - Pointer to null-terminated filename to move
'' @param dest_folder - Pointer to null-terminated destination folder name
'' @returns status - SUCCESS (0) on success, negative error code on failure

  status := send_command(CMD_MOVEFILE, name_ptr, dest_folder, 0, 0)

PUB freeSpace() : sectorCount
'' Get free space in sectors (multi-cog safe).
'' This may take a while on large cards.
''
'' Returns 0 if the FAT scan could not be completed, with the reason in ERROR(). A count
'' is only meaningful when the whole FAT was read: a scan that stopped part-way would
'' report a number that is simply too low, and an application sizing a write against it
'' would be told there is no room -- or, reasoning the other way, would trust space that
'' was never verified. Zero-with-an-error cannot be mistaken for either.
''
'' @returns sectorCount - Number of free sectors on the card, or 0 if the scan failed

  if send_command(CMD_FREESPACE, 0, 0, 0, 0) == SUCCESS
    sectorCount := pb_data0

PUB sectorsPerCluster() : count
'' Get the number of sectors per cluster for the mounted filesystem.
'' Returns 0 if no card is mounted.
''
'' @returns count - Sectors per cluster (power of 2: 1, 2, 4, 8, 16, 32, 64, or 128)

  count := sec_per_clus

PUB clusterBytes() : bytesPerCluster
'' Get the number of bytes per cluster of the mounted volume.
'' Returns 0 if no card is mounted. Direct DAT read (not worker-routed).
'' Test helper: lets a suite place a write exactly on a cluster boundary
'' and size fixtures to cluster geometry at run time.
''
'' @returns bytesPerCluster - Bytes per cluster (sec_per_clus * 512), or 0 when unmounted

  bytesPerCluster := sec_per_clus << SECTOR_SHIFT

PUB setDate(year, month, day, hour, minute, second) : status
'' Set the current date and time for file timestamps.
'' Starts the auto-incrementing clock (CT1-based, 2-second tick).
''
'' @param year - Year (1980-2107)
'' @param month - Month (1-12)
'' @param day - Day (1-31)
'' @param hour - Hour (0-23)
'' @param minute - Minute (0-59)
'' @param second - Second (0-59)
'' @returns status - SUCCESS (0) or E_INVALID_PARAM

  if year < 1980 OR year > 2107 OR month < 1 OR month > 12 OR day < 1 OR day > daysInMonth(year, month) OR hour < 0 OR hour > 23 OR minute < 0 OR minute > 59 OR second < 0 OR second > 59
    status := set_error(E_INVALID_PARAM)
  else
    FIELD[fld_yr][0]  := year - FAT_EPOCH_YEAR
    FIELD[fld_mon][0] := month
    FIELD[fld_day][0] := day
    FIELD[fld_hr][0]  := hour
    FIELD[fld_min][0] := minute
    FIELD[fld_sec][0] := second >> 1
    ct_active := true
    ct_last_tick := GETCT()
    status := set_error(SUCCESS)                        ' write-on-exit: never reaches send_command()

PUB getDate() : year, month, day, hour, minute, second
'' Get the current date and time as the driver knows it.
'' Returns the live clock value maintained by the worker cog CT1 tick.
'' If setDate() was never called, returns the default timestamp.
''
'' @returns year - Year (e.g., 2026)
'' @returns month - Month (1-12)
'' @returns day - Day (1-31)
'' @returns hour - Hour (0-23)
'' @returns minute - Minute (0-59)
'' @returns second - Second (0-58, even values only)

  year   := FIELD[fld_yr][0] + FAT_EPOCH_YEAR
  month  := FIELD[fld_mon][0]
  day    := FIELD[fld_day][0]
  hour   := FIELD[fld_hr][0]
  minute := FIELD[fld_min][0]
  second := FIELD[fld_sec][0] << 1

#ifdef SD_INCLUDE_DEFRAG

CON ' ---- Defragmentation API ----

PUB fileFragments(p_path) : fragment_count
'' Count the number of non-contiguous fragments in a file's cluster chain.
'' A contiguous file returns 1. An empty file returns 0.
''
'' @param p_path - Pointer to null-terminated filename string
'' @returns fragment_count - Fragment count (1 = contiguous), 0 if empty, or negative error code

  fragment_count := send_command(CMD_FILE_FRAGMENTS, p_path, 0, 0, 0)
  if fragment_count == SUCCESS
    fragment_count := pb_data0                          ' Same rule as readHandle: completed commands only

PUB isFileContiguous(p_path) : bContiguous
'' Check if a file's clusters are stored contiguously on disk.
'' Convenience wrapper around fileFragments() (Decision #6).
''
'' RETURNS A BOOLEAN ONLY -- see eofHandle() for why a method cannot return both. Here the
'' old mixed return was actively misleading: every negative error code is non-zero, so a
'' failed fragment count read as "yes, contiguous" and a caller could skip the compaction
'' the file actually needed. A failed query now reports FALSE, and ERROR() says why. FALSE
'' therefore means "not contiguous, or not known to be" -- the safe reading.
''
'' @param p_path - Pointer to null-terminated filename string
'' @returns bContiguous - TRUE only if the count was obtained AND equals 1; FALSE otherwise
''                        (see ERROR() to tell a fragmented file from a failed query)

  bContiguous := (fileFragments(p_path) == 1)

PUB createFileContiguous(p_path, file_size) : handle
'' Create a new file with a pre-allocated contiguous cluster chain.
'' The file's clusters are allocated upfront so writeHandle() never fragments.
'' If insufficient contiguous space exists, returns E_NO_CONTIGUOUS_SPACE.
'' Check-then-allocate: the name is checked first, so a rejected create
'' (E_FILE_EXISTS, invalid path) allocates nothing -- free space is unchanged.
''
'' @param p_path - Pointer to null-terminated filename string
'' @param file_size - Expected file size in bytes (determines cluster count)
'' @returns handle - Handle (0 to MAX_OPEN_FILES-1) on success, or negative error code

  handle := send_command(CMD_CREATE_CONTIGUOUS, p_path, file_size, 0, 0)
  if handle == SUCCESS
    handle := pb_data0                                  ' Same rule as readHandle: completed commands only

PUB compactFile(p_path) : status
'' Relocate a file's clusters into a contiguous chain on disk.
'' The file must not be open (no active handles). If already contiguous, returns SUCCESS (no-op).
'' Uses copy-then-free strategy: file is always readable during compaction.
'' Read-back verification is performed after every copy (Decision #5).
''
'' @param p_path - Pointer to null-terminated filename string
'' @returns status - SUCCESS, E_FILE_NOT_FOUND, E_FILE_OPEN_FOR_COMPACT, E_NO_CONTIGUOUS_SPACE, E_VERIFY_FAILED, E_IO_ERROR

  status := send_command(CMD_COMPACT_FILE, p_path, 0, 0, 0)

#endif                                                  ' SD_INCLUDE_DEFRAG

#ifdef SD_INCLUDE_ASYNC

CON ' ---- Non-Blocking File I/O ----
  {Spin2_Doc_CON}
  PENDING        = 1                                                          ' Returned by start*() to indicate operation launched
  E_ASYNC_BUSY   = -95                                                        ' An async operation is already in flight
  E_NO_ASYNC_OP  = -96                                                        ' No async operation to get result from

PUB startReadHandle(handle, p_buffer, count) : status
'' Begin an asynchronous read. Returns immediately with PENDING.
'' Caller must call isComplete()/getResult() to get the data.
'' The api_lock is held until getResult() or cancelAsync() is called.
''
'' ONE ASYNC OPERATION AT A TIME, ACROSS THE WHOLE DRIVER. There is a single in-flight
'' slot, not one per cog, so a second cog starting one while another is pending gets
'' E_ASYNC_BUSY -- promptly, even when the two starts race: a losing start never
'' blocks for the winner's operation. The operation belongs to the cog that started
'' it: only that cog may collect it with getResult() or drop it with cancelAsync().
''
'' WHILE THE OPERATION IS IN FLIGHT, the owning cog's api_lock is held, so every
'' blocking API call from that cog (readHandle, closeFileHandle, unmount, ...)
'' returns E_ASYNC_BUSY until the op is collected or cancelled. Other cogs' blocking
'' calls serialize behind the lock as usual.
''
'' @param handle - Valid read handle
'' @param p_buffer - Pointer to destination buffer
'' @param count - Number of bytes to read
'' @returns status - PENDING (1) on success, negative error on failure

  if async_active
    status := set_error(E_ASYNC_BUSY)
  elseif cog_id == -1
    status := set_error(E_NOT_MOUNTED)
  else
    ' ATOMIC BUSY ANSWER: async_active is set only while api_lock is held (and
    ' cleared before release), so a failed LOCKTRY with async_active TRUE means
    ' another cog's async op owns the lock for its whole duration -- answer
    ' E_ASYNC_BUSY promptly instead of blocking until it is collected. Holding
    ' the lock below therefore PROVES no async op is in flight, which is what
    ' makes the async_active := true assignment race-free.
    repeat
      if LOCKTRY(api_lock)
        quit
      if async_active
        status := set_error(E_ASYNC_BUSY)
        return

    pb_caller := COGID()
    pb_param0 := handle
    pb_param1 := p_buffer
    pb_param2 := count
    pb_cmd := CMD_READ_H

    ' Publish order matters for the lock-free readers (send_command's same-cog
    ' guard, getResult's ownership check): async_caller must be current BEFORE
    ' async_active announces the op, mirroring the clear side where
    ' async_active := false is written first.
    async_caller := COGID()
    async_active := true
    status := PENDING
    set_error(SUCCESS)                                  ' the START succeeded; the read's own
                                                        ' outcome is recorded by getResult()

PUB startWriteHandle(handle, p_buffer, count) : status
'' Begin an asynchronous write. Returns immediately with PENDING.
'' Caller must call isComplete()/getResult() to get the result.
'' The api_lock is held until getResult() or cancelAsync() is called.
''
'' ONE ASYNC OPERATION AT A TIME, ACROSS THE WHOLE DRIVER -- see startReadHandle(),
'' including the prompt-busy and in-flight blocking-API rules. The operation belongs
'' to the cog that started it; only that cog may collect or cancel it.
''
'' @param handle - Valid write handle
'' @param p_buffer - Pointer to source data
'' @param count - Number of bytes to write
'' @returns status - PENDING (1) on success, negative error on failure

  if async_active
    status := set_error(E_ASYNC_BUSY)
  elseif cog_id == -1
    status := set_error(E_NOT_MOUNTED)
  else
    ' ATOMIC BUSY ANSWER -- see startReadHandle(): a failed LOCKTRY with
    ' async_active TRUE is a lost start race; answer promptly, never block
    ' for the winner's whole operation.
    repeat
      if LOCKTRY(api_lock)
        quit
      if async_active
        status := set_error(E_ASYNC_BUSY)
        return

    pb_caller := COGID()
    pb_param0 := handle
    pb_param1 := p_buffer
    pb_param2 := count
    pb_cmd := CMD_WRITE_H

    ' Publish order -- see startReadHandle(): caller before active flag
    async_caller := COGID()
    async_active := true
    status := PENDING
    set_error(SUCCESS)                                  ' the START succeeded; the write's own
                                                        ' outcome is recorded by getResult()

PUB isComplete() : done
'' Check if THIS COG's async operation has completed.
'' Does NOT release the lock or consume the result.
''
'' Returns FALSE in a cog that does not own the in-flight operation -- that cog has no
'' async operation, so it has none that is complete. This is a pure accessor and does
'' not touch the error slot.
''
'' @returns done - TRUE if complete, FALSE if still in progress or not this cog's

  done := async_active AND (COGID() == async_caller) AND (pb_cmd == CMD_NONE)

PUB getResult() : byteCount
'' Get the result of THIS COG's completed async operation and release the lock.
'' After this call, new commands can be issued.
''
'' ONLY THE COG THAT STARTED THE OPERATION MAY COLLECT IT. Another cog calling this gets
'' E_NO_ASYNC_OP and changes nothing. Without that check it would take the owner's result
'' as its own, record that result in ITS error slot, and -- worst of the three -- call
'' LOCKREL() on a lock it does not hold, releasing the API lock out from under the cog
'' that does. Note this rejects only a call that is already incorrect today, so no correct
'' consumer is affected.
''
'' Runs the same worker stack-guard check as every blocking command: on a violation the
'' result is overridden with E_STACK_OVERFLOW, because nothing a corrupted worker
'' reported can be trusted.
''
'' @returns byteCount - Bytes read/written, negative error code, or E_NO_ASYNC_OP if this
''                      cog has no async operation in flight

  if NOT async_active OR COGID() <> async_caller
    byteCount := set_error(E_NO_ASYNC_OP)
  else
    ' Wait for completion if not already done
    repeat until pb_cmd == CMD_NONE

    ' Collect-time is async's only pass through the stack-guard escalation --
    ' async ops never reach send_command()'s check.
    if NOT checkStackGuard()
      DEBUG[CH_API]("  [getResult] STACK OVERFLOW after async op")
      byteCount := E_STACK_OVERFLOW
      set_error(E_STACK_OVERFLOW)
    elseif pb_status < 0
      byteCount := pb_status
      set_error(pb_status)
    else
      byteCount := pb_data0
      set_error(SUCCESS)                                ' write-on-exit: async never reaches send_command()

    async_active := false
    if POLLATN()                                        ' Drain stale COGATN from worker completion
    LOCKREL(api_lock)

PUB cancelAsync() : status
'' Cancel THIS COG's pending async operation and release the lock.
'' Waits for the worker to finish (cannot interrupt SPI mid-transfer),
'' then discards the result.
''
'' CANCEL DISCARDS THE RESULT, NOT THE OPERATION. The worker runs the op to
'' completion, so its side effects stand: the handle's position has MOVED by the
'' bytes transferred (and a write's data landed). A caller that wants the old
'' position back must seekHandle() there itself.
''
'' Same ownership rule as getResult(): only the cog that started the operation may cancel
'' it, for the same reason -- the LOCKREL() at the end would otherwise release a lock this
'' cog never held.
''
'' Runs the same worker stack-guard check as getResult() -- a violation reports
'' E_STACK_OVERFLOW even though the result is being discarded.
''
'' @returns status - SUCCESS, E_STACK_OVERFLOW on a worker stack-guard violation, or
''                   E_NO_ASYNC_OP if this cog has no async operation in flight

  if NOT async_active OR COGID() <> async_caller
    status := set_error(E_NO_ASYNC_OP)
  else
    repeat until pb_cmd == CMD_NONE

    async_active := false
    if POLLATN()                                        ' Drain stale COGATN from worker completion
    LOCKREL(api_lock)
    ' Stack corruption outlives the discarded result -- run the same escalation
    ' as getResult().
    if NOT checkStackGuard()
      DEBUG[CH_API]("  [cancelAsync] STACK OVERFLOW after async op")
      status := set_error(E_STACK_OVERFLOW)
    else
      status := set_error(SUCCESS)                      ' write-on-exit: async never reaches send_command()

#endif                                                  ' SD_INCLUDE_ASYNC

CON ' ---- Legacy ----

PUB fileName() : pName | p_temp, idx
'' Return the 8.3 filename of the currently opened file.
''
'' @returns pName - Pointer to filename string
' @local p_temp - Pointer to temporary filename buffer
' @local idx - Loop counter for parsing

  p_temp := @"filename.txt"
  bytemove(p_temp, @entry_buffer, SFN_TOTAL_LEN)
  idx := 0
  repeat until BYTE[p_temp + idx++] == " " OR idx == SFN_NAME_LEN + 1
  bytemove(p_temp + idx, p_temp + SFN_NAME_LEN, SFN_EXT_LEN)
  if attributes() & ATTR_DIRECTORY
    BYTE[p_temp + idx-1] := $00
  else
    BYTE[p_temp + idx-1] := "."
    BYTE[p_temp + idx + SFN_EXT_LEN] := $00
  pName := p_temp

PUB fileSize() : size
'' Return the size of the currently opened file in bytes.
''
'' @returns size - File size from directory entry

  size := dirEntFileSize(@entry_buffer)

PUB attributes() : attrByte
'' Return the attribute byte of the currently opened file.
''
'' @returns attrByte - FAT attribute byte

  attrByte := dirEntAttr(@entry_buffer)

PUB volumeLabel() : pLabel
'' Return pointer to volume label string.
''
'' @returns pLabel - Pointer to volume label (11 chars + null)

  pLabel := @vol_label

PUB setVolumeLabel(p_label) : status
'' Set the volume label on the mounted SD card.
'' Updates both the BPB and root directory volume label entry.
''
'' @param p_label - Pointer to new volume label string (max 11 chars)
'' @returns status - SUCCESS (0) on success, negative error code on failure

  status := send_command(CMD_SET_VOL_LABEL, p_label, 0, 0, 0)

PUB syncDirCache()
'' Force directory cache invalidation - invalidates the directory sector cache.
'' The next read will re-fetch from card.
'' Use after file operations to ensure consistency when multiple files are accessed.
'' This is safe to call from any cog (just sets a DAT variable to -1).

  dir_sec_in_buf := -1

CON ' ---- Error / Diagnostic ----

PUB ERROR() : status
'' Get the outcome of the most recent operation issued by this cog.
'' Returns SUCCESS (0) if that operation succeeded, or its negative error code.
'' Thread-safe: each cog has its own error slot.
''
'' Every method that ISSUES A COMMAND stores its result here on every exit path --
'' success as well as failure -- and the value stays put until this cog completes
'' another command. So checking ERROR() after a call describes THAT call, and a
'' previous error stays readable for as long as possible.
''
'' Pure accessors deliberately do NOT touch the slot: fileName(), fileSize(),
'' attributes(), volumeLabel(), sectorsPerCluster(), clusterBytes(), getDate(),
'' isComplete(), handleError(), lastFlushError() and ERROR() itself. Without that carve-out
'' a diagnostic call would erase the error being diagnosed -- debug(sd.fileName()) between
'' a failed openFileRead() and the ERROR() check would store SUCCESS over it.
''
'' Reading does not clear the slot -- only the next operation on this cog overwrites
'' it. That is the rule across this driver's error accessors: reading never changes
'' state, operations do.
''
'' @returns status - SUCCESS (0), or the negative error code from this cog's most
''                   recent operation

  status := LONG[@last_error][COGID()]

PUB handleError(handle) : status
'' Get why the last read or write on this handle came up short.
'' Returns SUCCESS (0) if that operation transferred everything it was asked for --
'' or stopped at a genuine end of file -- and the negative error code if it did not.
''
'' readHandle() and writeHandle() return a byte COUNT. A partial count is POSITIVE, so
'' the return value alone cannot tell a card failure part-way through a transfer from a
'' clean end of file: the documented read loop
''
''   repeat while (n := sd.readHandle(h, @buf, 512)) > 0
''
'' ends the same way in both cases, and a file truncated part-way through would otherwise
'' be processed as a complete one. Call this after any short count to find out which
'' happened. A negative return from readHandle()/writeHandle() already carries its own
'' reason and needs no second call.
''
'' The slot follows the same rule as ERROR(): every readHandle()/writeHandle() on this
'' handle writes it on EVERY exit -- success as well as failure -- so it always describes
'' the MOST RECENT one, and reading does not clear it. Reading never changes state in this
'' driver; operations do.
''
'' Attributed to the handle, so it is unambiguous when several files are open at once, and
'' unlike ERROR() it is not disturbed by another cog's work. A CLOSED handle reports
'' E_INVALID_HANDLE rather than SUCCESS -- its slot is back in the pool and has no outcome
'' to report -- so read this BEFORE closeFileHandle().
''
'' This is a pure accessor -- it reads a DAT variable directly and issues no command, so it
'' does not disturb ERROR().
''
'' @param handle - Handle previously read from or written to
'' @returns status - SUCCESS (0), or the negative error code from the last read/write on
''                   this handle; E_INVALID_HANDLE if the handle is out of range or closed

  if NOT validateHandle(handle)
    status := E_INVALID_HANDLE                          ' Better than the SUCCESS a freed slot holds -- a closed handle has no outcome to report
  else
    status := h_error[handle]

PUB lastFlushError() : status
'' Get the first failure seen by an AUTOMATIC background flush since the last clear.
'' Returns SUCCESS (0) if every automatic flush has landed cleanly.
''
'' Buffered writes reach the card either when you sync or close, or -- if you do neither --
'' when the driver notices the card has been idle and flushes on its own. That automatic
'' flush is started by the worker cog itself. There is no call to return a status to, so a
'' failure there reaches nobody: the data does not land, and every API call you make
'' afterward still reports success. POLLING THIS IS THE ONLY WAY TO LEARN IT HAPPENED, and
'' a program that writes for a long time between syncs should do so periodically.
''
'' The value is sticky and keeps the FIRST failure. Automatic flushes run on a timer, so a
'' later clean one could otherwise erase the report before you ever looked. Reading does
'' not clear it -- call clearFlushError() when you have handled it.
''
'' A failed flush leaves the handle DIRTY, so the data is still in the driver's buffer: a
'' later syncHandle() or closeFileHandle() can still get it to the card once whatever
'' caused the failure is resolved.
''
'' A flush cut short because a command arrived is NOT a failure and is not reported here --
'' the handles stay dirty and the next idle window retries.
''
'' This is a pure accessor -- it reads a DAT variable directly and issues no command, so it
'' does not disturb ERROR().
''
'' @returns status - SUCCESS (0), or the negative error code of the first automatic flush
''                   failure since the last clearFlushError()

  status := flush_error

PUB clearFlushError()
'' Clear the automatic-flush error reported by lastFlushError().
'' Call this once you have handled the failure; nothing else clears it, so a report left
'' unhandled stays readable for as long as it takes you to poll for it.
''
'' Clearing does not retry anything. The affected handle is still dirty -- use
'' syncHandle() or closeFileHandle() to get its data to the card.

  flush_error := SUCCESS

PUB cardWarnings() : warning_flags
'' Get card capability and advisory flags discovered during mount.
'' Returns bitmask of conditions probed at init time.
'' Check after mount() to learn what the card actually supports in SPI mode.
''
''   CW_CMD13_UNRELIABLE ($01) - CMD13 status checks disabled (broken SPI implementation)
''   CW_CMD23_SUPPORTED  ($02) - CMD23 SET_BLOCK_COUNT confirmed working in SPI mode
''
'' @returns warning_flags - Bitmask of CW_* constants (CW_NONE if no flags set)

  warning_flags := card_warning_flags

PUB checkStackGuard() : bIntact | idx
'' Verify worker cog stack guard is intact.
'' Returns TRUE if all guard bytes are $CC (no overflow detected).
'' Returns FALSE and reports via debug if any guard byte is corrupted.
''
'' @returns bIntact - TRUE if stack guard is intact, FALSE if overflow detected

  bIntact := true
  repeat idx from 0 TO (STACK_GUARD_LONGS * 4) - 1
    if BYTE[@cog_stack_guard][idx] <> STACK_GUARD_BYTE
      bIntact := false
      DEBUG[CH_API]("  STACK GUARD VIOLATION at offset ", udec_(idx), ": $", uhex_byte_(BYTE[@cog_stack_guard][idx]), " (expected $CC)")
      quit

#ifdef SD_INCLUDE_STACK_CHECK

PUB reportStackDepth() : depth
'' DIAG: Report worker stack high-water mark (longs used), retained across worker
'' sessions -- start() refills the measurement sentinel, so without retention a
'' suite that stops/restarts the worker would report only its last session.
'' Works even after stop(): the stack lives in hub DAT, so the last session is
'' still readable from the calling cog. Compare against STACK_SIZE.
''
'' @returns depth - Number of longs used (max across all sessions), or -1 if the
''                  worker has never run

  if send_command(CMD_STACK_DEPTH, 0, 0, 0, 0) == SUCCESS
    depth := pb_data0
  elseif stack_prepped
    stack_peak_longs #>= stackUtils.getStackDepth(@cog_stack, STACK_SIZE)
    depth := stack_peak_longs
  else
    depth := -1

#endif

CON ' ---- Raw Sector Access [SD_INCLUDE_RAW] ----

#ifdef SD_INCLUDE_RAW

PUB initCardOnly(_cs, _mosi, _miso, _sck) : status
'' Initialize SD card without mounting filesystem - for raw sector access.
'' Use this for low-level operations like formatting. Does NOT read filesystem.
'' Starts worker cog and initializes card for raw sector access (MODE_RAW).
'' Refused with E_NOT_MOUNTED while a filesystem is mounted -- unmount first.
''
'' @param _cs - Chip select pin number
'' @param _mosi - Master Out Slave In pin number
'' @param _miso - Master In Slave Out pin number
'' @param _sck - Serial clock pin number
'' @returns status - SUCCESS (0) on success, negative error code on failure

  DEBUG[CH_INIT]("  [initCardOnly] Pins: CS=P", udec_(_cs), " MOSI=P", udec_(_mosi), " MISO=P", udec_(_miso), " SCK=P", udec_(_sck))

  ' Check if already in filesystem mode - reject (must unmount first)
  if driver_mode == MODE_FILESYSTEM
    DEBUG[CH_INIT]("  [initCardOnly] REJECTED: Already mounted as filesystem, unmount first")
    status := E_NOT_MOUNTED
  elseif driver_mode == MODE_RAW
    ' Already in raw mode - already initialized
    DEBUG[CH_INIT]("  [initCardOnly] Already initialized in raw mode")
    status := SUCCESS
  else
    ' Start worker cog if not already running
    if cog_id == -1
      if start(_cs, _mosi, _miso, _sck) < 0
        DEBUG[CH_INIT]("  [initCardOnly] FAIL: Could not start worker cog")
        status := error()
    ' Send init command to worker (only if cog started OK)
    if status == 0
      status := send_command(CMD_INIT_CARD_ONLY, 0, 0, 0, 0)
      if status == SUCCESS
        DEBUG[CH_INIT]("  [initCardOnly] Card initialized successfully via worker")
      else
        DEBUG[CH_INIT]("  [initCardOnly] Card initialization failed, error=", sdec_(status))

PUB cardSizeSectors() : sectorCount
'' Get total sectors on card via worker cog.
'' Must call initCardOnly() or mount() first.
''
'' @returns sectorCount - Total number of 512-byte sectors on the card, or 0 if the
''                        query failed (see ERROR())

  if cog_id == -1
    DEBUG[CH_API]("  [cardSizeSectors] ERROR: Worker not running")
  else
    if send_command(CMD_GET_CARD_SIZE, 0, 0, 0, 0) == SUCCESS
      sectorCount := pb_data0                           ' Same rule as readHandle: completed commands only
    DEBUG[CH_API]("  [cardSizeSectors] ", udec(sectorCount), " sectors")

PUB testCMD13() : r2_response | r1, status
'' TEST ONLY: Send CMD13 and return raw R2 response.
'' Routes through worker cog which owns the SPI pins.
'' NOTE: This is a diagnostic method - not for normal operation.
''
'' @returns r2_response - R2 response word ($0000=OK, $FFFF=timeout, other=error)
' @local r1 - R1 response byte (decoded from R2 for debug output)
' @local status - Status byte (decoded from R2 for debug output)

  if cog_id == -1
    r2_response := $FFFF
  elseif send_command(CMD_TEST_CMD13, 0, 0, 0, 0) <> SUCCESS
    r2_response := $FFFF                                ' Could not ask (see ERROR()) -- same shape as timeout
  else
    r2_response := pb_data0                             ' Same rule as readHandle: completed commands only

    ' Decode R1 and status bytes for debug output
    r1 := r2_response >> 8
    status := r2_response & $FF

    ' Log detailed results
    DEBUG[CH_STATUS]("  [testCMD13] R1=$", uhex_byte_(r1), " STATUS=$", uhex_byte_(status), " -> R2=$", uhex_word_(r2_response))
    if r1 <> 0
      DEBUG[CH_STATUS]("    R1 errors:")
      if r1 & $40
        DEBUG[CH_STATUS]("      -> PARAMETER_ERROR")
      if r1 & $20
        DEBUG[CH_STATUS]("      -> ADDRESS_ERROR")
      if r1 & $10
        DEBUG[CH_STATUS]("      -> ERASE_SEQ_ERROR")
      if r1 & $08
        DEBUG[CH_STATUS]("      -> COM_CRC_ERROR")
      if r1 & $04
        DEBUG[CH_STATUS]("      -> ILLEGAL_COMMAND")
      if r1 & $02
        DEBUG[CH_STATUS]("      -> ERASE_RESET")
      if r1 & $01
        DEBUG[CH_STATUS]("      -> IN_IDLE_STATE")
    if status <> 0
      DEBUG[CH_STATUS]("    STATUS errors:")
      if status & CSR_OUT_OF_RANGE
        DEBUG[CH_STATUS]("      -> OUT_OF_RANGE")
      if status & CSR_ERASE_PARAM
        DEBUG[CH_STATUS]("      -> ERASE_PARAM")
      if status & CSR_WP_VIOLATION
        DEBUG[CH_STATUS]("      -> WP_VIOLATION")
      if status & CSR_CARD_ECC_FAILED
        DEBUG[CH_STATUS]("      -> CARD_ECC_FAILED")
      if status & CSR_CC_ERROR
        DEBUG[CH_STATUS]("      -> CC_ERROR")
      if status & CSR_ERROR
        DEBUG[CH_STATUS]("      -> ERROR")
      if status & CSR_WP_ERASE_SKIP
        DEBUG[CH_STATUS]("      -> WP_ERASE_SKIP")
      if status & CSR_CARD_IS_LOCKED
        DEBUG[CH_STATUS]("      -> CARD_IS_LOCKED")

PUB readSectorRaw(sector, p_buffer) : status
'' Read a sector at absolute LBA address - low-level for verification.
'' Bypasses filesystem. Requires initCardOnly() or mount() first.
''
'' @param sector - Absolute LBA sector number
'' @param p_buffer - Pointer to 512-byte buffer to receive data
'' @returns status - SUCCESS (0) on success, negative error code on failure

' Require worker cog to be running (no direct access allowed)

  if cog_id == -1
    DEBUG[CH_SECTOR]("  [readSectorRaw] ERROR: Worker not running - call initCardOnly() or mount() first")
    status := E_NOT_MOUNTED
  else
    status := send_command(CMD_READ_SECTOR_RAW, sector, p_buffer, 0, 0)
    DEBUG[CH_SECTOR]("  [readSectorRaw] Read sector ", udec(sector))

PUB writeSectorRaw(sector, p_buffer) : status
'' Write a sector at absolute LBA address - low-level for formatting/partitioning.
'' Bypasses filesystem. Requires initCardOnly() or mount() first.
''
'' @param sector - Absolute LBA sector number
'' @param p_buffer - Pointer to 512 bytes of data to write
'' @returns status - SUCCESS (0) on success, negative error code on failure

' Require worker cog to be running (no direct access allowed)

  if cog_id == -1
    DEBUG[CH_SECTOR]("  [writeSectorRaw] ERROR: Worker not running - call initCardOnly() or mount() first")
    status := E_NOT_MOUNTED
  else
    status := send_command(CMD_WRITE_SECTOR_RAW, sector, p_buffer, 0, 0)
    if status == SUCCESS
      DEBUG[CH_SECTOR]("  [writeSectorRaw] Wrote sector ", udec(sector))
    else
      DEBUG[CH_SECTOR]("  [writeSectorRaw] FAILED to write sector ", udec(sector))

PUB readSectorsRaw(start_sector, count, p_buffer) : sectorCount
'' Read multiple consecutive sectors - multi-block read using CMD18.
'' More efficient than calling readSectorRaw() in a loop.
''
'' @param start_sector - First sector to read (absolute LBA)
'' @param count - Number of sectors to read
'' A count short of what was asked for -- including 0 -- means the transfer failed;
'' ERROR() carries the reason. Compare the return against count rather than testing it
'' for zero, or a partial multi-block read reads as a complete one.
''
'' @param p_buffer - Pointer to buffer (must be count * 512 bytes)
'' @returns sectorCount - Number of sectors successfully read (0 on failure, see ERROR())

  if send_command(CMD_READ_SECTORS, start_sector, count, p_buffer, 0) == SUCCESS
    sectorCount := pb_data0
  else
    sectorCount := 0

PUB writeSectorsRaw(start_sector, count, p_buffer) : sectorCount
'' Write multiple consecutive sectors - multi-block write using CMD25.
'' More efficient than calling writeSectorRaw() in a loop.
''
'' @param start_sector - First sector to write (absolute LBA)
'' @param count - Number of sectors to write
'' A count short of what was asked for -- including 0 -- means the transfer failed;
'' ERROR() carries the reason. Compare the return against count rather than testing it
'' for zero, or a partial multi-block write reads as a complete one.
''
'' @param p_buffer - Pointer to buffer with data (must be count * 512 bytes)
'' @returns sectorCount - Number of sectors successfully written (0 on failure, see ERROR())

  if send_command(CMD_WRITE_SECTORS, start_sector, count, p_buffer, 0) == SUCCESS
    sectorCount := pb_data0
  else
    sectorCount := 0

PUB readVBRRaw(p_buf) : status
'' Read Volume Boot Record (512 bytes) into buffer.
'' Routes through worker cog which owns the SPI pins.
'' Card must be mounted for this method to work (VBR location determined at mount).
''
'' @param p_buf - Pointer to 512-byte buffer to receive VBR data
'' @returns status - SUCCESS (0) on success, negative error code on failure

  if NOT (flags & F_MOUNTED)
    DEBUG[CH_SECTOR]("  [readVBRRaw] FAILED: Card not mounted")
    status := E_NOT_MOUNTED
  else
    status := send_command(CMD_READ_SECTOR_RAW, vbr_sec, p_buf, 0, 0)

#endif

CON ' ---- Card Registers [SD_INCLUDE_REGISTERS] ----

#ifdef SD_INCLUDE_REGISTERS

PUB readCIDRaw(p_buf) : status
'' Read CID register (16 bytes) into buffer.
'' Contains manufacturer ID, product name, serial number, and manufacturing date.
'' Routes through worker cog which owns the SPI pins.
''
'' @param p_buf - Pointer to 16-byte buffer to receive CID data
'' @returns status - SUCCESS (0) on success, negative error code on failure

  status := send_command(CMD_READ_CID, p_buf, 0, 0, 0)
  if status == SUCCESS
    DEBUG[CH_IDENT]("  [readCIDRaw] CID read successfully")
  else
    DEBUG[CH_IDENT]("  [readCIDRaw] CID read FAILED")

PUB readCSDRaw(p_buf) : status
'' Read CSD register (16 bytes) into buffer.
'' Contains card capacity, speed, and features.
'' Routes through worker cog which owns the SPI pins.
''
'' @param p_buf - Pointer to 16-byte buffer to receive CSD data
'' @returns status - SUCCESS (0) on success, negative error code on failure

  status := send_command(CMD_READ_CSD, p_buf, 0, 0, 0)
  if status == SUCCESS
    DEBUG[CH_IDENT]("  [readCSDRaw] CSD read successfully")
  else
    DEBUG[CH_IDENT]("  [readCSDRaw] CSD read FAILED")

PUB readSCRRaw(p_buf) : status
'' Read SCR register (8 bytes) into buffer.
'' Contains SD spec version and bus widths.
'' Routes through worker cog which owns the SPI pins.
''
'' @param p_buf - Pointer to 8-byte buffer to receive SCR data
'' @returns status - SUCCESS (0) on success, negative error code on failure

  status := send_command(CMD_READ_SCR, p_buf, 0, 0, 0)
  if status == SUCCESS
    DEBUG[CH_IDENT]("  [readSCRRaw] SCR read successfully")
  else
    DEBUG[CH_IDENT]("  [readSCRRaw] SCR read FAILED")

PUB readSDStatusRaw(p_buf) : status
'' Read SD Status register (ACMD13) - returns 64 bytes of card status.
'' Contains Speed Class, UHS Speed Grade, Video Speed Class, and more.
''
'' @param p_buf - Pointer to 64-byte buffer to receive SD Status data
'' @returns status - SUCCESS (0) on success, negative error code on failure

  status := send_command(CMD_READ_SD_STATUS, p_buf, 0, 0, 0)
  if status == SUCCESS
    DEBUG[CH_IDENT]("  [readSDStatusRaw] SD Status read successfully")
  else
    DEBUG[CH_IDENT]("  [readSDStatusRaw] SD Status read FAILED")

PUB getOCR() : ocr
'' Get cached OCR register value - Operating Conditions Register from card init.
'' Contains card capacity status (CCS) and voltage range.
''
'' @returns ocr - 32-bit OCR value, or 0 if card not initialized

  ocr := ocr_value
  DEBUG[CH_IDENT]("  [getOCR] OCR = $", uhex_long(ocr))

#endif

CON ' ---- Speed Control [SD_INCLUDE_SPEED] + Card Info ----

#ifdef SD_INCLUDE_SPEED

PUB attemptHighSpeed() : hs_ok
'' Attempt to enable 50 MHz high-speed mode with verification.
'' Routes through worker cog which owns the SPI pins.
'' Queries capability, switches mode, then verifies READ-ONLY: a baseline
'' sector captured at the pre-switch speed is re-read at 50 MHz and compared.
'' Nothing is written to the card at the unverified speed.
'' Safe to call - will not break operation on failure (falls back to 25 MHz).
''
'' RETURNS AN HONEST BOOLEAN -- TRUE means 50 MHz is active, FALSE means it is not, and
'' that is all. "The card does not offer high speed" and "the card could not be asked" are
'' both FALSE here, but they call for completely different responses, so which one it was
'' is in ERROR(): SUCCESS when the card simply said no, an error code when the query or
'' the verification failed. Without that split, a card with SPI trouble reports "high speed
'' not supported" and sends you diagnosing the wrong thing.
''
'' On success the SPI clock is raised toward 50 MHz; the frequency actually reached
'' is the nearest achievable one for the current sysclk (43_750_000 Hz at 350 MHz),
'' so read getSPIFrequency() for the clock and isHighSpeedActive() for the mode.
''
'' @returns hs_ok - TRUE if high-speed mode is active, FALSE if not (see ERROR() for
''                  whether the card declined or could not be asked)

  if cog_id == -1
    set_error(E_NOT_MOUNTED)                            ' Could not ask at all -- do not report it as "no"
  else
    if send_command(CMD_ATTEMPT_HIGH_SPEED, 0, 0, 0, 0) == SUCCESS
      hs_ok := pb_data0                                 ' Same rule as readHandle: completed commands only

PUB checkCMD6Support() : supported | scr[2], sd_spec
'' Check if card supports CMD6 command - reads SCR for SD spec version.
'' CMD6 supported by SD 2.0 and later cards (SD_SPEC >= 2).
''
'' RETURNS AN HONEST BOOLEAN. FALSE means the card is SD 1.x, or that the SCR could not be
'' read at all; ERROR() says which. See attemptHighSpeed() for why the two must not be the
'' same answer.
''
'' @returns supported - TRUE if CMD6 is available, FALSE if not or unknown (see ERROR())
' @local scr - SCR register data (2 longs = 8 bytes)
' @local sd_spec - SD spec version from SCR

  if readSCRRaw(@scr) < 0
    DEBUG[CH_HSPEED]("  [checkCMD6Support] Failed to read SCR")
  else
    sd_spec := scr.BYTE[0] & $0F                        '  SD_SPEC in bits [3:0]
    DEBUG[CH_HSPEED]("  [checkCMD6Support] SCR: $", uhex_byte_(scr.BYTE[0]), " $", uhex_byte_(scr.BYTE[1]), " SD_SPEC=", udec_(sd_spec))
    supported := sd_spec >= 2                           '  CMD6 supported in SD 2.0+

PUB checkHighSpeedCapability() : capable
'' Check if card reports high-speed capability - queries function group 1.
'' Routes through worker cog which owns the SPI pins.
'' Uses CMD6 mode 0 (check without switch).
'' Requires CMD6 support - call checkCMD6Support() first.
''
'' RETURNS AN HONEST BOOLEAN. FALSE means the card reported no high-speed function, or the
'' question could not be put to it; ERROR() says which. See attemptHighSpeed().
''
'' @returns capable - TRUE if high-speed function is supported, FALSE if not or unknown
''                    (see ERROR())

  if cog_id == -1
    set_error(E_NOT_MOUNTED)                            ' Could not ask at all -- do not report it as "no"
  else
    if send_command(CMD_CHECK_HS_CAPABILITY, 0, 0, 0, 0) == SUCCESS
      capable := pb_data0                               ' Same rule as readHandle: completed commands only

PUB setSPISpeed(freq) : actual_hz
'' Set SPI clock frequency. Routes through worker cog which owns the SPI pins.
'' Frequency is rounded to nearest achievable value based on P2 clock divider.
''
'' Requests are BOUNDED at the card's declared ceiling (TRAN_SPEED, capped at
'' the SD SPI-mode 25 MHz; 50 MHz while verified CMD6 high-speed mode is
'' active). Above-ceiling operation is diagnostic-only -- characterized silent
'' write corruption exists above spec -- and the returned actual_hz reports the
'' clamped truth. Diagnostic tools may lift the bound via
'' debugSetOverspeedAllowed() [SD_INCLUDE_DEBUG].
''
'' @param freq - Target SPI frequency in Hz
'' @returns actual_hz - Actual frequency achieved (may differ due to divider
''                      rounding or the production ceiling), or 0 if the speed
''                      could not be set (see ERROR())

  if cog_id <> -1
    if send_command(CMD_SET_SPI_SPEED, freq, 0, 0, 0) == SUCCESS
      actual_hz := pb_data0                             ' Same rule as readHandle: completed commands only

#endif

PUB getSPIFrequency() : hz
'' Get current SPI clock frequency in Hz.
''
'' @returns hz - Current SPI clock frequency in Hz

  hz := spi_freq

PUB getCardMaxSpeed() : hz
'' Get card's reported maximum speed from CSD TRAN_SPEED field.
''
'' @returns hz - Card's maximum speed in Hz

  hz := card_max_speed_hz

PUB getManufacturerID() : mid
'' Get card manufacturer ID (MID) from CID register.
'' Common IDs: $03=SanDisk, $1B=Samsung, $1D=ADATA, $27=Phison, $28=Lexar.
''
'' @returns mid - Manufacturer ID byte

  mid := card_mfr_id

PUB getReadTimeout() : ms
'' Get read timeout from CSD register in milliseconds.
'' SDHC/SDXC: Fixed 100ms per spec. SDSC: Calculated from TAAC/NSAC.
''
'' @returns ms - Read timeout in milliseconds

  ms := card_read_timeout_ms

PUB getWriteTimeout() : ms
'' Get write timeout from CSD register in milliseconds.
'' SDHC/SDXC: Fixed 250ms per spec. SDSC: Read timeout * R2W_FACTOR.
''
'' @returns ms - Write timeout in milliseconds

  ms := card_write_timeout_ms

PUB eraseBlockSectors() : sectors
'' Get erase block size in sectors as reported by the card's CSD SECTOR_SIZE field.
'' Useful for application logic that wants to align writes to erase boundaries
'' for reduced wear and improved write throughput.
''
'' Typical values:
''   SDSC (CSD v1.0):           32 sectors (16 KB block)
''   SDHC/SDXC (CSD v2.0):     128 sectors (64 KB block)
''
'' @returns sectors - Number of 512-byte sectors per erase block.
''                    Returns the default (128) if CSD has not been parsed.

  sectors := card_erase_block_sectors

PUB isHighSpeedActive() : active
'' Check whether the CARD is in CMD6 high-speed mode -- entered by a verified
'' attemptHighSpeed(), left by a later setSPISpeed() or by unmount().
''
'' This reports the card's MODE, not a clock threshold. The actual SPI frequency
'' in high-speed mode depends on sysclk (350 MHz sysclk yields 43_750_000 Hz, not
'' 50_000_000), so asking "is the clock at least 50 MHz" answered FALSE on most
'' sysclks while high-speed mode was genuinely active. Use getSPIFrequency() for
'' the clock; use this for the mode.
''
'' Always FALSE in a build without [SD_INCLUDE_SPEED] -- there is no way in.
''
'' @returns active - TRUE if the card is in high-speed mode

  active := hs_mode_active

CON ' ---- Debug / Diagnostics [SD_INCLUDE_DEBUG] ----

#ifdef SD_INCLUDE_DEBUG

PUB debugOnClockChange() : status
'' DIAGNOSTIC ONLY: Recompute host-side sysclk-dependent state after a
'' caller-initiated clkset(). Use only when investigating sysclk-dependent
'' card behavior (e.g., the three-mode test pattern in
'' diagnostic-tests/SD_frequency_characterize.spin2).
''
'' Production applications must NOT call this. Production guidance after a
'' clkset() is to unmount() and mount() again. Calling this method in
'' production constitutes undefined behavior.
''
'' Caller is responsible for ensuring no SD operation is in flight at the
'' time of the call. The worker cog's command mailbox is checked; if a
'' command is mid-dispatch, this method returns E_BAD_RESPONSE without
'' modifying state.
''
'' Recomputes:
''   - spi_period (smart-pin half-period, derived from new clkfreq)
''   - WXPIN(sck, spi_period) so the smart pin uses the new period
''   - miso_wxpin (Phase 2 sample mode reflects new hp)
''   - WXPIN(miso, miso_wxpin) so MISO uses the new sample mode
''   - idle_flush_clocks (auto-flush threshold in new sysclks)
''   - ct_tick_clocks (clock-tick threshold in new sysclks)
''
'' Does NOT re-initialize the card. The card's internal state (CMD0/CMD8/
'' ACMD41/CMD58 results) is preserved across the call. Card register
'' caches (CID/CSD/SCR) are also preserved.
''
'' @returns status - 0 on success, E_BAD_RESPONSE if a command is in flight

  if pb_cmd <> CMD_NONE
    status := E_BAD_RESPONSE                                                '  Worker is busy; refuse to touch state
    return
  recompute_clock_state()
  status := 0

PUB getWriteDiag() : result_code, r1_resp, data_resp, sector_num
'' Get diagnostic info from last writeSector call.
'' Codes: 0=not called, 1=CMD24 fatal, 2=data-response timeout,
''        3=data CRC reject, 4=data write-err, 5=data unknown reject,
''        6=busy timeout, 7=success
''
'' @returns result_code - Outcome code
'' @returns r1_resp - CMD24 R1 response byte
'' @returns data_resp - Data response token
'' @returns sector_num - Sector number attempted

  result_code := diag_write_result
  r1_resp := diag_write_r1
  data_resp := diag_write_dresp
  sector_num := diag_write_sector

PUB getCmdR1Diag() : r1_ms, polls, op
'' Get R1 latency from last cmd() call. Reveals whether the card responds
'' promptly to a command word, or whether it stalls (returning $FF on MISO
'' for many polls before producing a valid R1 with bit 7 = 0).
''
'' @returns r1_ms - Elapsed ms from R1-polling start to R1-received (-1 if timed out at 1s)
'' @returns polls - Number of byte polls executed before R1 (or timeout)
'' @returns op    - CMD opcode of the last cmd() call (which command this is for)

  r1_ms := diag_cmd_r1_ms
  polls := diag_cmd_r1_polls
  op    := diag_cmd_last_op

PUB getLastCMD13() : r2
'' Get last CMD13 result (R1 in high byte, STATUS in low byte).
'' Value is from most recent CMD13, regardless of success/failure.
''
'' @returns r2 - Combined R2 response word

  r2 := (last_cmd13_r1 << 8) | last_cmd13_status

PUB getLastCMD13Error() : r2
'' Get last CMD13 error - returns last non-zero CMD13 result (preserved until next error).
'' Useful for diagnostics - shows most recent error even after recovery.
''
'' @returns r2 - Last non-zero R2 response word

  r2 := last_cmd13_error

PUB getLastCMD13Capture(p_dest) : count
'' Copy CMD13 raw byte stream capture to caller's buffer.
'' Returns NCR gap length (position of first non-$FF byte).
'' Buffer contains: NCR gap $FF bytes, R1 byte, STATUS byte, extra bytes.
'' Caller must provide an 8-byte buffer.
''
'' @param p_dest - Pointer to 8-byte destination buffer
'' @returns count - NCR gap length (position of first non-$FF byte)

  bytemove(p_dest, @cmd13_capture, 8)
  count := cmd13_capture_len

PUB getLastCMD13PreCapture(p_dest)
'' Copy the 7 MISO bytes received DURING CMD13 command transmission (full-duplex capture).
'' These bytes reveal what the card was outputting while we were sending CMD13.
'' If any byte is not $FF, the card was still active (e.g., streaming data from a
'' previous operation that didn't fully terminate).
'' Caller must provide a 7-byte buffer.
''
'' @param p_dest - Pointer to 7-byte destination buffer

  bytemove(p_dest, @cmd13_pre_capture, 7)

PUB setForceCmd13(enabled)
'' Force CMD13 status checks even on cards flagged as unreliable.
'' Diagnostic use only: overrides the cmd13_reliable flag so checkCardStatus()
'' always sends CMD13. Use this to capture CMD13 byte streams on problem cards.
'' Set to FALSE (or call clearTestErrors()) to restore normal behavior.
''
'' @param enabled - TRUE to force CMD13, FALSE to respect probe result

  test_force_cmd13 := (enabled <> 0) ? TRUE : FALSE

PUB getLastCMD18R1() : r1
'' Get last CMD18 R1 response - returns the R1 byte from the most recent CMD18 (READ_MULTIPLE_BLOCK).
'' $00 = accepted, non-zero = rejected (see R1 bit definitions).
''
'' @returns r1 - R1 response byte from last CMD18

  r1 := last_cmd18_r1

PUB getLastCMD18Token() : token
'' Get last data token from CMD18 - returns the token byte from the most recent waitDataToken().
'' $FE = success (data start), $01-$0F = error tokens, $FF = no token received (timeout).
''
'' @returns token - Token byte from last CMD18 data wait

  token := last_cmd18_token

PUB getLastCMD18Result() : code
'' Get last CMD18 outcome code - indicates which failure path was taken.
'' 0 = success (got $FE), 1 = timeout (never got non-$FF), 2 = error token received.
''
'' @returns code - Outcome code (0=ok, 1=timeout, 2=error token)

  code := last_cmd18_result

PUB getLastCMD18FailPath() : path
'' Get last CMD18 failure path - indicates where readSectors() failed.
'' 0 = no failure, 1 = R1 reject, 2 = data token fail, 3 = CMD12 fail, 4 = CMD13 fail.
''
'' @returns path - Failure path code

  path := last_cmd18_fail

PUB getLastCMD18SectorsRead() : count
'' Get sectors successfully read in last CMD18 operation before any post-read failure.
''
'' @returns count - Number of sectors read

  count := last_cmd18_sread

PUB getLastCMD12R1() : r1
'' Get last CMD12 R1 response - returns the R1 byte from the most recent sendStopTransmission().
''
'' @returns r1 - R1 response byte (negative if timeout)

  r1 := last_cmd12_r1

PUB getLastCMD12Result() : code
'' Get last CMD12 outcome - 0=ok, 1=R1 timeout, 2=R1 error bits, 3=busy timeout.
''
'' @returns code - Outcome code

  code := last_cmd12_busy

PUB getLastCMD12Capture(p_dest) : count
'' Copy CMD12 raw byte stream capture to caller's buffer.
'' Returns count of bytes before first non-$FF (NCR gap length).
'' Buffer is 16 bytes: pre-R1 $FF padding, R1 byte, post-R1 bytes.
'' Caller must provide a 16-byte buffer.
''
'' @param p_dest - Pointer to 16-byte destination buffer
'' @returns count - Position of first non-$FF byte (NCR gap length)

  bytemove(p_dest, @cmd12_capture, 16)
  count := cmd12_capture_len

PUB getLastCMD12PreCapture(p_dest)
'' Copy the 7 MISO bytes received DURING CMD12 command transmission (full-duplex capture).
'' These bytes reveal what the card was outputting while we were sending CMD12.
'' If byte[0] is $FE, the card was already streaming the next data token.
'' Caller must provide a 7-byte buffer.
''
'' @param p_dest - Pointer to 7-byte destination buffer

  bytemove(p_dest, @cmd12_pre_capture, 7)

PUB getLastCMD23Used() : used
'' Get whether CMD23 path was used for the last multi-block read.
''
'' @returns used - TRUE if CMD23 was sent before CMD18, FALSE if CMD12 path was used

  used := last_cmd23_used

PUB getLastCMD23R1() : r1
'' Get R1 response from last CMD23. Returns $FF if CMD23 was not sent.
''
'' @returns r1 - R1 response byte from CMD23 ($00=accepted, $FF=not sent)

  r1 := last_cmd23_r1

PUB getLastCMD23Verify() : verify_byte
'' Get the post-read verification byte from CMD23 path.
'' After reading the last sector, one extra byte is clocked.
'' $FF means card stopped (auto-stop honored). Any other value means card was still streaming.
''
'' @returns verify_byte - MISO byte after last sector's CRC ($FF=stopped, other=still streaming)

  verify_byte := last_cmd23_verify

PUB getCmd23Supported() : supported
'' Get whether the current card supports CMD23 (SET_BLOCK_COUNT).
'' Determined from SCR CMD_SUPPORT field during init.
''
'' @returns supported - TRUE if CMD23 is available

  supported := cmd23_supported

PUB getLastReceivedCRC() : crc
'' Get CRC-16 from last sector read - returns the 16-bit CRC received from the SD card
'' after the most recent sector read operation. Use for validating CRC algorithm.
''
'' @returns crc - 16-bit CRC the card calculated and sent

  crc := diag_recv_crc

PUB getLastCalculatedCRC() : crc
'' Get CRC-16 calculated from data - returns the 16-bit CRC we calculated from received data.
'' Should match getLastReceivedCRC() if data transfer was clean.
''
'' @returns crc - 16-bit CRC calculated from data

  crc := diag_calc_crc

PUB getLastSentCRC() : crc
'' Get CRC-16 sent with last write - returns the 16-bit CRC we calculated and sent.
''
'' @returns crc - 16-bit CRC sent with the last write operation

  crc := diag_sent_crc

PUB getCRCMatchCount() : count
'' Get count of CRC matches - returns number of sector reads where CRC matched.
''
'' @returns count - Number of sector reads where calculated CRC matched received CRC

  count := diag_crc_matches

PUB getCRCMismatchCount() : count
'' Get count of CRC mismatches - returns number of sector reads where CRC did NOT match.
'' Non-zero indicates data corruption occurred during transfer.
''
'' @returns count - Number of sector reads where CRC did not match

  count := diag_crc_mismatches

PUB getCRCRetryCount() : count
'' Get count of CRC retry attempts - returns total number of read retries triggered by CRC mismatches.
'' Non-zero indicates transient bus errors were recovered.
''
'' @returns count - Total CRC retry attempts across all sector reads

  count := diag_crc_retries

PUB setCRCValidation(enabled)
'' Enable/disable CRC validation for sector reads.
'' When enabled, each sector read validates CRC and updates match/mismatch counts.
''
'' @param enabled - TRUE (non-zero) enables CRC checking, FALSE (0) disables

  diag_crc_enabled := (enabled <> 0) ? 1 : 0

#ifdef SD_INCLUDE_DEBUG

PUB debugSetSampleMode(mode)
'' DIAGNOSTIC ONLY: select MISO sample mode for the smart-pin direct (Path A)
'' read path. This affects every sp_transfer_8 call and any byte-by-byte MISO
'' read. For the streamer-DMA bulk path (Path B), see debugSetAlignDelayOffset.
''
'' Production applications must NOT call this. The driver computes the right
'' sample mode internally based on hp; this knob is exposed only for diagnostic
'' tools (e.g., diagnostic-tests/SD_phase_sweep_test.spin2) that walk the
'' parameter grid to characterize marginal cards.
''
'' Modes:
''   -1 = auto-by-hp (default): pre-edge when hp <= pre_edge_threshold,
''        else on-edge. The default threshold of 5 means hp=4 and hp=5 use
''        pre-edge, hp >= 6 uses on-edge.
''    0 = force pre-edge (%0_00111): sample ~1 sysclk before SCK rising edge.
''        More tolerant of slow / older cards with long t_OD.
''    1 = force on-edge (%1_00111): sample ~2 sysclks past SCK rising edge.
''        Optimal for modern fast cards; this is the historical default.
''
'' Out-of-range modes are silently ignored. Mode change re-applies WXPIN to
'' MISO immediately so subsequent transfers use the new value.
''
'' @param mode - -1 (auto), 0 (pre-edge), or 1 (on-edge)

  if mode < -1 or mode > 1
    return                                                                  '  silently ignore invalid input
  sample_mode_override := mode
  ' Recompute miso_wxpin against current half-period
  case sample_mode_override
    0:        miso_wxpin := %0_00111
    1:        miso_wxpin := %1_00111
    other:                                                                  '  -1 = auto
      if spi_period <= pre_edge_threshold
        miso_wxpin := %0_00111
      else
        miso_wxpin := %1_00111
  ' Re-apply to MISO smart pin so the next byte-by-byte transfer uses it.
  ' WXPIN is safe to write while the smart pin is running (DIR=1) per
  ' p2kbArchSmartPins live-update behavior.
  WXPIN(miso, miso_wxpin)

PUB debugSetPreEdgeThreshold(hp_thresh)
'' DIAGNOSTIC ONLY: set the half-period threshold at and below which auto-mode
'' chooses pre-edge sampling. Default 5 (hp=4 and hp=5 use pre-edge in auto
'' mode). Only effective when sample_mode_override = -1 (auto). Forced modes
'' ignore. Production applications must NOT call this.
''
'' Range 4..32: hp values are clamped to >=4 by applySPISpeed, and hp=32
'' represents an extreme low-sysclk case far beyond practical SD use.
'' Out-of-range thresholds are silently ignored.
''
'' @param hp_thresh - threshold half-period value (4..32)

  if hp_thresh < 4 or hp_thresh > 32
    return                                                                  '  silently ignore invalid input
  pre_edge_threshold := hp_thresh
  ' Recompute miso_wxpin in case current hp is near the new threshold
  if sample_mode_override == -1
    if spi_period <= pre_edge_threshold
      miso_wxpin := %0_00111
    else
      miso_wxpin := %1_00111
    WXPIN(miso, miso_wxpin)

PUB debugGetEffectiveSampleMode() : mode
'' DIAGNOSTIC ONLY: return the actual MISO WXPIN value currently in use (the X
'' register value applied to the MISO smart pin). %1_00111 means on-edge,
'' %0_00111 means pre-edge. Production applications must NOT call this.
''
'' @returns mode - the current miso_wxpin value (one of %1_00111 or %0_00111)

  mode := miso_wxpin

PUB debugGetCurrentHp() : hp
'' DIAGNOSTIC ONLY: return the current SPI half-period in sysclks (the value
'' the SCK P_TRANSITION smart pin uses for its base period). Equals spi_period.
'' Production applications must NOT call this.
''
'' @returns hp - current half-period in sysclks

  hp := spi_period

PUB debugSetAlignDelayOffset(offset)
'' DIAGNOSTIC ONLY: set the signed integer offset added to spi_period (= hp)
'' to compute the streamer-DMA align_delay at every streamer-burst site.
''
'' This affects ONLY streamer-driven 512-byte sector transfers (Path B). It
'' does NOT affect single-byte transfers -- for Path A see debugSetSampleMode.
'' Production applications must NOT call this. The driver will bake in the
'' correct value once sweep results identify the production default.
''
'' Default 0 preserves the historical align_delay = hp behavior. Per
'' p2kbArchIoPinTiming the host-side I/O ring round trip is 5-6 sysclks
'' (smart-pin output 1.5-3 + registered input 3-4), so the optimal offset
'' post-Phase-1.5 is at positive values in the +5 to +7 range, not negative.
''
'' Floor: align_delay is clamped to >= 2 at use site (cog needs 2 sysclks
'' to execute WAITX before XINIT). At hp=4 with offset=-2 this lands exactly
'' on the floor.
''
'' Range: caller may pass [-8, +16]. Out-of-range values are silently ignored.
'' The upper limit covers one full bit period (2*hp ticks; 14 at the production
'' hp=7) so a passing-band sweep can find the band's UPPER edge -- the 2026-08-17
'' socket characterization found every offset up to the previous +8 limit passing,
'' leaving the band top unmeasured.
''
'' @param offset - signed integer offset added to spi_period

  if offset < -8 or offset > 16
    return                                                                  '  silently ignore invalid input
  align_delay_offset := offset

PUB debugGetEffectiveAlignDelay() : delay
'' DIAGNOSTIC ONLY: return the streamer-DMA align_delay value that will be
'' used on the next streamer-driven sector transfer (Path B) -- the shared
'' effectiveAlignDelay() computation, including the hp=4 floor-cell rule and
'' the WAITX floor of 2. Production applications must NOT call this.
''
'' @returns delay - the effective WAITX value in sysclks

  delay := effectiveAlignDelay()

PUB debugSetTxAlignDelay(pad)
'' DIAGNOSTIC ONLY: set the WAITX phase pad used between the SCK counter
'' reset and XINIT at both write-path streamer sites (writeSector and
'' writeSectors). This is the bench shmoo knob for the layout-invariance
'' fix -- with RDFAST hoisted out of the phase window, the data-vs-clock
'' phase is a build-independent constant and this pad centers it in the
'' passing window. Production applications must NOT call this; the driver
'' bakes in the characterized default (DAT tx_align_delay).
''
'' Range: [2, 2+2*hp] covers one full SCK period of phase. Values below the
'' WAITX floor of 2 are clamped at the use site; values above 2+2*hp wrap
'' the same phases and are accepted but pointless.
''
'' @param pad - WAITX value in sysclks

  tx_align_delay := pad

PUB debugGetTxAlignDelay() : pad
'' DIAGNOSTIC ONLY: return the WAITX phase pad the next write-path streamer
'' burst will use (before the use-site floor clamp to >= 2).
'' Production applications must NOT call this.
''
'' @returns pad - configured tx_align_delay in sysclks

  pad := tx_align_delay

PUB debugSetOverspeedAllowed(enabled)
'' DIAGNOSTIC ONLY: allow setSPISpeed() targets above the production ceiling
'' (the card's TRAN_SPEED capped at the SD SPI-mode 25 MHz). The socket-timing
'' campaign measured silent whole-sector write corruption above spec -- the
'' tx_align_delay losing phase moves with hp and lands on the default at
'' hp=5 / 35 MHz (SOCKET-SHMOO-RUN-NOTES.md round 7b) -- so above-ceiling
'' operation is reserved for characterization tools that know the map.
'' Production applications must NOT call this.
''
'' @param enabled - nonzero allows above-ceiling targets; 0 restores the bound

  overspeed_allowed := (enabled <> 0) ? 1 : 0

PUB debugSetAlignFloorRuleEnabled(enabled)
'' DIAGNOSTIC ONLY: enable or disable the hp=4 floor-cell rule (see
'' effectiveAlignDelay). The rule withholds positive align offsets at
'' spi_period = 4, where the passing band has never been measured -- which also
'' makes that cell impossible to sweep, since every positive offset collapses to
'' the same effective align value. A characterization tool disables the rule to
'' MEASURE the band; production applications must NOT call this.
''
'' Disabling it re-enables the configuration that broke the CMD6 high-speed
'' verify read in round 8a. That is the point -- the sweep is looking for where
'' the edges are -- but nothing outside a characterization run should be here.
''
'' @param enabled - nonzero keeps the production rule; 0 lifts it for measurement

  floor_rule_disabled := (enabled <> 0) ? 0 : 1

#endif                                                  ' SD_INCLUDE_DEBUG (Phase 2/3 diagnostic tuning APIs)

CON ' ---- Fault injection [SD_INCLUDE_TEST_HOOKS] ----

#ifdef SD_INCLUDE_TEST_HOOKS

PUB setTestForceReadError(count)
'' Set CRC error injection counter for reads. Each sector read will see a
'' forced CRC mismatch until the counter reaches zero.
'' Set to 1: one retry then success. Set to MAX_READ_CRC_RETRIES (3): all retries fail.
''
'' This hook is untargeted - it fires on the next N reads of ANY sector. Use
'' setTestFailSector() when the failing sector must be named. It also has no
'' effect on a card whose read-CRC validation is disabled (CW_NO_DATA_CRC);
'' setTestFailSector() does fire on such cards.
''
'' @param count - Number of read CRC mismatches to force

  test_force_read_crc_error := count

PUB setTestForceWriteError(enabled)
'' Arm one-shot CRC error injection for the next write. The next writeSector()
'' will send a corrupted CRC, causing the card to reject the data.
''
'' This hook is untargeted - it corrupts the next write of ANY sector - and it
'' depends on the card choosing to reject a bad CRC, so it does nothing on a
'' CW_NO_DATA_CRC card (which is sent idle filler in the CRC slot). Use
'' setTestFailSector() or setTestFailWriteAfter() for a failure that is both
'' named and card-independent.
''
'' @param enabled - Non-zero arms, zero disarms

  test_force_write_crc_error := (enabled <> 0) ? 1 : 0

PUB getTestErrorCount() : count
'' Get count of injected test errors triggered since last clear.
''
'' @returns count - Number of injected errors triggered

  count := test_error_count

PUB setTestMaxClusters(maxClusters)
'' Set artificial cluster limit for disk-full testing. When non-zero,
'' allocateCluster() will fail once the cluster number reaches this limit.
'' Set to 0 to disable (normal operation).
''
'' @param maxClusters - Maximum cluster number (0 = no limit)

  test_max_clusters := maxClusters

PUB setTestFailSector(sector, mode)
'' Arm a targeted sector-I/O failure at one LBA. Unlike the untargeted CRC
'' hooks above, this names the sector that must fail, so a specific write
'' inside a multi-step operation - the FAT2 mirror update, a directory-entry
'' rewrite - can be made to fail on its own.
''
'' The mode selects the direction and the lifetime:
''   TF_READ                readSector() fails at this LBA
''   TF_WRITE               writeSector() fails at this LBA
''   TF_BOTH                both directions fail
''   ... | TF_STICKY        keep failing until cleared; without it, one-shot
''   TF_OFF                 disarm (same as setTestFailSector(-1, TF_OFF))
''
'' An injected failure is indistinguishable to the caller from a genuine one.
'' A read failure runs the real CRC retry loop, bumps the same CRC diagnostic
'' counters, invalidates the same cache entry and returns E_CRC_ERROR. A write
'' failure returns E_WRITE_REJECTED with the same cache invalidation and the
'' same write-diagnostic code (3) as a card that rejected the data block.
''
'' Two properties are worth knowing before writing a test against this:
''  - A read failure fires only on a cache MISS. That is faithful: a genuine
''    read failure cannot happen for a sector the driver never reads.
''  - Only the single-block paths are injected. Raw multi-block transfers
''    (readSectorsRaw/writeSectorsRaw, CMD18/CMD25) are not affected.
''
'' @param sector - LBA to fail (-1 disarms)
'' @param mode - TF_READ, TF_WRITE or TF_BOTH, optionally OR'd with TF_STICKY

  if sector < 0 OR (mode & TF_BOTH) == TF_OFF
    test_fail_sector := -1
    test_fail_mode := TF_OFF
  else
    test_fail_sector := sector
    test_fail_mode := mode

PUB setTestFailWriteAfter(writeIndex)
'' Arm a failure on the nth subsequent writeSector() call, counting from the
'' next one. Use this when the sector that must fail is not known in advance
'' but its position in a write sequence is - the second of the two FAT copies,
'' the directory write that follows a data write.
''
'' The failure is one-shot and identical to the write failure described in
'' setTestFailSector(): E_WRITE_REJECTED, same cache invalidation, same
'' write-diagnostic code. Counting covers single-block writes only.
''
'' @param writeIndex - Which subsequent writeSector() call fails (1 = the very next; 0 disarms)

  test_fail_write_after := (writeIndex > 0) ? writeIndex : 0
  test_write_call_count := 0

PUB getTestWriteCallCount() : count
'' Get the number of writeSector() calls made since the counter was last reset -
'' by setTestFailWriteAfter() or clearTestErrors(). Counting runs whether or not
'' anything is armed, so a test can measure how many writes an operation actually
'' makes and then arm the one it wants to fail.
''
'' @returns count - writeSector() calls seen since the last reset

  count := test_write_call_count

PUB setTestFailReadAfter(readIndex)
'' Arm a failure on the nth subsequent CARD read - readSector() calls that
'' actually transfer from the card; cache hits are not counted. Use this when
'' the read that must fail is not known by LBA in advance but its position in
'' a read sequence is (v1.7.0 task #50: the re-read of the source entry's sector
'' inside moveFile, which shares its LBA with reads an LBA-armed injection
'' would kill first).
''
'' The failure is one-shot: the armed read returns E_CRC_ERROR before any
'' transfer starts, modeling an unrecoverable read; the cache tag for that
'' tier is left invalid, exactly as a genuine exhausted-retries read leaves it.
''
'' @param readIndex - Which subsequent card read fails (1 = the very next; 0 disarms)

  test_fail_read_after := (readIndex > 0) ? readIndex : 0
  test_read_call_count := 0

PUB getTestReadCallCount() : count
'' Get the number of card reads (readSector() cache misses) since the counter
'' was last reset - by setTestFailReadAfter() or clearTestErrors(). Counting
'' runs whether or not anything is armed, so a test can measure how many card
'' reads an operation actually makes and then arm the one it wants to fail.
''
'' @returns count - card reads seen since the last reset

  count := test_read_call_count

PUB setTestInvalidateCaches() : status
'' Drop all three sector-cache tags (directory, FAT, data) so the next
'' readSector() of any sector - whichever cache tier serves it - is a
'' guaranteed card read. Pure tag reset - no I/O is performed and nothing is
'' flushed; per-handle sector buffers are untouched, so a position already
'' buffered in an open handle is still served from that buffer without a
'' card read. Only reads that reach readSector() get the miss guarantee.
''
'' Injection tests need this because the read hooks fire only on a cache
'' miss: a sector the driver already holds never reaches the injection site,
'' so an armed read can silently succeed from cache. Call this after seeding
'' a file and before the armed read to make the miss deterministic.
''
'' The reset runs on the worker cog, serialized with all other commands, so
'' it cannot race an in-flight operation's cache use.
''
'' Like the rest of the setTest* tier this needs SD_INCLUDE_TEST_HOOKS,
'' which SD_INCLUDE_DEBUG deliberately does NOT imply - see the header note.
''
'' @returns status - 0 on success

  status := send_command(CMD_TEST_INVAL_CACHES, 0, 0, 0, 0)

PUB clearTestErrors()
'' Reset all test error injection state. Disarms every read/write hook,
'' zeroes the triggered error counter, and clears diagnostic overrides.
'' Leaves no residue for the next test.

  test_force_read_crc_error := 0
  test_force_write_crc_error := 0
  test_error_count := 0
  test_force_cmd13 := FALSE
  test_max_clusters := 0
  test_fail_sector := -1
  test_fail_mode := TF_OFF
  test_fail_write_after := 0
  test_write_call_count := 0
  test_fail_read_after := 0
  test_read_call_count := 0

#endif                                                  ' SD_INCLUDE_TEST_HOOKS (fault injection)

PUB debugGetRootSec() : sector
'' DEBUG: Return root_sec for diagnostic.
''
'' @returns sector - Root directory sector number

  sector := root_sec

PUB debugGetDirSec() : sector
'' DEBUG: Return calling cog's current directory sector for diagnostic.
''
'' @returns sector - Current directory sector number for calling cog

  sector := cog_dir_sec[COGID()]

PUB debugGetVbrSec() : sector
'' DEBUG: Return VBR sector for diagnostic.
''
'' @returns sector - Volume Boot Record sector number

  sector := vbr_sec

PUB debugGetFatSec() : sector
'' DEBUG: Return FAT sector for diagnostic.
''
'' @returns sector - FAT start sector number

  sector := fat_sec

PUB debugGetSecPerFat() : count
'' DEBUG: Return sectors per FAT for diagnostic.
''
'' @returns count - Number of sectors per FAT

  count := sec_per_fat

PUB debugZeroRootSector() : status
'' DEBUG: Zero the FIRST sector of the root directory. Diagnostic sledgehammer for
'' a root directory too corrupt to enumerate -- it does NOT delete all files.
''
'' Exactly what it does, and does not do:
''   - Zeroes ONLY root_sec, the first root-directory sector (16 entries).
''     Entries in the second and later root sectors are left physically intact.
''   - Frees NO cluster chains. Every entry it erases leaks its whole chain: that
''     space becomes lost clusters and no deleteFile() will ever return it.
''   - Leaves those intact later entries UNREACHABLE. Zeroing entry 0 writes a
''     FAT32 end-of-directory marker, so every conforming scan -- dir(),
''     openDirectory(), SD_FAT32_audit, and any host OS -- stops before it gets to
''     them. They are still on the card and gone as far as any tool is concerned.
''
'' So this is a one-way door for the whole root directory, not just the 16 entries
'' it overwrites. SD_FAT32_fsck will reclaim the leaked clusters, but "leaked"
'' includes the unreachable survivors' clusters -- their data goes too, and the
'' entries themselves stay on the card where they can resurface once the root
'' refills past 16 entries. Treat a card as scratch after this call: SD_format_card
'' is the way back to a genuinely clean one. To delete everything, format -- there
'' is no delete-all in this driver.
''
'' @returns status - 0 on success, -1 on error

  status := send_command(CMD_DEBUG_ZERO_ROOT_SEC, 0, 0, 0, 0)

PUB debugReadSectorSlow(sector, p_buffer) : status
'' DEBUG: Read sector byte-by-byte (no streamer) - for comparison with streamer.
'' This is SLOW but useful for debugging streamer issues.
'' Requires worker cog to be running (SPI pins configured).
''
'' NOTE: This runs in Cog0 and requires SPI smart pins to be configured for this cog.
''       It will NOT work with the normal driver architecture.
''       This is for DIAGNOSTIC USE ONLY.
''
'' @param sector - Sector number to read
'' @param p_buffer - Pointer to 512-byte destination buffer
'' @returns status - 0 on success, -1 on timeout/error

  status := send_command(CMD_DEBUG_SLOW_READ, sector, p_buffer, 0, 0)

PUB debugEraseBlock(start_sector) : status
'' DIAGNOSTIC ONLY: Erase one erase-block region starting at start_sector.
''
'' Sequence: CMD32 (ERASE_WR_BLK_START_ADDR), CMD33 (ERASE_WR_BLK_END_ADDR),
'' CMD38 (ERASE), then waits for busy completion. End address is computed as
'' start_sector + eraseBlockSectors() - 1 so exactly one erase block is erased.
''
'' Used by erase-then-write recovery tests (Phase D3 of macca diagnostic) to
'' distinguish "card flash is recoverable" from "card flash is failing."
''
'' Production code MUST NOT call this. The SD spec discourages explicit erase
'' for normal block writes - the controller handles erase internally on RMW.
'' Misuse can corrupt the FAT32 filesystem if start_sector falls within
'' filesystem-occupied space.
''
'' @param start_sector - First sector of the erase block (caller responsible
''                       for erase-block alignment; no alignment check is done)
'' @returns status - 0 on success, negative error code on timeout/IO error

  status := send_command(CMD_DEBUG_ERASE_BLOCK, start_sector, 0, 0, 0)

PUB debugGetReadSectorDiag(p_sector, p_buftype, p_token, p_b0, p_b1, p_b2, p_b3, p_pbuf)
'' DEBUG: Get readSector diagnostic data - copies diagnostic data from last readSector call.
'' Call this after readSectorRaw() to see what happened inside readSector.
''
'' @param p_sector - Pointer to receive last sector number
'' @param p_buftype - Pointer to receive last buffer type
'' @param p_token - Pointer to receive last token ($FE on success)
'' @param p_b0 - Pointer to receive buffer byte 0
'' @param p_b1 - Pointer to receive buffer byte 1
'' @param p_b2 - Pointer to receive buffer byte 2
'' @param p_b3 - Pointer to receive buffer byte 3
'' @param p_pbuf - Pointer to receive buffer pointer

  LONG[p_sector] := diag_last_sector
  LONG[p_buftype] := diag_last_buftype
  LONG[p_token] := diag_last_token
  LONG[p_b0] := diag_buf_byte0
  LONG[p_b1] := diag_buf_byte1
  LONG[p_b2] := diag_buf_byte2
  LONG[p_b3] := diag_buf_byte3
  LONG[p_pbuf] := diag_p_buf

PUB debugGetReadSectorDiagExt(p_before0, p_before1, p_before2, p_before3, p_spi_period)
'' DEBUG: Get extended readSector diagnostic data - buffer state BEFORE streamer and SPI timing.
''
'' @param p_before0 - Pointer to receive buffer byte 0 before streamer
'' @param p_before1 - Pointer to receive buffer byte 1 before streamer
'' @param p_before2 - Pointer to receive buffer byte 2 before streamer
'' @param p_before3 - Pointer to receive buffer byte 3 before streamer
'' @param p_spi_period - Pointer to receive SPI period value

  LONG[p_before0] := diag_before_b0
  LONG[p_before1] := diag_before_b1
  LONG[p_before2] := diag_before_b2
  LONG[p_before3] := diag_before_b3
  LONG[p_spi_period] := diag_spi_period

PUB debugDumpRootDir() | sec, idx, p_entry, local_buf[128]
'' DEBUG: Dump root directory entries to debug output.
'' Routes through worker cog which owns the SPI pins.
'' This is a diagnostic function for debugging. It reads the root directory
'' and prints each entry's first 11 bytes (filename) and first cluster.
'' Called from test cog so output appears in headless logs.
''
' @local sec - Current sector being read
' @local idx - Entry index counter
' @local p_entry - Pointer to current directory entry
' @local local_buf - Local 512-byte buffer for sector data

  sec := root_sec
  DEBUG[CH_DIR]("  [debugDumpRootDir] root_sec=", udec_(sec), " cog_dir_sec=", udec_(cog_dir_sec[COGID()]))
  if send_command(CMD_READ_SECTOR_RAW, sec, @local_buf, 0, 0) <> SUCCESS
    DEBUG[CH_DIR]("  [debugDumpRootDir] FAILED to read root directory sector")
  else
    DEBUG[CH_DIR]("  [debugDumpRootDir] Read sector ", udec_(sec), " into local buffer")
    repeat idx from 0 TO DIR_ENTRIES_PER_SECTOR - 1     ' First 16 entries
      p_entry := @local_buf + (idx * DIR_ENTRY_SIZE)
      if BYTE[p_entry] == 0
        DEBUG[CH_DIR]("  Entry ", udec_(idx), ": [END OF DIR]")
        quit
      elseif BYTE[p_entry] == DIR_ENTRY_DELETED
        DEBUG[CH_DIR]("  Entry ", udec_(idx), ": [DELETED]")
      else
        DEBUG[CH_DIR]("  Entry ", udec_(idx), ": [", lstr_(p_entry, 11), "] attr=$", uhex_byte_(BYTE[p_entry+11]), " clus=", udec_(WORD[p_entry+26] | (WORD[p_entry+20] << 16)))

PUB displaySector() | address, char, ascii_ptr, idx
'' Display sector in buffer - prints hex dump with ASCII representation.
''
' @local address - Current byte offset in buffer
' @local char - Current character being processed
' @local ascii_ptr - Pointer to ASCII representation string
' @local idx - Loop counter

  ascii_ptr := string("0123456789ABCDEF")
  repeat address from 0 TO 495 step 16
    repeat idx from 0 TO 15
      case char := (buf[address + idx])
        $20..$7E: BYTE[ascii_ptr + idx] := char
        other:
          if char == 0
            BYTE[ascii_ptr + idx] := "."
          else
            BYTE[ascii_ptr + idx] := char // 26 + "a"
    DEBUG[CH_SECTOR](uhex_word_(address),uhex_byte_array_(@buf + address,8),"-",uhex_byte_array_(@buf + address + 8,8)," | ",lstr_(ascii_ptr,16))

PUB displayEntry() | address, char, ascii_ptr, idx
'' Display directory entry - prints hex dump of entry_buffer with ASCII representation.
''
' @local address - Current byte offset in entry
' @local char - Current character being processed
' @local ascii_ptr - Pointer to ASCII representation string
' @local idx - Loop counter

  ascii_ptr := string("0123456789ABCDEF")
  repeat address from 0 TO 31 step 16
    repeat idx from 0 TO 15
      case char := (BYTE[@entry_buffer][address + idx])
        $20..$7E: BYTE[ascii_ptr + idx] := char
        other:
          if char == 0
            BYTE[ascii_ptr + idx] := "."
          else
            BYTE[ascii_ptr + idx] := char // 26 + "a"
    DEBUG[CH_RECOVER](uhex_word_(address),uhex_byte_array_(@entry_buffer + address,8),"-",uhex_byte_array_(@entry_buffer + address + 8,8)," | ",lstr_(ascii_ptr,16))

PUB displayFAT(cluster) | fat_sector, local_buf[128]
'' Display FAT sector containing cluster number - reads and displays FAT entries.
'' Routes through worker cog which owns the SPI pins.
''
'' @param cluster - Cluster number to display FAT sector for
' @local fat_sector - Computed FAT sector number
' @local local_buf - Local 512-byte buffer for sector data

  fat_sector := fat_sec + cluster >> 7
  if send_command(CMD_READ_SECTOR_RAW, fat_sector, @local_buf, 0, 0) <> SUCCESS
    DEBUG[CH_SECTOR]("  [displayFAT] Read FAILED for sector ", udec_(fat_sector))
  else
    bytemove(@buf, @local_buf, SECTOR_SIZE)             ' Copy to buf for displaySector()
    displaySector()

#endif

CON ' ---- Worker Infrastructure ----

#ifdef SD_INCLUDE_DEBUG

PRI recompute_clock_state() | half_period
' S.3 helper: recompute host-side sysclk-dependent state against the new
' clkfreq, using the cached current_spi_target_hz to drive the SPI rate
' calculation. Same formula as applySPISpeed (ceiling division clamped to >=4).
' Called only by debugOnClockChange() [SD_INCLUDE_DEBUG].

  ' Recompute spi_period (= hp) from new clkfreq against cached SPI target
  half_period := (clkfreq + (current_spi_target_hz * 2) - 1) / (current_spi_target_hz * 2)
  if half_period < 4
    half_period := 4
  spi_period := half_period
  spi_freq := clkfreq / (half_period * 2)

  ' Recompute Phase 2 miso_wxpin against the new hp
  case sample_mode_override
    0:        miso_wxpin := %0_00111
    1:        miso_wxpin := %1_00111
    other:                                                                  '  -1 = auto
      if half_period <= pre_edge_threshold
        miso_wxpin := %0_00111
      else
        miso_wxpin := %1_00111

  ' Apply new period and sample mode to smart pins (live-update is safe per
  ' p2kbArchSmartPins live-update behavior for WXPIN with DIR=1)
  WXPIN(sck, half_period)
  WXPIN(miso, miso_wxpin)

  ' Recompute worker-cog timing thresholds against new clkfreq
  idle_flush_clocks := clkfreq / 1000 * IDLE_FLUSH_MS
  ct_tick_clocks := clkfreq * 2

#endif                                                  ' SD_INCLUDE_DEBUG

PRI set_error(error_code) : code_out
' Set error code for this cog - store error code in per-cog slot and return the code.
'
' @param error_code - Error code to store
' @returns code_out - The same error code (for chained returns)

  LONG[@last_error][COGID()] := error_code
  code_out := error_code

PRI fs_worker() | cur_cmd
' Worker cog main loop - runs in the dedicated worker cog.
' Owns the SPI pins and handles all filesystem operations.
'
' @local cur_cmd - Current command being processed

  DEBUG[CH_API]("  [fs_worker] Starting on cog ", udec_(COGID()))

  ' Initialize SPI pins (this cog owns them)
  pinh(cs)                                                                      ' CS HIGH = deselected
  pinh(mosi)                                                                    ' MOSI HIGH idle
  pinl(sck)                                                                     ' SCK LOW (SPI mode 0)

  DEBUG[CH_API]("  [fs_worker] Pins initialized: CS=P", udec_(cs), " MOSI=P", udec_(mosi), " MISO=P", udec_(miso), " SCK=P", udec_(sck))

  ' Initialize FIELD pointers for direct date_stamp access
  fld_yr  := ^@date_stamp.[31..25]
  fld_mon := ^@date_stamp.[24..21]
  fld_day := ^@date_stamp.[20..16]
  fld_hr  := ^@date_stamp.[15..11]
  fld_min := ^@date_stamp.[10..5]
  fld_sec := ^@date_stamp.[4..0]

  ' Main command loop (structured: clock tick, command dispatch, idle flush)
  idle_timer := GETCT()
  flush_done := true

  repeat
    ' --- Filesystem command (Priority 1) ---
    repeat until (cur_cmd := pb_cmd) <> CMD_NONE
      ' --- Clock tick (F2: 2-second live timestamp) ---
      if ct_active
        if (GETCT() - ct_last_tick) >= ct_tick_clocks
          tick_clock()
          ct_last_tick := GETCT()

      ' --- Auto-flush (F3: flush dirty handles after 200ms idle) ---
      if NOT flush_done
        if (GETCT() - idle_timer) >= idle_flush_clocks
          do_idle_flush()

#ifdef SD_INCLUDE_STACK_CHECK
    ' The formal stack-check object owns cog_stack_end_mark and detects a shallower
    ' overflow than the driver's own guard can (the guard sits one long further out).
    '
    ' KNOWN GAP (bench builds only): checkStack() halts this cog WITHOUT publishing a
    ' status, so a caller asleep in WAITATN is stranded. Converting this site to
    ' publish-then-halt is deferred: every attempt to wrap the call in a condition made
    ' SD_RT_mount_tests #31 fail reproducibly, with the added branch demonstrably never
    ' taken. That is the same unexplained sensitivity tracked as root cause #3 in
    ' DOCs/Analysis/POST-V161-ROOT-CAUSE-ANALYSIS.md -- do not "fix" this by wrapping it
    ' until that is explained.
    stackUtils.checkStack(@cog_stack, STACK_SIZE)
#endif

    DEBUG[CH_API]("  [fs_worker] Received command ", udec_(cur_cmd))

' MODE ENFORCEMENT: Reject commands invalid for current mode
' File system commands require MODE_FILESYSTEM
' Raw sector commands are allowed in both MODE_RAW and MODE_FILESYSTEM
' Mode transitions (MOUNT, UNMOUNT, INIT_CARD_ONLY) have their own logic
' Filesystem commands (CMD_NEWDIR..CMD_MOVEFILE, CMD_OPEN_READ..CMD_SET_VOL_LABEL, CMD_CREATE_CONTIGUOUS..CMD_FILE_FRAGMENTS)
#ifdef SD_INCLUDE_DEFRAG
    if (cur_cmd >= CMD_NEWDIR AND cur_cmd <= CMD_MOVEFILE) OR (cur_cmd >= CMD_OPEN_READ AND cur_cmd <= CMD_SET_VOL_LABEL) OR (cur_cmd >= CMD_CREATE_CONTIGUOUS AND cur_cmd <= CMD_FILE_FRAGMENTS)
#else
    if (cur_cmd >= CMD_NEWDIR AND cur_cmd <= CMD_MOVEFILE) OR (cur_cmd >= CMD_OPEN_READ AND cur_cmd <= CMD_SET_VOL_LABEL)
#endif
      if driver_mode <> MODE_FILESYSTEM
        DEBUG[CH_API]("  [fs_worker] REJECTED: File operation requires MODE_FILESYSTEM")
        pb_status := E_NOT_MOUNTED
        pb_data0 := E_NOT_MOUNTED
        pb_cmd := CMD_NONE
        COGATN(1 << pb_caller)
        next                                                                    ' Skip to next command

    ' Dispatch command
    case cur_cmd
      CMD_MOUNT:
        pb_status := do_mount()

      CMD_UNMOUNT:
        pb_status := do_unmount()

      CMD_NEWDIR:
        pb_status := do_newdir(pb_param0)

      CMD_DELETE:
        pb_status := do_delete(pb_param0)

      CMD_CHDIR:
        pb_status := do_chdir(pb_param0)

      CMD_FILESIZE:
        pb_data0 := fileSize()
        pb_status := SUCCESS

      CMD_FREESPACE:
        pb_data0 := do_freespace()
        pb_status := freespace_error                    ' An incomplete scan is not a free-space answer

      CMD_SYNC:
        pb_status := do_sync()

      CMD_RENAME:
        pb_status := do_rename(pb_param0, pb_param1)

      CMD_MOVEFILE:
        pb_status := do_movefile(pb_param0, pb_param1)

      CMD_READDIR:
        pb_status := do_readdir(pb_param0)

#ifdef SD_INCLUDE_DEBUG
      CMD_DEBUG_SLOW_READ:
        ' DEBUG: Read sector byte-by-byte without streamer for comparison
        pb_status := readSectorSlow(pb_param0, pb_param1)

      CMD_DEBUG_ZERO_ROOT_SEC:
        ' DEBUG: Zero the FIRST root-directory sector only. Later root sectors are
        ' untouched and the erased entries' cluster chains are NOT freed -- see
        ' debugZeroRootSector() for the full contract.
        bytefill(@buf, 0, SECTOR_SIZE)                                          ' Zero the buffer
        if writeSector(root_sec, BUF_DATA) == SUCCESS                           ' Write to root directory
          dir_sec_in_buf := -1                                                  ' Invalidate cache
          pb_status := SUCCESS
        else
          pb_status := E_IO_ERROR

      CMD_DEBUG_ERASE_BLOCK:
        ' DEBUG: Erase one erase-block-sized region starting at param0
        pb_status := do_erase_block(pb_param0)
#endif

#ifdef SD_INCLUDE_TEST_HOOKS
      CMD_TEST_INVAL_CACHES:
        ' TEST: see setTestInvalidateCaches() for the contract
        invalidateAllCaches()
        pb_status := SUCCESS
#endif

      CMD_READ_SECTOR_RAW:
        sec_in_buf := -1                                                        ' Force re-read
        pb_status := readSector(pb_param0, BUF_DATA)                            ' pass through the actual error code (E_TIMEOUT/E_BAD_RESPONSE/E_CRC_ERROR/E_IO_ERROR)
        if pb_status == SUCCESS
          bytemove(pb_param1, @buf, SECTOR_SIZE)

#ifdef SD_INCLUDE_RAW
      CMD_READ_SECTORS:
        pb_data0 := readSectors(pb_param0, pb_param1, pb_param2)
        pb_status := SUCCESS

      CMD_WRITE_SECTORS:
        pb_data0 := writeSectors(pb_param0, pb_param1, pb_param2)
        pb_status := SUCCESS

      CMD_WRITE_SECTOR_RAW:
        bytemove(@buf, pb_param1, SECTOR_SIZE)
        DEBUG[CH_SECTOR]("  [WRITE_RAW] after bytemove: buf[0..3]=$", uhex_byte_(buf[0]), " $", uhex_byte_(buf[1]), " $", uhex_byte_(buf[2]), " $", uhex_byte_(buf[3]), " sig=$", uhex_word_(WORD[@buf + BOOT_SIG_OFFSET]))
        pb_status := writeSector(pb_param0, BUF_DATA)                           ' pass through actual error code (E_TIMEOUT/E_WRITE_REJECTED/E_CARD_BUSY/E_IO_ERROR), mirrors CMD_READ_SECTOR_RAW

      CMD_INIT_CARD_ONLY:
        pb_status := do_init_card_only()

      CMD_GET_CARD_SIZE:
        pb_data0 := do_get_card_size()
        pb_status := SUCCESS

      CMD_TEST_CMD13:
        pb_data0 := do_test_cmd13()
        pb_status := SUCCESS
#endif

#ifdef SD_INCLUDE_SPEED
      CMD_ATTEMPT_HIGH_SPEED:
        pb_data0 := do_attempt_high_speed()
        pb_status := hs_query_error                     ' "card says no" is SUCCESS; "could not ask" is not

      CMD_CHECK_HS_CAPABILITY:
        pb_data0 := do_check_hs_capability()
        pb_status := hs_query_error

      CMD_SET_SPI_SPEED:
        ' A hand-set clock takes the card OUT of high-speed mode first. The CMD6
        ' switch is sticky at the card: dropping the host clock while the card
        ' stays on high-speed output timing strands the link and every following
        ' transfer fails with E_IO_ERROR until re-init. High speed is entered by
        ' attemptHighSpeed() and left by touching the clock -- a rule, not a
        ' frequency threshold, because a threshold is another literal to get wrong
        ' at the next sysclk. The clamp then measures against the default-mode
        ' ceiling, which is the mode the card is now actually in.
        if hs_mode_active
          applyDefaultSpeedMode()
        applySPISpeed(clampUserSpeed(pb_param0))
        pb_data0 := spi_freq
        pb_status := SUCCESS
#endif

#ifdef SD_INCLUDE_REGISTERS
      CMD_READ_SCR:
        pb_status := do_read_scr(pb_param0)

      CMD_READ_CID:
        pb_status := do_read_cid(pb_param0)

      CMD_READ_CSD:
        pb_status := do_read_csd(pb_param0)

      CMD_READ_SD_STATUS:
        pb_status := do_read_sd_status(pb_param0)
#endif

      ' Handle-Based File Commands
      CMD_OPEN_READ:
        pb_data0 := do_open_read(pb_param0)                                     ' Returns handle or error
        pb_status := pb_data0 < 0 ? pb_data0 : SUCCESS

      CMD_OPEN_WRITE:
        pb_data0 := do_open_write(pb_param0)                                    ' Returns handle or error
        pb_status := pb_data0 < 0 ? pb_data0 : SUCCESS

      CMD_CREATE:
        pb_data0 := do_create(pb_param0)                                        ' Returns handle or error
        pb_status := pb_data0 < 0 ? pb_data0 : SUCCESS

      CMD_CLOSE_H:
        pb_status := do_close_h(pb_param0)                                      ' param0 = handle

      CMD_READ_H:
        pb_data0 := do_read_h(pb_param0, pb_param1, pb_param2)                  ' handle, buffer, count -> bytes_read
        pb_status := pb_data0 < 0 ? pb_data0 : SUCCESS

      CMD_WRITE_H:
        pb_data0 := do_write_h(pb_param0, pb_param1, pb_param2)                 ' handle, buffer, count -> bytes_written
        pb_status := pb_data0 < 0 ? pb_data0 : SUCCESS

      CMD_SEEK_H:
        pb_status := do_seek_h(pb_param0, pb_param1)                            ' handle, position

      CMD_TELL_H:
        if validateHandle(pb_param0)
          if h_flags[pb_param0] & HF_DIR
            pb_status := E_NOT_A_DIR_HANDLE
          else
            pb_data0 := h_position[pb_param0]
            pb_status := SUCCESS
        else
          pb_status := E_INVALID_HANDLE

      CMD_FILESIZE_H:
        if validateHandle(pb_param0)
          if h_flags[pb_param0] & HF_DIR
            pb_status := E_NOT_A_DIR_HANDLE
          else
            pb_data0 := h_size[pb_param0]
            pb_status := SUCCESS
        else
          pb_status := E_INVALID_HANDLE

      CMD_SYNC_H:
        pb_status := do_sync_h(pb_param0)                                       ' handle

      CMD_SYNC_ALL:
        pb_status := do_sync_all()

      CMD_EOF_H:
        if validateHandle(pb_param0)
          if h_flags[pb_param0] & HF_DIR
            pb_status := E_NOT_A_DIR_HANDLE
          else
            pb_data0 := h_position[pb_param0] >= h_size[pb_param0] ? 1 : 0
            pb_status := SUCCESS
        else
          pb_status := E_INVALID_HANDLE

      ' Directory Handle Commands
      CMD_OPEN_DIR:
        pb_data0 := do_open_dir(pb_param0)                                      ' Returns handle or error
        pb_status := pb_data0 < 0 ? pb_data0 : SUCCESS

      CMD_READ_DIR_H:
        pb_status := do_read_dir_h(pb_param0)
        if pb_status == SUCCESS
          pb_data0 := @entry_buffer

      CMD_CLOSE_DIR_H:
        pb_status := do_close_dir_h(pb_param0)

      CMD_SET_VOL_LABEL:
        pb_status := do_set_vol_label(pb_param0)

#ifdef SD_INCLUDE_DEFRAG
      CMD_FILE_FRAGMENTS:
        pb_data0 := do_file_fragments(pb_param0)
        pb_status := pb_data0 < 0 ? pb_data0 : SUCCESS

      CMD_COMPACT_FILE:
        pb_status := do_compact_file(pb_param0)

      CMD_CREATE_CONTIGUOUS:
        pb_data0 := do_create_contiguous(pb_param0, pb_param1)
        pb_status := pb_data0 < 0 ? pb_data0 : SUCCESS
#endif

#ifdef SD_INCLUDE_STACK_CHECK
      CMD_STACK_DEPTH:
        ' Fold the live depth into the retained cross-session peak and report that --
        ' the meaning is "deepest this worker has EVER gone", not "deepest lately".
        stack_peak_longs #>= stackUtils.getStackDepth(@cog_stack, STACK_SIZE)
        pb_data0 := stack_peak_longs
        pb_status := SUCCESS
#endif

      other:
        DEBUG[CH_API]("  [fs_worker] Unknown command: ", udec_(cur_cmd))
        pb_status := E_BAD_RESPONSE

    ' Signal completion and reset idle timer. The flush arms only while a
    ' filesystem is mounted: unmounted (the caller was told the card is
    ' released) and RAW mode (nothing to flush, no FSInfo) must not schedule
    ' timer-driven I/O. Same predicate as do_idle_flush()'s backstop guard,
    ' which is pure defense-in-depth against arming paths that slip through.
    pb_cmd := CMD_NONE
    COGATN(1 << pb_caller)                                                      ' Wake the caller
    idle_timer := GETCT()
    flush_done := NOT (flags & F_MOUNTED)

PRI tick_clock()
' Advance the live clock by 2 seconds. Operates directly on the packed
' date_stamp LONG via FIELD pointers - no unpacking, no repacking.

  FIELD[fld_sec][0]++
  if FIELD[fld_sec][0] >= 30
    FIELD[fld_sec][0]~
    FIELD[fld_min][0]++
    if FIELD[fld_min][0] >= 60
      FIELD[fld_min][0]~
      FIELD[fld_hr][0]++
      if FIELD[fld_hr][0] >= 24
        FIELD[fld_hr][0]~
        FIELD[fld_day][0]++
        if FIELD[fld_day][0] > daysInMonth(FIELD[fld_yr][0] + FAT_EPOCH_YEAR, FIELD[fld_mon][0])
          FIELD[fld_day][0] := 1
          FIELD[fld_mon][0]++
          if FIELD[fld_mon][0] > 12
            FIELD[fld_mon][0] := 1
            FIELD[fld_yr][0]++

PRI daysInMonth(year, month) : days
' Return the number of days in the given month.
'
' @param year - Full year (e.g., 2026)
' @param month - Month (1-12)
' @returns days - Number of days in that month

  days := BYTE[@days_table][month - 1]
  if month == 2 AND isLeapYear(year)
    days := 29

PRI isLeapYear(year) : bLeapYear
' Check if year is a leap year.
'
' @param year - Full year (e.g., 2024)
' @returns bLeapYear - TRUE if leap year

  bLeapYear := (year & 3) == 0
  if year == 2100
    bLeapYear := false

PRI send_command(op_cmd, p0, p1, p2, p3) : status
' Send command to worker and wait - acquire lock, send command, wait for completion.
'
' @param op_cmd - Command opcode to send
' @param p0 - Parameter 0
' @param p1 - Parameter 1
' @param p2 - Parameter 2
' @param p3 - Parameter 3
' @returns status - Status code from worker
'
' WRITE-ON-EXIT: this is the choke point for ERROR() semantics. Every command that
' reaches the worker records its outcome in the calling cog's error slot on the way
' out -- SUCCESS as well as failure -- so ERROR() describes the most recent operation
' rather than the last failure since boot. See the note on ERROR() itself.

' Verify worker cog is running

  if cog_id == -1
    DEBUG[CH_API]("  [send_command] ERROR: Worker not running")
    pb_data0 := E_NOT_MOUNTED
    status := E_NOT_MOUNTED
#ifdef SD_INCLUDE_ASYNC
  elseif async_active AND async_caller == COGID()
    ' SAME-COG RE-ENTRY GUARD: this cog's own async operation holds api_lock, and
    ' P2 locks are not re-entrant -- the LOCKTRY loop below would spin forever on
    ' a lock this cog already owns. Answer E_ASYNC_BUSY instead of deadlocking;
    ' one choke point here covers every blocking API (readHandle, closeFileHandle,
    ' unmount, stop, ...). The mailbox is deliberately NOT touched: the in-flight
    ' operation's pb_status/pb_data0 must survive intact for getResult().
    DEBUG[CH_API]("  [send_command] Own async op in flight -- E_ASYNC_BUSY for cmd ", udec_(op_cmd))
    status := E_ASYNC_BUSY
#endif
  else
    ' Acquire API lock (serialize multi-cog access)
    repeat until LOCKTRY(api_lock)

    ' Store caller ID and parameters
    pb_caller := COGID()
    pb_param0 := p0
    pb_param1 := p1
    pb_param2 := p2
    pb_param3 := p3

    ' Issue command (triggers worker)
    pb_cmd := op_cmd

    ' Wait for completion using WAITATN (efficient sleep)
    WAITATN()

    ' Get result
    status := pb_status

    ' Check worker cog stack guard after every command. A violation means the worker
    ' cog has written past its stack into whatever follows, so nothing it just reported
    ' can be trusted -- INCLUDING a SUCCESS. It therefore overrides the command's own
    ' status rather than being noted alongside it, and it must land BEFORE the
    ' write-on-exit below or ERROR() would report the operation instead of the
    ' corruption. Until this was escalated it reached DEBUG only, and the driver ships
    ' with DEBUG_MASK = 0 -- worker memory corruption was detected after every single
    ' command and told to nobody.
    if NOT checkStackGuard()
      DEBUG[CH_API]("  [send_command] STACK OVERFLOW after cmd ", udec_(op_cmd))
      status := E_STACK_OVERFLOW

    ' Release lock
    LOCKREL(api_lock)

  ' Both exits land here -- record the outcome for ERROR() (write-on-exit)
  set_error(status)

CON ' ---- Handle Management ----

PRI allocateHandle() : handle | idx
' Find and allocate a free handle slot by searching the handle table.
' NOTE: Does not set h_flags - caller must do that after populating handle state.
'
' @returns handle - Handle index (0 to MAX_OPEN_FILES-1) on success, E_TOO_MANY_FILES if all in use

  handle := E_TOO_MANY_FILES                            ' Default: no free slots
  repeat idx from 0 TO MAX_OPEN_FILES - 1
    if h_flags[idx] == HF_FREE
      handle := idx
      quit                                              ' Found a free slot

PRI freeHandle(handle)
' Release a handle back to the free pool - clears all state and marks slot as available.
' Does NOT validate handle - caller must ensure handle is valid.
' Does NOT flush dirty buffers - caller must do that before calling.
'
' @param handle - Handle index to release

  h_flags[handle] := HF_FREE
  h_attr[handle] := 0
  h_dir_offset[handle] := 0
  h_position[handle] := 0
  h_sector[handle] := 0
  h_start_clus[handle] := 0
  h_size[handle] := 0
  h_dir_sector[handle] := 0
  h_cluster[handle] := 0
  h_buf_sector[handle] := -1                            ' Mark buffer as invalid
  h_error[handle] := SUCCESS                            ' Slot is reusable -- never hand a new file a stale error

PRI validateHandle(handle) : bValid
' Check if handle is valid and in use - fast guard function for handle operations.
'
' @param handle - Handle index to validate
' @returns bValid - TRUE if valid and in use, FALSE if invalid or free

  if handle < 0 OR handle >= MAX_OPEN_FILES
    bValid := FALSE
  elseif h_flags[handle] == HF_FREE
    bValid := FALSE
  else
    bValid := TRUE                                      ' Handle is valid and in use

PRI isFileOpenForWrite(dir_sector, dir_offset) : bOpenForWrite
' Check if file is already open for write - enforces single-writer policy.
' Multiple read handles allowed, only one write handle per file.
'
' @param dir_sector - Directory sector containing the file entry
' @param dir_offset - Offset within sector of the file entry
' @returns bOpenForWrite - TRUE if file is open for write, FALSE otherwise

  bOpenForWrite := handleReferencesEntry(dir_sector, dir_offset, HF_WRITE)

PRI isFileOpen(dir_sector, dir_offset) : bOpen
' Check if ANY open file handle (read or write) references the directory entry
' at (dir_sector, dir_offset). Used by do_delete: deleting a file that a handle
' still references lets a later flush write the handle's dirty buffer into
' freed -- possibly already reallocated -- clusters.
'
' @param dir_sector - Directory sector containing the file entry
' @param dir_offset - Offset within sector of the file entry
' @returns bOpen - TRUE if any file handle references the entry, FALSE otherwise

  bOpen := handleReferencesEntry(dir_sector, dir_offset, HF_READ | HF_WRITE)

PRI handleReferencesEntry(dir_sector, dir_offset, flag_mask) : bMatch | handle
' Core handle-table scan shared by the isFileOpen* predicates: does any handle
' whose flags intersect flag_mask reference the entry at (dir_sector, dir_offset)?
'
' CHOOSE THE MASK DELIBERATELY. h_dir_sector/h_dir_offset are only ever set by
' the file-open paths; do_open_dir() leaves them at their previous values, so a
' mask that admits HF_DIR handles (e.g. $FF) can match a recycled directory
' handle on STALE coordinates from its previous life. HF_READ|HF_WRITE is the
' safe mask when the caller means "a live file handle".
'
' @param dir_sector - Directory sector containing the file entry
' @param dir_offset - Offset within sector of the file entry
' @param flag_mask - h_flags bits that qualify a handle for the match
' @returns bMatch - TRUE if a qualifying handle references the entry
' @local handle - Loop variable for handle search

  bMatch := FALSE
  repeat handle from 0 TO MAX_OPEN_FILES - 1
    if h_flags[handle] & flag_mask
      if h_dir_sector[handle] == dir_sector AND h_dir_offset[handle] == dir_offset
        bMatch := TRUE
        quit

PRI getHandleBuffer(handle) : p_buffer
' Get pointer to handle's data buffer - each handle has a dedicated 512-byte buffer.
' Does NOT validate handle - caller must do that first.
'
' @param handle - Handle index
' @returns p_buffer - Address of the 512-byte buffer for this handle

  p_buffer := @h_buf + (handle << SECTOR_SHIFT)         ' handle * 512

PRI initHandleTable() | idx
' Initialize all handles to free state - called during mount() for clean state.
' Releases all handles and invalidates all buffer cache tracking.
'
' @local idx - Loop variable

  repeat idx from 0 TO MAX_OPEN_FILES - 1
    freeHandle(idx)

CON ' ---- Struct Accessors ----

PRI partType(^mbr_partition_t pPart) : value
' Get partition type code from MBR partition entry.
'
' @param pPart - Pointer to MBR partition entry
' @returns value - Partition type code ($0B/$0C = FAT32)

  value := pPart.partType

PRI partLbaStart(^mbr_partition_t pPart) : value
' Get LBA start sector from MBR partition entry.
'
' @param pPart - Pointer to MBR partition entry
' @returns value - First sector of partition (LBA)

  value := pPart.lbaStart

PRI vbrBytesPerSec(^vbr_t pVBR) : value
' Get bytes per sector from VBR.
'
' @param pVBR - Pointer to Volume Boot Record
' @returns value - Bytes per sector (must be 512)

  value := pVBR.bytesPerSec

PRI vbrSecPerClus(^vbr_t pVBR) : value
' Get sectors per cluster from VBR.
'
' @param pVBR - Pointer to Volume Boot Record
' @returns value - Sectors per cluster (power of 2)

  value := pVBR.secPerClus

PRI vbrReservedSec(^vbr_t pVBR) : value
' Get reserved sector count from VBR.
'
' @param pVBR - Pointer to Volume Boot Record
' @returns value - Number of reserved sectors before FAT

  value := pVBR.reservedSec

PRI vbrNumFats(^vbr_t pVBR) : value
' Get number of FATs from VBR.
'
' @param pVBR - Pointer to Volume Boot Record
' @returns value - Number of FAT copies (typically 2)

  value := pVBR.numFats

PRI vbrSecPerFat32(^vbr_t pVBR) : value
' Get sectors per FAT from VBR.
'
' @param pVBR - Pointer to Volume Boot Record
' @returns value - Number of sectors per FAT

  value := pVBR.secPerFat32

PRI vbrFsInfoSec(^vbr_t pVBR) : value
' Get FSInfo sector offset from VBR.
'
' @param pVBR - Pointer to Volume Boot Record
' @returns value - FSInfo sector number (relative to VBR)

  value := pVBR.fsInfoSec

PRI vbrVolLabelAddr(^vbr_t pVBR) : addr
' Get address of volume label field in VBR.
'
' @param pVBR - Pointer to Volume Boot Record
' @returns addr - Hub address of 11-byte volume label field

  addr := @pVBR.volLabel

PRI fsiLeadSig(^fsinfo_t pFSI) : value
' Get FSInfo lead signature.
'
' @param pFSI - Pointer to FSInfo sector
' @returns value - Lead signature (must be $41615252)

  value := pFSI.leadSig

PRI fsiStructSig(^fsinfo_t pFSI) : value
' Get FSInfo struct signature.
'
' @param pFSI - Pointer to FSInfo sector
' @returns value - Struct signature (must be $61417272)

  value := pFSI.structSig

PRI fsiFreeClusters(^fsinfo_t pFSI) : value
' Get free cluster count from FSInfo.
'
' @param pFSI - Pointer to FSInfo sector
' @returns value - Number of free clusters ($FFFFFFFF if unknown)

  value := pFSI.freeClusters

PRI fsiNextFreeHint(^fsinfo_t pFSI) : value
' Get next free cluster hint from FSInfo.
'
' @param pFSI - Pointer to FSInfo sector
' @returns value - Suggested starting cluster for free space search

  value := pFSI.nextFreeHint

PRI fsiSetFreeClusters(^fsinfo_t pFSI, value)
' Set free cluster count in FSInfo.
'
' @param pFSI - Pointer to FSInfo sector
' @param value - New free cluster count

  pFSI.freeClusters := value

PRI fsiSetNextFreeHint(^fsinfo_t pFSI, value)
' Set next free cluster hint in FSInfo.
'
' @param pFSI - Pointer to FSInfo sector
' @param value - New next-free cluster hint

  pFSI.nextFreeHint := value

PRI dirEntAttr(^dir_entry_t pEntry) : value
' Get attribute byte from directory entry.
'
' @param pEntry - Pointer to directory entry
' @returns value - FAT attribute byte ($10=dir, $20=archive, $08=volume label)

  value := pEntry.attr

PRI dirEntStartClus(^dir_entry_t pEntry) : value
' Get start cluster from directory entry (combines high and low words).
'
' @param pEntry - Pointer to directory entry
' @returns value - 32-bit start cluster number

  value := pEntry.clusHI << 16 | pEntry.clusLO

PRI dirEntFileSize(^dir_entry_t pEntry) : value
' Get file size from directory entry.
'
' @param pEntry - Pointer to directory entry
' @returns value - File size in bytes

  value := pEntry.fileSize

PRI dirEntSetAttr(^dir_entry_t pEntry, value)
' Set attribute byte in directory entry.
'
' @param pEntry - Pointer to directory entry
' @param value - Attribute byte to set

  pEntry.attr := value

PRI dirEntSetStartClus(^dir_entry_t pEntry, value)
' Set start cluster in directory entry (splits into high and low words).
'
' @param pEntry - Pointer to directory entry
' @param value - 32-bit cluster number to set

  pEntry.clusHI := value >> 16
  pEntry.clusLO := value & $FFFF

PRI dirEntSetFileSize(^dir_entry_t pEntry, value)
' Set file size in directory entry.
'
' @param pEntry - Pointer to directory entry
' @param value - File size in bytes

  pEntry.fileSize := value

PRI dirEntSetCreateStamp(^dir_entry_t pEntry, stamp)
' Set creation timestamp in directory entry.
'
' @param pEntry - Pointer to directory entry
' @param stamp - Combined date/time stamp (date in upper 16, time in lower 16)

  pEntry.crtTime := stamp & $FFFF
  pEntry.crtDate := stamp >> 16

PRI dirEntSetModifyStamp(^dir_entry_t pEntry, stamp)
' Set modification timestamp in directory entry.
'
' @param pEntry - Pointer to directory entry
' @param stamp - Combined date/time stamp (date in upper 16, time in lower 16)

  pEntry.wrtTime := stamp & $FFFF
  pEntry.wrtDate := stamp >> 16

CON ' ---- SD Worker Operations ----

PRI do_mount() : status | reserved, pPart, pVBR, pFSI, idx, p_entry, cluster, sector, sec_idx, next_cluster, found
' Internal mount operation - initializes card and reads filesystem structures.
'
' @returns status - SUCCESS on success, error code on failure
' @local reserved - Reserved sector count from VBR
' @local pPart - Pointer to MBR partition entry
' @local pVBR - Pointer to Volume Boot Record overlay
' @local pFSI - Pointer to FSInfo sector overlay
' @local idx - Loop counter
' @local p_entry - Pointer to directory entry
' @local cluster - Current cluster number
' @local sector - Current sector number
' @local sec_idx - Sector index within cluster
' @local next_cluster - Next cluster in FAT chain
' @local found - Search result flag

  dir_sec_in_buf := -1
  fat_sec_in_buf := -1
  sec_in_buf := -1

  ' Initialize handle table to clean state
  initHandleTable()

  ' Skip card init if already in RAW mode (card already initialized)
  ' This avoids reinitializing smart pins which would corrupt pin states
  if driver_mode == MODE_RAW
    DEBUG[CH_MOUNT]("  [do_mount] Upgrading from RAW mode - skipping initCard()")
  else
    DEBUG[CH_MOUNT]("  [do_mount] Calling initCard()...")
    if NOT initCard()
      DEBUG[CH_MOUNT]("  [do_mount] FAIL: initCard() returned false")
      status := last_init_error

  ' Card is initialized (either fresh or from RAW mode)
  if status == 0
    DEBUG[CH_MOUNT]("  [do_mount] Reading MBR sector 0...")
    if readSector(0, BUF_DATA) < 0                                                               '  read master boot record
      DEBUG[CH_MOUNT]("  [do_mount] FAIL: MBR read error")
      status := E_IO_ERROR
    else
      pPart := @buf + MBR_PARTITION_OFFSET                                                       '  overlay partition entry 1
      DEBUG[CH_MOUNT]("  [do_mount] MBR type code: ", uhex_(partType(pPart)))
      if partType(pPart) == PART_TYPE_FAT32_LBA28 OR partType(pPart) == PART_TYPE_FAT32_LBA      '  FAT32 partition types
        vbr_sec := partLbaStart(pPart)                                                           '  volume boot record sector number
        DEBUG[CH_MOUNT]("  [do_mount] FAT32 detected, VBR at sector ", udec(vbr_sec))
        if readSector(vbr_sec, BUF_DATA) < 0                                                     '  read volume boot record
          DEBUG[CH_MOUNT]("  [do_mount] FAIL: VBR read error")
          status := E_IO_ERROR
      else
        DEBUG[CH_MOUNT]("  [do_mount] FAIL: Not FAT32 (type=", uhex_(partType(pPart)), ")")
        status := E_NOT_FAT32

  if status == 0
    pVBR := @buf                                                                                 '  overlay VBR
    DEBUG[CH_MOUNT]("  [do_mount] Bytes/sector: ", udec(vbrBytesPerSec(pVBR)))
    if vbrBytesPerSec(pVBR) <> SECTOR_SIZE
      DEBUG[CH_MOUNT]("  [do_mount] FAIL: Bytes/sector not 512")
      status := E_BAD_SECTOR_SIZE
    else
      sec_per_clus := vbrSecPerClus(pVBR)
      DEBUG[CH_MOUNT]("  [do_mount] Sectors/cluster: ", udec(sec_per_clus))
      ' 0 passes the power-of-two test (0 & -1 == 0) but reaches the
      ' '// sec_per_clus' below -- divide-by-zero HANGS the worker cog on a
      ' corrupted card. Reject it here so the mount fails instead.
      if sec_per_clus == 0 OR (sec_per_clus & (sec_per_clus - 1))
        DEBUG[CH_MOUNT]("  [do_mount] FAIL: sec_per_clus not a nonzero power of 2")
        status := E_NOT_FAT32
      else
        reserved := vbrReservedSec(pVBR)
        DEBUG[CH_MOUNT]("  [do_mount] Reserved sectors: ", udec(reserved))
        DEBUG[CH_MOUNT]("  [do_mount] Number of FATs: ", udec(vbrNumFats(pVBR)))
        if vbrNumFats(pVBR) <> 2
          DEBUG[CH_MOUNT]("  [do_mount] FAIL: FAT count not 2")
          status := E_NOT_FAT32
        else
          sec_per_fat := vbrSecPerFat32(pVBR)
          fsinfo_sec := vbrFsInfoSec(pVBR)
          fat_sec := vbr_sec + reserved
          fat2_sec := fat_sec + sec_per_fat
          root_sec := (fat_sec + 2 * sec_per_fat)
          longfill(@cog_dir_sec, root_sec, 8)                                                    ' All cogs start at root
          idle_flush_clocks := clkfreq / 1000 * IDLE_FLUSH_MS                                    ' Auto-flush threshold
          ct_tick_clocks := clkfreq * 2                                                          ' 2-second clock tick interval
          cluster_offset := root_sec // sec_per_clus
          bytemove(@vol_label, vbrVolLabelAddr(pVBR), SFN_TOTAL_LEN)
          vol_label[11] := 0
          DEBUG[CH_MOUNT]("  [do_mount] VBR volume label: ", zstr(@vol_label))

          ' Check root directory for authoritative volume label entry (ATTR_VOLUME_ID)
          ' The root directory entry is the primary source per the FAT32 spec;
          ' the VBR copy is a fallback (Windows format may write "NO NAME" to VBR).
          ' Follow the root cluster chain so we find the label even if it's not in the first sector.
          cluster := ROOT_CLUSTER
          found := false
          repeat while cluster >= ROOT_CLUSTER AND cluster +< FAT32_EOC_MIN AND NOT found
            sector := clus2sec(cluster)
            repeat sec_idx from 0 TO sec_per_clus - 1
              if readSector(sector + sec_idx, BUF_DIR) < 0
                DEBUG[CH_MOUNT]("  [do_mount] Root dir read failed, using VBR label")
                found := true
                quit
              repeat idx from 0 TO DIR_ENTRIES_PER_SECTOR - 1
                p_entry := @dir_buf + (idx * DIR_ENTRY_SIZE)
                if BYTE[p_entry] == $00                                                          '  end of directory
                  found := true
                  quit
                if BYTE[p_entry] <> DIR_ENTRY_DELETED AND dirEntAttr(p_entry) == ATTR_VOLUME_ID  '  volume label entry
                  bytemove(@vol_label, p_entry, SFN_TOTAL_LEN)
                  vol_label[11] := 0
                  DEBUG[CH_MOUNT]("  [do_mount] Root dir volume label: ", zstr(@vol_label))
                  found := true
                  quit
              if found
                quit
            ' Follow FAT chain to next cluster
            if NOT found
              if readSector(cluster >> 7 + fat_sec, BUF_FAT) < 0
                quit
              ' FAT32: top 4 bits reserved -- mask to the 28-bit cluster number
              next_cluster := LONG[@fat_buf + ((cluster << 2) & SECTOR_OFFSET_MASK)] & FAT32_ENTRY_MASK
              cluster := next_cluster

          ' Read FSInfo sector for free cluster count and next-free hint
          if fsinfo_sec > 0 AND fsinfo_sec < reserved
            if readSector(vbr_sec + fsinfo_sec, BUF_DATA) < 0
              DEBUG[CH_MOUNT]("  [do_mount] FSInfo read failed, continuing without free count")
              fsi_free_count := $FFFF_FFFF
              fsi_nxt_free := $FFFF_FFFF
            else
              pFSI := @buf                                                                       '  overlay FSInfo
              if fsiLeadSig(pFSI) == FSINFO_LEAD_SIG AND fsiStructSig(pFSI) == FSINFO_STRUCT_SIG
                fsi_free_count := fsiFreeClusters(pFSI)
                fsi_nxt_free := fsiNextFreeHint(pFSI)
                DEBUG[CH_MOUNT]("  [do_mount] FSInfo: free_count=", udec(fsi_free_count), " nxt_free=", udec(fsi_nxt_free))
              else
                fsi_free_count := $FFFF_FFFF
                fsi_nxt_free := $FFFF_FFFF
                DEBUG[CH_MOUNT]("  [do_mount] FSInfo: invalid signatures, ignoring")
          else
            fsi_free_count := $FFFF_FFFF
            fsi_nxt_free := $FFFF_FFFF
            DEBUG[CH_MOUNT]("  [do_mount] FSInfo: sector not present")

          DEBUG[CH_MOUNT]("  [do_mount] SUCCESS")
          if date_stamp == 0
            setdate(2009,01,27,07,00,00)
          flags |= F_MOUNTED

          driver_mode := MODE_FILESYSTEM
          DEBUG[CH_MOUNT]("  [do_mount] SUCCESS, mode=FILESYSTEM")
          if card_warning_flags & CW_CMD13_UNRELIABLE
            DEBUG[CH_MOUNT]("  [do_mount] WARNING: CMD13 unreliable on this card - status checks disabled")

PRI do_unmount() : status | sync_status, close_status
' Internal unmount operation - syncs all handles and updates FSInfo.
'
' Continues through the full unmount sequence even when an earlier step fails,
' so as much state as possible reaches disk; the first error encountered is
' the value returned.
'
' @returns status - SUCCESS on clean unmount; first non-SUCCESS encountered
'                   among (do_sync_all, do_close, updateFSInfo) otherwise.
'                   An FSInfo failure reports its own reason (E_IO_ERROR or
'                   E_BAD_FSINFO); a card with no FSInfo is not a failure.

' Sync all open handles before unmount

  status := SUCCESS

  sync_status := do_sync_all()
  if sync_status < 0
    status := sync_status

  close_status := do_close()
  if close_status < 0 AND status == SUCCESS
    status := close_status

  ' updateFSInfo() returns FALSE for "nothing to update" as well as for a real
  ' failure; fsinfo_error is what tells them apart, so no precondition gate is
  ' needed here. A card without FSInfo leaves fsinfo_error at SUCCESS.
  updateFSInfo()
  if fsinfo_error < 0 AND status == SUCCESS
    status := fsinfo_error

#ifdef SD_INCLUDE_SPEED
  ' Leave the card in the mode we found it in. The CMD6 high-speed switch is
  ' sticky at the CARD -- it does not follow our host clock down and it does not
  ' end when we let go -- so a card unmounted in high-speed mode is handed to
  ' whoever comes next in a mode they never asked for. This is the last moment
  ' we still own it. (Guarded: applyDefaultSpeedMode is [SD_INCLUDE_SPEED] code,
  ' and hs_mode_active can only be TRUE in such a build.)
  if hs_mode_active
    applyDefaultSpeedMode()
#endif

  ' From this moment the card belongs to the user (may be pulled or swapped).
  ' No cache may keep describing it: a stale tag surviving into the next
  ' initCardOnly()/mount() window could serve the OLD card's bytes as a cache
  ' hit on the new one. Handle-buffer tags are cleared for the same reason --
  ' every dirty buffer already reached disk (or was reported) via do_sync_all().
  dir_sec_in_buf := -1
  fat_sec_in_buf := -1
  sec_in_buf := -1
  longfill(@h_buf_sector, -1, MAX_OPEN_FILES)

  flags := flags & !F_MOUNTED
  driver_mode := MODE_NONE
  DEBUG[CH_MOUNT]("  [do_unmount] Card unmounted, mode=NONE, status=", sdec_(status))

PRI do_open(name_ptr) : status | search_result
' Internal open file operation - finds existing file in directory.
' Used internally by do_movefile to locate source file.
'
' @param name_ptr - Pointer to null-terminated filename string
' @returns status - SUCCESS on success, E_FILE_NOT_FOUND on failure
' @local search_result - Result from searchDirectory

  do_close()
  search_result := searchDirectory(name_ptr)
  if search_result AND (attributes() & (ATTR_HIDDEN | ATTR_SYSTEM | ATTR_VOLUME_ID | ATTR_DIRECTORY) == 0)
    status := SUCCESS
  elseif search_io_status < 0
    status := search_io_status                          ' The directory could not be read -- not "no such file"
  else
    status := E_FILE_NOT_FOUND

PRI do_close() : status
' Internal close operation - flush pending directory entry to disk.
' Used internally by do_movefile, do_delete, do_chdir, and do_unmount.
'
' @returns status - SUCCESS (0) on success, E_IO_ERROR on write failure

  status := SUCCESS

  ' Update directory entry on disk if modified
  if flags & F_NEWDIR
    if readSector(entry_address >> SECTOR_SHIFT, BUF_DIR) < 0
      DEBUG[CH_FILE]("  [do_close] Directory read FAILED for sector ", udec_(entry_address >> SECTOR_SHIFT))
      status := E_IO_ERROR
    else
      bytemove(@dir_buf + (entry_address & SECTOR_OFFSET_MASK), @entry_buffer, DIR_ENTRY_SIZE)
      if writeSector(entry_address >> SECTOR_SHIFT, BUF_DIR) < 0
        DEBUG[CH_FILE]("  [do_close] Directory write FAILED for sector ", udec_(entry_address >> SECTOR_SHIFT))
        status := E_IO_ERROR

  abandonPendingEntry()

PRI abandonPendingEntry()
' Discard the staged directory entry as ONE unit: entry_buffer and F_NEWDIR
' must always clear together. A cleared flag with a live buffer is harmless;
' a set flag with a stale or foreign buffer is the ghost-entry corruption the
' do_movefile abandon paths exist to prevent (v1.7.0 task #50). Every exit that
' leaves a staged entry unwritten goes through here -- this helper is what
' makes do_sync's "F_NEWDIR cannot be pending at a command boundary" claim
' structural rather than a by-hand enumeration of clearing sites.

  bytefill(@entry_buffer, 0, DIR_ENTRY_SIZE)
  flags := flags & !F_NEWDIR

PRI do_open_read(p_path) : handle | start_cluster
' Open file for reading - opens existing file and returns handle.
' Multiple files can be open simultaneously for reading.
' Each handle has its own position, enabling interleaved reads.
'
' @param p_path - Pointer to null-terminated path string
' @returns handle - Handle (0 to MAX_OPEN_FILES-1) on success, negative error code on failure
' @local start_cluster - Starting cluster of the file

' Allocate a handle slot

  handle := allocateHandle()
  if handle < 0
    DEBUG[CH_FILE]("  [do_open_read] No free handles")
  elseif NOT searchDirectory(p_path)
    ' Search for the file
    DEBUG[CH_FILE]("  [do_open_read] File not found: ", zstr_(p_path))
    freeHandle(handle)
    handle := (search_io_status < 0) ? search_io_status : E_FILE_NOT_FOUND
  elseif attributes() & ATTR_DIRECTORY                  ' Directory bit
    ' Verify it's a file, not a directory
    DEBUG[CH_FILE]("  [do_open_read] Path is a directory, not a file")
    freeHandle(handle)
    handle := E_NOT_A_FILE
  else
    ' Populate handle state from directory entry
    start_cluster := firstCluster()
    h_start_clus[handle] := start_cluster
    h_size[handle] := fileSize()
    h_attr[handle] := attributes()
    h_dir_sector[handle] := entry_address >> SECTOR_SHIFT
    h_dir_offset[handle] := entry_address & SECTOR_OFFSET_MASK
    h_cluster[handle] := start_cluster
    ' Cluster-0 symmetry with do_open_write: for a PC-written empty file
    ' (size 0) reads short-circuit at EOF and never touch this sector; keep
    ' it a harmless 0 rather than a fabricated below-root address. A corrupt
    ' entry (cluster < 2, size > 0) reads garbage either way -- unchanged
    ' failure class, not made worse.
    h_sector[handle] := (start_cluster < ROOT_CLUSTER) ? 0 : clus2sec(start_cluster)
    h_position[handle] := 0
    h_buf_sector[handle] := -1                          ' No sector cached yet
    h_flags[handle] := HF_READ
    DEBUG[CH_FILE]("  [do_open_read] Success: handle=", udec_(handle), " size=", udec_(h_size[handle]), " cluster=", udec_(start_cluster))

PRI do_open_write(p_path) : handle | start_cluster, current_cluster, fat_addr, file_size, cluster_count
' Open file for writing/append - opens existing file for appending.
' Enforces single-writer policy: only one write handle per file allowed.
' Position is set to end of file for appending.
'
' @param p_path - Pointer to null-terminated path string
' @returns handle - Handle (0 to MAX_OPEN_FILES-1) on success, negative error code on failure
' @local start_cluster - Starting cluster of the file
' @local current_cluster - Current cluster during FAT chain walk
' @local fat_addr - Address of FAT entry
' @local file_size - Size of file in bytes
' @local cluster_count - Number of clusters to walk

' Allocate a handle slot

  handle := allocateHandle()
  if handle < 0
    DEBUG[CH_FILE]("  [do_open_write] No free handles")
  elseif NOT searchDirectory(p_path)
    ' Search for the file
    DEBUG[CH_FILE]("  [do_open_write] File not found: ", zstr_(p_path))
    freeHandle(handle)
    handle := (search_io_status < 0) ? search_io_status : E_FILE_NOT_FOUND
  elseif attributes() & ATTR_DIRECTORY                  ' Directory bit
    ' Verify it's a file, not a directory
    DEBUG[CH_FILE]("  [do_open_write] Path is a directory, not a file")
    freeHandle(handle)
    handle := E_NOT_A_FILE
  elseif isFileOpenForWrite(entry_address >> SECTOR_SHIFT, entry_address & SECTOR_OFFSET_MASK)
    ' Check single-writer policy
    DEBUG[CH_FILE]("  [do_open_write] File already open for write")
    freeHandle(handle)
    handle := E_FILE_ALREADY_OPEN
  else
    ' Populate handle state from directory entry
    start_cluster := firstCluster()
    file_size := fileSize()
    h_start_clus[handle] := start_cluster
    h_size[handle] := file_size
    h_attr[handle] := attributes()
    h_dir_sector[handle] := entry_address >> SECTOR_SHIFT
    h_dir_offset[handle] := entry_address & SECTOR_OFFSET_MASK

    ' Position at end of file for append mode
    ' Walk FAT chain to find the last cluster
    h_position[handle] := file_size
    if file_size > 0
      ' Calculate which cluster contains the last byte
      cluster_count := (file_size - 1) / (sec_per_clus << SECTOR_SHIFT)
      current_cluster := start_cluster
      repeat cluster_count
        fat_addr := readFat(current_cluster)
        if fat_io_status < 0                            ' Stale link -- appending at a position derived from
          DEBUG[CH_FILE]("  [do_open_write] FAT read FAILED at cluster ", udec_(current_cluster))
          freeHandle(handle)                            '  a garbage chain would write into another file
          return E_IO_ERROR
        current_cluster := LONG[fat_addr] & FAT32_ENTRY_MASK  ' top 4 bits reserved -- 28-bit cluster number
        if current_cluster +>= FAT32_EOC_MIN            ' End of chain - shouldn't happen
          quit
      h_cluster[handle] := current_cluster
      h_sector[handle] := clus2sec(current_cluster) + ((file_size - 1) >> SECTOR_SHIFT) & (sec_per_clus - 1)
    else
      ' Empty file (size 0) - position at start. A PC-written empty file
      ' carries start cluster 0; clus2sec(0) lands BELOW root_sec and
      ' previously tripped the write path's metadata backstop, making the
      ' file permanently unappendable. Sector 0 is a safe sentinel: nothing
      ' reads it before the first write (flush is gated on HF_DIRTY, seek
      ' fast-paths on a size-0 file, read short-circuits at EOF), and
      ' do_write_h lazily allocates the real first cluster on that write.
      h_cluster[handle] := start_cluster
      h_sector[handle] := (start_cluster < ROOT_CLUSTER) ? 0 : clus2sec(start_cluster)

    h_buf_sector[handle] := -1                          ' No sector cached yet
    h_flags[handle] := HF_WRITE
    DEBUG[CH_FILE]("  [do_open_write] Success: handle=", udec_(handle), " size=", udec_(file_size), " pos=", udec_(h_position[handle]))

PRI do_create(p_path) : handle | temp, first_cluster
' Create new file - creates empty file and opens for writing.
' If file already exists, returns error.
' Allocation failures propagate the allocator's true code (E_DISK_FULL or
' E_IO_ERROR), matching do_newdir/do_newfile -- a failed FAT write must not
' masquerade as a full disk.
'
' @param p_path - Pointer to null-terminated path string
' @returns handle - Handle (0 to MAX_OPEN_FILES-1) on success, negative error code on failure
' @local temp - Temporary calculation variable
' @local first_cluster - First cluster allocated for the new file

' Allocate a handle slot

  handle := allocateHandle()
  if handle < 0
    DEBUG[CH_FILE]("  [do_create] No free handles")
  elseif searchDirectory(p_path)
    ' Check if file already exists
    DEBUG[CH_FILE]("  [do_create] File already exists: ", zstr_(p_path))
    freeHandle(handle)
    handle := E_FILE_EXISTS
  elseif search_io_status < 0
    ' FAIL CLOSED. The existence check could not be completed, so "not found" is not
    ' an answer -- creating here would add a second entry and a second cluster chain
    ' for a name that may already exist.
    DEBUG[CH_FILE]("  [do_create] Existence check FAILED, refusing to create: ", zstr_(p_path))
    freeHandle(handle)
    handle := search_io_status
  elseif entry_address == 0
    ' Guard: entry_address 0 means searchDirectory never found a valid directory
    DEBUG[CH_FILE]("  [do_create] entry_address=0 -- path not valid, aborting")
    freeHandle(handle)
    handle := E_FILE_NOT_FOUND
  else
    ' searchDirectory() sets entry_address to first free directory entry
    ' Check if we need to allocate a new cluster for the directory
    temp := (entry_address + cluster_offset << SECTOR_SHIFT) & (sec_per_clus << SECTOR_SHIFT - 1)
    if temp == (sec_per_clus << SECTOR_SHIFT - DIR_ENTRY_SIZE)
      if dir_buf[LAST_DIR_ENTRY_OFFSET] == $00          ' End of directory
        temp := allocateCluster(byte2clus(entry_address))
        if temp < 0
          DEBUG[CH_FILE]("  [do_create] Failed to allocate dir cluster")
          freeHandle(handle)
          handle := temp                                ' allocator's true code -- E_DISK_FULL or E_IO_ERROR
        elseif clearCluster(temp) < 0
          DEBUG[CH_FILE]("  [do_create] Failed to clear new dir cluster")
          freeHandle(handle)
          handle := E_IO_ERROR

    ' Allocate first cluster for the new file (if no error yet)
    if handle >= 0
      first_cluster := allocateCluster(0)
      if first_cluster < 0
        DEBUG[CH_FILE]("  [do_create] Failed to allocate file cluster")
        freeHandle(handle)
        handle := first_cluster                         ' allocator's true code -- E_DISK_FULL or E_IO_ERROR

    if handle >= 0
      ' Set up directory entry in entry_buffer
      dirEntSetAttr(@entry_buffer, ATTR_ARCHIVE)        ' Archive attribute
      dirEntSetCreateStamp(@entry_buffer, date_stamp)
      dirEntSetStartClus(@entry_buffer, first_cluster)
      dirEntSetModifyStamp(@entry_buffer, date_stamp)
      dirEntSetFileSize(@entry_buffer, 0)

      ' Write directory entry to disk
      if readSector(entry_address >> SECTOR_SHIFT, BUF_DIR) < 0
        DEBUG[CH_FILE]("  [do_create] Directory read FAILED for sector ", udec_(entry_address >> SECTOR_SHIFT))
        freeHandle(handle)
        handle := E_IO_ERROR
      else
        bytemove(@dir_buf + (entry_address & SECTOR_OFFSET_MASK), @entry_buffer, DIR_ENTRY_SIZE)
        if writeSector(entry_address >> SECTOR_SHIFT, BUF_DIR) < 0
          DEBUG[CH_FILE]("  [do_create] Directory write FAILED for sector ", udec_(entry_address >> SECTOR_SHIFT))
          freeHandle(handle)
          handle := E_IO_ERROR
        else
          ' Populate handle state
          h_start_clus[handle] := first_cluster
          h_size[handle] := 0
          h_attr[handle] := ATTR_ARCHIVE
          h_dir_sector[handle] := entry_address >> SECTOR_SHIFT
          h_dir_offset[handle] := entry_address & SECTOR_OFFSET_MASK
          h_cluster[handle] := first_cluster
          h_sector[handle] := clus2sec(first_cluster)
          h_position[handle] := 0
          h_buf_sector[handle] := -1                    ' No sector cached yet
          h_flags[handle] := HF_WRITE
          DEBUG[CH_FILE]("  [do_create] Success: handle=", udec_(handle), " cluster=", udec_(first_cluster))

PRI do_close_h(handle) : status
' Close file handle - closes handle, flushing writes and updating directory.
' For write handles, the directory entry is updated with the final file size.
'
' @param handle - Handle to close
' @returns status - SUCCESS (0) on success, E_INVALID_HANDLE on failure

' Validate handle

  if NOT validateHandle(handle)
    DEBUG[CH_FILE]("  [do_close_h] Invalid handle: ", sdec_(handle))
    status := E_INVALID_HANDLE
  elseif h_flags[handle] & HF_DIR
    status := E_NOT_A_DIR_HANDLE
  else
    ' Close IS "sync, then free": the data flush, the publish gate (no size
    ' update over unlanded bytes), and the directory update are exactly
    ' do_sync_h's -- one copy means close can never drift from sync.
    status := do_sync_h(handle)

#ifdef SD_INCLUDE_DEFRAG
    ' Clear pre-allocation tracking
    h_prealloc_end[handle] := 0
#endif
    ' Free the handle
    freeHandle(handle)

PRI do_read_h(handle, p_buffer, count) : bytes_read | p_hbuf, available, offset, to_read, cluster, fat_addr, next_cluster
' Handle-based read - reads data from file handle into user buffer.
' Uses per-handle buffer to avoid cache thrashing. Independent position per handle.
'
' A SHORT COUNT IS NOT SELF-EXPLANATORY. Every path below that stops early after some
' bytes moved returns the bytes transferred so far -- a positive number, indistinguishable
' from a genuine EOF by the return value alone. h_error[handle] carries which it was:
' SUCCESS on entry, and the specific code at each stopping point. Public readers get it
' from handleError().
'
' ZERO IS DIFFERENT, AND IS RESERVED FOR END OF FILE. When a stopping point is reached
' before any byte moved, the exit guard at the tail of this method returns h_error rather
' than a zero, because zero is the value every read loop is written to stop on.
'
' @param handle - Valid read handle
' @param p_buffer - Pointer to destination buffer
' @param count - Number of bytes to read
' @returns bytes_read - Bytes actually read; 0 ONLY at a genuine end of file; negative on
'                       error (see handleError() for why a positive count came up short)
' @local p_hbuf - Pointer to handle's buffer
' @local available - Bytes available to read
' @local offset - Offset within current sector
' @local to_read - Bytes to read from current sector
' @local cluster - Current cluster number
' @local fat_addr - Address of FAT entry
' @local next_cluster - Next cluster in chain

' Validate handle

  if NOT validateHandle(handle)
    DEBUG[CH_FILE]("  [do_read_h] Invalid handle: ", sdec_(handle))
    bytes_read := E_INVALID_HANDLE
  elseif h_flags[handle] & HF_DIR
    bytes_read := E_NOT_A_DIR_HANDLE
    h_error[handle] := E_NOT_A_DIR_HANDLE
  elseif h_size[handle] - h_position[handle] <= 0
    ' Calculate how many bytes we can actually read
    DEBUG[CH_FILE]("  [do_read_h] EOF reached")
    bytes_read := 0                                     ' EOF
    h_error[handle] := SUCCESS                          ' A genuine EOF is a clean stop, and must read as one
  else
    h_error[handle] := SUCCESS                          ' Write-on-exit: overwritten below if we stop early
    available := h_size[handle] - h_position[handle]
    count := count <# available                         ' Cap at available bytes
    DEBUG[CH_FILE]("  [do_read_h] handle=", udec_(handle), " pos=", udec_(h_position[handle]), " count=", udec_(count))

    ' Get pointer to handle's buffer
    p_hbuf := getHandleBuffer(handle)

    ' Advance past sector boundary left by previous read that ended exactly at 512-byte boundary.
    ' Without this, the next read returns stale data from the previous sector's buffer.
    if (h_position[handle] & SECTOR_OFFSET_MASK) == 0 AND h_position[handle] > 0 AND h_buf_sector[handle] == h_sector[handle]
      ' Read-after-write at a sector boundary: a dirty buffer must reach the
      ' card before its identity is discarded (reads on write handles are
      ' legal). On a failed flush the advance is refused and the handle state
      ' stays intact so a later flush can retry.
      if flushHandleBuffer(handle) < 0
        h_error[handle] := E_IO_ERROR                   ' Zero bytes read, and it is NOT end of file
        count := 0                                      ' Skip advance and main loop
      else
        h_buf_sector[handle] := -1
        h_sector[handle]++
        if ((h_sector[handle] - cluster_offset) & (sec_per_clus - 1)) == 0
          ' Follow FAT chain to next cluster
          cluster := h_cluster[handle]
          if readSector(cluster >> 7 + fat_sec, BUF_FAT) < 0
            DEBUG[CH_FILE]("  [do_read_h] FAT chain follow FAILED at boundary advance")
            h_error[handle] := E_IO_ERROR               ' Zero bytes read, and it is NOT end of file
            count := 0                                  ' Skip main loop
          else
            fat_addr := @fat_buf + ((cluster << 2) & SECTOR_OFFSET_MASK)
            next_cluster := LONG[fat_addr] & FAT32_ENTRY_MASK  ' top 4 bits reserved -- 28-bit cluster number
            if next_cluster +>= FAT32_EOC_MIN
              DEBUG[CH_FILE]("  [do_read_h] End of chain at boundary advance")
              h_error[handle] := E_BAD_CHAIN            ' Bytes remain per h_size, but the chain ended -- entry and chain disagree
              count := 0                                ' Skip main loop
            else
              h_cluster[handle] := next_cluster
              h_sector[handle] := clus2sec(next_cluster)

    bytes_read := 0
    repeat while count > 0
      ' Ensure current sector is loaded into handle's buffer
      if h_buf_sector[handle] <> h_sector[handle]
        ' Flush a dirty buffer before evicting it -- a read landing outside the
        ' buffered sector must not destroy unwritten write data.
        if flushHandleBuffer(handle) < 0
          h_error[handle] := E_IO_ERROR                 ' Short count follows -- say why, or it reads as EOF
          quit                                          ' Return partial read count; dirty buffer intact for retry
        ' Load sector into shared buffer, then copy to handle's buffer
        if readSector(h_sector[handle], BUF_DATA) < 0
          DEBUG[CH_FILE]("  [do_read_h] Sector read FAILED for sector ", udec_(h_sector[handle]))
          h_error[handle] := E_IO_ERROR                 ' Short count follows -- say why, or it reads as EOF
          quit                                          ' Return partial read count
        bytemove(p_hbuf, @buf, SECTOR_SIZE)
        h_buf_sector[handle] := h_sector[handle]

      ' Calculate offset within sector and bytes to read from this sector
      offset := h_position[handle] & SECTOR_OFFSET_MASK
      to_read := (SECTOR_SIZE - offset) <# count

      ' Copy data from handle buffer to user buffer
      bytemove(p_buffer, p_hbuf + offset, to_read)

      ' Advance positions
      p_buffer += to_read
      h_position[handle] += to_read
      bytes_read += to_read
      count -= to_read

      ' If we've finished this sector, advance to next
      if (h_position[handle] & SECTOR_OFFSET_MASK) == 0 AND count > 0
        h_sector[handle]++
        ' Check if we crossed a cluster boundary
        if ((h_sector[handle] - cluster_offset) & (sec_per_clus - 1)) == 0
          ' Follow FAT chain to next cluster
          cluster := h_cluster[handle]
          if readSector(cluster >> 7 + fat_sec, BUF_FAT) < 0
            DEBUG[CH_FILE]("  [do_read_h] FAT read FAILED for cluster ", udec_(cluster))
            h_error[handle] := E_IO_ERROR               ' Short count follows -- say why, or it reads as EOF
            quit                                        ' Return partial read count
          fat_addr := @fat_buf + ((cluster << 2) & SECTOR_OFFSET_MASK)
          next_cluster := LONG[fat_addr] & FAT32_ENTRY_MASK  ' top 4 bits reserved -- 28-bit cluster number
          if next_cluster +>= FAT32_EOC_MIN
            ' End of chain - shouldn't happen if h_size is correct
            DEBUG[CH_FILE]("  [do_read_h] Unexpected end of FAT chain")
            h_error[handle] := E_BAD_CHAIN              ' Chain ran out before h_size did -- entry and chain disagree
            quit
          h_cluster[handle] := next_cluster
          h_sector[handle] := clus2sec(next_cluster)

    ' ZERO MEANS END OF FILE AND NOTHING ELSE. Every stopping point above records its
    ' reason in h_error; when one of them stopped us before a single byte moved, the
    ' count alone is indistinguishable from a clean EOF -- and a caller looping until
    ' the count reaches zero would treat a dying card as a finished file. Surface the
    ' reason instead. A genuine EOF left h_error at SUCCESS and is untouched here.
    if bytes_read == 0 AND h_error[handle] < 0
      DEBUG[CH_FILE]("  [do_read_h] Nothing transferred -- returning ", sdec_(h_error[handle]), " rather than a zero that reads as EOF")
      bytes_read := h_error[handle]

    DEBUG[CH_FILE]("  [do_read_h] Read ", udec_(bytes_read), " bytes, pos now ", udec_(h_position[handle]))

PRI writeAdvanceCluster(handle) : ok | cluster, fat_addr, next_cluster, new_cluster
' Advance a write handle across a cluster boundary: FOLLOW the existing FAT link
' when the current cluster already links forward (in-place overwrite), and only
' allocate a fresh cluster when the current cluster is truly end-of-chain (growth).
'
' Mirrors do_read_h's chain-follow idiom exactly. The unconditional allocate that
' used to live at the boundary-advance sites re-linked a live FAT entry on a
' cross-boundary overwrite, orphaning the tail of the chain (Bug A).
'
' A FALSE return has two very different causes -- the card is failing, or the
' card is full -- and a caller that cannot tell them apart reports one as the
' other. The companion field advance_cluster_error carries which it was.
'
' @param handle - Valid write handle, positioned at a cluster boundary
' @returns ok - TRUE on success (h_cluster/h_sector advanced), FALSE on I/O or alloc failure
'               (see advance_cluster_error for E_IO_ERROR vs E_DISK_FULL)
' @local cluster - Current cluster whose FAT entry we read
' @local fat_addr - Address of the current cluster's FAT entry in fat_buf
' @local next_cluster - The FAT link out of the current cluster
' @local new_cluster - Freshly allocated cluster when growing the chain

  advance_cluster_error := SUCCESS
  cluster := h_cluster[handle]
  if readSector(cluster >> 7 + fat_sec, BUF_FAT) < 0
    DEBUG[CH_FILE]("  [writeAdvanceCluster] FAT read FAILED for cluster ", udec_(cluster))
    advance_cluster_error := E_IO_ERROR
    return false
  fat_addr := @fat_buf + ((cluster << 2) & SECTOR_OFFSET_MASK)
  next_cluster := LONG[fat_addr] & FAT32_ENTRY_MASK     ' top 4 bits reserved -- 28-bit cluster number
  if next_cluster +>= FAT32_EOC_MIN
    ' Truly end-of-chain -- grow the file by allocating a new cluster
    new_cluster := allocateCluster(cluster)
    if new_cluster < 0
      DEBUG[CH_FILE]("  [writeAdvanceCluster] Failed to allocate cluster: ", sdec_(new_cluster))
      advance_cluster_error := new_cluster               '  E_DISK_FULL or E_IO_ERROR, as allocateCluster reported it
      return false
    DEBUG[CH_FILE]("  [writeAdvanceCluster] Grew chain: allocated cluster ", udec_(new_cluster))
    h_cluster[handle] := new_cluster
    h_sector[handle] := clus2sec(new_cluster)
  else
    ' Cluster already links forward (in-place overwrite) -- FOLLOW it, do not allocate
    h_cluster[handle] := next_cluster
    h_sector[handle] := clus2sec(next_cluster)
  return true

PRI do_write_h(handle, p_buffer, count) : bytes_written | p_hbuf, offset, to_write, new_cluster
' Handle-based write - writes data from user buffer to file handle.
' Uses per-handle buffer with dirty tracking. File grows as needed.
' Clusters allocated when extending past current allocation.
'
' A SHORT COUNT IS NOT SELF-EXPLANATORY. An error is returned whenever NOTHING was
' accepted -- every zero-byte failure exit below returns its code, without exception.
' Once any byte has been counted the failure paths return the partial count instead,
' because the caller must be able to tell how much of the file is valid. That leaves the
' reason to h_error[handle]: SUCCESS on entry, the specific code at each stopping point.
' Public writers get it from handleError().
'
' @param handle - Valid write handle (must have HF_WRITE set)
' @param p_buffer - Pointer to source data buffer
' @param count - Number of bytes to write
' @returns bytes_written - Number of bytes written, negative on error
'                          (see handleError() for why a short count came up short)
' @local p_hbuf - Pointer to handle's buffer
' @local offset - Offset within current sector
' @local to_write - Bytes to write to current sector
' @local new_cluster - Newly allocated cluster

' Validate handle

  if NOT validateHandle(handle)
    DEBUG[CH_FILE]("  [do_write_h] Invalid handle: ", sdec_(handle))
    bytes_written := E_INVALID_HANDLE
  elseif h_flags[handle] & HF_DIR
    bytes_written := E_NOT_A_DIR_HANDLE
    h_error[handle] := E_NOT_A_DIR_HANDLE
  elseif NOT (h_flags[handle] & HF_WRITE)
    ' Verify handle is open for writing
    DEBUG[CH_FILE]("  [do_write_h] Handle not open for write")
    bytes_written := E_INVALID_HANDLE
    h_error[handle] := E_INVALID_HANDLE
  elseif count <= 0
    bytes_written := 0
    h_error[handle] := SUCCESS                          ' Nothing asked for, nothing wrong
  else
    h_error[handle] := SUCCESS                          ' Write-on-exit: overwritten below if we stop early
    DEBUG[CH_FILE]("  [do_write_h] handle=", udec_(handle), " pos=", udec_(h_position[handle]), " count=", udec_(count))

    ' LAZY FIRST-CLUSTER ALLOCATION (S5): a PC-written empty file carries
    ' start cluster 0, so the first append is the moment its chain must begin.
    ' Guarded below ROOT_CLUSTER rather than == 0 so a corrupt entry holding 1
    ' also routes here -- and gated on size 0, because a below-root cluster
    ' with a NONZERO size is a corrupt entry whose data position the fresh
    ' chain could never back: that shape keeps its below-root h_sector and
    ' fails closed at the metadata backstop in the write loop, exactly as
    ' before this fix. Position is necessarily 0 here (append position ==
    ' size == 0), so the stale-boundary block below is inapplicable. The
    ' backstop STAYS -- it is the diagnosis this fix answers, not the bug.
    if h_start_clus[handle] < ROOT_CLUSTER AND h_size[handle] == 0
      new_cluster := allocateCluster(0)                 ' no predecessor -- the do_create call shape
      if new_cluster < 0
        DEBUG[CH_FILE]("  [do_write_h] Lazy first-cluster allocation FAILED: ", sdec_(new_cluster))
        bytes_written := new_cluster                    ' nothing accepted -- surface the allocator's code
        h_error[handle] := new_cluster
        return
      h_start_clus[handle] := new_cluster
      h_cluster[handle] := new_cluster
      h_sector[handle] := clus2sec(new_cluster)
      h_buf_sector[handle] := -1                        ' defensive; provably already -1 on this path
      ' The on-disk entry still says cluster 0 -- owe the directory update so
      ' the idle flush publishes it even without an explicit sync
      h_flags[handle] |= HF_DIRSTALE

    ' Get pointer to handle's buffer
    p_hbuf := getHandleBuffer(handle)

    ' Advance past sector boundary left by previous write that ended exactly at 512-byte boundary.
    ' Without this, the next write overwrites the unflushed handle buffer before it reaches disk.
    if (h_position[handle] & SECTOR_OFFSET_MASK) == 0 AND h_position[handle] > 0 AND h_buf_sector[handle] == h_sector[handle]
      if flushHandleBuffer(handle) < 0
        bytes_written := E_IO_ERROR                    ' Surface I/O failure (sector still dirty -- next sync retries)
        h_error[handle] := E_IO_ERROR
        return
      h_buf_sector[handle] := -1
      h_sector[handle]++
      if ((h_sector[handle] - cluster_offset) & (sec_per_clus - 1)) == 0
#ifdef SD_INCLUDE_DEFRAG
        if h_prealloc_end[handle] > 0
          new_cluster := h_cluster[handle] + 1
          if new_cluster > h_prealloc_end[handle]
            ' Nothing has been accepted yet, so surface the reason rather than a zero
            ' that reads as "wrote nothing, all well" -- the else-arm below already
            ' returns its status, and these two must not disagree.
            DEBUG[CH_FILE]("  [do_write_h] Pre-allocated space exhausted")
            h_error[handle] := E_NO_CONTIGUOUS_SPACE     ' The contiguous reservation ran out -- not a card fault
            bytes_written := E_NO_CONTIGUOUS_SPACE
            return
          else
            h_cluster[handle] := new_cluster
            h_sector[handle] := clus2sec(new_cluster)
        else
#endif
          ' Follow the FAT chain on overwrite; allocate only at genuine EOC (Bug A fix)
          if not writeAdvanceCluster(handle)
            ' Nothing has been accepted yet, so surface the real reason rather than
            ' a silent zero -- same rule as the stale-sector flush failure above.
            DEBUG[CH_FILE]("  [do_write_h] Cluster advance FAILED: ", sdec_(advance_cluster_error))
            bytes_written := advance_cluster_error
            h_error[handle] := advance_cluster_error
            return

    bytes_written := 0
    repeat while count > 0
      ' Data-region write guard: file data lives at/after root_sec. A target below
      ' it means the chain walk landed in FAT/VBR/reserved space -- refuse rather
      ' than corrupt metadata. Correct-by-construction backstop; must never fire
      ' in a passing run.
      if h_sector[handle] < root_sec
        DEBUG[CH_FILE]("  [do_write_h] REFUSING metadata-region write at sector ", udec_(h_sector[handle]))
        h_error[handle] := E_BAD_CHAIN                  ' Distinct from an I/O failure: the card is fine, the chain walk is not
        if bytes_written == 0
          bytes_written := E_BAD_CHAIN                  ' Nothing accepted -- a zero here would read as "wrote nothing, all well"
        quit                                            ' Otherwise return bytes_written so far (partial), never metadata corruption
      ' Ensure current sector is in handle's buffer
      if h_buf_sector[handle] <> h_sector[handle]
        ' Flush dirty buffer first if needed
        if flushHandleBuffer(handle) < 0
          h_error[handle] := E_IO_ERROR
          if bytes_written == 0
            bytes_written := E_IO_ERROR                ' No data accepted yet -- surface failure
          quit                                         ' Otherwise return partial write count to caller

        ' Load sector (or zero-fill if writing past end).
        ' Load when this sector's FIRST byte is within the file, so a mid-sector
        ' append (pos == size, both mid-sector) preserves the existing leading
        ' bytes instead of zero-filling them (Bug B fix). SECTOR_OFFSET_MASK is
        ' bitwise-negated to sector-align the position.
        if (h_position[handle] & !SECTOR_OFFSET_MASK) < h_size[handle]
          ' Within existing file - load sector
          if readSector(h_sector[handle], BUF_DATA) < 0
            DEBUG[CH_FILE]("  [do_write_h] Sector read FAILED for sector ", udec_(h_sector[handle]))
            h_error[handle] := E_IO_ERROR               ' Read-modify-write could not read -- the bytes never merged
            if bytes_written == 0
              bytes_written := E_IO_ERROR              ' Nothing accepted -- surface the failure, not a zero
            quit                                        ' Otherwise return partial write count
          bytemove(p_hbuf, @buf, SECTOR_SIZE)
        else
          ' Past end of file - zero-fill buffer
          bytefill(p_hbuf, 0, SECTOR_SIZE)
        h_buf_sector[handle] := h_sector[handle]

      ' Calculate offset within sector and bytes to write to this sector
      offset := h_position[handle] & SECTOR_OFFSET_MASK
      to_write := (SECTOR_SIZE - offset) <# count

      ' Copy data from user buffer to handle buffer
      bytemove(p_hbuf + offset, p_buffer, to_write)
      h_flags[handle] |= HF_DIRTY

      ' Advance positions
      p_buffer += to_write
      h_position[handle] += to_write
      bytes_written += to_write
      count -= to_write

      ' Update file size if we've grown past it
      if h_position[handle] > h_size[handle]
        h_size[handle] := h_position[handle]

      ' If we've filled this sector, flush and advance to next
      if (h_position[handle] & SECTOR_OFFSET_MASK) == 0 AND count > 0
        ' Flush current (full) sector -- h_buf_sector == h_sector here: the
        ' load/zero-fill above set them equal and HF_DIRTY is set by the copy
        if flushHandleBuffer(handle) < 0
          h_error[handle] := E_IO_ERROR                ' The counted bytes did NOT reach the card -- the count alone would lie
          quit                                         ' Return partial write count -- this sector's bytes were already counted but did not reach disk
        h_buf_sector[handle] := -1

        h_sector[handle]++
        ' Check if we crossed a cluster boundary
        if ((h_sector[handle] - cluster_offset) & (sec_per_clus - 1)) == 0
' Need to allocate new cluster or follow chain
#ifdef SD_INCLUDE_DEFRAG
          if h_prealloc_end[handle] > 0
            new_cluster := h_cluster[handle] + 1
            if new_cluster > h_prealloc_end[handle]
              DEBUG[CH_FILE]("  [do_write_h] Pre-allocated space exhausted")
              h_error[handle] := E_NO_CONTIGUOUS_SPACE   ' The contiguous reservation ran out -- not a card fault
              quit                                      '  Return what we've written so far
            h_cluster[handle] := new_cluster
            h_sector[handle] := clus2sec(new_cluster)
          else
#endif
            ' Follow the FAT chain on overwrite; allocate only at genuine EOC (Bug A fix)
            if not writeAdvanceCluster(handle)
              ' Bytes were already accepted, so the count must be returned rather than
              ' an error; advance_cluster_error holds why the file could not grow further.
              DEBUG[CH_FILE]("  [do_write_h] Cluster advance FAILED mid-write: ", sdec_(advance_cluster_error))
              h_error[handle] := advance_cluster_error  ' E_IO_ERROR or E_DISK_FULL -- the caller cannot tell from a short count
              quit                                      ' Return what we've written so far (partial)

    DEBUG[CH_FILE]("  [do_write_h] Wrote ", udec_(bytes_written), " bytes, size now ", udec_(h_size[handle]))

PRI do_seek_h(handle, position) : status | target_cluster_idx, cluster, idx, fat_addr, sector_in_cluster
' Handle-based seek - seeks to absolute position in file.
' Position must be <= file size (no seeking past EOF).
'
' @param handle - Valid file handle
' @param position - Absolute byte position to seek to
' @returns status - SUCCESS (0) on success, negative error code on failure
' @local target_cluster_idx - Target cluster index from start
' @local cluster - Current cluster during walk
' @local idx - Loop counter
' @local fat_addr - Address of FAT entry
' @local sector_in_cluster - Sector offset within cluster

' Validate handle

  if NOT validateHandle(handle)
    DEBUG[CH_FILE]("  [do_seek_h] Invalid handle: ", sdec_(handle))
    status := E_INVALID_HANDLE
  elseif h_flags[handle] & HF_DIR
    status := E_NOT_A_DIR_HANDLE
  elseif position > h_size[handle]
    ' Validate position is within file
    DEBUG[CH_FILE]("  [do_seek_h] Position ", udec_(position), " > size ", udec_(h_size[handle]))
    status := E_END_OF_FILE
  else
    DEBUG[CH_FILE]("  [do_seek_h] handle=", udec_(handle), " pos ", udec_(h_position[handle]), " -> ", udec_(position))

    ' Fast path: if position is in the same sector, just update position
    if (position >> SECTOR_SHIFT) == (h_position[handle] >> SECTOR_SHIFT)
      h_position[handle] := position
      DEBUG[CH_FILE]("  [do_seek_h] Same sector, fast path")
    else
      ' Flush a dirty buffer BEFORE its identity is invalidated below: discarding
      ' it loses the unwritten data AND leaves HF_DIRTY set with h_buf_sector
      ' of -1, so every later flush writes to sector $FFFF_FFFF. On a failed
      ' flush the seek is refused and the handle state is left untouched.
      status := flushHandleBuffer(handle)
      if status == SUCCESS
        ' Calculate which cluster the target position is in
        ' target_cluster_idx = how many clusters from the start
        target_cluster_idx := position / (sec_per_clus << SECTOR_SHIFT)

        ' Walk the FAT chain from the file's start cluster
        cluster := h_start_clus[handle]

        ' BUG FIX: Guard against Spin2's count-down behavior
        ' When target_cluster_idx is 0, "repeat idx from 0 to -1" would execute twice
        ' (counting down from 0 to -1), incorrectly walking the FAT chain.
        ' Only walk the chain if we need to move to a different cluster.
        if target_cluster_idx > 0
          repeat idx from 0 TO target_cluster_idx - 1
            ' Read FAT entry for current cluster
            if readSector(cluster >> 7 + fat_sec, BUF_FAT) < 0
              DEBUG[CH_FILE]("  [do_seek_h] FAT read FAILED for cluster ", udec_(cluster))
              status := E_IO_ERROR
              quit
            fat_addr := @fat_buf + ((cluster << 2) & SECTOR_OFFSET_MASK)
            cluster := LONG[fat_addr] & FAT32_ENTRY_MASK  ' top 4 bits reserved -- 28-bit cluster number
            if cluster +>= FAT32_EOC_MIN
              ' End of chain reached before target - shouldn't happen
              DEBUG[CH_FILE]("  [do_seek_h] Unexpected end of FAT chain at index ", udec_(idx))
              status := E_END_OF_FILE
              quit

        if status == 0
          ' Calculate sector within cluster
          sector_in_cluster := (position >> SECTOR_SHIFT) & (sec_per_clus - 1)

          ' Update handle state
          h_cluster[handle] := cluster
          h_sector[handle] := clus2sec(cluster) + sector_in_cluster
          h_position[handle] := position
          if h_buf_sector[handle] <> h_sector[handle]
            h_buf_sector[handle] := -1                  ' Invalidate only when the buffer holds a different sector
          DEBUG[CH_FILE]("  [do_seek_h] Seek complete: cluster=", udec_(cluster), " sector=", udec_(h_sector[handle]))

PRI flushHandleBuffer(handle) : status | p_buf
' Flush the handle's dirty sector buffer to the card, if dirty.
' Clears HF_DIRTY only on a successful write -- on failure the data stays
' pending in the handle buffer (identity intact) so a later flush can retry.
' Shared by EVERY path that evicts or invalidates a handle buffer, including
' all three do_write_h flush points (inline copies collapsed 2026-08-09,
' Stephen's call at the task #48 handoff: one copy owns the HF_DIRTY discipline,
' and invalidateCacheRange()'s dirty-handle exemption depends on this exact
' ordering -- writeSector is called while HF_DIRTY is still set).
'
' @param handle - Valid file handle
' @returns status - SUCCESS (0), or E_IO_ERROR if the write failed
' @local p_buf - Pointer to handle's buffer

  status := SUCCESS
  if h_flags[handle] & HF_DIRTY
    DEBUG[CH_FILE]("  [flushHandleBuffer] Flushing dirty buffer for sector ", udec_(h_buf_sector[handle]))
    p_buf := getHandleBuffer(handle)
    bytemove(@buf, p_buf, SECTOR_SIZE)
    if writeSector(h_buf_sector[handle], BUF_DATA) < 0
      DEBUG[CH_FILE]("  [flushHandleBuffer] Dirty buffer write FAILED for sector ", udec_(h_buf_sector[handle]))
      status := E_IO_ERROR
    else
      h_flags[handle] &= !HF_DIRTY

PRI do_sync_h(handle) : status
' Sync handle buffer to disk - flushes pending writes and updates directory.
' Does NOT close handle - file remains open for further operations.
'
' @param handle - Valid file handle
' @returns status - SUCCESS (0) on success, E_INVALID_HANDLE on failure

' Validate handle

  if NOT validateHandle(handle)
    DEBUG[CH_FILE]("  [do_sync_h] Invalid handle: ", sdec_(handle))
    status := E_INVALID_HANDLE
  elseif h_flags[handle] & HF_DIR
    status := E_NOT_A_DIR_HANDLE
  else
    DEBUG[CH_FILE]("  [do_sync_h] Syncing handle=", udec_(handle), " flags=$", uhex_byte_(h_flags[handle]))

    ' If buffer is dirty, flush it to disk. HF_DIRTY survives a failed write --
    ' the data is still pending in the handle buffer and a future sync retries.
    status := flushHandleBuffer(handle)

    ' If opened for write, update directory entry with current size. Skip when
    ' the dirty-buffer flush above failed -- writing a dir entry that claims
    ' a size whose backing data didn't reach disk would corrupt the filesystem.
    if status == SUCCESS AND (h_flags[handle] & HF_WRITE)
      DEBUG[CH_FILE]("  [do_sync_h] Updating directory: size=", udec_(h_size[handle]))
      if readSector(h_dir_sector[handle], BUF_DIR) < 0
        DEBUG[CH_FILE]("  [do_sync_h] Directory read FAILED for sector ", udec_(h_dir_sector[handle]))
        status := E_IO_ERROR
      else
        LONG[@dir_buf + h_dir_offset[handle] + DE_FILESIZE_OFFSET] := h_size[handle]
        LONG[@dir_buf + h_dir_offset[handle] + DE_WRT_TIME_OFFSET] := date_stamp  ' Update modification timestamp
        ' Publish the start cluster unconditionally: a no-op re-stamp for a
        ' normal file, and the moment a lazily-allocated first cluster (S5 --
        ' cluster-0 entry appended to) reaches the on-disk entry. Ordering is
        ' safe: this entry update only runs after flushHandleBuffer succeeded,
        ' so the cluster named here always has its data on the card.
        dirEntSetStartClus(@dir_buf + h_dir_offset[handle], h_start_clus[handle])
        if writeSector(h_dir_sector[handle], BUF_DIR) < 0
          DEBUG[CH_FILE]("  [do_sync_h] Directory write FAILED for sector ", udec_(h_dir_sector[handle]))
          status := E_IO_ERROR
      ' Track the directory entry's staleness in its OWN flag: re-arming
      ' HF_DIRTY here would be cancelled by any intervening buffer-evicting
      ' flush (seek, read), silently dropping the background retry.
      ' do_idle_flush selects on either flag; success clears the debt.
      if status == SUCCESS
        h_flags[handle] &= !HF_DIRSTALE
      else
        h_flags[handle] |= HF_DIRSTALE

    DEBUG[CH_FILE]("  [do_sync_h] Sync complete, status=", sdec_(status))

PRI do_idle_flush() | idx, bAborted, status
' Auto-flush dirty handles after idle period. Scans all handles for HF_DIRTY,
' syncs each, then updates FSInfo if needed. Checks pb_cmd between each handle
' sync to abort immediately if a command arrives.
'
' THIS IS THE PATH A CALLER'S DATA TAKES when they write without explicit syncs, and
' it is the only one the worker starts on its own -- there is no cog waiting on it, so
' a failure here has nowhere to be returned. Both statuses below are therefore recorded
' in flush_error, which lastFlushError() exposes; without that a failed background
' flush is invisible and every later API call still reports success.
'
' An ABORT IS NOT A FAILURE. A command arriving mid-flush cancels the remaining work
' by design, the handles stay dirty, and the next idle window retries -- nothing is
' recorded for it.
'
' @local idx - Handle index being scanned
' @local bAborted - TRUE when an arriving command cut the flush short
' @local status - Per-handle do_sync_h result

  ' Backstop (defense-in-depth; the dispatcher already arms on this same
  ' predicate): with no filesystem mounted there is nothing to flush and no
  ' FSInfo to update -- and the card may already be out of the slot. Disarms
  ' so a slipped-through arming does not re-fire every worker-loop pass.
  if NOT (flags & F_MOUNTED)
    flush_done := true
    return

  bAborted := false
  repeat idx from 0 TO MAX_OPEN_FILES - 1
    if pb_cmd <> CMD_NONE
      bAborted := true                                  ' Command arrived, abort flush
      quit
    if h_flags[idx] & (HF_DIRTY | HF_DIRSTALE)
      status := do_sync_h(idx)
      if status <> SUCCESS
        DEBUG[CH_FILE]("  [do_idle_flush] Background sync FAILED on handle ", udec_(idx), ": ", sdec_(status))
        recordFlushError(status)                        ' The handle stays dirty/dir-stale, so a later flush or sync can still retry
  if NOT bAborted
    updateFSInfo()
    ' updateFSInfo()'s FALSE also means "nothing to update", so the companion field is
    ' what says whether an attempted update actually failed.
    if fsinfo_error <> SUCCESS
      DEBUG[CH_MOUNT]("  [do_idle_flush] Background FSInfo update FAILED: ", sdec_(fsinfo_error))
      recordFlushError(fsinfo_error)
    flush_done := true

PRI recordFlushError(status)
' Record the FIRST failure seen by an automatic flush, and keep it.
'
' Sticky rather than last-writer-wins: a background flush runs on a timer, so a second
' one can easily come and go before anyone polls lastFlushError(). Overwriting on each
' failure would be harmless, but overwriting on SUCCESS would erase the very report this
' field exists to deliver, so the field is never cleared here at all -- only
' clearFlushError() clears it.
'
' @param status - Non-SUCCESS code to record

  if flush_error == SUCCESS
    flush_error := status

PRI do_sync_all() : status | idx, sync_status
' Sync all open write handles - flushes all write handles to disk.
' Called by unmount() to ensure all data is written before stopping.
'
' Continues syncing remaining handles even if one fails so as much data as
' possible reaches disk; reports the first failure encountered.
'
' @returns status - SUCCESS (0) if every dirty handle synced cleanly; first
'                   non-SUCCESS returned by do_sync_h otherwise.
' @local idx - Loop variable
' @local sync_status - Per-handle do_sync_h return value

  status := SUCCESS
  DEBUG[CH_FILE]("  [do_sync_all] Syncing all handles")
  repeat idx from 0 TO MAX_OPEN_FILES - 1
    if h_flags[idx] & HF_WRITE
      DEBUG[CH_FILE]("  [do_sync_all] Syncing write handle ", udec_(idx))
      sync_status := do_sync_h(idx)
      if sync_status < 0 AND status == SUCCESS
        status := sync_status

  DEBUG[CH_FILE]("  [do_sync_all] All handles synced, status=", sdec_(status))

PRI do_open_dir(p_path) : handle | start_cluster
' Open directory for enumeration - returns handle for iterating entries.
' Directory handles share the existing handle pool with file handles.
'
' @param p_path - Pointer to null-terminated path string ("." or "" for CWD)
' @returns handle - Handle (0 to MAX_OPEN_FILES-1) on success, negative error code on failure
' @local start_cluster - Starting cluster of the directory

' Allocate a handle slot

  handle := allocateHandle()
  if handle < 0
    DEBUG[CH_DIR]("  [do_open_dir] No free handles")
  else
    ' Determine which directory to enumerate
    if BYTE[p_path] == 0 OR (BYTE[p_path] == "." AND BYTE[p_path + 1] == 0)
      ' Empty string or "." -- enumerate calling cog's CWD
      n_sec := cog_dir_sec[pb_caller]
      start_cluster := sec2clus(n_sec)
    elseif BYTE[p_path] == "/" AND BYTE[p_path + 1] == 0
      ' Bare "/" -- enumerate root directory
      n_sec := root_sec
      start_cluster := sec2clus(root_sec)
    else
      ' Search for the named directory
      if NOT searchDirectory(p_path)
        DEBUG[CH_DIR]("  [do_open_dir] Directory not found: ", zstr_(p_path))
        freeHandle(handle)
        handle := (search_io_status < 0) ? search_io_status : E_FILE_NOT_FOUND
      elseif NOT (attributes() & ATTR_DIRECTORY)
        ' Verify it's a directory
        DEBUG[CH_DIR]("  [do_open_dir] Not a directory: ", zstr_(p_path))
        freeHandle(handle)
        handle := E_NOT_A_DIR
      else
        start_cluster := firstCluster()
        if start_cluster < 2
          start_cluster := ROOT_CLUSTER                 ' Root directory

    ' Populate handle state (only if handle is still valid)
    if handle >= 0
      h_flags[handle] := HF_DIR
      h_start_clus[handle] := start_cluster
      h_cluster[handle] := start_cluster
      h_sector[handle] := clus2sec(start_cluster)
      h_position[handle] := 0                           ' Entry index
      h_size[handle] := 0                               ' Not used for directories
      h_buf_sector[handle] := -1                        ' No sector cached yet
      DEBUG[CH_DIR]("  [do_open_dir] Success: handle=", udec_(handle), " cluster=", udec_(start_cluster))

PRI do_read_dir_h(handle) : status | p_hbuf, offset, char, attrib, cluster, fat_addr, next_cluster
' Read next directory entry from handle - skips deleted and LFN entries.
' Copies valid entry into entry_buffer for caller to inspect via fileName()/attributes().
'
' @param handle - Valid directory handle (must have HF_DIR flag)
' @returns status - SUCCESS on valid entry, E_FILE_NOT_FOUND at end of directory
' @local p_hbuf - Pointer to handle's buffer
' @local offset - Byte offset within current sector
' @local char - First byte of entry
' @local attrib - Entry attribute byte
' @local cluster - Current cluster number
' @local fat_addr - Address of FAT entry
' @local next_cluster - Next cluster in chain

' Validate handle

  if NOT validateHandle(handle)
    status := E_INVALID_HANDLE
  elseif NOT (h_flags[handle] & HF_DIR)
    status := E_INVALID_HANDLE
  else
    p_hbuf := getHandleBuffer(handle)
    status := E_FILE_NOT_FOUND                                                        ' Default: end of directory

    repeat
      ' Check if we need to advance to next sector (16 entries per 512-byte sector)
      if h_position[handle] > 0 AND (h_position[handle] & (DIR_ENTRIES_PER_SECTOR - 1)) == 0
        h_sector[handle]++
        ' Check if we crossed a cluster boundary
        if ((h_sector[handle] - cluster_offset) & (sec_per_clus - 1)) == 0
          ' Follow FAT chain to next cluster
          cluster := h_cluster[handle]
          if readSector(cluster >> 7 + fat_sec, BUF_FAT) < 0
            DEBUG[CH_DIR]("  [do_read_dir_h] FAT read FAILED for cluster ", udec_(cluster))
            status := E_IO_ERROR
            quit
          fat_addr := @fat_buf + ((cluster << 2) & SECTOR_OFFSET_MASK)
          next_cluster := LONG[fat_addr] & FAT32_ENTRY_MASK  ' top 4 bits reserved -- 28-bit cluster number
          if next_cluster +>= FAT32_EOC_MIN
            quit                                                                      ' End of directory chain
          h_cluster[handle] := next_cluster
          h_sector[handle] := clus2sec(next_cluster)
        h_buf_sector[handle] := -1                                                    ' Force re-read

      ' Load current sector into handle's buffer if not cached
      if h_buf_sector[handle] <> h_sector[handle]
        if readSector(h_sector[handle], BUF_DATA) < 0
          DEBUG[CH_DIR]("  [do_read_dir_h] Sector read FAILED for sector ", udec_(h_sector[handle]))
          status := E_IO_ERROR
          quit
        bytemove(p_hbuf, @buf, SECTOR_SIZE)
        h_buf_sector[handle] := h_sector[handle]

      ' Calculate byte offset within sector (each entry is 32 bytes)
      offset := (h_position[handle] & (DIR_ENTRIES_PER_SECTOR - 1)) * DIR_ENTRY_SIZE  ' byte offset within sector

      ' Read first byte and attributes
      char := BYTE[p_hbuf + offset]
      attrib := BYTE[p_hbuf + offset + 11]

      ' Advance position for next call
      h_position[handle]++

      ' Check for end of directory
      if char == $00
        quit                                                                          ' E_FILE_NOT_FOUND (default)

      ' Skip deleted entries and LFN entries
      if char == DIR_ENTRY_DELETED
        next
      if attrib == ATTR_LFN                                                           ' LFN entry
        next
      ' Skip entries with hidden/system attributes that aren't normally shown
      if attrib & (ATTR_HIDDEN | ATTR_SYSTEM | ATTR_VOLUME_ID) <> 0
        next

      ' Valid entry found - copy to entry_buffer
      bytemove(@entry_buffer, p_hbuf + offset, DIR_ENTRY_SIZE)
      status := SUCCESS
      quit

PRI do_close_dir_h(handle) : status
' Close directory handle - releases handle back to pool.
'
' @param handle - Valid directory handle
' @returns status - SUCCESS on success, E_INVALID_HANDLE if invalid

  if NOT validateHandle(handle)
    status := E_INVALID_HANDLE
  elseif NOT (h_flags[handle] & HF_DIR)
    status := E_INVALID_HANDLE
  else
    DEBUG[CH_DIR]("  [do_close_dir_h] Closing handle=", udec_(handle))
    freeHandle(handle)
    status := SUCCESS

PRI do_newfile(name_ptr) : status | temp
' Internal new file operation - creates a new file in current directory.
'
' @param name_ptr - Pointer to null-terminated filename string
' @returns status - SUCCESS on success, E_FILE_EXISTS if file exists
' @local temp - Temporary calculation variable

  do_close()
  status := SUCCESS
  if searchDirectory(name_ptr)
    status := E_FILE_EXISTS
  elseif search_io_status < 0
    ' FAIL CLOSED -- see do_create. An incomplete existence check must not be read
    ' as "the name is available".
    DEBUG[CH_DIR]("  [do_newfile] Existence check FAILED, refusing to create")
    status := search_io_status
  elseif entry_address == 0
    ' Guard: entry_address 0 means searchDirectory never found a valid directory
    ' (e.g., path component doesn't exist). Writing at address 0 would corrupt the MBR.
    DEBUG[CH_DIR]("  [do_newfile] entry_address=0 -- path not valid, aborting")
    status := E_FILE_NOT_FOUND
  else
    temp := (entry_address + cluster_offset << SECTOR_SHIFT) & (sec_per_clus << SECTOR_SHIFT - 1)
    if temp == (sec_per_clus << SECTOR_SHIFT - DIR_ENTRY_SIZE)
      if dir_buf[LAST_DIR_ENTRY_OFFSET] == $00          ' Check dir buffer after searchDirectory
        temp := allocateCluster(byte2clus(entry_address))
        if temp < 0                                       '  E_DISK_FULL/E_IO_ERROR into clus2sec() would
          DEBUG[CH_DIR]("  [do_newfile] Failed to allocate dir cluster: ", sdec_(temp))
          status := temp                                  '   write sectors at a wild negative-derived address
        elseif clearCluster(temp) < 0
          DEBUG[CH_DIR]("  [do_newfile] Failed to clear new dir cluster")
          status := E_IO_ERROR

    if status == SUCCESS
      dirEntSetAttr(@entry_buffer, ATTR_ARCHIVE)
      dirEntSetCreateStamp(@entry_buffer, date_stamp)
      dirEntSetStartClus(@entry_buffer, 0)
      dirEntSetModifyStamp(@entry_buffer, date_stamp)
      dirEntSetFileSize(@entry_buffer, 0)
      flags |= F_NEWDIR

PRI do_newdir(name_ptr) : status | temp, dir_clus, parent_clus
' Internal new directory operation - creates a new directory in current directory.
'
' The ./.. entries are written into the new cluster BEFORE the parent directory
' gains an entry pointing at it, so a failure part-way through can never leave the
' parent referring to an uninitialized directory cluster. Both writes are checked
' and both are verified by read-back.
'
' @param name_ptr - Pointer to null-terminated directory name string
' @returns status - SUCCESS on success, E_FILE_EXISTS if directory exists,
'                   E_DISK_FULL or E_IO_ERROR if a cluster or write failed
' @local temp - Temporary calculation variable for cluster allocation
' @local dir_clus - Cluster allocated for the new directory itself
' @local parent_clus - Cluster the new directory's ".." entry points at (0 for root)

  do_close()
  if searchDirectory(name_ptr)
    status := E_FILE_EXISTS
  elseif search_io_status < 0
    ' FAIL CLOSED -- see do_create.
    DEBUG[CH_DIR]("  [do_newdir] Existence check FAILED, refusing to create")
    status := search_io_status
  elseif entry_address == 0
    ' Guard: entry_address 0 means searchDirectory never found a valid directory
    ' (e.g., path component doesn't exist). Writing at address 0 would corrupt the MBR.
    DEBUG[CH_DIR]("  [do_newdir] entry_address=0 -- path not valid, aborting")
    status := E_FILE_NOT_FOUND
  else
    temp := (entry_address + cluster_offset << SECTOR_SHIFT) & (sec_per_clus << SECTOR_SHIFT - 1)
    if temp == sec_per_clus << SECTOR_SHIFT - DIR_ENTRY_SIZE
      if dir_buf[LAST_DIR_ENTRY_OFFSET] == $00          ' Check dir buffer after searchDirectory
        temp := allocateCluster(byte2clus(entry_address))
        if temp < 0                                     '  E_DISK_FULL/E_IO_ERROR into clus2sec() would write
          DEBUG[CH_DIR]("  [do_newdir] Failed to allocate extended dir cluster: ", sdec_(temp))
          return temp                                   '   sectors at a wild negative-derived address
        if clearCluster(temp) < 0                       '  return before the entry is built: a directory whose
          DEBUG[CH_DIR]("  [do_newdir] Failed to clear extended dir cluster")
          return E_IO_ERROR                             '   cluster still holds old data reads back as garbage entries

    dir_clus := allocateCluster(0)                      ' The new directory's own cluster
    if dir_clus < 0
      DEBUG[CH_DIR]("  [do_newdir] Failed to allocate directory cluster: ", sdec_(dir_clus))
      return dir_clus
    if clearCluster(dir_clus) < 0                       '  zero all sectors in new directory cluster
      DEBUG[CH_DIR]("  [do_newdir] Failed to clear new directory cluster")
      return E_IO_ERROR
    dirEntSetAttr(@entry_buffer, ATTR_DIRECTORY)        ' Directory attribute
    dirEntSetCreateStamp(@entry_buffer, date_stamp)
    dirEntSetStartClus(@entry_buffer, dir_clus)
    dirEntSetModifyStamp(@entry_buffer, date_stamp)
    dirEntSetFileSize(@entry_buffer, 0)

    ' Step 1: write the ./.. entries into the new cluster FIRST. Ordering is what
    ' guarantees the parent never gains an entry pointing at an uninitialized
    ' directory cluster -- if this write fails, nothing in the parent refers to it
    ' and the only cost is the leaked cluster allocateCluster already documents.
    bytefill(@dir_buf, 0, SECTOR_SIZE)
    bytemove(@dir_buf[0], string(".          "), SFN_TOTAL_LEN)
    BYTE[@dir_buf + DE_ATTR_OFFSET] := ATTR_DIRECTORY
    LONG[@dir_buf + DE_CRT_TIME_OFFSET] := date_stamp
    WORD[@dir_buf + DE_CLUS_HI_OFFSET] := dir_clus >> 16
    LONG[@dir_buf + DE_WRT_TIME_OFFSET] := date_stamp
    WORD[@dir_buf + DE_CLUS_LO_OFFSET] := dir_clus & $FFFF

    parent_clus := byte2clus(entry_address)
    if parent_clus == ROOT_CLUSTER
      parent_clus := 0                                  ' ".." points at 0 for the root directory
    bytemove(@dir_buf[DIR_ENTRY_SIZE], string("..         "), SFN_TOTAL_LEN)
    BYTE[@dir_buf + DIR_ENTRY_SIZE + DE_ATTR_OFFSET] := ATTR_DIRECTORY
    LONG[@dir_buf + DIR_ENTRY_SIZE + DE_CRT_TIME_OFFSET] := date_stamp
    WORD[@dir_buf + DIR_ENTRY_SIZE + DE_CLUS_HI_OFFSET] := parent_clus >> 16
    LONG[@dir_buf + DIR_ENTRY_SIZE + DE_WRT_TIME_OFFSET] := date_stamp
    WORD[@dir_buf + DIR_ENTRY_SIZE + DE_CLUS_LO_OFFSET] := parent_clus & $FFFF

    n_sec := clus2sec(dir_clus)
    DEBUG[CH_DIR]("  [do_newdir] Writing ./.. to sector ", udec_(n_sec), ": dir_buf[0]=[", lstr_(@dir_buf, 11), "] dir_buf[32]=[", lstr_(@dir_buf + 32, 11), "]")
    if writeSector(n_sec, BUF_DIR) < 0
      DEBUG[CH_DIR]("  [do_newdir] ./.. write FAILED for sector ", udec_(n_sec))
      return E_IO_ERROR
    dir_sec_in_buf := n_sec

    ' Read the ./.. entries back and check them. This verification already existed
    ' but only ever reached DEBUG; it now fails the operation, which is the whole
    ' point of doing the extra read.
    dir_sec_in_buf := -1                                ' Force re-read
    if readSector(n_sec, BUF_DIR) < 0
      DEBUG[CH_DIR]("  [do_newdir] Verify ./.. read FAILED for sector ", udec_(n_sec))
      return E_IO_ERROR
    if BYTE[@dir_buf] <> "." OR WORD[@dir_buf + DE_CLUS_LO_OFFSET] <> (dir_clus & $FFFF)
      DEBUG[CH_DIR]("  [do_newdir] Verify ./.. MISMATCH at sector ", udec_(n_sec))
      return E_IO_ERROR
    DEBUG[CH_DIR]("  [do_newdir] After ./.. verify: dir_buf[0]=[", lstr_(@dir_buf, 11), "] dir_buf[32]=[", lstr_(@dir_buf + 32, 11), "]")

    ' Step 2: only now link the initialized cluster from the parent directory.
    if readSector(entry_address >> SECTOR_SHIFT, BUF_DIR) < 0
      DEBUG[CH_DIR]("  [do_newdir] Directory read FAILED for sector ", udec_(entry_address >> SECTOR_SHIFT))
      status := E_IO_ERROR
    else
      DEBUG[CH_DIR]("  [do_newdir] Before write: dir_buf[", udec_(entry_address & SECTOR_OFFSET_MASK), "]=[", lstr_(@dir_buf + (entry_address & SECTOR_OFFSET_MASK), 11), "]")
      bytemove(@dir_buf + (entry_address & SECTOR_OFFSET_MASK), @entry_buffer, DIR_ENTRY_SIZE)
      DEBUG[CH_DIR]("  [do_newdir] After copy: dir_buf[", udec_(entry_address & SECTOR_OFFSET_MASK), "]=[", lstr_(@dir_buf + (entry_address & SECTOR_OFFSET_MASK), 11), "]")
      DEBUG[CH_DIR]("  [do_newdir] entry_buffer=[", lstr_(@entry_buffer, 11), "]")
      if writeSector(entry_address >> SECTOR_SHIFT, BUF_DIR) < 0
        DEBUG[CH_DIR]("  [do_newdir] Parent entry write FAILED for sector ", udec_(entry_address >> SECTOR_SHIFT))
        status := E_IO_ERROR
      ' Verify the parent entry by reading it back and comparing against the bytes
      ' we wrote -- entry_buffer still holds them. This read-back already existed
      ' but only ever reached DEBUG; it now fails the operation.
      elseif readSector(entry_address >> SECTOR_SHIFT, BUF_DIR) < 0
        DEBUG[CH_DIR]("  [do_newdir] Verify read FAILED for sector ", udec_(entry_address >> SECTOR_SHIFT))
        status := E_IO_ERROR
      elseif NOT entryMatches(@dir_buf + (entry_address & SECTOR_OFFSET_MASK), @entry_buffer)
        DEBUG[CH_DIR]("  [do_newdir] Verify MISMATCH at sector ", udec_(entry_address >> SECTOR_SHIFT))
        status := E_IO_ERROR
      else
        DEBUG[CH_DIR]("  [do_newdir] After verify read: dir_buf[", udec_(entry_address & SECTOR_OFFSET_MASK), "]=[", lstr_(@dir_buf + (entry_address & SECTOR_OFFSET_MASK), 11), "]")
        n_sec := clus2sec(dir_clus)                     ' Leave n_sec on the new directory, as before
        status := SUCCESS

PRI entryMatches(p_actual, p_expected) : bMatch | idx
' Compare a 32-byte directory entry read back from the card against the bytes we
' meant to write. Used to turn a write's read-back from a DEBUG decoration into a
' real assertion: a write that never landed leaves the OLD entry there, and a torn
' write leaves a partial one -- both differ from what we handed to writeSector().
'
' @param p_actual - Pointer to the entry as read back from the card
' @param p_expected - Pointer to the entry we wrote
' @returns bMatch - TRUE when all DIR_ENTRY_SIZE bytes are identical
' @local idx - Byte index

  bMatch := true
  repeat idx from 0 to DIR_ENTRY_SIZE - 1
    if BYTE[p_actual + idx] <> BYTE[p_expected + idx]
      bMatch := false
      quit

PRI do_delete(name_ptr) : status
' Internal delete operation - deletes a file and frees its clusters.
'
' ORDER MATTERS. The entry must be marked deleted on the card BEFORE the chain is
' freed, and the chain must not be freed at all if that write did not land. The
' failure this prevents: entry still live, clusters free -- the file still appears
' in the directory, its clusters get handed to the next allocation, and reading it
' returns another file's data. Leaving an undeleted file behind is recoverable;
' freeing a chain out from under a live entry is not.
'
' TWO REFUSALS (contract set 2026-08-09, v1.7.0):
' - E_FILE_OPEN: any open file handle still references the entry. Deleting under
'   it would let a later sync/idle flush write the handle's dirty buffer into
'   freed -- possibly reallocated -- clusters.
' - E_DIR_NOT_EMPTY: the target is a directory with live children. Deleting it
'   used to free only the directory's OWN chain, orphaning every child's clusters
'   as lost chains. The caller empties the directory first (no recursive delete).
'
' @param name_ptr - Pointer to null-terminated filename string
' @returns status - SUCCESS on success, E_FILE_NOT_FOUND if not found,
'                   E_FILE_OPEN if a handle still references the file,
'                   E_DIR_NOT_EMPTY if a directory still has entries,
'                   E_IO_ERROR if the entry could not be marked deleted

  do_close()
  if searchDirectory(name_ptr) == 0
    status := (search_io_status < 0) ? search_io_status : E_FILE_NOT_FOUND
  elseif attributes() & ATTR_LFN                                                ' Check read-only, hidden, system, volume label
    status := E_FILE_NOT_FOUND                                                  ' Protected file (but allow directories)
  elseif isFileOpen(entry_address >> SECTOR_SHIFT, entry_address & SECTOR_OFFSET_MASK)
    status := E_FILE_OPEN                                                       ' See header: delete-while-open corruption path
  else
    if attributes() & ATTR_DIRECTORY
      status := checkDirectoryEmpty()                                           ' Clobbers n_sec and dir_buf
    if status == SUCCESS
      ' Re-read the entry's sector: the emptiness walk above (or any interim
      ' caching) may have replaced dir_buf since searchDirectory loaded it.
      if readSector(entry_address >> SECTOR_SHIFT, BUF_DIR) < 0
        DEBUG[CH_FILE]("  [do_delete] Entry sector re-read FAILED for sector ", udec_(entry_address >> SECTOR_SHIFT))
        status := E_IO_ERROR
      else
        dir_buf[entry_address & SECTOR_OFFSET_MASK] := DIR_ENTRY_DELETED        ' Mark entry as deleted in dir buffer
        if writeSector(entry_address >> SECTOR_SHIFT, BUF_DIR) < 0
          DEBUG[CH_FILE]("  [do_delete] Entry-deleted write FAILED for sector ", udec_(entry_address >> SECTOR_SHIFT))
          status := E_IO_ERROR                                                  ' Leave the chain intact -- see above
        else
          ' Only deallocate clusters if file has data (cluster >= 2)
          status := freeClusterChain(firstCluster())

PRI checkDirectoryEmpty() : status | idx, ch, adv
' Walk the directory whose entry sits in entry_buffer and report whether it
' holds any live child. '.', '..' (both start with '.'), and deleted ($E5)
' entries do not count. The walk cannot prove emptiness if a read fails, and
' "unknown" must not delete a directory -- it fails closed as E_IO_ERROR.
' Clobbers n_sec and dir_buf.
'
' @returns status - SUCCESS when empty, E_DIR_NOT_EMPTY when a live child
'                   exists, E_IO_ERROR when the walk could not complete
' @local idx - Byte offset of the current entry within the directory
' @local ch - First byte of the current entry
' @local adv - readNextSector() status at sector boundaries

  status := SUCCESS
  if firstCluster() < 2
    return                                              ' No chain -- nothing can be inside
  n_sec := clus2sec(firstCluster())
  if readSector(n_sec, BUF_DIR) < 0
    return E_IO_ERROR
  idx := 0
  repeat
    ch := dir_buf[idx & SECTOR_OFFSET_MASK]
    if ch == $00
      quit                                              ' Terminator: nothing further exists
    if ch <> DIR_ENTRY_DELETED AND ch <> "."
      status := E_DIR_NOT_EMPTY                         ' A live child (LFN remnants count too)
      quit
    idx += DIR_ENTRY_SIZE
    if idx & SECTOR_OFFSET_MASK == 0                    ' Crossed a sector boundary
      adv := readNextSector(BUF_DIR)
      if adv < 0
        status := E_IO_ERROR                            ' Could not look -- not the same as empty
        quit
      if adv == END_OF_CHAIN
        quit                                            ' Chain ended with no live child found

PRI do_chdir(name_ptr) : status
' Internal change directory operation - changes current directory.
'
' @param name_ptr - Pointer to null-terminated directory name string
' @returns status - SUCCESS on success, E_NOT_A_DIR when the name exists but is not
'                  a directory, E_FILE_NOT_FOUND when no entry carries the name
'                  (v1.7.0 split these; both were E_NOT_A_DIR before), or the
'                  propagated search_io_status when the directory could not be read

  do_close()
  if BYTE[name_ptr] == "/" AND BYTE[name_ptr + 1] == $00
    ' Bare "/" means root directory -- no search needed
    cog_dir_sec[pb_caller] := root_sec
    status := SUCCESS
  elseif searchDirectory(name_ptr)
    ' ATTR_DIRECTORY alone authorizes the change. The old OR-arm accepted any
    ' match whose n_sec landed on root_sec -- which searchDirectory's cluster-0
    ' redirect produces for EVERY 0-byte cluster-0 file (what a PC writes for an
    ' empty file), silently setting the caller's CWD to root. '..' does not
    ' need the arm: every '..' entry carries ATTR_DIRECTORY (do_newdir writes
    ' it; FAT32 requires it), and for a first-level '..' the redirect still
    ' supplies root_sec as the TARGET -- it just no longer authorizes by itself.
    if attributes() & ATTR_DIRECTORY
      cog_dir_sec[pb_caller] := n_sec
      status := SUCCESS
    else
      DEBUG[CH_DIR]("  [do_chdir] NOT a directory: attr=", uhex_byte_(attributes()))
      status := E_NOT_A_DIR
  elseif search_io_status < 0
    DEBUG[CH_DIR]("  [do_chdir] Directory read FAILED for: ", zstr(name_ptr))
    status := search_io_status                          ' Could not read the directory -- not "not a directory"
  else
    ' A name with no entry at all is "not found", not "not a directory" -- the
    ' two used to share E_NOT_A_DIR. The distinction also keeps the volume
    ' label invisible: the label filter makes the search miss it, and a miss
    ' must not imply the name exists as a non-directory.
    DEBUG[CH_DIR]("  [do_chdir] searchDirectory FAILED for: ", zstr(name_ptr), " dir_sec=", udec_(cog_dir_sec[pb_caller]))
    status := E_FILE_NOT_FOUND

PRI do_freespace() : sectorCount | cluster
' Internal free space calculation - returns free sectors on card.
'
' AN INCOMPLETE SCAN MUST NOT BE REPORTED AS A COUNT. Stopping early leaves every
' unscanned cluster uncounted, so the number comes out LOW -- the volume looks fuller
' than it is, or emptier, depending on which way the caller reasons -- and an
' application deciding whether a write will fit gets a wrong answer delivered as fact.
' The companion field freespace_error says whether the scan completed; do_freespace
' still returns the partial count so a diagnostic caller can see how far it got.
'
' @returns sectorCount - Number of free sectors (partial if freespace_error is set)
' @local cluster - Loop variable for FAT scan

  freespace_error := SUCCESS
  if NOT (flags & F_MOUNTED)
    sectorCount := 0
    freespace_error := E_NOT_MOUNTED
  else
    n_sec := fat_sec
    repeat sec_per_fat
      if readSector(n_sec++, BUF_FAT) < 0
        DEBUG[CH_MOUNT]("  [do_freespace] FAT read FAILED, scan is incomplete")
        freespace_error := E_IO_ERROR
        quit
      repeat cluster from 0 TO FAT_ENTRIES_PER_SECTOR - 1
        ' FAT32: top 4 bits reserved -- a free cluster is free regardless of them
        if (LONG[@fat_buf + cluster << 2] & FAT32_ENTRY_MASK) == 0
          sectorCount++
    sectorCount := sectorCount * sec_per_clus

PRI do_sync() : status
' Internal sync operation: flush EVERYTHING -- every open write handle, then
' the FSInfo sector -- the same persistence pairing do_unmount runs, without
' unmounting. One copy of each routine means sync can never drift from unmount.
'
' History: this method once flushed only a pending F_NEWDIR directory entry.
' That flag provably cannot survive to a command boundary (v1.7.0 task #50: every
' do_movefile exit clears it or reaches do_close, which clears it), so for a
' while this was an honest no-op. But sync() is public API documented as
' "flush all pending writes" (TUTORIAL, THEORY, ERROR-HANDLING guides), so the
' no-op was a silent-dataloss trap wearing a SUCCESS return -- now it delivers
' what the name and the docs promise.
'
' Mode enforcement gates CMD_SYNC on MODE_FILESYSTEM, so mount state (and
' fsinfo_sec) is always valid here.
'
' @returns status - SUCCESS (0) if every dirty handle and FSInfo reached disk;
'                   first non-SUCCESS encountered otherwise. Failed handles
'                   stay dirty, so a later sync() retries them.

  if flags & F_NEWDIR
    ' Tripwire: should be impossible (see header). If this ever prints, some
    ' new exit path leaked a staged entry -- the ghost-entry bug class is back.
    DEBUG[CH_MOUNT]("  [do_sync] LEAKED F_NEWDIR -- an operation exited with a staged entry pending")

  status := do_sync_all()

  ' updateFSInfo() returns FALSE for "nothing to update" as well as for a real
  ' failure; fsinfo_error is what tells them apart (see do_unmount).
  updateFSInfo()
  if fsinfo_error < 0 AND status == SUCCESS
    status := fsinfo_error

PRI do_rename(old_name, new_name) : status | bookmark, temp_sec, idx, saved_entry[8], p_buf, name_83[4]
' Internal rename operation - renames file/directory by updating directory entry.
' Finds old file, saves entry, parses new_name into 8.3 format, writes back.
'
' @param old_name - Pointer to current filename string
' @param new_name - Pointer to new filename string
' @returns status - SUCCESS on success, E_FILE_NOT_FOUND on failure
' @local bookmark - Saved entry address
' @local temp_sec - Saved directory sector
' @local idx - Loop counter
' @local saved_entry - Saved directory entry (32 bytes = 8 longs)
' @local p_buf - Pointer to buffer position
' @local name_83 - Zeroed scratch for the 8.3 name conversion (16 bytes)

  DEBUG[CH_DIR]("  [do_rename] old=", zstr_(old_name), " new=", zstr_(new_name), " dir_sec=", udec_(cog_dir_sec[pb_caller]))
  if NOT searchDirectory(old_name)
    DEBUG[CH_DIR]("  [do_rename] Old file NOT FOUND")
    status := (search_io_status < 0) ? search_io_status : E_FILE_NOT_FOUND
  else
    DEBUG[CH_DIR]("  [do_rename] Found old file, entry_address=", uhex_(entry_address))
    bookmark := entry_address
    temp_sec := cog_dir_sec[pb_caller]
    bytemove(@saved_entry, @entry_buffer, DIR_ENTRY_SIZE)                       ' Save complete entry (32 bytes)
    ' Search the SAME DIRECTORY the old entry lives in, from its FIRST sector.
    ' entry_address >> SECTOR_SHIFT (used before) is the sector CONTAINING the
    ' old entry -- starting there skipped every earlier sector of a multi-sector
    ' directory, so a conflicting name in those sectors went undetected and the
    ' rename minted a duplicate. search_parent_sec is captured by the
    ' searchDirectory(old_name) call above.
    cog_dir_sec[pb_caller] := search_parent_sec
    idx := 0
    repeat until BYTE[new_name + idx] == $00
      if BYTE[new_name + idx] == "/"
        new_name += idx+1
        idx := 0
      idx++
    DEBUG[CH_DIR]("  [do_rename] Checking if new name exists...")
    if searchDirectory(new_name) <> 0                                           ' Verify new name doesn't exist
      DEBUG[CH_DIR]("  [do_rename] New name already exists!")
      status := E_FILE_EXISTS
    elseif search_io_status < 0
      ' FAIL CLOSED -- renaming onto a name we could not verify as free would leave
      ' two directory entries carrying the same name.
      DEBUG[CH_DIR]("  [do_rename] New-name check FAILED, refusing to rename")
      status := search_io_status
    else
      DEBUG[CH_DIR]("  [do_rename] New name doesn't exist, proceeding")
      bytemove(@entry_buffer, @saved_entry, DIR_ENTRY_SIZE)                     ' Restore complete entry
      if readSector(bookmark >> SECTOR_SHIFT, BUF_DIR) < 0
        DEBUG[CH_DIR]("  [do_rename] Directory read FAILED for sector ", udec_(bookmark >> SECTOR_SHIFT))
        status := E_IO_ERROR
      else
        ' Parse new_name into 8.3 format in a ZEROED SCRATCH, then copy exactly
        ' the 11-byte SFN field onto the live entry. Converting in place on the
        ' live entry clobbered DE_ATTR (byte 11): a 12-character name landed its
        ' last extension character on the attribute byte, and the extension
        ' rearrangement read byte 11 into the name even for shorter names.
        ' The conversion mirrors searchDirectory's creation-path conversion.
        p_buf := @dir_buf + (bookmark & SECTOR_OFFSET_MASK)
        idx := 0
        repeat until BYTE[new_name + idx] == "/" OR BYTE[new_name + idx] == $00
          idx++
        longfill(@name_83, 0, 4)
        bytemove(@name_83, new_name, idx <# SFN_WITH_DOT_LEN)                   ' Copy name, max 12 characters
        repeat idx from 0 TO SFN_WITH_DOT_LEN - 1                               ' Uppercase before 8.3 rearrangement
          case BYTE[@name_83][idx]
            "a".."z" : BYTE[@name_83][idx] -= ASCII_CASE_OFFSET
        idx := 0
        repeat strsize(@name_83) <# SFN_NAME_LEN + 1                            ' Search name for extension
          if BYTE[@name_83][idx++] == "."
            bytemove(@name_83 + SFN_NAME_LEN, @name_83 + idx, SFN_EXT_LEN)      '  move extension to byte 8
            bytefill(@name_83 + idx - 1, " ", SFN_NAME_LEN + 1 - idx)           '  fill space between name and extension
        bytefill(@name_83 + strsize(@name_83), " ", SFN_WITH_DOT_LEN - strsize(@name_83))
        bytemove(p_buf, @name_83, SFN_TOTAL_LEN)                                ' 11 bytes only -- DE_ATTR untouched
        ' The rewritten entry IS the entire product of a rename. If this write does
        ' not land the file simply keeps its old name, so reporting success would be
        ' telling the caller the rename happened when nothing changed on the card.
        bytemove(@entry_buffer, p_buf, DIR_ENTRY_SIZE)                          ' Capture what we are about to write
        if writeSector(bookmark >> SECTOR_SHIFT, BUF_DIR) < 0
          DEBUG[CH_DIR]("  [do_rename] Entry write FAILED for sector ", udec_(bookmark >> SECTOR_SHIFT))
          status := E_IO_ERROR
        else
          dir_sec_in_buf := -1                                                  ' Force re-read for verification
          if readSector(bookmark >> SECTOR_SHIFT, BUF_DIR) < 0
            DEBUG[CH_DIR]("  [do_rename] Verify read FAILED for sector ", udec_(bookmark >> SECTOR_SHIFT))
            status := E_IO_ERROR
          elseif NOT entryMatches(@dir_buf + (bookmark & SECTOR_OFFSET_MASK), @entry_buffer)
            DEBUG[CH_DIR]("  [do_rename] Verify MISMATCH at sector ", udec_(bookmark >> SECTOR_SHIFT))
            status := E_IO_ERROR
          else
            DEBUG[CH_DIR]("  [do_rename] SUCCESS")
            status := SUCCESS
    ' Restore the caller's working directory on EVERY path. It is redirected above
    ' so the new-name search runs in the file's own directory, and leaving it
    ' redirected on an error path silently moves the caller's CWD.
    cog_dir_sec[pb_caller] := temp_sec

PRI do_set_vol_label(p_label) : status | idx, ch, p_entry, label_83[3], pVBR
' Internal set volume label - updates BPB and root directory volume label entry.
'
' @param p_label - Pointer to new volume label string (max 11 chars)
' @returns status - SUCCESS on success, E_IO_ERROR on failure
' @local idx - Character index
' @local ch - Current character being processed
' @local p_entry - Pointer to directory entry
' @local label_83 - 11-byte buffer for formatted 8.3 label
' @local pVBR - Pointer to Volume Boot Record overlay

' Format label: uppercase, space-pad to 11 chars

  bytefill(@label_83, " ", SFN_TOTAL_LEN)
  idx := 0
  repeat while BYTE[p_label + idx] <> 0 AND idx < 11
    ch := BYTE[p_label + idx]
    if ch >= "a" AND ch <= "z"
      ch -= ASCII_CASE_OFFSET
    BYTE[@label_83][idx] := ch
    idx++

  DEBUG[CH_MOUNT]("  [do_set_vol_label] new label=[", lstr_(@label_83, SFN_TOTAL_LEN), "]")

  ' Step 1: Update BPB volume label (VBR sector)
  if readSector(vbr_sec, BUF_DATA) < 0
    DEBUG[CH_MOUNT]("  [do_set_vol_label] FAIL: read VBR")
    status := E_IO_ERROR
  else
    pVBR := @buf
    bytemove(vbrVolLabelAddr(pVBR), @label_83, SFN_TOTAL_LEN)
    if writeSector(vbr_sec, BUF_DATA) < 0
      DEBUG[CH_MOUNT]("  [do_set_vol_label] FAIL: write VBR")
      status := E_IO_ERROR

  ' Step 2: Find and update volume label entry in root directory
  if status == 0
    n_sec := root_sec
    if readSector(n_sec, BUF_DIR) < 0
      DEBUG[CH_MOUNT]("  [do_set_vol_label] FAIL: read root dir")
      status := E_IO_ERROR
    else
      idx := 0
      repeat
        p_entry := @dir_buf + (idx & SECTOR_OFFSET_MASK)
        if BYTE[p_entry] == $00                                                          ' End of directory
          quit
        if BYTE[p_entry] <> DIR_ENTRY_DELETED AND dirEntAttr(p_entry) == ATTR_VOLUME_ID  ' Volume label entry found
          bytemove(p_entry, @label_83, SFN_TOTAL_LEN)
          if writeSector(n_sec, BUF_DIR) < 0
            DEBUG[CH_MOUNT]("  [do_set_vol_label] FAIL: write root dir entry")
            status := E_IO_ERROR
          else
            DEBUG[CH_MOUNT]("  [do_set_vol_label] Updated root dir entry")
          quit
        idx += DIR_ENTRY_SIZE
        if idx & SECTOR_OFFSET_MASK == 0
          if readNextSector(BUF_DIR) < 0                                                '  cannot scan further -- do not read stale entries
            DEBUG[CH_MOUNT]("  [do_set_vol_label] FAIL: advance to next dir sector")
            status := E_IO_ERROR
            quit

      ' Step 3: Update in-memory copy -- only when the on-disk entry actually
      ' landed. This gate also protects the entry-write failure above, which
      ' set E_IO_ERROR only to have an unconditional SUCCESS overwrite it.
      if status == SUCCESS
        bytemove(@vol_label, @label_83, SFN_TOTAL_LEN)
        vol_label[11] := 0
        DEBUG[CH_MOUNT]("  [do_set_vol_label] SUCCESS")

PRI do_movefile(name_ptr, dest_folder) : status | bookmark, p_temp, temp_sec
' Internal move file operation - moves file from current directory to destination.
'
' @param name_ptr - Pointer to null-terminated filename to move
' @param dest_folder - Pointer to null-terminated destination folder name
' @returns status - SUCCESS on success, E_FILE_NOT_FOUND on failure
' @local bookmark - Saved entry address
' @local p_temp - Pointer to temporary filename buffer
' @local temp_sec - Saved directory sector

  status := E_FILE_NOT_FOUND
  p_temp := @"FILENAME.TXT"
  if do_open(name_ptr) == SUCCESS
    bookmark := entry_address
    bytemove(p_temp, filename(), 12)
    temp_sec := cog_dir_sec[pb_caller]
    if do_chdir(dest_folder) == SUCCESS
      if bookmark >> SECTOR_SHIFT == n_sec
        status := E_FILE_EXISTS                         ' Same directory
      elseif do_newfile(p_temp) == SUCCESS
        DEBUG[CH_DIR]("  [do_movefile] newfile OK, new entry_address=", uhex_(entry_address))
        DEBUG[CH_DIR]("  [do_movefile] Reading sector ", udec_(bookmark >> SECTOR_SHIFT), " (dir_sec_in_buf=", sdec_(dir_sec_in_buf), ")")
        ' NOTE: error_injection Test 34 arms THIS read by ordinal (3rd card read
        ' of the moveFile sequence) -- a caching change that renumbers moveFile's
        ' reads silently retargets that test; update its arming comment together
        ' with any change to what hits the card here.
        if readSector(bookmark >> SECTOR_SHIFT, BUF_DIR) < 0
          ' Source unreadable, so the source entry cannot be deleted -- abandon
          ' the move exactly as the source-delete WRITE failure below does.
          ' Before v1.7.0 this path returned with F_NEWDIR still set and the
          ' staged DESTINATION entry in entry_buffer, so the next do_close()
          ' from any operation wrote it: one file live in two directories.
          DEBUG[CH_DIR]("  [do_movefile] Directory read FAILED for sector ", udec_(bookmark >> SECTOR_SHIFT))
          abandonPendingEntry()
          status := E_IO_ERROR
        else
          DEBUG[CH_DIR]("  [do_movefile] After read: dir_buf[128]=[", lstr_(@dir_buf + 128, 11), "] dir_buf[", udec_(bookmark & SECTOR_OFFSET_MASK), "]=[", lstr_(@dir_buf + (bookmark & SECTOR_OFFSET_MASK), 11), "]")
          bytemove(@entry_buffer, @dir_buf + (bookmark & SECTOR_OFFSET_MASK), 32)
          DEBUG[CH_DIR]("  [do_movefile] Copied entry: [", lstr_(@entry_buffer, 11), "]")
          BYTE[@dir_buf + (bookmark & SECTOR_OFFSET_MASK)] := DIR_ENTRY_DELETED
          DEBUG[CH_DIR]("  [do_movefile] After $E5: dir_buf[128]=[", lstr_(@dir_buf + 128, 11), "]")
          if writeSector(bookmark >> SECTOR_SHIFT, BUF_DIR) < 0
            ' Source still live and the destination not yet written -- abandon the
            ' move rather than let do_close() add the second entry. F_NEWDIR must be
            ' cleared explicitly or the NEXT do_close() from any operation would
            ' write that destination entry and produce the duplicate anyway.
            DEBUG[CH_DIR]("  [do_movefile] Source-entry delete write FAILED for sector ", udec_(bookmark >> SECTOR_SHIFT))
            abandonPendingEntry()
            status := E_IO_ERROR
          else
            DEBUG[CH_DIR]("  [do_movefile] Calling do_close, flags=", uhex_(flags))
            ' do_close() writes the destination entry. If THAT fails the source is
            ' already gone, so the file is unreachable with its clusters still
            ' allocated -- a lost chain fsck can recover. Two writes cannot be made
            ' atomic; this order is chosen so the unavoidable failure leaks a chain
            ' rather than leaving one file live in two directories, where deleting
            ' either would free clusters the other still points at.
            status := do_close()
            if status < 0
              DEBUG[CH_DIR]("  [do_movefile] Destination entry write FAILED -- file is now unreferenced")
      else
        DEBUG[CH_DIR]("  [do_movefile] do_newfile FAILED")
    else
      DEBUG[CH_DIR]("  [do_movefile] do_chdir FAILED for: ", zstr(dest_folder))
    cog_dir_sec[pb_caller] := temp_sec

PRI do_readdir(entry_num) : status | idx, char, attrib
' Internal read directory operation - reads directory entry at specified index.
'
' @param entry_num - Entry index to read (0-based)
' @returns status - SUCCESS on success, E_FILE_NOT_FOUND if entry doesn't exist
' @local idx - Current byte offset in directory
' @local char - First character of entry
' @local attrib - Entry attributes

  status := E_FILE_NOT_FOUND
  idx := 0
  n_sec := cog_dir_sec[pb_caller]
  if readSector(n_sec, BUF_DIR) < 0
    DEBUG[CH_DIR]("  [do_readdir] Directory read FAILED for sector ", udec_(n_sec))
    status := E_IO_ERROR
  else
    repeat until entry_num == -1
      char := BYTE[@dir_buf + (idx & SECTOR_OFFSET_MASK)]
      attrib := BYTE[@dir_buf + (idx & SECTOR_OFFSET_MASK) + DE_ATTR_OFFSET]

      if char == $00
        quit                                            ' E_FILE_NOT_FOUND (default)
      elseif char <> DIR_ENTRY_DELETED
        if attrib & (ATTR_HIDDEN | ATTR_SYSTEM | ATTR_VOLUME_ID) == 0
          entry_num--
          if entry_num == -1
            bytemove(@entry_buffer, @dir_buf + (idx & SECTOR_OFFSET_MASK), 32)
            status := SUCCESS
      idx += DIR_ENTRY_SIZE
      if entry_num <> -1 AND idx & SECTOR_OFFSET_MASK == 0  '  entry_num == -1 means the entry was found; do not advance
        if readNextSector(BUF_DIR) < 0                      '  cannot advance -- report the I/O error rather than
          DEBUG[CH_DIR]("  [do_readdir] Advance to next dir sector FAILED")
          status := E_IO_ERROR                              '   letting stale buffer content look like directory entries
          quit

#ifdef SD_INCLUDE_RAW

PRI do_init_card_only() : status
' Internal card-only init (raw mode) - initialize card for raw sector access.
' Sets driver_mode to MODE_RAW without filesystem parsing.
'
' @returns status - SUCCESS on success, E_INIT_FAILED on failure

  dir_sec_in_buf := -1
  fat_sec_in_buf := -1
  sec_in_buf := -1
  DEBUG[CH_INIT]("  [do_init_card_only] Calling initCard()...")
  if initCard()
    DEBUG[CH_INIT]("  [do_init_card_only] Card initialized successfully")
    driver_mode := MODE_RAW
    DEBUG[CH_INIT]("  [do_init_card_only] SUCCESS, mode=RAW")
    if card_warning_flags & CW_CMD13_UNRELIABLE
      DEBUG[CH_INIT]("  [do_init_card_only] WARNING: CMD13 unreliable on this card - status checks disabled")
    status := SUCCESS
  else
    DEBUG[CH_INIT]("  [do_init_card_only] FAIL: initCard() returned false")
    driver_mode := MODE_NONE
    status := last_init_error

PRI do_get_card_size() : sectorCount | csd[4], c_size, read_bl_len, c_size_mult
' Internal get card size operation - returns total number of 512-byte sectors.
' Runs on worker cog where smart pins are configured.
'
' @returns sectorCount - Total number of 512-byte sectors on the card
' @local csd - CSD register data (4 longs = 16 bytes)
' @local c_size - Capacity size field from CSD
' @local read_bl_len - Read block length from CSD
' @local c_size_mult - Size multiplier from CSD

' Read CSD using CMD9

  if fetchCSD(@csd) <> SUCCESS
    DEBUG[CH_IDENT]("  [do_get_card_size] Failed to read CSD")
    sectorCount := 0
  else
    ' CSD structure version is in bits [127:126] (byte 0, bits 7:6)
    if (csd.BYTE[0] >> 6) == 0
      ' CSD Version 1.0 (SDSC)
      read_bl_len := csd.BYTE[5] & $0F
      c_size := (csd.BYTE[6] & $03) << 10
      c_size |= csd.BYTE[7] << 2
      c_size |= csd.BYTE[8] >> 6
      c_size_mult := (csd.BYTE[9] & $03) << 1
      c_size_mult |= csd.BYTE[10] >> 7
      sectorCount := (c_size + 1) << (c_size_mult + 2 + read_bl_len - 9)
      DEBUG[CH_IDENT]("  [do_get_card_size] CSD v1.0: ", udec(sectorCount), " sectors")
    else
      ' CSD Version 2.0 (SDHC/SDXC)
      c_size := (csd.BYTE[7] & $3F) << 16
      c_size |= csd.BYTE[8] << 8
      c_size |= csd.BYTE[9]
      sectorCount := (c_size + 1) << 10                 ' * 1024 sectors (512KB units)
      DEBUG[CH_IDENT]("  [do_get_card_size] CSD v2.0: ", udec(sectorCount), " sectors")

PRI do_test_cmd13() : r2_response | r1, status
' Internal CMD13 test - sends CMD13 and returns raw R2 response.
' Uses sendCmd13Transaction() for the wire transaction.
'
' @returns r2_response - R2 response word ($0000=OK, $FFFF=timeout, other=error)
' @local r1 - R1 response byte
' @local status - Status byte from R2

  r1, status := sendCmd13Transaction()
  if r1 == -1
    r2_response := $FFFF
  else
    r2_response := (r1 << 8) | status

#endif

#ifdef SD_INCLUDE_REGISTERS

PRI do_read_scr(p_buf) : status
' Internal read SCR operation - reads the 8-byte SCR register into buffer.
' Runs on worker cog where smart pins are configured.
'
' @param p_buf - Pointer to 8-byte buffer to receive SCR data
' @returns status - SUCCESS on success, E_IO_ERROR on failure

  status := fetchSCR(p_buf)
  if status == SUCCESS
    DEBUG[CH_IDENT]("  [do_read_scr] SCR read successfully")
  else
    DEBUG[CH_IDENT]("  [do_read_scr] SCR read failed: ", sdec_(status))

PRI do_read_cid(p_buf) : status
' Internal read CID operation - reads the 16-byte CID register into buffer.
' Runs on worker cog where smart pins are configured.
'
' @param p_buf - Pointer to 16-byte buffer to receive CID data
' @returns status - SUCCESS on success, E_IO_ERROR on failure

  status := fetchCID(p_buf)
  if status == SUCCESS
    DEBUG[CH_IDENT]("  [do_read_cid] CID read successfully")
  else
    DEBUG[CH_IDENT]("  [do_read_cid] CID read failed: ", sdec_(status))

PRI do_read_csd(p_buf) : status
' Internal read CSD operation - reads the 16-byte CSD register into buffer.
' Runs on worker cog where smart pins are configured.
'
' @param p_buf - Pointer to 16-byte buffer to receive CSD data
' @returns status - SUCCESS on success, E_IO_ERROR on failure

  status := fetchCSD(p_buf)
  if status == SUCCESS
    DEBUG[CH_IDENT]("  [do_read_csd] CSD read successfully")
  else
    DEBUG[CH_IDENT]("  [do_read_csd] CSD read failed: ", sdec_(status))

PRI do_read_sd_status(p_buf) : status
' Read SD Status register (ACMD13) - 64 bytes.
'
' @param p_buf - Pointer to 64-byte buffer to receive SD Status data
' @returns status - SUCCESS on success, E_IO_ERROR on failure

  status := fetchSDStatus(p_buf)
  if status == SUCCESS
    DEBUG[CH_IDENT]("  [do_read_sd_status] SD Status read successfully")
  else
    DEBUG[CH_IDENT]("  [do_read_sd_status] SD Status read failed: ", sdec_(status))

#endif

#ifdef SD_INCLUDE_SPEED

PRI clampUserSpeed(freq) : hz
' Production speed bound (2026-08-18, Stephen: above-ceiling SPI is "diagnostic /
' developer only"). Applied ONLY to user setSPISpeed() requests -- internal
' speed changes (init 400 kHz, setOptimalSpeed, the CMD6 high-speed path) are
' unaffected.
'
' Ceiling: the card's declared TRAN_SPEED capped at the SD SPI-mode 25 MHz,
' lifted to 50 MHz only while verified CMD6 high-speed mode is active. The
' 2026-08-17/18 socket campaign measured silent whole-sector write corruption
' where the fixed tx_align_delay phase pad meets above-spec frequencies (losing
' phase at pads 4,9 at hp=5 / 35 MHz on three of five cards; see
' DOCs/Plans/SOCKET-SHMOO-RUN-NOTES.md round 7b) -- nothing at or below the
' ceiling can reach that configuration. Characterization tools re-enable the
' full range via debugSetOverspeedAllowed() [SD_INCLUDE_DEBUG].
'
' @param freq - Requested SPI frequency in Hz
' @returns hz - The request, clamped to the production ceiling unless overridden

  hz := freq
  if overspeed_allowed
    return
  if hs_mode_active                                     ' Verified high-speed mode active
    hz := hz <# 50_000_000
  elseif card_max_speed_hz > 0
    hz := hz <# (card_max_speed_hz <# 25_000_000)
  else
    hz := hz <# 25_000_000                              ' Card not identified yet: SPI-mode ceiling

PRI do_attempt_high_speed() : hs_ok | idx, mismatch
' Internal attempt high-speed mode - queries, switches, and verifies at 50 MHz.
' Runs on worker cog where smart pins are configured.
' Uses existing DAT buffers (@buf and @dir_buf) instead of stack locals
' to stay within worker cog stack limits (STACK_SIZE=160 longs).
'
' VERIFY IS READ-ONLY (contract set 2026-08-09, v1.7.0). The baseline copy of
' the verification sector is captured at the CURRENT, known-good speed BEFORE
' CMD6, then the same sector is force-re-read at 50 MHz and compared. The old
' scheme did both reads at the suspect speed -- consistent corruption compared
' equal -- and wrote the root sector back at that suspect speed with the write
' status ignored, so a bad 50 MHz link could destroy the root directory during
' the very check meant to detect it.
'
' @returns hs_ok - TRUE if 50 MHz active, FALSE if fell back to 25 MHz
' @local idx - Loop counter
' @local mismatch - Count of mismatched longs

  DEBUG[CH_HSPEED]("  [do_attempt_high_speed] Attempting high-speed mode...")
  hs_query_error := SUCCESS

  if probeHighSpeed() <> SUCCESS
    ' The card could not be asked -- distinct from a card that answered "no". Only THIS
    ' branch is an error: a card that genuinely lacks the feature is a normal outcome.
    DEBUG[CH_HSPEED]("  [do_attempt_high_speed] Could not determine high-speed support")
    hs_query_error := E_IO_ERROR
  elseif NOT hs_supported
    ' Asked and answered: this card does not offer high speed
    DEBUG[CH_HSPEED]("  [do_attempt_high_speed] Card does not support high-speed")
  elseif readSector(root_sec, BUF_DATA) < 0
    ' Baseline capture at the current known-good speed. Without a trusted
    ' baseline the 50 MHz verify proves nothing, so no switch is attempted.
    DEBUG[CH_HSPEED]("  [do_attempt_high_speed] Baseline read FAILED at current speed")
    hs_query_error := E_IO_ERROR
  else
    bytemove(@dir_buf, @buf, SECTOR_SIZE)               ' Known-good baseline into dir_buf

    if applyHighSpeed() <> SUCCESS
      ' Switch to high-speed mode
      DEBUG[CH_HSPEED]("  [do_attempt_high_speed] Failed to switch to high-speed")
      hs_query_error := E_IO_ERROR
      applyDefaultSpeedMode()                           ' Card state unknown after a failed switch -- force default mode
    else
      ' Set 50 MHz SPI clock
      applySPISpeed(50_000_000)
      DEBUG[CH_HSPEED]("  [do_attempt_high_speed] SPI set to 50 MHz, verifying (read-only)...")

      bytefill(@buf, $AA, SECTOR_SIZE)                  ' Poison so a failed transfer cannot alias the baseline
      sec_in_buf := -1                                  ' Force a REAL 50 MHz read -- a cache hit would verify nothing
      if readSector(root_sec, BUF_DATA) < 0             ' Re-read the baseline sector at 50 MHz
        DEBUG[CH_HSPEED]("  [do_attempt_high_speed] Verify read FAILED at 50 MHz - falling back to 25 MHz")
        hs_query_error := E_IO_ERROR
        applySPISpeed(25_000_000)                       ' An unverified 50 MHz link must not stay active
        applyDefaultSpeedMode()                         ' ...and neither may the CARD stay in high-speed mode
      else
        ' Compare dir_buf (safe-speed baseline) vs buf (50 MHz re-read) long-by-long
        mismatch := 0
        repeat idx from 0 TO FAT_ENTRIES_PER_SECTOR - 1
          if LONG[@dir_buf][idx] <> LONG[@buf][idx]
            mismatch++

        if mismatch > 0
          DEBUG[CH_HSPEED]("  [do_attempt_high_speed] VERIFICATION FAILED - ", udec_(mismatch), " long mismatches")
          DEBUG[CH_HSPEED]("  [do_attempt_high_speed] Falling back to 25 MHz")
          applySPISpeed(25_000_000)
          applyDefaultSpeedMode()                       ' Card must not stay in high-speed mode either
          sec_in_buf := -1                              ' buf holds the suspect-speed bytes -- must not stay cached as valid
        else
          DEBUG[CH_HSPEED]("  [do_attempt_high_speed] VERIFIED - 50 MHz high-speed mode ACTIVE")
          hs_mode_active := true                        ' The ONE place the card enters high-speed mode
          hs_ok := true

    ' Invalidate dir cache since we borrowed dir_buf as the baseline copy
    dir_sec_in_buf := -1

PRI do_check_hs_capability() : capable | status[16]
' Internal check high-speed capability - queries CMD6 function group 1.
' Runs on worker cog where smart pins are configured.
'
' Returns an HONEST BOOLEAN: FALSE means the card said no. Whether the card could be
' asked at all is a separate question, and it travels in hs_query_error -- otherwise a
' card with SPI trouble reports "high speed not supported" and sends whoever is
' diagnosing it after the wrong thing entirely.
'
' @returns capable - TRUE if high-speed function is supported (see hs_query_error)
' @local status - CMD6 status structure (16 longs = 64 bytes)

  hs_query_error := issueCMD6($00FFFFF1, @status)
  if hs_query_error <> SUCCESS
    capable := false
  else
    capable := (status.BYTE[13] & $02) <> 0

#endif

CON ' ---- SD Directory / FAT Operations ----

PRI searchDirectory(name_ptr) : bFound | p_temp, p_entry, idx, search_sec, jdx, adv
' Search directory for a file/directory by name.
'
' FALSE HAS TWO MEANINGS AND THE COMPANION FIELD IS WHAT SEPARATES THEM: "the name is
' not there" and "the directory could not be read". Every caller must consult
' search_io_status before acting on FALSE. The dangerous reading is the existence
' check -- do_create/do_newfile/do_newdir/do_create_contiguous and do_rename's
' new-name check all treat FALSE as "the name is available", so an unchecked read
' failure makes the driver write a SECOND directory entry and allocate a SECOND
' cluster chain for a file that already exists: two entries, two chains, one name.
' Those paths must fail closed.
'
' The signal is a companion field rather than a status return because SUCCESS is 0
' and 0 is FALSE in Spin2, so converting this to a status return would silently
' invert the sense of all fourteen call sites (do_delete's
' `searchDirectory(name) == 0` means NOT FOUND today and would mean FOUND after).
' tools/check_error_handling.sh rule 3 flags any call site that ignores the field.
'
' DO NOT factor the repeated `(search_io_status < 0) ? search_io_status :
' E_FILE_NOT_FOUND` in the callers into a helper. Rule 3 detects consultation by
' looking for the identifier `search_io_status` inside each calling method; hiding
' it behind a helper removes the identifier and every one of those call sites
' silently starts failing the check that this pattern depends on.
'
' MATCHING CONTRACT: only live short-name entries participate in matching.
' Slots whose first byte is $E5 (deleted residue) and slots with the
' ATTR_VOLUME_ID bit set (the volume label; every LFN fragment carries the bit
' via $0F) are invisible to the name search -- a dot-less label of <=11 chars
' is byte-identical to a search key and would otherwise be renameable,
' openable, and collide with create. $E5 slots filtered from matching still
' mint as free slots; volume-ID/LFN slots do not (their first byte is never
' $E5/$00). Per-caller attribute filters (do_open, do_delete, do_open_dir)
' stay as defense-in-depth on top of this central filter.
'
' @param name_ptr - Pointer to null-terminated filename string
' @returns bFound - TRUE if found, FALSE if absent OR unreadable (see search_io_status)
' @local p_temp - Pointer to temporary filename buffer
' @local p_entry - Pointer to current directory entry
' @local idx - Loop counter
' @local search_sec - Local directory sector for path resolution
' @local jdx - Loop counter for case-insensitive name comparison
' @local adv - Last readNextSector() status: END_OF_CHAIN means the buffer holds
'              served zeros and n_sec is OUTSIDE the directory's chain, so no
'              free-slot address may be minted from the current scan position

  search_io_status := SUCCESS
  p_temp := @"FILENAMETXT"
  search_sec := cog_dir_sec[pb_caller]
  if BYTE[name_ptr] == "/"
    search_sec := root_sec
    name_ptr++
  n_sec := search_sec

  repeat until BYTE[name_ptr] == $00
    bytefill(@entry_buffer, 0, DIR_ENTRY_SIZE)
    idx := 0

    repeat until BYTE[name_ptr + idx] == "/" OR BYTE[name_ptr + idx] == $00                       '  advance idx up to "/" or null
      idx++
    bytemove(@entry_buffer,name_ptr,idx <# 12)                                                    '  copy name into entry_buffer, max 12 characters
    name_ptr += idx                                                                               '  advance ptr to "/" or null
    if BYTE[name_ptr] == "/"                                                                      '  if "/"
      name_ptr++                                                                                  '   advance ptr to byte following "/"

    repeat idx from 0 TO SFN_WITH_DOT_LEN - 1                                                     '  convert name to uppercase
      case BYTE[@entry_buffer][idx]
        "a".."z" : BYTE[@entry_buffer][idx] -= ASCII_CASE_OFFSET

    idx := 0                                                                                      '  convert 8.3 filename into short filename
    ' do_rename mirrors this conversion on its own scratch -- keep the two in lockstep
    if strcomp(@entry_buffer,string("..")) == 0                                                   '  exception if changing directory to ".."
      repeat strsize(@entry_buffer) <# 9                                                          '  search name for extension
        if BYTE[@entry_buffer][idx++] == "."                                                      '  if extension found
          bytemove(@entry_buffer + 8,@entry_buffer + idx,3)                                       '   move extension to byte 8
          bytefill(@entry_buffer + idx-1," ",9-idx)                                               '   fill space between name and extension
    bytefill(@entry_buffer + strsize(@entry_buffer)," ",SFN_WITH_DOT_LEN-strsize(@entry_buffer))  ' fill remaining space (in case extension < 3 characters)
    BYTE[@entry_buffer][SFN_TOTAL_LEN] := $00                                                     '  append null

    idx := 0
    search_parent_sec := n_sec                                                                    '  first sector of the directory this component is scanned in (do_rename's duplicate check starts here)
    DEBUG[CH_DIR]("  [searchDir] Starting search at n_sec=", udec_(n_sec), " for [", lstr_(@entry_buffer, 11), "]")
    if readSector(n_sec, BUF_DIR) < 0                                                             '  read 1st sector of directory
      DEBUG[CH_DIR]("  [searchDir] Directory read FAILED for sector ", udec_(n_sec))
      search_io_status := E_IO_ERROR                                                              '   FALSE here means "could not look", not "not there"
      bFound := false
      quit
    DEBUG[CH_DIR]("  [searchDir] After read: dir_buf[0]=[", lstr_(@dir_buf, 11), "] dir_buf[32]=[", lstr_(@dir_buf + 32, 11), "]")
    entry_address := 0
    adv := SUCCESS
    repeat
      p_entry := @dir_buf + (idx & SECTOR_OFFSET_MASK)                                            '  locate entry in directory (FIXED precedence)
      bytemove(p_temp,p_entry,SFN_TOTAL_LEN)                                                      '  copy short filename into p_temp
      BYTE[p_temp + SFN_TOTAL_LEN] := 0                                                           '  null terminate for comparison
      repeat jdx from 0 TO SFN_TOTAL_LEN - 1                                                      '  uppercase on-disk entry for case-insensitive match
        case BYTE[p_temp + jdx]
          "a".."z" : BYTE[p_temp + jdx] -= ASCII_CASE_OFFSET
      ' MATCH FILTER: only live short-name entries are name-addressable -- see
      ' the MATCHING CONTRACT paragraph in this method's header
      if BYTE[p_entry] <> DIR_ENTRY_DELETED AND ((dirEntAttr(p_entry) & ATTR_VOLUME_ID) == 0) AND strcomp(@entry_buffer,p_temp)  '  if matching LIVE entry located
        bFound := true                                                                            '   mark path component as found
        entry_address := (n_sec << SECTOR_SHIFT) | (idx & SECTOR_OFFSET_MASK)                     '   store the byte-level address of the entry
        bytemove(@entry_buffer,p_entry, DIR_ENTRY_SIZE)                                           '   copy entire entry into entry_buffer
        DEBUG[CH_DIR]("  [searchDir] FOUND at idx=", udec_(idx), " firstCluster=", udec_(firstCluster()), " n_sec will be ", udec_(clus2sec(firstCluster())))
        if firstCluster() == 0                                                                    '  exception if ".." points to root directory
          n_sec := clus2sec(2)                                                                    '   root directory located in cluster 2
        else
          n_sec := clus2sec(firstCluster())                                                       '   set n_sec to 1st sector of 1st cluster of file
        quit
      elseif BYTE[name_ptr] == $00                                                                '  if end of path reached
        ' A slot may only be minted from a sector that IS in the directory's chain.
        ' Past END_OF_CHAIN the buffer holds served zeros and n_sec is the next
        ' physical LBA -- a "free slot" built from it would hand do_create/do_newfile
        ' /do_newdir a FOREIGN sector to write a directory entry into. A full
        ' terminator-less directory (legal FAT32, typically PC-written) therefore
        ' leaves entry_address == 0 and the create paths fail closed.
        if (entry_address == 0) AND (adv <> END_OF_CHAIN) AND (BYTE[p_temp] == DIR_ENTRY_DELETED OR BYTE[p_temp] == $00)  '  if entry_address not set, and 1st byte is $E5 or $00
          entry_address := (n_sec << SECTOR_SHIFT) | (idx & SECTOR_OFFSET_MASK)                   '    set entry_address to 1st unused entry (for newFile / newDirectory)
          DEBUG[CH_DIR]("  [searchDir] Free slot at n_sec=", udec_(n_sec), " idx=", udec_(idx), " entry_address=$", uhex_(entry_address))

      if BYTE[p_temp] == $00                                                                      '  entry not found in directory
        bFound := false
        quit
      idx += DIR_ENTRY_SIZE                                                                       '  increment to next entry
      if idx & SECTOR_OFFSET_MASK == 0                                                            '  read new directory sector/cluster if needed
        adv := readNextSector(BUF_DIR)
        if adv < 0                                                                                '   cannot advance -- stop rather than scan a stale buffer
          DEBUG[CH_DIR]("  [searchDir] Advance to next dir sector FAILED")
          search_io_status := E_IO_ERROR                                                          '   the search was cut short, so FALSE is not an answer
          bFound := false
          quit
    if NOT bFound                                                                                 '  if entry not found in directory
      quit                                                                                        '   stop searching remaining path components

PRI firstCluster() : cluster
' Return the 1st cluster location of the currently opened file.
'
' @returns cluster - First cluster number (combined from entry bytes $14-$15 and $1A-$1B)

  cluster := dirEntStartClus(@entry_buffer)

PRI readFat(cluster) : pFatEntry
' Read a FAT location and return a pointer to the location of that entry.
'
' The return is a pointer, so it cannot carry a failure code: on a read failure
' this still hands back a dereferenceable address into fat_buf, but the contents
' are whatever the previous read left there. EVERY CALLER MUST CHECK
' fat_io_status BEFORE DEREFERENCING -- a chain walk that trusts a stale link
' follows it into another file's clusters.
'
' @param cluster - Cluster number to look up
' @returns pFatEntry - Pointer to FAT entry in fat_buf (contents valid only when fat_io_status == SUCCESS)

  fat_io_status := SUCCESS
  if readSector((cluster >> 7 + fat_sec), BUF_FAT) < 0  '  128 entries in each FAT sector
    DEBUG[CH_SECTOR]("  [readFat] FAT read FAILED for cluster ", udec_(cluster))
    fat_io_status := E_IO_ERROR
    pFatEntry := @fat_buf                               '  Valid pointer but caller gets stale data
  else
    pFatEntry := @fat_buf + ((cluster << 2) & SECTOR_OFFSET_MASK)

PRI allocateCluster(cluster) : result | fat_idx, buf_idx, high_bits, start_fat_idx, fat_limit, wrapped
' Search FAT for an empty cluster, allocate it, and return cluster number.
' If cluster parameter is non-zero, links the new cluster to that chain.
' Uses next-fit scanning: starts after previous cluster (or fsi_nxt_free hint)
' and wraps around to cluster 2 if end-of-FAT is reached without finding free space.
'
' HALF-WRITTEN STATE. Allocation is four writes (new cluster FAT1 + FAT2 mirror,
' then chain-link FAT1 + FAT2 mirror) and any of them can fail with the earlier
' ones already on the card. The rule is the same at every one of those points:
' return E_IO_ERROR and never report the cluster as allocated. The consequence is
' deliberate -- a cluster whose FAT1 entry landed becomes a LEAKED cluster, marked
' in use and owned by no file, recoverable by fsck. The alternative, handing the
' number back after a partial write, is a cross-link: the same cluster given to a
' second file later, both reported as successful writes, and unrecoverable. A leak
' costs space; a cross-link costs data. Free-count and next-free bookkeeping are
' therefore applied only when all required writes landed.
'
' @param cluster - Previous cluster to link (0 for new chain)
' @returns result - Cluster number on success, negative error code on failure
' @local fat_idx - Current FAT byte index
' @local buf_idx - Index within FAT buffer
' @local high_bits - Preserved high 4 bits of FAT entry
' @local start_fat_idx - Where scan began (for wrap-around termination)
' @local fat_limit - End of FAT in bytes (sec_per_fat * SECTOR_SIZE)
' @local wrapped - TRUE if scan has wrapped around to cluster 2

' Next-fit: choose starting scan position

  if cluster > 0
    fat_idx := (cluster + 1) << 2                                                ' Start after previous cluster
  elseif fsi_nxt_free >= ROOT_CLUSTER AND fsi_nxt_free +< sec_per_fat << 7       ' Hint sane: within this FAT's entry count, UNSIGNED
    ' The hint comes off the card (FSInfo sector) and is untrusted. The compare
    ' must be unsigned and on the RAW hint: a garbage hint >= $2000_0000 passes
    ' the signed lower bound, goes NEGATIVE after << 2, and a signed >= fat_limit
    ' check never catches it. +< also rejects $FFFF_FFFF ("no hint") for free.
    fat_idx := fsi_nxt_free << 2                                                 ' Use FSInfo hint for new chains
  else
    fat_idx := 8                                                                 ' Default: cluster 2

  fat_limit := sec_per_fat << SECTOR_SHIFT                                       ' End of FAT in bytes
  if fat_idx +>= fat_limit                                                       ' Guard: if start is past end, wrap to cluster 2 (unsigned, matches hint guard)
    fat_idx := 8
#ifdef SD_INCLUDE_TEST_HOOKS
  if test_max_clusters > 0 AND (fat_idx >> 2) >= test_max_clusters               ' Guard: if start is past test limit, wrap
    fat_idx := 8
#endif
  start_fat_idx := fat_idx                                                       ' Remember where we started (for wrap detection)
  wrapped := false

  if readSector(fat_sec + (fat_idx >> SECTOR_SHIFT), BUF_FAT) < 0                ' Pre-load FAT sector at starting position
    DEBUG[CH_SECTOR]("  [allocateCluster] FAT pre-load FAILED")
    result := E_IO_ERROR
  else
    '   if cluster parameter <> 0, writes newly allocated cluster number in parameter cell
    repeat
      if fat_idx & SECTOR_OFFSET_MASK == 0 AND fat_idx > 0                       '  if at sector boundary (but not first iteration)
        if fat_idx >= fat_limit                                                  '   past end of FAT?
          if wrapped                                                             '    already wrapped once - entire FAT scanned
            result := E_DISK_FULL
            quit
          fat_idx := 8                                                           '    wrap to cluster 2
          wrapped := true
        if wrapped AND fat_idx >= start_fat_idx                                  '   wrapped and reached starting point?
          result := E_DISK_FULL
          quit
        if readSector(fat_sec + fat_idx >> SECTOR_SHIFT, BUF_FAT) < 0            '   load next sector of FAT
          DEBUG[CH_SECTOR]("  [allocateCluster] FAT scan read FAILED")
          result := E_IO_ERROR
          quit
      buf_idx := fat_idx & SECTOR_OFFSET_MASK
#ifdef SD_INCLUDE_TEST_HOOKS
      if test_max_clusters > 0 AND (fat_idx >> 2) >= test_max_clusters           '  test hook: artificial cluster limit
        if wrapped                                                               '   already wrapped - all visible clusters scanned
          result := E_DISK_FULL
          quit
        fat_idx := 8                                                             '   wrap to cluster 2
        buf_idx := 8
        wrapped := true
        if fat_idx >= start_fat_idx                                              '   started at cluster 2? nowhere left to scan
          result := E_DISK_FULL
          quit
#endif
      result := LONG[@fat_buf + buf_idx]                                         '  read a cluster cell
      if (result & FAT32_ENTRY_MASK) == $0000_0000                               '  if cluster cell is empty (check only low 28 bits)
        high_bits := result & FAT32_RESERVED_MASK                                '  preserve high 4 bits
        LONG[@fat_buf + buf_idx] := high_bits | FAT32_EOC_MARK                   '  mark as end-of-chain, preserve high bits
        result := fat_idx >> 2                                                   '  store cluster number in result
        if writeSector(fat_sec + result >> 7, BUF_FAT) < 0                       '  write FAT1 sector
          DEBUG[CH_SECTOR]("  [allocateCluster] FAT1 write FAILED for cluster ", udec_(result))
          result := E_IO_ERROR                                                   '   nothing landed: the card still shows this
          quit                                                                   '   cluster free, so it must NOT be handed out
        if writeSector(fat2_sec + result >> 7, BUF_FAT) < 0                      '  write FAT2 sector (MIRROR)
          DEBUG[CH_SECTOR]("  [allocateCluster] FAT2 mirror write FAILED for cluster ", udec_(result))
          result := E_IO_ERROR                                                   '   see HALF-WRITTEN STATE above: cluster leaks
          quit
        if cluster <> 0                                                          '  if allocateCluster was called with a non-zero cluster parameter
          if readSector(fat_sec + cluster >> 7, BUF_FAT) < 0                     '   read FAT sector containing cluster cell
            DEBUG[CH_SECTOR]("  [allocateCluster] FAT chain-link read FAILED - cluster orphaned")
            result := E_IO_ERROR
          else
            buf_idx := (cluster << 2) & SECTOR_OFFSET_MASK
            high_bits := LONG[@fat_buf + buf_idx] & FAT32_RESERVED_MASK          '  preserve high 4 bits
            LONG[@fat_buf + buf_idx] := high_bits | (result & FAT32_ENTRY_MASK)  '  link to new cluster, preserve high bits
            if writeSector(fat_sec + cluster >> 7, BUF_FAT) < 0                  '  write FAT1 sector
              DEBUG[CH_SECTOR]("  [allocateCluster] chain-link FAT1 write FAILED - cluster orphaned")
              result := E_IO_ERROR                                               '   new cluster is allocated but unreachable
            elseif writeSector(fat2_sec + cluster >> 7, BUF_FAT) < 0             '  write FAT2 sector (MIRROR)
              DEBUG[CH_SECTOR]("  [allocateCluster] chain-link FAT2 mirror write FAILED")
              result := E_IO_ERROR
        if result >= 0                                                           '  bookkeeping only when the allocation truly landed
          if fsi_free_count <> $FFFF_FFFF                                        '   track free count incrementally
            fsi_free_count--                                                     '   (avoids slow FAT scan on unmount)
          fsi_nxt_free := result + 1                                             '   update next-free hint (Decision #3)
        quit
      fat_idx += 4                                                               '  advance index to next cluster cell
      if fat_idx >= fat_limit AND NOT wrapped                                    '  past end of FAT? wrap around
        fat_idx := 8
        wrapped := true
        if readSector(fat_sec, BUF_FAT) < 0                                      '   pre-load first FAT sector after wrap
          DEBUG[CH_SECTOR]("  [allocateCluster] FAT wrap pre-load FAILED")
          result := E_IO_ERROR
          quit
      elseif wrapped AND fat_idx >= start_fat_idx                                '  wrapped and back to start?
        result := E_DISK_FULL
        quit

PRI clearCluster(cluster) : status
' Initialize entire contents of cluster to 0 - used for new directories.
'
' Every sector must land. A caller that ignores the status can report a new
' directory as created while its cluster still holds whatever was there before,
' which then reads back as a directory full of garbage entries.
'
' @param cluster - Cluster number to clear
' @returns status - SUCCESS when every sector was written, E_IO_ERROR otherwise

  status := SUCCESS
  n_sec := clus2sec(cluster)                            '  set n_sec to 1st sector of specified cluster
  bytefill(@dir_buf, 0, SECTOR_SIZE)                    '  clear directory buffer
  repeat sec_per_clus                                   '  repeat for all sectors in the cluster
    if writeSector(n_sec++, BUF_DIR) < 0                '   overwrite sector
      DEBUG[CH_SECTOR]("  [clearCluster] Write FAILED for sector ", udec_(n_sec - 1))
      status := E_IO_ERROR
      quit
  if status == SUCCESS
    dir_sec_in_buf := n_sec - 1                         '  dir_buf holds this sector's (zeroed) contents
  else
    dir_sec_in_buf := -1                                '  the write did not land, so the buffer describes nothing on disk

PRI readNextSector(buf_type) : status | cluster, address, contents
' Load the next sector into buffer - follows FAT chain at cluster boundaries.
'
' A caller that ignores the status interprets whatever the buffer happens to
' hold -- stale content from the previous sector, or the zeros written on the
' end-of-chain path -- as real directory entries.
'
' @param buf_type - Buffer type: BUF_DIR, BUF_FAT, or BUF_DATA
' @returns status - SUCCESS on success, END_OF_CHAIN (positive, so `< 0` error
'                   checks are unaffected) when the chain ended and zeros were
'                   served, E_IO_ERROR if a FAT or data read failed
' @local cluster - Current cluster number
' @local address - FAT entry address
' @local contents - FAT entry contents

  status := SUCCESS
  n_sec++
  if ((n_sec - cluster_offset) & (sec_per_clus - 1)) == 0                       '  if next sector is in a different cluster
    cluster := sec2clus(n_sec-1)                                                '   find current cluster number
    if readSector(cluster >> 7 + fat_sec, BUF_FAT) < 0                          '   read sector of FAT containing cluster number (128 cluster entries in each FAT sector)
      DEBUG[CH_SECTOR]("  [readNextSector] FAT read FAILED for cluster ", udec_(cluster))
      status := E_IO_ERROR
    else
      address := @fat_buf + ((cluster << 2) & SECTOR_OFFSET_MASK)               '   find long within FAT buffer for current cluster
      contents := LONG[address] & FAT32_ENTRY_MASK                              '   next cluster number (top 4 bits reserved -- masked)
      if contents +>= FAT32_EOC_MIN                                             '   end-of-chain marker detected
        ' Zeros are served in place of a sector that does not exist. The tier's
        ' cache tag must not keep naming the LAST REAL sector while the buffer
        ' holds these zeros -- a later readSector() of that sector would
        ' cache-hit zeros and read a real directory sector as empty. n_sec now
        ' also points OUTSIDE the chain (next physical LBA); END_OF_CHAIN tells
        ' callers not to treat scan positions derived from it as real (see
        ' searchDirectory's free-slot suppression).
        case buf_type
          BUF_DIR:
            bytefill(@dir_buf, 0, SECTOR_SIZE)
            dir_sec_in_buf := -1
          BUF_FAT:
            bytefill(@fat_buf, 0, SECTOR_SIZE)
            fat_sec_in_buf := -1
          other:
            bytefill(@buf, 0, SECTOR_SIZE)
            sec_in_buf := -1
        status := END_OF_CHAIN
      else
        n_sec := clus2sec(contents)                                             '   convert next cluster number into sector number
        if readSector(n_sec, buf_type) < 0
          DEBUG[CH_SECTOR]("  [readNextSector] Sector read FAILED for sector ", udec_(n_sec))
          status := E_IO_ERROR
  else
    if readSector(n_sec, buf_type) < 0
      DEBUG[CH_SECTOR]("  [readNextSector] Sector read FAILED for sector ", udec_(n_sec))
      status := E_IO_ERROR

PRI updateFSInfo() : bSuccess | pFSI
' Update FSInfo sector with current free cluster count.
' Uses cached fsi_free_count (tracked incrementally during alloc/delete).
' Called by unmount() to ensure other OSes see correct free space.
'
' A FALSE return alone does not mean failure -- "there was nothing to update" and
' "the update failed" are different outcomes. The companion field fsinfo_error
' separates them: it stays SUCCESS when there was simply nothing to do, and
' carries the error code when an update was attempted and did not land.
'
' @returns bSuccess - TRUE when the FSInfo sectors were updated, FALSE otherwise
' @local pFSI - Pointer overlaid on buf for fsinfo_t struct access

  fsinfo_error := SUCCESS
  if fsinfo_sec == 0 OR fsi_free_count == $FFFF_FFFF
    DEBUG[CH_MOUNT]("  [updateFSInfo] No valid FSInfo to update")  '  not a failure -- fsinfo_error stays SUCCESS
  elseif readSector(vbr_sec + fsinfo_sec, BUF_DATA) < 0
    DEBUG[CH_MOUNT]("  [updateFSInfo] FSInfo read FAILED")
    fsinfo_error := E_IO_ERROR
  else
    pFSI := @buf                                        '  overlay FSInfo

    ' Verify signatures before writing
    if fsiLeadSig(pFSI) <> FSINFO_LEAD_SIG OR fsiStructSig(pFSI) <> FSINFO_STRUCT_SIG
      DEBUG[CH_MOUNT]("  [updateFSInfo] Invalid FSInfo signatures")
      fsinfo_error := E_BAD_FSINFO
    else
      ' Update free count and next-free hint
      fsiSetFreeClusters(pFSI, fsi_free_count)          '  FSI_Free_Count (cached value)
      fsiSetNextFreeHint(pFSI, fsi_nxt_free)            '  FSI_Nxt_Free (keep cached value)

      ' Write updated FSInfo sector (primary + backup at sector 7). Report
      ' success only when BOTH writes land; a successful primary with a failed
      ' backup is still a partial failure -- the backup exists precisely so
      ' other OSes can recover from a torn primary.
      if writeSector(vbr_sec + fsinfo_sec, BUF_DATA) < 0
        DEBUG[CH_MOUNT]("  [updateFSInfo] Primary FSInfo write FAILED")
        fsinfo_error := E_IO_ERROR
      elseif writeSector(vbr_sec + 7, BUF_DATA) < 0      '  backup FSInfo at sector 7
        DEBUG[CH_MOUNT]("  [updateFSInfo] Backup FSInfo write FAILED")
        fsinfo_error := E_IO_ERROR
      else
        DEBUG[CH_MOUNT]("  [updateFSInfo] Updated primary+backup: free_count=", udec(fsi_free_count))
        bSuccess := true

PRI countFreeClusters() : count | fat_idx, entry
' Count free clusters in FAT - scans entire FAT for zero entries.
' This is slow on large cards but only called on unmount().
'
' @returns count - Number of free clusters
' @local fat_idx - Current FAT byte index
' @local entry - Current FAT entry value

  count := 0
  fat_idx := ROOT_CLUSTER * 4                                                   '  start at cluster 2 (skip reserved entries 0,1)
  repeat
    if fat_idx & SECTOR_OFFSET_MASK == 0                                        '  if at sector boundary
      if fat_idx >> SECTOR_SHIFT >= sec_per_fat                                 '  if past end of FAT
        quit
      if readSector(fat_sec + fat_idx >> SECTOR_SHIFT, BUF_FAT) < 0             '  read next FAT sector
        DEBUG[CH_SECTOR]("  [countFreeClusters] FAT read FAILED, returning partial count")
        quit
    entry := LONG[@fat_buf + (fat_idx & SECTOR_OFFSET_MASK)]
    if (entry & FAT32_ENTRY_MASK) == 0                                          '  check only low 28 bits
      count++
    fat_idx += 4
  fat_sec_in_buf := -1                                                          '  invalidate FAT buffer

PRI freeClusterChain(first_cluster) : status | clus, next_clus, last_clus, fat_sector, loop_count
' Walk a FAT chain and mark every cluster as free (zero entry).
' Writes both FAT1 and FAT2 (mirror) at sector boundaries and at end.
' Used by do_delete() and compactFile().
'
' @param first_cluster - First cluster of the chain to free
' @returns status - SUCCESS or E_IO_ERROR on safety limit

  status := SUCCESS
  clus := first_cluster
  last_clus := first_cluster
  loop_count := 0
  if clus >= ROOT_CLUSTER
    repeat
      next_clus := LONG[readFat(clus)] & FAT32_ENTRY_MASK                       '  top 4 bits reserved -- 28-bit cluster number
      if fat_io_status < 0                                                      '  stale link -- abort BEFORE zeroing anything.
        DEBUG[CH_FILE]("  [freeClusterChain] FAT read FAILED at cluster ", udec_(clus))
        status := E_IO_ERROR                                                    '   Following a garbage link would free clusters
        quit                                                                    '   belonging to other files.
      LONG[@fat_buf + ((clus << 2) & SECTOR_OFFSET_MASK)] := 0                  '  zero the FAT entry
      if fsi_free_count <> $FFFF_FFFF                                           '  track free count incrementally
        fsi_free_count++
      last_clus := clus
      if (next_clus >> 7) - (clus >> 7) <> 0                                    '  different FAT sector? (explicit precedence)
        fat_sector := clus >> 7
        if writeSector(fat_sector + fat_sec, BUF_FAT) < 0
          DEBUG[CH_FILE]("  [freeClusterChain] FAT1 write FAILED at sector ", udec_(fat_sector))
          status := E_IO_ERROR
          quit
        if writeSector(fat_sector + fat2_sec, BUF_FAT) < 0
          DEBUG[CH_FILE]("  [freeClusterChain] FAT2 write FAILED at sector ", udec_(fat_sector))
          status := E_IO_ERROR
          quit
      clus := next_clus
      loop_count++
      if loop_count > 100000                                                    '  safety limit
        status := E_IO_ERROR
        quit
    until next_clus +>= FAT32_EOC_MIN
    ' Always write the FAT sector containing the last freed cluster
    if status == SUCCESS
      fat_sector := last_clus >> 7
      if writeSector(fat_sector + fat_sec, BUF_FAT) < 0
        DEBUG[CH_FILE]("  [freeClusterChain] final FAT1 write FAILED at sector ", udec_(fat_sector))
        status := E_IO_ERROR
      elseif writeSector(fat_sector + fat2_sec, BUF_FAT) < 0
        DEBUG[CH_FILE]("  [freeClusterChain] final FAT2 write FAILED at sector ", udec_(fat_sector))
        status := E_IO_ERROR

#ifdef SD_INCLUDE_DEFRAG

PRI do_create_contiguous(p_path, file_size) : handle | cluster_count, new_first, temp, first_cluster
' Worker-side handler for CMD_CREATE_CONTIGUOUS.
' Creates a new file with a pre-allocated contiguous cluster chain.
' Reuses do_create() directory entry logic with pre-allocated first cluster.
' Check-then-allocate: the existence/path checks run BEFORE the chain is
' reserved, so a rejected name (E_FILE_EXISTS etc.) touches no FAT state.
' Failures after the chain lands still leak it (never free-on-fail) -- see
' the HALF-WRITTEN STATE doctrine at allocateCluster().
' Allocation failures propagate the allocator's true code (E_DISK_FULL or
' E_IO_ERROR), matching do_create/do_newdir.
'
' @param p_path - Pointer to null-terminated filename string
' @param file_size - Expected file size in bytes
' @returns handle - Handle on success, negative error code on failure

' Calculate clusters needed

  cluster_count := (file_size + (sec_per_clus << SECTOR_SHIFT) - 1) / (sec_per_clus << SECTOR_SHIFT)
  if cluster_count < 1
    cluster_count := 1                                  '  minimum 1 cluster

  ' Allocate a handle slot
  handle := allocateHandle()
  if handle < 0
    DEBUG[CH_FILE]("  [do_create_contiguous] No free handles")
  elseif searchDirectory(p_path)
    ' Check if file already exists
    DEBUG[CH_FILE]("  [do_create_contiguous] File already exists: ", zstr_(p_path))
    freeHandle(handle)
    handle := E_FILE_EXISTS
  elseif search_io_status < 0
    ' FAIL CLOSED -- see do_create.
    DEBUG[CH_FILE]("  [do_create_contiguous] Existence check FAILED, refusing to create")
    freeHandle(handle)
    handle := search_io_status
  elseif entry_address == 0
    DEBUG[CH_FILE]("  [do_create_contiguous] entry_address=0 -- path not valid")
    freeHandle(handle)
    handle := E_FILE_NOT_FOUND
  else
    ' Check if directory needs a new cluster for the entry
    ' (must stay adjacent to searchDirectory -- reads its dir_buf state)
    temp := (entry_address + cluster_offset << SECTOR_SHIFT) & (sec_per_clus << SECTOR_SHIFT - 1)
    if temp == (sec_per_clus << SECTOR_SHIFT - DIR_ENTRY_SIZE)
      if dir_buf[LAST_DIR_ENTRY_OFFSET] == $00
        temp := allocateCluster(byte2clus(entry_address))
        if temp < 0
          DEBUG[CH_FILE]("  [do_create_contiguous] Failed to allocate dir cluster")
          freeHandle(handle)
          handle := temp                                ' allocator's true code -- E_DISK_FULL or E_IO_ERROR
        elseif clearCluster(temp) < 0
          DEBUG[CH_FILE]("  [do_create_contiguous] Failed to clear new dir cluster")
          freeHandle(handle)
          handle := E_IO_ERROR

    ' Reserve the contiguous chain -- only now that the name is known free
    if handle >= 0
      new_first := findContiguousRun(cluster_count)
      if new_first < 0
        freeHandle(handle)
        handle := new_first                             '  E_NO_CONTIGUOUS_SPACE or E_IO_ERROR
      else
        temp := allocateContiguousChain(new_first, cluster_count)
        if temp < 0
          freeHandle(handle)
          handle := temp

    if handle >= 0
      ' Set up directory entry
      first_cluster := new_first
      dirEntSetAttr(@entry_buffer, ATTR_ARCHIVE)
      dirEntSetCreateStamp(@entry_buffer, date_stamp)
      dirEntSetStartClus(@entry_buffer, first_cluster)
      dirEntSetModifyStamp(@entry_buffer, date_stamp)
      dirEntSetFileSize(@entry_buffer, 0)

      ' Write directory entry to disk
      if readSector(entry_address >> SECTOR_SHIFT, BUF_DIR) < 0
        DEBUG[CH_FILE]("  [do_create_contiguous] Directory read FAILED")
        freeHandle(handle)
        handle := E_IO_ERROR
      else
        bytemove(@dir_buf + (entry_address & SECTOR_OFFSET_MASK), @entry_buffer, DIR_ENTRY_SIZE)
        if writeSector(entry_address >> SECTOR_SHIFT, BUF_DIR) < 0
          DEBUG[CH_FILE]("  [do_create_contiguous] Directory write FAILED")
          freeHandle(handle)
          handle := E_IO_ERROR
        else
          ' Populate handle state
          h_start_clus[handle] := first_cluster
          h_size[handle] := 0
          h_attr[handle] := ATTR_ARCHIVE
          h_dir_sector[handle] := entry_address >> SECTOR_SHIFT
          h_dir_offset[handle] := entry_address & SECTOR_OFFSET_MASK
          h_cluster[handle] := first_cluster
          h_sector[handle] := clus2sec(first_cluster)
          h_position[handle] := 0
          h_buf_sector[handle] := -1
          h_flags[handle] := HF_WRITE
          h_prealloc_end[handle] := new_first + cluster_count - 1
          DEBUG[CH_FILE]("  [do_create_contiguous] Success: handle=", udec_(handle), " clusters=", udec_(new_first), "..", udec_(new_first + cluster_count - 1))

PRI do_compact_file(p_path) : status | dir_sec, dir_off, start_cluster, file_size, cluster_count, new_first, clus, next_clus, idx, frag_count
' Worker-side handler for CMD_COMPACT_FILE.
' Relocates a file's clusters into a contiguous chain using copy-then-free.
' 12-step process with mandatory read-back verification (Decision #5).
'
' @param p_path - Pointer to null-terminated filename string
' @returns status - SUCCESS or negative error code

' Step 1: Find the file

  if searchDirectory(p_path) == 0
    status := (search_io_status < 0) ? search_io_status : E_FILE_NOT_FOUND
  elseif isFileOpenAny(entry_address >> SECTOR_SHIFT, entry_address & SECTOR_OFFSET_MASK)
    ' Step 2: Check file is not open
    status := E_FILE_OPEN_FOR_COMPACT
  elseif dirEntFileSize(@entry_buffer) == 0
    ' Step 3: Empty file - nothing to compact
    status := SUCCESS
  else
    dir_sec := entry_address >> SECTOR_SHIFT
    dir_off := entry_address & SECTOR_OFFSET_MASK
    start_cluster := firstCluster()
    file_size := dirEntFileSize(@entry_buffer)

    ' Step 4: Count clusters and check fragmentation
    frag_count := countFileFragments(start_cluster)
    if frag_count < 0
      status := frag_count                              '  E_IO_ERROR walking the chain
    elseif frag_count == 1
      status := SUCCESS                                 '  already contiguous
    else
      ' Count clusters by walking the chain
      cluster_count := 0
      clus := start_cluster
      repeat
        cluster_count++
        next_clus := LONG[readFat(clus)] & FAT32_ENTRY_MASK
        if fat_io_status < 0                            '  stale link -- a wrong cluster_count would size
          DEBUG[CH_FILE]("  [do_compact_file] count-phase FAT read FAILED at cluster ", udec_(clus))
          return E_IO_ERROR                             '   the destination run wrongly. Nothing has been
        if next_clus >= FAT32_EOC_MIN                   '   modified yet, so returning here is clean.
          quit
        if next_clus < ROOT_CLUSTER
          quit
        clus := next_clus

      ' Step 5: Find contiguous free space
      new_first := findContiguousRun(cluster_count)
      if new_first < 0
        status := new_first                             '  E_NO_CONTIGUOUS_SPACE or E_IO_ERROR
      else
        ' Step 6: Copy phase - walk old chain, copy each cluster to new location
        clus := start_cluster
        idx := 0
        status := SUCCESS
        repeat
          status := copyClusterData(clus, new_first + idx)
          if status < 0
            quit                                        '  E_IO_ERROR
          idx++
          next_clus := LONG[readFat(clus)] & FAT32_ENTRY_MASK
          if fat_io_status < 0                          '  stale link -- stop before copying a cluster
            DEBUG[CH_FILE]("  [do_compact_file] copy-phase FAT read FAILED at cluster ", udec_(clus))
            status := E_IO_ERROR                        '   that is not part of this file
            quit
          if next_clus >= FAT32_EOC_MIN
            quit
          if next_clus < ROOT_CLUSTER
            quit
          clus := next_clus

        ' Step 7: Verify phase (Decision #5) - read-back compare every cluster
        if status >= 0
          clus := start_cluster
          idx := 0
          repeat
            status := verifyClusterCopy(clus, new_first + idx)
            if status < 0
              quit                                      '  E_VERIFY_FAILED
            idx++
            next_clus := LONG[readFat(clus)] & FAT32_ENTRY_MASK
            if fat_io_status < 0                        '  stale link -- an unverified copy must not be
              DEBUG[CH_FILE]("  [do_compact_file] verify-phase FAT read FAILED at cluster ", udec_(clus))
              status := E_IO_ERROR                      '   promoted by pointing the entry at it
              quit
            if next_clus >= FAT32_EOC_MIN
              quit
            if next_clus < ROOT_CLUSTER
              quit
            clus := next_clus

        ' Step 8: Build new FAT chain
        if status >= 0
          status := allocateContiguousChain(new_first, cluster_count)

        ' Step 9: Update directory entry to point to new first cluster
        if status >= 0
          if readSector(dir_sec, BUF_DIR) < 0
            status := E_IO_ERROR
          else
            bytemove(@entry_buffer, @dir_buf + dir_off, DIR_ENTRY_SIZE)
            dirEntSetStartClus(@entry_buffer, new_first)
            bytemove(@dir_buf + dir_off, @entry_buffer, DIR_ENTRY_SIZE)
            if writeSector(dir_sec, BUF_DIR) < 0
              DEBUG[CH_FILE]("  [do_compact_file] dir entry write FAILED for sector ", udec_(dir_sec))
              status := E_IO_ERROR

        ' Step 10: Free old clusters. Propagate failure so caller knows the
        ' FAT may be in an inconsistent state (clusters leaked).
        if status >= 0
          status := freeClusterChain(start_cluster)

        ' Step 11: Invalidate all caches
        invalidateAllCaches()

                ' Step 12: Success (status already set by each step)

PRI do_file_fragments(p_path) : count | start_cluster
' Worker-side handler for CMD_FILE_FRAGMENTS.
' Looks up the file and counts its FAT chain fragments.
'
' @param p_path - Pointer to null-terminated filename string
' @returns count - Fragment count (1 = contiguous), 0 if empty, or negative error code

  if searchDirectory(p_path) == 0
    count := (search_io_status < 0) ? search_io_status : E_FILE_NOT_FOUND
  else
    start_cluster := firstCluster()
    if start_cluster < ROOT_CLUSTER
      count := 0                                        '  empty file (no clusters)
    else
      count := countFileFragments(start_cluster)

PRI countFileFragments(first_cluster) : count | clus, next_clus, loop_count
' Count the number of non-contiguous fragments in a file's cluster chain.
' A contiguous file has fragment count 1; each gap increments the count.
'
' @param first_cluster - First cluster of the file's chain
' @returns count - Fragment count (1 = contiguous), 0 if empty chain, E_IO_ERROR on FAT read failure

  if first_cluster < ROOT_CLUSTER
    count := 0                                          '  empty or invalid chain
  else
    count := 1
    clus := first_cluster
    loop_count := 0
    repeat
      next_clus := LONG[readFat(clus)] & FAT32_ENTRY_MASK
      if fat_io_status < 0                              '  stale link -- a fragment count off a garbage
        DEBUG[CH_FILE]("  [countFileFragments] FAT read FAILED at cluster ", udec_(clus))
        return E_IO_ERROR                               '   chain is meaningless, do not report one
      if next_clus >= FAT32_EOC_MIN
        quit                                            '  end of chain
      if next_clus < ROOT_CLUSTER                       '  bad reference
        quit
      if next_clus <> clus + 1                          '  non-contiguous transition?
        count++
      clus := next_clus
      loop_count++
      if loop_count > 100000                            '  safety limit
        quit

PRI findContiguousRun(cluster_count) : first_cluster | fat_idx, entry, run_start, run_length
' Scan FAT for a contiguous run of N free clusters.
' Performs a linear scan from cluster 2 through end of FAT.
'
' @param cluster_count - Number of consecutive free clusters needed
' @returns first_cluster - First cluster of the run, or E_NO_CONTIGUOUS_SPACE

  run_start := ROOT_CLUSTER
  run_length := 0
  fat_idx := ROOT_CLUSTER * 4                                                   '  start at cluster 2
  repeat
    if fat_idx & SECTOR_OFFSET_MASK == 0                                        '  at sector boundary?
      if fat_idx >> SECTOR_SHIFT >= sec_per_fat                                 '   past end of FAT?
        quit
      if readSector(fat_sec + fat_idx >> SECTOR_SHIFT, BUF_FAT) < 0             '   load next FAT sector
        DEBUG[CH_SECTOR]("  [findContiguousRun] FAT read FAILED")
        first_cluster := E_IO_ERROR
        quit
    if first_cluster <> E_IO_ERROR
#ifdef SD_INCLUDE_TEST_HOOKS
      if test_max_clusters > 0 AND (fat_idx >> 2) >= test_max_clusters          '  test hook: artificial cluster limit
        quit
#endif
      entry := LONG[@fat_buf + (fat_idx & SECTOR_OFFSET_MASK)]
      if (entry & FAT32_ENTRY_MASK) == 0                                        '  free cluster?
        if run_length == 0
          run_start := fat_idx >> 2                                             '   start new run
        run_length++
        if run_length >= cluster_count                                          '  found enough?
          first_cluster := run_start
          quit
      else
        run_length := 0                                                         '  reset run
      fat_idx += 4
  if first_cluster <> E_IO_ERROR AND run_length < cluster_count
    first_cluster := E_NO_CONTIGUOUS_SPACE                                      '  no run found
  fat_sec_in_buf := -1

PRI allocateContiguousChain(first_cluster, count) : status | clus, fat_idx, buf_idx, high_bits, prev_fat_sector
' Mark N consecutive clusters as a linked sequential chain in the FAT.
' Writes both FAT1 and FAT2 (mirror). Preserves high 4 reserved bits.
'
' @param first_cluster - First cluster of the contiguous run
' @param count - Number of clusters to link
' @returns status - SUCCESS or E_IO_ERROR

  status := SUCCESS
  prev_fat_sector := -1
  repeat clus from first_cluster TO first_cluster + count - 1
    fat_idx := clus << 2
    buf_idx := fat_idx & SECTOR_OFFSET_MASK
    ' Load FAT sector if needed
    if (fat_idx >> SECTOR_SHIFT) <> prev_fat_sector
      if prev_fat_sector >= 0                                                   '  write previous sector before loading new one
        if writeSector(fat_sec + prev_fat_sector, BUF_FAT) < 0
          DEBUG[CH_SECTOR]("  [allocateContiguousChain] FAT1 write FAILED at sector ", udec_(prev_fat_sector))
          status := E_IO_ERROR
          quit
        if writeSector(fat2_sec + prev_fat_sector, BUF_FAT) < 0
          DEBUG[CH_SECTOR]("  [allocateContiguousChain] FAT2 write FAILED at sector ", udec_(prev_fat_sector))
          status := E_IO_ERROR
          quit
      prev_fat_sector := fat_idx >> SECTOR_SHIFT
      if readSector(fat_sec + prev_fat_sector, BUF_FAT) < 0
        DEBUG[CH_SECTOR]("  [allocateContiguousChain] FAT read FAILED at cluster ", udec_(clus))
        status := E_IO_ERROR
        quit
    ' Write chain link or EOC
    high_bits := LONG[@fat_buf + buf_idx] & FAT32_RESERVED_MASK                 '  preserve high 4 bits
    if clus < first_cluster + count - 1
      LONG[@fat_buf + buf_idx] := high_bits | ((clus + 1) & FAT32_ENTRY_MASK)   '  link to next cluster
    else
      LONG[@fat_buf + buf_idx] := high_bits | FAT32_EOC_MARK                    '  end of chain
  ' Write final FAT sector
  if prev_fat_sector >= 0 AND status == SUCCESS
    if writeSector(fat_sec + prev_fat_sector, BUF_FAT) < 0
      DEBUG[CH_SECTOR]("  [allocateContiguousChain] final FAT1 write FAILED at sector ", udec_(prev_fat_sector))
      status := E_IO_ERROR
    elseif writeSector(fat2_sec + prev_fat_sector, BUF_FAT) < 0
      DEBUG[CH_SECTOR]("  [allocateContiguousChain] final FAT2 write FAILED at sector ", udec_(prev_fat_sector))
      status := E_IO_ERROR
  ' Update free cluster tracking
  if status == SUCCESS
    if fsi_free_count <> $FFFF_FFFF
      fsi_free_count -= count
    fsi_nxt_free := first_cluster + count                                       '  update next-free hint

PRI copyClusterData(src_cluster, dst_cluster) : status | idx
' Copy all sectors of one cluster from source to destination.
'
' @param src_cluster - Source cluster number
' @param dst_cluster - Destination cluster number
' @returns status - SUCCESS or E_IO_ERROR

  status := SUCCESS
  repeat idx from 0 TO sec_per_clus - 1
    if readSector(clus2sec(src_cluster) + idx, BUF_DATA) < 0
      DEBUG[CH_SECTOR]("  [copyClusterData] Read FAILED at sector ", udec_(clus2sec(src_cluster) + idx))
      status := E_IO_ERROR
      quit
    if writeSector(clus2sec(dst_cluster) + idx, BUF_DATA) < 0
      DEBUG[CH_SECTOR]("  [copyClusterData] Write FAILED at sector ", udec_(clus2sec(dst_cluster) + idx))
      status := E_IO_ERROR
      quit

PRI verifyClusterCopy(src_cluster, dst_cluster) : status | idx, byte_idx
' Verify that all sectors in a cluster were copied correctly by reading
' both source and destination and comparing byte-by-byte.
' Repurposes dir_buf for destination reads (safe when file is closed).
' Implements Decision #5 (mandatory read-back verify after compact).
'
' @param src_cluster - Source cluster number (original data)
' @param dst_cluster - Destination cluster number (copied data)
' @returns status - SUCCESS or E_VERIFY_FAILED

  status := SUCCESS
  repeat idx from 0 TO sec_per_clus - 1
    if readSector(clus2sec(src_cluster) + idx, BUF_DATA) < 0
      status := E_IO_ERROR
      quit
    if readSector(clus2sec(dst_cluster) + idx, BUF_DIR) < 0
      status := E_IO_ERROR
      quit
    repeat byte_idx from 0 TO SECTOR_SIZE - 1
      if BYTE[@buf][byte_idx] <> BYTE[@dir_buf][byte_idx]
        DEBUG[CH_FILE]("  [verifyClusterCopy] Mismatch at sector ", udec_(idx), " byte ", udec_(byte_idx))
        status := E_VERIFY_FAILED
        quit
    if status < 0
      quit

PRI isFileOpenAny(dir_sector, dir_offset) : bOpen
' Check if a file is open in any mode (read, write, or directory).
' Used by compactFile() to reject compaction on open files.
'
' @param dir_sector - Directory sector containing the file entry
' @param dir_offset - Offset within sector of the file entry
' @returns bOpen - TRUE if file is open in any mode, FALSE otherwise

  ' $FF admits every mode including HF_DIR -- pre-existing semantics for the
  ' compaction guard; see handleReferencesEntry for the stale-coordinate caveat.
  bOpen := handleReferencesEntry(dir_sector, dir_offset, $FF)

#endif                                                  ' SD_INCLUDE_DEFRAG

PRI invalidateAllCaches()
' Reset all three sector cache tracking variables to force re-reads.
' Called after compactFile() to prevent stale cached sectors, and by the
' CMD_TEST_INVAL_CACHES test hook to guarantee injection tests a cache miss.

  dir_sec_in_buf := -1
  fat_sec_in_buf := -1
  sec_in_buf := -1

CON ' ---- SD Conversion Helpers ----

PRI byte2clus(byte_address) : cluster
' Convert byte address to cluster number.
'
' @param byte_address - Byte address to convert
' @returns cluster - Cluster number containing that byte

  cluster := sec2clus(byte_address >> SECTOR_SHIFT)

PRI sec2clus(sector) : cluster
' Convert sector number to cluster number.
'
' @param sector - Sector number to convert
' @returns cluster - Cluster number containing that sector

  cluster := (sector - root_sec) / sec_per_clus + ROOT_CLUSTER

PRI clus2sec(cluster) : sector
' Convert cluster number to sector number.
'
' @param cluster - Cluster number to convert
' @returns sector - Sector number of first sector in that cluster

  sector := (cluster - ROOT_CLUSTER) * sec_per_clus + root_sec

CON ' ---- SD SPI Layer ----

PRI initSPIPins()
' Configure smart pins for SPI operation - initialize Smart Pins for high-speed SPI communication.
' Pattern from working isp_tile_sensor.spin2:
' - DIRL -> WRPIN -> WXPIN -> DIRH (no WYPIN during config)
' - Smart pins stay enabled, WYPIN triggers transfers
'
' SCK uses P_PULSE for clock generation (X = period | low_time<<16)
' MOSI uses P_SYNC_TX for synchronized transmit (clocked by SCK)
' MISO uses P_SYNC_RX for synchronized receive (clocked by SCK)
' CS remains standard GPIO (manual control)

' Smart pin mode configuration
' P_TRANSITION: clock generation with X = half-period (transitions toggle output)
' P_SYNC_TX: synchronized serial transmit (clocked by B-input)
' P_SYNC_RX: synchronized serial receive (clocked by B-input)
' B-input pin selector: computed dynamically from actual pin assignments
'   WRPIN mode bits [26:24] encode signed offset from data pin to clock pin
'   Encoding: +1=%001, +2=%010, +3=%011, -1=%111, -2=%110, -3=%101
'   Formula: ((sck - data_pin) & 7) << 24
'   Hardware constraint: SCK must be within +/-3 pins of MOSI and MISO
' Reference: ManAtWork SpiFlash.spin2 (OBEX 2872) - working smart pin SPI
' CRITICAL: Do NOT use P_INVERT_OUTPUT for SD card SPI mode 0!
' ManAtWork's flash uses different polarity. SD cards need clock idle LOW.

  spi_clk_mode := P_TRANSITION | P_OE                   ' Transition mode, idle LOW for SPI mode 0
  spi_tx_mode := P_SYNC_TX | P_OE | (((sck - mosi) & 7) << 24)  ' Sync TX, B-input routed to SCK
  spi_rx_mode := P_SYNC_RX | (((sck - miso) & 7) << 24)         ' Sync RX, B-input routed to SCK

  DEBUG[CH_INIT]("    [initSPIPins] Setting up smart pins (ManAtWork pattern)...")
  DEBUG[CH_INIT]("    [initSPIPins] Mode values:")
  DEBUG[CH_INIT]("    [initSPIPins]   spi_clk_mode=$", uhex_long(spi_clk_mode), " (P_TRANSITION | P_OE, idle LOW)")
  DEBUG[CH_INIT]("    [initSPIPins]   spi_tx_mode=$", uhex_long(spi_tx_mode), " (P_SYNC_TX, SCK offset=", sdec_(sck - mosi), ")")
  DEBUG[CH_INIT]("    [initSPIPins]   spi_rx_mode=$", uhex_long(spi_rx_mode), " (P_SYNC_RX, SCK offset=", sdec_(sck - miso), ")")
  DEBUG[CH_INIT]("    [initSPIPins]   SCK=P", udec_(sck), " MOSI=P", udec_(mosi), " MISO=P", udec_(miso))

  ' CS PIN: Standard GPIO (unchanged from bit-bang)
  ' CS is manually controlled - LOW = selected, HIGH = deselected
  pinh(cs)                                              ' Start deselected

  ' SCK PIN: P_TRANSITION mode for clock generation
  ' X register: half-period in clocks (time between transitions)
  ' Y register: Number of transitions (2 per bit) - loaded via WYPIN per transfer
  ' Configure with FLTL -> WRPIN, then WXPIN/DRVL in applySPISpeed()
  pinfloat(sck)                                         ' FLTL - reset smart pin
  WRPIN(sck, spi_clk_mode)                              ' P_TRANSITION | P_OE
  ' X register (half-period) will be set by applySPISpeed()
  DEBUG[CH_INIT]("    [initSPIPins]   SCK configured: P_TRANSITION | P_OE (awaiting applySPISpeed)")

  ' MOSI PIN: P_SYNC_TX mode for synchronized transmit
  ' B-input routed to SCK (offset computed dynamically from pin assignments)
  ' X register: %M_NNNNN where M=mode (1=start/stop), N=bits-1
  ' Y register: Data to transmit - loaded via WYPIN per transfer
  ' Configure with DIRL -> WRPIN -> WXPIN -> DIRH (no WYPIN yet)
  pinfloat(mosi)                                        ' DIRL - reset smart pin
  WRPIN(mosi, spi_tx_mode)                              ' P_SYNC_TX | P_OE | B-input->SCK
  WXPIN(mosi, %1_00111)                                 ' Start-stop mode, 8 bits default
  pinh(mosi)                                            ' DIRH - enable smart pin
  DEBUG[CH_INIT]("    [initSPIPins]   MOSI configured: P_SYNC_TX, B-input->SCK (enabled)")

  ' MISO PIN: P_SYNC_RX mode for synchronized receive
  ' B-input routed to SCK (offset computed dynamically from pin assignments)
  ' X register: %M_NNNNN where M=mode (1=post-edge for SPI mode 0), N=bits-1
  ' Z register: Received data - read via RDPIN per transfer
  ' Configure with DIRL -> WRPIN -> WXPIN -> DIRH (no WYPIN needed)
  pinfloat(miso)                                        ' DIRL - reset smart pin
  WRPIN(miso, spi_rx_mode)                              ' P_SYNC_RX | B-input->SCK
  WXPIN(miso, miso_wxpin)                               ' Phase 2: adaptive sample mode (computed by applySPISpeed)
  pinh(miso)                                            ' DIRH - enable smart pin
  DEBUG[CH_INIT]("    [initSPIPins]   MISO configured: P_SYNC_RX, B-input->SCK (enabled)")

  ' Configure event SE1 for efficient waiting on SCK completion
  ' Event format: D[5:0]=pin, D[7:6]=%01 for positive edge on IN
  ' This allows waitse1 instead of polling testp loop
  spi_event := %01_000000 | sck
  configureEvent(spi_event)
  DEBUG[CH_INIT]("    [initSPIPins]   Event SE1 configured for SCK pin ", udec_(sck))

  DEBUG[CH_INIT]("    [initSPIPins] Smart pins configured and enabled")

PRI configureEvent(event_config) | ev
' Configure SE1 event for waitse1 - helper to configure SE1 event from a computed value.
' Event format: D[5:0]=pin, D[7:6]=%01 for positive edge on IN
'
' @param event_config - Event configuration value
' @local ev - Copy of event config for inline assembly

  ev := event_config
  ORG
              SETSE1    ev
  END

PRI applySPISpeed(freq) | half_period, actual_freq
' Set SPI clock frequency - configure SPI clock speed for sysclk-independent operation.
' Must only be called from worker cog context (owns the SPI pins).
' Using P_TRANSITION mode: X = half-period (time between transitions)
' Reference: ManAtWork SpiFlash.spin2
'
' Formula: half_period = clkfreq / (freq * 2)
' For 400 kHz: half_period = 320M / 800k = 400 clocks
' For 25 MHz: half_period = 320M / 50M = 6.4 -> minimum 4
'
' @param freq - Target SPI frequency in Hz (e.g., 400_000 or 25_000_000)
' @local half_period - Calculated half-period in system clocks
' @local actual_freq - Actual achieved frequency

' Calculate half-period (time between transitions) in system clocks
' Use ceiling division to ensure we never exceed target frequency
' Formula: ceil(a/b) = (a + b - 1) / b

  half_period := (clkfreq + (freq * 2) - 1) / (freq * 2)

  ' Guard against too-small period (ManAtWork uses minimum of 4)
  if half_period < 4
    half_period := 4
    DEBUG[CH_INIT]("    [applySPISpeed] WARNING: Half-period clamped to minimum (4)")

  ' Calculate actual achieved frequency for debugging
  actual_freq := clkfreq / (half_period * 2)

  ' Store in DAT variables for debugging/monitoring
  spi_period := half_period
  spi_freq := actual_freq
  current_spi_target_hz := freq                                                 ' S.3: cache target for debugOnClockChange()

  ' Phase 2: compute MISO WXPIN value based on hp and sample_mode_override.
  ' This value is consumed by every WXPIN(_miso, ...) call site in the driver.
  ' At default settings (sample_mode_override = -1, pre_edge_threshold = 5) and
  ' hp >= 6, miso_wxpin = %1_00111 (on-edge), preserving pre-Phase-2 behavior
  ' at sysclk >= 255 MHz with 25 MHz SPI target.
  case sample_mode_override
    0:                                                  ' Force pre-edge
      miso_wxpin := %0_00111
    1:                                                  ' Force on-edge
      miso_wxpin := %1_00111
    other:                                              ' -1 (auto) or any other = auto-by-hp
      if half_period <= pre_edge_threshold
        miso_wxpin := %0_00111                          ' Narrow bit cell -> pre-edge for trailing margin
      else
        miso_wxpin := %1_00111                          ' Wide bit cell -> on-edge (current default)

  ' Configure SCK smart pin X register and enable with DRVL
  WXPIN(sck, half_period)                               ' Set transition period
  pinl(sck)                                             ' DRVL enables smart pin (ManAtWork pattern)

  DEBUG[CH_INIT]("    [applySPISpeed] Target=", udec_(freq/1000), " kHz, Actual=", udec_(actual_freq/1000), " kHz")
  DEBUG[CH_INIT]("    [applySPISpeed] Half-period=", udec_(half_period), " clocks, miso_wxpin=$", uhex_byte_(miso_wxpin))

PRI calcDataCRC(pData, len) : crc | raw
' Calculate CRC-16-CCITT for SD card data - hardware-accelerated using P2's GETCRC instruction.
' Eliminates 512-byte lookup table with equivalent results.
'
' Algorithm:
'   1. GETCRC with reflected polynomial $8408 on raw data
'   2. XOR with precomputed base value (compensates for GETCRC quirks)
'   3. REV 31 reverses all 32 bits (LSB-first to MSB-first)
'   4. >> 16 extracts 16-bit CRC from upper half
'
' Note: This formula was validated against lookup table with 100% match
'       across 10 test patterns. See TestCard/SD_CRC_solution_test.spin2
'
' @param pData - Pointer to data buffer
' @param len - Number of bytes to process (must be 512 for sector data)
' @returns crc - 16-bit CRC-16-CCITT value matching SD card's calculation
' @local raw - Raw GETCRC result before transformation

  raw := GETCRC(pData, CRC_POLY_REFLECTED, len)
  crc := ((raw ^ CRC_BASE_512) REV 31) >> 16

PRI sp_transfer(data, bits) : rxData
' Smart pin SPI transfer (variable bits) - dispatches to 8-bit or 32-bit transfer.
' For now, only support 8-bit and 32-bit transfers.
'
' @param data - Data to transmit
' @param bits - Number of bits to transfer (8 or 32)
' @returns rxData - Received data

  if bits == 8
    rxData := sp_transfer_8(data)
  elseif bits == 32
    rxData := sp_transfer_32(data)
  else
    ' Fallback to bit-bang for unsupported sizes
    rxData := transfer(data, bits)

PRI sp_transfer_8(data) : rxByte | _sck, _mosi, _miso, tx_data, raw_result
' 8-bit smart pin SPI transfer - full-duplex 8-bit SPI transfer using smart pins.
' Reference: ManAtWork SpiFlash.spin2 (OBEX 2872)
' TX: shl #24, rev, wypin data, 16 transitions
' RX: wait on MISO IN flag, rdpin, rev, zerox #7
'
' @param data - Byte to transmit
' @returns rxByte - Byte received
' @local _sck - Local copy of SCK pin number
' @local _mosi - Local copy of MOSI pin number
' @local _miso - Local copy of MISO pin number
' @local tx_data - Prepared transmit data
' @local raw_result - Raw rdpin result before processing

  _sck := sck
  _mosi := mosi
  _miso := miso
  tx_data := data
  ORG
              ' Prepare TX data: shift to MSB position and reverse for LSB-first transmission
              SHL       tx_data, #24                    ' Move byte to bits [31:24]
              REV       tx_data                         ' Reverse for MSB-first SPI

              ' Configure MOSI for 8-bit start-stop mode and load data
              WXPIN     #$27, _mosi                     ' 8 bits, start-stop mode (%1_00111)
              WYPIN     tx_data, _mosi
              DRVL      _mosi                           ' Enable TX smart pin

              ' Configure MISO for 8-bit receive
              ' Note: wrpin already set from initSPIPins - don't use dirl which clears it!
              WXPIN     #$27, _miso                     ' 8 bits, start-stop mode
              AKPIN     _miso                           ' Clear any pending IN flag
              DIRH      _miso                           ' Enable smart pin

              ' Start clock: 16 transitions = 8 clock cycles
              WYPIN     #16, _sck
              NOP

' Wait for MISO receive complete (not clock!)
.waitRx       TESTP     _miso   wz                      ' IN=1 when receive complete
        if_nz JMP       #.waitRx

              ' Read received data - keep raw value for debug
              RDPIN     raw_result, _miso
              MOV       rxByte, raw_result
              REV       rxByte                          ' Reverse for MSB-first
              ZEROX     rxByte, #7                      ' Limit to 8 bits
  END
  ' Debug: show raw rdpin value and pin info occasionally
  if sp_debug_ctr < 5
    DEBUG[CH_INIT]("    [sp_transfer_8] pins: miso=", udec_(_miso), " sck=", udec_(_sck), " raw=", uhex_long_(raw_result), " final=", uhex_byte_(rxByte))
    sp_debug_ctr++

PRI sp_transfer_32(data) : rxLong | _sck, _mosi, _miso, tx_data
' 32-bit smart pin SPI transfer - full-duplex 32-bit SPI transfer using smart pins.
'
' @param data - 32-bit data to transmit
' @returns rxLong - 32-bit data received
' @local _sck - Local copy of SCK pin number
' @local _mosi - Local copy of MOSI pin number
' @local _miso - Local copy of MISO pin number
' @local tx_data - Prepared transmit data

  _sck := sck
  _mosi := mosi
  _miso := miso
  tx_data := data
  ORG
              ' Prepare TX data: reverse for LSB-first transmission
              REV       tx_data                         ' Reverse for MSB-first SPI

              ' Configure MOSI for 32-bit start-stop mode and load data
              WXPIN     #$3F, _mosi                     ' 32 bits, start-stop mode (%1_11111)
              WYPIN     tx_data, _mosi
              DRVL      _mosi                           ' Enable TX smart pin

              ' Configure MISO for 32-bit receive
              WXPIN     #$3F, _miso                     ' 32 bits, start-stop mode
              DRVL      _miso                           ' Enable RX smart pin

              ' Start clock: 64 transitions = 32 clock cycles
              WYPIN     #64, _sck
              NOP

' Wait for MISO receive complete
.waitRx       TESTP     _miso   wz                      ' IN=1 when receive complete
        if_nz JMP       #.waitRx

              ' Read received data
              RDPIN     rxLong, _miso
              REV       rxLong                          ' Reverse for MSB-first
  END

PRI initCard() : bSuccess | timeout, resp, card_version, acmd41_arg, got_response, flush_extra, cmd16_msg_ptr
' Initialize SD card - performs complete card initialization sequence per SD spec.
' Steps: power-on delay, SPI setup, card presence detection, CMD0, CMD8, ACMD41 loop, CMD58.
'
' @returns bSuccess - TRUE on successful init, FALSE on failure
' @local timeout - Timeout deadline
' @local resp - Command response byte
' @local card_version - Detected SD version (1 or 2)
' @local acmd41_arg - Argument for ACMD41 (HCS flag)
' @local got_response - TRUE if any CMD0 attempt got a non-timeout response

  DEBUG[CH_INIT]("    [initCard] Starting card init...")
  DEBUG[CH_INIT]("    [initCard] Reference: SPI_SD_Implementation_Reference.md")

  ' Reset per-card discovered state so a failed init does not leak the prior
  ' card's properties into the next mount attempt. Each init must redetect
  ' from scratch -- a different card may be in the slot, or the same card may
  ' have re-IPL'd. Caches are also invalidated (sec_in_buf, fat_sec_in_buf).
  sec_in_buf := -1
  fat_sec_in_buf := -1
  card_warning_flags := CW_NONE
  cmd23_supported := FALSE
  hcs := 0
  ocr_value := 0

  ' ============================================
  ' STEP 1: Power-on delay
  ' Spec: VDD must be stable, then wait 1ms minimum
  ' ============================================
  DEBUG[CH_INIT]("    [initCard] Step 1: Power-on delay (100ms)...")
  waitms(POWER_ON_DELAY_MS)

  ' We have not switched THIS card's speed mode, so our record must not claim we
  ' have -- a stale TRUE surviving a card swap would make the next unmount issue
  ' a CMD6 switch-back to a card that was never switched. Nothing here inspects
  ' the card's own mode: a card left in high-speed mode by a previous session
  ' without a power cycle is a separate, uncharacterized case.
  hs_mode_active := false

  ' ============================================
  ' STEP 2: Configure SPI pins and slow clock
  ' Spec: Use 100-400 kHz during initialization
  ' ============================================
  bit_delay := clkfreq / 100_000                                                '  ~50kHz for init (conservative)
  DEBUG[CH_INIT]("    [initCard] Step 2: SPI config, bit_delay=", udec(bit_delay), " (~50kHz)")

  ' SD card SPI mode 0: CPOL=0, CPHA=0
  ' Data sampled on rising edge, changed on falling edge
  ' On re-mount, SCK/MOSI may still be in active smart-pin state from a prior
  ' initSPIPins (P_TRANSITION | P_OE on SCK, P_SYNC_TX | P_OE on MOSI). With
  ' P_OE set, the smart pin owns the output and DIRL alone does not release it
  ' ("Smart pin modes may still operate while DIR=0" per P2KB). pinclear()
  ' both clears DIR=0 AND writes WRPIN=0 (mode register reset) - disabling the
  ' smart pin so the subsequent pinh/pinl and the recovery flush below actually
  ' drive the pin. Without this, on remount #2+ the 4096-clock recovery flush
  ' produces ZERO transitions on the wire, the card is never reset, and CMD0
  ' fails with -8 E_NO_CARD.
  pinclear(sck)                                                                 '  WRPIN=0 + DIRL: fully disable SCK smart pin
  pinclear(mosi)                                                                '  WRPIN=0 + DIRL: fully disable MOSI smart pin
  pinh(cs)                                                                      '  CS HIGH = deselected
  pinh(mosi)                                                                    '  MOSI HIGH (card expects high during idle)
  pinl(sck)                                                                     '  SCK LOW (SPI mode 0 idle state)

  ' Enable 15K pull-up on MISO for card-presence detection
  ' If no card is present, MISO reads $FF (pulled high by P2 internal resistor)
  ' If card is present, card drives MISO (easily overpowers 15K pull-up)
  ' Pull-up is cleared later when initSPIPins() configures MISO for smart pin SPI
  ' Order DIRL -> WRPIN per p2kbArchSmartPins canonical sequence (smart pin must
  ' be reset before WRPIN). On re-mount, MISO may be in active smart-pin state
  ' from a prior initSPIPins; pinf() ensures DIR=0 before the WRPIN.
  pinf(miso)                                                                    '  DIRL: reset MISO smart pin (input mode)
  WRPIN(miso, P_HIGH_15K)                                                       '  Configure 15K pull-up for card-presence detection
  waitus(10)                                                                    '  Let pull-up settle

  DEBUG[CH_INIT]("    [initCard] Pins: CS=", udec_(pinr(cs)), " MOSI=", udec_(pinr(mosi)), " MISO=", udec_(pinr(miso)), " SCK=", udec_(pinr(sck)))

  ' ============================================
  ' STEP 3: Card recovery + init clocks
  ' If card is stuck mid-transfer or busy from a prior write, clock with CS HIGH
  ' until MISO releases (goes high). Some counterfeit SDSC cards re-busy themselves
  ' after CS deassert (internal GC / wear-leveling), and the spec'd 74-clock minimum
  ' is insufficient. We clock RECOVERY_FLUSH_CLKS as a baseline (spec + margin), then
  ' continue clocking up to RECOVERY_BUSY_TIMEOUT_CLKS more if MISO is still held low.
  ' ============================================
  DEBUG[CH_INIT]("    [initCard] Step 3: Recovery flush + busy poll...")
  repeat RECOVERY_FLUSH_CLKS                                                    '  Mandatory baseline (74+ spec clocks plus margin)
    pinh(sck)
    waitus(10)
    pinl(sck)
    waitus(10)

  ' If MISO still held low, keep clocking until card releases or timeout
  flush_extra := 0
  repeat while (pinr(miso) == 0) AND (flush_extra < RECOVERY_BUSY_TIMEOUT_CLKS)
    pinh(sck)
    waitus(10)
    pinl(sck)
    waitus(10)
    flush_extra++

  DEBUG[CH_INIT]("    [initCard] MISO after recovery flush: ", udec_(pinr(miso)), " (extra=", udec_(flush_extra), ")")

  ' ============================================
  ' STEP 3.5: Initialize smart pins for SPI
  ' ============================================
  DEBUG[CH_INIT]("    [initCard] Step 3.5: Initializing smart pins (ManAtWork pattern)...")
  initSPIPins()
  applySPISpeed(INIT_SPI_FREQ)                                                  ' 400 kHz for init
  waitus(SMARTPIN_SETTLE_US)                                                    ' Let smart pins settle

  ' Send dummy clocks using smart pins
  repeat INIT_DUMMY_BYTES
    sp_transfer_8($FF)
  DEBUG[CH_INIT]("    [initCard] Dummy clocks sent via smart pins")

  ' ============================================
  ' STEP 4: CMD0 - GO_IDLE_STATE
  ' Sends: 0x40 0x00 0x00 0x00 0x00 0x95
  ' Expected R1: 0x01 (in idle state)
  ' ============================================
#ifdef SD_INIT_QUIESCE
  ' ============================================
  ' STEP 3.9 (EXPERIMENTAL, -D SD_INIT_QUIESCE): quiesce a card that a PREVIOUS
  ' bus master may have left mid-transfer.
  '
  ' We are not the only thing that talks to this card. On every P2 reset the boot
  ' ROM reads its boot pattern from P59/P60/P61, and P60 pulled up selects SD boot
  ' -- P60 being our CS pin, which the card's own internal 50 kOhm CS pull-up
  ' asserts whenever a card is seated. On that pattern the ROM initialises the card
  ' in SPI mode, mounts FAT32, hunts for a boot file, and gives up. It runs under
  ' RCFAST, before any user code, and nothing guarantees it terminated cleanly.
  '
  ' A card left in a data-transfer state is not listening for commands -- it is
  ' streaming. CMD0 sent into that stream is data, not a command, which is exactly
  ' the observed failure: five CMD0 retries, no response, E_NO_CARD. And more
  ' clocking cannot fix it, because a multiple-block read continues until it is
  ' told to stop; clocking only feeds it. (Measured: 102_400 clocks in each CS
  ' polarity recovered nothing.)
  '
  ' CMD12 is the command the specification designates for this. Part 1 Physical
  ' Layer, section 4.3: "All data read commands can be aborted any time by the stop
  ' command (CMD12). The data transfer will terminate and the card will return to
  ' the Transfer State."
  '
  ' Harmless on a card that is idle -- CMD12 with nothing to stop is a no-op that
  ' returns an error bit we deliberately ignore. There is no state here to get
  ' wrong, which is why it can sit unconditionally ahead of CMD0 if it proves out.
  ' UNCONDITIONAL print while this is an experimental -D arm, so a transcript
  ' PROVES which build produced it. Round 15b's five clean runs rest on the
  ' operator having passed the right -D: the two builds differ by 20 bytes and the
  ' captured log records neither the size nor any marker, so nothing in the
  ' transcript distinguished them. The result stands on its interleaved controls,
  ' but it should not have needed to. Drop this line if the step becomes the
  ' default -- production has no business printing on every mount.
  debug("    [initCard] CMD12 quiesce ACTIVE (SD_INIT_QUIESCE build)")
  cmd(CMD12, 0)
  pinh(cs)                                                                      '  deselect
  sp_transfer_8($FF)                                                            '  NCS recovery clocks (SD spec)
  waitms(CMD_RETRY_DELAY_MS)
#endif

  DEBUG[CH_INIT]("    [initCard] Step 4: CMD0 (GO_IDLE_STATE)...")
  resp := 0
  got_response := false
  repeat CMD0_MAX_RETRIES                                                       '  try up to 5 times
    resp := cmd(CMD0, 0)
    DEBUG[CH_INIT]("    [initCard] CMD0 response: $", uhex_(resp))
    if resp <> 0                                                                '  cmd() returns 0 on timeout
      got_response := true
    if resp == R1_IN_IDLE
      quit
    waitms(CMD_RETRY_DELAY_MS)

  bSuccess := true                                                              '  optimistic - set false on any failure

  if resp <> $01
    if NOT got_response
      DEBUG[CH_INIT]("    [initCard] No card detected (MISO idle across all CMD0 attempts)")
      bSuccess := false
      last_init_error := E_NO_CARD
    else
      DEBUG[CH_INIT]("    [initCard] Card responded but CMD0 failed: $", uhex_(resp))
      bSuccess := false
      last_init_error := E_BAD_RESPONSE

  if bSuccess
    DEBUG[CH_INIT]("    [initCard] CMD0 OK - card in idle state")

    ' ============================================
    ' STEP 5: CMD8 - SEND_IF_COND
    ' Sends: 0x48 0x00 0x00 0x01 0xAA 0x87
    ' Argument: VHS=0x01 (2.7-3.6V), check_pattern=0xAA
    ' Expected R7: R1 + 4 bytes echoing VHS and pattern
    ' ============================================
    DEBUG[CH_INIT]("    [initCard] Step 5: CMD8 (SEND_IF_COND, VHS=1, pattern=$AA)...")
    resp := cmd(CMD8, CMD8_CHECK_PATTERN)                                       '  send CMD8, get 32-bit echo
    DEBUG[CH_INIT]("    [initCard] CMD8 response (32-bit): $", uhex_long(resp))

    card_version := 1                                                           '  assume v1.x until proven otherwise
    acmd41_arg := $00000000                                                     '  HCS=0 for v1.x cards

    if diag_cmd_r1_ms < 0                                                       ' cmd() returns 0 on R1 timeout, byte-identical to a valid R1=$00 clean
      DEBUG[CH_INIT]("    [initCard] CMD8 R1 NEVER ARRIVED (cmd() timed out) -> treating as Ver 1.x")
      card_version := 1
      acmd41_arg := $00000000                                                   '  no HCS for v1.x
    elseif resp == 0                                                            '  illegal-command response from v1.x (no echo bytes)
      DEBUG[CH_INIT]("    [initCard] CMD8 no echo -> Ver 1.x SD card (SDSC only)")
      card_version := 1
      acmd41_arg := $00000000                                                   '  no HCS for v1.x
    elseif (resp & CMD8_ECHO_MASK) == CMD8_ECHO_EXPECTED                        '  check VHS and pattern echo
      DEBUG[CH_INIT]("    [initCard] CMD8 echo valid ($1AA) -> Ver 2.0+ SD card")
      card_version := 2
      acmd41_arg := ACMD41_HCS_BIT                                              '  HCS=1 for v2.0+ (support SDHC/SDXC)
    else
      DEBUG[CH_INIT]("    [initCard] CMD8 echo unexpected: $", uhex_long(resp & CMD8_ECHO_MASK), " expected $1AA")
      DEBUG[CH_INIT]("    [initCard] Treating as Ver 1.x card")
      card_version := 1
      acmd41_arg := $00000000

    ' ============================================
    ' STEP 6: ACMD41 - SD_SEND_OP_COND (loop until ready)
    ' Requires CMD55 prefix before each ACMD41
    ' CMD55: 0x77 0x00 0x00 0x00 0x00 0x65
    ' ACMD41: 0x69 [arg] CRC
    ' Expected R1: 0x00 when ready, 0x01 while initializing
    ' ============================================
    DEBUG[CH_INIT]("    [initCard] Step 6: ACMD41 init loop (arg=$", uhex_long(acmd41_arg), ")...")
    ' v1.5.3: GETMS-based deadline (was GETCT-based; safe at this duration but
    ' converted for consistency with other timeout sites)
    timeout := GETMS() + ACMD41_TIMEOUT_SECS * 1000                             '  2 second timeout

    repeat
      resp := cmd(CMD55, 0)                                                     '  APP_CMD prefix
      if diag_cmd_r1_ms < 0                                                     ' cmd() returns 0 on R1 timeout, byte-identical to a valid R1=$00 clean
        DEBUG[CH_INIT]("    [initCard] CMD55 R1 NEVER ARRIVED (cmd() timed out)")
        waitms(ACMD41_POLL_DELAY_MS)
      elseif resp > $01                                                         '  error other than "in idle"
        DEBUG[CH_INIT]("    [initCard] CMD55 error: $", uhex_(resp))
        waitms(ACMD41_POLL_DELAY_MS)
      else
        resp := cmd(ACMD41, acmd41_arg)                                         '  SD_SEND_OP_COND
        if diag_cmd_r1_ms < 0                                                   ' cmd() returns 0 on R1 timeout, byte-identical to a valid R1=$00 clean
          DEBUG[CH_INIT]("    [initCard] ACMD41 R1 NEVER ARRIVED (cmd() timed out)")
        elseif resp == $00                                                      '  card ready (not in idle anymore)
          DEBUG[CH_INIT]("    [initCard] ACMD41 complete - card ready!")
          quit
        elseif resp == R1_IN_IDLE                                               '  still initializing
        ' continue looping
        else
          DEBUG[CH_INIT]("    [initCard] ACMD41 unexpected response: $", uhex_(resp))

      if GETMS() - timeout > 0
        DEBUG[CH_INIT]("    [initCard] FAIL: ACMD41 timeout after 2 seconds")
        DEBUG[CH_INIT]("    [initCard] Last response: $", uhex_(resp))
        bSuccess := false
        last_init_error := E_TIMEOUT
        quit
      waitms(ACMD41_POLL_DELAY_MS)

  if bSuccess
    ' ============================================
    ' STEP 7: CMD58 - READ_OCR
    ' Sends: 0x7A 0x00 0x00 0x00 0x00 0xFD
    ' Expected R3: R1 + 32-bit OCR register
    ' Check bit 31 (busy), bit 30 (CCS)
    ' ============================================
    DEBUG[CH_INIT]("    [initCard] Step 7: CMD58 (READ_OCR)...")
    resp := cmd(CMD58, 0)
    if diag_cmd_r1_ms < 0                                                       ' cmd() returns 0 on R1 timeout, byte-identical to a valid R1=$00 clean
      DEBUG[CH_INIT]("    [initCard] CMD58 R1 NEVER ARRIVED (cmd() timed out)")
      bSuccess := false
      last_init_error := E_TIMEOUT
    else
      ocr_value := resp                                                         '  Cache OCR for later retrieval
      DEBUG[CH_INIT]("    [initCard] OCR: $", uhex_long(resp))
      DEBUG[CH_INIT]("    [initCard]   Bit 31 (ready): ", udec((resp >> 31) & 1))
      DEBUG[CH_INIT]("    [initCard]   Bit 30 (CCS):   ", udec((resp >> OCR_CCS_SHIFT) & 1))

      if (resp >> OCR_CCS_SHIFT) & 1
        hcs := 0                                                                '  SDHC/SDXC: block addressing (no shift)
        DEBUG[CH_INIT]("    [initCard] Card type: SDHC/SDXC (block addressing)")
      else
        hcs := 9                                                                '  SDSC: byte addressing (shift by 9 = multiply by 512)
        DEBUG[CH_INIT]("    [initCard] Card type: SDSC (byte addressing)")

      ' ============================================
      ' STEP 7.5: CMD16 - SET_BLOCKLEN (SDSC only)
      ' SDHC/SDXC hardwire the data block length to 512 and ignore CMD16.
      ' SDSC cards take their read/write data-token size from CMD16; the
      ' power-up default is the CSD READ_BL_LEN, which on 2 GB cards is
      ' commonly 1024. Without CMD16 the card may stream more bytes per block
      ' than the streamer reads, leaving the card mid-block and desynced.
      ' SD Physical Layer Spec section 7.2.3.
      ' ============================================
      ' SDSC: CMD16 pins block length to 512. CSD READ_BL_LEN default is
      ' commonly 1024 on 2 GB cards; without CMD16=512 our 512-byte streamer
      ' reads stay mid-block forever and MISO desyncs silently. If this ever
      ' fails on an SDSC card we want it loud in the log - every downstream
      ' read/write failure would otherwise be unattributable.
      ' Policy: observability only, no behavior change here. Init continues
      ' regardless; the five log states below let us recognize the exception
      ' case post-mortem from any captured run.
      ' Consolidated: 1 compiled debug record (was 6) via @msg_cmd16_* strings.
      if hcs == 0                                                               ' SDHC/SDXC: CMD16 not applicable
        cmd16_msg_ptr := @msg_cmd16_skipped
        resp := 0
      else                                                                      ' SDSC: byte-addressed -> block length must be pinned explicitly
        resp := cmd(CMD16, SECTOR_SIZE)
        if diag_cmd_r1_ms < 0                                                   ' cmd() returns 0 on R1 timeout, byte-identical to a valid R1=$00 clean
          cmd16_msg_ptr := @msg_cmd16_no_resp
        elseif resp & R1_FATAL_MASK                                             ' Fatal bits: illegal cmd ($04), address err ($20), param err ($40)
          cmd16_msg_ptr := @msg_cmd16_fatal
        elseif resp & R1_STALE_MASK                                             ' Stale bits: idle ($01), erase reset ($02), CRC ($08), erase seq ($10)
          cmd16_msg_ptr := @msg_cmd16_stale
        else
          cmd16_msg_ptr := @msg_cmd16_accepted
      DEBUG[CH_INIT]("    [initCard] ", zstr_(cmd16_msg_ptr), " R1=$", uhex_byte_(resp))

    ' ============================================
    ' STEP 8: Identify card and set optimal SPI speed
    ' Reads CID for manufacturer ID, CSD for TRAN_SPEED
    ' ============================================
    pinh(cs)                                                                    '  ensure CS HIGH before CID/CSD read
    DEBUG[CH_INIT]("    [initCard] Step 8: Card identification and speed selection...")
    identifyCard()                                                              '  read CID/CSD, identify manufacturer
    setOptimalSpeed()                                                           '  set speed based on card type
    ' Send dummy clocks with CS HIGH to stabilize new clock rate
    repeat POST_INIT_DUMMY_REPS
      sp_transfer(-1, 8)                                                        '  8 dummy bytes = 64 clocks (using smart pins)
    DEBUG[CH_INIT]("    [initCard] Dummy clocks sent, CS HIGH")

    ' ============================================
    ' STEP 9: Probe CMD13 reliability
    ' Some older/budget controllers don't implement CMD13 in SPI mode.
    ' Detect this now so checkCardStatus() can skip CMD13 on broken cards.
    ' See DOCs/Analysis/CMD13-COMPATIBILITY-ANALYSIS.md
    ' ============================================
    cmd13_reliable := TRUE
    probeCmd13()

    ' STEP 10: Check CMD23 support from SCR CMD_SUPPORT field
    probeCmd23()

    ' STEP 11: Probe data-block CRC behavior. Some cards (older SDSC and
    ' counterfeit media) return a dummy $0000/$FFFF data CRC instead of a real
    ' one; detect this now so readSector does not treat the mismatch as fatal.
    ' See DOCs/Analysis/DUMMY-DATA-CRC-ANALYSIS.md
    probeDataCrc()

    ' STEP 12: For dummy-CRC cards, empirically find the highest SCK at which
    ' streamer-based reads match ground truth. Real-CRC cards rely on runtime
    ' data-CRC validation for drift detection; dummy-CRC cards have lost that
    ' detection so the operating SCK must be pinned below the card's actual
    ' clean-read ceiling at init time. No-op for cards without CW_NO_DATA_CRC.
    ' See DOCs/Analysis/COUNTERFEIT-ASDFG-SDSC-INVESTIGATION.md
    probeSpiCeiling()

    DEBUG[CH_INIT]("    [initCard] === INIT SUCCESS ===")

PRI cmd(op,parm) : response | timeout, timed_out, r1_start_ms

' Send a SPI command using smart pins - sends command byte, argument, and CRC.
' Handles R1, R3, and R7 response formats based on command type.
'
' CALLER CONTRACT - R1 TIMEOUT DISAMBIGUATION:
'   On R1 timeout this PRI returns 0 (false), which is byte-identical to a clean
'   R1=$00 success. Callers that treat resp==$00 (or any "resp <> error" check)
'   as success MUST first check `diag_cmd_r1_ms < 0` to disambiguate timeout
'   from real success. The marker is set to -1 by this PRI on timeout and to a
'   non-negative latency on every successful R1 byte.
'
'   Failing to consult diag_cmd_r1_ms after cmd() causes the silent-error
'   anti-pattern that has been root-caused multiple times in this driver
'   (commits bfeb20e, and the broader audit recorded in
'   DOCs/Analysis/COUNTERFEIT-ASDFG-SDSC-INVESTIGATION.md). Every cmd() call
'   site whose return value is consumed must include the diag_cmd_r1_ms check.
'
' @param op - Command number (0-63)
' @param parm - 32-bit command argument
' @returns response - R1 response, or R3/R7 32-bit value for CMD8/CMD58.
'                     Returns 0 (false) on R1 timeout; check diag_cmd_r1_ms < 0
'                     to disambiguate from a clean R1=$00 result.
' @local timeout - Timeout deadline
' @local timed_out - TRUE if response polling timed out
' @local r1_start_ms - GETMS() at start of R1 polling loop (for diag_cmd_r1_ms)

  diag_cmd_last_op := op
  diag_cmd_r1_polls := 0
  if op == CMD0
    DEBUG[CH_INIT]("      [cmd] CS before assert: ", udec_(pinr(cs)))
  sp_transfer(-1,8)                                                                 '  required for certain cards (my 512MB card fails if not present)
  pinl(cs)                                                                          '  CS LOW = selected (standard active-LOW)
  if op == CMD0
    DEBUG[CH_INIT]("      [cmd] CS after pinl: ", udec_(pinr(cs)), " MISO=", udec_(pinr(miso)))
  sp_transfer(-1,8)                                                                 '  required for certain cards (my 512MB and 32GB cards fail if not present)
  sp_transfer($40 | op,8)
  sp_transfer(parm,32)
  if op == CMD0
    sp_transfer(CRC_CMD0,8)                                                         '  send CRC for cmd(0,0)
    DEBUG[CH_INIT]("      [cmd] After CMD0 sent, MISO=", udec_(pinr(miso)))
  else
    sp_transfer(CRC_CMD8,8)                                                         '  send CRC for cmd(8,$1AA)
  ' v1.5.3: GETMS-based deadline (was GETCT-based, overflowed at low sysclk)
  timed_out := false
  r1_start_ms := GETMS()
  timeout := r1_start_ms + 1000                                                   '  1s timeout
  repeat
    response := sp_transfer(-1,8)                                                   '  read 1st byte of reply
    diag_cmd_r1_polls++
    if (response & $80) == 0                                                        '  valid R1 has bit 7 = 0 (SD spec 7.3.2.1)
      diag_cmd_r1_ms := GETMS() - r1_start_ms
      quit
    if GETMS() - timeout > 0                                                        '  check timeout
      pinh(cs)                                                                      '  CS HIGH = deselected (standard active-LOW)
      response := false
      timed_out := true
      diag_cmd_r1_ms := -1                                                          '  marker for timeout
      quit
  if NOT timed_out
    if op == CMD8 OR op == CMD58                                                    '  read 32-bit reply for cmd8 and cmd58
      response := sp_transfer(-1,32)                                                '  (memory card interface condition and operation conditions register
    if op <> CMD17 AND op <> CMD24 AND op <> CMD18 AND op <> CMD25 AND op <> CMD55  '  keep cs asserted for sector read/write and application commands
      pinh(cs)                                                                      '  CS HIGH = deselected (standard active-LOW)

#ifdef SD_INCLUDE_TEST_HOOKS
PRI testFailArmedFor(sector, direction) : armed
' Report whether a targeted failure is armed for this sector in this direction,
' consuming a one-shot arming if so. Called from readSector()/writeSector().
'
' @param sector - LBA about to be transferred
' @param direction - TF_READ or TF_WRITE
' @returns armed - TRUE if this transfer must fail

  armed := test_fail_sector == sector AND (test_fail_mode & direction) <> 0
  if armed
    test_error_count++
    if (test_fail_mode & TF_STICKY) == 0                                        '  one-shot: disarm on consumption
      test_fail_sector := -1
      test_fail_mode := TF_OFF
#endif

PRI readSector(sector, buf_type) : status | _sck, _miso, data, loop_ctr, timeout, stream_mode, clk_count, xfrq, init_phase, p_buf, align_delay, p_cache, attempt, inject_fail
' Read a sector into buffer using P2 streamer - hardware DMA for bulk 512-byte transfer.
' Reference: flash_loader.spin2 pattern for SPI reads
'
' Protocol:
' 1. CMD17 (READ_SINGLE_BLOCK) with sector address
' 2. Wait for $FE start token (polled via sp_transfer_8)
' 3. Receive 512 bytes via streamer (MISO -> hub)
' 4. Receive 2 CRC bytes, validate against calculated CRC
' 5. Deselect card
'
' @param sector - Sector number to read
' @param buf_type - Buffer type: BUF_DIR, BUF_FAT, or BUF_DATA
' @returns status - 0 on success, negative error code on failure
' @local _sck - Local copy of SCK pin
' @local _miso - Local copy of MISO pin
' @local data - Received data/token
' @local loop_ctr - Token polling counter
' @local timeout - Timeout deadline
' @local stream_mode - Streamer mode word
' @local clk_count - Number of clock transitions
' @local xfrq - Streamer NCO frequency
' @local init_phase - Streamer initial phase
' @local p_buf - Pointer to destination buffer
' @local align_delay - Alignment delay before streamer
' @local p_cache - Pointer to cache variable
' @local attempt - CRC retry loop counter
' @local inject_fail - Targeted fault injection armed for this sector (test hooks only)

' Select buffer and cache based on type

  case buf_type
    BUF_DIR:
      p_buf := @dir_buf
      p_cache := @dir_sec_in_buf
    BUF_FAT:
      p_buf := @fat_buf
      p_cache := @fat_sec_in_buf
    other:                                                                      ' BUF_DATA or default
      p_buf := @buf
      p_cache := @sec_in_buf

  if sector <> LONG[p_cache]                                                    '  cache miss - must read from card
    ' debug[CH_SECTOR]("  [readSector] Reading sector ", udec_(sector), " type=", udec_(buf_type), " p_buf=", uhex_(p_buf))
    ' The buffer is about to hold transfer-in-progress bytes; the tag commits
    ' only at the end, after every accept check has passed. Committing here
    ' meant any exit that missed an explicit invalidate left a VALID tag on
    ' garbage -- and a CRC-retry success left the sector uncached (the retry
    ' path invalidated, nothing recommitted).
    LONG[p_cache] := -1

#ifdef SD_INCLUDE_TEST_HOOKS
    ' TEST HOOK: fail the nth card read (cache misses only -- a cache hit never
    ' reaches this point). Short-circuits before CMD17 with the tag already
    ' invalid, so the observable outcome matches an exhausted-retries read:
    ' E_CRC_ERROR, nothing cached, buffer contents indeterminate.
    test_read_call_count++
    if test_fail_read_after > 0 AND test_read_call_count == test_fail_read_after
      test_fail_read_after := 0                                                 '  one-shot
      test_error_count++
      return E_CRC_ERROR
#endif

    ' Pre-compute streamer constants (invariant across retries)
    _sck := sck
    _miso := miso
    stream_mode := STREAM_RX_BASE | (_miso << 17) | (SECTOR_SIZE * 8)           ' RX mode + MISO pin + bit count
    clk_count := SECTOR_SIZE * 8 * 2                                            ' 8192 clock transitions
    xfrq := $4000_0000 / spi_period                                             ' One sample per full clock period
    if ($4000_0000 // spi_period) == 0                                          ' Exact division (power-of-2 hp)?
      xfrq -= 1                                                                 ' Match write-path NCO fix: ensure 1-cycle late rollover
    init_phase := $4000_0000                                                    ' Sample mid-bit for stability
    align_delay := effectiveAlignDelay()                                        ' Phase 3: tunable streamer phase (hp=4 rule inside)

    ' CRC RETRY LOOP: Re-read on CRC mismatch (industry standard practice)
    ' Card has no CRC-error state - it just sees another CMD17 on retry
    repeat attempt from 1 TO MAX_READ_CRC_RETRIES

      ' Send CMD17 (READ_SINGLE_BLOCK)
      cmd(CMD17, sector << hcs)
      ' Detect cmd() R1 timeout (returns 0, byte-identical to a clean R1=$00).
      ' Without this check, a card that fails to acknowledge CMD17 leaves the
      ' driver spinning on the data-start-token wait, mis-classifying the
      ' failure as "no start token" when the actual problem was "command
      ' never acknowledged." Bail with E_TIMEOUT immediately - no retry can
      ' help if the card never received CMD17.
      if diag_cmd_r1_ms < 0
        DEBUG[CH_SECTOR]("  [readSector] CMD17 R1 NEVER ARRIVED (cmd() timed out) attempt ", udec_(attempt))
        pinh(cs)
        status := E_TIMEOUT
        quit                                                                  ' break retry loop

      ' Wait for start token ($FE) - use sp_transfer_8 for token polling
      ' v1.5.3: GETMS-based deadline (was GETCT-based, overflowed at low sysclk).
      ' card_read_timeout_ms already includes 100x safety factor from parseTimeouts.
      timeout := GETMS() + card_read_timeout_ms                                 ' CSD-based timeout (ms)
      loop_ctr := 0
      repeat
        data := sp_transfer_8($FF)
        loop_ctr++
        if data == $FE
          quit                                                                  ' Got start token
        if data <> $FF
          diag_last_token := data                                               '  capture the actual byte the card sent (failure path - was left stale)
          if data & $F0                                                         '  high nibble set -> not a data error token
            DEBUG[CH_SECTOR]("  [readSector] ERROR: got $", uhex_byte_(data), " (not $FF/$FE, not a data error token)")
          else
            ' Data error token (SD spec 7.3.3.3): low 4 bits = R2 error bits.
            ' The card is telling us exactly why it could not deliver data.
            DEBUG[CH_SECTOR]("  [readSector] DATA ERROR TOKEN $", uhex_byte_(data), " - error=", udec_(data & 1), " ccErr=", udec_((data >> 1) & 1), " eccFail=", udec_((data >> 2) & 1), " outOfRange=", udec_((data >> 3) & 1))
          pinh(cs)
          status := E_BAD_RESPONSE
          quit
        if GETMS() - timeout > 0
          diag_last_token := data                                               '  card stayed silent ($FF); record it rather than leaving it stale
          DEBUG[CH_SECTOR]("  [readSector] TIMEOUT waiting for start token")
          pinh(cs)
          status := E_TIMEOUT
          quit
      if status < 0                                                             '  token error or timeout
        quit                                                                    '   exit retry loop

      ' STREAMER BULK TRANSFER: Receive 512 bytes from MISO to hub buffer
      ' Pattern: SETXFRQ -> WRFAST -> WYPIN(clk) -> WAITX -> XINIT -> WAITXFI
      ' CRITICAL: Must disable MISO smart pin before streamer capture!

      ' CRITICAL FIX: Disable MISO smart pin before streamer capture
      ' The smart pin interferes with streamer's direct pin reading
      ' Reference: flash_loader.spin2 does NOT configure smart pin on MISO during reads
      ' Verified fix: 2026-01-23 in SD_streamer_lut_test.spin2
      pinclear(_miso)                                                           ' Clear smart pin mode
      pinf(_miso)                                                               ' Float pin (input mode)

      ' DIAGNOSTIC: Capture buffer state BEFORE streamer
      diag_before_b0 := BYTE[p_buf]
      diag_before_b1 := BYTE[p_buf+1]
      diag_before_b2 := BYTE[p_buf+2]
      diag_before_b3 := BYTE[p_buf+3]
      diag_spi_period := spi_period

      ' STREAMER BULK TRANSFER: 512 bytes from MISO to hub via DMA
      ' Phase 1.5 reorder (per @evanh, KB-verified against
      ' p2kbArchSmartPin00101TransitionOutput): WYPIN must execute before the
      ' first base-period boundary after DIR-rise on _sck, otherwise the first
      ' SCK transition slips by a full half-period when hp <= 6. Setup
      ' instructions (WRFAST, SETXFRQ) moved BEFORE DIR-rise; FLTL replaces
      ' DIRL+DRVL pair; WYPIN immediately follows DIRH with no instructions
      ' between, so Y is written 2 sysclks after DIR-rise (always less than
      ' hp=4 minimum) and the first SCK transition lands at tick hp.
      ORG
              WRFAST    #0, p_buf                       ' Setup WRFAST to hub buffer (before DIR-rise)
              SETXFRQ   xfrq                            ' Set streamer NCO rate (before DIR-rise)
              FLTL      _sck                            ' Reset SCK smart pin (replaces DIRL+DRVL)
              DIRH      _sck                            ' DIR=1 -- internal counter starts cycling at hp
              WYPIN     clk_count, _sck                 ' Y written 2 sysclks after DIRH (within first hp)
              WAITX     align_delay                     ' Wait to align streamer with first SCK rising edge
              XINIT     stream_mode, init_phase         ' Start streamer with phase offset
              WAITXFI                                   ' Wait for streamer to complete
      END

      ' DIAGNOSTIC: Capture data for test cog to read
      diag_last_sector := sector
      diag_last_buftype := buf_type
      diag_last_token := data                                                   ' Start token ($FE if success)
      diag_p_buf := p_buf
      diag_buf_byte0 := BYTE[p_buf]
      diag_buf_byte1 := BYTE[p_buf+1]
      diag_buf_byte2 := BYTE[p_buf+2]
      diag_buf_byte3 := BYTE[p_buf+3]

      ' Re-enable MISO smart pin for CRC reads (sp_transfer_8 needs it)
      WRPIN(_miso, spi_rx_mode)                                                 ' P_SYNC_RX | B-input->SCK
      WXPIN(_miso, miso_wxpin)                                                  ' Phase 2: adaptive sample mode
      pinh(_miso)                                                               ' DIRH - enable smart pin

      ' Read and capture 2 CRC bytes (high byte first per SD protocol)
      diag_recv_crc := sp_transfer_8($FF) << 8
      diag_recv_crc |= sp_transfer_8($FF)

      inject_fail := FALSE
#ifdef SD_INCLUDE_TEST_HOOKS
      ' TEST HOOK: targeted per-sector failure. Consumed once per read attempt,
      ' so a one-shot arming fails attempt 1 and the retry succeeds, while a
      ' sticky arming fails every attempt and the read returns E_CRC_ERROR.
      inject_fail := testFailArmedFor(sector, TF_READ)
#endif
      ' CRC-16 validation: skipped when globally disabled, or when this card
      ' returns a dummy data CRC (CW_NO_DATA_CRC, set by probeDataCrc at init).
      ' A targeted injection overrides the skip - an instrument that silently
      ' does nothing on one class of card is worse than no instrument.
      if ((NOT diag_crc_enabled) OR (card_warning_flags & CW_NO_DATA_CRC)) AND NOT inject_fail
        pinh(cs)                                                                ' Deselect card - skip CRC check
        quit                                                                    ' Exit retry loop (assume success)
      diag_calc_crc := calcDataCRC(p_buf, SECTOR_SIZE)
      ' TEST HOOK: Force CRC mismatch for error injection testing
#ifdef SD_INCLUDE_TEST_HOOKS
      if test_force_read_crc_error > 0
        diag_calc_crc ^= $FFFF
        test_force_read_crc_error--
        test_error_count++
      if inject_fail
        diag_calc_crc := diag_recv_crc ^ $FFFF                                   '  guaranteed mismatch on any card
#endif
      if diag_calc_crc == diag_recv_crc
        diag_crc_matches++
        pinh(cs)                                                                ' Deselect card - CRC OK
        quit                                                                    ' Exit retry loop on success
      else
        diag_crc_mismatches++
        pinh(cs)                                                                ' Deselect card before retry
        sp_transfer_8($FF)                                                      ' 8 NCS recovery clocks (CS HIGH, SD spec)
        if attempt < MAX_READ_CRC_RETRIES
          diag_crc_retries++
          DEBUG[CH_SECTOR]("  [readSector] CRC MISMATCH attempt ", udec_(attempt), "/", udec_(MAX_READ_CRC_RETRIES), " recv=$", uhex_(diag_recv_crc), " calc=$", uhex_(diag_calc_crc), " - retrying")
        else
          DEBUG[CH_SECTOR]("  [readSector] CRC FAILED after ", udec_(MAX_READ_CRC_RETRIES), " attempts recv=$", uhex_(diag_recv_crc), " calc=$", uhex_(diag_calc_crc))
          status := E_CRC_ERROR

    ' CMD13: Verify card internal state after read
    ' CRC validates wire integrity; CMD13 validates card-internal state (ECC, address, etc.)
    if status == 0 AND checkCardStatus(@"readSector") < 0
      status := E_IO_ERROR

    ' The ONLY tag commit. Every accept check (CRC or its sanctioned skip, then
    ' CMD13) has passed; no failure exit can reach here, so no exit can leave a
    ' valid tag on a buffer the card never filled.
    if status == 0
      LONG[p_cache] := sector
  ' else: cache hit - status stays 0 (success)

PRI readSectors(start_sector, count, p_buffer) : sectors_read | _sck, _miso, p_buf, stream_mode, clk_count, xfrq, init_phase, align_delay, resp
' Read multiple consecutive sectors using CMD18 (READ_MULTIPLE_BLOCK).
' More efficient than individual readSector() calls because:
' - Only one CMD18 command instead of N CMD17 commands
' - No inter-sector gaps from CS deassert/reassert
' - Card can pre-fetch ahead for sequential access
'
' Protocol: CMD18 -> (wait $FE -> read 512 bytes -> CRC) x N -> CMD12
'
' @param start_sector - First sector to read
' @param count - Number of sectors to read (0 returns immediately)
' @param p_buffer - Pointer to buffer (must be at least count * 512 bytes)
' @returns sectors_read - Number of sectors successfully read (0 on error)
' @local _sck - Local copy of SCK pin
' @local _miso - Local copy of MISO pin
' @local p_buf - Current buffer position
' @local stream_mode - Streamer mode word
' @local clk_count - Number of clock transitions
' @local xfrq - Streamer NCO frequency
' @local init_phase - Streamer initial phase
' @local align_delay - Alignment delay before streamer
' @local resp - Command response

  if count > 0
    ' Setup variables for streamer
    _sck := sck
    _miso := miso
    stream_mode := STREAM_RX_BASE | (_miso << 17) | (SECTOR_SIZE * 8)           ' RX mode + MISO pin + 4096 bits
    clk_count := SECTOR_SIZE * 8 * 2                                            ' 8192 clock transitions
    xfrq := $4000_0000 / spi_period                                             ' One sample per full clock period
    if ($4000_0000 // spi_period) == 0                                          ' Exact division (power-of-2 hp)?
      xfrq -= 1                                                                 ' Match write-path NCO fix: ensure 1-cycle late rollover
    init_phase := $4000_0000                                                    ' Sample mid-bit for stability
    align_delay := effectiveAlignDelay()                                        ' Phase 3: tunable streamer phase (hp=4 rule inside)

    ' Send CMD23 (SET_BLOCK_COUNT) if card supports it (verified at init by probeCmd23)
    last_cmd18_fail := 0                                                        ' Clear failure path
    last_cmd23_used := FALSE
    last_cmd23_r1 := $FF                                                        ' Default: not sent
    last_cmd23_verify := $FF                                                    ' Default: idle
    if cmd23_supported
      resp := cmd(CMD23, count)
      last_cmd23_r1 := resp
      last_cmd23_used := TRUE
      if diag_cmd_r1_ms < 0                                                     ' cmd() returns 0 on R1 timeout, byte-identical to a valid R1=$00 clean
        DEBUG[CH_SECTOR]("  [readSectors] CMD23 R1 NEVER ARRIVED (cmd() timed out)")
      else
        DEBUG[CH_SECTOR]("  [readSectors] CMD23 set block count=", udec_(count))

    ' Send CMD18 (READ_MULTIPLE_BLOCK) with starting sector
    ' Note: cmd() handles CS assertion and returns R1 response
    resp := cmd(CMD18, start_sector << hcs)
    last_cmd18_r1 := resp
    if diag_cmd_r1_ms < 0                                                       ' cmd() returns 0 on R1 timeout, byte-identical to a valid R1=$00 clean
      last_cmd18_fail := 6                                                      ' Path 6: R1 timeout (CMD18 never acknowledged)
      DEBUG[CH_SECTOR]("  [readSectors] CMD18 R1 NEVER ARRIVED (cmd() timed out)")
      pinh(cs)
    elseif resp <> $00
      last_cmd18_fail := 1                                                      ' Path 1: R1 reject
      DEBUG[CH_SECTOR]("  [readSectors] CMD18 failed, R1=$", uhex_byte_(resp))
      pinh(cs)
    else
      ' Read each sector
      sectors_read := 0
      repeat count
        p_buf := p_buffer + (sectors_read * SECTOR_SIZE)                        ' Calculate buffer position

        ' Wait for data token ($FE) for this sector
        if waitDataToken() < 0
          last_cmd18_fail := 2                                                  ' Path 2: data token fail
          DEBUG[CH_SECTOR]("  [readSectors] No data token for sector ", udec_(start_sector + sectors_read))
          quit                                                                  ' Exit loop on error

        ' Disable MISO smart pin before streamer capture
        pinclear(_miso)
        pinf(_miso)

        ' Streamer bulk transfer: 512 bytes from MISO to hub.
        ' LAYOUT-INVARIANCE (2026-08-12): SETXFRQ/WRFAST hoisted above the SCK
        ' reset, matching readSector's Phase 1.5 ordering, so every op from
        ' DRVL onward is fixed-2-clock and the capture phase is a compile-time
        ' constant. (WRFAST is near-fixed latency per p2kbArchFifo, unlike the
        ' write path's RDFAST -- hoisted anyway for one uniform discipline.)
        ORG
              SETXFRQ   xfrq                            ' Set streamer NCO rate (before SCK reset)
              WRFAST    #0, p_buf                       ' Setup WRFAST to hub buffer (before SCK reset)
              DIRL      _sck                            ' Reset SCK: counter stops, output LOW, Y=0
              DRVL      _sck                            ' Re-enable: DIR=1 restarts base period counter fresh
              WYPIN     clk_count, _sck                 ' Y written 2 sysclks after DIR-rise (within first hp)
              WAITX     align_delay                     ' Align streamer with first SCK rising edge
              XINIT     stream_mode, init_phase         ' Start streamer with phase offset -- fixed offset from DRVL
              WAITXFI
        END

        ' Re-enable MISO smart pin for CRC reads
        WRPIN(_miso, spi_rx_mode)
        WXPIN(_miso, miso_wxpin)                                                ' Phase 2: adaptive sample mode
        pinh(_miso)

        ' Read and capture 2 CRC bytes, validate against calculated CRC
        diag_recv_crc := sp_transfer_8($FF) << 8
        diag_recv_crc |= sp_transfer_8($FF)

        if diag_crc_enabled AND NOT (card_warning_flags & CW_NO_DATA_CRC)
          diag_calc_crc := calcDataCRC(p_buf, SECTOR_SIZE)
          if diag_calc_crc == diag_recv_crc
            diag_crc_matches++
          else
            diag_crc_mismatches++
            DEBUG[CH_SECTOR]("  [readSectors] CRC MISMATCH sec ", udec_(start_sector + sectors_read), " recv=$", uhex_(diag_recv_crc), " calc=$", uhex_(diag_calc_crc))

        sectors_read++

      ' Capture sectors actually read before CMD12/CMD13 might zero the count
      last_cmd18_sread := sectors_read

      if last_cmd23_used
        ' CMD23 path: card should have auto-stopped after N sectors
        ' Verify: clock one byte - if card stopped, MISO should be $FF (idle)
        resp := sp_transfer_8($FF)
        last_cmd23_verify := resp
        if resp <> $FF
          DEBUG[CH_SECTOR]("  [readSectors] CMD23 WARNING: card still outputting after count reached ($", uhex_byte_(resp), ")")
          ' Card didn't honor CMD23 auto-stop - fall back to CMD12 for this and future reads
          cmd23_supported := FALSE
          last_cmd23_used := FALSE
          sendStopTransmission()
        pinh(cs)                                                                ' Deselect card
        DEBUG[CH_SECTOR]("  [readSectors] CMD23 path: ", udec_(sectors_read), " sectors, no CMD12 needed")

        ' CMD13: Verify card internal state after multi-block read
        if checkCardStatus(@"readSectors") < 0
          last_cmd18_fail := 4                                                  ' Path 4: CMD13 fail
          DEBUG[CH_SECTOR]("  [readSectors] CMD13 status check FAILED")
          sectors_read := 0                                                     ' Card reports error - data can't be trusted
      else
        ' CMD12 path: send CMD12 to stop transmission
        if sendStopTransmission() < 0
          ' CMD12 failed - but if all requested sectors arrived with valid CRC,
          ' the data is trustworthy. Some cards (SP Elite) return garbled R1 from
          ' CMD12 while data transfer is perfect. See rpt6-cmd12-external-analysis.txt.
          recoverToIdle()                                                       ' Force card back to idle
          if sectors_read == count
            last_cmd18_fail := 5                                                ' Path 5: CMD12 fail, tolerated
            DEBUG[CH_SECTOR]("  [readSectors] CMD12 R1 error (tolerated, all ", udec_(count), " sectors received)")
          else
            last_cmd18_fail := 3                                                ' Path 3: CMD12 fail, data incomplete
            DEBUG[CH_SECTOR]("  [readSectors] CMD12 failed - incomplete read, recovering")
            sectors_read := 0                                                   ' Incomplete data can't be trusted
        else
          pinh(cs)                                                              ' Deselect card

          ' CMD13: Verify card internal state after multi-block read
          if checkCardStatus(@"readSectors") < 0
            last_cmd18_fail := 4                                                ' Path 4: CMD13 fail
            DEBUG[CH_SECTOR]("  [readSectors] CMD13 status check FAILED")
            sectors_read := 0                                                   ' Card reports error - data can't be trusted

PRI invalidateCacheRange(first_sector, last_sector) | idx
' Cross-tier cache coherence for a written or erased LBA range: clear every
' dir/FAT/data tag inside [first_sector, last_sector], and every CLEAN
' per-handle buffer tag in the range.
'
' DIRTY handle buffers are deliberately EXEMPT. Every handle-flush path copies
' the handle buffer into buf and calls writeSector() while HF_DIRTY is still
' set (the flag clears only after the call returns), so the exemption is what
' stops a handle's own flush from discarding the very buffer it is flushing.
' For any OTHER dirty overlap the handle's pending flush is the newest copy of
' that sector and wins -- last-writer semantics; single-writer policy makes a
' second dirty holder of the same sector impossible, and invalidating a dirty
' tag would orphan the user's unflushed bytes and hand the later sync a -1
' sector to write.
'
' @param first_sector - First LBA of the invalidated range
' @param last_sector - Last LBA of the invalidated range (== first_sector for one sector)
' @local idx - Handle index

  if dir_sec_in_buf >= first_sector AND dir_sec_in_buf <= last_sector
    dir_sec_in_buf := -1
  if fat_sec_in_buf >= first_sector AND fat_sec_in_buf <= last_sector
    fat_sec_in_buf := -1
  if sec_in_buf >= first_sector AND sec_in_buf <= last_sector
    sec_in_buf := -1
  repeat idx from 0 TO MAX_OPEN_FILES - 1
    if h_buf_sector[idx] >= first_sector AND h_buf_sector[idx] <= last_sector AND NOT (h_flags[idx] & HF_DIRTY)
      h_buf_sector[idx] := -1

PRI writeSector(sector, buf_type) : status | _sck, _mosi, p_buf, stream_mode, clk_count, xfrq, resp, p_cache, inject_fail, tx_pad
' Write buffer into a sector using P2 streamer - hardware DMA for bulk 512-byte transfer.
' Reference: flash_loader.spin2 pattern for SPI writes
'
' PNY COMPATIBILITY: This implementation follows strict SPI write protocol:
' 1. CMD24 with sector address
' 2. Data start token ($FE)
' 3. 512 bytes of data via streamer (hub -> MOSI)
' 4. 2 CRC bytes (calculated CRC-16-CCITT, high byte first)
' 5. Wait for data-response token ($x5 = accepted)
' 6. Wait for MISO to go HIGH ($FF = programming complete)
' CRITICAL: CS must stay LOW and clocking must continue during entire busy period!
'
' @param sector - Sector number to write
' @param buf_type - Buffer type: BUF_DIR, BUF_FAT, or BUF_DATA
' @returns status - 0 on success, negative error code on failure
' @local _sck - Local copy of SCK pin
' @local _mosi - Local copy of MOSI pin
' @local p_buf - Pointer to source buffer
' @local stream_mode - Streamer mode word
' @local clk_count - Number of clock transitions
' @local xfrq - Streamer NCO frequency
' @local resp - Response byte
' @local p_cache - Pointer to cache variable
' @local inject_fail - Targeted fault injection armed for this write (test hooks only)
' @local tx_pad - WAITX phase pad between SCK reset and XINIT (from tx_align_delay)

' Select buffer and cache based on type

  case buf_type
    BUF_DIR:
      p_buf := @dir_buf
      p_cache := @dir_sec_in_buf
    BUF_FAT:
      p_buf := @fat_buf
      p_cache := @fat_sec_in_buf
    other:                                                                      ' BUF_DATA or default
      p_buf := @buf
      p_cache := @sec_in_buf

  _sck := sck
  _mosi := mosi
  ' p_buf already set above based on buf_type

  ' Invalidate cache for this buffer type after write
  LONG[p_cache] := -1

  ' Cross-tier cache coherence: any other cache holding this sector -- the two
  ' other DAT tiers AND any clean per-handle buffer -- is stale the moment this
  ' write lands. (The old sweep here checked only the three DAT tags; a handle
  ' holding the sector kept serving pre-write bytes.) Runs before the transfer
  ' so a failed/partial write can never leave a cache claiming to describe the
  ' sector; see invalidateCacheRange for the dirty-handle exemption that
  ' protects the flush-own-buffer path.
  invalidateCacheRange(sector, sector)

  ' Capture sector for diagnostics
  diag_write_sector := sector
  diag_write_result := 0                                                        ' Reset: not yet determined

#ifdef SD_INCLUDE_TEST_HOOKS
  ' TEST HOOK: targeted write failure. Reported here, after cache invalidation
  ' and before CMD24, so the driver-visible outcome matches a card that rejected
  ' the data block: nothing committed, every cache holding this sector already
  ' invalidated above, E_WRITE_REJECTED returned with write-diagnostic code 3.
  ' Short-circuiting rather than corrupting the CRC makes the failure independent
  ' of whether a given card enforces write CRC - a CW_NO_DATA_CRC card is sent
  ' idle filler in the CRC slot and would never reject.
  test_write_call_count++                                                       '  count every write, armed or not
  inject_fail := test_fail_write_after > 0 AND test_write_call_count == test_fail_write_after
  if inject_fail
    test_fail_write_after := 0                                                  '  one-shot
    test_error_count++
  elseif testFailArmedFor(sector, TF_WRITE)
    inject_fail := TRUE
  if inject_fail
    diag_write_dresp := DATA_CRC_ERROR
    diag_write_result := 3                                                      '  3 = CRC reject, same as a genuine rejection
    return E_WRITE_REJECTED
#endif

  resp := cmd(CMD24, sector << hcs)
  diag_write_r1 := resp                                                         ' Capture CMD24 R1 response
  if diag_cmd_r1_ms < 0                                                         ' cmd() returns 0 on R1 timeout, byte-identical to a valid R1=$00 clean
    DEBUG[CH_SECTOR]("  [writeSector] CMD24 R1 NEVER ARRIVED (cmd() timed out)")
    diag_write_result := 8                                                      ' 8 = R1 timeout (not the same as R1-with-fatal-bits)
    pinh(cs)
    status := E_TIMEOUT
  elseif resp & R1_FATAL_MASK                                                   ' Fatal R1 bits: illegal cmd ($04), address err ($20), parameter err ($40)
    DEBUG[CH_SECTOR]("  [writeSector] CMD24 FATAL, R1=$", uhex_byte_(resp))
    diag_write_result := 1                                                      ' 1 = CMD24 fatal-R1
    pinh(cs)
    status := E_IO_ERROR
  else
    if resp & R1_STALE_MASK                                                     ' Stale R1 bits: idle ($01), erase reset ($02), CRC ($08), erase seq ($10)
      DEBUG[CH_SECTOR]("  [writeSector] CMD24 warning: R1=$", uhex_byte_(resp), " (stale bits, proceeding)")
    sp_transfer_8($FE)                                                          ' Data start token

    ' STREAMER BULK TRANSFER: Send 512 bytes from hub buffer to MOSI
    ' Pattern: SETXFRQ -> RDFAST -> DIRL/DRVL(SCK) -> WAITX -> XINIT -> WYPIN(clk) -> WAITXFI
    ' Mode word format: base_mode | (pin << 17) | bit_count
    ' For 512 bytes: 512 * 8 = 4096 bits = $1000
    stream_mode := STREAM_TX_BASE | (_mosi << 17) | (SECTOR_SIZE * 8)           ' TX mode + MOSI pin + bit count
    clk_count := SECTOR_SIZE * 8 * 2                                            ' 8192 clock transitions
    tx_pad := tx_align_delay
    if tx_pad < 2                                                               '  WAITX floor (cog needs 2 sysclks min)
      tx_pad := 2

    ' Calculate streamer NCO frequency to match SPI clock
    ' Same formula as readSector: one bit per full clock period
    xfrq := $4000_0000 / spi_period                                             ' One output per full clock period
    if ($4000_0000 // spi_period) == 0                                          ' Exact division (power-of-2 hp)?
      xfrq -= 1                                                                 ' Ensure 1-cycle late rollover like truncated values

    pinclear(_mosi)                                                             ' Clear smart pin mode (WRPIN=0, DIR=0)
    pinl(_mosi)                                                                 ' Drive pin low (DIR=1, output mode)

    ' Streamer TX with LAYOUT-INVARIANT clock alignment (2026-08-12):
    '   1. SETXFRQ and RDFAST execute BEFORE the SCK reset. RDFAST's blocking
    '      FIFO fill is documented at 10-17 sysclks (p2kbPasm2Rdfast) -- an
    '      8-value spread it does not pin to a single cause. Whatever drives
    '      it, it is NOT a fixed instruction count, and pre-fix it sat between
    '      DRVL and XINIT, so the MOSI-bitstream-to-SCK phase was not a
    '      compile-time constant. Losing phases stored every sector shifted
    '      one bit late at the card, silently (SPI-mode write CRC is not
    '      enforced -- CMD59 is never sent, so dresp=$05 proves framing only).
    '      DO NOT re-narrow this to "egg-beater slot wait for p_buf's address
    '      slice." That attribution was asserted here through 2026-08-12 and
    '      is NOT established: p2kbArchP2ArchitectureMentalModel states the
    '      hub slot wait as "depending on when the COG's slot arrives" -- a
    '      property of issue time, not of the address requested. The fix does
    '      not depend on which it is; the correctness argument is only that a
    '      variable-latency instruction must not sit inside the phase window.
    '   2. dirl/drvl on SCK resets the P_TRANSITION base-period counter
    '      (DIR=0 resets counter, output, Y without clearing WRPIN/WXPIN
    '       config; drvl sets DIR=1 with OUT=0, enabled and ready)
    '   3. From DRVL on, every op is a fixed-2-clock cog op: WAITX tx_pad,
    '      XINIT at a compile-time-constant offset, WYPIN 2 clocks later.
    '      SCK edges land on the base-period grid anchored at DIR-rise
    '      (p2kbArchSmartPin00101TransitionOutput), so data-vs-clock phase is
    '      now a build-independent constant, tuned once via tx_align_delay.
    ' History: RDFAST sat inside this window in EVERY release from v0.9.3 through
    ' v1.6.1 (verified by walking the tags). v1.5.2 additionally removed the WAITX
    ' that had sat between XINIT and WYPIN, which moved the phase but did not
    ' introduce the window problem. The fault was observed ONCE, at a41c839, and
    ' confirmed at the card by reading the affected sectors back with a known-good
    ' build (SD_stored_shift_probe: 495/495 bytes shifted, three patterns).
    ' WHAT SELECTS THE FAILING PHASE IS NOT IDENTIFIED. Do not write "layout" here
    ' as though it were the cause -- that attribution was withdrawn 2026-08-13, and
    ' no released build has ever been shown to produce the fault.
    ORG
              SETXFRQ   xfrq                            ' Set streamer bit rate (before SCK reset)
              RDFAST    #0, p_buf                       ' Prime FIFO -- variable-latency op lands HERE, outside the phase window
              DIRL      _sck                            ' Reset SCK: counter stops, output LOW, Y=0
              DRVL      _sck                            ' Re-enable: DIR=1 restarts base period counter fresh
              WAITX     tx_pad                          ' Engineered phase pad (tx_align_delay, floor 2)
              XINIT     stream_mode, #0                 ' Start streamer; NCO ramps from zero -- fixed offset from DRVL
              WYPIN     clk_count, _sck                 ' Start clock -- fixed offset from DRVL
              WAITXFI                                   ' Wait for streamer to complete
    END

    ' Rebuild MOSI smart pin for CRC and response byte transfers
    WRPIN(_mosi, spi_tx_mode)                                                   ' P_SYNC_TX | P_OE | B-input->SCK
    WXPIN(_mosi, %1_00111)                                                      ' Start-stop mode, 8 bits
    pinh(_mosi)                                                                 ' DIRH - enable smart pin

    ' EXPERIMENT 3 (asdfg counterfeit wedge investigation, 2026-05-26):
    ' For CW_NO_DATA_CRC cards (which return placeholder $0000/$FFFF as CRC on
    ' reads, indicating non-spec CRC handling), send $FF $FF idle bytes in the
    ' CRC packet slot instead of a calculated CRC. Per SD spec section 7.2,
    ' CRC validation is OFF by default in SPI mode and the 2 CRC bytes are
    ' part of the packet framing - the card is supposed to ignore their
    ' content. But on counterfeit silicon "supposed to ignore" and "actually
    ' ignores" may differ; this test asks whether the real CRC bytes are
    ' confusing the card's data-response state machine.
    ' Normal cards: unchanged (real calculated CRC).
    if card_warning_flags & CW_NO_DATA_CRC
      diag_sent_crc := $FFFF                                                    ' record what was sent for diag
      sp_transfer_8($FF)                                                        ' CRC high byte: idle filler
      sp_transfer_8($FF)                                                        ' CRC low byte: idle filler
    else
      ' SD protocol: CRC high byte first, then low byte
      diag_sent_crc := calcDataCRC(p_buf, SECTOR_SIZE)
      ' TEST HOOK: Corrupt write CRC for error injection testing (one-shot)
#ifdef SD_INCLUDE_TEST_HOOKS
      if test_force_write_crc_error
        diag_sent_crc ^= $FFFF
        test_force_write_crc_error := 0
        test_error_count++
#endif
      sp_transfer_8(diag_sent_crc >> 8)                                         ' CRC high byte
      sp_transfer_8(diag_sent_crc & $FF)                                        ' CRC low byte

    ' Wait for data-response token (should be immediate, within a few bytes)
    resp := waitDataResponse()
    if resp < 0
      diag_write_result := 2                                                    ' 2 = data-response timeout
      diag_write_dresp := $FF
      pinh(cs)
      status := E_TIMEOUT
    else
      diag_write_dresp := resp                                                  ' Capture data response token (masked)
      ' Verify data-response token: bits [3:1] decode as: 010=accepted, 101=CRC error, 110=write error
      if resp <> DATA_ACCEPTED
        if resp == DATA_CRC_ERROR
          DEBUG[CH_SECTOR]("  [writeSector] Data REJECTED: CRC error (response=$", uhex_byte_(resp), ")")
          diag_write_result := 3                                                ' 3 = CRC reject
          status := E_WRITE_REJECTED
        elseif resp == DATA_WRITE_ERROR
          DEBUG[CH_SECTOR]("  [writeSector] Data REJECTED: Write error (response=$", uhex_byte_(resp), ")")
          diag_write_result := 4                                                ' 4 = write error reject
          status := E_WRITE_REJECTED
        else
          DEBUG[CH_SECTOR]("  [writeSector] Data REJECTED: Unknown status (response=$", uhex_byte_(resp), ")")
          diag_write_result := 5                                                ' 5 = unknown reject
          status := E_IO_ERROR
        pinh(cs)

    if status == SUCCESS
      ' Wait for card to finish programming (busy period)
      ' CRITICAL for PNY: Keep CS LOW and keep clocking until card releases MISO!
      if waitBusyComplete() < 0
        diag_write_result := 6                                                  ' 6 = busy timeout
        pinh(cs)
        status := E_CARD_BUSY

    if status == SUCCESS
      pinh(cs)
      diag_write_result := 7                                                    ' 7 = success

      ' CMD13: Verify card internal state after write
      ' Data response $05 confirms wire-level acceptance; CMD13 validates card-internal state
      if checkCardStatus(@"writeSector") < 0
        status := E_IO_ERROR

PRI writeSectors(start_sector, count, p_buffer) : sectors_written | _sck, _mosi, p_buf, stream_mode, clk_count, xfrq, tx_pad, resp, failure_path, failure_msg_ptr, failure_sector, failure_r1, failure_resp, postloop_msg_ptr, postloop_sectors
' Write multiple consecutive sectors using CMD25 (WRITE_MULTIPLE_BLOCK).
' More efficient than individual writeSector() calls because:
' - Only one CMD25 command instead of N CMD24 commands
' - Card can optimize internal flash writes for sequential access
' - Reduced overhead from CS cycling and command processing
'
' CRITICAL: Multi-block write uses different tokens than single-block!
' - Each data block uses $FC (not $FE) as start token
' - Transmission ends with $FD stop token (not CMD12!)
'
' Protocol: CMD25 -> ($FC + 512 bytes + CRC + wait busy) x N -> $FD -> wait busy
'
' @param start_sector - First sector to write
' @param count - Number of sectors to write (0 returns immediately)
' @param p_buffer - Pointer to source data (must be at least count * 512 bytes)
' @returns sectors_written - Number of sectors successfully written (0 on error)
' @local _sck - Local copy of SCK pin
' @local _mosi - Local copy of MOSI pin
' @local p_buf - Current buffer position
' @local stream_mode - Streamer mode word
' @local clk_count - Number of clock transitions
' @local xfrq - Streamer NCO frequency
' @local resp - Response byte
' @local failure_path - Per-block exit reason: 0=ok, 1=no dresp, 2=rejected, 3=stuck busy
' @local failure_msg_ptr - DAT pointer to per-block / CMD25 failure label (0 = no failure)
' @local failure_sector - Absolute sector that failed (for per-block paths)
' @local failure_r1 - R1 byte captured on CMD25 fatal-R1 failure
' @local failure_resp - dresp byte captured on per-block rejection failure
' @local postloop_msg_ptr - DAT pointer to post-loop ($FD/CMD13) failure label (0 = no failure)
' @local postloop_sectors - sectors_written captured before recovery zero-out
' @local tx_pad - WAITX phase pad between SCK reset and XINIT (from tx_align_delay)

  if count > 0
    ' Every cache tag inside the written range -- all three DAT tiers and any
    ' clean per-handle buffer -- is stale once blocks start landing. Invalidated
    ' up front (conservatively covering the FULL range even if a per-block
    ' failure stops the burst early) so no failure path can leave a cache
    ' describing pre-write bytes.
    invalidateCacheRange(start_sector, start_sector + count - 1)

    ' Setup variables for streamer
    _sck := sck
    _mosi := mosi
    stream_mode := STREAM_TX_BASE | (_mosi << 17) | (SECTOR_SIZE * 8)           ' TX mode + MOSI pin + 4096 bits
    tx_pad := tx_align_delay
    if tx_pad < 2                                                               '  WAITX floor (cog needs 2 sysclks min)
      tx_pad := 2
    clk_count := SECTOR_SIZE * 8 * 2                                            ' 8192 clock transitions
    xfrq := $4000_0000 / spi_period                                             ' One output per full clock period
    if ($4000_0000 // spi_period) == 0                                          ' Exact division (power-of-2 hp)?
      xfrq -= 1                                                                 ' Ensure 1-cycle late rollover like truncated values

    ' Send CMD25 (WRITE_MULTIPLE_BLOCK) with starting sector
    ' Note: cmd() handles CS assertion and returns R1 response
    resp := cmd(CMD25, start_sector << hcs)
    if diag_cmd_r1_ms < 0                                                       ' cmd() returns 0 on R1 timeout, byte-identical to a valid R1=$00 clean
      failure_msg_ptr := @msg_ws_cmd25_no_resp
      pinh(cs)
    elseif resp <> $00
      failure_msg_ptr := @msg_ws_cmd25_fatal
      failure_r1 := resp
      pinh(cs)
    else
      ' Write each sector
      sectors_written := 0
      failure_path := 0                                                         ' 0=ok, 1=no dresp, 2=rejected, 3=stuck busy
      repeat count
        p_buf := p_buffer + (sectors_written * SECTOR_SIZE)                     ' Calculate buffer position

        ' Send multi-block write start token ($FC, NOT $FE!)
        sp_transfer_8(TOKEN_START_MULTI_WRITE)                                  ' $FC

        pinclear(_mosi)                                                         ' Clear smart pin mode
        pinl(_mosi)                                                             ' Drive pin low (output mode)

        ' Streamer TX with LAYOUT-INVARIANT clock alignment (2026-08-12; see
        ' writeSector for the full rationale, including why the cause of
        ' RDFAST's variable latency is NOT attributed here). RDFAST executes
        ' BEFORE the SCK reset; everything from DRVL to XINIT/WYPIN is
        ' fixed-2-clock, so data-vs-clock phase is a build-independent
        ' constant tuned via tx_align_delay.
        ORG
              SETXFRQ   xfrq                            ' Set streamer bit rate (before SCK reset)
              RDFAST    #0, p_buf                       ' Prime FIFO -- variable-latency op outside the phase window
              DIRL      _sck                            ' Reset SCK: counter stops, output LOW, Y=0
              DRVL      _sck                            ' Re-enable: DIR=1 restarts base period counter fresh
              WAITX     tx_pad                          ' Engineered phase pad (tx_align_delay, floor 2)
              XINIT     stream_mode, #0                 ' Start streamer; NCO ramps from zero -- fixed offset from DRVL
              WYPIN     clk_count, _sck                 ' Start clock -- fixed offset from DRVL
              WAITXFI
        END

        ' Rebuild MOSI smart pin for CRC and response
        WRPIN(_mosi, spi_tx_mode)
        WXPIN(_mosi, %1_00111)
        pinh(_mosi)

        ' EXPERIMENT 3 (matches writeSector single-block): for CW_NO_DATA_CRC
        ' cards send $FF $FF idle bytes in the CRC slot instead of a calculated
        ' CRC. See writeSector for the full rationale.
        if card_warning_flags & CW_NO_DATA_CRC
          diag_sent_crc := $FFFF
          sp_transfer_8($FF)
          sp_transfer_8($FF)
        else
          ' Calculate and send CRC-16 for this sector's data
          diag_sent_crc := calcDataCRC(p_buf, SECTOR_SIZE)
          sp_transfer_8(diag_sent_crc >> 8)                                     ' CRC high byte
          sp_transfer_8(diag_sent_crc & $FF)                                    ' CRC low byte

        ' Wait for data response token
        resp := waitDataResponse()
        if resp < 0
          failure_msg_ptr := @msg_ws_no_dresp
          failure_sector := start_sector + sectors_written
          failure_path := 1                                                     ' card never sent dresp; state indeterminate
          quit
        if (resp & $0F) <> DATA_ACCEPTED
          failure_msg_ptr := @msg_ws_rejected
          failure_sector := start_sector + sectors_written
          failure_resp := resp
          failure_path := 2                                                     ' clean rejection; per spec, $FD is the required next move
          quit

        ' Wait for card to finish programming this block
        if waitBusyComplete() < 0
          failure_msg_ptr := @msg_ws_busy_perblock
          failure_sector := start_sector + sectors_written
          failure_path := 3                                                     ' card stuck busy; $FD to busy card is undefined
          quit

        sectors_written++

      ' Path 1 (no dresp) and Path 3 (stuck busy) leave the card in an
      ' indeterminate or wedged state. Sending $FD now would either be
      ' interpreted against unknown card state (path 1 may still be in
      ' data-reception) or against a busy card (path 3, undefined per spec).
      ' Skip the stop token and go straight to recovery.
      ' Path 0 (full success) and Path 2 (clean rejection per SD spec
      ' section 7.3.3.1) require the $FD stop transmission token.
      if failure_path == 1 OR failure_path == 3
        recoverToIdle()                                                         ' Force card back to idle
        sectors_written := 0                                                    ' Write integrity unknown
      else
        ' Send stop token ($FD) to terminate multi-block write (NOT CMD12!)
        sp_transfer_8(TOKEN_STOP_TRAN)                                          ' $FD
        sp_transfer_8($FF)                                                      ' Stuff byte (NWR=1, required by spec)

        ' Wait for card to finish any final programming - card is in PROGRAMMING state
        if waitBusyComplete() < 0
          postloop_msg_ptr := @msg_ws_busy_final
          postloop_sectors := sectors_written
          recoverToIdle()                                                       ' Force card back to idle
          sectors_written := 0                                                  ' Write integrity unknown
        else
          pinh(cs)                                                              ' Deselect card

          ' CMD13: Verify card internal state after multi-block write
          if checkCardStatus(@"writeSectors") < 0
            postloop_msg_ptr := @msg_ws_cmd13_failed
            postloop_sectors := sectors_written
            sectors_written := 0                                                ' Card reports error - writes can't be trusted

      ' Path 2: clean per-block rejection - $FD sent, card went idle, but nothing
      ' counts as written from the rejected block on; 0 tells the caller the batch
      ' failed. (This check previously sat AFTER the consolidated debug emit below,
      ' where the emit block's outdent left it nested under `if postloop_msg_ptr <> 0`
      ' -- unreachable for path 2, which sets failure_msg_ptr. A rejected CMD25
      ' therefore returned a partial count that read as success.)
      if failure_path == 2
        sectors_written := 0                                                    ' caller treats 0 as failure

  ' Consolidated debug emit: one record for per-block/CMD25 failure family,
  ' one for post-loop ($FD/CMD13) failure family. Silent on full success.
  ' Saves 6 compiled records vs the original 8 per-branch DEBUG calls.
  if failure_msg_ptr <> 0
    DEBUG[CH_SECTOR]("  [writeSectors] ", zstr_(failure_msg_ptr), " sector=", udec_(failure_sector), " R1=$", uhex_byte_(failure_r1), " resp=$", uhex_byte_(failure_resp))
  if postloop_msg_ptr <> 0
    DEBUG[CH_SECTOR]("  [writeSectors] post-loop: ", zstr_(postloop_msg_ptr), " sectors_written=", udec_(postloop_sectors))

PRI waitDataToken() : status | timeout, resp
' Wait for data start token ($FE) - polls for data token before sector data.
' Error tokens: $01-$0F indicate read errors.
' Timeout: Uses card_read_timeout_ms from CSD (minimum 100ms, with 10x safety factor)
'
' @returns status - 0 on success (got $FE), negative error code on timeout or error token
' @local timeout - Timeout deadline
' @local resp - Received byte

  ' v1.5.3: GETMS-based deadline (was GETCT-based, overflowed at low sysclk).
  ' card_read_timeout_ms already includes 100x safety factor from parseTimeouts.
  status := E_TIMEOUT                                                           '  default: timeout
  last_cmd18_token := $FF                                                       ' Default: no token received
  last_cmd18_result := 1                                                        ' Default: timeout
  timeout := GETMS() + card_read_timeout_ms                                     ' CSD-based timeout (ms)
  repeat
    resp := sp_transfer_8($FF)
    if resp == TOKEN_START_BLOCK                                                ' $FE = data coming
      last_cmd18_token := resp
      last_cmd18_result := 0                                                    ' Success
      status := 0                                                               ' Success
      quit
    if resp <> $FF                                                              ' Error token (not $FF, not $FE)
      last_cmd18_token := resp
      last_cmd18_result := 2                                                    ' Error token
      DEBUG[CH_RECOVER]("  [waitDataToken] ERROR token: $", uhex_byte_(resp))
      status := E_BAD_RESPONSE
      quit
    if GETMS() - timeout > 0
      DEBUG[CH_RECOVER]("  [waitDataToken] TIMEOUT")
      quit

PRI waitDataResponse() : response | timeout, resp
' Wait for data response token after write - polls for data response after sending a block.
' Response format: xxx0sss1 where sss = 010 (accepted), 101 (CRC err), 110 (write err)
' Timeout: 100ms
'
' @returns response - Response status on success, negative error code on timeout
' @local timeout - Timeout deadline
' @local resp - Received byte

  ' v1.5.3: GETMS-based deadline (was GETCT-based, overflowed at low sysclk)
  response := E_TIMEOUT                                 '  default: timeout
  timeout := GETMS() + 100                              ' 100ms timeout
  repeat
    resp := sp_transfer_8($FF)
    if resp <> $FF
      ' Got response - check if it's a valid data response token (bit 0 = 1, bit 4 = 0)
      if (resp & $11) == $01                            ' Valid data response format
        response := resp & DATA_RESPONSE_MASK           ' Lower 5 bits
        quit
    ' Not a valid response format, keep polling (might be noise)
    if GETMS() - timeout > 0
      DEBUG[CH_RECOVER]("  [waitDataResponse] TIMEOUT")
      quit

PRI waitBusyComplete() : status | timeout, resp
' Wait for card to finish programming - polls until MISO returns $FF (not busy).
' Timeout: Uses card_write_timeout_ms from CSD (default 250ms for SDHC, calculated for SDSC)
' CRITICAL: Must keep clocking and CS LOW during busy period!
'
' @returns status - 0 on success, negative error code on timeout
' @local timeout - Timeout deadline
' @local resp - Received byte

  ' v1.5.3: GETMS-based deadline (was GETCT-based, overflowed at low sysclk
  ' for SDSC's spec'd long write timeouts up to 30s)
  status := E_TIMEOUT                                                           '  default: timeout
  timeout := GETMS() + card_write_timeout_ms                                    ' CSD-based timeout (ms)
  repeat
    resp := sp_transfer_8($FF)
    if resp == $FF                                                              ' Card released MISO = done
      status := 0
      quit
    if GETMS() - timeout > 0
      DEBUG[CH_RECOVER]("  [waitBusyComplete] TIMEOUT - card still busy")
      quit

PRI sendStopTransmission() : status | resp, idx, timeout
' Send CMD12 to stop multi-block operation - terminates multi-block read/write.
' Note: CMD12 has a "stuff byte" before the response - we handle this by polling.
' Captures the first 16 bytes after the stuff byte into cmd12_capture[] for framing analysis.
'
' @returns status - 0 on success, negative error code on error
' @local resp - Response byte
' @local idx - Capture buffer index
' @local timeout - Timeout deadline

' Capture MISO bytes during CMD12 transmission (full-duplex: card outputs while we send)

  cmd12_pre_capture[0] := sp_transfer_8($40 | CMD12)    ' Command byte: 0x40 | 12 = 0x4C
  cmd12_pre_capture[1] := sp_transfer_8($00)            ' Argument bytes (ignored for CMD12)
  cmd12_pre_capture[2] := sp_transfer_8($00)
  cmd12_pre_capture[3] := sp_transfer_8($00)
  cmd12_pre_capture[4] := sp_transfer_8($00)
  cmd12_pre_capture[5] := sp_transfer_8(CRC_CMD12)      ' CRC7 + stop bit for CMD12
  cmd12_pre_capture[6] := sp_transfer_8($FF)            ' Stuff byte (required by spec)

  ' Capture raw byte stream for framing analysis, then find R1
  bytefill(@cmd12_capture, $FF, 16)
  cmd12_capture_len := 0
  last_cmd12_r1 := -1                                   ' Default: no response
  last_cmd12_busy := 1                                  ' Default: timeout

  ' v1.5.3: GETMS-based deadline (was GETCT-based, overflowed at low sysclk)
  timeout := GETMS() + 100                              ' 100ms timeout
  idx := 0
  repeat
    resp := sp_transfer_8($FF)
    if idx < 16
      cmd12_capture[idx] := resp
      idx++
    if resp <> $FF
      cmd12_capture_len := idx                          ' Record position of first non-$FF
      last_cmd12_r1 := resp
      quit
    if GETMS() - timeout > 0
      cmd12_capture_len := idx
      DEBUG[CH_RECOVER]("  [sendStopTransmission] TIMEOUT waiting for R1")
      status := E_TIMEOUT
      quit

  if status == 0
    ' Capture remaining bytes after R1 (for post-R1 framing analysis)
    repeat while idx < 16
      cmd12_capture[idx] := sp_transfer_8($FF)
      idx++

    ' Evaluate R1 response
    if last_cmd12_r1 <> $00
      last_cmd12_busy := 2                              ' R1 error
      DEBUG[CH_RECOVER]("  [sendStopTransmission] R1 error: $", uhex_byte_(last_cmd12_r1))
      status := E_IO_ERROR
    else
      ' Wait for busy to complete (card may still be finishing last block)
      status := waitBusyComplete()
      if status < 0
        last_cmd12_busy := 3                            ' Busy timeout
      else
        last_cmd12_busy := 0                            ' Success

PRI recoverToIdle() : status
' Force the card's SPI state machine back to idle by deasserting CS and clocking.
' In SPI mode, CS deassert aborts any pending operation (multi-block read/write, busy).
' Dummy clocks with CS high allow the card to release MISO and transition to standby.
' VERIFIES that the card actually released the bus (MISO goes high).
'
' @returns status - 0 if card released bus, negative error code if card still holding MISO low

  pinh(cs)                                              ' CS HIGH - abort any pending operation
  repeat 10
    sp_transfer_8($FF)                                  ' 80 clocks with CS deasserted - let card release bus

  ' Verify card released MISO (should be high via pull-up when CS is deasserted)
  if pinr(miso) == 0
    ' Card still holding MISO low - try extended clocking
    DEBUG[CH_RECOVER]("  [recoverToIdle] MISO still low after 80 clocks, extending...")
    repeat 20
      sp_transfer_8($FF)                                ' 160 more clocks - extended recovery
    if pinr(miso) == 0
      DEBUG[CH_RECOVER]("  [recoverToIdle] FAILED: card holding MISO low after 240 clocks")
      status := E_IO_ERROR                              ' Card stuck - caller must handle

PRI sendCmd13Transaction() : r1, status | idx, resp, timeout
' Send CMD13 with full-duplex MISO capture - shared wire transaction for probeCmd13
' and checkCardStatus. Sends dummy clocks with CS HIGH for recovery, then CMD13 with
' full-duplex capture of both pre-command MISO bytes and post-command response stream.
' Populates cmd13_pre_capture[], cmd13_capture[], cmd13_capture_len for diagnostic
' inspection. Stages last_cmd13_r1, last_cmd13_status, last_cmd13_error.
'
' @returns r1 - R1 response byte (-1 if timeout)
' @returns status - STATUS byte (second byte of R2 response), 0 if timeout
' @local idx - Capture buffer index
' @local resp - Received byte
' @local timeout - Timeout deadline

' Initialize capture buffers

  bytefill(@cmd13_pre_capture, $FF, 7)
  bytefill(@cmd13_capture, $FF, 8)
  cmd13_capture_len := 0

  ' Send dummy clocks with CS HIGH (card recovery time)
  pinh(cs)
  sp_transfer_8($FF)
  sp_transfer_8($FF)

  ' Send CMD13 with full-duplex MISO capture (card may still be outputting)
  pinl(cs)
  cmd13_pre_capture[0] := sp_transfer_8($40 | CMD13)    '  command byte
  cmd13_pre_capture[1] := sp_transfer_8($00)            '  argument bytes
  cmd13_pre_capture[2] := sp_transfer_8($00)
  cmd13_pre_capture[3] := sp_transfer_8($00)
  cmd13_pre_capture[4] := sp_transfer_8($00)
  cmd13_pre_capture[5] := sp_transfer_8($FF)            '  CRC (don't care after init)

  ' Capture raw byte stream and find R1 - skip bytes with bit 7 set (SD spec 7.3.2.1)
  ' v1.5.3: GETMS-based deadline (was GETCT-based, overflowed at low sysclk)
  timeout := GETMS() + 100                              '  100ms timeout
  idx := 0
  r1 := -1
  repeat
    resp := sp_transfer_8($FF)
    if idx < 8
      cmd13_capture[idx] := resp
      idx++
    if (resp & $80) == 0                                '  valid R1 has bit 7 = 0
      cmd13_capture_len := idx
      r1 := resp
      quit
    if GETMS() - timeout > 0
      cmd13_capture_len := idx
      last_cmd13_r1 := $FF
      quit                                              '  r1 stays -1, status stays 0

  if r1 >= 0
    ' Capture remaining bytes after R1 (STATUS byte + extra for analysis)
    repeat while idx < 8
      cmd13_capture[idx] := sp_transfer_8($FF)
      idx++

    ' STATUS byte is immediately after R1
    status := cmd13_capture[cmd13_capture_len]

  pinh(cs)                                              '  deselect card

  ' Stage CMD13 results for diagnostic getters
  last_cmd13_r1 := r1
  if r1 >= 0
    last_cmd13_status := status
    if r1 <> 0 OR status <> 0
      last_cmd13_error := (r1 << 8) | status

PRI probeCmd13() | r1, status
' Probe CMD13 reliability at end of initCard().
' Sends a single CMD13 on an idle card and checks whether the response is valid.
' If the response violates the SD spec (R1 bit 7 set, or 3+ simultaneous error
' bits in STATUS on an idle card), marks cmd13_reliable := FALSE and sets
' CW_CMD13_UNRELIABLE in card_warning_flags.
'
' @local r1 - R1 response byte from CMD13
' @local status - STATUS byte (second byte of R2 response)

  r1, status := sendCmd13Transaction()

  ' Log full capture for diagnostics
  DEBUG[CH_STATUS]("    [probeCmd13] pre=[", uhex_byte_(cmd13_pre_capture[0]), " ", uhex_byte_(cmd13_pre_capture[1]), " ", uhex_byte_(cmd13_pre_capture[2]), " ", uhex_byte_(cmd13_pre_capture[3]), " ", uhex_byte_(cmd13_pre_capture[4]), " ", uhex_byte_(cmd13_pre_capture[5]), "]")
  DEBUG[CH_STATUS]("    [probeCmd13] cap=[", uhex_byte_(cmd13_capture[0]), " ", uhex_byte_(cmd13_capture[1]), " ", uhex_byte_(cmd13_capture[2]), " ", uhex_byte_(cmd13_capture[3]), " ", uhex_byte_(cmd13_capture[4]), " ", uhex_byte_(cmd13_capture[5]), " ", uhex_byte_(cmd13_capture[6]), " ", uhex_byte_(cmd13_capture[7]), "] NCR=", udec_(cmd13_capture_len))
  DEBUG[CH_STATUS]("    [probeCmd13] R1=$", uhex_byte_(r1), " STATUS=$", uhex_byte_(status))

  ' Check 1: Timeout - sendCmd13Transaction returns r1 = -1
  if r1 == -1
    DEBUG[CH_STATUS]("    [probeCmd13] TIMEOUT - marking CMD13 unreliable")
    cmd13_reliable := FALSE
    card_warning_flags |= CW_CMD13_UNRELIABLE
  ' Check 2: R1 bit 7 must be 0 per SD spec
  elseif r1 & $80
    DEBUG[CH_STATUS]("    [probeCmd13] R1 bit 7 set - marking CMD13 unreliable")
    cmd13_reliable := FALSE
    card_warning_flags |= CW_CMD13_UNRELIABLE
  ' Check 3: 3+ error bits in STATUS on an idle card = garbage data
  elseif ONES status >= 3
    DEBUG[CH_STATUS]("    [probeCmd13] STATUS has ", udec_(ONES status), " error bits - marking CMD13 unreliable")
    cmd13_reliable := FALSE
    card_warning_flags |= CW_CMD13_UNRELIABLE
  else
    DEBUG[CH_STATUS]("    [probeCmd13] CMD13 OK (R1=$", uhex_byte_(r1), " STATUS=$", uhex_byte_(status), ")")

PRI probeCmd23() | scr[2], cmd_support, resp
' Probe CMD23 support at init time.
' First checks SCR CMD_SUPPORT field (bit 1 = CMD23 advertised).
' If advertised, sends a real CMD23 to verify the card accepts it in SPI mode.
' Some cards advertise CMD23 in SCR but reject it in SPI mode (R1=$04 Illegal Command).
' Sets cmd23_supported := TRUE only if the card actually accepts CMD23.
'
' @local scr - SCR register data (2 longs = 8 bytes)
' @local cmd_support - CMD_SUPPORT field from SCR
' @local resp - R1 response from CMD23 probe

  cmd23_supported := FALSE

  ' Step 1: Check SCR CMD_SUPPORT field (pre-filter)
  if fetchSCR(@scr) == SUCCESS
    cmd_support := scr.BYTE[3] & $03
    if cmd_support & $02
      DEBUG[CH_STATUS]("    [probeCmd23] SCR advertises CMD23 (CMD_SUPPORT=$", uhex_byte_(cmd_support), ") - verifying...")

      ' Step 2: Send real CMD23 with count=1 to verify SPI mode support
      resp := cmd(CMD23, 1)
      if diag_cmd_r1_ms < 0                                                     ' cmd() returns 0 on R1 timeout, byte-identical to a valid R1=$00 clean
        DEBUG[CH_STATUS]("    [probeCmd23] CMD23 R1 NEVER ARRIVED (cmd() timed out) - leaving cmd23_supported FALSE")
      elseif resp == $00
        cmd23_supported := TRUE
        card_warning_flags |= CW_CMD23_SUPPORTED
        DEBUG[CH_STATUS]("    [probeCmd23] CMD23 CONFIRMED - card accepts SET_BLOCK_COUNT in SPI mode")
      else
        DEBUG[CH_STATUS]("    [probeCmd23] CMD23 REJECTED R1=$", uhex_byte_(resp), " - not supported in SPI mode")
    else
      DEBUG[CH_STATUS]("    [probeCmd23] CMD23 not advertised (CMD_SUPPORT=$", uhex_byte_(cmd_support), ")")
  else
    DEBUG[CH_STATUS]("    [probeCmd23] SCR read failed - assuming CMD23 not supported")

PRI probeDataCrc() | data, idx, timeout, recv_crc, calc_crc, got_token
' Probe the card's data-block CRC behavior at init time.
' Some cards -- older SDSC and counterfeit media especially -- do not compute
' a real CRC-16 for the data blocks they return on a read; they transmit a
' fixed placeholder ($0000 or $FFFF) in the CRC field. The card's 512 data
' bytes are still valid -- only the trailing CRC is a dummy. readSector would
' treat the resulting mismatch as a fatal error and reject the card.
'
' This probe does one byte-by-byte read of sector 0 (no streamer, tolerant of
' a CRC mismatch) and compares the card's CRC against the computed CRC. If the
' card's CRC is a placeholder that disagrees with the computed value, it sets
' CW_NO_DATA_CRC so readSector skips read-CRC validation for this card. Cards
' that return a real, matching CRC are unaffected -- they keep strict
' validation. See DOCs/Analysis/DUMMY-DATA-CRC-ANALYSIS.md
'
' @local data - Received byte / start token
' @local idx - Data byte loop counter
' @local timeout - Token-wait deadline (ms)
' @local recv_crc - 16-bit CRC read from the card
' @local calc_crc - 16-bit CRC computed over the received data
' @local got_token - TRUE once the $FE start token is seen

  cmd(CMD17, 0)                                                                 ' READ_SINGLE_BLOCK, sector 0 (return ignored, mirrors readSector)

  ' Wait for the $FE start token
  got_token := FALSE
  timeout := GETMS() + card_read_timeout_ms
  repeat
    data := sp_transfer_8($FF)
    if data == $FE
      got_token := TRUE
      quit
    if data <> $FF OR GETMS() - timeout > 0
      quit                                                                      ' error token or timeout

  if NOT got_token
    DEBUG[CH_INIT]("    [probeDataCrc] no start token (got $", uhex_byte_(data), ") - probe skipped")
    pinh(cs)
  else
    ' Read 512 data bytes + 2 CRC bytes byte-by-byte (no streamer)
    repeat idx from 0 TO SECTOR_SIZE - 1
      BYTE[@buf + idx] := sp_transfer_8($FF)
    recv_crc := sp_transfer_8($FF) << 8
    recv_crc |= sp_transfer_8($FF)
    pinh(cs)                                                                    ' Deselect card
    sp_transfer_8($FF)                                                          ' 8 NCS recovery clocks (CS HIGH, SD spec)

    calc_crc := calcDataCRC(@buf, SECTOR_SIZE)
    diag_recv_crc := recv_crc                                                   ' publish for diagnostic getters
    diag_calc_crc := calc_crc
    sec_in_buf := 0                                                             ' buf holds valid sector 0 - leave cached so mount's MBR read is a cache hit

    if recv_crc == calc_crc
      DEBUG[CH_INIT]("    [probeDataCrc] data CRC OK ($", uhex_word_(recv_crc), ") - validation stays ON")
    elseif recv_crc == $0000 OR recv_crc == $FFFF
      card_warning_flags |= CW_NO_DATA_CRC
      DEBUG[CH_INIT]("    [probeDataCrc] card returns dummy data CRC ($", uhex_word_(recv_crc), ", computed $", uhex_word_(calc_crc), ") - read-CRC validation DISABLED for this card")
    else
      DEBUG[CH_INIT]("    [probeDataCrc] data CRC MISMATCH recv=$", uhex_word_(recv_crc), " calc=$", uhex_word_(calc_crc), " (not a dummy value) - validation stays ON")

PRI probeSpiCeiling() | saved_target_hz, default_hp, hp, idx, status, truth_crc, cand_crc, freq_for_hp, data, timeout, got_token, operating_hp, sample, hp_is_clean
' Empirically find the highest streamer-read SCK that this card can sustain.
'
' Runs ONLY on cards flagged CW_NO_DATA_CRC by probeDataCrc. Real-CRC cards
' rely on runtime data-CRC validation to detect speed-margin failures and
' would back off reactively; dummy-CRC cards have lost that detection, so
' the operating SCK must be pinned below the card's actual clean-read
' ceiling at init time.
'
' Algorithm:
'   1. Capture ground truth: byte-by-byte (no-streamer) read of sector 0 at
'      1 MHz SCK -- well below any plausible card's ceiling, no streamer NCO
'      involvement. Store in fat_buf scratch.
'   2. Mandatory pre-backoff for exact-target SCK: if setOptimalSpeed landed at
'      EXACTLY the target rate (sysclk an integer multiple of 2*target_hz, no
'      rounding margin) on a dummy-CRC card, force one hp step of backoff before
'      probing. Rationale: at non-exact sysclks the ceiling-rounded hp math
'      already produces SCK < target, which is the natural drift margin. At
'      exact sysclks (350/14 = 25 MHz, 250/10 = 25 MHz, etc.) the achieved SCK
'      equals the target precisely with zero natural margin -- precisely the
'      rate where prior characterization shows marginal cards corrupt rarely
'      but enough to wedge under load, and where N=8 sampling is statistically
'      blind to that rare corruption. The pre-backoff compensates.
'   3. Walk hp upward from the (possibly pre-backed-off) starting point. At
'      each hp, take PROBE_SCK_SAMPLES streamer reads of sector 0 and compare
'      each CRC to ground truth. ALL samples must match for the hp to be
'      accepted -- on a marginal card, a single read can pass by luck
'      (intermittent single-bit corruption), so one sample is not statistically
'      meaningful. The first mismatch (or readSector error) at any sample
'      breaks the inner loop and derates -- no point burning the remaining
'      samples once we already know this rate is unsafe.
'
' On exit: applySPISpeed has set the operating rate; sec_in_buf holds
' sector 0 from the final clean read (mount's MBR read becomes a cache hit).
' fat_buf was used as scratch and is invalidated.
'
' @local saved_target_hz - Original setOptimalSpeed target (for fallback if probe fails)
' @local default_hp - Half-period chosen by setOptimalSpeed
' @local hp - Current candidate half-period
' @local idx - Byte loop counter for slow read
' @local status - readSector return code
' @local truth_crc - CRC of ground-truth slow read
' @local cand_crc - CRC of candidate streamer read
' @local freq_for_hp - Frequency that lands applySPISpeed at the target hp
' @local data - Received byte during slow read
' @local timeout - Token-wait deadline
' @local got_token - TRUE once $FE start token is seen
' @local operating_hp - The hp at which reads were clean (or -1 if exhausted)

  ' Only relevant for dummy-CRC cards
  if NOT (card_warning_flags & CW_NO_DATA_CRC)
    return

  saved_target_hz := current_spi_target_hz
  default_hp := spi_period

  DEBUG[CH_INIT]("    [probeSpiCeiling] dummy-CRC card detected; probing SCK ceiling (default hp=", udec_(default_hp), ", saved target=", udec_(saved_target_hz / 1_000_000), " MHz)")

  ' ---- Step 1: ground truth via byte-by-byte read at 1 MHz SCK ----
  applySPISpeed(1_000_000)
  cmd(CMD17, 0)
  got_token := FALSE
  timeout := GETMS() + card_read_timeout_ms
  repeat
    data := sp_transfer_8($FF)
    if data == $FE
      got_token := TRUE
      quit
    if data <> $FF OR GETMS() - timeout > 0
      quit

  if NOT got_token
    DEBUG[CH_INIT]("    [probeSpiCeiling] ground-truth read FAILED (no start token, got $", uhex_byte_(data), "); aborting probe")
    pinh(cs)
    applySPISpeed(saved_target_hz)
    return

  repeat idx from 0 TO SECTOR_SIZE - 1
    BYTE[@fat_buf + idx] := sp_transfer_8($FF)
  sp_transfer_8($FF)                                                            ' discard CRC byte 1
  sp_transfer_8($FF)                                                            ' discard CRC byte 2
  pinh(cs)
  sp_transfer_8($FF)                                                            ' NCS recovery clocks (CS HIGH, SD spec)

  truth_crc := calcDataCRC(@fat_buf, SECTOR_SIZE)
  DEBUG[CH_INIT]("    [probeSpiCeiling] ground truth captured at 1 MHz (CRC=$", uhex_word_(truth_crc), ")")

  ' ---- Step 2: mandatory pre-backoff if default lands at exact target SCK ----
  ' Restore the original target SPI rate (the slow ground-truth read changed it),
  ' then check whether the achieved SPI rate equals the target exactly. If so,
  ' force one hp step of backoff before the sampling loop -- see the algorithm
  ' header above. Achieved-equals-target happens only when 2*default_hp*target
  ' divides clkfreq evenly (e.g., sysclk 350 / target 25 MHz / hp=7).
  applySPISpeed(saved_target_hz)
  if spi_freq == saved_target_hz
    default_hp += 1
    applySPISpeed((clkfreq + (2 * default_hp) - 1) / (2 * default_hp))
    DEBUG[CH_INIT]("    [probeSpiCeiling] default landed at exact target (", udec_(saved_target_hz / 1_000_000), " MHz) with zero natural margin; pre-backoff to hp=", udec_(default_hp), " SCK=", udec_(spi_freq / 1_000_000), " MHz before probing")

  ' ---- Step 3: walk hp upward from (possibly pre-backed-off) start until all samples match truth ----
  ' applySPISpeed ceiling-divides clkfreq by the target frequency to compute hp.
  ' To land applySPISpeed at exactly hp = N, the target we pass must be the SMALLEST
  ' integer frequency satisfying ceil(clkfreq / (2*freq)) == N. That's the ceiling
  ' division of clkfreq by (2*N). Using floor (clkfreq / (2*N)) silently overshoots
  ' to hp = N+1 whenever 2N does not divide clkfreq evenly.
  operating_hp := -1
  repeat hp from default_hp TO 32
    freq_for_hp := (clkfreq + (2 * hp) - 1) / (2 * hp)
    applySPISpeed(freq_for_hp)

    ' Sample PROBE_SCK_SAMPLES reads at this hp. ALL must match ground truth
    ' for the hp to be accepted; the first mismatch (or readSector error)
    ' derates immediately -- once we have evidence this rate is unsafe, there
    ' is no value in burning the remaining samples.
    hp_is_clean := TRUE
    repeat sample from 1 TO PROBE_SCK_SAMPLES
      sec_in_buf := -1                                                          ' force re-read (bypass cache)
      status := readSector(0, BUF_DATA)
      if status < 0
        DEBUG[CH_INIT]("    [probeSpiCeiling] hp=", udec_(hp), " SCK=", udec_(spi_freq / 1_000_000), " MHz: sample ", udec_(sample), "/", udec_(PROBE_SCK_SAMPLES), " readSector error ", sdec_(status), " - rejecting hp")
        hp_is_clean := FALSE
        quit

      cand_crc := calcDataCRC(@buf, SECTOR_SIZE)
      if cand_crc <> truth_crc
        DEBUG[CH_INIT]("    [probeSpiCeiling] hp=", udec_(hp), " SCK=", udec_(spi_freq / 1_000_000), " MHz: sample ", udec_(sample), "/", udec_(PROBE_SCK_SAMPLES), " CRC=$", uhex_word_(cand_crc), " != truth $", uhex_word_(truth_crc), " - too fast, stepping down")
        hp_is_clean := FALSE
        quit

    if hp_is_clean
      operating_hp := hp
      DEBUG[CH_INIT]("    [probeSpiCeiling] hp=", udec_(hp), " SCK=", udec_(spi_freq / 1_000_000), " MHz: MATCH (all ", udec_(PROBE_SCK_SAMPLES), " samples clean, CRC=$", uhex_word_(cand_crc), ") - operating point found")
      quit

  ' ---- Cleanup ----
  fat_sec_in_buf := -1                                                          ' scratch use invalidates FAT cache

  if operating_hp > 0
    DEBUG[CH_INIT]("    [probeSpiCeiling] DONE: operating SPI = ", udec_(spi_freq / 1_000_000), " MHz, hp = ", udec_(operating_hp), " (default was ", udec_(default_hp), ", backoff ", udec_(operating_hp - default_hp), " steps)")
  else
    DEBUG[CH_INIT]("    [probeSpiCeiling] WARNING: exhausted hp ladder, no clean rate found; operating at hp=32")

PRI checkCardStatus(caller) : status | r1, cmd_status
' Send CMD13 to verify card status after operation - checks R2 response for errors.
' R2 response format: R1 byte + status byte.
' Call this after every write operation and after CMD12.
' Skipped on cards where CMD13 was found unreliable at init (unless test_force_cmd13 is set).
'
' @param caller - String identifying the calling function (for debug)
' @returns status - 0 on success (card OK), negative error code on error
' @local r1 - R1 response byte
' @local cmd_status - Status byte (second byte of R2)

' Skip CMD13 on cards with broken implementation (unless diagnostic override is set)

  if cmd13_reliable OR test_force_cmd13
    r1, cmd_status := sendCmd13Transaction()

    ' Log pre-capture for diagnostic visibility
    DEBUG[CH_STATUS]("  [checkCardStatus] ", zstr_(caller), ": pre=[", uhex_byte_(cmd13_pre_capture[0]), " ", uhex_byte_(cmd13_pre_capture[1]), " ", uhex_byte_(cmd13_pre_capture[2]), " ", uhex_byte_(cmd13_pre_capture[3]), " ", uhex_byte_(cmd13_pre_capture[4]), " ", uhex_byte_(cmd13_pre_capture[5]), "] NCR=", udec_(cmd13_capture_len), " R1=$", uhex_byte_(r1), " ST=$", uhex_byte_(cmd_status))

    ' Check for errors
    if r1 == -1
      DEBUG[CH_STATUS]("  [checkCardStatus] ", zstr_(caller), ": TIMEOUT waiting for R1")
      status := E_TIMEOUT
    elseif r1 <> $00
      DEBUG[CH_STATUS]("  [checkCardStatus] ", zstr_(caller), ": R1 error=$", uhex_byte_(r1))
      status := E_IO_ERROR
    elseif cmd_status <> $00
      DEBUG[CH_STATUS]("  [checkCardStatus] ", zstr_(caller), ": STATUS error=$", uhex_byte_(cmd_status))
      if cmd_status & CSR_OUT_OF_RANGE
        DEBUG[CH_STATUS]("    -> OUT_OF_RANGE")
      if cmd_status & CSR_ERASE_PARAM
        DEBUG[CH_STATUS]("    -> ERASE_PARAM")
      if cmd_status & CSR_WP_VIOLATION
        DEBUG[CH_STATUS]("    -> WP_VIOLATION")
      if cmd_status & CSR_CARD_ECC_FAILED
        DEBUG[CH_STATUS]("    -> CARD_ECC_FAILED")
      if cmd_status & CSR_CC_ERROR
        DEBUG[CH_STATUS]("    -> CC_ERROR")
      if cmd_status & CSR_ERROR
        DEBUG[CH_STATUS]("    -> ERROR")
      if cmd_status & CSR_WP_ERASE_SKIP
        DEBUG[CH_STATUS]("    -> WP_ERASE_SKIP")
      if cmd_status & CSR_CARD_IS_LOCKED
        DEBUG[CH_STATUS]("    -> CARD_IS_LOCKED")
      status := E_IO_ERROR

PRI transfer(data,bits) : rxData | _cs, _mosi, _miso, _sck, delay
' Transfer data to/from SD card - bit-bang fallback for unsupported sizes.
'
' @param data - Data to transmit
' @param bits - Number of bits to transfer
' @returns rxData - Received data
' @local _cs - Local copy of CS pin
' @local _mosi - Local copy of MOSI pin
' @local _miso - Local copy of MISO pin
' @local _sck - Local copy of SCK pin
' @local delay - Bit delay value

  longmove(@_cs,@cs,4)
  delay := bit_delay
  rxData := data << (32-bits)                           '  move data to MSB
  ORG
              REP       @.end_rep, bits
               RCL      rxData, #1              wc      '  send from msb of rxData, receive into lsb of rxData
               DRVL     _sck
               DRVC     _mosi
               WAITX    delay
               DRVH     _sck
               WAITX    delay
               TESTP    _miso                   wc
.end_rep
              DRVH      _mosi
              RCL       rxData, #1
  END
  if bits < 32                                          '  mask to requested bit count
    rxData &= (1 << bits) - 1                           '  (skip for 32 bits - mask would wrap)

PRI fetchDataRegister(cmd_num, arg, crc_byte, p_buf, byte_count) : status | timeout, idx, resp
' Consolidated register read transaction - sends command, waits for R1 and $FE data token,
' reads byte_count bytes into p_buf, consumes 2-byte CRC, deselects card.
' Used by: fetchCSD (CMD9, 16 bytes), fetchCID (CMD10, 16 bytes), issueCMD6 (CMD6, 64 bytes),
' fetchSCR (ACMD51, 8 bytes), fetchSDStatus (ACMD13, 64 bytes).
'
' RENAMED from readDataRegister when it stopped returning a boolean. That rename was the
' point: SUCCESS is 0 and 0 is FALSE in Spin2, so changing the return type in place would
' have inverted every `if NOT readCSD(...)` in the driver silently -- compiling clean and
' running backwards. Renaming makes the old name vanish, so the compiler has to be shown
' every call site. The same applies to any future conversion of this kind.
'
' A single FALSE used to cover three different failures. They need different responses --
' a card that never answered is not a card that answered with an error -- so each now
' reports its own code.
'
' @param cmd_num - SD command number (e.g., CMD9, CMD10, CMD6)
' @param arg - 32-bit command argument (0 for most register reads)
' @param crc_byte - Pre-computed CRC-7 byte for this command
' @param p_buf - Pointer to buffer to receive data
' @param byte_count - Number of data bytes to read (8, 16, or 64)
' @returns status - SUCCESS (0); E_TIMEOUT if no R1 or no data token arrived;
'                   E_BAD_RESPONSE if the card answered R1 with an error
' @local timeout - Timeout deadline
' @local idx - Loop counter
' @local resp - SPI response byte

  sp_transfer_8($FF)                                    '  pre-command dummy clock
  pinl(cs)                                              '  CS LOW = selected
  sp_transfer_8($FF)                                    '  required by some cards
  sp_transfer_8($40 | cmd_num)                          '  command byte
  sp_transfer(arg, 32)                                  '  32-bit argument
  sp_transfer_8(crc_byte)                               '  CRC-7

  ' Wait for R1 response - skip bytes with bit 7 set (SD spec 7.3.2.1)
  ' v1.5.3: GETMS-based deadlines (was GETCT-based, overflowed at low sysclk)
  timeout := GETMS() + 1000                             '  1s timeout
  repeat
    resp := sp_transfer_8($FF)
    if (resp & $80) == 0                                '  valid R1 has bit 7 = 0
      quit
    if GETMS() - timeout > 0
      quit

  if resp <> $00
    ' Either no R1 ever arrived (still $FF from the idle line) or the card reported an
    ' error in it. Those are different conditions with different remedies.
    status := (resp & $80) ? E_TIMEOUT : E_BAD_RESPONSE
  else
    ' Wait for data token ($FE)
    status := E_TIMEOUT                                 ' Until the token arrives, that is what happened
    timeout := GETMS() + 1000                           '  1s timeout
    repeat
      resp := sp_transfer_8($FF)
      if resp == TOKEN_START_BLOCK                      '  $FE = data coming
        quit
      if GETMS() - timeout > 0
        quit

    if resp == TOKEN_START_BLOCK
      ' Read data bytes into caller's buffer
      repeat idx from 0 TO byte_count - 1
        BYTE[p_buf + idx] := sp_transfer_8($FF)

      ' Read and discard 2-byte CRC
      sp_transfer_8($FF)
      sp_transfer_8($FF)

      status := SUCCESS

  pinh(cs)                                              '  CS HIGH = deselected

PRI fetchCSD(p_csd) : status
' Read CSD register using CMD9 - reads 16-byte CSD register into buffer.
' Renamed from readCSD on conversion to a status return -- see fetchDataRegister.
'
' @param p_csd - Pointer to 16-byte buffer to receive CSD data
' @returns status - SUCCESS (0), or the negative code from fetchDataRegister

  status := fetchDataRegister(CMD9, 0, CRC_CMD9, p_csd, 16)

PRI fetchCID(p_cid) : status
' Read CID register using CMD10 - reads 16-byte Card Identification register.
' CID layout: MID[1] OID[2] PNM[5] PRV[1] PSN[4] MDT[2] CRC[1] (big-endian from card).
' Renamed from readCID on conversion to a status return -- see fetchDataRegister.
'
' @param p_cid - Pointer to 16-byte buffer to receive CID data
' @returns status - SUCCESS (0), or the negative code from fetchDataRegister

  status := fetchDataRegister(CMD10, 0, CRC_CMD10, p_cid, 16)

PRI parseTransSpeed(p_csd) : speed_hz | tran_speed, time_val, mult_val
' Parse TRAN_SPEED from CSD register - returns max transfer speed in Hz.
' TRAN_SPEED format: bits [2:0] = rate unit, bits [6:3] = time value.
'
' @param p_csd - Pointer to CSD register data
' @returns speed_hz - Maximum transfer speed in Hz
' @local tran_speed - Raw TRAN_SPEED byte
' @local time_val - Time value multiplier
' @local mult_val - Transfer rate unit multiplier

  tran_speed := BYTE[p_csd + 3]

  ' Time value multiplier (bits 6:3) - values per spec
  case (tran_speed >> 3) & $0F
    0:  time_val := 0                                   ' Reserved
    1:  time_val := 10                                  ' 1.0
    2:  time_val := 12                                  ' 1.2
    3:  time_val := 13                                  ' 1.3
    4:  time_val := 15                                  ' 1.5
    5:  time_val := 20                                  ' 2.0
    6:  time_val := 25                                  ' 2.5
    7:  time_val := 30                                  ' 3.0
    8:  time_val := 35                                  ' 3.5
    9:  time_val := 40                                  ' 4.0
    10: time_val := 45                                  ' 4.5
    11: time_val := 50                                  ' 5.0
    12: time_val := 55                                  ' 5.5
    13: time_val := 60                                  ' 6.0
    14: time_val := 70                                  ' 7.0
    15: time_val := 80                                  ' 8.0

  ' Transfer rate unit (bits 2:0) - values per spec
  case tran_speed & $07
    0:  mult_val := 100_000 / 10                        ' 100 kbit/s
    1:  mult_val := 1_000_000 / 10                      ' 1 Mbit/s
    2:  mult_val := 10_000_000 / 10                     ' 10 Mbit/s
    3:  mult_val := 100_000_000 / 10                    ' 100 Mbit/s (not used in SPI mode)
    other: mult_val := 0                                ' Reserved

  speed_hz := time_val * mult_val
  DEBUG[CH_IDENT]("  [parseTransSpeed] TRAN_SPEED=$", uhex_byte_(tran_speed), " -> ", udec(speed_hz / 1_000_000), " MHz")

PRI parseMfrId(p_cid) : mfr_id
' Extract manufacturer ID from CID register byte 0.
' Common IDs: $03=SanDisk, $1B=Samsung, $1D=ADATA, $27=Phison, $28=Lexar, $74=Gigastone/Transcend.
'
' @param p_cid - Pointer to CID register data
' @returns mfr_id - Manufacturer ID byte

  mfr_id := BYTE[p_cid]
  DEBUG[CH_IDENT]("  [parseMfrId] Manufacturer ID=$", uhex_byte_(mfr_id))

PRI parseTimeouts(p_csd) | csd_ver, taac, nsac, r2w_factor, read_timeout_ns, time_val, time_unit, sector_size_field
' Extract timeout values from CSD register - sets card_read_timeout_ms and card_write_timeout_ms.
' SDHC/SDXC: Fixed values (100ms read, 250ms write).
' SDSC: Calculated from TAAC, NSAC, and R2W_FACTOR.
' Also sets card_erase_block_sectors from CSD SECTOR_SIZE (same field for both CSD v1.0 and v2.0).
'
' @param p_csd - Pointer to CSD register data
' @local csd_ver - CSD structure version
' @local taac - Data read access time-1
' @local nsac - Data read access time-2 in CLK cycles
' @local r2w_factor - Read to write factor
' @local read_timeout_ns - Read timeout in nanoseconds
' @local time_val - Time value multiplier
' @local time_unit - Time unit in nanoseconds
' @local sector_size_field - Raw SECTOR_SIZE field from CSD (encoded as N-1)

  csd_ver := BYTE[p_csd] >> 6                                                     ' CSD_STRUCTURE in bits [7:6] of byte 0

  ' SECTOR_SIZE [45:39] is at the same byte/bit position for both CSD v1.0 (SDSC)
  ' and v2.0 (SDHC/SDXC): top 6 bits = byte 10 [5:0], bottom 1 bit = byte 11 [7].
  ' Encoded as (sectors_per_erase_block - 1).
  sector_size_field := ((BYTE[p_csd + 10] & $3F) << 1) | (BYTE[p_csd + 11] >> 7)
  card_erase_block_sectors := sector_size_field + 1
  DEBUG[CH_IDENT]("  [parseTimeouts] Erase block: ", udec_(card_erase_block_sectors), " sectors (", udec_(card_erase_block_sectors << 9), " bytes)")

  if csd_ver == 1
    ' CSD Version 2.0 (SDHC/SDXC): Use generous timeouts
    ' SD spec says 250ms max for writes, but real cards (especially large SDXC)
    ' can exceed this on cold writes or sector 0. Use 500ms for reliability.
    card_read_timeout_ms := 100                                                   ' 100ms read timeout
    card_write_timeout_ms := 500                                                  ' 500ms write timeout (2x spec for margin)
    DEBUG[CH_IDENT]("  [parseTimeouts] SDHC/SDXC: read=", udec_(card_read_timeout_ms), "ms, write=", udec_(card_write_timeout_ms), "ms")
  else
    ' CSD Version 1.0 (SDSC): Calculate from TAAC, NSAC, R2W_FACTOR
    taac := BYTE[p_csd + 1]                                                       ' Data read access time-1 (TAAC)
    nsac := BYTE[p_csd + 2]                                                       ' Data read access time-2 (NSAC) in CLK cycles
    r2w_factor := (BYTE[p_csd + 12] >> 2) & $07                                   ' R2W_FACTOR bits [4:2] of byte 12

    ' Parse TAAC: time value in bits [6:3], time unit in bits [2:0]
    case (taac >> 3) & $0F                                                        ' Time value multiplier
      0:  time_val := 0                                                           ' Reserved
      1:  time_val := 10
      2:  time_val := 12
      3:  time_val := 13
      4:  time_val := 15
      5:  time_val := 20
      6:  time_val := 25
      7:  time_val := 30
      8:  time_val := 35
      9:  time_val := 40
      10: time_val := 45
      11: time_val := 50
      12: time_val := 55
      13: time_val := 60
      14: time_val := 70
      15: time_val := 80

    case taac & $07                                                               ' Time unit (nanoseconds)
      0:  time_unit := 1                                                          ' 1 ns
      1:  time_unit := 10                                                         ' 10 ns
      2:  time_unit := 100                                                        ' 100 ns
      3:  time_unit := 1_000                                                      ' 1 us
      4:  time_unit := 10_000                                                     ' 10 us
      5:  time_unit := 100_000                                                    ' 100 us
      6:  time_unit := 1_000_000                                                  ' 1 ms
      7:  time_unit := 10_000_000                                                 ' 10 ms

    ' Read timeout = TAAC + NSAC * 100 (NSAC is in clock cycles / 100)
    ' For safety, multiply by 100 to get worst-case timeout
    read_timeout_ns := (time_val * time_unit) * 100                               ' Apply 100x safety factor
    card_read_timeout_ms := (read_timeout_ns / 1_000_000) #> 100 <# 5_000         ' Min 100ms, max 5s

    ' Write timeout = read timeout * 2^R2W_FACTOR (full SDSC spec range, capped at 30s)
    ' v1.5.3: cap raised from 1000ms to 30000ms - covers the SDSC spec's full
    ' worst-case write time (TAAC * 2^R2W can produce up to ~24s on slow cards).
    ' v1.5.3 also fixes the GETCT overflow bug that was masking this; the previous
    ' 1000ms cap was incidentally protecting against that overflow at low sysclks.
    card_write_timeout_ms := (card_read_timeout_ms << r2w_factor) #> 250 <# 30_000  ' Min 250ms, max 30s

    DEBUG[CH_IDENT]("  [parseTimeouts] SDSC: TAAC=$", uhex_byte_(taac), " NSAC=", udec_(nsac), " R2W=", udec_(r2w_factor))
    DEBUG[CH_IDENT]("  [parseTimeouts] SDSC: read=", udec_(card_read_timeout_ms), "ms, write=", udec_(card_write_timeout_ms), "ms")

PRI identifyCard() | cid[4], csd[4]
' Read card identity and configure adaptive timing.
' Reads CID/CSD, identifies brand, sets optimal SPI speed.
' SPI speed is min(TRAN_SPEED, 25 MHz) for every card regardless of
' manufacturer; card_mfr_id is recorded for identification only.
'
' @local cid - CID register data (4 longs = 16 bytes)
' @local csd - CSD register data (4 longs = 16 bytes)

  DEBUG[CH_IDENT]("  [identifyCard] Reading card registers...")

  ' Read CID to identify manufacturer
  if fetchCID(@cid) == SUCCESS
    card_mfr_id := parseMfrId(@cid)
    DEBUG[CH_IDENT]("  [identifyCard] Manufacturer ID: $", uhex_byte_(card_mfr_id))
  else
    DEBUG[CH_IDENT]("  [identifyCard] WARNING: Could not read CID")
    card_mfr_id := 0

  ' Read CSD to get maximum speed and timeouts
  if fetchCSD(@csd) == SUCCESS
    card_max_speed_hz := parseTransSpeed(@csd)
    parseTimeouts(@csd)
  else
    DEBUG[CH_IDENT]("  [identifyCard] WARNING: Could not read CSD")
    card_max_speed_hz := 25_000_000                     ' Default to 25 MHz
    card_read_timeout_ms := 100                         ' Safe defaults
    card_write_timeout_ms := 500

PRI effectiveAlignDelay() : delay
' The ONE computation of the read-streamer WAITX phase pad, shared by both
' burst sites and the diagnostic getter.
'
' hp=4 FLOOR-CELL RULE: positive offsets do NOT apply at spi_period = 4 -- that
' cell keeps align = hp. hp = 4 arises at the 50 MHz high-speed request and at
' low-sysclk 25 MHz configurations (e.g. 200 MHz sysclk).
'
' DO NOT REMOVE THIS AS A CONSERVATIVE PLACEHOLDER. It was introduced as one
' (2026-08-18) and has since been MEASURED CORRECT (2026-08-19). Swept inside
' verified CMD6 high-speed mode -- the state hp=4 actually ships in -- the read
' band is [-3..+4] on two cards and [-1..+5] on a third. This rule's offset 0 is
' inside on all three and dead centre on two; the +5 production default is
' OUTSIDE the band on two of the three.
'
' An earlier sweep found [+2..+8] centred +5 at hp=4 and was read as grounds for
' deleting this rule. That sweep reached 43.75 MHz by SETTING the clock, which
' leaves the card in default speed mode driven above spec, and the band there sits
' three ticks higher than in the shipping state. Measuring the convenient state
' instead of the shipping state inverted the conclusion. See
' DOCs/SPI-PHASE-MARGIN-API.md for the per-card table.
'
' Negative (diagnostic) offsets still apply, floored at the WAITX minimum of 2.
' debugSetAlignFloorRuleEnabled() lifts the rule for characterization only.

  if spi_period >= 5 or floor_rule_disabled
    delay := spi_period + align_delay_offset
  else
    delay := spi_period + (align_delay_offset <# 0)     ' hp=4: positive offsets withheld
  if delay < 2
    delay := 2                                          ' WAITX floor (cog needs 2 sysclks min)

PRI setOptimalSpeed()
' Set SPI speed based on card identification.
' Called after identifyCard() to configure optimal SPI clock.
' Uses card's reported max speed, capped at 25 MHz for SPI mode.

  if card_max_speed_hz > 25_000_000
    applySPISpeed(25_000_000)
  else
    applySPISpeed(card_max_speed_hz)
  DEBUG[CH_IDENT]("  [setOptimalSpeed] Set to card's max speed (up to 25 MHz)")

#ifdef SD_INCLUDE_SPEED

PRI issueCMD6(arg, p_status) : status
' Send CMD6 (SWITCH_FUNC) and receive 64-byte status structure.
' arg format: [31]=mode (0=check, 1=switch), [3:0]=function group 1 selection.
' Renamed from sendCMD6 on conversion to a status return -- see fetchDataRegister.
'
' @param arg - CMD6 argument word
' @param p_status - Pointer to 64-byte buffer to receive status
' @returns status - SUCCESS (0), or the negative code from fetchDataRegister

  status := fetchDataRegister(CMD6, arg, CRC_NONE, p_status, 64)

PRI probeHighSpeed() : status | scr[2], cmd6_status[16], sd_spec
' Ask the card whether it supports high-speed mode - queries SCR and function group 1.
' Renamed from queryHighSpeedSupport on conversion to a status return.
'
' "THE CARD DOES NOT SUPPORT IT" AND "WE COULD NOT FIND OUT" ARE DIFFERENT ANSWERS, and
' the old boolean gave both as FALSE -- so a card whose SCR read timed out was recorded as
' a card that simply lacks the feature. The status return says whether the QUESTION was
' answered; the answer itself lands in the companion field hs_supported. That split keeps
' the governing rule intact: a method returns either a boolean or a status, never both.
'
' @returns status - SUCCESS (0) if the card was successfully asked; negative if it was not
' @local scr - SCR register data (2 longs = 8 bytes)
' @local cmd6_status - CMD6 status structure (16 longs = 64 bytes)
' @local sd_spec - SD spec version from SCR

  DEBUG[CH_HSPEED]("  [probeHighSpeed] Checking card capabilities...")
  hs_supported := false

  ' First check SCR for CMD6 support (SD 2.0+ cards support CMD6)
  status := fetchSCR(@scr)
  if status <> SUCCESS
    DEBUG[CH_HSPEED]("  [probeHighSpeed] Failed to read SCR: ", sdec_(status))
  else
    sd_spec := scr.BYTE[0] & $0F                        '  SD_SPEC in bits [3:0]
    DEBUG[CH_HSPEED]("  [probeHighSpeed] SD_SPEC=", udec_(sd_spec))
    if sd_spec < 2
      ' A definite, correctly-obtained answer of "no" -- the query succeeded.
      DEBUG[CH_HSPEED]("  [probeHighSpeed] Card is SD 1.x - CMD6 not supported")
    else
      DEBUG[CH_HSPEED]("  [probeHighSpeed] Card is SD 2.0+ - CMD6 supported")

      ' Query function group 1 using CMD6 mode 0 (check)
      ' Argument: 0x00FFFFF1 = check mode, access function group 1, query high-speed
      status := issueCMD6($00FFFFF1, @cmd6_status)
      if status <> SUCCESS
        DEBUG[CH_HSPEED]("  [probeHighSpeed] CMD6 query failed: ", sdec_(status))
      else
        ' Status bytes 12-13 contain function group 1 support bits
        ' Bit 1 of byte 13 indicates high-speed support
        if (cmd6_status.BYTE[13] & $02) == 0
          DEBUG[CH_HSPEED]("  [probeHighSpeed] High-speed function not supported")
        else
          DEBUG[CH_HSPEED]("  [probeHighSpeed] High-speed (50 MHz) IS SUPPORTED")
          hs_supported := true

PRI applyHighSpeed() : status | cmd6_status[16]
' Switch card to high-speed mode - sends CMD6 to switch function group 1.
' Renamed from switchToHighSpeed on conversion to a status return.
'
' A card that REFUSED the switch is not a card that failed to answer, and the old boolean
' reported both as FALSE.
'
' @returns status - SUCCESS (0) if the card switched; E_BAD_RESPONSE if it answered but
'                   declined; otherwise the negative code from issueCMD6
' @local cmd6_status - CMD6 status structure (16 longs = 64 bytes)

  DEBUG[CH_HSPEED]("  [applyHighSpeed] Sending CMD6 switch command...")

  ' Switch to high-speed using CMD6 mode 1 (switch)
  ' Argument: 0x80FFFFF1 = switch mode, access function group 1, select high-speed
  status := issueCMD6($80FFFFF1, @cmd6_status)
  if status <> SUCCESS
    DEBUG[CH_HSPEED]("  [applyHighSpeed] CMD6 switch failed: ", sdec_(status))
  else
    ' Verify switch succeeded - check function group 1 selection in status
    ' Byte 16, bits 3:0 should be 1 (high-speed selected)
    if (cmd6_status.BYTE[16] & $0F) <> 1
      DEBUG[CH_HSPEED]("  [applyHighSpeed] Switch not accepted, status=$", uhex_byte_(cmd6_status.BYTE[16]))
      status := E_BAD_RESPONSE
    else
      DEBUG[CH_HSPEED]("  [applyHighSpeed] Successfully switched to high-speed mode")

PRI applyDefaultSpeedMode() | cmd6_status[16]
' Switch the card BACK to default-speed mode (CMD6 switch, function group 1 = 0).
' Used by the high-speed fallback paths: the CMD6 switch is STICKY at the card,
' so a host that abandons high speed must switch the card back or every
' subsequent read arrives on high-speed output timing and fails with a -7
' cascade until re-init (latent since the HS feature shipped; exposed 2026-08-18
' by the round-8a regression when the align-default change briefly made the
' 50 MHz verify read fail deterministically -- SD_RT_speed_tests #9/#12).
'
' The card receives commands on the host->card path regardless of its own
' output-timing mode, so the switch takes effect even when its RESPONSE cannot
' be read cleanly -- issueCMD6's status is deliberately not consulted here;
' there is no recovery decision to make on it, and the caller has already
' recorded the failure that brought us here.
'
' This is the ONE place the card leaves high-speed mode, so it is also the one
' place hs_mode_active is cleared. Every exit from high speed routes here --
' the three failed-switch/failed-verify paths, a user speed change, and unmount.

  issueCMD6($80FFFFF0, @cmd6_status)
  hs_mode_active := false

#endif

PRI sendAppCmdPrefix() : resp
' Send CMD55 (APP_CMD) prefix for application-specific commands (ACMD*).
' Uses cmd() for the command transaction, then deasserts CS for the ACMD to follow.
'
' @returns resp - R1 response from CMD55 ($00 or $01 = success, >$01 = error)

  resp := cmd(CMD55, 0)
  pinh(cs)                                              '  deselect between CMD55 and ACMD

PRI fetchSCR(p_scr) : status | resp
' Read SCR register using ACMD51 - reads 8-byte SD Configuration Register.
' Requires CMD55 prefix before ACMD51.
' Renamed from readSCR on conversion to a status return -- see fetchDataRegister.
'
' The CMD55 prefix has its own two failure modes, and they were previously flattened
' into the same FALSE as an ACMD51 failure.
'
' @param p_scr - Pointer to 8-byte buffer to receive SCR data
' @returns status - SUCCESS (0); E_TIMEOUT if the CMD55 R1 never arrived;
'                   E_BAD_RESPONSE if CMD55 answered with an error; otherwise whatever
'                   fetchDataRegister reported
' @local resp - CMD55 R1 response

  resp := sendAppCmdPrefix()
  if diag_cmd_r1_ms < 0                                 ' cmd() returns 0 on R1 timeout, byte-identical to a valid R1=$00 clean
    DEBUG[CH_STATUS]("  [fetchSCR] CMD55 R1 NEVER ARRIVED (cmd() timed out)")
    status := E_TIMEOUT
  elseif resp > $01                                     '  accept $00 or $01 (idle)
    DEBUG[CH_STATUS]("  [fetchSCR] CMD55 error response: $", uhex_byte_(resp))
    status := E_BAD_RESPONSE
  else
    status := fetchDataRegister(ACMD51, 0, CRC_ACMD51, p_scr, 8)

PRI fetchSDStatus(p_buf) : status | resp
' Read SD Status register using ACMD13 - reads 64-byte SD Status.
' Requires CMD55 prefix before ACMD13.
' Renamed from readSDStatus on conversion to a status return -- see fetchDataRegister.
'
' @param p_buf - Pointer to 64-byte buffer to receive SD Status data
' @returns status - SUCCESS (0); E_TIMEOUT if the CMD55 R1 never arrived;
'                   E_BAD_RESPONSE if CMD55 answered with an error; otherwise whatever
'                   fetchDataRegister reported
' @local resp - CMD55 R1 response

  resp := sendAppCmdPrefix()
  if diag_cmd_r1_ms < 0                                 ' cmd() returns 0 on R1 timeout, byte-identical to a valid R1=$00 clean
    DEBUG[CH_STATUS]("  [fetchSDStatus] CMD55 R1 NEVER ARRIVED (cmd() timed out)")
    status := E_TIMEOUT
  elseif resp > $01                                     '  accept $00 or $01 (idle)
    DEBUG[CH_STATUS]("  [fetchSDStatus] CMD55 error response: $", uhex_byte_(resp))
    status := E_BAD_RESPONSE
  else
    status := fetchDataRegister(CMD13, 0, CRC_NONE, p_buf, 64)

#ifdef SD_INCLUDE_DEBUG

PRI readSectorSlow(sector, p_buffer) : status | data, idx, timeout
' DEBUG: Read sector byte-by-byte (no streamer) - for streamer debugging.
' This is SLOW (~50x slower than streamer) but helps isolate timing issues.
'
' @param sector - Sector number to read
' @param p_buffer - Pointer to 512-byte destination buffer
' @returns status - 0 on success, negative error code on failure
' @local data - Received byte/token
' @local idx - Loop counter
' @local timeout - Timeout deadline

' Send CMD17 (READ_SINGLE_BLOCK)

  cmd(CMD17, sector << hcs)

  ' Wait for start token ($FE)
  ' v1.5.3: GETMS-based deadline (was GETCT-based, overflowed at low sysclk).
  ' card_read_timeout_ms already includes 100x safety factor from parseTimeouts.
  status := E_TIMEOUT                                   '  assume failure
  timeout := GETMS() + card_read_timeout_ms
  repeat
    data := sp_transfer_8($FF)
    if data == $FE
      status := 0                                       '  got start token
      quit
    if data <> $FF
      status := E_BAD_RESPONSE
      quit                                              '  error token
    if GETMS() - timeout > 0
      quit                                              '  timeout

  if status == 0
    ' Read 512 bytes one at a time using sp_transfer_8
    repeat idx from 0 TO SECTOR_SIZE - 1
      BYTE[p_buffer + idx] := sp_transfer_8($FF)

    ' Read and capture 2 CRC bytes (high byte first per SD protocol)
    diag_recv_crc := sp_transfer_8($FF) << 8
    diag_recv_crc |= sp_transfer_8($FF)

    ' CRC-16 validation: calculate CRC of received data and compare with card's CRC
    if diag_crc_enabled
      diag_calc_crc := calcDataCRC(p_buffer, SECTOR_SIZE)
      if diag_calc_crc == diag_recv_crc
        diag_crc_matches++
      else
        diag_crc_mismatches++
        DEBUG[CH_SECTOR]("  [readSectorSlow] CRC MISMATCH! recv=$", uhex_(diag_recv_crc), " calc=$", uhex_(diag_calc_crc))

  pinh(cs)                                              '  Deselect card

PRI do_erase_block(start_sector) : status | resp, end_sector, timeout, failed_cmd, failed_r1, failed_msg_ptr
' DEBUG: Erase one erase-block-sized region via CMD32/CMD33/CMD38 sequence.
' End address is computed as start_sector + (eraseBlockSectors - 1) so exactly
' one erase block is erased. After CMD38 we wait for MISO to return to $FF
' (busy completion) using card_write_timeout_ms.
'
' Consolidated debug: every failure path captures (failed_cmd, failed_r1,
' failed_msg_ptr) and emits one debug record at the end of the method. Saves
' 6 compiled records vs the original per-branch DEBUG[CH_SECTOR] calls.
'
' @param start_sector - First sector of erase block (caller alignment-responsible)
' @returns status - 0 on success, negative error code on timeout/IO error
' @local resp - R1 response from card
' @local end_sector - Last sector address in the range
' @local timeout - Timeout deadline
' @local failed_cmd - CMD number that failed (32, 33, 38, 0=none)
' @local failed_r1 - R1 byte captured on fatal-R1 failure
' @local failed_msg_ptr - DAT pointer to the captured failure-kind label (0 = no failure)

  end_sector := start_sector + card_erase_block_sectors - 1
  failed_cmd := 0
  failed_r1 := 0
  failed_msg_ptr := 0

  ' An erase rewrites on-card contents exactly as a write does: every cache tag
  ' inside the erased range (all tiers + clean handle buffers) is stale.
  invalidateCacheRange(start_sector, end_sector)

' CMD32: ERASE_WR_BLK_START_ADDR

  resp := cmd(CMD32, start_sector << hcs)
  if diag_cmd_r1_ms < 0                                                         ' cmd() returns 0 on R1 timeout, byte-identical to a valid R1=$00 clean
    failed_cmd := 32
    failed_msg_ptr := @msg_erase_no_resp
    pinh(cs)
    status := E_TIMEOUT
  elseif resp <> $00
    failed_cmd := 32
    failed_r1 := resp
    failed_msg_ptr := @msg_erase_fatal
    pinh(cs)
    status := E_BAD_RESPONSE
  else
    ' CMD33: ERASE_WR_BLK_END_ADDR
    resp := cmd(CMD33, end_sector << hcs)
    if diag_cmd_r1_ms < 0                                                       ' cmd() returns 0 on R1 timeout, byte-identical to a valid R1=$00 clean
      failed_cmd := 33
      failed_msg_ptr := @msg_erase_no_resp
      pinh(cs)
      status := E_TIMEOUT
    elseif resp <> $00
      failed_cmd := 33
      failed_r1 := resp
      failed_msg_ptr := @msg_erase_fatal
      pinh(cs)
      status := E_BAD_RESPONSE
    else
      ' CMD38: ERASE
      resp := cmd(CMD38, 0)
      if diag_cmd_r1_ms < 0                                                     ' cmd() returns 0 on R1 timeout, byte-identical to a valid R1=$00 clean
        failed_cmd := 38
        failed_msg_ptr := @msg_erase_no_resp
        pinh(cs)
        status := E_TIMEOUT
      elseif resp <> $00
        failed_cmd := 38
        failed_r1 := resp
        failed_msg_ptr := @msg_erase_fatal
        pinh(cs)
        status := E_BAD_RESPONSE
      else
        ' Wait for busy completion (MISO returns to $FF)
        ' v1.5.3: GETMS-based deadline (was GETCT-based, overflowed at low sysclk)
        status := E_TIMEOUT
        timeout := GETMS() + card_write_timeout_ms
        repeat
          if sp_transfer_8($FF) == $FF
            status := 0
            quit
          if GETMS() - timeout > 0
            failed_cmd := 38
            failed_msg_ptr := @msg_erase_busy
            quit
        pinh(cs)

  ' Consolidated end-of-method debug: 1 compiled record covers all failure
  ' paths. Silent on success (matches prior behavior). The captured state
  ' makes which-command/which-failure unambiguous.
  if failed_msg_ptr <> 0
    DEBUG[CH_SECTOR]("  [do_erase_block] CMD", udec_(failed_cmd), " ", zstr_(failed_msg_ptr), " R1=$", uhex_byte_(failed_r1))

#endif

' ---- FAT32 file system ----
'    ┌─────────────────────────┐     The master boot record contains 446 bytes of boot code
'    │ Master Boot Record      │      followed by four 16-byte partition entries
'    │                         │      terminated with $55 $AA in the final 2 bytes
'    │ Partitions      $55 $AA │     The 16-byte partition
'    ├─────────────────────────┤     ┌──────┬───────┬──────┬─────┬───────┬───────────┐
'    │ Reserved                │     │ Boot │ CHS   │ Type │ CHS │ LBA   │ Number of │  Type code located at byte address $1C2
'    ├─────────────────────────┤     │ Flag │ Begin │ Code │ End │ Begin │ Sectors   │   Type code = $0B or $0C for FAT32
'    │ Volume Boot Record 1    │     ├──────┼───────┼──────┼─────┼───────┼───────────┤  LBA Begin contains address of volume boot record (VBR)
'    ├─────────────────────────┤     │      │       │  5   │     │ 9-12  │           │   VBR address located at byte address $1C6
'    │ Reserved                │     └──────┴───────┴──────┴─────┴───────┴───────────┘
'    ├─────────────────────────┤     Volume boot record contains
'    │ Volume Boot Record 2    │     ┌─────────────────────────────────┬────────┬──────┬────────────────────┐
'    ├─────────────────────────┤     │          Field                  │ Offset │ Size │ Value              │
'    │ Reserved                │     ├─────────────────────────────────┼────────┼──────┼────────────────────┤
'    ├─────────────────────────┤     │ Bytes per Sector                │  $0B   │ 16b  │       512          │
'    │ File allocation table 1 │     │ Sectors per Cluster             │  $0D   │  8b  │1/2/4/8/16/32/64/128│
'    ├─────────────────────────┤     │ Number of Reserved Sectors      │  $0E   │ 16b  │                    │
'    │ File allocation table 2 │     │ Number of FATs                  │  $10   │  8b  │        2           │
'    ├─────────────────────────┤     │ Sectors per FAT                 │  $24   │ 32b  │                    │
'    │ Root directory and      │     │ Root Directory of First Cluster │  $2C   │ 32b  │        2           │
'    │  Data region            │     │ Signature                       │ $1FE   │ 16b  │      $AA55         │
'    │                         │     └─────────────────────────────────┴────────┴──────┴────────────────────┘
'    │                         │      The address of the 1st FAT is VBR address + number of reserved sectors
'    │                         │      The address of the root directory is FAT address + number of FATs x sectors per fat
'    └─────────────────────────┘
'                                    The file system directory contains 32-byte entries for each file in the root directory
'                                    ┌─────────────────────────────────┬────────┬──────┐
'                                    │          Field                  │ Offset │ Size │  The first byte of the short filename indicates the type of entry
'                                    ├─────────────────────────────────┼────────┼──────┤   Normal entry     - as expected   "FILENAMETXT"
'                                    │ Short Filename                  │  $00   │ 11B  │   Unused/deleted   - 1st byte $E5  "<E5>ILENAMETXT"
'                                    │ Attrib Byte                     │  $0B   │  1B  │   End of directory - 1st byte $00
'                                    │ Date of creation                │  $0E   │  4B  │
'                                    │ First Cluster High              │  $14   │  2B  │
'                                    │ Date of modification            │  $16   │  4B  │
'                                    │ First Cluster Low               │  $1A   │  2B  │
'                                    │ File Size                       │  $1C   │  4B  │
'                                    └─────────────────────────────────┴────────┴──────┘
'                                    Attrib byte contains bitfields
'                                    ┌───┬───────────┬─────┬────────────────────────────────────┐
'                                    │bit│ Function  │ LFN │ Comment                            │
'                                    ├───┼───────────┼─────┼────────────────────────────────────┤
'                                    │ 7 │ Unused    │  0  │ Should be zero                     │
'                                    │ 6 │ Unused    │  0  │ Should be zero                     │
'                                    │ 5 │ Archive   │  x  │ Has been changed since last backup │
'                                    │ 4 │ Directory │  x  │ Is a subdirectory                  │
'                                    │ 3 │ Volume ID │  1  │ Filename is Volume ID              │
'                                    │ 2 │ System    │  1  │ File is operating system           │
'                                    │ 1 │ Hidden    │  1  │ Should not show in dir listing     │
'                                    │ 0 │ Read Only │  1  │ Should not allow writing           │
'                                    └───┴───────────┴─────┴────────────────────────────────────┘
'                                    Each entry in the file allocation table is 32 bits, entry 0 is associated with cluster 0, entry 1/cluster 1, and so on
'                                     The 32-bit value contains 0 if the associated cluster is available
'                                     contains $0FFF_FFFF if the data in the associated cluster ends in that cluster
'                                     contains the address of the next cluster in the file if the file occupies multiple clusters
'                                    ┌───────────┬───────────┬───────────┬───────────┐
'                clusters $00 - $03  │ 0FFF_FFFF │ 0FFF_FFFF │ 0FFF_FFFF │ 0FFF_FFFF │  1st four clusters occupied by self-contained files
'                         $04 - $07  │ 0000_0005 │ 0000_0006 │ 0000_0007 │ 0FFF_FFFF │  next four clusters occupied by a file in sequential clusters
'                         $08 - $0B  │ 0000_000A │ 0FFF_FFFF │ 0000_000C │ 0FFF_FFFF │  a fragmented file starts in cluster 8, and occupies clusters 10, 12, and ends in 14
'                         $0C - $0F  │ 0000_000E │ 0000_0000 │ 0FFF_FFFF │ 0000_0000 │  clusters 13 and 15 are unused
'                                    └───────────┴───────────┴───────────┴───────────┘
' ---- end FAT32 file system ----

