'' =================================================================================================
''
''   File....... SD_spi_limit_test.spin2
''   Purpose.... Test one SPI frequency point for external header max speed characterization
''   Author..... Stephen M Moraco
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... FEB 2026
''   Updated.... 01 MAR 2026
''
'' =================================================================================================
''
'' Mounts, sets SPI to the maximum speed achievable at this SYSCLK (the hp value
'' just below 25 MHz), then runs 10 write-read-verify round-trips of 8 sectors each.
'' Reports PASS/FAIL with actual SPI frequency.
''
'' _CLKFREQ is changed by the runner script to probe different SPI frequencies.
''
'' =================================================================================================

CON

     _CLKFREQ        = 350_000_000               ' Changed by runner script

     ' P2 Edge module SD slot pins
     SD_CS   = 60
     SD_MOSI = 59
     SD_MISO = 58
     SD_SCK  = 61

     ' External SD header (base pin 16)
     'SD_CS   = 20
     'SD_MOSI = 19
     'SD_MISO = 18
     'SD_SCK  = 21

     WRITE_SECTOR_BASE = 200_200                 ' Safe write area
     MULTI_COUNT      = 8                        ' 8 sectors per round-trip
     NUM_ITERS        = 10                       ' Write-read-verify iterations
     MIN_HP           = 4                        ' Minimum SPI half-period (hardware floor)
     HP_ROUND_UP      = 49_999_999               ' Rounding constant for 50 MHz HP calculation
     HP_DIVISOR       = 50_000_000               ' SPI HP divisor (50 MHz base)
     PATTERN_SECTOR   = 41                       ' Pattern multiplier for sector index
     PATTERN_ITER     = 67                       ' Pattern multiplier for iteration

#ifdef __SPINTOOLS__
#define SD_INCLUDE_RAW
#define SD_INCLUDE_REGISTERS
#define SD_INCLUDE_SPEED
#define SD_INCLUDE_DEBUG
#elseifdef __FLEXSPIN__
#define SD_INCLUDE_RAW
#pragma exportdef SD_INCLUDE_RAW
#define SD_INCLUDE_REGISTERS
#pragma exportdef SD_INCLUDE_REGISTERS
#define SD_INCLUDE_SPEED
#pragma exportdef SD_INCLUDE_SPEED
#define SD_INCLUDE_DEBUG
#pragma exportdef SD_INCLUDE_DEBUG
#else
#pragma exportdef SD_INCLUDE_RAW
#pragma exportdef SD_INCLUDE_REGISTERS
#pragma exportdef SD_INCLUDE_SPEED
#pragma exportdef SD_INCLUDE_DEBUG
#endif

OBJ
    sd    : "micro_sd_fat32_fs"
    utils : "isp_rt_utilities"

VAR
    BYTE    writeBuffer[MULTI_COUNT * sd.SECTOR_SIZE]
    BYTE    readBuffer[MULTI_COUNT * sd.SECTOR_SIZE]
    BYTE    readBuffer_guard[16]

PUB go() | status, hp, actualHz, errors, iter, idx, sector, written, readCt, byteErrs
'' Test write-read-verify at max SPI speed for this SYSCLK.
'' Calls setSPISpeed(25_000_000) -- the driver computes hp from clkfreq.
'' At non-multiple-of-50MHz SYSCLK, hp rounds up and actual SPI < 25 MHz.
'' This lets us probe SPI frequencies in the 22-25 MHz gap.

    debug(" ")
    debug("SPI_LIMIT_TEST")
    debug("  SYSCLK=", udec_(clkfreq))

    ' Mount
    status := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    if status < 0
        debug("  MOUNT_FAIL")
        debug("END_SESSION")
        return

    ' Set SPI to 25 MHz target -- driver computes hp = ceil(clkfreq / 50_000_000)
    ' At 350 MHz: hp=7, actual=25.0 MHz
    ' At 270 MHz: hp=6, actual=22.5 MHz
    ' At 370 MHz: hp=8, actual=23.125 MHz -- etc.
    sd.setSPISpeed(25_000_000)

    ' Report what we actually got
    hp := (clkfreq + HP_ROUND_UP) / HP_DIVISOR
    if hp < MIN_HP
        hp := MIN_HP
    actualHz := clkfreq / (hp * 2)

    debug("  hp=", udec_(hp), " actual=", udec_(actualHz), " Hz")

    ' Run write-read-verify iterations
    errors := 0
    repeat iter from 0 to NUM_ITERS - 1
        sector := WRITE_SECTOR_BASE + (iter * MULTI_COUNT)

        ' Fill write buffer
        repeat idx from 0 to (MULTI_COUNT * sd.SECTOR_SIZE) - 1
            writeBuffer[idx] := ((idx / sd.SECTOR_SIZE) * PATTERN_SECTOR + (idx // sd.SECTOR_SIZE) + iter * PATTERN_ITER) & $FF

        ' Write
        written := sd.writeSectorsRaw(sector, MULTI_COUNT, @writeBuffer)
        if written <> MULTI_COUNT
            errors++
            next

        ' Clear and read
        bytefill(@readBuffer, $00, MULTI_COUNT * sd.SECTOR_SIZE)
        utils.initGuard(@readBuffer_guard)
        readCt := sd.readSectorsRaw(sector, MULTI_COUNT, @readBuffer)
        utils.checkGuard(@readBuffer_guard, @"readBuffer guard")

        if readCt <> MULTI_COUNT
            errors++
            next

        ' Verify
        byteErrs := 0
        repeat idx from 0 to (MULTI_COUNT * sd.SECTOR_SIZE) - 1
            if readBuffer[idx] <> writeBuffer[idx]
                byteErrs++
        if byteErrs > 0
            errors++
            if errors <= 3
                debug("  iter ", udec_(iter), ": ", udec_(byteErrs), " byte errors")

    if errors == 0
        debug("  RESULT=PASS iters=", udec_(NUM_ITERS))
    else
        debug("  RESULT=FAIL errors=", udec_(errors), "/", udec_(NUM_ITERS))

    sd.unmount()
    debug("END_SESSION")

con { license }

