{{ =================================================================================================
   File....... SD_cs_low_across_repro.spin2
   Purpose.... Experiment 6.3 (asdfg counterfeit SDSC wedge investigation, 2026-05-27):
               CS-LOW-across-writes isolation.

               Hypothesis (the last one standing after experiments 1-6.2): the wedge
               trigger is the CS-HIGH -> CS-LOW toggle between two consecutive raw
               single-block writes. Multi-block CMD25 with count>1 keeps CS LOW
               continuously across blocks and does NOT wedge these cards. Raw single-
               block writes toggle CS between every call and DO wedge.

               This test uses a temporary driver hook (test_skip_cs_release) that
               makes writeSector leave CS LOW and skip CMD13 in its success path,
               so the next writeSectorRaw call enters cmd() with CS already
               asserted. The card sees a continuous SPI session across two CMD24
               writes - the only difference from a normal multi-block protocol is
               that the second command is CMD24 instead of a $FC start token.

               Run sequence (no power cycle between):
                 1. Power-cycle Lerdisk in Edge socket
                 2. Run SD_RT_mount_tests  (the wedge-primer)
                 3. Run this diagnostic

   Expected outcomes:
     - Write #2 SUCCEEDS with CS held LOW across:
         -> CS TOGGLE is the wedge trigger
         -> Fix path: for CW_NO_DATA_CRC cards, fuse adjacent single-block writes
            into a sequence that keeps CS LOW across them
     - Write #2 FAILS the same way as the baseline (drespTO or busyTO):
         -> CS toggle is NOT the trigger
         -> The fundamental issue is the act of issuing a fresh CMD24 after a
            committed prior write; we have eliminated the last structural variable
         -> Investigation pivots from "what driver change avoids it" to "what about
            the SD protocol or card-firmware design makes this card behave this way"

   Author..... Stephen M Moraco
   Started.... 27 MAY 2026
================================================================================================= }}

CON
    _CLKFREQ        = 350_000_000
    DEBUG_BAUD      = 2_000_000

    DEBUG_MASK      = (1 << 0) | (1 << 4) | (1 << 9)

#ifdef SD_PINS_EXTERNAL
    SD_CS   = 20
    SD_MOSI = 19
    SD_MISO = 18
    SD_SCK  = 21
#else
    SD_CS   = 60
    SD_MOSI = 59
    SD_MISO = 58
    SD_SCK  = 61
#endif

    SECTOR_SIZE = 512
    LBA_TEST_A  = 100_000
    LBA_TEST_B  = 100_001

#pragma exportdef SD_INCLUDE_ALL

OBJ
    sd : "micro_sd_fat32_fs"

DAT
    buf1    BYTE    0[SECTOR_SIZE]
    buf2    BYTE    0[SECTOR_SIZE]

PUB go() | mountStatus, w1Status, w2Status, idx, code, r1, dresp, sec, r1_ms, polls, op

    debug(" ")
    debug("=== CS-LOW-across-writes (experiment 6.3): LBA ", udec_(LBA_TEST_A), " / ", udec_(LBA_TEST_B), " ===")
    debug(" ")

    repeat idx from 0 to SECTOR_SIZE - 1
        buf1[idx] := $7E
        buf2[idx] := $E7

    mountStatus := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    debug("  mount() status = ", sdec_(mountStatus))
    if mountStatus <> 0
        debug("FATAL: mount failed; cannot run experiment")
        flushAndEnd()
        return

    debug("  cardWarnings = $", uhex_(sd.cardWarnings()))
    debug(" ")

    ' ---------- WRITE #1 — arm the test hook BEFORE this write ----------
    ' So that writeSector skips the pinh(cs) and CMD13 at the end of write #1.
    sd.setTestSkipCsRelease(1)
    debug("  test_skip_cs_release armed: writeSector will leave CS LOW after success.")
    debug(" ")

    debug("--- Write #1 at sector ", udec_(LBA_TEST_A), " via writeSectorRaw (CMD24) [CS will stay LOW] ---")
    w1Status := sd.writeSectorRaw(LBA_TEST_A, @buf1)
    debug("  writeSectorRaw status = ", sdec_(w1Status))
    code, r1, dresp, sec := sd.getWriteDiag()
    r1_ms, polls, op := sd.getCmdR1Diag()
    debug("    writeDiag: code=", udec_(code), " R1=$", uhex_byte_(r1), " dresp=$", uhex_byte_(dresp), " sector=", udec_(sec))
    debug("    cmdR1Diag: latency=", sdec_(r1_ms), " ms after ", udec_(polls), " polls (op=", udec_(op), ")")
    debug(" ")

    if w1Status < 0
        debug("UNEXPECTED: write #1 failed.")
        sd.setTestSkipCsRelease(0)
        sd.unmount()
        flushAndEnd()
        return

    ' ---------- WRITE #2 — CS is still LOW from write #1 (test hook held it down) ----------
    debug("--- Write #2 at sector ", udec_(LBA_TEST_B), " via writeSectorRaw (CMD24) [CS still LOW from #1] ---")
    w2Status := sd.writeSectorRaw(LBA_TEST_B, @buf2)
    debug("  writeSectorRaw status = ", sdec_(w2Status))
    code, r1, dresp, sec := sd.getWriteDiag()
    r1_ms, polls, op := sd.getCmdR1Diag()
    debug("    writeDiag: code=", udec_(code), " R1=$", uhex_byte_(r1), " dresp=$", uhex_byte_(dresp), " sector=", udec_(sec))
    debug("    cmdR1Diag: latency=", sdec_(r1_ms), " ms after ", udec_(polls), " polls (op=", udec_(op), ")")
    debug(" ")

    ' Disarm so post-experiment cleanup is normal
    sd.setTestSkipCsRelease(0)

    if w2Status == 0
        debug("RESULT: Write #2 SUCCEEDED with CS held LOW across the two writes!")
        debug("        -> CS toggle is the wedge trigger.")
        debug("        -> Fix path: for asdfg-class cards, fuse adjacent single-block")
        debug("           writes into a CS-low-across sequence.")
    else
        debug("RESULT: Write #2 FAILED (status=", sdec_(w2Status), " code=", udec_(code), " dresp=$", uhex_byte_(dresp), ").")
        debug("        -> CS toggle is NOT the trigger.")
        debug("        -> The wedge is in the act of issuing a fresh CMD24 after a")
        debug("           prior committed single-block write, regardless of bus state.")
        debug("        -> All structural driver variables now eliminated. Wedge is a")
        debug("           card-internal property, not a driver issue we can work around.")
    debug(" ")

    sd.unmount()
    flushAndEnd()

PRI flushAndEnd()
    debug(" ")
    debug("=== END OF EXPERIMENT ===")
    waitms(100)
    debug("END_SESSION")
