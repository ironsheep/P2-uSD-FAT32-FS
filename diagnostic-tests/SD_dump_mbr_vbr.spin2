{{ =================================================================================================
   File....... SD_dump_mbr_vbr.spin2
   Purpose.... Forensic capture: full 512-byte hex dumps of the four FAT32 ground-truth
               structures of the as-received counterfeit Cloudisk 2GB card --
               MBR (sector 0), VBR/BPB (partition LBA start), first FAT sector, and the
               first root-directory sector -- with the BPB decoded so the FAT and
               root-dir sector numbers are computed from the card itself.
   Author..... Stephen M Moraco
   Started.... 18 MAY 2026
   Updated.... 18 MAY 2026 -- extended to FAT + root dir; added serial-flush guard
================================================================================================= }}

CON
    _CLKFREQ        = 350_000_000
    DEBUG_BAUD      = 2_000_000

    ' SD card pin assignments
    ' Default: P2 Edge module SD slot. Build with -D SD_PINS_EXTERNAL
    ' to use the external SD header (base pin 16).
#ifdef SD_PINS_EXTERNAL
    SD_CS   = 20
    SD_MOSI = 19
    SD_MISO = 18
    SD_SCK  = 21
#else
    SD_CS   = 60
    SD_MOSI = 59
    SD_MISO = 58
    SD_SCK  = 61
#endif
    VBR_SECTOR      = 8192                                                      ' partition 1 LBA start (from the MBR)

#pragma exportdef SD_INCLUDE_ALL

OBJ
    sd : "micro_sd_fat32_fs"

DAT
    buf     BYTE    0[512]

PUB go() | status, bytsPerSec, secPerClus, rsvdSecCnt, numFATs, fatSz32, rootClus, fatStartSec, dataStartSec, rootDirSec

    debug(" ")
    debug("=== SD MBR/VBR/FAT/ROOTDIR FORENSIC DUMP (as-received) ===")
    debug(" ")

    status := sd.initCardOnly(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    if status < 0
        debug("FATAL: initCardOnly failed (", sdec_(status), ")")
        flushAndEnd()
        return
    debug("  initCardOnly OK")

    ' ---- MBR (sector 0) ----
    debug(" ")
    debug("================ MBR  (sector 0) ================")
    status := sd.readSectorRaw(0, @buf)
    if status < 0
        debug("  ERROR reading sector 0  (status ", sdec_(status), ")")
        flushAndEnd()
        return
    dumpSector()
    debug("  signature[510..511] = ", uhex_byte_(buf[510]), " ", uhex_byte_(buf[511]), "  (expect 55 AA)")
    debug("  part1 type (off 450) = ", uhex_byte_(buf[450]), "  LBA start (off 454) = ", udec_(buf[454] | (buf[455] << 8) | (buf[456] << 16) | (buf[457] << 24)))

    ' ---- VBR (partition LBA start) ----
    debug(" ")
    debug("================ VBR  (sector ", udec_(VBR_SECTOR), ") ================")
    status := sd.readSectorRaw(VBR_SECTOR, @buf)
    if status < 0
        debug("  ERROR reading sector ", udec_(VBR_SECTOR), "  (status ", sdec_(status), ")")
        flushAndEnd()
        return
    dumpSector()

    bytsPerSec := buf[11] | (buf[12] << 8)
    secPerClus := buf[13]
    rsvdSecCnt := buf[14] | (buf[15] << 8)
    numFATs    := buf[16]
    fatSz32    := buf[36] | (buf[37] << 8) | (buf[38] << 16) | (buf[39] << 24)
    rootClus   := buf[44] | (buf[45] << 8) | (buf[46] << 16) | (buf[47] << 24)

    debug(" ")
    debug("  -- BPB decode --")
    debug("    BytsPerSec  (off 11) = ", udec_(bytsPerSec), "   (expect 512)")
    debug("    SecPerClus  (off 13) = ", udec_(secPerClus))
    debug("    RsvdSecCnt  (off 14) = ", udec_(rsvdSecCnt))
    debug("    NumFATs     (off 16) = ", udec_(numFATs))
    debug("    FATSz32     (off 36) = ", udec_(fatSz32))
    debug("    RootClus    (off 44) = ", udec_(rootClus))
    debug("    fstype @82           = '", lstr_(@buf + 82, 8), "'")
    debug("    signature[510..511]  = ", uhex_byte_(buf[510]), " ", uhex_byte_(buf[511]))

    ' ---- derived geometry (computed from the card's own BPB) ----
    fatStartSec  := VBR_SECTOR + rsvdSecCnt
    dataStartSec := VBR_SECTOR + rsvdSecCnt + (numFATs * fatSz32)
    rootDirSec   := dataStartSec + ((rootClus - 2) * secPerClus)
    debug(" ")
    debug("  -- derived geometry (absolute LBAs) --")
    debug("    FAT[0] start sector  = ", udec_(fatStartSec))
    debug("    data region start    = ", udec_(dataStartSec))
    debug("    root dir start sector= ", udec_(rootDirSec))

    ' ---- first FAT sector ----
    debug(" ")
    debug("================ FAT[0]  (sector ", udec_(fatStartSec), ") ================")
    status := sd.readSectorRaw(fatStartSec, @buf)
    if status < 0
        debug("  ERROR reading FAT sector  (status ", sdec_(status), ")")
    else
        dumpSector()
        debug("  FAT[0] (media+EOC) = ", uhex_long_(buf[0] | (buf[1] << 8) | (buf[2] << 16) | (buf[3] << 24)))
        debug("  FAT[1] (EOC)       = ", uhex_long_(buf[4] | (buf[5] << 8) | (buf[6] << 16) | (buf[7] << 24)))
        debug("  FAT[2] (root clus) = ", uhex_long_(buf[8] | (buf[9] << 8) | (buf[10] << 16) | (buf[11] << 24)))

    ' ---- first root-directory sector ----
    debug(" ")
    debug("================ ROOT DIR  (sector ", udec_(rootDirSec), ") ================")
    status := sd.readSectorRaw(rootDirSec, @buf)
    if status < 0
        debug("  ERROR reading root dir sector  (status ", sdec_(status), ")")
    else
        dumpSector()

    flushAndEnd()


PRI dumpSector() | off
' Hex-dump the 512-byte buffer, 16 bytes per line, with the offset prefix.

    repeat off from 0 to 511 step 16
        debug("  ", uhex_word_(off), ": ", uhex_byte_array_(@buf + off, 16))


PRI flushAndEnd()
' Give the headless terminal time to drain its log backlog before END_SESSION
' triggers shutdown, otherwise the burst of dump lines is lost.

    waitms(500)
    debug(" ")
    debug("END_SESSION")
