{{ =================================================================================================
   File....... SD_cmd25_single_repro.spin2
   Purpose.... Experiment 2 (asdfg counterfeit SDSC wedge investigation, 2026-05-26):
               CMD24 vs CMD25 single-block isolation.

               Hypothesis: after the mount_tests primer run, write #1 succeeds and
               write #2's data-response is silently refused. The pattern is identical
               whether or not we add an idle gap after write #1 (experiment 1 refuted).
               This experiment asks: is the refusal specifically of CMD24's single-block
               protocol path (no stop-token cleanup), or is it independent of which
               WRITE command is used?

               Run sequence (no power cycle between):
                 1. Power-cycle Lerdisk in Edge socket
                 2. Run SD_RT_mount_tests (the wedge-primer)
                 3. Run this diagnostic

               This diagnostic:
                 - mount() the card
                 - Write #1 to sector 100_000 via writeSectorRaw  (CMD24 single-block)
                 - Write #2 to sector 100_001 via writeSectorsRaw(start, 1, buf)
                                                                  (CMD25 single-block + $FD stop token)
                 - Report both outcomes plus the write diagnostics from each path

   Expected outcomes:
     - CMD25-single SUCCESS where CMD24 would fail -> the wedge is specifically about
       CMD24's protocol path; CMD25 + $FD cleanup is tolerated by the counterfeit silicon.
     - CMD25-single FAILS at write #2 too -> the wedge is independent of WRITE command;
       points at something deeper in the card's flash translation layer reacting to
       write #1's commit regardless of protocol path.

   Author..... Stephen M Moraco
   Started.... 26 MAY 2026
================================================================================================= }}

CON
    _CLKFREQ        = 350_000_000
    DEBUG_BAUD      = 2_000_000

    ' Debug channel mask: INIT + SECTOR + RECOVER
    DEBUG_MASK      = (1 << 0) | (1 << 4) | (1 << 9)

    ' SD card pin assignments
#ifdef SD_PINS_EXTERNAL
    SD_CS   = 20
    SD_MOSI = 19
    SD_MISO = 18
    SD_SCK  = 21
#else
    SD_CS   = 60
    SD_MOSI = 59
    SD_MISO = 58
    SD_SCK  = 61
#endif

    SECTOR_SIZE = 512

#pragma exportdef SD_INCLUDE_ALL

OBJ
    sd : "micro_sd_fat32_fs"

DAT
    buf1    BYTE    0[SECTOR_SIZE]
    buf2    BYTE    0[SECTOR_SIZE]

PUB go() | mountStatus, w1Status, w2Status, idx

    debug(" ")
    debug("=== CMD24 vs CMD25 single-block isolation (experiment 2) ===")
    debug(" ")

    ' Fill buffers with distinct patterns so we can tell them apart if read-back
    ' is ever attempted (not in this run; we are only testing write acceptance)
    repeat idx from 0 to SECTOR_SIZE - 1
        buf1[idx] := $A1
        buf2[idx] := $B2

    ' Mount the card (drives the same init path as mount_tests)
    mountStatus := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    debug("  mount() status = ", sdec_(mountStatus))
    if mountStatus <> 0
        debug("FATAL: mount failed; cannot run experiment")
        flushAndEnd()
        return

    debug("  cardWarnings = $", uhex_(sd.cardWarnings()))
    debug(" ")

    ' ---------- WRITE #1: CMD24 single-block (writeSectorRaw) ----------
    debug("--- Write #1 at sector 100_000 via writeSectorRaw (CMD24) ---")
    w1Status := sd.writeSectorRaw(100_000, @buf1)
    debug("  writeSectorRaw status = ", sdec_(w1Status))
    dumpWriteDiag(@"write #1 (CMD24)")
    debug(" ")

    if w1Status < 0
        debug("UNEXPECTED: write #1 failed before the experiment could trigger.")
        debug("            The wedge primer (mount_tests) may not have run, or")
        debug("            the card is in a different state than expected.")
        sd.unmount()
        flushAndEnd()
        return

    ' ---------- WRITE #2: CMD25 single-block (writeSectorsRaw, count=1) ----------
    ' This is the experiment: same payload, same sector address class, DIFFERENT
    ' command. If CMD25 succeeds where CMD24 would have failed (per the historical
    ' raw_sector_tests reproducer), the wedge is CMD24-specific.
    debug("--- Write #2 at sector 100_001 via writeSectorsRaw(count=1) (CMD25 + $FD) ---")
    w2Status := sd.writeSectorsRaw(100_001, 1, @buf2)
    debug("  writeSectorsRaw returned (sectors_written) = ", udec_(w2Status))
    dumpWriteDiag(@"write #2 (CMD25 single)")
    debug(" ")

    if w2Status == 1
        debug("RESULT: CMD25 single-block ACCEPTED at write #2.")
        debug("        -> Wedge is CMD24-specific. The card refuses CMD24's no-stop-token")
        debug("           protocol after a prior successful CMD24, but accepts CMD25 + $FD.")
    else
        debug("RESULT: CMD25 single-block REJECTED at write #2 (sectors_written = ", udec_(w2Status), ").")
        debug("        -> Wedge is INDEPENDENT of write command. The mechanism is deeper")
        debug("           than the CMD24-vs-CMD25 protocol distinction.")
    debug(" ")

    sd.unmount()

    flushAndEnd()

PRI dumpWriteDiag(label) | code, r1, dresp, sec, r1_ms, polls, op
'' Dump driver write-path diagnostics so we can see what the driver observed.
    code, r1, dresp, sec := sd.getWriteDiag()
    r1_ms, polls, op := sd.getCmdR1Diag()
    debug("    DIAG (", zstr_(label), "):")
    debug("      writeDiag: code=", udec_(code), " R1=$", uhex_byte_(r1), " dresp=$", uhex_byte_(dresp), " sector=", udec_(sec))
    debug("      (codes: 1=CMD24fatalR1 2=drespTO 3=CRCrej 4=writeErr 5=unkRej 6=busyTO 7=success 8=R1neverArrived)")
    debug("      cmdR1Diag: latency=", sdec_(r1_ms), " ms after ", udec_(polls), " polls (op=", udec_(op), ")")

PRI flushAndEnd()
    debug(" ")
    debug("=== END OF EXPERIMENT ===")
    waitms(100)
    debug("END_SESSION")
