{{ =================================================================================================
   File....... SD_lba_scan_50K.spin2
   Purpose.... Experiment 6.2 (asdfg counterfeit SDSC wedge investigation, 2026-05-27):
               Multi-LBA scan, point 1: LBA 50,000.

               Hypothesis: experiments 5 and 6.1 established two distinct failure modes:
                 - busyTO at low-LBA-fresh (1,001) and same-LBA-rewrite (100,000 twice)
                 - drespTO at high-LBA-fresh (100,001)
               This scan probes intermediate LBAs to characterize where the boundary
               between modes lies.

               This is the first of a planned scan:
                 LBA 10        — very low (boot/MBR area)
                 LBA 1,000     — already tested (busyTO) - experiment 5
                 LBA 50,000    — THIS TEST (midpoint between 1K and 100K)
                 LBA 100,000   — already tested (drespTO) - baseline
                 LBA 500,000   — high LBA
                 LBA near-end  — very high LBA

               Run sequence (no power cycle between):
                 1. Power-cycle Lerdisk in Edge socket
                 2. Run SD_RT_mount_tests  (the wedge-primer)
                 3. Run this diagnostic

   Expected outcomes (interpreted post-run):
     - If write #2 at 50,001 is busyTO -> mode-boundary is between 50K and 100K
     - If write #2 at 50,001 is drespTO -> mode-boundary is between 1K and 50K

   Author..... Stephen M Moraco
   Started.... 27 MAY 2026
================================================================================================= }}

CON
    _CLKFREQ        = 350_000_000
    DEBUG_BAUD      = 2_000_000

    DEBUG_MASK      = (1 << 0) | (1 << 4) | (1 << 9)

#ifdef SD_PINS_EXTERNAL
    SD_CS   = 20
    SD_MOSI = 19
    SD_MISO = 18
    SD_SCK  = 21
#else
    SD_CS   = 60
    SD_MOSI = 59
    SD_MISO = 58
    SD_SCK  = 61
#endif

    SECTOR_SIZE = 512
    LBA_TEST_A  = 50_000
    LBA_TEST_B  = 50_001

#pragma exportdef SD_INCLUDE_ALL

OBJ
    sd : "micro_sd_fat32_fs"

DAT
    buf1    BYTE    0[SECTOR_SIZE]
    buf2    BYTE    0[SECTOR_SIZE]

PUB go() | mountStatus, w1Status, w2Status, idx, code, r1, dresp, sec, r1_ms, polls, op

    debug(" ")
    debug("=== Multi-LBA scan (experiment 6.2): LBA 50,000 / 50,001 ===")
    debug(" ")

    repeat idx from 0 to SECTOR_SIZE - 1
        buf1[idx] := $A5
        buf2[idx] := $5A

    mountStatus := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    debug("  mount() status = ", sdec_(mountStatus))
    if mountStatus <> 0
        debug("FATAL: mount failed; cannot run experiment")
        flushAndEnd()
        return

    debug("  cardWarnings = $", uhex_(sd.cardWarnings()))
    debug(" ")

    debug("--- Write #1 at sector ", udec_(LBA_TEST_A), " via writeSectorRaw (CMD24) ---")
    w1Status := sd.writeSectorRaw(LBA_TEST_A, @buf1)
    debug("  writeSectorRaw status = ", sdec_(w1Status))
    code, r1, dresp, sec := sd.getWriteDiag()
    r1_ms, polls, op := sd.getCmdR1Diag()
    debug("    writeDiag: code=", udec_(code), " R1=$", uhex_byte_(r1), " dresp=$", uhex_byte_(dresp), " sector=", udec_(sec))
    debug("    (codes: 1=CMD24fatalR1 2=drespTO 3=CRCrej 4=writeErr 5=unkRej 6=busyTO 7=success 8=R1neverArrived)")
    debug("    cmdR1Diag: latency=", sdec_(r1_ms), " ms after ", udec_(polls), " polls (op=", udec_(op), ")")
    debug(" ")

    if w1Status < 0
        debug("UNEXPECTED: write #1 at LBA ", udec_(LBA_TEST_A), " failed.")
        sd.unmount()
        flushAndEnd()
        return

    debug("--- Write #2 at sector ", udec_(LBA_TEST_B), " (adjacent, fresh) via writeSectorRaw (CMD24) ---")
    w2Status := sd.writeSectorRaw(LBA_TEST_B, @buf2)
    debug("  writeSectorRaw status = ", sdec_(w2Status))
    code, r1, dresp, sec := sd.getWriteDiag()
    r1_ms, polls, op := sd.getCmdR1Diag()
    debug("    writeDiag: code=", udec_(code), " R1=$", uhex_byte_(r1), " dresp=$", uhex_byte_(dresp), " sector=", udec_(sec))
    debug("    (codes: 1=CMD24fatalR1 2=drespTO 3=CRCrej 4=writeErr 5=unkRej 6=busyTO 7=success 8=R1neverArrived)")
    debug("    cmdR1Diag: latency=", sdec_(r1_ms), " ms after ", udec_(polls), " polls (op=", udec_(op), ")")
    debug(" ")

    debug("RESULT: write #2 at LBA ", udec_(LBA_TEST_B), " status=", sdec_(w2Status), " code=", udec_(code), " dresp=$", uhex_byte_(dresp))
    if code == 6
        debug("  -> busyTO mode (data accepted, busy stuck). Mode-boundary is between 50K and 100K.")
    elseif code == 2
        debug("  -> drespTO mode (no dresp). Mode-boundary is between 1K and 50K.")
    elseif w2Status == 0
        debug("  -> SUCCESS at this LBA! Sector range really does matter; wedge has range exemptions.")
    else
        debug("  -> Different / unexpected failure code. Investigate.")
    debug(" ")

    sd.unmount()
    flushAndEnd()

PRI flushAndEnd()
    debug(" ")
    debug("=== END OF EXPERIMENT ===")
    waitms(100)
    debug("END_SESSION")
