{{ =================================================================================================

   File....... SD_frequency_characterize.spin2
   Purpose.... Sweep sysclk frequencies to find failure boundaries for streamer timing
   Author..... Stephen M Moraco
               -- see below for terms of use
   E-mail..... stephen@ironsheep.biz
   Started.... JAN 2026
   Updated.... 01 MAR 2026

   This utility dynamically changes sysclk frequency using clkset() to find exactly where
   the driver's multi-block operations fail. The goal is to identify timing-sensitive
   frequency ranges and quantization boundaries.

   Test Matrix (ascending sweep, 200 -> 350 MHz):
     200 MHz - hp=4, exact division
     220 MHz - hp=5
     240 MHz - hp=5
     250 MHz - hp=5, HDMI target
     255 MHz - hp=6 (boundary, hp changes 5->6 above this)
     260 MHz - hp=6
     270 MHz - hp=6, FAIL (verified)
     280 MHz - hp=6
     290 MHz - hp=6
     295 MHz - hp=6
     300 MHz - hp=6, exact 25 MHz SPI
     305 MHz - hp=7 (boundary, hp changes 6->7 above this)
     310 MHz - hp=7
     320 MHz - hp=7
     330 MHz - hp=7
     340 MHz - hp=7
     350 MHz - hp=7, P2 absolute max (overclock)

   Encoding (per p2kbPasm2Hubset):
     D[24]    = 1 (PLL enable)
     D[23:18] = XDIV - 1   (PLL input divider, 6 bits)
     D[17:8]  = XMUL - 1   (VCO multiplier, 10 bits)
     D[7:4]   = PPPP       (post divider: 0=/1, 1=/2, 3=/4, 5=/6, ...)
     D[3:2]   = 01         (15pF caps for 20 MHz crystal)
     D[1:0]   = 11         (PLL source)

   Each entry chooses XDIV and XMUL so VCO equals target (post=1), keeping
   VCO at or below the P2's ~350 MHz absolute max so the PLL stays in spec.

   The test runs writeSectorsRaw(8) + readSectorsRaw(8) and checks data integrity.
   This is the exact operation that fails at 270 MHz.

================================================================================================= }}

CON

    ' Boot at 200 MHz (lowest, safest in our sweep range)
    _CLKFREQ        = 200_000_000

    ' Lock DEBUG terminal baud so it survives sysclk changes
    DEBUG_BAUD      = 2_000_000

    ' P2 Edge module SD slot pins
    SD_CS   = 60
    SD_MOSI = 59
    SD_MISO = 58
    SD_SCK  = 61

    ' Test parameters
    TEST_SECTOR_BASE = 200_100          ' Different from other tests to avoid collisions
    TEST_COUNT       = 8                ' 8 sectors = 4KB
    CLK_SETTLE_MS    = 10               ' Clock stabilization delay after frequency change

    ' Frequency test points (ascending order, 200 -> 350 MHz)
    #0, FREQ_200, FREQ_220, FREQ_240, FREQ_250, FREQ_255, FREQ_260
    #6, FREQ_270, FREQ_280, FREQ_290, FREQ_295, FREQ_300, FREQ_305
    #12, FREQ_310, FREQ_320, FREQ_330, FREQ_340, FREQ_350, FREQ_COUNT

    ' Test mode selectors for runSweepPass()
    #0, MODE_C, MODE_A, MODE_B

' Enable full driver features for this utility
#ifdef __SPINTOOLS__
#define SD_INCLUDE_ALL
#elseifdef __FLEXSPIN__
#define SD_INCLUDE_ALL
#pragma exportdef SD_INCLUDE_ALL
#else
#pragma exportdef SD_INCLUDE_ALL
#endif

OBJ
    sd : "micro_sd_fat32_fs"

DAT
    ' Test frequencies in Hz (ascending order, 200 -> 350 MHz)
    freq_table      long    200_000_000     ' FREQ_200 - hp=4
                    long    220_000_000     ' FREQ_220 - hp=5
                    long    240_000_000     ' FREQ_240 - hp=5
                    long    250_000_000     ' FREQ_250 - hp=5, HDMI target
                    long    255_000_000     ' FREQ_255 - hp=6 (boundary 5->6)
                    long    260_000_000     ' FREQ_260 - hp=6
                    long    270_000_000     ' FREQ_270 - hp=6 (known fail)
                    long    280_000_000     ' FREQ_280 - hp=6
                    long    290_000_000     ' FREQ_290 - hp=6
                    long    295_000_000     ' FREQ_295 - hp=6
                    long    300_000_000     ' FREQ_300 - hp=6, exact 25 MHz
                    long    305_000_000     ' FREQ_305 - hp=7 (boundary 6->7)
                    long    310_000_000     ' FREQ_310 - hp=7
                    long    320_000_000     ' FREQ_320 - hp=7
                    long    330_000_000     ' FREQ_330 - hp=7
                    long    340_000_000     ' FREQ_340 - hp=7
                    long    350_000_000     ' FREQ_350 - hp=7, P2 absolute max

    ' Expected half_period for each frequency (sysclk / (2 * 25 MHz), rounded up)
    hp_table        byte    4               ' 200
                    byte    5, 5, 5         ' 220, 240, 250
                    byte    6, 6, 6, 6, 6, 6, 6   ' 255-300 range
                    byte    7, 7, 7, 7, 7, 7      ' 305, 310, 320, 330, 340, 350

    ' Results storage per mode: 0=untested, 1=PASS, 2=FAIL
    '   C = no-fix: SPI hp set at boot mount, drifts as sysclk rises (SPI overclocks)
    '   A = sysclk isolation: setSPISpeed(25 MHz) after each clkset
    '   B = full remount: unmount + mount at this sysclk (driver picks fresh hp)
    results_c       byte    0[FREQ_COUNT]
    results_a       byte    0[FREQ_COUNT]
    results_b       byte    0[FREQ_COUNT]

VAR
    BYTE    write_buf[TEST_COUNT * sd.SECTOR_SIZE]
    BYTE    read_buf[TEST_COUNT * sd.SECTOR_SIZE]
    LONG    pass_count
    LONG    fail_count

PUB go() | result, freq_idx, test_freq, errors, hp, lbl_c, lbl_a, lbl_b
'' Main entry point - runs sysclk frequency sweep test.
'' Dynamically changes sysclk to find where streamer timing fails.

    debug(" ")
    debug("============================================================")
    debug("  SD Frequency Sweep Test (V2 Driver)")
    debug("============================================================")
    debug("  Purpose: Find sysclk frequencies where streamer timing fails")
    debug("  Test: writeSectorsRaw(8) + readSectorsRaw(8) + verify")
    debug(" ")
    debug("Boot clkfreq = ", udec_long_(clkfreq), "  clkmode = $", uhex_long_(clkmode))

    pass_count := 0
    fail_count := 0

    debug("============================================================")
    debug("  FREQUENCY SWEEP (200 -> 350 MHz, 3 modes per frequency)")
    debug("============================================================")
    debug("    Mode C: host runtime timing isolated via debugOnClockChange()")
    debug("            (sysclk rises, SPI hp does not -> SPI overclocks)")
    debug("            Documents what a user-without-driver-help sees.")
    debug("    Mode A: setSPISpeed(25 MHz) after each clkset")
    debug("            (sysclk-isolation: SPI held at 25 MHz, only sysclk varies)")
    debug("    Mode B: unmount + mount at this sysclk before each test")
    debug("            (full re-init: exercises mount path at this sysclk)")
    debug(" ")
    debug("  Each mode is its own pass with its own boot-anchored mount,")
    debug("  so per-mode semantics stay clean (Mode C truly stale, etc.).")

    ' --- PASS 1: Mode C (host runtime timing isolated via debugOnClockChange) ---
    ' Per S.3 + S.4 of the SPI Phase-Margin sprint plan, Mode C now exercises the
    ' host-side runtime timing in isolation: after each clkset() we call
    ' sd.debugOnClockChange() which recomputes host-side state (spi_period, MISO
    ' sample mode, idle/tick thresholds, SCK WXPIN) without re-initializing the
    ' card. This requires SD_INCLUDE_DEBUG to be exportdef'd by this consumer
    ' (we exportdef SD_INCLUDE_ALL above, which includes DEBUG).
    debug(" ")
    debug("============================================================")
    debug("  PASS 1: Mode C (host runtime timing via debugOnClockChange)")
    debug("============================================================")
    runSweepPass(@results_c, MODE_C)

    ' --- PASS 2: Mode A (setSPISpeed(25 MHz) at each freq) ---
    debug(" ")
    debug("============================================================")
    debug("  PASS 2: Mode A (sysclk isolation, SPI held at 25 MHz)")
    debug("============================================================")
    runSweepPass(@results_a, MODE_A)

    ' --- PASS 3: Mode B (full remount at each freq) ---
    debug(" ")
    debug("============================================================")
    debug("  PASS 3: Mode B (full unmount + mount at each freq)")
    debug("============================================================")
    runSweepPass(@results_b, MODE_B)

    ' Return to safe boot freq before reporting
    changeFrequency(200_000_000)
    waitms(CLK_SETTLE_MS)
    sd.unmount()

    ' Print summary
    debug(" ")
    debug("============================================================")
    debug("  FREQUENCY SWEEP RESULTS")
    debug("============================================================")
    debug(" ")
    debug("  Freq    hp   ModeC  ModeA  ModeB")
    debug("  ------  ---  -----  -----  -----")

    repeat freq_idx from 0 to FREQ_COUNT - 1
        test_freq := long[@freq_table][freq_idx]
        hp := byte[@hp_table][freq_idx]
        lbl_c := resultLabel(results_c[freq_idx])
        lbl_a := resultLabel(results_a[freq_idx])
        lbl_b := resultLabel(results_b[freq_idx])
        debug("  ", udec_long_(test_freq / 1_000_000), " MHz  ", udec_(hp), "   ", zstr_(lbl_c), "   ", zstr_(lbl_a), "   ", zstr_(lbl_b))

    debug(" ")
    debug("  Total tests: ", udec_(pass_count), " PASS, ", udec_(fail_count), " FAIL")
    debug(" ")

    ' Identify boundaries (Mode A only - the canonical sysclk-isolation result)
    debug("============================================================")
    debug("  BOUNDARY ANALYSIS (Mode A - sysclk isolation)")
    debug("============================================================")
    analyzeBoundaries()

    debug(" ")
    debug("END_SESSION")


PRI runSweepPass(results_ptr, mode) | freq_idx, test_freq, hp, errors, mount_status
' Run one mode's full sweep across all frequencies.
'
' Each pass is self-contained: boots at 200 MHz, mounts once at 200 MHz, then
' for each target sysclk applies the mode-specific action and runs writeSectorsRaw
' + readSectorsRaw + verify. This isolates each mode's semantics so Mode C truly
' tests "stale boot-mount hp" without interference from Mode B remounts.
'
' @param results_ptr - Address of byte array to record results in
' @param mode        - MODE_C, MODE_A, or MODE_B

    ' Anchor every pass at 200 MHz with a fresh mount
    changeFrequency(200_000_000)
    waitms(CLK_SETTLE_MS)
    mount_status := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    if mount_status < 0
        debug("  ERROR: boot-anchor mount failed (", udec_(mount_status), ")")
        return
    fillTestPattern()

    repeat freq_idx from 0 to FREQ_COUNT - 1
        test_freq := long[@freq_table][freq_idx]
        hp := byte[@hp_table][freq_idx]

        debug(" ")
        debug("--- ", udec_(test_freq / 1_000_000), " MHz (hp=", udec_(hp), ") ---")
        changeFrequency(test_freq)
        waitms(CLK_SETTLE_MS)
        debug("  clkfreq = ", udec_(clkfreq))

        case mode
            MODE_C:
                ' S.4: recompute host-side sysclk-dependent state (spi_period,
                ' miso_wxpin, idle_flush_clocks, ct_tick_clocks, SCK WXPIN)
                ' WITHOUT re-initializing the card. This isolates host-side
                ' runtime timing as the test variable. Requires SD_INCLUDE_DEBUG.
                ' Returns 0 on success or E_BAD_RESPONSE if worker is busy.
                if sd.debugOnClockChange() <> 0
                    debug("    Mode C: debugOnClockChange aborted (worker busy)")
                    byte[results_ptr][freq_idx] := 2
                    fail_count++
                    next
            MODE_A:
                sd.setSPISpeed(25_000_000)
            MODE_B:
                sd.unmount()
                mount_status := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
                if mount_status < 0
                    debug("    Mode B mount FAILED (", udec_(mount_status), ")")
                    byte[results_ptr][freq_idx] := 2
                    fail_count++
                    next

        errors := runTest(test_freq)
        recordPassResult(results_ptr, freq_idx, errors)

    sd.unmount()


PRI recordPassResult(results_ptr, freq_idx, errors)
' Record a per-pass test result and bump global counters.

    if errors == 0
        byte[results_ptr][freq_idx] := 1
        debug("    -> PASS")
        pass_count++
    else
        byte[results_ptr][freq_idx] := 2
        debug("    -> FAIL: ", udec_(errors), " byte errors")
        fail_count++


PRI resultLabel(code) : label_ptr
' Map a result code (0=untested, 1=PASS, 2=FAIL) to a printable label.

    case code
        1:     label_ptr := @str_pass
        2:     label_ptr := @str_fail
        other: label_ptr := @str_skip


DAT
    str_pass    byte    "PASS", 0
    str_fail    byte    "FAIL", 0
    str_skip    byte    " -- ", 0


PRI fillTestPattern() | idx
' Fill write buffer with deterministic pattern.
' Pattern: each byte = (sector_num * 17 + byte_offset) & $FF

    repeat idx from 0 to (TEST_COUNT * sd.SECTOR_SIZE) - 1
        write_buf[idx] := ((idx / sd.SECTOR_SIZE) * 17 + (idx // sd.SECTOR_SIZE)) & $FF


PRI runTest(freq) : errors | written, readCt, idx, sector
' Run the critical test: writeSectorsRaw + readSectorsRaw + verify.
' This is exactly what fails at 270 MHz.
'
' @param freq - Current sysclk frequency (for logging)
' @returns errors - Number of byte errors (0 = pass)

    errors := -1
    sector := TEST_SECTOR_BASE

    ' Write 8 sectors
    written := sd.writeSectorsRaw(sector, TEST_COUNT, @write_buf)
    if written <> TEST_COUNT
        debug("  writeSectorsRaw returned ", udec_(written))
    else
        ' Clear read buffer
        bytefill(@read_buf, $00, TEST_COUNT * sd.SECTOR_SIZE)

        ' Read 8 sectors
        readCt := sd.readSectorsRaw(sector, TEST_COUNT, @read_buf)
        if readCt <> TEST_COUNT
            debug("  readSectorsRaw returned ", udec_(readCt))
        else
            ' Verify all bytes
            errors := 0
            repeat idx from 0 to (TEST_COUNT * sd.SECTOR_SIZE) - 1
                if read_buf[idx] <> write_buf[idx]
                    if errors < 3
                        debug("  byte ", udec_(idx), ": exp=$", uhex_byte_(write_buf[idx]), " got=$", uhex_byte_(read_buf[idx]))
                    errors++


PRI changeFrequency(target_freq)
' Change system clock to target frequency using PLL.
'
' Encoding (verified against compiler-emitted CLKMODE for _CLKFREQ=200_000_000
' which produced $0100_09FB):
'   D[24]    = 1            (PLL enable)
'   D[23:18] = XDIV - 1     (PLL input divider)
'   D[17:8]  = XMUL - 1     (VCO multiplier)
'   D[7:4]   = PPPP         (post divider: %1111 = /1, %0000 = /2, %0001 = /4, ...)
'   D[3:2]   = %10          (15pF caps for 20 MHz crystal)
'   D[1:0]   = %11          (PLL source)
'
' Each target chooses XDIV and XMUL so VCO == target with post=1, keeping VCO at
' or below the P2's ~350 MHz absolute max so the PLL stays within spec.
'
' @param target_freq - Target frequency in Hz

    case target_freq
        200_000_000:
            ' 20/1 * 10 = 200 MHz, VCO=200
            clkset(%1_000000_0000001001_1111_10_11, target_freq)
        220_000_000:
            ' 20/1 * 11 = 220 MHz, VCO=220
            clkset(%1_000000_0000001010_1111_10_11, target_freq)
        240_000_000:
            ' 20/1 * 12 = 240 MHz, VCO=240
            clkset(%1_000000_0000001011_1111_10_11, target_freq)
        250_000_000:
            ' 20/2 * 25 = 250 MHz, VCO=250
            clkset(%1_000001_0000011000_1111_10_11, target_freq)
        255_000_000:
            ' 20/4 * 51 = 255 MHz, VCO=255
            clkset(%1_000011_0000110010_1111_10_11, target_freq)
        260_000_000:
            ' 20/1 * 13 = 260 MHz, VCO=260
            clkset(%1_000000_0000001100_1111_10_11, target_freq)
        270_000_000:
            ' 20/2 * 27 = 270 MHz, VCO=270
            clkset(%1_000001_0000011010_1111_10_11, target_freq)
        280_000_000:
            ' 20/1 * 14 = 280 MHz, VCO=280
            clkset(%1_000000_0000001101_1111_10_11, target_freq)
        290_000_000:
            ' 20/2 * 29 = 290 MHz, VCO=290
            clkset(%1_000001_0000011100_1111_10_11, target_freq)
        295_000_000:
            ' 20/4 * 59 = 295 MHz, VCO=295
            clkset(%1_000011_0000111010_1111_10_11, target_freq)
        300_000_000:
            ' 20/1 * 15 = 300 MHz, VCO=300
            clkset(%1_000000_0000001110_1111_10_11, target_freq)
        305_000_000:
            ' 20/4 * 61 = 305 MHz, VCO=305
            clkset(%1_000011_0000111100_1111_10_11, target_freq)
        310_000_000:
            ' 20/2 * 31 = 310 MHz, VCO=310
            clkset(%1_000001_0000011110_1111_10_11, target_freq)
        320_000_000:
            ' 20/1 * 16 = 320 MHz, VCO=320
            clkset(%1_000000_0000001111_1111_10_11, target_freq)
        330_000_000:
            ' 20/2 * 33 = 330 MHz, VCO=330
            clkset(%1_000001_0000100000_1111_10_11, target_freq)
        340_000_000:
            ' 20/1 * 17 = 340 MHz, VCO=340
            clkset(%1_000000_0000010000_1111_10_11, target_freq)
        350_000_000:
            ' 20/2 * 35 = 350 MHz, VCO=350
            clkset(%1_000001_0000100010_1111_10_11, target_freq)


PRI analyzeBoundaries() | idx, prev_result, curr_result, prev_freq, curr_freq, prev_hp, curr_hp
' Identify where PASS->FAIL and FAIL->PASS transitions occur.

    prev_result := results_a[0]
    prev_freq := long[@freq_table][0] / 1_000_000
    prev_hp := byte[@hp_table][0]

    repeat idx from 1 to FREQ_COUNT - 1
        curr_result := results_a[idx]
        curr_freq := long[@freq_table][idx] / 1_000_000
        curr_hp := byte[@hp_table][idx]

        if prev_result <> curr_result and prev_result > 0 and curr_result > 0
            if prev_result == 1 and curr_result == 2
                debug("  PASS->FAIL boundary: ", udec_(prev_freq), "-", udec_(curr_freq), " MHz")
                if prev_hp <> curr_hp
                    debug("    (hp boundary: ", udec_(prev_hp), "->", udec_(curr_hp), ")")
            elseif prev_result == 2 and curr_result == 1
                debug("  FAIL->PASS boundary: ", udec_(prev_freq), "-", udec_(curr_freq), " MHz")
                if prev_hp <> curr_hp
                    debug("    (hp boundary: ", udec_(prev_hp), "->", udec_(curr_hp), ")")

        prev_result := curr_result
        prev_freq := curr_freq
        prev_hp := curr_hp

con { license }

