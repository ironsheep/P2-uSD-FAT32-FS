{{ =================================================================================================
   File....... SD_same_lba_twice_repro.spin2
   Purpose.... Experiment 6.1 (asdfg counterfeit SDSC wedge investigation, 2026-05-26):
               Same-LBA-twice isolation.

               Hypothesis: experiments 1-5 refuted timing, command type, CRC content,
               post-write CMD13, and "sector range doesn't matter". Experiment 5 showed
               the failure mode varies by LBA. This test isolates whether the wedge
               trigger is:
                 (a) "any second single-block write after the first"
                       -> write #2 to LBA 100_000 (same as write #1) should also fail
                 (b) "writing to a fresh/different LBA"
                       -> write #2 to LBA 100_000 (same sector) might succeed

               Run sequence (no power cycle between):
                 1. Power-cycle Lerdisk in Edge socket
                 2. Run SD_RT_mount_tests  (the wedge-primer)
                 3. Run this diagnostic

               This diagnostic:
                 - mount() the card
                 - Write #1 at sector 100_000 (buf1 pattern $E1)
                 - Write #2 at sector 100_000 (SAME sector, buf2 pattern $F2)
                 - Report both outcomes plus full diag

   Expected outcomes:
     - Write #2 SUCCEEDS at same sector:
         -> The wedge trigger is "fresh LBA" (changing target address)
         -> The card holds some single-block-write state keyed by address
     - Write #2 FAILS at same sector:
         -> The wedge trigger is "any second single-block write"
         -> Address doesn't matter; the act of issuing a second write is the trigger
         -> The failure mode (drespTO vs busyTO) is what varies with LBA per experiment 5,
            but the failure itself is unconditional

   Author..... Stephen M Moraco
   Started.... 26 MAY 2026
================================================================================================= }}

CON
    _CLKFREQ        = 350_000_000
    DEBUG_BAUD      = 2_000_000

    ' Debug channel mask: INIT + SECTOR + RECOVER
    DEBUG_MASK      = (1 << 0) | (1 << 4) | (1 << 9)

    ' SD card pin assignments
#ifdef SD_PINS_EXTERNAL
    SD_CS   = 20
    SD_MOSI = 19
    SD_MISO = 18
    SD_SCK  = 21
#else
    SD_CS   = 60
    SD_MOSI = 59
    SD_MISO = 58
    SD_SCK  = 61
#endif

    SECTOR_SIZE = 512
    LBA_TEST    = 100_000                                                       ' Same LBA used by both writes

#pragma exportdef SD_INCLUDE_ALL

OBJ
    sd : "micro_sd_fat32_fs"

DAT
    buf1    BYTE    0[SECTOR_SIZE]
    buf2    BYTE    0[SECTOR_SIZE]

PUB go() | mountStatus, w1Status, w2Status, idx, code, r1, dresp, sec, r1_ms, polls, op

    debug(" ")
    debug("=== Same-LBA-twice (experiment 6.1): two writes to LBA 100,000 ===")
    debug(" ")

    ' Distinct fill patterns so we can tell which write landed
    repeat idx from 0 to SECTOR_SIZE - 1
        buf1[idx] := $E1
        buf2[idx] := $F2

    mountStatus := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    debug("  mount() status = ", sdec_(mountStatus))
    if mountStatus <> 0
        debug("FATAL: mount failed; cannot run experiment")
        flushAndEnd()
        return

    debug("  cardWarnings = $", uhex_(sd.cardWarnings()))
    debug(" ")

    ' ---------- WRITE #1 at LBA 100_000 (pattern buf1) ----------
    debug("--- Write #1 at sector ", udec_(LBA_TEST), " via writeSectorRaw (CMD24) ---")
    w1Status := sd.writeSectorRaw(LBA_TEST, @buf1)
    debug("  writeSectorRaw status = ", sdec_(w1Status))
    code, r1, dresp, sec := sd.getWriteDiag()
    r1_ms, polls, op := sd.getCmdR1Diag()
    debug("    writeDiag: code=", udec_(code), " R1=$", uhex_byte_(r1), " dresp=$", uhex_byte_(dresp), " sector=", udec_(sec))
    debug("    (codes: 1=CMD24fatalR1 2=drespTO 3=CRCrej 4=writeErr 5=unkRej 6=busyTO 7=success 8=R1neverArrived)")
    debug("    cmdR1Diag: latency=", sdec_(r1_ms), " ms after ", udec_(polls), " polls (op=", udec_(op), ")")
    debug(" ")

    if w1Status < 0
        debug("UNEXPECTED: write #1 failed (status=", sdec_(w1Status), "). Cannot continue.")
        sd.unmount()
        flushAndEnd()
        return

    ' ---------- WRITE #2 at SAME LBA (pattern buf2) ----------
    debug("--- Write #2 at sector ", udec_(LBA_TEST), " (SAME sector) via writeSectorRaw (CMD24) ---")
    w2Status := sd.writeSectorRaw(LBA_TEST, @buf2)
    debug("  writeSectorRaw status = ", sdec_(w2Status))
    code, r1, dresp, sec := sd.getWriteDiag()
    r1_ms, polls, op := sd.getCmdR1Diag()
    debug("    writeDiag: code=", udec_(code), " R1=$", uhex_byte_(r1), " dresp=$", uhex_byte_(dresp), " sector=", udec_(sec))
    debug("    (codes: 1=CMD24fatalR1 2=drespTO 3=CRCrej 4=writeErr 5=unkRej 6=busyTO 7=success 8=R1neverArrived)")
    debug("    cmdR1Diag: latency=", sdec_(r1_ms), " ms after ", udec_(polls), " polls (op=", udec_(op), ")")
    debug(" ")

    if w2Status == 0
        debug("RESULT: Write #2 at SAME LBA SUCCEEDED.")
        debug("        -> Wedge trigger is 'fresh LBA' (changing target address)")
        debug("        -> Card holds single-block-write state keyed by address")
        debug("        -> Workaround: rewriting same sector might be safe; different sectors are not")
    else
        debug("RESULT: Write #2 at SAME LBA FAILED (status = ", sdec_(w2Status), ").")
        debug("        -> Wedge trigger is 'any second single-block write' (regardless of address)")
        debug("        -> The failure stage varies by LBA (experiment 5) but the failure is unconditional")
        debug("        -> No address-based workaround is possible")
    debug(" ")

    sd.unmount()

    flushAndEnd()

PRI flushAndEnd()
    debug(" ")
    debug("=== END OF EXPERIMENT ===")
    waitms(100)
    debug("END_SESSION")
