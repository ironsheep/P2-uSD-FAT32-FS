'' =================================================================
''   SD Phase Sweep Test (Phase 4 of SPI margin-improvement sprint)
''
''   Walks the diagnostic tuning knobs added by Phase 2 (debugSetSampleMode)
''   and Phase 3 (debugSetAlignDelayOffset) over a fixed grid at one compile-time
''   sysclk, exercising both Path A (smart-pin direct via CSD read) and
''   Path B (streamer DMA, validated against a slow-path read of the same
''   sector). Path B PASS = streamer read matches the known-good slow read
''   byte-for-byte. This is card-agnostic: no filesystem or boot signature
''   is required, so unformattable / marginal cards can be swept.
''
''   Sweep grid: 2 sample modes x 12 align_delay offsets = 24 cells.
''   Sample modes: 0 = pre-edge, 1 = on-edge.
''   Align-delay offsets: -3 to +8 (range justified by p2kbArchIoPinTiming
''   host-side I/O ring round trip of 5-6 sysclks plus card-side margin).
''
''   The test is READ-ONLY. No writes are issued to the card during sweep.
''
''   Default _CLKFREQ is 250_000_000 to match @macca's failing case.
''   Recompile with a different _CLKFREQ to test other sysclks.
''
''   Per Phase 4 §4.5, output includes margin-summary post-processing
''   identifying the largest contiguous passing-band per sample mode.
''
''   Author: sprint task #12 (Phase 4 task A)
''   Date:   2026-05-04
'' =================================================================

CON
' Sysclk selection (added 2026-08-17 for the socket-timing study): default stays
' 250 MHz (@macca's failing case); -D SYSCLK_350 rebuilds at 350 MHz so the SPI
' targets below land on the socket-shmoo grid (35.0 MHz = hp5, 29.17 MHz = hp6).
#ifdef SYSCLK_350
    _CLKFREQ        = 350_000_000
#else
    _CLKFREQ        = 250_000_000               ' Configurable per build
#endif
    _XTLFREQ        = 20_000_000

' SPI speed override (added 2026-08-17): the sweep historically ran at whatever
' speed initCardOnly settled, which cannot reach the region where the Lerdisk
' asdfg card corrupts Path B (onset 29.17-35.0 MHz per the socket shmoo). Select
' a target with -D SPI_35M / -D SPI_29M / -D SPI_25M; default (no define) keeps
' the historical init-settled behavior.
' -D SPI_43M (added 2026-08-18) targets hp=4 / 43.75 MHz at 350 MHz sysclk -- the
' FLOOR CELL. Two production guards have to be lifted to measure it at all: the
' speed bound (as with the other high arms) and the hp=4 floor-cell rule, which
' otherwise collapses every positive offset to the same align value and yields a
' flat, meaningless sweep. This arm lifts both. It is the only arm that does.
#ifdef SPI_43M_HS
    SPI_TARGET_HZ   = 0                         ' negotiated, not set -- see the HS block below
#elseifdef SPI_43M
    SPI_TARGET_HZ   = 43_750_000
#elseifdef SPI_35M
    SPI_TARGET_HZ   = 35_000_000
#elseifdef SPI_29M
    SPI_TARGET_HZ   = 29_170_000
#elseifdef SPI_25M
    SPI_TARGET_HZ   = 25_000_000
#else
    SPI_TARGET_HZ   = 0                         ' 0 = leave at init-settled speed
#endif

    ' SD card pin assignments
    ' Default: P2 Edge module SD slot. Build with -D SD_PINS_EXTERNAL
    ' to use the external SD header (base pin 16).
#ifdef SD_PINS_EXTERNAL
    SD_CS   = 20
    SD_MOSI = 19
    SD_MISO = 18
    SD_SCK  = 21
#else
    SD_CS   = 60
    SD_MOSI = 59
    SD_MISO = 58
    SD_SCK  = 61
#endif
    DEBUG_BAUD      = 2_000_000

    OFFSET_MIN      = -3                        ' Sweep range low
    OFFSET_MAX      = 16                        ' Sweep range high (widened 2026-08-17 with the
                                                ' driver clamp, to reach the passing band's top)
    OFFSET_COUNT    = 20                        ' OFFSET_MAX - OFFSET_MIN + 1
    MODE_COUNT      = 2                         ' pre-edge + on-edge

    PHASE_TEST_SECTOR = 0                       ' Sector swept on Path B (any readable sector)

    PATH_A_PASS     = 1
    PATH_A_FAIL     = 0
    PATH_B_PASS     = 1
    PATH_B_FAIL     = 0


#pragma exportdef SD_INCLUDE_ALL                ' Need RAW + REGISTERS + DEBUG


OBJ
    sd : "micro_sd_fat32_fs"


DAT
    ' 2D result matrix: result_b[mode * OFFSET_COUNT + (offset - OFFSET_MIN)]
    ' Path A is reported separately as a binary categorical per mode (since
    ' the sample-mode axis IS the Path A knob, the Path B offset axis does
    ' not affect Path A directly).
    result_b        BYTE    0[MODE_COUNT * OFFSET_COUNT]
    result_a        BYTE    0[MODE_COUNT]       ' Indexed by sample mode

    ' Streamer-path readback buffer
    sec_buf         BYTE    0[512]

    ' Slow-path (known-good reference) readback buffer
    slow_buf        BYTE    0[512]

    ' CSD readback buffer (16 bytes)
    csd_buf         BYTE    0[16]


PUB go() | mode, offset, status
'' Entry point. Mounts the card, walks the 2x12 grid, prints per-cell results,
'' then runs §4.5 margin-measurement post-processing.

    waitms(50)                                                                  '  power-on settle
    debug(" ")
    debug("============================================================")
    debug("  SD Phase Sweep Test (Phase 4 / sprint task #12)")
    debug("============================================================")
    debug("  sysclk = ", udec_(clkfreq), " Hz (", udec_(clkfreq / 1_000_000), " MHz)")
    debug("  Sweep grid: ", udec_(MODE_COUNT), " modes x ", udec_(OFFSET_COUNT), " offsets = ", udec_(MODE_COUNT * OFFSET_COUNT), " cells")
    debug("  Path A: smart-pin direct (CSD read; sample-mode axis only)")
    debug("  Path B: streamer DMA (sector 0; both axes)")
    debug("  READ-ONLY: no writes to the card.")
    debug(" ")

    ' Characterization tool: lift the production speed bound so the SPI_43M /
    ' SPI_35M / SPI_29M override arms can exceed the card ceiling
    sd.debugSetOverspeedAllowed(true)

#ifdef SPI_43M
    ' Floor cell only: lift the hp=4 rule so positive offsets actually take
    ' effect. Without this the sweep reports every positive offset identically
    ' and measures nothing. Production keeps the rule -- see the CON note above.
    sd.debugSetAlignFloorRuleEnabled(false)
    debug("  FLOOR-CELL ARM: hp=4 rule LIFTED for measurement (production keeps it)")
#endif

#ifdef SPI_43M_HS
    ' THE READ BAND AT hp=4, INSIDE VERIFIED HIGH-SPEED MODE (added 2026-08-19).
    '
    ' Why a separate arm from SPI_43M. That arm reaches 43.75 MHz by SETTING the
    ' clock, which leaves the card in DEFAULT speed mode driven above spec. hp=4
    ' occurs in production only inside high-speed mode, where the card's own
    ' output timing is different by definition -- so the band SPI_43M measures
    ' does not transfer to the case that actually ships. Round 9c measured that
    ' band and it was mistakenly read as deciding the production exemption; it
    ' does not.
    '
    ' No speed change is needed during this sweep, which is what makes it
    ' possible at all: Path B compares the streamer read against
    ' debugReadSectorSlow() at the SAME clock, and the slow path's smart-pin
    ' sampling is hardware-synchronised to SCK and unaffected by align_delay.
    ' Round 8b measured that byte-by-byte path clean at hp=4, so the reference is
    ' trustworthy here.
    sd.debugSetAlignFloorRuleEnabled(false)
    if not sd.attemptHighSpeed()
        debug("  HS ARM: card DECLINED high speed (ERROR(): ", sdec_(sd.error()), ")")
        debug("  This arm is MEANINGLESS without hp=4. Not a failure -- use a card that negotiates.")
        debug("END_SESSION")
        return
    debug("  HS ARM: high speed ACTIVE at ", udec_(sd.getSPIFrequency() / 1000), " kHz, hp=", udec_(sd.debugGetCurrentHp()))
    debug("  HS ARM: hp=4 floor rule LIFTED for measurement (production keeps it)")
#endif

    status := sd.initCardOnly(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    if status < 0
        debug("FATAL: initCardOnly failed (", sdec_(status), ")")
        debug("END_SESSION")
        return

    debug("  initCardOnly OK. hp = ", udec_(sd.debugGetCurrentHp()))
    if SPI_TARGET_HZ > 0
        debug("  SPI override: requested ", udec_(SPI_TARGET_HZ / 1_000), " kHz, got ", ...
            udec_(sd.setSPISpeed(SPI_TARGET_HZ) / 1_000), " kHz (hp = ", udec_(sd.debugGetCurrentHp()), ")")
    debug(" ")
    debug("============================================================")
    debug("  Per-cell sweep")
    debug("============================================================")
    debug(" ")

    repeat mode from 0 to MODE_COUNT - 1
        sd.debugSetSampleMode(mode)
        ' Path A is determined by sample mode alone; test once per mode
        result_a[mode] := test_path_a()
        debug("  --- mode=", udec_(mode), " (",  zstr_((mode == 0) ? @str_preedge : @str_onedge), ") path_a=",  zstr_((result_a[mode] == PATH_A_PASS) ? @str_pass : @str_fail), " ---")
        repeat offset from OFFSET_MIN to OFFSET_MAX
            sd.debugSetAlignDelayOffset(offset)
            status := test_path_b()
            result_b[mode * OFFSET_COUNT + (offset - OFFSET_MIN)] := status
            debug("    sysclk=", udec_(clkfreq / 1_000_000), " hp=", udec_(sd.debugGetCurrentHp()), " mode=", udec_(mode), " offset=", sdec_(offset), " path_b=",  zstr_((status == PATH_B_PASS) ? @str_pass : @str_fail))

    debug(" ")

    ' §4.5 margin-summary post-processing
    print_margin_summary()

    debug(" ")
    debug("============================================================")
    debug("  END")
    debug("============================================================")
    debug("END_SESSION")


PRI test_path_a() : status | read_status, csd_struct
' Path A test: read CSD via sd.readCSDRaw and verify it looks valid.
' On a healthy card, CSD byte 0 has CSD_STRUCTURE in bits [7:6]: 00=v1.0, 01=v2.0.
' We accept either as valid. Returns PATH_A_PASS or PATH_A_FAIL.
' This exercises sp_transfer_8 (Path A) for the entire CSD readback sequence.

    bytefill(@csd_buf, $EE, 16)                                                 '  sentinel
    read_status := sd.readCSDRaw(@csd_buf)
    if read_status < 0
        return PATH_A_FAIL
    csd_struct := (csd_buf[0] >> 6) & $03
    if csd_struct == $03 OR csd_struct == $02                                   '  reserved values
        return PATH_A_FAIL
    if csd_buf[0] == $EE                                                        '  buffer untouched -> read silently failed
        return PATH_A_FAIL
    return PATH_A_PASS


PRI test_path_b() : status | streamer_status, slow_status, idx, mismatches
' Path B test: read PHASE_TEST_SECTOR via the streamer-DMA path AND via the
' slow byte-by-byte path, then compare. The slow path is the known-good
' reference - its smart-pin sampling is hardware-synchronized to SCK and is
' not affected by the align_delay knob. PASS = streamer read succeeded and
' matches the slow-path read byte-for-byte. Card-agnostic: needs no
' filesystem and no boot signature, so unformattable cards can be swept.

    bytefill(@sec_buf, $EE, 512)                                                '  streamer sentinel
    bytefill(@slow_buf, $CC, 512)                                               '  slow-path sentinel (distinct)
    streamer_status := sd.readSectorRaw(PHASE_TEST_SECTOR, @sec_buf)
    slow_status := sd.debugReadSectorSlow(PHASE_TEST_SECTOR, @slow_buf)
    if slow_status < 0
        return PATH_B_FAIL                                                      '  no reference -> cannot judge this cell
    if streamer_status < 0
        return PATH_B_FAIL                                                      '  streamer read errored outright
    mismatches := 0
    repeat idx from 0 to 511
        if sec_buf[idx] <> slow_buf[idx]
            mismatches++
    if mismatches == 0
        return PATH_B_PASS
    return PATH_B_FAIL


PRI print_margin_summary() | mode, offset, run_start, run_end, run_width, best_start, best_end, best_width, in_run, idx, plateau_count, plateau_starts[OFFSET_COUNT]
' §4.5 margin-summary post-processing.
' For each sample mode, find the largest contiguous run of passing
' align_delay_offset values (the "passing band"). Detect §3 falsification
' triggers: no band, multiple plateaus, or center far from predicted +5..+7.

    debug(" ")
    debug("============================================================")
    debug("  Margin summary (Phase 4 §4.5)")
    debug("============================================================")

    repeat mode from 0 to MODE_COUNT - 1
        debug(" ")
        debug("  --- mode=", udec_(mode), " (", zstr_((mode == 0) ? @str_preedge : @str_onedge), ") ---")

        ' Path A categorical (binary axis)
        debug("    Path A: ", zstr_((result_a[mode] == PATH_A_PASS) ? @str_pass : @str_fail))

        ' Path B passing-band analysis
        best_start := 0
        best_end := -1
        best_width := 0
        run_start := 0
        run_end := -1
        run_width := 0
        in_run := 0
        plateau_count := 0

        repeat offset from OFFSET_MIN to OFFSET_MAX
            idx := mode * OFFSET_COUNT + (offset - OFFSET_MIN)
            if result_b[idx] == PATH_B_PASS
                if NOT in_run
                    run_start := offset
                    in_run := 1
                run_end := offset
                run_width := run_end - run_start + 1
            else
                if in_run
                    if run_width > best_width
                        best_start := run_start
                        best_end := run_end
                        best_width := run_width
                    plateau_starts[plateau_count] := run_start
                    plateau_count++
                    in_run := 0
        ' Final run if it ended at OFFSET_MAX
        if in_run
            if run_width > best_width
                best_start := run_start
                best_end := run_end
                best_width := run_width
            plateau_starts[plateau_count] := run_start
            plateau_count++

        ' Report findings + §3 falsification triggers
        if best_width == 0
            debug("    Path B: NO PASSING BAND -- model violation suspected")
            debug("            (no offset in [", sdec_(OFFSET_MIN), "..", sdec_(OFFSET_MAX), "] passed for this mode)")
        else
            ' Path B passing-band found
            idx := (best_start + best_end) / 2                                  ' reuse idx as center
            debug("    Path B: passing band [", sdec_(best_start), "..", sdec_(best_end), "], width=", udec_(best_width), ", center=", sdec_(idx))
            ' Trigger: multiple disjoint plateaus
            if plateau_count > 1
                debug("            WARNING: ", udec_(plateau_count), " disjoint plateaus -- model expected single bathtub")
            ' Trigger: center far from predicted +5..+7 range
            ' Per p2kbArchIoPinTiming the predicted optimum is host-side
            ' round-trip 5-6 sysclks plus card t_OD 0-2 sysclks. Allow +-2
            ' sysclks of leeway -> warn if center outside [+3, +9].
            if idx < 3 OR idx > 9
                debug("            WARNING: band center outside predicted [+3..+9] -- investigate model")


DAT
    str_pass        BYTE    "PASS", 0
    str_fail        BYTE    "FAIL", 0
    str_preedge     BYTE    "pre-edge", 0
    str_onedge     BYTE    "on-edge", 0
