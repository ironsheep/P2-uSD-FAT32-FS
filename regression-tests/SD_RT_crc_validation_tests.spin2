'' =================================================================================================
''
''   File....... SD_RT_crc_validation_tests.spin2
''   Purpose.... This object tests CRC error injection hooks and validates retry/failure behavior
''   Author..... Stephen M Moraco
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... FEB 2026
''   Updated.... 27 FEB 2026
''
'' =================================================================================================
''
'' Tests the CRC error injection test hooks:
''   - setTestForceReadError(count) - Force N read CRC mismatches
''   - setTestForceWriteError(enabled) - Corrupt next write CRC (one-shot)
''   - getTestErrorCount() - Count of injected errors triggered
''   - clearTestErrors() - Reset all injection state
''
'' Test groups:
''   - Forced Read CRC Errors (retry behavior, exhaustive failure, recovery)
''   - Forced Write CRC Errors (card rejection, recovery)
''   - Test Hook State Management (clearTestErrors reset)
''
'' =================================================================================================

CON

     _CLKFREQ        = 270_000_000

     ' P2 Edge module SD slot pins
     SD_CS   = 60
     SD_MOSI = 59
     SD_MISO = 58
     SD_SCK  = 61

     ' External SD header (base pin 16)
     'SD_CS   = 20
     'SD_MOSI = 19
     'SD_MISO = 18
     'SD_SCK  = 21

     BUFFER_SIZE = 512

     MAX_READ_CRC_RETRIES = 3  ' Must match driver constant

' Enable all features including debug/test hooks
#IFDEF __SPINTOOLS__
#DEFINE SD_INCLUDE_ALL
#ELSEIFDEF __FLEXSPIN__
#define SD_INCLUDE_ALL
#pragma exportdef SD_INCLUDE_ALL
#ELSE
#PRAGMA EXPORTDEF SD_INCLUDE_ALL
#ENDIF

OBJ
    sd    : "micro_sd_fat32_fs"
    utils : "isp_rt_utilities"

DAT

' Test filenames
crcFile1        BYTE    "CRCVAL1.BIN", 0
crcFile2        BYTE    "CRCVAL2.BIN", 0

' Buffers
writeBuffer     BYTE    0[BUFFER_SIZE]
readBuffer      BYTE    0[BUFFER_SIZE]
readBuffer_guard BYTE   0[16]

PUB go() | result, handle, bytesRead, bytesWritten, retryBefore, retryAfter, mismatchBefore, mismatchAfter, errCount
'' Main entry point for CRC validation regression tests

    debug(" ")
    debug("==============================================")
    debug("  SD Card Driver - CRC Validation Tests")
    debug("==============================================")

    ' Mount the card first
    result := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
    if result == false
        debug("ERROR: Could not mount SD card!")
        debug("END_SESSION")
        return

    ' Show card info
    debug(" ")
    debug("* SD Card Information:")
    debug("   Volume Label: ", zstr_(sd.volumeLabel()))

    ' Clean up any existing test files
    sd.deleteFile(@crcFile1)
    sd.deleteFile(@crcFile2)

    ' Create test file with known pattern
    utils.fillBufferWithPattern(@writeBuffer, BUFFER_SIZE, $42)
    handle := sd.createFileNew(@crcFile1)
    if handle >= 0
        sd.writeHandle(handle, @writeBuffer, BUFFER_SIZE)
        sd.closeFileHandle(handle)

    ' Ensure test hooks are clean
    sd.clearTestErrors()

    ' ======================================================================
    ' TEST GROUP: Forced Read CRC Errors
    ' ======================================================================
    utils.startTestGroup(@"Forced Read CRC Errors")

    ' Test 1: Single forced CRC error triggers retry but read succeeds
    ' NOTE: Hook must be armed AFTER openFileRead to avoid consuming count on directory reads
    utils.startTest(@"Single forced CRC error triggers retry, read succeeds")
    utils.setCheckCountPerTest(3)
    retryBefore := sd.getCRCRetryCount()
    handle := sd.openFileRead(@crcFile1)
    if handle >= 0
        sd.setTestForceReadError(1)
        utils.initGuard(@readBuffer_guard)
        bytesRead := sd.readHandle(handle, @readBuffer, BUFFER_SIZE)
        utils.checkGuard(@readBuffer_guard, @"readBuffer guard")
        sd.closeFileHandle(handle)
    retryAfter := sd.getCRCRetryCount()
    errCount := sd.getTestErrorCount()
    debug("  bytesRead=", sdec_(bytesRead), " retries before=", udec_(retryBefore), " after=", udec_(retryAfter), " errCount=", udec_(errCount))
    utils.evaluateSubValue(bytesRead, @"read returns 512 bytes", BUFFER_SIZE)
    utils.evaluateSubBool(retryAfter > retryBefore, @"retry count increased", true)
    utils.evaluateSubValue(errCount, @"error count == 1", 1)
    utils.showSubTestResults()

    ' Test 2: Exhaustive forced CRC error (count=3) causes read failure
    ' NOTE: Hook must be armed AFTER openFileRead to avoid consuming count on directory reads
    utils.startTest(@"Exhaustive forced CRC error causes read failure")
    utils.setCheckCountPerTest(2)
    sd.clearTestErrors()
    mismatchBefore := sd.getCRCMismatchCount()
    handle := sd.openFileRead(@crcFile1)
    if handle >= 0
        sd.setTestForceReadError(MAX_READ_CRC_RETRIES)
        utils.initGuard(@readBuffer_guard)
        bytesRead := sd.readHandle(handle, @readBuffer, BUFFER_SIZE)
        utils.checkGuard(@readBuffer_guard, @"readBuffer guard")
        sd.closeFileHandle(handle)
    mismatchAfter := sd.getCRCMismatchCount()
    debug("  bytesRead=", sdec_(bytesRead), " mismatches before=", udec_(mismatchBefore), " after=", udec_(mismatchAfter))
    utils.evaluateSubValue(bytesRead, @"read returns 0 (failure)", 0)
    utils.evaluateSubBool(mismatchAfter > mismatchBefore, @"mismatch count increased", true)
    utils.showSubTestResults()

    ' Test 3: Normal read after forced error succeeds
    utils.startTest(@"Normal read after forced error succeeds")
    sd.clearTestErrors()
    handle := sd.openFileRead(@crcFile1)
    if handle >= 0
        bytefill(@readBuffer, 0, BUFFER_SIZE)
        utils.initGuard(@readBuffer_guard)
        bytesRead := sd.readHandle(handle, @readBuffer, BUFFER_SIZE)
        utils.checkGuard(@readBuffer_guard, @"readBuffer guard")
        sd.closeFileHandle(handle)
    result := utils.verifyBufferPattern(@readBuffer, BUFFER_SIZE, $42)
    utils.evaluateSubBool(bytesRead == BUFFER_SIZE, @"read returns 512", true)
    utils.evaluateSubBool(result, @"data matches pattern", true)

    ' ======================================================================
    ' TEST GROUP: Forced Write CRC Errors
    ' ======================================================================
    utils.startTestGroup(@"Forced Write CRC Errors")

    ' Test 4: Forced write CRC error causes card rejection
    ' NOTE: Hook must be armed AFTER createFileNew to avoid corrupting directory write
    utils.startTest(@"Forced write CRC error causes card rejection")
    sd.clearTestErrors()
    handle := sd.createFileNew(@crcFile2)
    if handle >= 0
        utils.fillBufferWithPattern(@writeBuffer, BUFFER_SIZE, $55)
        sd.setTestForceWriteError(1)
        bytesWritten := sd.writeHandle(handle, @writeBuffer, BUFFER_SIZE)
        sd.closeFileHandle(handle)
    errCount := sd.getTestErrorCount()
    debug("  bytesWritten=", sdec_(bytesWritten), " errCount=", udec_(errCount))
    ' The write may fail or the error may be detected differently depending on card behavior
    utils.evaluateSubBool(errCount > 0, @"error was injected", true)

    ' Test 5: Normal write after forced error succeeds
    utils.startTest(@"Normal write after forced error succeeds")
    sd.clearTestErrors()
    sd.deleteFile(@crcFile2)
    handle := sd.createFileNew(@crcFile2)
    if handle >= 0
        utils.fillBufferWithPattern(@writeBuffer, BUFFER_SIZE, $77)
        bytesWritten := sd.writeHandle(handle, @writeBuffer, BUFFER_SIZE)
        sd.closeFileHandle(handle)
    debug("  bytesWritten=", sdec_(bytesWritten))
    ' Verify data was written correctly by reading back
    handle := sd.openFileRead(@crcFile2)
    if handle >= 0
        bytefill(@readBuffer, 0, BUFFER_SIZE)
        utils.initGuard(@readBuffer_guard)
        bytesRead := sd.readHandle(handle, @readBuffer, BUFFER_SIZE)
        utils.checkGuard(@readBuffer_guard, @"readBuffer guard")
        sd.closeFileHandle(handle)
    result := utils.verifyBufferPattern(@readBuffer, BUFFER_SIZE, $77)
    utils.evaluateBool(result, @"write data verified", true)

    ' ======================================================================
    ' TEST GROUP: Test Hook State Management
    ' ======================================================================
    utils.startTestGroup(@"Test Hook State Management")

    ' Test 6: clearTestErrors resets all injection state
    utils.startTest(@"clearTestErrors resets all injection state")
    utils.setCheckCountPerTest(3)
    ' Arm both hooks
    sd.setTestForceReadError(5)
    sd.setTestForceWriteError(1)
    ' Now clear
    sd.clearTestErrors()
    errCount := sd.getTestErrorCount()
    utils.evaluateSubValue(errCount, @"error count == 0", 0)
    ' Verify read works normally
    handle := sd.openFileRead(@crcFile1)
    if handle >= 0
        bytefill(@readBuffer, 0, BUFFER_SIZE)
        utils.initGuard(@readBuffer_guard)
        bytesRead := sd.readHandle(handle, @readBuffer, BUFFER_SIZE)
        utils.checkGuard(@readBuffer_guard, @"readBuffer guard")
        sd.closeFileHandle(handle)
    utils.evaluateSubValue(bytesRead, @"read returns 512", BUFFER_SIZE)
    result := utils.verifyBufferPattern(@readBuffer, BUFFER_SIZE, $42)
    utils.evaluateSubBool(result, @"data correct after clear", true)
    utils.showSubTestResults()

    ' ======================================================================
    ' Cleanup and Summary
    ' ======================================================================
    sd.clearTestErrors()
    sd.deleteFile(@crcFile1)
    sd.deleteFile(@crcFile2)

    sd.unmount()

    utils.ShowTestEndCounts()

    debug(" ")
    debug("END_SESSION")


con { license }

